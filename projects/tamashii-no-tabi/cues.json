{
  "total": 1550.14,
  "count": 561,
  "cues": [
    {
      "t": 0,
      "s": "その日の夜のことを、私はよく覚えています。"
    },
    {
      "t": 4.25,
      "s": "四十九日の法要が終わって、"
    },
    {
      "t": 6.88,
      "s": "お坊さんが帰ったあとでした。"
    },
    {
      "t": 9.72,
      "s": "親戚もみんな帰ってしまって、"
    },
    {
      "t": 12.19,
      "s": "部屋には私ひとりです。"
    },
    {
      "t": 14.12,
      "s": "座卓の上には、"
    },
    {
      "t": 15.36,
      "s": "まだ手をつけていないぼたも"
    },
    {
      "t": 17.65,
      "s": "ちの皿が残っていました。"
    },
    {
      "t": 19.76,
      "s": "位牌の前には、蝋燭が一本。"
    },
    {
      "t": 22.65,
      "s": "まだずいぶん長いままで、"
    },
    {
      "t": 25.32,
      "s": "静かに燃えていました。"
    },
    {
      "t": 27.76,
      "s": "朝から、ずっと言われていた言葉があります。"
    },
    {
      "t": 31.98,
      "s": "今日で忌明けですよ、と。"
    },
    {
      "t": 34.39,
      "s": "四十九日で一区切りですから、と。"
    },
    {
      "t": 37.61,
      "s": "私はその言葉に、何度もうなずいていました。"
    },
    {
      "t": 41.88,
      "s": "ええ、ええ、と。"
    },
    {
      "t": 43.51,
      "s": "ですが正直に言うと、"
    },
    {
      "t": 45.54,
      "s": "なんのことだか、"
    },
    {
      "t": 47.17,
      "s": "わかってはいなかったんです。"
    },
    {
      "t": 50.02,
      "s": "今日が最後の日。"
    },
    {
      "t": 51.7,
      "s": "そう聞かされました。"
    },
    {
      "t": 53.79,
      "s": "では、何の最後なんでしょうか。"
    },
    {
      "t": 56.93,
      "s": "四十九日というのは、"
    },
    {
      "t": 58.87,
      "s": "いったい誰のための四十九日なのか。"
    },
    {
      "t": 62.17,
      "s": "この四十九日のあいだ、"
    },
    {
      "t": 64.31,
      "s": "あの人はどこにいたことになっているのか。"
    },
    {
      "t": 68.19,
      "s": "考えてみれば、"
    },
    {
      "t": 69.62,
      "s": "私はそれを一度も教わっていませんでした。"
    },
    {
      "t": 73.69,
      "s": "法事には子どものころから何度も出ています。"
    },
    {
      "t": 77.98,
      "s": "座って、手を合わせて、お斎をいただいて帰る。"
    },
    {
      "t": 82.46,
      "s": "そのたびに、"
    },
    {
      "t": 83.57,
      "s": "なぜ七日ごとなのか、"
    },
    {
      "t": 85.41,
      "s": "なぜ四十九で終わるのか、"
    },
    {
      "t": 87.62,
      "s": "誰も説明してくれませんでした。たぶん、"
    },
    {
      "t": 91.12,
      "s": "説明できる人がいなかったんだと思います。"
    },
    {
      "t": 94.81,
      "s": "この四十九日のあいだ、"
    },
    {
      "t": 97.31,
      "s": "うちには七日ごとに人が来ていました。"
    },
    {
      "t": 101.4,
      "s": "初七日、二七日、三七日。"
    },
    {
      "t": 104.13,
      "s": "数えていくのは私の役目でした。"
    },
    {
      "t": 107.54,
      "s": "カレンダーに印をつけて、"
    },
    {
      "t": 109.98,
      "s": "その日が来ると座布団を出す。"
    },
    {
      "t": 112.82,
      "s": "お茶を出して、同じ話をして、見送る。"
    },
    {
      "t": 116.48,
      "s": "それを七回、繰り返したことになります。"
    },
    {
      "t": 120.34,
      "s": "ずいぶん丁寧に区切ってあるものだな、"
    },
    {
      "t": 123.35,
      "s": "とは思っていました。ですが、"
    },
    {
      "t": 125.7,
      "s": "その区切りが何を数えているのかまでは、"
    },
    {
      "t": 128.88,
      "s": "考えたことがなかったんです。"
    },
    {
      "t": 131.22,
      "s": "その夜、"
    },
    {
      "t": 131.96,
      "s": "私は仏壇のわきにあった古い本を"
    },
    {
      "t": 134.75,
      "s": "引っぱり出しました。"
    },
    {
      "t": 136.61,
      "s": "祖父が持っていたものです。"
    },
    {
      "t": 139.03,
      "s": "調べていくうちに、"
    },
    {
      "t": 140.71,
      "s": "わかってきたことがあります。"
    },
    {
      "t": 143.31,
      "s": "この四十九日という数字には、"
    },
    {
      "t": 145.75,
      "s": "ちゃんと出どころがあるんです。そして、"
    },
    {
      "t": 149.06,
      "s": "そこには一枚の地図のよ"
    },
    {
      "t": 150.98,
      "s": "うなものが描かれていました。"
    },
    {
      "t": 153.42,
      "s": "魂はどこから来て、どこへ行くのか。"
    },
    {
      "t": 156.96,
      "s": "お経は、それにずいぶん細かく答えていました。"
    },
    {
      "t": 161.55,
      "s": "今日は、"
    },
    {
      "t": 162.38,
      "s": "その道を最初から一緒に"
    },
    {
      "t": 164.68,
      "s": "歩いてみたいと思います。"
    },
    {
      "t": 168.67,
      "s": "まず、出発点の話からです。"
    },
    {
      "t": 171.3,
      "s": "仏教の考え方では、人の一生は、"
    },
    {
      "t": 174.34,
      "s": "一本の線ではありません。"
    },
    {
      "t": 176.77,
      "s": "輪になっています。"
    },
    {
      "t": 178.59,
      "s": "生まれて、生きて、亡くなって、また生まれる。"
    },
    {
      "t": 183.05,
      "s": "これを輪廻といいます。"
    },
    {
      "t": 185.28,
      "s": "輪になって廻る、と書きます。"
    },
    {
      "t": 188.12,
      "s": "ここが、この話の大事な前提です。"
    },
    {
      "t": 191.31,
      "s": "この考え方では、"
    },
    {
      "t": 192.91,
      "s": "亡くなることは終点ではありません。"
    },
    {
      "t": 196.31,
      "s": "輪の上の、ひとつの地点でしかない。"
    },
    {
      "t": 199.7,
      "s": "そうすると、ひとつ疑問が出てきます。"
    },
    {
      "t": 202.92,
      "s": "亡くなってから、次に生まれるまで。"
    },
    {
      "t": 205.95,
      "s": "そのあいだの時間は、"
    },
    {
      "t": 207.74,
      "s": "いったい何なんでしょうか。"
    },
    {
      "t": 210.06,
      "s": "その、"
    },
    {
      "t": 210.86,
      "s": "あいだの時間につけられた名前があります。"
    },
    {
      "t": 216.21,
      "s": "中有、あるいは中陰といいます。"
    },
    {
      "t": 220.21,
      "s": "中くらいの中に、有る無しの有。"
    },
    {
      "t": 224.22,
      "s": "中の陰、と書くこともあります。"
    },
    {
      "t": 228.23,
      "s": "この言葉、もとはサンスクリット語です。"
    },
    {
      "t": 231.81,
      "s": "アンタラーバヴァ、といいます。"
    },
    {
      "t": 234.63,
      "s": "アンタラーが中間、バヴァが生存の状態。"
    },
    {
      "t": 238.21,
      "s": "つまり、中間の生存状態。"
    },
    {
      "t": 240.73,
      "s": "インドで生まれた言葉が、"
    },
    {
      "t": 243.25,
      "s": "中国を通って、"
    },
    {
      "t": 244.71,
      "s": "そのまま日本語の中陰になったわけです。"
    },
    {
      "t": 248.7,
      "s": "私はこの言葉を知ったとき、"
    },
    {
      "t": 251.23,
      "s": "なんというか、"
    },
    {
      "t": 252.6,
      "s": "少し不思議な気持ちになりました。中間、"
    },
    {
      "t": 256.31,
      "s": "ということは、"
    },
    {
      "t": 257.67,
      "s": "まだ着いていないということです。"
    },
    {
      "t": 260.79,
      "s": "もう、ここにはいない。"
    },
    {
      "t": 263.01,
      "s": "けれど、次の場所にも、まだ着いていない。"
    },
    {
      "t": 267.05,
      "s": "仏教はその、"
    },
    {
      "t": 268.26,
      "s": "どちらでもない状態に、"
    },
    {
      "t": 270.48,
      "s": "わざわざ名前をつけていたんです。"
    },
    {
      "t": 273.71,
      "s": "そして考えてみると、"
    },
    {
      "t": 275.74,
      "s": "残された側も、"
    },
    {
      "t": 277.16,
      "s": "ちょうどその状態にいます。"
    },
    {
      "t": 279.79,
      "s": "もういないことはわかっている。"
    },
    {
      "t": 282.83,
      "s": "けれど、いないことにはまだなっていない。"
    },
    {
      "t": 286.89,
      "s": "さて、この中陰には期間があります。"
    },
    {
      "t": 290.66,
      "s": "七日を七回。"
    },
    {
      "t": 291.99,
      "s": "四十九日です。"
    },
    {
      "t": 293.54,
      "s": "なぜ七なのか。"
    },
    {
      "t": 295.03,
      "s": "ここを調べていて、私はいちばん驚きました。"
    },
    {
      "t": 299.52,
      "s": "古い仏教の論書に、"
    },
    {
      "t": 301.44,
      "s": "『倶舎論』という有名な本があります。"
    },
    {
      "t": 305.28,
      "s": "インドで書かれたものです。"
    },
    {
      "t": 308.06,
      "s": "その第九巻に、"
    },
    {
      "t": 309.42,
      "s": "中有の期間についての議論が出てきます。"
    },
    {
      "t": 313.12,
      "s": "そこでは、"
    },
    {
      "t": 314.09,
      "s": "いくつもの説が並べて紹介されていました。"
    },
    {
      "t": 317.98,
      "s": "ある先生は、期限は決まっていないと言う。"
    },
    {
      "t": 322.03,
      "s": "世友という人は、長くて七日だと言う。"
    },
    {
      "t": 325.67,
      "s": "毘婆沙師という人たちは、"
    },
    {
      "t": 328.09,
      "s": "もっとずっと短いと言う。"
    },
    {
      "t": 330.52,
      "s": "そして、"
    },
    {
      "t": 331.42,
      "s": "そのあいだに一行、"
    },
    {
      "t": 333.44,
      "s": "こういう書き方で挟まっているんです。有余師、"
    },
    {
      "t": 338.39,
      "s": "つまり、"
    },
    {
      "t": 339.29,
      "s": "ほかにこう言う先生もいる、と。"
    },
    {
      "t": 342.66,
      "s": "その先生の説が、四十九日でした。"
    },
    {
      "t": 346.26,
      "s": "四十九日という数字は、"
    },
    {
      "t": 348.38,
      "s": "その本のなかでは、"
    },
    {
      "t": 350.12,
      "s": "いちばん強い説ではなかったんです。"
    },
    {
      "t": 353.39,
      "s": "ほかにこういう説もある、"
    },
    {
      "t": 355.71,
      "s": "という書かれ方をした、"
    },
    {
      "t": 357.83,
      "s": "いわば少数意見でした。"
    },
    {
      "t": 359.95,
      "s": "私はこれを読んで、"
    },
    {
      "t": 361.74,
      "s": "少しのあいだ、"
    },
    {
      "t": 363.14,
      "s": "手が止まりました。あの一行が、"
    },
    {
      "t": 366.13,
      "s": "二千年近くかけて、"
    },
    {
      "t": 367.92,
      "s": "私の家のカレンダーになっていたわけです。"
    },
    {
      "t": 371.91,
      "s": "インドの論書に並んだいくつもの説のうち、"
    },
    {
      "t": 375.89,
      "s": "ひとつが選ばれて、残った。"
    },
    {
      "t": 378.48,
      "s": "それが海を渡って、"
    },
    {
      "t": 380.28,
      "s": "この国の家々の、"
    },
    {
      "t": 381.87,
      "s": "七日ごとの予定になった。"
    },
    {
      "t": 384.26,
      "s": "ですから、"
    },
    {
      "t": 385.22,
      "s": "なぜ七なのかという問いに、"
    },
    {
      "t": 387.73,
      "s": "私は今もはっきりとは答えられません。ただ、"
    },
    {
      "t": 391.77,
      "s": "天から降ってきた数字ではないということは、"
    },
    {
      "t": 395.82,
      "s": "わかりました。人が選んで、"
    },
    {
      "t": 398.32,
      "s": "人が受け継いで、"
    },
    {
      "t": 399.87,
      "s": "ここまで来た数字なんです。"
    },
    {
      "t": 402.37,
      "s": "死後七日ごとに法要を営んで、"
    },
    {
      "t": 405.43,
      "s": "四十九日を満中陰とする。"
    },
    {
      "t": 408.05,
      "s": "その習慣が定着したのは、そのあとのことです。"
    },
    {
      "t": 412.86,
      "s": "満ちる中陰、と書いて満中陰。"
    },
    {
      "t": 416.05,
      "s": "中陰の期間が満ちた、という意味です。"
    },
    {
      "t": 420.16,
      "s": "忌明けという言い方も、ここから来ています。"
    },
    {
      "t": 424.95,
      "s": "では、その期間に中身を入れたのは誰か。"
    },
    {
      "t": 429.24,
      "s": "中国の人たちです。晩唐のころ、中国で、"
    },
    {
      "t": 433.52,
      "s": "ひとつの信仰がかたちになりました。"
    },
    {
      "t": 437.36,
      "s": "十王信仰といいます。"
    },
    {
      "t": 439.66,
      "s": "十人の王が、順番に死者を裁く。"
    },
    {
      "t": 443.1,
      "s": "その考え方を記したのが"
    },
    {
      "t": 445.63,
      "s": "『十王経』と呼ばれるお経です。"
    },
    {
      "t": 449.07,
      "s": "ここは正確に言っておきたいところです。"
    },
    {
      "t": 452.51,
      "s": "この『十王経』、"
    },
    {
      "t": 453.95,
      "s": "インドから伝わったお経ではありません。"
    },
    {
      "t": 457.39,
      "s": "中国で作られたものです。"
    },
    {
      "t": 459.56,
      "s": "もともとインドの仏教にも、閻魔はいました。"
    },
    {
      "t": 463.83,
      "s": "ですが、"
    },
    {
      "t": 464.64,
      "s": "十人の王が順番に取り調べると"
    },
    {
      "t": 467.48,
      "s": "いう形はありません。あの、"
    },
    {
      "t": 470.12,
      "s": "役所のように並んだ仕組みは、"
    },
    {
      "t": 472.97,
      "s": "中国で加わったものなんです。"
    },
    {
      "t": 475.81,
      "s": "そして日本には、"
    },
    {
      "t": 477.33,
      "s": "平安時代の末ごろ、"
    },
    {
      "t": 479.05,
      "s": "この世の終わりが近いと"
    },
    {
      "t": 481.15,
      "s": "いう末法の思想と一緒に、"
    },
    {
      "t": 483.43,
      "s": "広く入ってきました。"
    },
    {
      "t": 485.34,
      "s": "ちなみに、王は十人います。"
    },
    {
      "t": 488.5,
      "s": "七人ではありません。"
    },
    {
      "t": 490.92,
      "s": "残りの三人は、四十九日より先に出てきます。"
    },
    {
      "t": 496.02,
      "s": "百か日、一周忌、三回忌。"
    },
    {
      "t": 498.94,
      "s": "法事がそこまで続くのは、これが理由なんです。"
    },
    {
      "t": 504.28,
      "s": "では、"
    },
    {
      "t": 504.92,
      "s": "その七つの関所では、"
    },
    {
      "t": 507.04,
      "s": "何が起きることになっているのか。"
    },
    {
      "t": 510.44,
      "s": "私が開いた本には、一つずつ、"
    },
    {
      "t": 513.42,
      "s": "名前まで書いてありました。"
    },
    {
      "t": 517.67,
      "s": "最初の七日目。初七日です。"
    },
    {
      "t": 521.39,
      "s": "ここで会うのは、秦広王という王でした。"
    },
    {
      "t": 526.82,
      "s": "初七日の法要という言葉は、"
    },
    {
      "t": 529.58,
      "s": "今でもよく聞きます。"
    },
    {
      "t": 531.71,
      "s": "最近では葬儀の日にまとめて"
    },
    {
      "t": 534.48,
      "s": "しまうことも多いですね。あれは本来、"
    },
    {
      "t": 538.3,
      "s": "この最初の関所の日のことなんです。"
    },
    {
      "t": 541.92,
      "s": "この最初の七日間に歩くとされているのが、"
    },
    {
      "t": 545.91,
      "s": "死出の山という山道です。"
    },
    {
      "t": 548.3,
      "s": "死に出ると書きます。"
    },
    {
      "t": 550.3,
      "s": "順番を、"
    },
    {
      "t": 551.08,
      "s": "ここではっきりさせておきたいと思います。"
    },
    {
      "t": 554.98,
      "s": "山が先で、川はそのあとなんです。"
    },
    {
      "t": 558.1,
      "s": "なぜそう言えるのか。"
    },
    {
      "t": 560.37,
      "s": "二番目の王の名前が、その証拠になっています。"
    },
    {
      "t": 565.37,
      "s": "次が十四日目。"
    },
    {
      "t": 566.96,
      "s": "二七日といいます。"
    },
    {
      "t": 569,
      "s": "ここで会うのが、初江王。"
    },
    {
      "t": 571.73,
      "s": "初めの江、と書きます。"
    },
    {
      "t": 574.4,
      "s": "江というのは、大きな川のことです。"
    },
    {
      "t": 578.54,
      "s": "最初の川の王、という名前なんです。"
    },
    {
      "t": 582.67,
      "s": "名前のとおり、"
    },
    {
      "t": 584.17,
      "s": "この王は川のほとりにいることになっています。"
    },
    {
      "t": 588.9,
      "s": "三途の川です。"
    },
    {
      "t": 590.4,
      "s": "つまり川は、二週目に出てくる。"
    },
    {
      "t": 593.62,
      "s": "一週目ではありません。"
    },
    {
      "t": 595.98,
      "s": "この三途という言葉も、"
    },
    {
      "t": 598.11,
      "s": "少し誤解されているところがあります。"
    },
    {
      "t": 601.58,
      "s": "三つの道、という意味ではないんです。"
    },
    {
      "t": 605.06,
      "s": "三途はもともと三悪道のこと。"
    },
    {
      "t": 608.64,
      "s": "餓鬼道、畜生道、地獄道。"
    },
    {
      "t": 611.72,
      "s": "この三つを指す仏教の言葉で、"
    },
    {
      "t": 615.3,
      "s": "『金光明経』にその用例があります。"
    },
    {
      "t": 619.65,
      "s": "ですから、"
    },
    {
      "t": 620.53,
      "s": "三途の川という呼び方は、"
    },
    {
      "t": 622.65,
      "s": "三つの悪い行き先のほうから来た名前なんです。"
    },
    {
      "t": 626.53,
      "s": "川に三本の流れがあると"
    },
    {
      "t": 628.47,
      "s": "いう意味ではありません。"
    },
    {
      "t": 630.59,
      "s": "では、"
    },
    {
      "t": 631.27,
      "s": "川に三つの渡り方があるという、"
    },
    {
      "t": 634.7,
      "s": "あの話はどこから来たのか。"
    },
    {
      "t": 637.66,
      "s": "さきほどの『地蔵十王経』です。"
    },
    {
      "t": 641.09,
      "s": "そこにはこう書かれています。"
    },
    {
      "t": 644.28,
      "s": "渡る所に三つ有り。"
    },
    {
      "t": 646.43,
      "s": "一つは山水瀬、"
    },
    {
      "t": 648.1,
      "s": "二つは江深淵、"
    },
    {
      "t": 649.77,
      "s": "三つには橋の渡り有り。"
    },
    {
      "t": 652.4,
      "s": "善い人は、金銀七宝でできた橋を渡る。"
    },
    {
      "t": 656.75,
      "s": "罪の軽い人は、山水瀬という浅瀬を歩いて渡る。"
    },
    {
      "t": 662.07,
      "s": "罪の重い人は、"
    },
    {
      "t": 663.77,
      "s": "江深淵という難所を渡ることになる。"
    },
    {
      "t": 667.88,
      "s": "同じ川なのに、渡る場所が三つある。"
    },
    {
      "t": 671.33,
      "s": "橋があるのに、全員が橋を通るわけではない。"
    },
    {
      "t": 675.59,
      "s": "そういう書かれ方をしています。"
    },
    {
      "t": 678.63,
      "s": "そして川のほとりには、年老いた夫婦がいます。"
    },
    {
      "t": 684.17,
      "s": "奪衣婆と懸衣翁。"
    },
    {
      "t": 686.19,
      "s": "衣を奪う婆さまと、衣を懸ける翁です。"
    },
    {
      "t": 690.72,
      "s": "婆さまが死んだ人の着物を剥ぎ取って、"
    },
    {
      "t": 694.43,
      "s": "翁がそれを木の枝に掛ける。"
    },
    {
      "t": 697.12,
      "s": "衣領樹という木です。"
    },
    {
      "t": 699.18,
      "s": "そして枝の垂れ具合で、"
    },
    {
      "t": 701.45,
      "s": "どの瀬を渡るかが決まるとされています。"
    },
    {
      "t": 705.37,
      "s": "私はこの場面の話を読んで、"
    },
    {
      "t": 707.86,
      "s": "少し考え込みました。"
    },
    {
      "t": 709.77,
      "s": "持っているものを全部取られて、"
    },
    {
      "t": 712.63,
      "s": "着ていたものまで脱がされる。残るのは、"
    },
    {
      "t": 716.27,
      "s": "その人がしてきたことの重さだけなんですね。"
    },
    {
      "t": 720.28,
      "s": "この奪衣婆は、"
    },
    {
      "t": 721.64,
      "s": "のちに江戸時代の終わりごろ、"
    },
    {
      "t": 724.35,
      "s": "人びとの信仰の対象そのものになりました。"
    },
    {
      "t": 728.22,
      "s": "お堂が建てられて、"
    },
    {
      "t": 729.97,
      "s": "拝まれるようになったんです。"
    },
    {
      "t": 732.68,
      "s": "恐ろしい姿の者ほど、"
    },
    {
      "t": 734.61,
      "s": "いつのまにか拝まれている。"
    },
    {
      "t": 737.13,
      "s": "あの世の話には、そういうところがあります。"
    },
    {
      "t": 741.2,
      "s": "ここで、"
    },
    {
      "t": 742.13,
      "s": "私はひとつ気になって、"
    },
    {
      "t": 744.67,
      "s": "年代を調べてみました。"
    },
    {
      "t": 747.22,
      "s": "この川の風景は、"
    },
    {
      "t": 749.07,
      "s": "いつからあるものなんだろう、と。"
    },
    {
      "t": 752.78,
      "s": "日本で、"
    },
    {
      "t": 753.6,
      "s": "あの世の姿をいちばん早くまとめて書いたのは、"
    },
    {
      "t": 758.14,
      "s": "源信というお坊さんの『往生要集』です。"
    },
    {
      "t": 762.06,
      "s": "西暦九百八十五年、平安時代の本です。"
    },
    {
      "t": 765.77,
      "s": "ところがこの本、地獄の話も、六道の話も、"
    },
    {
      "t": 769.59,
      "s": "たっぷり書いてあるのに、"
    },
    {
      "t": 771.88,
      "s": "三途の川が出てこないんです。"
    },
    {
      "t": 774.55,
      "s": "十人の王も出てきません。"
    },
    {
      "t": 776.84,
      "s": "では中国の『十王経』のほうにはあるのか。"
    },
    {
      "t": 781.27,
      "s": "こちらには、十人の王はいます。"
    },
    {
      "t": 784.59,
      "s": "裁きの場面もあります。ですが、"
    },
    {
      "t": 787.92,
      "s": "川を渡る場面も、"
    },
    {
      "t": 789.69,
      "s": "衣を剥ぐ老夫婦も、鏡も、"
    },
    {
      "t": 792.35,
      "s": "見当たりません。"
    },
    {
      "t": 794.12,
      "s": "それらが揃って出てくるのは、"
    },
    {
      "t": 797.08,
      "s": "十二世紀ごろ、"
    },
    {
      "t": 798.57,
      "s": "日本で作られた『地蔵十王経』からです。"
    },
    {
      "t": 802.59,
      "s": "三途の川も、奪衣婆も、"
    },
    {
      "t": 804.92,
      "s": "浄玻璃の鏡も、"
    },
    {
      "t": 806.4,
      "s": "本地の仏の一覧も、"
    },
    {
      "t": 808.31,
      "s": "この日本製のお経にあります。"
    },
    {
      "t": 811.27,
      "s": "私はこれを、"
    },
    {
      "t": 812.38,
      "s": "なんだ後付けか、"
    },
    {
      "t": 813.87,
      "s": "というふうには受け取りませんでした。"
    },
    {
      "t": 817.2,
      "s": "むしろ逆です。"
    },
    {
      "t": 818.5,
      "s": "インドで中有という言葉が生まれ、"
    },
    {
      "t": 821.75,
      "s": "中国で十人の王が並び、"
    },
    {
      "t": 823.98,
      "s": "日本で川と橋と老夫婦が描き足された。"
    },
    {
      "t": 827.64,
      "s": "誰かを見送った人が、"
    },
    {
      "t": 829.67,
      "s": "その人の行く先を思って、"
    },
    {
      "t": 832.11,
      "s": "少しずつ描き込んでいった地図なんです。"
    },
    {
      "t": 835.97,
      "s": "さて、道に戻ります。"
    },
    {
      "t": 838.81,
      "s": "三週目、二十一日目。宋帝王。"
    },
    {
      "t": 842.79,
      "s": "四週目、二十八日目は、五官王です。"
    },
    {
      "t": 847.61,
      "s": "五つの官と書きます。"
    },
    {
      "t": 850.45,
      "s": "この王が、罪の重さを秤で量るとされています。"
    },
    {
      "t": 856.7,
      "s": "そして、五週目。"
    },
    {
      "t": 858.27,
      "s": "三十五日目です。"
    },
    {
      "t": 859.84,
      "s": "ここで出てくるのが、"
    },
    {
      "t": 861.81,
      "s": "みなさんご存じの、"
    },
    {
      "t": 863.58,
      "s": "あの方でした。"
    },
    {
      "t": 864.95,
      "s": "閻魔王です。"
    },
    {
      "t": 866.35,
      "s": "ここで私は、思わず本を読み返しました。"
    },
    {
      "t": 870.88,
      "s": "三十五日目。"
    },
    {
      "t": 872.31,
      "s": "三十五日目なんです。"
    },
    {
      "t": 874.69,
      "s": "四十九日ではありません。"
    },
    {
      "t": 877.55,
      "s": "私はずっと、"
    },
    {
      "t": 878.64,
      "s": "四十九日に閻魔さまが出てきて、"
    },
    {
      "t": 881.37,
      "s": "最後の判決を下すんだとばかり思っていました。"
    },
    {
      "t": 885.36,
      "s": "たぶん、"
    },
    {
      "t": 886.09,
      "s": "そう思っている方は多いんじゃないでしょうか。"
    },
    {
      "t": 890.09,
      "s": "ですが十王の順番では、閻魔王は五番目。"
    },
    {
      "t": 894.63,
      "s": "七つの関所のうちの五つ目です。"
    },
    {
      "t": 898.21,
      "s": "まだ先があるわけです。"
    },
    {
      "t": 900.84,
      "s": "その閻魔王の宮殿には、"
    },
    {
      "t": 903.04,
      "s": "鏡があるとされています。"
    },
    {
      "t": 905.44,
      "s": "浄玻璃の鏡といいます。"
    },
    {
      "t": 907.64,
      "s": "その人が生きているあいだにしてきたことが、"
    },
    {
      "t": 911.85,
      "s": "そのまま映ると書かれています。"
    },
    {
      "t": 914.85,
      "s": "六週目、四十二日目は変成王。"
    },
    {
      "t": 918.23,
      "s": "そして七週目、四十九日目。"
    },
    {
      "t": 921.36,
      "s": "最後の関所に立っているのは、"
    },
    {
      "t": 924.74,
      "s": "泰山王という王でした。"
    },
    {
      "t": 927.39,
      "s": "ここで、行き先が決まるとされています。"
    },
    {
      "t": 931.22,
      "s": "四十九日が満ちる日というのは、"
    },
    {
      "t": 934.25,
      "s": "そういう日だったんです。"
    },
    {
      "t": 936.67,
      "s": "では、行き先にはどんなものがあるのか。"
    },
    {
      "t": 941.17,
      "s": "六つある、とされています。六道です。"
    },
    {
      "t": 945.43,
      "s": "地獄道、餓鬼道、畜生道、修羅道、人間道、"
    },
    {
      "t": 949.65,
      "s": "天道。"
    },
    {
      "t": 950.28,
      "s": "この六つのどこかに、また生まれていく。"
    },
    {
      "t": 954.29,
      "s": "さきほどの『往生要集』が細かく描いたのは、"
    },
    {
      "t": 958.73,
      "s": "この六つの世界のほうでした。"
    },
    {
      "t": 961.68,
      "s": "ここで輪がつながります。"
    },
    {
      "t": 963.88,
      "s": "中陰というのは、"
    },
    {
      "t": 965.34,
      "s": "この六つのどこかへ戻っていくまでの、"
    },
    {
      "t": 968.64,
      "s": "あいだの時間だったわけです。"
    },
    {
      "t": 971.2,
      "s": "どこから来てどこへ行くのか。"
    },
    {
      "t": 973.76,
      "s": "答えは、同じ輪の上でした。"
    },
    {
      "t": 976.14,
      "s": "お棺にお金を入れる風習を、"
    },
    {
      "t": 978.64,
      "s": "ご覧になったことがあるかもしれません。"
    },
    {
      "t": 982.28,
      "s": "六文銭とか、六道銭と呼ばれるものです。"
    },
    {
      "t": 985.93,
      "s": "これはお経に書かれていることではありません。"
    },
    {
      "t": 989.67,
      "s": "民間の習わしです。"
    },
    {
      "t": 991.2,
      "s": "お金を納める習慣そのも"
    },
    {
      "t": 993.06,
      "s": "のは古くからありますが、"
    },
    {
      "t": 995.1,
      "s": "六枚と決まったのは、"
    },
    {
      "t": 996.8,
      "s": "だいぶあとの江戸時代のことでした。"
    },
    {
      "t": 999.69,
      "s": "何のためなのかも、一つに決まっていません。"
    },
    {
      "t": 1004.32,
      "s": "三途の川の渡し賃だという説。"
    },
    {
      "t": 1007.4,
      "s": "六道を行くあいだの路銀だという説。"
    },
    {
      "t": 1011.15,
      "s": "地蔵菩薩へのお賽銭だという説もあります。"
    },
    {
      "t": 1015.56,
      "s": "どれが本当かは、わかりません。ただ、"
    },
    {
      "t": 1018.74,
      "s": "どの説をとっても、"
    },
    {
      "t": 1020.33,
      "s": "中身は同じことを言っています。"
    },
    {
      "t": 1022.98,
      "s": "向こうで困らないように、という気持ちです。"
    },
    {
      "t": 1026.69,
      "s": "ここで、"
    },
    {
      "t": 1027.4,
      "s": "ひとつお伝えして"
    },
    {
      "t": 1028.83,
      "s": "おかなければならないことがあります。"
    },
    {
      "t": 1032.04,
      "s": "今お話ししてきた四十九日の旅は、"
    },
    {
      "t": 1034.9,
      "s": "日本のすべてのお宅に当て"
    },
    {
      "t": 1037.04,
      "s": "はまるものではありません。"
    },
    {
      "t": 1039.36,
      "s": "たとえば浄土真宗では、"
    },
    {
      "t": 1041.59,
      "s": "亡くなった方は阿弥陀仏の本願力によって、"
    },
    {
      "t": 1045.63,
      "s": "臨終と同時に極楽浄土へ往生すると説きます。"
    },
    {
      "t": 1049.88,
      "s": "ですから、"
    },
    {
      "t": 1050.9,
      "s": "七日ごとに裁かれる中陰と"
    },
    {
      "t": 1053.32,
      "s": "いう期間を立てません。"
    },
    {
      "t": 1055.55,
      "s": "もっとさかのぼれば、"
    },
    {
      "t": 1057.53,
      "s": "上座部仏教では、"
    },
    {
      "t": 1059.11,
      "s": "中有という期間があること"
    },
    {
      "t": 1061.49,
      "s": "自体を認めていません。"
    },
    {
      "t": 1063.67,
      "s": "どれが正しいという話を、"
    },
    {
      "t": 1065.89,
      "s": "私はするつもりがありません。ただ、"
    },
    {
      "t": 1069.03,
      "s": "同じ仏教のなかでも、"
    },
    {
      "t": 1070.87,
      "s": "あの世の見取り図はひとつではない。"
    },
    {
      "t": 1074.01,
      "s": "そのことは、"
    },
    {
      "t": 1075.12,
      "s": "知っておいてよいことだと思います。"
    },
    {
      "t": 1078.26,
      "s": "さて。"
    },
    {
      "t": 1078.94,
      "s": "ここまで読んできて、私は正直、"
    },
    {
      "t": 1082.36,
      "s": "少し気が重くなっていました。"
    },
    {
      "t": 1085.55,
      "s": "七つの関所。秤。鏡。"
    },
    {
      "t": 1087.8,
      "s": "衣を剥ぐ老夫婦。"
    },
    {
      "t": 1089.6,
      "s": "言ってしまえば、これは取り調べの連続です。"
    },
    {
      "t": 1094.32,
      "s": "あの人が、"
    },
    {
      "t": 1095.44,
      "s": "そんなところを歩いているのかと思うと、"
    },
    {
      "t": 1099.71,
      "s": "あまりいい気持ちはしませんでした。"
    },
    {
      "t": 1103.53,
      "s": "ところが、"
    },
    {
      "t": 1104.51,
      "s": "本のうしろのほうに、"
    },
    {
      "t": 1106.48,
      "s": "一覧表がついていたんです。"
    },
    {
      "t": 1109.03,
      "s": "十人の王の名前と、その横に、"
    },
    {
      "t": 1111.78,
      "s": "もう一つの名前が並んでいました。"
    },
    {
      "t": 1114.92,
      "s": "本地、と書いてあります。"
    },
    {
      "t": 1117.43,
      "s": "本の地と書いて、ほんじ。これは、"
    },
    {
      "t": 1120.78,
      "s": "その神さまや王の、"
    },
    {
      "t": 1122.67,
      "s": "本当の姿とされる仏のことです。この一覧も、"
    },
    {
      "t": 1127.06,
      "s": "日本で作られたお経で加わった部分です。"
    },
    {
      "t": 1131.04,
      "s": "最初の秦広王の本地は、不動明王。"
    },
    {
      "t": 1135.17,
      "s": "二番目の初江王は、釈迦如来。"
    },
    {
      "t": 1138.78,
      "s": "三番目の宋帝王は、文殊菩薩。"
    },
    {
      "t": 1142.4,
      "s": "四番目の五官王は、普賢菩薩。"
    },
    {
      "t": 1146.01,
      "s": "そして、五番目。"
    },
    {
      "t": 1147.66,
      "s": "閻魔王のところに、私は目が止まりました。"
    },
    {
      "t": 1151.77,
      "s": "地蔵菩薩、と書いてありました。"
    },
    {
      "t": 1154.33,
      "s": "お地蔵さんです。"
    },
    {
      "t": 1155.88,
      "s": "道ばたに立って、"
    },
    {
      "t": 1157.44,
      "s": "前掛けをかけてもらっている、"
    },
    {
      "t": 1160.15,
      "s": "あのお地蔵さん。"
    },
    {
      "t": 1161.71,
      "s": "日本でいちばん親しまれて"
    },
    {
      "t": 1164.03,
      "s": "いる菩薩だと思います。"
    },
    {
      "t": 1166.17,
      "s": "いちばん恐れられている王の本当の姿が、"
    },
    {
      "t": 1169.59,
      "s": "いちばん親しまれている仏だと"
    },
    {
      "t": 1172.11,
      "s": "書かれていたんです。"
    },
    {
      "t": 1173.91,
      "s": "私は、しばらくそのページを見ていました。"
    },
    {
      "t": 1177.61,
      "s": "これは、どういうことなんだろうと。"
    },
    {
      "t": 1180.75,
      "s": "つまり、こういうことになります。"
    },
    {
      "t": 1183.78,
      "s": "閻魔王が恐ろしい顔で問いただしているとき、"
    },
    {
      "t": 1187.77,
      "s": "その顔の下にいるのは、"
    },
    {
      "t": 1189.85,
      "s": "地蔵菩薩なんです。"
    },
    {
      "t": 1191.56,
      "s": "裁いている者と、"
    },
    {
      "t": 1193.24,
      "s": "救おうとしている者が、"
    },
    {
      "t": 1195.55,
      "s": "別人ではない。"
    },
    {
      "t": 1197.02,
      "s": "同じ一人だということです。"
    },
    {
      "t": 1199.75,
      "s": "思い返せば、"
    },
    {
      "t": 1200.97,
      "s": "あのお経の正式な名前も"
    },
    {
      "t": 1203.22,
      "s": "『地蔵菩薩発心因縁十王経』でした。"
    },
    {
      "t": 1206.68,
      "s": "十王の話なのに、頭に地蔵菩薩がついている。"
    },
    {
      "t": 1210.96,
      "s": "はじめから、そういうお経だったわけです。"
    },
    {
      "t": 1215.04,
      "s": "七番目の泰山王の本地は、薬師如来。"
    },
    {
      "t": 1218.93,
      "s": "病を癒やす仏です。"
    },
    {
      "t": 1220.99,
      "s": "そして十番目、"
    },
    {
      "t": 1222.59,
      "s": "いちばん最後の五道転輪王の本地は、"
    },
    {
      "t": 1226.48,
      "s": "阿弥陀如来でした。"
    },
    {
      "t": 1228.54,
      "s": "十人並んだ王たちの列は、"
    },
    {
      "t": 1231.12,
      "s": "名前だけ見れば裁く者の列です。"
    },
    {
      "t": 1234.34,
      "s": "ですが本地の側から見れば、"
    },
    {
      "t": 1237.13,
      "s": "はじめから終わりまで、全部、"
    },
    {
      "t": 1240.13,
      "s": "仏の列なんです。"
    },
    {
      "t": 1241.85,
      "s": "そしてもう一つ、"
    },
    {
      "t": 1243.27,
      "s": "辞典を読んでいて気づいたことがあります。"
    },
    {
      "t": 1246.83,
      "s": "中陰について書かれた説明に、"
    },
    {
      "t": 1249.32,
      "s": "こんな一節がありました。"
    },
    {
      "t": 1251.45,
      "s": "中陰のあいだに、"
    },
    {
      "t": 1253.15,
      "s": "残された家族が法要を"
    },
    {
      "t": 1255.28,
      "s": "営んで功徳を回し向ければ、"
    },
    {
      "t": 1258.05,
      "s": "罪は許される、と。"
    },
    {
      "t": 1259.96,
      "s": "これは、順序が大事なところです。"
    },
    {
      "t": 1263.35,
      "s": "七日ごとの法要というのは、"
    },
    {
      "t": 1266.11,
      "s": "裁判の日程表ではないんです。家族の側が、"
    },
    {
      "t": 1270.35,
      "s": "七日ごとに手を出せる、"
    },
    {
      "t": 1272.68,
      "s": "その仕組みのほうなんです。"
    },
    {
      "t": 1275.44,
      "s": "七回も裁きがあるということは、七回も、"
    },
    {
      "t": 1279.08,
      "s": "助けに行ける機会があるということでした。"
    },
    {
      "t": 1284.9,
      "s": "気がつくと、ずいぶん時間が経っていました。"
    },
    {
      "t": 1288.61,
      "s": "本を閉じて、"
    },
    {
      "t": 1290.16,
      "s": "私はもう一度、"
    },
    {
      "t": 1291.97,
      "s": "位牌の前に座り直しました。"
    },
    {
      "t": 1295.33,
      "s": "同じ座卓、同じ皿。"
    },
    {
      "t": 1297.65,
      "s": "ぼたもちは、まだそのままです。"
    },
    {
      "t": 1301.53,
      "s": "蝋燭だけが、短くなっていました。"
    },
    {
      "t": 1304.92,
      "s": "朝に言われた言葉を、"
    },
    {
      "t": 1307.04,
      "s": "私はもう一度思い出していました。"
    },
    {
      "t": 1310.43,
      "s": "今日で一区切りですよ、と。"
    },
    {
      "t": 1313.18,
      "s": "同じ言葉ですが、聞こえ方が変わっていました。"
    },
    {
      "t": 1317.84,
      "s": "じつは、"
    },
    {
      "t": 1318.57,
      "s": "この点について、"
    },
    {
      "t": 1320.04,
      "s": "はっきりそう書いている宗派があります。"
    },
    {
      "t": 1323.52,
      "s": "中陰の期間を立てない、あの浄土真宗です。"
    },
    {
      "t": 1327.18,
      "s": "本願寺派の説明に、こういう一文があります。"
    },
    {
      "t": 1331.03,
      "s": "中陰の法要は、"
    },
    {
      "t": 1332.31,
      "s": "亡くなった人のための追善ではなく、"
    },
    {
      "t": 1335.42,
      "s": "むしろ遺族自身が悲しみから立ち直って"
    },
    {
      "t": 1338.72,
      "s": "いくための機縁となる法要です、と。"
    },
    {
      "t": 1341.83,
      "s": "これは私の思いつきではありません。"
    },
    {
      "t": 1345.44,
      "s": "宗派がそう言っているんです。"
    },
    {
      "t": 1348.42,
      "s": "あの七日ごとの日程は、"
    },
    {
      "t": 1350.75,
      "s": "こちら側のための日程だ、と。"
    },
    {
      "t": 1353.73,
      "s": "言われてみると、思い当たることばかりでした。"
    },
    {
      "t": 1357.81,
      "s": "この四十九日のあいだ、"
    },
    {
      "t": 1359.84,
      "s": "七日ごとに誰かが来て、"
    },
    {
      "t": 1361.88,
      "s": "そのたびにお茶を出して、"
    },
    {
      "t": 1364.11,
      "s": "同じ話を何度もしました。"
    },
    {
      "t": 1366.33,
      "s": "悲しみが、七つに区切ってあったんです。"
    },
    {
      "t": 1370.03,
      "s": "一度に全部ではなく、"
    },
    {
      "t": 1371.98,
      "s": "次の区切りまで、"
    },
    {
      "t": 1373.54,
      "s": "とりあえずここまで。"
    },
    {
      "t": 1375.49,
      "s": "そういう歩き方になっていました。"
    },
    {
      "t": 1378.61,
      "s": "しかも、その区切りには終わりが宣言されます。"
    },
    {
      "t": 1383.28,
      "s": "満中陰。"
    },
    {
      "t": 1384.13,
      "s": "今日で忌明けですよ、という、あの言葉です。"
    },
    {
      "t": 1388.59,
      "s": "そして、"
    },
    {
      "t": 1389.42,
      "s": "そこでぷつりと切れるわけでもありません。"
    },
    {
      "t": 1393.6,
      "s": "百か日があり、一周忌があり、三回忌がある。"
    },
    {
      "t": 1397.98,
      "s": "間隔が少しずつ広がっていきます。"
    },
    {
      "t": 1401.32,
      "s": "急に手を離すのではなく、"
    },
    {
      "t": 1403.82,
      "s": "だんだん間を空けていく。"
    },
    {
      "t": 1406.33,
      "s": "十人の王が四十九日より先まで並んでいたのは、"
    },
    {
      "t": 1410.92,
      "s": "そういう形でもあったわけです。"
    },
    {
      "t": 1414.05,
      "s": "もちろん、"
    },
    {
      "t": 1414.88,
      "s": "これで悲しみがなくなると"
    },
    {
      "t": 1416.86,
      "s": "いう話ではありません。"
    },
    {
      "t": 1418.68,
      "s": "法要に出たからといって、"
    },
    {
      "t": 1420.67,
      "s": "癒えるとはかぎらない。"
    },
    {
      "t": 1422.49,
      "s": "そういうことを言うつもりはありません。"
    },
    {
      "t": 1425.63,
      "s": "ただ、"
    },
    {
      "t": 1426.24,
      "s": "人を一人きりにしない日程が、"
    },
    {
      "t": 1429.1,
      "s": "そこに組んである。"
    },
    {
      "t": 1430.94,
      "s": "それだけのことですが、"
    },
    {
      "t": 1433.19,
      "s": "それだけのことが、"
    },
    {
      "t": 1435.03,
      "s": "あの四十九日のあいだ、"
    },
    {
      "t": 1437.28,
      "s": "私を助けていました。"
    },
    {
      "t": 1439.32,
      "s": "もうひとつ、思ったことがあります。"
    },
    {
      "t": 1442.79,
      "s": "川を渡って向こう岸へ行く、という話は、"
    },
    {
      "t": 1446.66,
      "s": "日本だけのものではありません。"
    },
    {
      "t": 1449.72,
      "s": "古代の近東にも、"
    },
    {
      "t": 1451.35,
      "s": "ギリシアの神話にも、"
    },
    {
      "t": 1453.38,
      "s": "よく似た川が出てきます。"
    },
    {
      "t": 1455.83,
      "s": "たがいに関係があったかどうかは、"
    },
    {
      "t": 1458.8,
      "s": "わかりません。ただ、"
    },
    {
      "t": 1460.65,
      "s": "離れた土地の人が、"
    },
    {
      "t": 1462.32,
      "s": "それぞれに同じ形を思いついた。"
    },
    {
      "t": 1465.1,
      "s": "人が亡くなることを、"
    },
    {
      "t": 1466.95,
      "s": "消えてなくなることではなく、"
    },
    {
      "t": 1469.55,
      "s": "どこかへ向かう旅のほうだと"
    },
    {
      "t": 1471.96,
      "s": "考えてきたわけです。"
    },
    {
      "t": 1473.81,
      "s": "その向こう岸に本当に何があるのかを、"
    },
    {
      "t": 1477.11,
      "s": "私は知りません。"
    },
    {
      "t": 1478.57,
      "s": "お経にはこう書かれている、"
    },
    {
      "t": 1480.96,
      "s": "というところまでしか、"
    },
    {
      "t": 1482.97,
      "s": "私には言えません。"
    },
    {
      "t": 1484.62,
      "s": "ですが、わかったこともあります。"
    },
    {
      "t": 1487.69,
      "s": "この道を描いた人たちは、"
    },
    {
      "t": 1489.99,
      "s": "歩く人を一人にしない仕組みを、"
    },
    {
      "t": 1492.87,
      "s": "そこに書き込んでいました。"
    },
    {
      "t": 1495.37,
      "s": "七日ごとに手を合わせる場所を作り、"
    },
    {
      "t": 1498.53,
      "s": "いちばん恐ろしい王の下に、"
    },
    {
      "t": 1500.95,
      "s": "いちばん優しい仏を置いた。"
    },
    {
      "t": 1503.37,
      "s": "私はもう一度、位牌のほうを見ました。"
    },
    {
      "t": 1506.82,
      "s": "何も変わってはいません。ただ、"
    },
    {
      "t": 1509.7,
      "s": "自分がここに座っている理由が、"
    },
    {
      "t": 1512.58,
      "s": "朝よりは少しわかるようになっていました。"
    },
    {
      "t": 1516.42,
      "s": "四十九日は、終わりの日と呼ばれています。"
    },
    {
      "t": 1520.04,
      "s": "ですがあれは、"
    },
    {
      "t": 1521.31,
      "s": "送り出す側が、"
    },
    {
      "t": 1522.58,
      "s": "ゆっくり時間をかけて歩けるように"
    },
    {
      "t": 1525.47,
      "s": "区切られた道でもあったんです。"
    },
    {
      "t": 1528.19,
      "s": "何百年も前から、"
    },
    {
      "t": 1529.84,
      "s": "この国のたくさんの人が、"
    },
    {
      "t": 1532.31,
      "s": "同じ数の日を数えて、"
    },
    {
      "t": 1534.38,
      "s": "同じように座ってきました。"
    },
    {
      "t": 1537.06,
      "s": "今日も、どこかの家で誰かが座っています。"
    },
    {
      "t": 1541.18,
      "s": "蝋燭を消して、私は部屋を出ました。"
    },
    {
      "t": 1544.81,
      "s": "ぼたもちの皿は、明日の朝、"
    },
    {
      "t": 1547.58,
      "s": "片づけることにしました。"
    }
  ]
}