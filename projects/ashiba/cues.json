    },
    {
      "t": 701.21,
      "s": "男性だけを見ると、およそ四割です。"
    },
    {
      "t": 704.97,
      "s": "ほかの三か国は、だいたい一割台でした。"
    },
    {
      "t": 709.18,
      "s": "この数字を見て、"
    },
    {
      "t": 710.96,
      "s": "私は日本が寂しい国だとは思いませんでした。"
    },
    {
      "t": 715.64,
      "s": "思ったのは、もっと単純なことです。"
    },
    {
      "t": 719.43,
      "s": "五人に二人。"
