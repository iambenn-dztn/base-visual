    {
      "t": 725.31,
      "s": "定年のあと私と同じ席に座ることになります。"
    },
    {
      "t": 729.42,
      "s": "私ひとりの性格の話にしては、"
    },
    {
      "t": 732.43,
      "s": "人数が多すぎるんです。"
    },
    {
      "t": 734.8,
      "s": "先週も私は、あの定食屋に行きました。"
    },
    {
      "t": 739.14,
      "s": "同じ正午です。"
    },
    {
      "t": 740.83,
      "s": "同じ席で、同じ日替わりを頼みました。"
    },
    {
      "t": 745.17,
      "s": "まわりはやはりワイシャツで、"
    },
    {
      "t": 747.57,
      "s": "社員証が揺れていて、"
    },
    {
      "t": 749.29,
      "s": "社内の誰かの話でどっと笑っていました。"
    },
    {
      "t": 752.55,
      "s": "向かいの椅子も、空いたままです。"
    },
    {
      "t": 755.29,
      "s": "外のことは、"
    },
    {
      "t": 756.39,
      "s": "本当に何ひとつ変わっていないんです。"
    },
    {
      "t": 759.7,
      "s": "変わったのは、"
    },
    {
      "t": 761.08,
      "s": "そこに座っている私のほうでした。"
    },
    {
      "t": 764.25,
      "s": "自分が何を失ったのか、名前がわかったんです。"
    },
    {
      "t": 768.6,
      "s": "近くにいること。"
    },
    {
      "t": 770.09,
      "s": "約束せずに会ってしまうこと。"
    },
    {
      "t": 772.71,
      "s": "気を抜いて話せる場所。三つです。"
    },
    {
      "t": 775.69,
      "s": "どれも、私の中にあったものではありません。"
    },
    {
      "t": 779.62,
      "s": "私のまわりに、組んであったものです。"
    },
    {
      "t": 782.82,
      "s": "建物のほうは、立っています。"
    },
    {
      "t": 785.34,
      "s": "あのフィンランドの調査が数えたとおり、"
    },
    {
      "t": 788.77,
      "s": "いちばん内側の輪は、"
    },
    {
      "t": 790.57,
      "s": "減っていませんでした。"
    },
    {
      "t": 792.55,
      "s": "薄くなったのは外側です。"
    },
    {
      "t": 794.97,
      "s": "深いところではありませんでした。"
    },
    {
      "t": 798.19,
      "s": "店を出たのは、やはり十二時二十分でした。"
    },
    {
      "t": 802.53,
      "s": "日差しは相変わらず強くて、"
    },
    {
      "t": 805.36,
      "s": "影は足もとに短いままです。"
    },
    {
      "t": 808.18,
      "s": "午後は、まだ丸ごと残っています。"
    },
    {
      "t": 810.94,
      "s": "行かなければならない場所も、"
    },
    {
      "t": 813.36,
      "s": "やはりありません。"
    },
    {
      "t": 814.91,
      "s": "ですが、"
    },
    {
      "t": 815.67,
      "s": "あの日と違っていることが、"
    },
    {
      "t": 818.13,
      "s": "ひとつだけあります。"
    },
    {
      "t": 820.02,
      "s": "私はもう、自分を責めていませんでした。"
    },
    {
      "t": 825.11,
      "s": "友達を作る力が、"
    },
    {
      "t": 826.64,
      "s": "なくなったわけではないんです。"
    },
    {
      "t": 829.52,
      "s": "その仕事を、"
    },
    {
      "t": 830.62,
      "s": "四十年ものあいだ代わりに"
    },
    {
      "t": 832.81,
      "s": "やってくれていた足場が、"
    },
    {
      "t": 835,
      "s": "外されただけなんです。"
    }
  ]
