    },
    {
      "t": 593.07,
      "s": "そして退職の前後で、外側の輪が減りました。"
    },
    {
      "t": 597.86,
      "s": "減った数が、〇・六七人です。"
    },
    {
      "t": 601.05,
      "s": "一人にも、届いていません。"
    },
    {
      "t": 604.02,
      "s": "内側の輪と、中間の輪は。"
    },
    {
      "t": 606.27,
      "s": "ほとんど変わっていませんでした。"
    },
    {
      "t": 609.26,
      "s": "つまり、薄くなったのは外側だけだったんです。"
    },
    {
      "t": 613.57,
      "s": "深いところは、"
    },
    {
      "t": 614.94,
      "s": "定年をはさんでも、"
    },
    {
      "t": 616.7,
      "s": "そのままそこにありました。"
    },
    {
      "t": 619.26,
      "s": "もうひとつ、大事な発見があります。"
    },
    {
      "t": 622.91,
      "s": "その減り方が、いつ起きたか、です。"
