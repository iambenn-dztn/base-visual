    {
      "t": 626.55,
      "s": "外側が減ったのは、"
    },
    {
      "t": 628.32,
      "s": "退職をまたぐ時期だけでした。"
    },
    {
      "t": 631.07,
      "s": "そのあと一年半のあいだは、"
    },
    {
      "t": 633.62,
      "s": "〇・一人ほどしか動いていません。"
    },
    {
      "t": 636.76,
      "s": "誤差の範囲です。"
    },
    {
      "t": 638.34,
      "s": "もし年を取ることが原因なら、"
    },
    {
      "t": 640.85,
      "s": "減り続けるはずなんです。"
    },
    {
      "t": 642.99,
      "s": "年は取り続けるんですから。"
    },
    {
      "t": 645.31,
      "s": "ところが、止まりました。"
    },
    {
      "t": 647.49,
      "s": "ですから研究者たちは、"
    },
    {
      "t": 649.49,
      "s": "これは加齢によるものというより、"
    },
    {
      "t": 652.39,
      "s": "退職に結びついた変化だろう、"
    },
    {
      "t": 654.94,
      "s": "と書いています。"
    },
    {
      "t": 656.4,
      "s": "年を取ったから減ったのではない。"
    },
    {
      "t": 659.63,
      "s": "仕事をやめたから、その時だけ減った。"
    },
    {
      "t": 663.27,
      "s": "そして、そこで止まった。"
    },
    {
      "t": 665.69,
      "s": "もちろん、この調査にも限界があります。"
    },
    {
      "t": 669.43,
      "s": "対象はフィンランドの公務員で、"
    },
    {
      "t": 672.38,
      "s": "八割以上が女性でした。"
    },
    {
      "t": 674.54,
      "s": "日本の男には、"
    },
    {
      "t": 675.92,
      "s": "そのまま当てはまらない部分があります。"
    },
    {
      "t": 679.65,
      "s": "日本の数字もあります。内閣府が、"
