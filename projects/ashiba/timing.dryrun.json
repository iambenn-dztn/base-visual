{
  "slug": "ashiba",
  "fps": 30,
  "totalDuration": 851.28,
  "dryRun": true,
  "narration": null,
  "lang": "ja",
  "voice": {
    "provider": "gpt-sovits-local",
    "voice_name": "keita",
