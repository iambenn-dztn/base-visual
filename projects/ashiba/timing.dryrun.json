    "speed": 0.95,
    "seed": 42
  },
  "cues": [
    {
      "id": "C01",
      "chapter": "第1章 — 正午の定食屋",
      "text": "正午でした。会社から二つ先の通りにある、いつもの定食屋です。",
      "file": null,
      "start": 0,
      "duration": 6.12
    },
    {
      "id": "C02",
      "chapter": null,
      "text": "この店で、十何年もお昼を食べてきました。その日も、いつもの席で、いつもの日替わりを頼みました。",
      "file": null,
      "start": 6.12,
      "duration": 9.59
    },
    {
      "id": "C03",
      "chapter": null,
      "text": "違っていたのは、私がもう、あの会社の人間ではないということです。定年になって、ひと月が経っていました。",
      "file": null,
      "start": 15.71,
      "duration": 10.41
    },
    {
      "id": "C04",
      "chapter": null,
      "text": "まわりは、ワイシャツばかりです。首から社員証を下げた人たちが、四人掛けの席に詰めて座っています。",
      "file": null,
      "start": 26.12,
      "duration": 9.8
    },
    {
      "id": "C05",
      "chapter": null,
      "text": "話しているのは仕事のことです。納期がどうの、あの部署がどうの。そして、社内の人にしかわからない何かで、どっと笑うんです。",
      "file": null,
      "start": 35.92,
      "duration": 12.24
    },
    {
      "id": "C06",
      "chapter": null,
      "text": "私の向かいの椅子は、空いていました。",
      "file": null,
      "start": 48.16,
      "duration": 3.67
    },
    {
      "id": "C07",
      "chapter": null,
      "text": "そして私は、その店の誰よりも早く食べ終わってしまいました。話す相手がいないと、ごはんというのは、こんなに早く終わるんですね。",
      "file": null,
      "start": 51.83,
      "duration": 12.65
    },
    {
      "id": "C08",
      "chapter": null,
      "text": "店を出たのが、十二時二十分でした。日差しが強くて、影が足もとに短く落ちていました。",
      "file": null,
      "start": 65.68,
      "duration": 8.37
    },
    {
      "id": "C09",
      "chapter": null,
      "text": "午後が、まだ丸ごと残っています。行かなければならない場所は、どこにもありません。",
      "file": null,
      "start": 74.05,
      "duration": 8.16
    },
    {
      "id": "C10",
      "chapter": null,
      "text": "そのとき頭に浮かんだのは、さびしいという言葉ではありませんでした。もっと間の抜けた疑問です。",
      "file": null,
      "start": 82.21,
      "duration": 9.39
    },
    {
      "id": "C11",
      "chapter": null,
      "text": "私は昔、どうやって友達を作っていたんだろう、と。",
      "file": null,
      "start": 91.6,
      "duration": 4.9
    },
    {
      "id": "C12",
      "chapter": null,
      "text": "学生のころには、いました。会社に入ってからも、いました。時間だけなら、今のほうがはるかにあります。",
      "file": null,
      "start": 96.5,
      "duration": 10
    },
    {
      "id": "C13",
      "chapter": null,
      "text": "時間はあるのに、人が増えない。正直に言うと、私はこれを、自分の性格の問題だと思っていました。",
      "file": null,
      "start": 106.5,
      "duration": 9.39
    },
    {
      "id": "C14",
      "chapter": null,
      "text": "年を取って、人づきあいが下手になったんだろう、と。そう思って、しばらく調べてみたんです。",
      "file": null,
      "start": 115.89,
      "duration": 8.98
    },
    {
      "id": "C15",
      "chapter": null,
      "text": "ところが出てきたのは、性格の話ではありませんでした。条件の話だったんです。",
      "file": null,
      "start": 124.87,
      "duration": 7.55
    },
    {
      "id": "C16",
      "chapter": "第2章 — 三つの条件",
      "text": "アメリカに、レベッカ・アダムスという社会学者がいます。ノースカロライナ大学グリーンズボロ校で、人のつながりを長く研究してきた方です。",
      "file": null,
      "start": 132.42,
      "duration": 13.47
    },
    {
      "id": "C17",
      "chapter": null,
      "text": "ご自分の実験を発表したわけではありません。二十世紀の半ばから積み重なっていた研究を、まとめて整理したんです。",
      "file": null,
      "start": 145.89,
      "duration": 11.02
    },
    {
      "id": "C18",
      "chapter": null,
      "text": "そのまとめによると、親しい友人ができるには、三つの条件が要る。三つです。数えられます。",
      "file": null,
      "start": 156.91,
      "duration": 8.78
    },
    {
      "id": "C19",
      "chapter": null,
      "text": "ひとつめは、近接性。同じ場所に、繰り返し体が置かれていることです。",
      "file": null,
      "start": 165.69,
      "duration": 6.73
    },
    {
      "id": "C20",
      "chapter": null,
      "text": "ふたつめは、予定しない繰り返しの再会。約束しなくても、また顔を合わせてしまうことです。",
      "file": null,
      "start": 172.42,
      "duration": 8.78
    },
    {
      "id": "C21",
      "chapter": null,
      "text": "みっつめは、心を開いて話せる場。かしこまらなくていい場所があることです。",
      "file": null,
      "start": 181.2,
      "duration": 7.35
    },
    {
      "id": "C22",
      "chapter": null,
      "text": "ここで私は、手を止めました。この三つの中に、性格というものが、ひとつも入っていません。",
      "file": null,
      "start": 188.55,
      "duration": 8.78
    },
    {
      "id": "C23",
      "chapter": null,
      "text": "明るいとか、話がうまいとか。そういうものは、条件になっていないんです。",
      "file": null,
      "start": 197.33,
      "duration": 7.14
    },
    {
      "id": "C24",
      "chapter": null,
      "text": "書いてあるのは全部、その人のまわりの話でした。どこにいるか。誰と何度会うか。どんな場所か。つまり、環境の話です。",
      "file": null,
      "start": 204.47,
      "duration": 11.43
    },
    {
      "id": "C25",
      "chapter": null,
      "text": "それで私は、さっきの定食屋のことを、もう一度思い出しました。",
      "file": null,
      "start": 215.9,
      "duration": 6.12
    },
    {
      "id": "C26",
      "chapter": null,
      "text": "四人掛けに詰めて座っていたあの人たちは、同じ建物で働いています。ひとつめが、あります。",
      "file": null,
      "start": 222.02,
      "duration": 8.78
    },
    {
      "id": "C27",
      "chapter": null,
      "text": "誰も、今日ここで会おうと約束していません。昼になったから出てきて、たまたま一緒になっただけです。ふたつめも、あります。",
      "file": null,
      "start": 230.8,
      "duration": 12.04
    },
    {
      "id": "C28",
      "chapter": null,
      "text": "昼休みの定食屋は、上司も部下もネクタイをゆるめる場所です。社内の話で笑える場所です。みっつめも、あります。",
      "file": null,
      "start": 242.84,
      "duration": 10.82
    },
    {
      "id": "C29",
      "chapter": null,
      "text": "三つとも、そろっていました。私から二メートル離れたところに、三つとも、そろっていたんです。",
      "file": null,
      "start": 253.66,
      "duration": 9.18
    },
    {
      "id": "C30",
      "chapter": null,
      "text": "そして私の側には、ひとつもありませんでした。同じ店で、同じ時間に、同じものを食べていたのに、です。",
      "file": null,
      "start": 262.84,
      "duration": 10
    },
    {
      "id": "C31",
      "chapter": "第3章 — 足場",
      "text": "工事現場に、足場というものがありますね。建物のまわりに鉄パイプを組んで、人が上まで登れるようにする、あの仮設のやつです。",
      "file": null,
      "start": 272.84,
      "duration": 12.24
    },
    {
      "id": "C32",
      "chapter": null,
      "text": "調べていて思ったのは、会社とは、まさにあれだったな、ということでした。",
      "file": null,
      "start": 285.08,
      "duration": 7.14
    },
    {
      "id": "C33",
      "chapter": null,
      "text": "同じフロアに毎日いる。近接性です。廊下でもエレベーターでも顔が合ってしまう。予定しない再会です。",
      "file": null,
      "start": 292.22,
      "duration": 9.8
    },
    {
      "id": "C34",
      "chapter": null,
      "text": "そして仕事が終われば、一杯やる場所がある。あそこでは、みんな少し気を抜きます。心を開いて話せる場です。",
      "file": null,
      "start": 302.02,
      "duration": 10.41
    },
    {
      "id": "C35",
      "chapter": null,
      "text": "三つとも、会社が用意していました。しかも四十年間、毎日、無料でです。誰も、用意しているとは言いませんでした。",
      "file": null,
      "start": 312.43,
      "duration": 11.02
    },
    {
      "id": "C36",
      "chapter": null,
      "text": "言われないまま、そこにありました。足場というのは、そういうものです。組んである間は、誰も見ていません。",
      "file": null,
      "start": 323.45,
      "duration": 10.41
    },
    {
      "id": "C37",
      "chapter": null,
      "text": "そして足場は、一度に外れたわけではありませんでした。順番に、外れていったんです。",
      "file": null,
      "start": 333.86,
      "duration": 8.16
    },
    {
      "id": "C38",
      "chapter": null,
      "text": "最初に外れたのは、学校を出たときです。同じ教室に毎日いるという、あの近さがなくなりました。",
      "file": null,
      "start": 342.02,
      "duration": 9.18
    },
    {
      "id": "C39",
      "chapter": null,
      "text": "次は、転勤や引っ越しのときです。約束しなくても会えていた人たちが、約束しないと会えない人たちに変わります。",
      "file": null,
      "start": 351.2,
      "duration": 10.82
    },
    {
      "id": "C40",
      "chapter": null,
      "text": "そして定年です。定年の日には、三つが一度に外れます。同じ日に、まとめてです。",
      "file": null,
      "start": 362.02,
      "duration": 7.76
    },
    {
      "id": "C41",
      "chapter": null,
      "text": "行く場所がなくなり、たまたま会う人がいなくなり、気を抜いて話せる場所も消えました。三本の筋交いが、同じ日に地面に落ちたわけです。",
      "file": null,
      "start": 369.78,
      "duration": 13.06
    },
    {
      "id": "C42",
      "chapter": null,
      "text": "それなのに私は、落ちたのは自分のほうだと思っていました。",
      "file": null,
      "start": 382.84,
      "duration": 5.71
    },
    {
      "id": "C43",
      "chapter": null,
      "text": "もうひとつ、知らなかったことに行き当たりました。友達ができるまでの時間を、数えた人がいるんです。",
      "file": null,
      "start": 388.55,
      "duration": 9.8
    },
    {
      "id": "C44",
      "chapter": null,
      "text": "カンザス大学の、ジェフリー・ホールという研究者です。二〇一八年の論文の題が、こうです。友達を一人作るのに、何時間かかるのか。",
      "file": null,
      "start": 398.35,
      "duration": 12.65
    },
    {
      "id": "C45",
      "chapter": null,
      "text": "調べたのは二つの集まりです。知らない土地へ引っ越した大人が三百五十五人。入学したばかりの大学生が百十二人を、九週間追いかけました。",
      "file": null,
      "start": 411,
      "duration": 13.27
    },
    {
      "id": "C46",
      "chapter": null,
      "text": "出てきた数字が、こうです。ただの知り合いが、親しい知り合いになるまで、およそ五十時間。",
      "file": null,
      "start": 424.27,
      "duration": 8.78
    },
    {
      "id": "C47",
      "chapter": null,
      "text": "そこから友人と呼べるようになるまでが、およそ九十時間。そして親友と呼べるところまでは、二百時間を超えます。",
      "file": null,
      "start": 433.05,
      "duration": 10.82
    },
    {
      "id": "C48",
      "chapter": null,
      "text": "二百時間です。正直に言うと、ぞっとしました。週に一度、二時間ずつ会ったとして、二年かかる計算です。",
      "file": null,
      "start": 443.87,
      "duration": 10
    },
    {
      "id": "C49",
      "chapter": null,
      "text": "ところが、そのあとで気づきました。この二百時間を、私はもう払っていたんです。何度も。",
      "file": null,
      "start": 453.87,
      "duration": 8.57
    },
    {
      "id": "C50",
      "chapter": null,
      "text": "同じ部署に一年いれば、その人とは千時間を超えて同じ空間にいます。二百時間どころではありません。",
      "file": null,
      "start": 462.44,
      "duration": 9.59
    },
    {
      "id": "C51",
      "chapter": null,
      "text": "つまり、努力していたわけではないんです。会社に行っていたら、勝手に積み上がっていた。足場が、時間まで積んでくれていたわけです。",
      "file": null,
      "start": 472.03,
      "duration": 12.86
    },
    {
      "id": "C52",
      "chapter": null,
      "text": "ただ、正直に言っておかないといけません。ホール自身が、論文の中でわざわざ断っているんです。",
      "file": null,
      "start": 484.89,
      "duration": 9.18
    },
    {
      "id": "C53",
      "chapter": null,
      "text": "一緒に働いた時間は、一緒に遊んだ時間と同じには数えられない、と。会議で隣にいた三時間は、その人の人生の話を聞いた三時間ではありません。",
      "file": null,
      "start": 494.07,
      "duration": 13.67
    },
    {
      "id": "C54",
      "chapter": null,
      "text": "四十年働いたからといって、その分の親友がいるとは限りません。そこは私も、思い当たる節があります。",
      "file": null,
      "start": 507.74,
      "duration": 9.8
    },
    {
      "id": "C55",
      "chapter": null,
      "text": "数字そのものも、二つの調査から出した平均です。ここを超えたら友達、という関所はありません。",
      "file": null,
      "start": 517.54,
      "duration": 9.18
    },
    {
      "id": "C56",
      "chapter": null,
      "text": "アダムスの三条件も同じです。対照群を置いた実験ではなく、長年の研究を社会学者がまとめたものでした。",
      "file": null,
      "start": 526.72,
      "duration": 10
    },
    {
      "id": "C57",
      "chapter": null,
      "text": "ですから私は、これを法則だとは思っていません。ただ、外れた三本に名前がついた。それだけでも、ずいぶん違いました。",
      "file": null,
      "start": 536.72,
      "duration": 11.43
    },
    {
      "id": "C58",
      "chapter": "第4章 — 帰り道",
      "text": "それでも、疑問が残っていました。では結局、定年で人は何人いなくなるのか、ということです。",
      "file": null,
      "start": 548.15,
      "duration": 8.98
    },
    {
      "id": "C59",
      "chapter": null,
      "text": "これを実際に数えた調査がありました。フィンランドの、トゥルク大学のグループです。二〇二一年に発表されました。",
      "file": null,
      "start": 557.13,
      "duration": 11.02
    },
    {
      "id": "C60",
      "chapter": null,
      "text": "対象は二千三百十九人。定年を迎える人たちを、退職の前から後まで追いかけています。",
      "file": null,
      "start": 568.15,
      "duration": 8.16
    },
    {
      "id": "C61",
      "chapter": null,
      "text": "つながりは、三つの輪に分けて数えました。内側は、いなくなったら困る人たち。その外が、近しい人たち。いちばん外が、そこまで近くはない人たちです。",
      "file": null,
      "start": 576.31,
      "duration": 14.49
    },
    {
      "id": "C62",
      "chapter": null,
      "text": "退職する前の平均は、全部で二十一人と少し。内側が五人あまり、中間が七人ほど、外側が九人ほどでした。",
      "file": null,
      "start": 590.8,
      "duration": 10
    },
    {
      "id": "C63",
      "chapter": null,
      "text": "そして退職の前後で、外側の輪が減りました。減った数が、〇・六七人です。一人にも、届いていません。",
      "file": null,
      "start": 600.8,
      "duration": 9.8
    },
    {
      "id": "C64",
      "chapter": null,
      "text": "内側の輪と、中間の輪は。ほとんど変わっていませんでした。",
      "file": null,
      "start": 610.6,
      "duration": 5.71
    },
    {
      "id": "C65",
      "chapter": null,
      "text": "つまり、薄くなったのは外側だけだったんです。深いところは、定年をはさんでも、そのままそこにありました。",
      "file": null,
      "start": 616.31,
      "duration": 10.41
    },
    {
      "id": "C66",
      "chapter": null,
      "text": "もうひとつ、大事な発見があります。その減り方が、いつ起きたか、です。",
      "file": null,
      "start": 626.72,
      "duration": 6.94
    },
    {
      "id": "C67",
      "chapter": null,
      "text": "外側が減ったのは、退職をまたぐ時期だけでした。そのあと一年半のあいだは、〇・一人ほどしか動いていません。誤差の範囲です。",
      "file": null,
      "start": 633.66,
      "duration": 12.24
    },
    {
      "id": "C68",
      "chapter": null,
      "text": "もし年を取ることが原因なら、減り続けるはずなんです。年は取り続けるんですから。",
      "file": null,
      "start": 645.9,
      "duration": 7.96
    },
    {
      "id": "C69",
      "chapter": null,
      "text": "ところが、止まりました。ですから研究者たちは、これは加齢によるものというより、退職に結びついた変化だろう、と書いています。",
      "file": null,
      "start": 653.86,
      "duration": 12.45
    },
    {
      "id": "C70",
      "chapter": null,
      "text": "年を取ったから減ったのではない。仕事をやめたから、その時だけ減った。そして、そこで止まった。",
      "file": null,
      "start": 666.31,
      "duration": 9.39
    },
    {
      "id": "C71",
      "chapter": null,
      "text": "もちろん、この調査にも限界があります。対象はフィンランドの公務員で、八割以上が女性でした。日本の男には、そのまま当てはまらない部分があります。",
      "file": null,
      "start": 675.7,
      "duration": 14.49
    },
    {
      "id": "C72",
      "chapter": null,
      "text": "日本の数字もあります。内閣府が、六十歳以上の人を日本・アメリカ・ドイツ・スウェーデンで比べた調査。二〇二〇年の暮れの調査です。",
      "file": null,
      "start": 690.19,
      "duration": 12.86
    },
    {
      "id": "C73",
      "chapter": null,
      "text": "家族以外に親しい友人がいない、と答えた日本の人は、三十一・三パーセント。男性だけを見ると、およそ四割です。ほかの三か国は、だいたい一割台でした。",
      "file": null,
      "start": 703.05,
      "duration": 14.69
    },
    {
      "id": "C74",
      "chapter": null,
      "text": "この数字を見て、私は日本が寂しい国だとは思いませんでした。思ったのは、もっと単純なことです。",
      "file": null,
      "start": 717.74,
      "duration": 9.39
    },
    {
      "id": "C75",
      "chapter": null,
      "text": "五人に二人。あの定食屋にいた男の人たちのうち、二人くらいは、定年のあと私と同じ席に座ることになります。",
      "file": null,
      "start": 727.13,
      "duration": 10.41
    },
    {
      "id": "C76",
      "chapter": null,
      "text": "私ひとりの性格の話にしては、人数が多すぎるんです。",
      "file": null,
      "start": 737.54,
      "duration": 5.1
    },
    {
      "id": "C77",
      "chapter": null,
      "text": "先週も私は、あの定食屋に行きました。同じ正午です。同じ席で、同じ日替わりを頼みました。",
      "file": null,
      "start": 742.64,
      "duration": 8.78
    },
    {
      "id": "C78",
      "chapter": null,
      "text": "まわりはやはりワイシャツで、社員証が揺れていて、社内の誰かの話でどっと笑っていました。向かいの椅子も、空いたままです。",
      "file": null,
      "start": 751.42,
      "duration": 12.04
    },
    {
      "id": "C79",
      "chapter": null,
      "text": "外のことは、本当に何ひとつ変わっていないんです。",
      "file": null,
      "start": 763.46,
      "duration": 4.9
    },
    {
      "id": "C80",
      "chapter": null,
      "text": "変わったのは、そこに座っている私のほうでした。自分が何を失ったのか、名前がわかったんです。",
      "file": null,
      "start": 768.36,
      "duration": 9.18
    },
    {
      "id": "C81",
      "chapter": null,
      "text": "近くにいること。約束せずに会ってしまうこと。気を抜いて話せる場所。三つです。どれも、私の中にあったものではありません。",
      "file": null,
      "start": 777.54,
      "duration": 12.04
    },
    {
      "id": "C82",
      "chapter": null,
      "text": "私のまわりに、組んであったものです。",
      "file": null,
      "start": 789.58,
      "duration": 3.67
    },
    {
      "id": "C83",
      "chapter": null,
      "text": "建物のほうは、立っています。あのフィンランドの調査が数えたとおり、いちばん内側の輪は、減っていませんでした。",
      "file": null,
      "start": 793.25,
      "duration": 11.02
    },
    {
      "id": "C84",
      "chapter": null,
      "text": "薄くなったのは外側です。深いところではありませんでした。",
      "file": null,
      "start": 804.27,
      "duration": 5.71
    },
    {
      "id": "C85",
      "chapter": null,
      "text": "店を出たのは、やはり十二時二十分でした。日差しは相変わらず強くて、影は足もとに短いままです。",
      "file": null,
      "start": 809.98,
      "duration": 9.39
    },
    {
      "id": "C86",
      "chapter": null,
      "text": "午後は、まだ丸ごと残っています。行かなければならない場所も、やはりありません。",
      "file": null,
      "start": 819.37,
      "duration": 7.96
    },
    {
      "id": "C87",
      "chapter": null,
      "text": "ですが、あの日と違っていることが、ひとつだけあります。私はもう、自分を責めていませんでした。",
      "file": null,
      "start": 827.33,
      "duration": 9.39
    },
    {
      "id": "C88",
      "chapter": null,
      "text": "友達を作る力が、なくなったわけではないんです。",
      "file": null,
      "start": 838.22,
      "duration": 4.69
    },
    {
      "id": "C89",
      "chapter": null,
      "text": "その仕事を、四十年ものあいだ代わりにやってくれていた足場が、外されただけなんです。",
      "file": null,
      "start": 842.91,
      "duration": 8.37
    }
  ]
}