{
  "total": 804.88,
  "count": 298,
  "cues": [
    {
      "t": 0,
      "s": "目が覚めました。真っ暗です。"
    },
    {
      "t": 3.64,
      "s": "何の音もしていません。"
    },
    {
      "t": 6.5,
      "s": "枕元の時計を見ます。午前三時。"
    },
    {
      "t": 9.89,
      "s": "数字が赤くにじんで見えました。"
    },
    {
      "t": 13.29,
      "s": "今週、これで三度目です。"
    },
    {
      "t": 16,
      "s": "仰向けのまま、天井を見ていました。"
    },
    {
      "t": 19.5,
      "s": "カーテンの隙間から、"
    },
    {
      "t": 21.56,
      "s": "街灯の光が細く入ってきています。"
    },
    {
      "t": 24.85,
      "s": "天井を斜めに横切る、一本の帯になって。"
    },
    {
      "t": 28.77,
      "s": "何かあったわけではないんです。"
    },
    {
      "t": 31.56,
      "s": "昼間は普通でした。"
    },
    {
      "t": 33.23,
      "s": "仕事にも行きましたし、"
    },
    {
      "t": 35.27,
      "s": "人と笑って話もしました。"
    },
    {
      "t": 37.5,
      "s": "ただ、この時間になると、その考えが来る。"
    },
    {
      "t": 42.26,
      "s": "いつか自分にも終わりが来る、という、"
    },
    {
      "t": 46.55,
      "s": "あの考えです。"
    },
    {
      "t": 48.22,
      "s": "ずっと考えているわけではありません。"
    },
    {
      "t": 51.66,
      "s": "三十分ほどでしょうか。"
    },
    {
      "t": 53.77,
      "s": "やがてまた眠ります。"
    },
    {
      "t": 55.68,
      "s": "朝が来れば、忘れています。"
    },
    {
      "t": 58.17,
      "s": "それでも、また次の夜に来るんです。"
    },
    {
      "t": 61.8,
      "s": "若いころは、こんなことはありませんでした。"
    },
    {
      "t": 66.09,
      "s": "いつからでしょうか。"
    },
    {
      "t": 68.13,
      "s": "はっきりした境目は、思い出せません。"
    },
    {
      "t": 71.81,
      "s": "ただ、"
    },
    {
      "t": 72.43,
      "s": "ここ何年かのあいだに、"
    },
    {
      "t": 74.73,
      "s": "夜の三時という時間が、"
    },
    {
      "t": 77.02,
      "s": "そういう時間に変わってしまった。"
    },
    {
      "t": 80.35,
      "s": "それだけは確かなんです。"
    },
    {
      "t": 82.85,
      "s": "こういう話は、誰にもしません。"
    },
    {
      "t": 85.62,
      "s": "朝の食卓で言うようなことでもありませんし、"
    },
    {
      "t": 89.5,
      "s": "言ったところで、"
    },
    {
      "t": 90.98,
      "s": "心配をかけるだけですから。"
    },
    {
      "t": 93.38,
      "s": "ですから、"
    },
    {
      "t": 94.34,
      "s": "私はてっきり、"
    },
    {
      "t": 95.67,
      "s": "これは自分だけの夜だと思っていたんです。"
    },
    {
      "t": 99.5,
      "s": "不思議だったのは、その数日前のことでした。"
    },
    {
      "t": 104.53,
      "s": "父を病院へ送っていった帰りの車の中です。"
    },
    {
      "t": 109.32,
      "s": "父は八十を過ぎています。"
    },
    {
      "t": 112.2,
      "s": "その父が、"
    },
    {
      "t": 113.2,
      "s": "自分のあとのことを話しはじめました。"
    },
    {
      "t": 116.79,
      "s": "どこに入るか、誰に何を頼んであるか。淡々と。"
    },
    {
      "t": 121.19,
      "s": "屋根の修理の相談でもして"
    },
    {
      "t": 123.53,
      "s": "いるような調子でした。"
    },
    {
      "t": 125.68,
      "s": "運転しながら、"
    },
    {
      "t": 127.05,
      "s": "私はうまく相槌が打てませんでした。"
    },
    {
      "t": 130.37,
      "s": "おかしいと思いませんか。"
    },
    {
      "t": 132.54,
      "s": "年をとるほど、その日は近づいてくるはずです。"
    },
    {
      "t": 136.52,
      "s": "近いほうが、怖いはずでしょう。"
    },
    {
      "t": 139.24,
      "s": "なのに、"
    },
    {
      "t": 140.07,
      "s": "どうして父のほうが落ち着いているんでしょう。"
    },
    {
      "t": 144.66,
      "s": "夜中に目を覚ましているのは、"
    },
    {
      "t": 147.57,
      "s": "私のほうなんです。"
    },
    {
      "t": 150.93,
      "s": "誰か、これを測った人はいないだろうか。"
    },
    {
      "t": 154.49,
      "s": "そう思って調べはじめました。"
    },
    {
      "t": 157.12,
      "s": "ありました。二〇〇七年、"
    },
    {
      "t": 159.18,
      "s": "『デス・スタディーズ』という学術誌に載った、"
    },
    {
      "t": 162.97,
      "s": "ラサックたちの調査です。"
    },
    {
      "t": 165.02,
      "s": "十八歳から八十七歳まで、三百四人。"
    },
    {
      "t": 168.8,
      "s": "一人ひとりに尺度で答えてもらって、"
    },
    {
      "t": 172.59,
      "s": "年齢ごとに並べたものです。"
    },
    {
      "t": 175.48,
      "s": "私は、"
    },
    {
