    },
    {
      "t": 413.91,
      "s": "子どもたちに、"
    },
    {
      "t": 415.21,
      "s": "親はどれくらいだと思うかを答えてもらった。"
    },
    {
      "t": 419.09,
      "s": "八・一でした。親本人の四・〇の、倍です。"
    },
    {
      "t": 424.44,
      "s": "少し、飲み込むのに時間がかかりました。"
    },
    {
      "t": 427.41,
      "s": "もう一度言います。"
    },
    {
      "t": 428.81,
      "s": "いちばん静かだったのは親で、"
    },
    {
      "t": 431,
      "s": "その親をいちばん不安だと見ていたのは、"
    },
    {
      "t": 433.96,
      "s": "子どものほうだったんです。"
    },
    {
      "t": 435.99,
      "s": "親の不安をいちばん心配しているのは、"
    },
    {
      "t": 439.72,
      "s": "親ではない。"
    },
    {
      "t": 440.96,
      "s": "子どもなんです。"
    },
    {
      "t": 442.62,
      "s": "あの車の中で、"
    },
    {
      "t": 443.94,
      "s": "うまく相槌が打てなかったのは、"
    },
    {
      "t": 446.76,
      "s": "私のほうでした。"
    },
    {
      "t": 448.27,
      "s": "父ではありません。"
    },
    {
      "t": 449.96,
      "s": "父は、"
    },
    {
      "t": 450.53,
      "s": "言いにくい話をしていたのではなかったんです。"
    },
    {
      "t": 454.71,
      "s": "私が、聞きにくい話として受け取っていた。"
    },
    {
      "t": 458.52,
      "s": "それだけのことでした。"
    },
    {
      "t": 460.61,
      "s": "この研究には、もう一つ、"
    },
    {
      "t": 462.95,
      "s": "聞いておきたい発見があります。"
    },
    {
      "t": 465.88,
      "s": "高齢の方たちが「怖い」と答えたとき、"
    },
    {
      "t": 469.38,
      "s": "その中身です。"
    },
    {
      "t": 470.75,
      "s": "終わりそのもののことではありませんでした。"
    },
    {
      "t": 474.61,
      "s": "答えの多くが向いていたのは、"
    },
    {
      "t": 477.18,
      "s": "そこへ向かう過程に、"
    },
    {
      "t": 479.01,
      "s": "痛みがあるかどうかでした。"
    },
    {
      "t": 481.4,
      "s": "つまり、"
    },
    {
      "t": 482.17,
      "s": "二つの別々のものが、"
    },
    {
      "t": 484.08,
      "s": "一つの言葉に押し込められて"
    },
    {
      "t": 486.57,
      "s": "いたということです。"
    },
    {
      "t": 488.48,
      "s": "そして、これは大事な違いなんです。なぜなら、"
    },
    {
      "t": 492.62,
      "s": "痛みのことは、"
    },
    {
      "t": 493.94,
      "s": "尋ねられることだからです。"
    },
    {
      "t": 496.38,
      "s": "最期に苦しくないようにしてもらえるのか。"
    },
    {
      "t": 499.6,
      "s": "それは黙って耐える話ではなくて、"
    },
    {
      "t": 502.17,
      "s": "担当してくださる方がいて、"
    },
    {
      "t": 504.27,
      "s": "先に話しておける話なんです。"
    },
    {
      "t": 506.52,
      "s": "漠然と怖いものと、尋ねられるもの。"
    },
    {
      "t": 510.06,
      "s": "この二つを分けておくだけでも、"
    },
    {
      "t": 513.19,
      "s": "夜の重さは変わってくると思います。"
    },
    {
      "t": 517.72,
      "s": "では、なぜ年をとると線が下がるんでしょうか。"
    },
    {
      "t": 522.28,
      "s": "ここについては、一つの説明が出されています。"
    },
    {
      "t": 526.84,
      "s": "一九九九年、"
    },
    {
      "t": 528,
      "s": "カーステンセンたちが"
    },
    {
      "t": 529.93,
      "s": "『アメリカン・サイコロジスト』に"
    },
    {
      "t": 533.01,
      "s": "発表した考え方です。"
    },
    {
      "t": 534.94,
      "s": "先に断っておきますが、"
    },
    {
      "t": 537.01,
      "s": "これは不安を測った結果ではありません。"
    },
    {
      "t": 540.58,
      "s": "なぜそうなるのかを説明するために出された、"
    },
    {
      "t": 544.53,
      "s": "理論です。"
    },
    {
      "t": 545.47,
      "s": "言っていることは、こうです。人は、"
    },
    {
      "t": 548.68,
      "s": "残り時間をどう感じているかで、"
    },
    {
      "t": 551.51,
      "s": "何を大事にするかの順番を入れ替える。"
    },
    {
      "t": 554.91,
      "s": "残り時間が、"
    },
    {
      "t": 556.36,
      "s": "まだいくらでもあると感じられているとき。"
    },
    {
      "t": 561.21,
      "s": "人は、集めるほうを優先します。"
    },
    {
      "t": 564.85,
      "s": "知識、経験、新しい出会い。"
    },
    {
      "t": 568,
      "s": "広げていく方向です。"
    },
    {
      "t": 570.42,
      "s": "ところが、"
    },
    {
      "t": 571.35,
      "s": "残り時間が限られていると"
    },
    {
      "t": 573.59,
      "s": "感じられるようになると、"
    },
    {
      "t": 575.83,
      "s": "順番が入れ替わる。"
    },
    {
      "t": 577.51,
      "s": "先に来るのは、"
    },
    {
      "t": 578.82,
      "s": "いま目の前にある、"
    },
    {
      "t": 580.5,
      "s": "意味のあるもののほうなんです。"
    },
    {
      "t": 583.3,
      "s": "会う人の数は減るかもしれません。"
    },
    {
      "t": 586.65,
      "s": "ですが、その減り方が肝心です。"
    },
    {
      "t": 589.79,
      "s": "誰でもよかったのが、"
    },
    {
      "t": 591.88,
      "s": "この人でなければ困る、に変わる。"
    },
    {
      "t": 595.23,
      "s": "ここが、"
    },
    {
      "t": 595.93,
      "s": "私がいちばん取り違えていたところでした。"
    },
    {
      "t": 599.43,
      "s": "静かになった人を見て、私はずっと、"
    },
    {
      "t": 602.72,
      "s": "あきらめたのだと思っていたんです。"
    },
    {
      "t": 606.02,
      "s": "歳をとって、もう望まなくなったのだと。"
    },
    {
      "t": 609.71,
      "s": "この説明が正しいとすれば、逆です。"
    },
    {
      "t": 613.39,
      "s": "関心が消えたのではなくて、"
    },
    {
      "t": 616.2,
      "s": "関心を向ける先が入れ替わった、"
    },
    {
      "t": 619.45,
      "s": "ということになります。"
    },
    {
      "t": 621.83,
      "s": "あきらめではありません。"
    },
    {
      "t": 623.85,
      "s": "向きを変えただけなんです。"
    },
    {
      "t": 626.04,
      "s": "ここまで数字を並べてきましたので、"
    },
    {
      "t": 628.94,
      "s": "言っておかないといけないことが、"
    },
    {
      "t": 631.67,
      "s": "三つあります。"
    },
    {
      "t": 632.86,
      "s": "一つ。"
    },
    {
      "t": 633.43,
      "s": "これはあくまで、"
    },
    {
      "t": 634.94,
      "s": "大勢を並べたときに見えてくる傾向です。"
    },
    {
      "t": 638.53,
      "s": "一人ひとりに当てはまる決まりではありません。"
    },
    {
      "t": 642.68,
      "s": "八十歳で眠れない方もいます。"
    },
    {
      "t": 645.62,
      "s": "五十歳でもう静かな方もいます。"
    },
    {
      "t": 648.77,
      "s": "どちらも、おかしなことではないんです。"
    },
    {
      "t": 652.76,
      "s": "二つ。"
    },
    {
      "t": 653.43,
      "s": "シノフの研究は四十四組、一つの国の、"
    },
    {
      "t": 657.43,
      "s": "入院しておられた方が対象です。"
    },
    {
      "t": 660.76,
      "s": "数としては多くありません。"
    },
    {
      "t": 663.66,
      "s": "証明された、という言い方はできません。"
    },
    {
      "t": 667.88,
      "s": "三つ。"
    },
    {
      "t": 668.56,
      "s": "どちらの調査も、本人が自分で答える尺度です。"
    },
    {
      "t": 673.54,
      "s": "口に出せなかったものまでは、測れていません。"
    },
    {
      "t": 678.53,
      "s": "正直に言えば、"
    },
    {
      "t": 679.87,
      "s": "この三つ目が私には、"
    },
    {
      "t": 681.78,
      "s": "いちばん引っかかっています。"
    },
    {
      "t": 684.46,
      "s": "夜中のあの三十分を、"
    },
    {
      "t": 686.38,
      "s": "紙の上の数字で言い当て"
    },
    {
      "t": 688.48,
      "s": "られるとは思えませんから。"
    },
    {
      "t": 690.97,
      "s": "それでも、残るものがあります。"
    },
    {
      "t": 693.91,
      "s": "年齢とともに線が下がっていくという形は、"
    },
    {
      "t": 697.83,
      "s": "別々の調査で、"
    },
    {
      "t": 699.2,
      "s": "繰り返し出てきているんです。"
    },
    {
      "t": 703.91,
      "s": "また、目が覚めました。"
    },
    {
      "t": 706.77,
      "s": "同じ部屋です。"
    },
    {
      "t": 708.59,
      "s": "同じ天井です。"
    },
    {
      "t": 710.41,
      "s": "街灯の帯も、"
    },
    {
      "t": 711.61,
      "s": "同じところを斜めに横切っています。"
    },
    {
      "t": 715.02,
      "s": "何一つ、変わっていません。"
    },
    {
      "t": 717.62,
      "s": "変わったのは、"
    },
    {
      "t": 718.82,
      "s": "自分がどのあたりにいるのかが、"
    },
    {
      "t": 721.4,
      "s": "わかったことだけです。"
    },
    {
      "t": 723.3,
      "s": "私がいま立っているところは、"
    },
    {
      "t": 726.15,
      "s": "もう測られていました。"
    },
    {
      "t": 728.39,
      "s": "そして、そこから先にあるのは、下りなんです。"
    },
    {
      "t": 732.87,
      "s": "これは気休めではありません。"
    },
    {
      "t": 735.71,
      "s": "名前と年の付いた調査に、"
    },
    {
      "t": 738.15,
      "s": "そう出ている、"
    },
    {
      "t": 739.57,
      "s": "というだけのことです。"
    },
    {
      "t": 741.8,
      "s": "その下り坂の先にあるものも、"
    },
    {
      "t": 744.58,
      "s": "もうあきらめだとは思っていません。"
    },
    {
      "t": 747.95,
      "s": "向きが変わるだけなのだと、"
    },
    {
      "t": 750.53,
      "s": "いまは思っています。"
    },
    {
      "t": 752.52,
      "s": "そして、もう一つ。あの車の中の父です。"
    },
    {
      "t": 758.01,
      "s": "父は、何も隠していませんでした。"
    },
    {
      "t": 760.83,
      "s": "淡々としていたのは、"
    },
    {
      "t": 762.6,
      "s": "本当に淡々としていたからなんです。"
    },
    {
      "t": 765.59,
      "s": "つまり、先に通った人が、すぐ隣に座っている。"
    },
    {
      "t": 770.22,
      "s": "しかも、こちらから訊けるところにいるんです。"
    },
    {
      "t": 774.85,
      "s": "今度、車を出すときに訊いてみようと思います。"
    },
    {
      "t": 778.64,
      "s": "そちらはどうですか、と。"
    },
    {
      "t": 780.71,
      "s": "この夜が、自分だけの夜ではなかった。"
    },
    {
      "t": 784.94,
      "s": "それだけでも、"
    },
    {
      "t": 786.58,
      "s": "天井の見え方は少し違ってきます。"
    },
    {
      "t": 790.34,
      "s": "いちばん重い夜は、"
    },
    {
      "t": 791.93,
      "s": "もう後ろにあるのかもしれません。そして、"
    },
    {
      "t": 795.46,
      "s": "そのあとに来るものは、"
    },
    {
      "t": 797.4,
      "s": "あきらめではないんです。"
    },
    {
      "t": 799.53,
      "s": "ご不安が続くときは、"
    },
    {
      "t": 801.51,
      "s": "かかりつけの先生にご相談ください。"
    }
  ]
}