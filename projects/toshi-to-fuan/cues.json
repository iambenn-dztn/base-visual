    },
    {
      "t": 285.81,
      "s": "私は、坂を下っている途中だと思っていました。"
    },
    {
      "t": 290.44,
      "s": "年をとるにつれて、どんどん沈んでいくのだと。"
    },
    {
      "t": 295.07,
      "s": "そうではなかったんです。山の上、"
    },
    {
      "t": 298.13,
      "s": "あるいは山を越えたあたりに、いたんです。"
    },
    {
      "t": 301.96,
      "s": "山というのは、そういうものです。"
    },
    {
      "t": 304.7,
      "s": "上がったところがあるなら、"
    },
    {
      "t": 306.92,
      "s": "その先には必ず、"
    },
    {
      "t": 308.29,
      "s": "下りがあるということです。"
    },
    {
      "t": 310.5,
      "s": "実際、"
    },
    {
      "t": 311.14,
      "s": "この調査でいちばんはっきりしていたのは、"
    },
    {
      "t": 315.38,
      "s": "そこでした。"
    },
    {
      "t": 316.65,
      "s": "年齢とともに、線は下がっていく。"
    },
    {
      "t": 320.05,
      "s": "しかも、かなりはっきりと。"
    },
    {
      "t": 322.82,
      "s": "同じ論文には二つ目の調査もあって、"
    },
    {
      "t": 326.26,
      "s": "十八歳から八十五歳までの女性百十三人に、"
    },
    {
      "t": 330.3,
      "s": "別の尺度で答えてもらっています。"
    },
    {
      "t": 333.53,
      "s": "尺度を変えても、"
    },
    {
      "t": 335.38,
      "s": "人を変えても、"
    },
    {
      "t": 337,
      "s": "出てきた形は同じでした。"
    },
    {
      "t": 339.78,
      "s": "二つの山と、そのあとの長い下り。"
    },
    {
      "t": 343.49,
      "s": "つまり、"
    },
    {
      "t": 344.27,
      "s": "いちばん静かなのは、"
    },
    {
      "t": 346.22,
      "s": "いちばん年をとった人たちだった、"
    },
    {
      "t": 349.33,
      "s": "ということです。"
    },
    {
      "t": 350.88,
      "s": "父の、あの車の中の声を思い出しました。"
    },
    {
      "t": 354.35,
      "s": "あれは我慢していたわけでは"
    },
    {
      "t": 356.73,
      "s": "なかったのかもしれません。"
    },
    {
      "t": 360.6,
      "s": "それを、もっと直接に調べた研究があります。"
    },
    {
      "t": 364.8,
      "s": "二〇一七年、"
    },
    {
      "t": 366,
      "s": "『フロンティアズ・イン・メディシン』に載っ"
    },
    {
      "t": 370.21,
      "s": "た、"
    },
    {
      "t": 370.61,
      "s": "シノフという研究者の報告です。"
    },
    {
      "t": 373.61,
      "s": "イスラエルで、高齢の方と、"
    },
    {
      "t": 376.61,
      "s": "その成人した子ども。"
    },
    {
      "t": 378.91,
      "s": "同じ家の二人を、一組として調べました。"
    },
    {
      "t": 383.29,
      "s": "四十四組です。"
    },
    {
      "t": 384.9,
      "s": "両方に、"
    },
    {
      "t": 385.76,
      "s": "同じ十五点満点の尺度で答えてもらいます。"
    },
    {
      "t": 390.05,
      "s": "点が高いほど、"
    },
    {
      "t": 391.55,
      "s": "不安が強いということになります。"
    },
    {
      "t": 394.98,
      "s": "高齢のご本人の平均は、四・〇でした。"
    },
    {
      "t": 398.75,
      "s": "十五点のうち四です。"
    },
    {
      "t": 400.84,
      "s": "その子どもたちが、"
    },
    {
      "t": 402.72,
      "s": "自分自身について答えた点は、六・九。"
    },
    {
      "t": 406.49,
      "s": "親より高いんです。"
    },
    {
      "t": 408.37,
      "s": "そして、"
    },
    {
      "t": 409.11,
      "s": "この研究のいちばん大事なところは、"
