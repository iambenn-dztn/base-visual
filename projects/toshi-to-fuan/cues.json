    },
    {
      "t": 180.59,
      "s": "年をとるほど近づくのだから、不安も増える。"
    },
    {
      "t": 184.29,
      "s": "当たり前のように思えます。"
    },
    {
      "t": 186.58,
      "s": "違いました。"
    },
    {
      "t": 187.81,
      "s": "線はまっすぐではなかったんです。"
    },
    {
      "t": 191.09,
      "s": "山が、二つありました。"
    },
    {
      "t": 193.34,
      "s": "いちばん高いところは、二十代でした。"
    },
    {
      "t": 197.71,
      "s": "男性も、女性も、そこが最高地点です。"
    },
    {
      "t": 202.08,
      "s": "意外に聞こえるかもしれません。"
    },
    {
      "t": 205.03,
      "s": "二十代といえば、"
    },
    {
      "t": 206.61,
      "s": "そんなことを考える暇も"
    },
    {
      "t": 208.77,
      "s": "ない年頃のはずですから。"
    },
    {
      "t": 211.13,
      "s": "ですが、"
    },
    {
      "t": 211.91,
      "s": "思い返してみると、"
    },
    {
      "t": 213.68,
      "s": "心当たりのある方もいるのではないでしょうか。"
    },
    {
      "t": 217.99,
      "s": "眠れずに、天井を見ていた若い夜のことです。"
    },
    {
      "t": 222.1,
      "s": "あれは特別なことではなかったんです。"
    },
    {
      "t": 225.59,
      "s": "あの年代の山の上に、"
    },
    {
      "t": 227.53,
      "s": "みんな立っていた、"
    },
    {
      "t": 229.28,
      "s": "ということになります。"
    },
    {
      "t": 231.41,
      "s": "そこから線は下がります。"
    },
    {
      "t": 234.06,
      "s": "三十代、四十代。"
    },
    {
      "t": 235.83,
      "s": "低い窪みになります。"
    },
    {
      "t": 238.04,
      "s": "そして五十代。"
    },
    {
      "t": 239.73,
      "s": "ここでもう一度、線が上がるんです。"
    },
    {
      "t": 243.83,
      "s": "二つ目の山です。"
    },
    {
      "t": 245.76,
      "s": "ここは正確に言わないといけません。"
    },
    {
      "t": 248.89,
      "s": "この二つ目の山は、"
    },
    {
      "t": 250.54,
      "s": "女性のグループに見られたものです。"
    },
    {
      "t": 253.67,
      "s": "同じ調査で、"
    },
    {
      "t": 254.88,
      "s": "男性にはこの五十代の山は出ていません。"
    },
    {
      "t": 258.69,
      "s": "男性の線は、"
    },
    {
      "t": 259.9,
      "s": "二十代の山を越えたあと、"
    },
    {
      "t": 262.31,
      "s": "下がったままなんです。"
    },
    {
      "t": 264.51,
      "s": "ですから、"
    },
    {
      "t": 265.49,
      "s": "五十代になったら誰でも不安が跳ね上がる、"
    },
    {
      "t": 269.41,
      "s": "という話ではありません。"
    },
    {
      "t": 271.76,
      "s": "そう聞こえたなら、それは言いすぎです。"
    },
    {
      "t": 275.48,
      "s": "ここで私は、手が止まりました。"
    },
    {
      "t": 278.35,
      "s": "自分がどちらの説明に当てはまるにしても、"
    },
    {
