{
  "total": 806.29,
  "count": 310,
  "cues": [
    {
      "t": 0,
      "s": "火曜日の、午前十時のことです。"
    },
    {
      "t": 3.14,
      "s": "洗濯物を干し終えて、"
    },
    {
      "t": 5.24,
      "s": "私は六畳の部屋でアイロンをかけていました。"
    },
    {
      "t": 9.64,
      "s": "東向きの窓から、日が斜めに入ってきます。"
    },
    {
      "t": 14.18,
      "s": "畳の上に、窓枠の影が四角く落ちています。"
    },
    {
      "t": 18.71,
      "s": "その朝、"
    },
    {
      "t": 19.53,
      "s": "私は自分で決めて、"
    },
    {
      "t": 21.38,
      "s": "携帯電話の電源を切っていました。"
    },
    {
      "t": 24.67,
      "s": "今日はどこにも行かない。"
    },
    {
      "t": 27.13,
      "s": "誰にも会わない。"
    },
    {
      "t": 28.78,
      "s": "そう決めた日でした。"
    },
    {
      "t": 30.82,
      "s": "シャツを一枚ずつ畳んでいくと、"
    },
    {
      "t": 33.79,
      "s": "部屋の静けさが、"
    },
    {
      "t": 35.38,
      "s": "少しずつ体に染みてくるようでした。ああ、"
    },
    {
      "t": 39.34,
      "s": "いい時間だな、"
    },
    {
      "t": 40.73,
      "s": "と思ったのを覚えています。"
    },
    {
      "t": 44.79,
      "s": "その二日後の木曜日です。"
    },
    {
      "t": 47.15,
      "s": "同じ午前十時。同じ部屋で、"
    },
    {
      "t": 49.7,
      "s": "同じようにアイロンをかけていました。"
    },
    {
      "t": 53.23,
      "s": "日の入り方も、畳の影も、"
    },
    {
      "t": 55.78,
      "s": "火曜日とまったく同じです。"
    },
    {
      "t": 58.55,
      "s": "部屋には、私のほかに誰もいません。"
    },
    {
      "t": 62.17,
      "s": "それも同じでした。"
    },
    {
      "t": 64.08,
      "s": "違っていたのは、"
    },
    {
      "t": 65.58,
      "s": "前の晩にかかってきた一本の電話です。"
    },
    {
      "t": 68.96,
      "s": "昔からの友人と、この日、"
    },
    {
      "t": 71.22,
      "s": "会う約束をしていました。"
    },
    {
      "t": 73.47,
      "s": "急な用事ができたから、また今度にしてほしい。"
    },
    {
      "t": 78.64,
      "s": "よくあることです。"
    },
    {
      "t": 80.76,
      "s": "私も、いいよ、と言って電話を切りました。"
    },
    {
      "t": 85.45,
      "s": "それなのに、"
    },
    {
      "t": 86.6,
      "s": "その朝の部屋は、"
    },
    {
      "t": 88.13,
      "s": "なんというか、"
    },
    {
      "t": 89.47,
      "s": "どこか重たかったんです。静けさが、"
    },
    {
      "t": 92.72,
      "s": "染みてくるのではなく、"
    },
    {
      "t": 94.82,
      "s": "のしかかってくる感じがしました。"
    },
    {
      "t": 97.89,
      "s": "火曜日は心地よかった一人の時間が、木曜日は、"
    },
    {
      "t": 102.66,
      "s": "つらかった。部屋も、光も、"
    },
    {
      "t": 105.48,
      "s": "一人であることも、"
    },
    {
      "t": 107.43,
      "s": "何ひとつ変わっていないのにです。"
    },
    {
      "t": 110.89,
      "s": "同じ一人のはずなのに、"
    },
    {
      "t": 112.77,
      "s": "なぜこんなに違うんだろう。"
    },
    {
      "t": 114.99,
      "s": "アイロンを置いて、"
    },
    {
      "t": 116.53,
      "s": "私はしばらくそのことを考えていました。"
    },
    {
      "t": 119.78,
      "s": "実は、この違いを、"
    },
    {
      "t": 121.47,
      "s": "実験室で本当に測った人たちがいます。"
    },
    {
      "t": 124.85,
      "s": "その結果を、順番にたどってみたいと思います。"
    },
    {
      "t": 128.98,
      "s": "先に一つ、断っておきたいことがあります。"
    },
    {
      "t": 132.99,
      "s": "人の数と寂しさは別のものだ、"
    },
    {
      "t": 135.79,
      "s": "という研究は、"
    },
    {
      "t": 137.19,
      "s": "これまでにもたくさんあります。"
    },
    {
      "t": 140.2,
      "s": "ですが、"
    },
    {
      "t": 141.02,
      "s": "今日比べたいのは、"
    },
    {
      "t": 142.86,
      "s": "そこではありません。"
    },
    {
      "t": 144.91,
      "s": "人の数は、どちらもゼロ。"
    },
    {
      "t": 147.37,
      "s": "まったく同じ一人の時間どうしの違いなんです。"
    },
    {
      "t": 151.87,
      "s": "アメリカのロチェスター大学に、"
    },
    {
      "t": 154.41,
      "s": "一人の時間を専門に調べて"
    },
    {
      "t": 156.44,
      "s": "いる研究者がいました。"
    },
    {
      "t": 158.3,
      "s": "トゥイ・ヴィ・グエンさんという人です。"
    },
    {
      "t": 161.51,
      "s": "グエンさんは、"
    },
    {
      "t": 162.78,
      "s": "リチャード・ライアン、"
    },
    {
      "t": 164.78,
      "s": "エドワード・デシと"
    },
    {
      "t": 166.42,
      "s": "いう二人の心理学者と組んで、"
    },
    {
      "t": 168.97,
      "s": "四つの実験を行いました。"
    },
    {
      "t": 171.14,
      "s": "二千十八年に、"
    },
    {
      "t": 172.67,
      "s": "アメリカの社会心理学の専門誌に出た報告です。"
    },
    {
      "t": 177.48,
      "s": "題名を訳すと、"
    },
    {
      "t": 179.01,
      "s": "気持ちを整える方法としての一人の時間、"
    },
    {
      "t": 183.16,
      "s": "となります。"
    },
    {
      "t": 184.47,
      "s": "最初の実験は、とても簡単なものです。"
    },
    {
      "t": 188.46,
      "s": "大学の学生に、"
    },
    {
      "t": 190.01,
      "s": "座り心地のいい椅子に、"
    },
    {
      "t": 192.44,
      "s": "一人で十五分座ってもらう。"
    },
    {
      "t": 195.32,
      "s": "携帯電話は持ち込めません。"
    },
    {
      "t": 198.12,
      "s": "誰とも話さない。本もない。"
    },
    {
      "t": 200.92,
      "s": "ただ座っているだけです。"
    },
    {
      "t": 203.5,
      "s": "比べる相手として、"
    },
    {
      "t": 205.24,
      "s": "別の学生たちには、"
    },
    {
      "t": 206.98,
      "s": "同じ十五分を、"
    },
    {
      "t": 208.33,
      "s": "人と世間話をして過ごしてもらいました。"
    },
    {
      "t": 211.99,
      "s": "十五分の前と後で、"
    },
    {
      "t": 213.9,
      "s": "そのときの気持ちを細かく答えてもらいます。"
    },
    {
      "t": 218.35,
      "s": "わくわくする。"
    },
    {
      "t": 219.84,
      "s": "いらいらする。"
    },
    {
      "t": 221.32,
      "s": "落ちついている。"
    },
    {
      "t": 223.02,
      "s": "そういう項目です。"
    },
    {
      "t": 224.93,
      "s": "結果は、はっきりしていました。"
    },
    {
      "t": 227.55,
      "s": "一人で座っていた人たちだけ、"
    },
    {
      "t": 230,
      "s": "強い気持ちが静まっていたんです。"
    },
    {
      "t": 232.79,
      "s": "不安や怒りのような、強い嫌な気持ちが下がる。"
    },
    {
      "t": 237.59,
      "s": "ここまでは、予想どおりかもしれません。"
    },
    {
      "t": 241.74,
      "s": "ところが、"
    },
    {
      "t": 242.6,
      "s": "わくわくするような、"
    },
    {
      "t": 244.32,
      "s": "強いよい気持ちも、"
    },
    {
      "t": 245.86,
      "s": "同じように下がっていました。"
    },
    {
      "t": 248.27,
      "s": "一人でいると、"
    },
    {
      "t": 249.66,
      "s": "気持ちの針が、"
    },
    {
      "t": 251.05,
      "s": "よい方にも悪い方にも大きく振れなくなる。"
    },
    {
      "t": 255.01,
      "s": "研究では、これを、"
    },
    {
      "t": 256.79,
      "s": "気持ちを静める働きとして報告しています。"
    },
    {
      "t": 260.76,
      "s": "次の実験では、"
    },
    {
      "t": 262.17,
      "s": "一人の十五分に、"
    },
    {
      "t": 263.79,
      "s": "本を読むかどうかで違いが"
    },
    {
      "t": 266.21,
      "s": "出るかを確かめました。"
    },
    {
      "t": 268.44,
      "s": "結果は、同じでした。"
    },
    {
      "t": 270.14,
      "s": "本を読んでいても、"
    },
    {
      "t": 271.66,
      "s": "何もしなくても、"
    },
    {
      "t": 273.02,
      "s": "一人でいれば、"
    },
    {
      "t": 274.21,
      "s": "気持ちは静まっていったんです。"
    },
    {
      "t": 276.74,
      "s": "つまり、"
    },
    {
      "t": 277.36,
      "s": "この静まり方は、"
    },
    {
      "t": 278.59,
      "s": "何をするかで決まるのではありません。"
    },
    {
      "t": 281.38,
      "s": "一人でいること、"
    },
    {
      "t": 282.61,
      "s": "そのものが起こしているということです。"
    },
    {
      "t": 286.72,
      "s": "ここで、火曜日と木曜日のことを考えました。"
    },
    {
      "t": 291.05,
      "s": "静まる。それ自体は、"
    },
    {
      "t": 293.11,
      "s": "どちらの日にも起きていたはずです。"
    },
    {
      "t": 296.61,
      "s": "火曜日には、それが穏やかさとして届きました。"
    },
    {
      "t": 300.97,
      "s": "木曜日には、"
    },
    {
      "t": 302.16,
      "s": "張りが抜けて、"
    },
    {
      "t": 303.55,
      "s": "何もかも色が薄くなったように感じられた。"
    },
    {
      "t": 307.52,
      "s": "同じ静まり方が、"
    },
    {
      "t": 309.3,
      "s": "ある日は休息になり、"
    },
    {
      "t": 311.52,
      "s": "ある日は空っぽになる。"
    },
    {
      "t": 313.96,
      "s": "正直に言うと、私はここで少し混乱しました。"
    },
    {
      "t": 318.62,
      "s": "では、その差は、どこから来るのか。"
    },
    {
      "t": 321.68,
      "s": "グエンさんたちが三つ目の実験で確かめたのが、"
    },
    {
      "t": 325.63,
      "s": "まさにそこでした。"
    },
    {
      "t": 327.25,
      "s": "三つ目の実験でも、"
    },
    {
      "t": 329.37,
      "s": "学生たちは一人で十五分座ります。"
    },
    {
      "t": 333.15,
      "s": "違うのは、その十五分に、何を考えるかです。"
    },
    {
      "t": 338.1,
      "s": "ある人たちには、"
    },
    {
      "t": 339.61,
      "s": "楽しいことを考えてくださいと頼みました。"
    },
    {
      "t": 343.4,
      "s": "別の人たちには、"
    },
    {
      "t": 344.91,
      "s": "何を考えるかを、"
    },
    {
      "t": 346.43,
      "s": "自分で選んでもらいました。"
    },
    {
      "t": 348.88,
      "s": "すると、"
    },
    {
      "t": 349.59,
      "s": "この人たちでは、"
    },
    {
      "t": 351.02,
      "s": "わくわくするような強いよい気持ちが、"
    },
    {
      "t": 354.22,
      "s": "下がらなかったんです。"
    },
    {
      "t": 356.18,
      "s": "不安や怒りのほうは、ちゃんと静まる。"
    },
    {
      "t": 360.37,
      "s": "落ちつきは得られる。"
    },
    {
      "t": 362.69,
      "s": "それでいて、心の張りは失われない。"
    },
    {
      "t": 366.64,
      "s": "寂しさや悲しさも、増えませんでした。"
    },
    {
      "t": 371.99,
      "s": "四つ目の調査は、実験室の外です。"
    },
    {
      "t": 375.36,
      "s": "百五十人あまりの学生に、二週間、"
    },
    {
      "t": 378.72,
      "s": "ふだんの暮らしの中で、"
    },
    {
      "t": 381.04,
      "s": "一人の時間を毎日十五分ずつとって"
    },
    {
      "t": 384.41,
      "s": "もらいました。"
    },
    {
      "t": 385.88,
      "s": "そして、"
    },
    {
      "t": 386.65,
      "s": "その日の気持ちと一緒に、"
    },
    {
      "t": 388.94,
      "s": "なぜ一人でいたのかも書いてもらいます。"
    },
    {
      "t": 392.58,
      "s": "自分がそうしたかったからか。"
    },
    {
      "t": 395.25,
      "s": "それとも、そうするしかなかったからか。"
    },
    {
      "t": 398.89,
      "s": "自分から望んで一人でいたときほど、"
    },
    {
      "t": 401.9,
      "s": "人は落ちついて、"
    },
    {
      "t": 403.32,
      "s": "ストレスも軽くなっていました。"
    },
    {
      "t": 405.98,
      "s": "一人の時間が、"
    },
    {
      "t": 407.22,
      "s": "ちゃんと休息になっていたんです。"
    },
    {
      "t": 410.06,
      "s": "四つの実験をつなげると、"
    },
    {
      "t": 412.16,
      "s": "一つの言葉が浮かんできます。"
    },
    {
      "t": 414.6,
      "s": "研究者たちが中心に置いたのは、"
    },
    {
      "t": 417.22,
      "s": "自律性という言葉でした。"
    },
    {
      "t": 419.32,
      "s": "英語ではオートノミーといいます。"
    },
    {
      "t": 422.24,
      "s": "ライアンとデシは、"
    },
    {
      "t": 423.89,
      "s": "この言葉を柱に"
    },
    {
      "t": 425.17,
      "s": "した自己決定理論という考え方を、"
    },
    {
      "t": 428.09,
      "s": "四十年ほどかけて育ててきた人たちです。"
    },
    {
      "t": 431.56,
      "s": "自律性と聞くと、"
    },
    {
      "t": 433.18,
      "s": "一人で何でもできること、"
    },
    {
      "t": 435.62,
      "s": "と思うかもしれません。"
    },
    {
      "t": 437.85,
      "s": "実は、この理論での意味は少し違います。"
    },
    {
      "t": 441.71,
      "s": "自分のしていることを、"
    },
    {
      "t": 443.85,
      "s": "自分で納得して選んでいる感じ。"
    },
    {
      "t": 446.76,
      "s": "やらされているのではなく、"
    },
    {
      "t": 449.28,
      "s": "自分から向かっている感じ。"
    },
    {
      "t": 451.8,
      "s": "それを自律性と呼んでいるんです。"
    },
    {
      "t": 454.91,
      "s": "だから、"
    },
    {
      "t": 455.74,
      "s": "一人でいることと、自律性は、別の話です。"
    },
    {
      "t": 459.89,
      "s": "一人でも自律的でいられるし、"
    },
    {
      "t": 462.79,
      "s": "一人であることを押しつけられることもある。"
    },
    {
      "t": 468.63,
      "s": "ここで、"
    },
    {
      "t": 469.46,
      "s": "火曜日と木曜日が、"
    },
    {
      "t": 471.31,
      "s": "きれいに分かれました。"
    },
    {
      "t": 473.58,
      "s": "火曜日の一人は、私が選んだものでした。"
    },
    {
      "t": 477.5,
      "s": "電話を切ったのも、"
    },
    {
      "t": 479.36,
      "s": "どこにも行かないと決めたのも、私です。"
    },
    {
      "t": 483.28,
      "s": "木曜日の一人は、"
    },
    {
      "t": 484.96,
      "s": "選んだものではありませんでした。"
    },
    {
      "t": 488.31,
      "s": "予定が消えて、"
    },
    {
      "t": 489.77,
      "s": "そこにできた空白に、"
    },
    {
      "t": 491.87,
      "s": "私が落ちたんです。"
    },
    {
      "t": 493.75,
      "s": "部屋も、光も、一人であることも同じ。"
    },
    {
      "t": 497.61,
      "s": "違っていたのは、そこに入った道筋だけでした。"
    },
    {
      "t": 502.33,
      "s": "自分で入ったのか、落ちたのか。"
    },
    {
      "t": 505.55,
      "s": "一人の時間が心地よいか、つらいか。"
    },
    {
      "t": 508.8,
      "s": "それを分けていたのは、"
    },
    {
      "t": 510.91,
      "s": "一人であることそのものではなく、"
    },
    {
      "t": 513.97,
      "s": "それを自分で選んだかどうかだった、"
    },
    {
      "t": 517.22,
      "s": "ということです。"
    },
    {
      "t": 518.75,
      "s": "ライアンは、"
    },
    {
      "t": 519.86,
      "s": "この結果について、"
    },
    {
      "t": 521.53,
      "s": "自分から進んで一人になるとき、"
    },
    {
      "t": 524.3,
      "s": "得るものは大きい、"
    },
    {
      "t": 525.97,
      "s": "それは昔からの知恵でもあった、"
    },
    {
      "t": 528.75,
      "s": "と話しています。"
    },
    {
      "t": 530.23,
      "s": "一人が好きな性格の人だけの話では、"
    },
    {
      "t": 533.54,
      "s": "と思われるかもしれません。"
    },
    {
      "t": 536.07,
      "s": "私も最初はそう思いました。"
    },
    {
      "t": 538.6,
      "s": "ところが、"
    },
    {
      "t": 539.68,
      "s": "グエンさんたちは二千二十二年に、"
    },
    {
      "t": 543.13,
