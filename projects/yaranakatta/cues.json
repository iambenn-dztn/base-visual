    {
      "t": 383.02,
      "s": "その差は、"
    },
    {
      "t": 384.04,
      "s": "元の報告よりはっきり小さかった。"
    },
    {
      "t": 387.31,
      "s": "そして一つの実験では、"
    },
    {
      "t": 389.51,
      "s": "元の研究が示した形が、"
    },
    {
      "t": 391.71,
      "s": "見つからなかったんです。"
    },
    {
      "t": 395.58,
      "s": "翌年の二千二十三年。"
    },
    {
      "t": 397.52,
      "s": "今度は、元の研究者自身が動きました。"
    },
    {
      "t": 401.02,
      "s": "ギロビッチが、"
    },
    {
      "t": 402.38,
      "s": "ジェリー・リチャードソンと"
    },
    {
      "t": 404.9,
      "s": "いう研究者と組んで、"
    },
    {
      "t": 406.85,
      "s": "もう一度測り直したんです。"
    },
    {
      "t": 409.36,
      "s": "場所は、"
