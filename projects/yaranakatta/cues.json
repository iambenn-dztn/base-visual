  "cues": [
    {
      "t": 0,
      "s": "平日の、朝の九時すぎでした。"
    },
    {
      "t": 3.02,
      "s": "通勤の人波が引いたあとの、"
    },
    {
      "t": 5.82,
      "s": "少し静かな駅のホームです。"
    },
    {
      "t": 8.62,
      "s": "私は用事があって、"
    },
    {
      "t": 10.35,
      "s": "ひとつ先の町まで行くところでした。"
    },
    {
      "t": 13.62,
      "s": "ベンチの向かいの壁に、"
    },
    {
      "t": 15.74,
      "s": "旅行のポスターが貼ってありました。"
    },
    {
      "t": 19.01,
      "s": "紅葉の渓谷の写真です。"
    },
    {
      "t": 21.38,
      "s": "川の両岸が、赤と黄色で埋まっている。"
    },
    {
      "t": 25.26,
      "s": "その下に、"
    },
    {
      "t": 26.34,
      "s": "東北のある温泉地の名前がありました。"
    },
    {
      "t": 31.69,
      "s": "その名前を見たとき、頭の中で、"
    },
    {
      "t": 34.57,
      "s": "ある声がしました。"
    },
    {
      "t": 36.3,
      "s": "あの時、行っておけばよかった。"
    },
    {
      "t": 39.18,
      "s": "母と、いつか行こうと話していた場所なんです。"
    },
    {
      "t": 43.53,
      "s": "紅葉の時期に、二人で。"
    },
    {
      "t": 45.7,
      "s": "何度も話に出ました。"
    },
    {
      "t": 47.68,
      "s": "でも、一度も行きませんでした。"
    },
    {
      "t": 50.64,
      "s": "母が亡くなって、もう七年になります。"
    },
    {
      "t": 54.02,
      "s": "不思議なのは、"
    },
    {
      "t": 55.34,
      "s": "この声が初めてではないことでした。"
    },
    {
      "t": 58.53,
      "s": "何年たっても、"
    },
    {
      "t": 59.85,
      "s": "ふとした時に同じ言葉が戻ってくるんです。"
    },
    {
      "t": 63.61,
      "s": "一方で、私にも、"
    },
    {
      "t": 65.28,
      "s": "してしまった失敗はたくさんあります。"
    },
    {
      "t": 69.05,
      "s": "若いころ、勢いで口にしたきつい言葉。"
    },
    {
      "t": 72.81,
      "s": "考えなしに決めて、あとで困ったこと。"
    },
    {
      "t": 76.58,
      "s": "そういう失敗は、"
    },
    {
      "t": 78.23,
      "s": "思い出せば今でも少し恥ずかしい。"
    },
    {
      "t": 81.54,
      "s": "でも、なんというか、もう痛くはないんです。"
    },
    {
      "t": 85.88,
      "s": "いつのまにか、片がついている。"
    },
    {
      "t": 88.98,
      "s": "やらなかったことは消えずに残って、"
    },
    {
      "t": 92.32,
      "s": "やってしまったことは薄れていく。"
    },
    {
      "t": 95.47,
      "s": "なぜなんでしょう。"
    },
    {
      "t": 97.24,
      "s": "電車が入ってきました。"
    },
    {
      "t": 99.41,
      "s": "私は座席で、その続きを考えはじめました。"
    },
    {
      "t": 105.29,
      "s": "実は、"
    },
    {
      "t": 105.93,
      "s": "この問いには、"
    },
    {
      "t": 107.41,
      "s": "よく知られた答えがあるんです。"
    },
    {
      "t": 110.6,
      "s": "私も、どこかで読んで知っていました。"
    },
    {
      "t": 114.42,
      "s": "アメリカの心理学者、"
    },
    {
      "t": 116.31,
      "s": "トーマス・ギロビッチと、"
    },
    {
      "t": 118.58,
      "s": "ヴィクトリア・メドベック。"
    },
    {
      "t": 121.03,
      "s": "二人が千九百九十四年に発表した研究です。"
    },
    {
      "t": 124.81,
      "s": "もう三十年あまり前になります。"
    },
    {
      "t": 127.65,
      "s": "二人は、人に後悔を思い出してもらいました。"
    },
    {
      "t": 131.75,
      "s": "ただし、聞き方を二通りに分けたんです。"
    },
    {
      "t": 135.45,
      "s": "ひとつは、ごく最近の後悔。"
    },
    {
      "t": 138.08,
      "s": "この一週間で、一番悔やんでいることは何か。"
    },
    {
      "t": 142.33,
      "s": "もうひとつは、"
    },
    {
      "t": 143.74,
      "s": "人生全体を振り返って、"
    },
    {
      "t": 145.97,
      "s": "一番悔やんでいることは何か。"
    },
    {
      "t": 148.8,
      "s": "そして、出てきた後悔を二つに分けました。"
    },
    {
      "t": 152.88,
      "s": "何かをしてしまった後悔。"
    },
    {
      "t": 155.33,
      "s": "それから、何かをしなかった後悔です。"
    },
    {
      "t": 159,
      "s": "報告された形は、こうでした。"
    },
    {
      "t": 162.14,
      "s": "人生を振り返ったときの一番の後悔は、"
    },
    {
      "t": 166.17,
      "s": "しなかったことのほうが、"
    },
    {
      "t": 168.86,
      "s": "大きく上回った。"
    },
    {
      "t": 170.65,
      "s": "短い目で見ると、人は、"
    },
    {
      "t": 172.75,
      "s": "してしまったことを悔やみやすい。"
    },
    {
      "t": 175.79,
      "s": "長い目で見ると、"
    },
    {
      "t": 177.32,
      "s": "しなかったことを悔やみやすい。"
    },
    {
      "t": 180.17,
      "s": "時間がたつにつれて、"
    },
    {
      "t": 182.08,
      "s": "後悔の中身が入れ替わっていく、"
    },
    {
      "t": 184.94,
      "s": "ということです。"
    },
    {
      "t": 186.45,
      "s": "この研究は、"
    },
    {
      "t": 187.69,
      "s": "その後何十年も、"
    },
    {
      "t": 189.35,
      "s": "あちこちで引用されてきました。"
    },
    {
      "t": 192.47,
      "s": "後悔の話になると、まず出てくる研究なんです。"
    },
    {
      "t": 197.03,
      "s": "日本でも、似た言葉をよく耳にします。"
    },
    {
      "t": 200.68,
      "s": "やらずに後悔するより、やって後悔しろ。"
    },
    {
      "t": 204.52,
      "s": "聞いたことのある方も多いと思います。"
    },
    {
      "t": 208.18,
      "s": "では、なぜそんな入れ替わりが起きるのか。"
    },
    {
      "t": 212.43,
      "s": "翌年の千九百九十五年、"
    },
    {
      "t": 214.77,
      "s": "二人はその仕組みについて、"
    },
    {
      "t": 217.53,
      "s": "長い論文を書いています。"
    },
    {
      "t": 220.07,
      "s": "まず、してしまったことの後悔です。"
    },
    {
      "t": 223.32,
      "s": "これには、手の打ちようがあるんです。"
    },
    {
      "t": 226.76,
      "s": "謝ることができる。"
    },
    {
      "t": 228.48,
      "s": "やり直すことができる。"
    },
    {
      "t": 230.59,
      "s": "それに人は、失敗の中によかった点を探します。"
    },
    {
      "t": 234.95,
      "s": "あれで懲りたから、今の自分がある。"
    },
    {
      "t": 238.31,
      "s": "そう考えることで、"
    },
    {
      "t": 240.09,
      "s": "失敗には少しずつ区切りがついていくわけです。"
    },
    {
      "t": 244.44,
      "s": "ところが、"
    },
    {
      "t": 245.33,
      "s": "しなかったことには、"
    },
    {
      "t": 247.1,
      "s": "この手が使えません。"
    },
    {
      "t": 248.88,
      "s": "起きていないことは、謝りようも、"
    },
    {
      "t": 251.72,
      "s": "やり直しようもないからです。"
    },
    {
      "t": 254.21,
      "s": "もうひとつ、二人が挙げた仕組みがあります。"
    },
    {
      "t": 258.18,
      "s": "時間がたつと、"
    },
    {
      "t": 259.5,
      "s": "あの時ためらった理由のほうが、"
    },
    {
      "t": 262.33,
      "s": "見えにくくなるというんです。"
    },
    {
      "t": 264.97,
      "s": "当時は、怖さも迷いも、ちゃんとありました。"
    },
    {
      "t": 268.9,
      "s": "でも年月がたつと、それを忘れてしまう。"
    },
    {
      "t": 272.45,
      "s": "すると、"
    },
    {
      "t": 273.2,
      "s": "やればきっとうまくいった、"
    },
    {
      "t": 275.63,
      "s": "と思えてくるわけです。"
    },
    {
      "t": 277.69,
      "s": "二千三年には、"
    },
    {
      "t": 279.1,
      "s": "同じギロビッチたちが、日本、中国、"
    },
    {
      "t": 282.53,
      "s": "ロシアでも調べています。"
    },
    {
      "t": 284.95,
      "s": "長い目で見ると、"
    },
    {
      "t": 286.57,
