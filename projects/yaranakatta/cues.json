    {
      "t": 412.95,
      "s": "心理学を体験できる施設でした。"
    },
    {
      "t": 416.55,
      "s": "訪れた人に、その場で答えてもらう。"
    },
    {
      "t": 420.62,
      "s": "集まったのは二千六百人です。"
    },
    {
      "t": 423.97,
      "s": "元の研究で、"
    },
    {
      "t": 425.23,
      "s": "人生の後悔を聞いた相手は、"
    },
    {
      "t": 427.96,
      "s": "三十二人でした。"
    },
    {
      "t": 429.64,
      "s": "今回は、そのおよそ八十倍です。"
    },
    {
      "t": 432.79,
      "s": "人数が少ないと、"
    },
    {
      "t": 434.47,
      "s": "たまたまの偏りが大きく出ることがあるんです。"
    },
    {
      "t": 439.09,
      "s": "大事なのは、そのやり方です。この研究は、"
    },
    {
      "t": 443.19,
      "s": "結果が出る前に、"
    },
    {
      "t": 444.82,
      "s": "どう分析するかを決めていました。"
    },
    {
      "t": 448.09,
      "s": "雑誌の側も、"
    },
    {
      "t": 449.2,
      "s": "結果を見る前に、"
    },
    {
      "t": 450.67,
      "s": "載せることを約束する。"
    },
    {
      "t": 452.7,
      "s": "こうしておけば、"
    },
    {
      "t": 454.18,
      "s": "あとから都合のいい結果だけを"
    },
    {
      "t": 456.76,
      "s": "選ぶことができません。"
    },
    {
      "t": 458.79,
      "s": "自分の研究を測り直すには、"
    },
    {
      "t": 461.19,
      "s": "いちばん厳しいやり方なんです。"
    },
    {
      "t": 465.91,
      "s": "結果です。"
    },
    {
      "t": 466.86,
      "s": "ごく最近の後悔では、"
    },
    {
      "t": 468.76,
      "s": "してしまったことの後悔のほうが、"
    },
    {
      "t": 471.81,
      "s": "はっきり多く出ました。"
    },
    {
      "t": 473.9,
      "s": "では、"
    },
    {
      "t": 474.53,
      "s": "人生を振り返っての一番の後悔は、"
    },
    {
      "t": 477.91,
      "s": "どうだったか。"
    },
    {
      "t": 479.39,
      "s": "してしまったことが五十一パーセント。"
    },
    {
      "t": 483.2,
      "s": "しなかったことが、四十九パーセント。"
    },
    {
      "t": 487,
      "s": "ほぼ、半々でした。"
    },
    {
      "t": 491.08,
      "s": "統計の上では、差がないと言っていい数字です。"
    },
    {
      "t": 495.02,
      "s": "コインを投げて、"
    },
    {
      "t": 496.45,
      "s": "表と裏が出る割合と、"
    },
    {
      "t": 498.24,
      "s": "ほとんど変わらないということです。"
    },
    {
      "t": 501.28,
      "s": "人生で一番の後悔は、"
    },
    {
      "t": 503.14,
      "s": "しなかったことに大きく偏る。"
    },
    {
      "t": 505.75,
      "s": "有名だったその部分が、"
    },
    {
      "t": 507.8,
      "s": "今回は出てこなかったんです。"
    },
    {
      "t": 510.41,
      "s": "ただ、ここは正確にお伝えしておきます。"
    },
    {
      "t": 514.19,
      "s": "発見が丸ごと崩れたわけではありません。"
    },
    {
      "t": 517.97,
      "s": "最近の後悔では、してしまったことが多い。"
    },
    {
      "t": 521.75,
      "s": "長い目で見ると、"
    },
    {
      "t": 523.26,
      "s": "しなかったことが追いついてくる。"
    },
    {
      "t": 526.28,
      "s": "時間とともに後悔の中身が動いていく、"
    },
    {
      "t": 529.68,
      "s": "その傾きそのものは、"
    },
    {
      "t": 531.57,
      "s": "確かめられたんです。"
    },
    {
      "t": 533.46,
      "s": "崩れたのは、その先です。"
    },
    {
      "t": 535.65,
      "s": "人は結局、しなかったことばかりを悔やむ。"
    },
    {
      "t": 539.3,
      "s": "そう言い切れるほど、"
    },
    {
      "t": 541.13,
      "s": "強い偏りではなかったということです。"
    },
    {
      "t": 544.41,
      "s": "ギロビッチたちは論文の中で、"
    },
    {
      "t": 547.19,
      "s": "元の結果と形が違ったことを、"
    },
    {
      "t": 549.97,
      "s": "そのまま書いています。"
    },
    {
      "t": 552.15,
      "s": "三十年前の自分の発見を、"
    },
    {
      "t": 554.53,
      "s": "自分で測り直して、"
    },
    {
      "t": 556.32,
      "s": "違ったと書いたわけです。"
    },
    {
      "t": 558.71,
      "s": "正直に言うと、"
    },
    {
      "t": 560.1,
      "s": "私はこの論文を読んで、"
    },
    {
      "t": 562.27,
      "s": "しばらく考えこみました。"
    },
    {
      "t": 564.65,
      "s": "やらずに後悔するより、やって後悔しろ。"
    },
    {
      "t": 568.41,
      "s": "あの言葉を、"
    },
    {
      "t": 569.6,
      "s": "私はほとんど法則のように思っていたからです。"
    },
    {
      "t": 573.94,
      "s": "なぜ違いが出たのかは、はっきりしていません。"
    },
    {
      "t": 578.18,
      "s": "時代のせいか、"
    },
    {
      "t": 579.53,
      "s": "聞いた相手のせいか、"
    },
    {
      "t": 581.46,
      "s": "聞き方のせいか。"
    },
    {
      "t": 583,
      "s": "論文も、そこは決めきれていないんです。"
    },
    {
      "t": 586.66,
      "s": "日本で調べた二千三年の研究も、古い方法で、"
    },
    {
      "t": 591.1,
      "s": "少ない人数で測ったものです。"
    },
    {
      "t": 594.07,
      "s": "同じ規模と厳しさで、"
    },
    {
      "t": 596.18,
      "s": "日本で測り直した研究を、"
    },
    {
      "t": 598.72,
      "s": "私は見つけられませんでした。"
    },
    {
      "t": 601.69,
      "s": "この点は、私にはわかりません。"
    },
    {
      "t": 604.85,
      "s": "それでも、一つはっきりしたことがあります。"
    },
    {
      "t": 609.34,
      "s": "しなかった後悔が人生の後悔を占める、"
    },
    {
      "t": 613.18,
      "s": "という話は、"
    },
    {
      "t": 614.46,
      "s": "思われていたほど強くはなかった。"
    },
    {
      "t": 617.88,
      "s": "心理学の法則だ、"
    },
    {
      "t": 619.64,
      "s": "という響きが、"
    },
    {
      "t": 621.18,
      "s": "その話を実際よりも重く聞かせていたんです。"
    },
    {
      "t": 628.26,
      "s": "夕方、私は同じ駅に戻ってきました。"
    },
    {
      "t": 631.93,
      "s": "ホームには、帰りの人が増えはじめていました。"
    },
    {
      "t": 636.69,
      "s": "壁には、朝と同じポスターがあります。"
    },
    {
      "t": 641.46,
      "s": "赤と黄色の渓谷。"
    },
    {
      "t": 643.59,
      "s": "温泉地の名前。"
    },
    {
      "t": 645.44,
      "s": "あの時、行っておけばよかった。"
    },
    {
      "t": 649.42,
      "s": "声は、やはり聞こえました。"
    },
    {
      "t": 652.87,
      "s": "ただ、朝とは少し聞こえ方が違いました。"
    },
    {
      "t": 656.9,
      "s": "これは、人が逃れられない法則ではないんです。"
    },
    {
      "t": 661.57,
      "s": "誰にでもある、ひとつの後悔です。"
    },
    {
      "t": 664.96,
      "s": "ギロビッチたちの説明を、"
    },
    {
      "t": 667.05,
      "s": "もう一度思い出しました。"
    },
    {
      "t": 669.13,
      "s": "年月がたつと、"
    },
    {
      "t": 670.35,
      "s": "ためらった理由のほうが見えにくくなる。"
    },
    {
      "t": 673.65,
      "s": "思い返すと、あの秋、"
    },
    {
      "t": 675.51,
      "s": "母は膝を悪くしていました。"
    },
    {
      "t": 677.92,
      "s": "その宿は、長い石段の上にありました。"
    },
    {
      "t": 681.26,
      "s": "行かなかったのには、"
    },
    {
      "t": 683.12,
      "s": "行かなかったなりの理由が、"
    },
    {
      "t": 685.53,
      "s": "ちゃんとあったんです。"
    },
    {
      "t": 687.57,
      "s": "人生を振り返ったときの一番の後悔は、"
    },
    {
      "t": 690.66,
      "s": "してしまったことと、"
    },
    {
      "t": 692.38,
      "s": "しなかったことで、"
    },
    {
      "t": 693.93,
      "s": "ほぼ半分ずつ。"
    },
    {
      "t": 695.14,
      "s": "二千六百人に聞いて、"
    },
    {
      "t": 696.85,
      "s": "そうだったということです。"
    },
    {
      "t": 699.09,
      "s": "ホームで電車を待つ人たちにも、それぞれ、"
    },
    {
      "t": 702.92,
      "s": "そういう声が一つや二つあるのでしょう。"
    },
    {
      "t": 706.55,
      "s": "あの二千六百の答えの中にも、"
    },
    {
      "t": 709.23,
      "s": "私の後悔と同じ形のものが、"
    },
    {
      "t": 711.72,
      "s": "並んでいたのだと思います。"
    },
    {
      "t": 714.21,
      "s": "あの声が消えることは、たぶんないと思います。"
    },
    {
      "t": 718.41,
      "s": "ですが、"
    },
    {
      "t": 719.17,
      "s": "それは法則が決めた重さではありません。"
    },
    {
      "t": 722.8,
      "s": "人が持ち運べる、ふつうの重さなんです。"
    },
    {
      "t": 727.89,
      "s": "私はポスターの前で、少しだけ足を止めました。"
    },
    {
      "t": 732.01,
      "s": "それから、帰りの電車に乗りました。"
    }
  ]
}