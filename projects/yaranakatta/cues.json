    {
      "t": 332.41,
      "s": "同じ結果が出ないことがある。"
    },
    {
      "t": 335.29,
      "s": "そういう例が、次々に見つかったんです。"
    },
    {
      "t": 339.2,
      "s": "そこで、"
    },
    {
      "t": 340.01,
      "s": "名の知れた研究を、"
    },
    {
      "t": 341.83,
      "s": "改めて測り直す動きが起きました。"
    },
    {
      "t": 345.07,
      "s": "ギロビッチとメドベックの研究も、"
    },
    {
      "t": 348.31,
      "s": "その対象になりました。"
    },
    {
      "t": 350.54,
      "s": "二千二十二年。"
    },
    {
      "t": 351.86,
      "s": "香港大学のギラド・フェルドマンらのチームが、"
    },
    {
      "t": 356.01,
      "s": "結果を発表しました。"
    },
    {
      "t": 357.9,
      "s": "インターネットを通じて、"
    },
    {
      "t": 360.32,
      "s": "およそ千人のアメリカ人に、"
    },
    {
      "t": 362.93,
      "s": "元の研究と同じ形の質問をしたんです。"
    },
    {
      "t": 366.55,
      "s": "元の論文にあった実験を、"
    },
    {
      "t": 368.97,
      "s": "いくつもまとめて繰り返しました。"
    },
    {
      "t": 372.19,
      "s": "結果は、"
