    },
    {
      "t": 290.6,
      "s": "窓の外を、"
    },
    {
      "t": 291.59,
      "s": "刈り入れの済んだ田んぼが流れていきました。"
    },
    {
      "t": 295.76,
      "s": "私は、なるほどと思いました。"
    },
    {
      "t": 298.53,
      "s": "母との旅行は、まさにそれだったからです。"
    },
    {
      "t": 302.5,
      "s": "行かなかった旅は、終わっていない旅なんです。"
    },
    {
      "t": 306.65,
      "s": "終わっていないから、片がつかない。"
    },
    {
      "t": 309.86,
      "s": "私は長いあいだ、そう理解してきました。"
    },
    {
      "t": 315.4,
      "s": "ところが、この話には続きがありました。"
    },
    {
      "t": 318.82,
      "s": "私がそれを知ったのは、"
    },
    {
      "t": 320.81,
      "s": "ずっとあとになってからです。"
    },
    {
      "t": 323.34,
      "s": "心理学では、"
    },
    {
      "t": 324.58,
      "s": "この十年あまり、"
    },
    {
      "t": 326.23,
      "s": "ある反省が広がっています。"
    },
    {
      "t": 328.9,
      "s": "有名な実験を同じようにやり直すと、"
