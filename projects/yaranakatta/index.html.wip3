S('S34', 491.08, 501.28, function(u,T){    /* C43: tung đồng xu — sấp ngửa */
  setF(L_GOLD);
  setFork(FO, {L:[0.1,0.1], R:[0.1,0.1], T:0.0, cL:COL_AMB, cR:COL_WW});
  COIN.visible = true;
  var g = FO.at(0, 0.03); var gy = g.y - 0.01;
  var tA = 491.6, tL = 495.6, Tf = tL - tA;
  var yy, rx, tilt = 0, prec = 0;
  if(T < tA){ yy = gy + 0.0009; rx = 0; }
  else if(T < tL){ var tau = (T - tA)/Tf; yy = gy + 0.0009 + 0.16*4*tau*(1 - tau); rx = tau*Math.PI*2*7; }
  else { var d = T - tL; yy = gy + 0.0009 + 0.004*Math.abs(Math.sin(d*9))*Math.exp(-d*4); rx = 0; tilt = 0.32*Math.exp(-d*1.1); prec = d*(6 + 10*Math.exp(-d)); }
  COIN.position.set(g.x, yy + Math.sin(tilt)*0.0113, g.z);
  COIN.rotation.set(0,0,0);
  var q = new THREE.Quaternion().setFromAxisAngle(V3(1,0,0), rx);
  var qt = new THREE.Quaternion().setFromAxisAngle(V3(Math.cos(prec),0,Math.sin(prec)), tilt);
  COIN.quaternion.copy(qt.multiply(q));
  var ly = lerp(gy + 0.01, yy, 0.55);
  cam(g.x + 0.11, gy + 0.075 + (ly - gy)*0.5, g.z + 0.13, g.x, ly, g.z, 34, 0.01);
}, 0.35, 0.35);
