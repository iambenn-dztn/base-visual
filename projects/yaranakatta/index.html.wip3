S('S14', 159.0, 186.45, function(u,T){     /* C15–C16: hình dạng 1994 — gần: trái sáng; xa: phải rực */
  setF(L_GOLD);
  var a = ramp(T, 161.5, 166.0), b = ramp(T, 166.2, 170.0);
  var st = { L:[lerp(0.6,1.05,a), lerp(0.6,0.16,b)], R:[lerp(0.6,0.32,a), lerp(0.6,1.30,b)], T:0.42, cL:COL_AMB, cR:COL_BLU };
  var p1 = (T > 170.6 && T < 176) ? (T - 170.65)/5.0 : -1;
  var p2 = (T > 175.8 && T < 181) ? (T - 175.8)/5.0 : -1;
  st.pulse = T < 176 ? p1*0.5 : 0.35 + p2*0.6; st.pAmp = 0.5*(win(T,170.8,175.6,0.8) + win(T,176,181,0.8));
  setFork(FO, st);
  camLerpF([0,4.0,16, 0,0.3,-40, 48], [0,24,52, 0,-2,-50, 44], ease(u/27.4));
  kAt('lDid', win(T, 170.6, 185.8, 0.6), up(FO.at(1,0.25), 1.4));
  kAt('lDidnt', win(T, 170.6, 185.8, 0.6), up(FO.at(2,0.25), 1.4));
}, 0, 0.35);
S('S15', 186.45, 197.03, function(u,T){    /* C17: được trích dẫn khắp nơi — nhiều ngã rẽ nhỏ sáng lên */
