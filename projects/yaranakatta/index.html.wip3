var L_GORGE_E = { hs:[0.46,0.38,0.44], hg:[0.22,0.14,0.10], hi:0.5, sc:[1.0,0.50,0.22], si:2.2, sd:[-0.80,0.16,0.40],
  shc:[30,14,-120], shr:60, fc:[0.62,0.42,0.32], fd:0.0045,
  sky:[[0.18,0.20,0.38],[1.0,0.56,0.30],[0.26,0.16,0.12],[1.0,0.55,0.25]], sunSize:0.0012 };
var L_CORR = { hs:[0.10,0.10,0.12], hg:[0.05,0.04,0.04], hi:0.25, sc:[0,0,0], si:0.0, sd:[0,1,0],
  shc:[0,0,-30], shr:40, fc:[0.02,0.02,0.025], fd:0.035, sky:null };

/* Địa hình lưới + bộ lấy độ cao KHỚP ĐÚNG tam giác của mesh (đường mòn/cỏ/camera đặt lên
 * mặt lưới thật, không lệch nội suy — tránh đường mòn chìm dưới đất). */
function makeTerrain(S, N, zShift, fn){
  var seg = S/N, n1 = N+1, hs = new Float32Array(n1*n1);
  for(var iy=0; iy<n1; iy++) for(var ix=0; ix<n1; ix++){ hs[iy*n1+ix] = fn(-S/2 + ix*seg, -S/2 + iy*seg + zShift); }
  function h(x, z){
    var gx = (x + S/2)/seg, gz = (z - zShift + S/2)/seg;
    var ix = Math.floor(gx), iy = Math.floor(gz);
    if(ix < 0 || iy < 0 || ix >= N || iy >= N) return fn(x,z);
    var fx = gx - ix, fz = gz - iy;
    var ha = hs[iy*n1+ix], hb = hs[(iy+1)*n1+ix], hc = hs[(iy+1)*n1+ix+1], hd = hs[iy*n1+ix+1];
    if(fx + fz <= 1) return ha + (hd-ha)*fx + (hb-ha)*fz;
    return hc + (hb-hc)*(1-fx) + (hd-hc)*(1-fz);
  }
  /* PlaneGeometry: hàng iy chạy theo -y trước khi xoay → dựng index riêng khớp với h() */
  var pos = new Float32Array(n1*n1*3), idx = [];
  for(var iy2=0; iy2<n1; iy2++) for(var ix2=0; ix2<n1; ix2++){
    var k = iy2*n1+ix2; pos[k*3] = -S/2 + ix2*seg; pos[k*3+1] = hs[k]; pos[k*3+2] = -S/2 + iy2*seg + zShift;
  }
  for(var y=0; y<N; y++) for(var x=0; x<N; x++){
    var a = y*n1+x, b = (y+1)*n1+x, c = (y+1)*n1+x+1, d = y*n1+x+1;
    idx.push(a,b,d, b,c,d);
  }
  var g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.BufferAttribute(pos,3));
  g.setAttribute('uv', new THREE.BufferAttribute(new Float32Array(n1*n1*2).map(function(v,i){ var k=i>>1; return (i&1) ? Math.floor(k/n1)/N : (k%n1)/N; }),2));
  g.setIndex(idx); g.computeVertexNormals();
  return {geo:g, h:h};
}

/* =========================================================================
 * TIỆN ÍCH DỰNG
 * ========================================================================= */
var G = {};
function grp(name){ var g = new THREE.Group(); g.visible = false; scene.add(g); G[name] = g; return g; }
function std(o){ return new THREE.MeshStandardMaterial(o); }
function addBox(g, w,h,d, mat, x,y,z, cast, recv){
  var m = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), mat);
  m.position.set(x,y,z); m.castShadow = (cast !== false); m.receiveShadow = (recv !== false);
  g.add(m); return m;
}
function addPlane(g, w,h, mat, x,y,z, ry, rx){
  var m = new THREE.Mesh(new THREE.PlaneGeometry(w,h), mat);
  m.position.set(x,y,z); if(ry) m.rotation.y = ry; if(rx) m.rotation.x = rx;
  m.receiveShadow = true; g.add(m); return m;
}

/* =========================================================================
 * SÂN KHẤU P — SÂN GA (sáng 9 giờ / chiều muộn)
 * Toạ độ: mặt sân ga y=0, mép sân ga x=-1.75, đường ray tâm x=-3.3,
 * tường đối diện x=-7.2 (poster hộp đèn dán trên tường, nhìn về +x), dài theo z.
 * ========================================================================= */
var P = grp('P');
function concreteTex(base, seed, rep, streak){
  return canvasTex(512,512,function(cx,w,h){
    var r = HFA.mulberry32(seed);
    cx.fillStyle = base; cx.fillRect(0,0,w,h);
    for(var i=0;i<60;i++){ var x=r()*w, y=r()*h, rr=30+r()*120, g=cx.createRadialGradient(x,y,0,x,y,rr);
      var d = r()<0.5 ? '0,0,0' : '255,255,255'; g.addColorStop(0,'rgba('+d+','+(0.03+r()*0.05).toFixed(3)+')'); g.addColorStop(1,'rgba('+d+',0)');
      cx.fillStyle=g; cx.fillRect(x-rr,y-rr,rr*2,rr*2); }
    for(var k=0;k<9000;k++){ cx.fillStyle = 'rgba(' + (r()<0.5?'20,20,20':'240,240,240') + ',' + (r()*0.10).toFixed(3) + ')'; cx.fillRect(r()*w, r()*h, 1 + r()*1.5, 1 + r()*1.5); }
    if(streak){ for(var j=0;j<70;j++){ var sx=r()*w, sl=40+r()*260; var g2=cx.createLinearGradient(0,0,0,sl); g2.addColorStop(0,'rgba(30,26,22,'+(0.05+r()*0.08).toFixed(3)+')'); g2.addColorStop(1,'rgba(30,26,22,0)');
      cx.fillStyle=g2; cx.fillRect(sx,0,2+r()*6,sl); } }
  }, {repeat:rep});
}
var TX_CONC = concreteTex('#8b8781', 11, [2,40], false);
var TX_CONC2 = concreteTex('#7d7a74', 12, [25,1], true);
var TX_GRAVEL = noiseTex('#6b655d','30,28,26',512,512,13,26000,0.55,[3,70],4);
var TX_TACT = canvasTex(128,128,function(cx,w,h){
  cx.fillStyle='#caa21c'; cx.fillRect(0,0,w,h);
  for(var i=0;i<4;i++) for(var j=0;j<4;j++){
    var g = cx.createRadialGradient(16+i*32-4,16+j*32-4,1,16+i*32,16+j*32,11);
    g.addColorStop(0,'#f2d35a'); g.addColorStop(0.7,'#d7ae24'); g.addColorStop(1,'#9c7a12');
    cx.fillStyle=g; cx.beginPath(); cx.arc(16+i*32,16+j*32,10,0,6.2832); cx.fill();
  }
}, {repeat:[2.3,400]});
var mConc  = std({map:TX_CONC, roughness:0.93, metalness:0});
var mWall  = std({map:TX_CONC2, roughness:0.95, metalness:0});
var mGrav  = std({map:TX_GRAVEL, roughness:1.0});
var mTact  = std({map:TX_TACT, roughness:0.7});
var mWhite = std({color:0xdedad2, roughness:0.6});
var mSteel = std({color:0x8e9296, roughness:0.35, metalness:0.9});
var mRail  = std({color:0x6a615a, roughness:0.45, metalness:0.85});
var mSleep = std({color:0x6e6860, roughness:0.95});
var mRoof  = std({color:0xb8bab6, roughness:0.75, metalness:0.2});
var mPaint = std({color:0x5d6a66, roughness:0.55, metalness:0.4});
var mPlaster = std({color:0xa39c90, roughness:0.9});
var mDark  = std({color:0x1a1a1c, roughness:0.8});

addBox(P, 7.4, 1.1, 150, mConc, 1.95, -0.55, 0, false, true);          // bệ sân ga
addBox(P, 0.30, 0.012, 150, mTact, -1.0, 0.006, 0, false, true);        // gạch dẫn đường cho người khiếm thị
addBox(P, 0.07, 0.013, 150, mWhite, -1.52, 0.007, 0, false, true);      // vạch trắng mép
addBox(P, 0.18, 0.02, 150, std({color:0x9a968e, roughness:0.8}), -1.66, 0.01, 0, false, true);
addBox(P, 5.6, 0.2, 150, mGrav, -4.55, -1.2, 0, false, true);           // nền đá dăm
(function(){ /* tà vẹt + ray */
  var n = 250, geo = new THREE.BoxGeometry(2.1,0.14,0.22);
  var im = new THREE.InstancedMesh(geo, mSleep, n); var m4 = new THREE.Matrix4();
  for(var i=0;i<n;i++){ m4.makeTranslation(-3.3, -1.03, -75 + i*0.6); im.setMatrixAt(i, m4); }
  im.receiveShadow = true; P.add(im);
  addBox(P, 0.07, 0.16, 150, mRail, -3.84, -0.88, 0);
  addBox(P, 0.07, 0.16, 150, mRail, -2.76, -0.88, 0);
})();
addBox(P, 0.4, 3.7, 150, mWall, -7.45, 0.75, 0, true, true);           // tường chắn đối diện
addBox(P, 7.6, 0.18, 150, mRoof, 1.9, 3.36, 0, true, true);            // mái che
for(var _z=-70; _z<=70; _z+=10){
  var col = new THREE.Mesh(new THREE.CylinderGeometry(0.13,0.13,3.36,16), mPaint);
  col.position.set(2.7, 1.68, _z); col.castShadow = true; col.receiveShadow = true; P.add(col);
  addBox(P, 7.4, 0.28, 0.16, mPaint, 1.9, 3.13, _z);
}
var mFluo = std({color:0xffffff, emissive:new THREE.Color(0.95,0.98,1.0), emissiveIntensity:1.6, roughness:0.4});
for(var _z2=-72.5; _z2<=72.5; _z2+=5){
  addBox(P, 0.16, 0.06, 1.25, mFluo, -0.3, 3.22, _z2, false, false);
  addBox(P, 0.16, 0.06, 1.25, mFluo, 3.6, 3.22, _z2, false, false);
}
addBox(P, 0.2, 3.36, 150, mPlaster, 5.7, 1.68, 0);                     // tường nhà ga phía sau
/* nhà thấp tầng sau tường đối diện */
(function(){
  var r = HFA.mulberry32(77);
  var TXW = canvasTex(256,256,function(cx,w,h){
    cx.fillStyle='#b8b0a4'; cx.fillRect(0,0,w,h);
    for(var y=16;y<h;y+=64) for(var x=12;x<w;x+=52){ cx.fillStyle='rgba(40,46,56,0.85)'; cx.fillRect(x,y,34,36); cx.fillStyle='rgba(200,210,220,0.25)'; cx.fillRect(x,y,34,6); }
  }, {repeat:[1,1]});
  for(var i=0;i<46;i++){
    var hgt = 6 + r()*16, wd = 8 + r()*10, dp = 8 + r()*10;
    var col = new THREE.Color().setHSL(0.08 + r()*0.05, 0.08 + r()*0.08, 0.55 + r()*0.2);
    var m = std({map:TXW, color:col, roughness:0.9});
    var b = addBox(P, dp, hgt, wd, m, -18 - r()*50, hgt/2 - 1.1, -75 + i*3.4 + r()*2, false, true);
  }
})();

/* ---- poster hộp đèn ---- */
function paintGorge(cx,w,h,withText){
  var r = HFA.mulberry32(2024);
  var ph = withText ? h*0.76 : h;
  var g = cx.createLinearGradient(0,0,0,ph*0.45);
  g.addColorStop(0,'#9fc3e2'); g.addColorStop(1,'#eef1ee');
  cx.fillStyle = g; cx.fillRect(0,0,w,ph);
  /* núi xa */
  cx.fillStyle = '#8c98a8';
  cx.beginPath(); cx.moveTo(0,ph*0.30);
  for(var x=0;x<=w;x+=8){ cx.lineTo(x, ph*0.26 + Math.sin(x*0.006)*ph*0.05 + Math.sin(x*0.021)*ph*0.015); }
  cx.lineTo(w,ph); cx.lineTo(0,ph); cx.fill();
  /* hai sườn thung lũng */
  function slope(side){
    cx.save(); cx.beginPath();
    if(side<0){ cx.moveTo(0,ph*0.22); cx.bezierCurveTo(w*0.25,ph*0.30, w*0.40,ph*0.62, w*0.47,ph); cx.lineTo(0,ph); }
    else { cx.moveTo(w,ph*0.18); cx.bezierCurveTo(w*0.76,ph*0.28, w*0.60,ph*0.60, w*0.54,ph); cx.lineTo(w,ph); }
    cx.closePath(); cx.fillStyle='#5a3a22'; cx.fill(); cx.clip();
    var cols = ['#b3261a','#c9391c','#d8601e','#e08a24','#e9b42c','#d9c248','#7a2a18','#51602c','#3f4a26'];
    var wts  = [ 0.16,     0.14,     0.16,     0.14,     0.14,     0.07,     0.08,     0.06,     0.05 ];
    for(var i=0;i<16000;i++){
      var px = r()*w, py = ph*0.18 + r()*ph*0.84;
      var q = r(), k = 0; while(q > wts[k] && k < wts.length-1){ q -= wts[k]; k++; }
      var sz = 3 + r()*7*(0.5 + py/ph);
      cx.fillStyle = cols[k]; cx.globalAlpha = 0.85;
      cx.beginPath(); cx.arc(px,py,sz,0,6.2832); cx.fill();
    }
    cx.globalAlpha = 1;
    var sh = cx.createLinearGradient(side<0?0:w,0,w*0.5,0);
    sh.addColorStop(0,'rgba(0,0,0,0)'); sh.addColorStop(1,'rgba(20,8,4,0.35)');
    cx.fillStyle = sh; cx.fillRect(0,0,w,ph);
    cx.restore();
  }
  slope(-1); slope(1);
  /* sông */
  cx.beginPath(); cx.moveTo(w*0.49,ph*0.62);
  cx.bezierCurveTo(w*0.52,ph*0.75, w*0.44,ph*0.86, w*0.40,ph);
  cx.lineTo(w*0.62,ph); cx.bezierCurveTo(w*0.56,ph*0.86, w*0.55,ph*0.74, w*0.51,ph*0.62); cx.closePath();
  var rg = cx.createLinearGradient(0,ph*0.62,0,ph); rg.addColorStop(0,'#9fb9c4'); rg.addColorStop(1,'#4f7f8c');
  cx.fillStyle = rg; cx.fill();
  cx.strokeStyle = 'rgba(255,255,255,0.55)'; cx.lineWidth = 2;
  for(var j=0;j<40;j++){ var yy = ph*0.66 + r()*ph*0.33; var xx = w*0.44 + r()*w*0.14 - (yy-ph*0.66)*0.12;
    cx.beginPath(); cx.moveTo(xx,yy); cx.lineTo(xx + 10 + r()*24, yy + 1); cx.stroke(); }
  /* sương mỏng */
  var mg = cx.createLinearGradient(0,ph*0.48,0,ph*0.66);
  mg.addColorStop(0,'rgba(255,255,255,0)'); mg.addColorStop(0.5,'rgba(255,255,255,0.28)'); mg.addColorStop(1,'rgba(255,255,255,0)');
  cx.fillStyle = mg; cx.fillRect(0,ph*0.48,w,ph*0.18);
  if(withText){
    cx.fillStyle = '#f5f0e6'; cx.fillRect(0,ph,w,h-ph);
    cx.fillStyle = '#9b2a1c'; cx.fillRect(0,ph,w,8);
    cx.fillStyle = '#2a211c'; cx.textBaseline = 'middle';
    cx.font = '700 84px ' + JP_FONT; cx.fillText('紅葉の渓谷へ', 70, ph + (h-ph)*0.40);
    cx.font = '700 50px ' + JP_FONT; cx.fillStyle = '#6b3a26'; cx.fillText('みちのく　湯ノ瀬温泉', 74, ph + (h-ph)*0.78);
    cx.font = '400 30px ' + JP_FONT; cx.fillStyle = '#6b5e52'; cx.textAlign = 'right';
    cx.fillText('見頃　十月下旬〜十一月上旬', w-60, ph + (h-ph)*0.78); cx.textAlign = 'left';
  }
}
var TX_POSTER = textCanvasTex(1456, 1030, function(cx,w,h){ paintGorge(cx,w,h,true); });
function genericPoster(seed, kind){
  return canvasTex(728, 515, function(cx,w,h){
    var r = HFA.mulberry32(seed), g;
    if(kind===0){ g=cx.createLinearGradient(0,0,0,h); g.addColorStop(0,'#5c9fd6'); g.addColorStop(0.55,'#cfe6f0'); g.addColorStop(0.56,'#2c78a6'); g.addColorStop(1,'#123e62');
      cx.fillStyle=g; cx.fillRect(0,0,w,h); cx.fillStyle='rgba(255,255,255,0.8)'; for(var i=0;i<60;i++){ cx.fillRect(r()*w, h*0.58 + r()*h*0.4, 8+r()*30, 2); } }
    else if(kind===1){ g=cx.createLinearGradient(0,0,0,h); g.addColorStop(0,'#1d2346'); g.addColorStop(1,'#d9825a'); cx.fillStyle=g; cx.fillRect(0,0,w,h);
      for(var k=0;k<24;k++){ var bw=20+r()*50, bh=60+r()*260, bx=r()*w; cx.fillStyle='#161826'; cx.fillRect(bx,h-bh,bw,bh);
        cx.fillStyle='rgba(255,210,140,0.8)'; for(var q=0;q<12;q++) cx.fillRect(bx+3+r()*(bw-8), h-bh+r()*bh, 3, 4); } }
    else if(kind===2){ g=cx.createLinearGradient(0,0,0,h); g.addColorStop(0,'#7aa7d8'); g.addColorStop(1,'#e8eef4'); cx.fillStyle=g; cx.fillRect(0,0,w,h);
      cx.fillStyle='#f4f6f8'; cx.beginPath(); cx.moveTo(0,h*0.8); cx.lineTo(w*0.35,h*0.25); cx.lineTo(w*0.55,h*0.5); cx.lineTo(w*0.72,h*0.3); cx.lineTo(w,h*0.75); cx.lineTo(w,h); cx.lineTo(0,h); cx.fill();
      cx.fillStyle='#6d7f94'; cx.fillRect(0,h*0.84,w,h*0.16); }
    else { cx.fillStyle='#f1c83c'; cx.fillRect(0,0,w,h); cx.fillStyle='#ffffff'; cx.beginPath(); cx.arc(w*0.66,h*0.5,h*0.36,0,6.2832); cx.fill();
      cx.fillStyle='#2f6b3c'; cx.fillRect(w*0.62,h*0.22,w*0.08,h*0.56); cx.fillStyle='#c7e0c4'; cx.fillRect(w*0.635,h*0.3,w*0.05,h*0.2);
      cx.fillStyle='#b9322a'; cx.fillRect(w*0.08,h*0.3,w*0.34,h*0.08); cx.fillRect(w*0.08,h*0.46,w*0.26,h*0.05); }
  });
}
var mFrame = std({color:0xa8aaac, roughness:0.4, metalness:0.8});
var POSTERS = [];
function addPoster(z, tex, ei){
  addBox(P, 0.14, 1.18, 1.62, mFrame, -7.18, 1.3, z, false, true);
  var m = std({map:tex, emissiveMap:tex, emissive:new THREE.Color(1,1,1), emissiveIntensity:ei, roughness:0.28, metalness:0});
  var pl = addPlane(P, 1.46, 1.03, m, -7.105, 1.3, z, Math.PI/2);
  POSTERS.push(m); return m;
}
var POSTER_MAIN = addPoster(0, TX_POSTER, 0.9);
var _kinds = [0,1,2,3,1,0,2,3,0,1];
for(var _pz=-40, _pk=0; _pz<=40; _pz+=8){ if(_pz===0) continue; addPoster(_pz, genericPoster(300+_pk, _kinds[_pk%10]), 0.55); _pk++; }

/* ---- ghế băng sân ga (4 ghế nhựa trên khung thép), quay mặt ra đường ray ---- */
var mSeat = std({color:0xc06a2a, roughness:0.45});
(function(){
  var bx = 0.9;
  addBox(P, 0.12, 0.08, 2.0, mSteel, bx+0.02, 0.36, 0);
  addBox(P, 0.06, 0.36, 0.06, mSteel, bx+0.02, 0.18, -0.85); addBox(P, 0.06, 0.36, 0.06, mSteel, bx+0.02, 0.18, 0.85);
  addBox(P, 0.5, 0.03, 0.3, mSteel, bx+0.02, 0.015, -0.85); addBox(P, 0.5, 0.03, 0.3, mSteel, bx+0.02, 0.015, 0.85);
  for(var i=0;i<4;i++){
    var z = -0.72 + i*0.48;
    var seat = addBox(P, 0.44, 0.045, 0.44, mSeat, bx, 0.43, z);
    var back = addBox(P, 0.045, 0.42, 0.44, mSeat, bx+0.24, 0.66, z); back.rotation.z = -0.12;
  }
})();
/* ---- máy bán hàng tự động (mặt phát sáng) ---- */
var TX_VEND = canvasTex(256,470,function(cx,w,h){
  cx.fillStyle='#eef2f4'; cx.fillRect(0,0,w,h);
  var cols=['#c7372f','#2f6fb3','#e0b33a','#3f8a4c','#f0f0f0','#8a4b2a','#d4d9de','#1f3d6d'];
  var r = HFA.mulberry32(55);
