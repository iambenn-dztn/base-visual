    cx.fillStyle='#39414a'; cx.fillRect(12 + k*39, 106 + row*92, 30, 10);
  }
  cx.fillStyle='#1b2530'; cx.fillRect(0,330,w,140); cx.fillStyle='#5c6670'; cx.fillRect(40,400,176,40);
});
var mVend = std({map:TX_VEND, emissiveMap:TX_VEND, emissive:new THREE.Color(1,1,1), emissiveIntensity:0.9, roughness:0.3});
