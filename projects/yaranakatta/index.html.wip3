  setGate(1 - ramp(T, 238.4, 242.8));
  var c0 = FO.at(1, 0.055), cr = FO.at(1, 0.115), gt = FO.at(1, 0.9);
  var p0 = up(c0, 1.55), l0 = cr;
  var p1 = up(FO.at(1, 0.06), 1.5), l1 = up(gt, 0.8);
  camVL(p0, l0, p1, l1, ramp(T, 237.0, 239.5), lerp(40, 22, ramp(T, 237, 239.5)));
  kOn('s95', win(T, 212.4, 220.0, 0.8));
  kOn('w1', win(T, 226.7, 237.0, 0.5)); kOn('w2', win(T, 228.4, 237.0, 0.5)); kOn('w3', win(T, 230.5, 237.0, 0.5));
}, 0.35, 0);
S('S18', 244.44, 254.21, function(u,T){    /* C22: việc chưa làm — không cổng, mất hút vào sương */
