/* =========================================================================
 * VÒNG LẶP CHÍNH — renderAtTime(t) TẤT ĐỊNH THUẦN
 * ========================================================================= */
function resetVis(){
  for(var k in G) G[k].visible = false;
  TRAIN.visible = false; LEAVES.visible = false;
  stage.lens.uniforms.uVig.value = 0.36;
  for(var i=0;i<PL.length;i++) PL[i].intensity = 0;
}
function sceneIndex(t){
  for(var i=0;i<SC.length;i++){ if(t >= SC[i].a && t < SC[i].b) return i; }
  return t < SC[0].a ? 0 : SC.length-1;
}
function renderAtTime(t){
  /* LEADTAIL:APPLIED — dịch timeline sang phải 2s cho intro lặng.
     Cảnh vẫn dùng mốc gốc của timing.json; chỉ tới muộn hơn 2s. */
  var _tReal = t;                    /* thời gian THẬT của video, cho phụ đề */
  t = Math.max(0, t - 2);   /* thời gian CẢNH, đã trừ intro */

  t = clamp(t, 0, SCENE_END);
  SHARED.uT.value = t;
  resetVis();
  var i = sceneIndex(t), s = SC[i];
  var u = t - s.a;
  s.fn(u, t, s.b - s.a);
  sky.position.copy(camera.position);
  var f = 1;
  if(s.fi > 0) f = Math.min(f, smooth(u / s.fi));
  if(s.fo > 0) f = Math.min(f, smooth((s.b - t) / s.fo));
  stage.lens.uniforms.uFade.value = f * HFA.globalFade(t, SCENE_END, 1.2, 2.5);
  stage.lens.uniforms.uT.value = t;
  kFlush();
  HFA.applySubtitle(subEl, CUES, _tReal);
  /* LEADTAIL:APPLIED — màn hình đen 5s cuối: nhạc chạy tiếp, hình tắt dần. */
  (function(){
    var ob = document.getElementById('outro-black');
    if(!ob) return;
    var f = (_tReal - 737.24) / 1.2;         /* 1.2s chuyển sang đen */
    ob.style.opacity = String(Math.max(0, Math.min(1, f)));
  })();
  HFA.applyChapter(chapEl, CHAPTERS, _tReal, 5.5);
  composer.render();
}

/* =========================================================================
 * PHỤ ĐỀ — sinh bởi: node scripts/gen-captions.mjs --project projects/yaranakatta
 * (≤22 ký tự toàn角/dòng, tự nhận tiếng Nhật). ĐỪNG sửa tay.
 * ========================================================================= */
const CUES=[
 {t:2.00,s:"平日の、朝の九時すぎでした。"},
 {t:5.02,s:"通勤の人波が引いたあとの、"},
 {t:7.82,s:"少し静かな駅のホームです。"},
 {t:10.62,s:"私は用事があって、"},
 {t:12.35,s:"ひとつ先の町まで行くところでした。"},
 {t:15.62,s:"ベンチの向かいの壁に、"},
 {t:17.74,s:"旅行のポスターが貼ってありました。"},
 {t:21.01,s:"紅葉の渓谷の写真です。"},
 {t:23.38,s:"川の両岸が、赤と黄色で埋まっている。"},
 {t:27.26,s:"その下に、"},
 {t:28.34,s:"東北のある温泉地の名前がありました。"},
 {t:33.69,s:"その名前を見たとき、頭の中で、"},
 {t:36.57,s:"ある声がしました。"},
 {t:38.30,s:"あの時、行っておけばよかった。"},
 {t:41.18,s:"母と、いつか行こうと話していた場所なんです。"},
 {t:45.53,s:"紅葉の時期に、二人で。"},
 {t:47.70,s:"何度も話に出ました。"},
 {t:49.68,s:"でも、一度も行きませんでした。"},
 {t:52.64,s:"母が亡くなって、もう七年になります。"},
 {t:56.02,s:"不思議なのは、"},
 {t:57.34,s:"この声が初めてではないことでした。"},
 {t:60.53,s:"何年たっても、"},
 {t:61.85,s:"ふとした時に同じ言葉が戻ってくるんです。"},
 {t:65.61,s:"一方で、私にも、"},
 {t:67.28,s:"してしまった失敗はたくさんあります。"},
 {t:71.05,s:"若いころ、勢いで口にしたきつい言葉。"},
 {t:74.81,s:"考えなしに決めて、あとで困ったこと。"},
 {t:78.58,s:"そういう失敗は、"},
 {t:80.23,s:"思い出せば今でも少し恥ずかしい。"},
 {t:83.54,s:"でも、なんというか、もう痛くはないんです。"},
 {t:87.88,s:"いつのまにか、片がついている。"},
 {t:90.98,s:"やらなかったことは消えずに残って、"},
 {t:94.32,s:"やってしまったことは薄れていく。"},
 {t:97.47,s:"なぜなんでしょう。"},
 {t:99.24,s:"電車が入ってきました。"},
 {t:101.41,s:"私は座席で、その続きを考えはじめました。"},
 {t:107.29,s:"実は、"},
 {t:107.93,s:"この問いには、"},
 {t:109.41,s:"よく知られた答えがあるんです。"},
 {t:112.60,s:"私も、どこかで読んで知っていました。"},
 {t:116.42,s:"アメリカの心理学者、"},
 {t:118.31,s:"トーマス・ギロビッチと、"},
 {t:120.58,s:"ヴィクトリア・メドベック。"},
 {t:123.03,s:"二人が千九百九十四年に発表した研究です。"},
 {t:126.81,s:"もう三十年あまり前になります。"},
 {t:129.65,s:"二人は、人に後悔を思い出してもらいました。"},
 {t:133.75,s:"ただし、聞き方を二通りに分けたんです。"},
 {t:137.45,s:"ひとつは、ごく最近の後悔。"},
 {t:140.08,s:"この一週間で、一番悔やんでいることは何か。"},
 {t:144.33,s:"もうひとつは、"},
 {t:145.74,s:"人生全体を振り返って、"},
 {t:147.97,s:"一番悔やんでいることは何か。"},
 {t:150.80,s:"そして、出てきた後悔を二つに分けました。"},
 {t:154.88,s:"何かをしてしまった後悔。"},
 {t:157.33,s:"それから、何かをしなかった後悔です。"},
 {t:161.00,s:"報告された形は、こうでした。"},
 {t:164.14,s:"人生を振り返ったときの一番の後悔は、"},
 {t:168.17,s:"しなかったことのほうが、"},
 {t:170.86,s:"大きく上回った。"},
 {t:172.65,s:"短い目で見ると、人は、"},
 {t:174.75,s:"してしまったことを悔やみやすい。"},
 {t:177.79,s:"長い目で見ると、"},
 {t:179.32,s:"しなかったことを悔やみやすい。"},
 {t:182.17,s:"時間がたつにつれて、"},
 {t:184.08,s:"後悔の中身が入れ替わっていく、"},
 {t:186.94,s:"ということです。"},
 {t:188.45,s:"この研究は、"},
 {t:189.69,s:"その後何十年も、"},
 {t:191.35,s:"あちこちで引用されてきました。"},
 {t:194.47,s:"後悔の話になると、まず出てくる研究なんです。"},
 {t:199.03,s:"日本でも、似た言葉をよく耳にします。"},
 {t:202.68,s:"やらずに後悔するより、やって後悔しろ。"},
 {t:206.52,s:"聞いたことのある方も多いと思います。"},
 {t:210.18,s:"では、なぜそんな入れ替わりが起きるのか。"},
 {t:214.43,s:"翌年の千九百九十五年、"},
 {t:216.77,s:"二人はその仕組みについて、"},
 {t:219.53,s:"長い論文を書いています。"},
 {t:222.07,s:"まず、してしまったことの後悔です。"},
 {t:225.32,s:"これには、手の打ちようがあるんです。"},
 {t:228.76,s:"謝ることができる。"},
 {t:230.48,s:"やり直すことができる。"},
 {t:232.59,s:"それに人は、失敗の中によかった点を探します。"},
 {t:236.95,s:"あれで懲りたから、今の自分がある。"},
 {t:240.31,s:"そう考えることで、"},
 {t:242.09,s:"失敗には少しずつ区切りがついていくわけです。"},
 {t:246.44,s:"ところが、"},
 {t:247.33,s:"しなかったことには、"},
 {t:249.10,s:"この手が使えません。"},
 {t:250.88,s:"起きていないことは、謝りようも、"},
 {t:253.72,s:"やり直しようもないからです。"},
 {t:256.21,s:"もうひとつ、二人が挙げた仕組みがあります。"},
 {t:260.18,s:"時間がたつと、"},
 {t:261.50,s:"あの時ためらった理由のほうが、"},
 {t:264.33,s:"見えにくくなるというんです。"},
 {t:266.97,s:"当時は、怖さも迷いも、ちゃんとありました。"},
 {t:270.90,s:"でも年月がたつと、それを忘れてしまう。"},
 {t:274.45,s:"すると、"},
 {t:275.20,s:"やればきっとうまくいった、"},
 {t:277.63,s:"と思えてくるわけです。"},
 {t:279.69,s:"二千三年には、"},
 {t:281.10,s:"同じギロビッチたちが、日本、中国、"},
 {t:284.53,s:"ロシアでも調べています。"},
 {t:286.95,s:"長い目で見ると、"},
 {t:288.57,s:"どの国でも同じ形が出たと報告されました。"},
 {t:292.60,s:"窓の外を、"},
 {t:293.59,s:"刈り入れの済んだ田んぼが流れていきました。"},
 {t:297.76,s:"私は、なるほどと思いました。"},
 {t:300.53,s:"母との旅行は、まさにそれだったからです。"},
 {t:304.50,s:"行かなかった旅は、終わっていない旅なんです。"},
 {t:308.65,s:"終わっていないから、片がつかない。"},
 {t:311.86,s:"私は長いあいだ、そう理解してきました。"},
 {t:317.40,s:"ところが、この話には続きがありました。"},
 {t:320.82,s:"私がそれを知ったのは、"},
 {t:322.81,s:"ずっとあとになってからです。"},
 {t:325.34,s:"心理学では、"},
 {t:326.58,s:"この十年あまり、"},
 {t:328.23,s:"ある反省が広がっています。"},
 {t:330.90,s:"有名な実験を同じようにやり直すと、"},
 {t:334.41,s:"同じ結果が出ないことがある。"},
 {t:337.29,s:"そういう例が、次々に見つかったんです。"},
 {t:341.20,s:"そこで、"},
 {t:342.01,s:"名の知れた研究を、"},
 {t:343.83,s:"改めて測り直す動きが起きました。"},
 {t:347.07,s:"ギロビッチとメドベックの研究も、"},
 {t:350.31,s:"その対象になりました。"},
 {t:352.54,s:"二千二十二年。"},
 {t:353.86,s:"香港大学のギラド・フェルドマンらのチームが、"},
 {t:358.01,s:"結果を発表しました。"},
 {t:359.90,s:"インターネットを通じて、"},
 {t:362.32,s:"およそ千人のアメリカ人に、"},
 {t:364.93,s:"元の研究と同じ形の質問をしたんです。"},
 {t:368.55,s:"元の論文にあった実験を、"},
 {t:370.97,s:"いくつもまとめて繰り返しました。"},
 {t:374.19,s:"結果は、"},
 {t:375.01,s:"半分はうなずけて、"},
 {t:376.85,s:"半分は違うものでした。"},
 {t:379.09,s:"いくつかの実験では、"},
 {t:381.14,s:"元と同じ向きの結果が出ました。けれど、"},
 {t:385.02,s:"その差は、"},
 {t:386.04,s:"元の報告よりはっきり小さかった。"},
 {t:389.31,s:"そして一つの実験では、"},
 {t:391.51,s:"元の研究が示した形が、"},
 {t:393.71,s:"見つからなかったんです。"},
 {t:397.58,s:"翌年の二千二十三年。"},
 {t:399.52,s:"今度は、元の研究者自身が動きました。"},
 {t:403.02,s:"ギロビッチが、"},
 {t:404.38,s:"ジェリー・リチャードソンと"},
 {t:406.90,s:"いう研究者と組んで、"},
 {t:408.85,s:"もう一度測り直したんです。"},
 {t:411.36,s:"場所は、"},
 {t:412.32,s:"シカゴの街なかにある、"},
 {t:414.95,s:"心理学を体験できる施設でした。"},
 {t:418.55,s:"訪れた人に、その場で答えてもらう。"},
 {t:422.62,s:"集まったのは二千六百人です。"},
 {t:425.97,s:"元の研究で、"},
 {t:427.23,s:"人生の後悔を聞いた相手は、"},
 {t:429.96,s:"三十二人でした。"},
 {t:431.64,s:"今回は、そのおよそ八十倍です。"},
 {t:434.79,s:"人数が少ないと、"},
 {t:436.47,s:"たまたまの偏りが大きく出ることがあるんです。"},
 {t:441.09,s:"大事なのは、そのやり方です。この研究は、"},
 {t:445.19,s:"結果が出る前に、"},
 {t:446.82,s:"どう分析するかを決めていました。"},
 {t:450.09,s:"雑誌の側も、"},
 {t:451.20,s:"結果を見る前に、"},
 {t:452.67,s:"載せることを約束する。"},
 {t:454.70,s:"こうしておけば、"},
 {t:456.18,s:"あとから都合のいい結果だけを"},
 {t:458.76,s:"選ぶことができません。"},
 {t:460.79,s:"自分の研究を測り直すには、"},
 {t:463.19,s:"いちばん厳しいやり方なんです。"},
 {t:467.91,s:"結果です。"},
 {t:468.86,s:"ごく最近の後悔では、"},
 {t:470.76,s:"してしまったことの後悔のほうが、"},
 {t:473.81,s:"はっきり多く出ました。"},
 {t:475.90,s:"では、"},
 {t:476.53,s:"人生を振り返っての一番の後悔は、"},
 {t:479.91,s:"どうだったか。"},
 {t:481.39,s:"してしまったことが五十一パーセント。"},
 {t:485.20,s:"しなかったことが、四十九パーセント。"},
 {t:489.00,s:"ほぼ、半々でした。"},
 {t:493.08,s:"統計の上では、差がないと言っていい数字です。"},
 {t:497.02,s:"コインを投げて、"},
 {t:498.45,s:"表と裏が出る割合と、"},
 {t:500.24,s:"ほとんど変わらないということです。"},
 {t:503.28,s:"人生で一番の後悔は、"},
 {t:505.14,s:"しなかったことに大きく偏る。"},
 {t:507.75,s:"有名だったその部分が、"},
 {t:509.80,s:"今回は出てこなかったんです。"},
 {t:512.41,s:"ただ、ここは正確にお伝えしておきます。"},
 {t:516.19,s:"発見が丸ごと崩れたわけではありません。"},
 {t:519.97,s:"最近の後悔では、してしまったことが多い。"},
 {t:523.75,s:"長い目で見ると、"},
 {t:525.26,s:"しなかったことが追いついてくる。"},
 {t:528.28,s:"時間とともに後悔の中身が動いていく、"},
 {t:531.68,s:"その傾きそのものは、"},
 {t:533.57,s:"確かめられたんです。"},
 {t:535.46,s:"崩れたのは、その先です。"},
 {t:537.65,s:"人は結局、しなかったことばかりを悔やむ。"},
 {t:541.30,s:"そう言い切れるほど、"},
 {t:543.13,s:"強い偏りではなかったということです。"},
 {t:546.41,s:"ギロビッチたちは論文の中で、"},
 {t:549.19,s:"元の結果と形が違ったことを、"},
 {t:551.97,s:"そのまま書いています。"},
 {t:554.15,s:"三十年前の自分の発見を、"},
 {t:556.53,s:"自分で測り直して、"},
 {t:558.32,s:"違ったと書いたわけです。"},
 {t:560.71,s:"正直に言うと、"},
 {t:562.10,s:"私はこの論文を読んで、"},
 {t:564.27,s:"しばらく考えこみました。"},
 {t:566.65,s:"やらずに後悔するより、やって後悔しろ。"},
 {t:570.41,s:"あの言葉を、"},
 {t:571.60,s:"私はほとんど法則のように思っていたからです。"},
 {t:575.94,s:"なぜ違いが出たのかは、はっきりしていません。"},
 {t:580.18,s:"時代のせいか、"},
 {t:581.53,s:"聞いた相手のせいか、"},
 {t:583.46,s:"聞き方のせいか。"},
 {t:585.00,s:"論文も、そこは決めきれていないんです。"},
 {t:588.66,s:"日本で調べた二千三年の研究も、古い方法で、"},
 {t:593.10,s:"少ない人数で測ったものです。"},
 {t:596.07,s:"同じ規模と厳しさで、"},
 {t:598.18,s:"日本で測り直した研究を、"},
 {t:600.72,s:"私は見つけられませんでした。"},
 {t:603.69,s:"この点は、私にはわかりません。"},
 {t:606.85,s:"それでも、一つはっきりしたことがあります。"},
 {t:611.34,s:"しなかった後悔が人生の後悔を占める、"},
 {t:615.18,s:"という話は、"},
 {t:616.46,s:"思われていたほど強くはなかった。"},
 {t:619.88,s:"心理学の法則だ、"},
 {t:621.64,s:"という響きが、"},
 {t:623.18,s:"その話を実際よりも重く聞かせていたんです。"},
 {t:630.26,s:"夕方、私は同じ駅に戻ってきました。"},
 {t:633.93,s:"ホームには、帰りの人が増えはじめていました。"},
 {t:638.69,s:"壁には、朝と同じポスターがあります。"},
 {t:643.46,s:"赤と黄色の渓谷。"},
 {t:645.59,s:"温泉地の名前。"},
 {t:647.44,s:"あの時、行っておけばよかった。"},
 {t:651.42,s:"声は、やはり聞こえました。"},
 {t:654.87,s:"ただ、朝とは少し聞こえ方が違いました。"},
 {t:658.90,s:"これは、人が逃れられない法則ではないんです。"},
 {t:663.57,s:"誰にでもある、ひとつの後悔です。"},
 {t:666.96,s:"ギロビッチたちの説明を、"},
 {t:669.05,s:"もう一度思い出しました。"},
 {t:671.13,s:"年月がたつと、"},
 {t:672.35,s:"ためらった理由のほうが見えにくくなる。"},
 {t:675.65,s:"思い返すと、あの秋、"},
 {t:677.51,s:"母は膝を悪くしていました。"},
 {t:679.92,s:"その宿は、長い石段の上にありました。"},
 {t:683.26,s:"行かなかったのには、"},
 {t:685.12,s:"行かなかったなりの理由が、"},
 {t:687.53,s:"ちゃんとあったんです。"},
 {t:689.57,s:"人生を振り返ったときの一番の後悔は、"},
 {t:692.66,s:"してしまったことと、"},
 {t:694.38,s:"しなかったことで、"},
 {t:695.93,s:"ほぼ半分ずつ。"},
 {t:697.14,s:"二千六百人に聞いて、"},
 {t:698.85,s:"そうだったということです。"},
 {t:701.09,s:"ホームで電車を待つ人たちにも、それぞれ、"},
 {t:704.92,s:"そういう声が一つや二つあるのでしょう。"},
 {t:708.55,s:"あの二千六百の答えの中にも、"},
 {t:711.23,s:"私の後悔と同じ形のものが、"},
 {t:713.72,s:"並んでいたのだと思います。"},
 {t:716.21,s:"あの声が消えることは、たぶんないと思います。"},
 {t:720.41,s:"ですが、"},
 {t:721.17,s:"それは法則が決めた重さではありません。"},
 {t:724.80,s:"人が持ち運べる、ふつうの重さなんです。"},
 {t:729.89,s:"私はポスターの前で、少しだけ足を止めました。"},
 {t:734.01,s:"それから、帰りの電車に乗りました。"}
];

/* ---- font Nhật: chỉ vẽ texture có chữ SAU KHI font nạp xong ---- */
if(document.fonts && document.fonts.load){
  Promise.all([
    document.fonts.load('700 96px "BIZ UDPGothic"'),
    document.fonts.load('400 96px "BIZ UDPGothic"')
  ]).then(function(){
    drawTextTextures();
    var tl = window.__timelines && window.__timelines["yaranakatta"];
    renderAtTime(tl ? tl.time() : 0);
  });
}

/* Dòng đăng ký phải nằm NGUYÊN DẠNG trong file này — StaticGuard quét VĂN BẢN. */
window.__timelines = window.__timelines || {};
window.__timelines["yaranakatta"] = HFA.makeTimeline("yaranakatta", TOTAL, renderAtTime);
</script>
</body>
</html>
