    cL:mixArr(COL_NEU, COL_AMB, ramp(T, 152.9, 154.3)), cR:mixArr(COL_NEU, COL_BLU, ramp(T, 155.3, 156.7)) };
  setFork(FO, st);
  camLerpF([0,3.6,15, 0,0.6,-34, 48], [0,3.9,14, 0,0.6,-36, 48], u/10.2);
  kAt('lDid', win(T, 152.9, 158.8, 0.6), up(FO.at(1,0.32), 1.4));
  kAt('lDidnt', win(T, 155.3, 158.8, 0.6), up(FO.at(2,0.32), 1.4));
