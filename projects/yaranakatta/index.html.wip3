/* ---- đồng hồ treo ---- */
var TX_CLOCK = textCanvasTex(256,256,function(cx,w,h){
  cx.fillStyle='#f4f2ec'; cx.beginPath(); cx.arc(128,128,124,0,6.2832); cx.fill();
  cx.strokeStyle='#222'; cx.lineWidth=6; cx.stroke();
  for(var i=0;i<60;i++){ var a=i/60*6.2832, r1 = (i%5===0)?96:106;
    cx.lineWidth = (i%5===0)?6:2; cx.beginPath(); cx.moveTo(128+Math.sin(a)*r1,128-Math.cos(a)*r1); cx.lineTo(128+Math.sin(a)*114,128-Math.cos(a)*114); cx.stroke(); }
  cx.fillStyle='#222'; cx.font='700 34px ' + JP_FONT; cx.textAlign='center'; cx.textBaseline='middle';
  cx.fillText('12',128,62); cx.fillText('3',194,128); cx.fillText('6',128,194); cx.fillText('9',62,128);
});
var CLOCK = new THREE.Group(); P.add(CLOCK);
CLOCK.position.set(0.4, 2.72, -6);
(function(){
  var face = std({map:TX_CLOCK, roughness:0.5, emissiveMap:TX_CLOCK, emissive:new THREE.Color(1,1,1), emissiveIntensity:0.12});
  var rim = new THREE.Mesh(new THREE.CylinderGeometry(0.32,0.32,0.09,40), std({color:0x33373a, roughness:0.4, metalness:0.7}));
  rim.rotation.z = Math.PI/2; CLOCK.add(rim);
  var f1 = new THREE.Mesh(new THREE.CircleGeometry(0.3,40), face); f1.position.x = -0.047; f1.rotation.y = -Math.PI/2; CLOCK.add(f1);
  var f2 = new THREE.Mesh(new THREE.CircleGeometry(0.3,40), face); f2.position.x = 0.047; f2.rotation.y = Math.PI/2; CLOCK.add(f2);
  var rod = new THREE.Mesh(new THREE.CylinderGeometry(0.015,0.015,0.36,8), mSteel); rod.position.y = 0.48; CLOCK.add(rod);
})();
var CLOCK_H = [], CLOCK_M = [];
(function(){
  var mh = std({color:0x111111, roughness:0.5});
  for(var s=-1; s<=1; s+=2){
    var ph = new THREE.Group(); ph.position.x = s*0.052; CLOCK.add(ph);
    var h = new THREE.Mesh(new THREE.BoxGeometry(0.006,0.15,0.022), mh); h.position.y = 0.065; ph.add(h);
    var pm = new THREE.Group(); pm.position.x = s*0.056; CLOCK.add(pm);
    var m = new THREE.Mesh(new THREE.BoxGeometry(0.006,0.23,0.014), mh); m.position.y = 0.10; pm.add(m);
    CLOCK_H.push({g:ph, s:s}); CLOCK_M.push({g:pm, s:s});
  }
})();
function setClock(hh, mm){
  var ah = ((hh%12) + mm/60)/12*Math.PI*2, am = mm/60*Math.PI*2;
  for(var i=0;i<2;i++){ CLOCK_H[i].g.rotation.x = -CLOCK_H[i].s*ah; CLOCK_M[i].g.rotation.x = -CLOCK_M[i].s*am; }
}

/* ---- tàu điện 3 toa (thép không gỉ, dải xanh) ---- */
var TRAIN = new THREE.Group(); P.add(TRAIN);
var TRAIN_DOORS = [];
(function(){
  var L = 19.5;
  var sh = new THREE.Shape();
  sh.moveTo(-1.45,-0.55); sh.lineTo(1.45,-0.55); sh.lineTo(1.45,2.45);
  sh.quadraticCurveTo(1.45,2.86,1.05,2.88); sh.lineTo(-1.05,2.88);
  sh.quadraticCurveTo(-1.45,2.86,-1.45,2.45); sh.lineTo(-1.45,-0.55);
  var bodyGeo = new THREE.ExtrudeGeometry(sh, {depth:L, bevelEnabled:false, curveSegments:10});
  bodyGeo.translate(0,0,-L/2);
  var mBody = std({color:0xb9bcbf, roughness:0.3, metalness:0.85});
  var mBand = std({color:0x157a3c, roughness:0.4, metalness:0.3});
  var TXWIN = canvasTex(64,128,function(cx,w,h){ var g=cx.createLinearGradient(0,0,0,h); g.addColorStop(0,'#fff6e6'); g.addColorStop(0.6,'#c9c0ae'); g.addColorStop(1,'#6f6a60'); cx.fillStyle=g; cx.fillRect(0,0,w,h); });
  var mWin = std({color:0x0b0d10, roughness:0.06, metalness:0.3, emissive:new THREE.Color(1,0.95,0.85), emissiveMap:TXWIN, emissiveIntensity:0.16});
  var mInside = std({color:0x222222, roughness:0.8, emissive:new THREE.Color(1,0.93,0.8), emissiveMap:TXWIN, emissiveIntensity:0.5});
  var mDoor = std({color:0xa8abae, roughness:0.28, metalness:0.85});
  var mUnder = std({color:0x2a2a2c, roughness:0.85, metalness:0.3});
  var doorsZ = [-7.2,-2.4,2.4,7.2];
  for(var c=0;c<3;c++){
    var car = new THREE.Group(); car.position.z = c*20; TRAIN.add(car);
    var body = new THREE.Mesh(bodyGeo, mBody); body.castShadow = true; body.receiveShadow = true; car.add(body);
    addBox(car, 2.6, 0.5, 16.5, mUnder, 0, -0.8, 0, true, false);
    addBox(car, 2.3, 0.5, 2.6, mUnder, 0, -0.95, -6.6, true, false);
    addBox(car, 2.3, 0.5, 2.6, mUnder, 0, -0.95, 6.6, true, false);
    addBox(car, 1.6, 0.26, 3.4, std({color:0x8c9094, roughness:0.6, metalness:0.5}), 0, 3.0, 0, true, false);
    for(var s=-1; s<=1; s+=2){
      var xo = s*1.456, ry = s>0 ? Math.PI/2 : -Math.PI/2;
      addPlane(car, L, 0.12, mBand, xo + s*0.003, 0.84, 0, ry);
      addPlane(car, L, 0.05, mBand, xo + s*0.003, 2.3, 0, ry);
      var wins = [[-4.8,2.3],[0,2.3],[4.8,2.3],[-9.0,0.9],[9.0,0.9]];
      for(var k=0;k<wins.length;k++){ addPlane(car, wins[k][1], 0.95, mWin, xo + s*0.005, 1.45, wins[k][0], ry); }
      for(var d=0; d<doorsZ.length; d++){
        var dz = doorsZ[d];
        addPlane(car, 1.3, 1.98, mInside, xo + s*0.005, 0.94, dz, ry);
        var leaves = [];
        for(var q=-1; q<=1; q+=2){
          var lf = new THREE.Group(); lf.position.set(xo + s*0.014, 0.94, dz + q*0.325); lf.rotation.y = ry; car.add(lf);
          var pn = new THREE.Mesh(new THREE.PlaneGeometry(0.65,1.98), mDoor); lf.add(pn);
          var gw = new THREE.Mesh(new THREE.PlaneGeometry(0.42,0.85), mWin); gw.position.set(0,0.42,0.004); lf.add(gw);
          leaves.push({g:lf, q:q, z0:dz + q*0.325, s:s});
        }
        TRAIN_DOORS.push(leaves);
      }
    }
    if(c===0){ /* mặt đầu tàu hướng -z */
      var fz = -L/2 - 0.004;
      addPlane(car, 2.5, 0.95, mWin, 0, 1.62, fz, Math.PI);
      var mHead = std({color:0xffffff, emissive:new THREE.Color(1,0.96,0.86), emissiveIntensity:6});
      addPlane(car, 0.28, 0.12, mHead, -0.95, 0.35, fz-0.002, Math.PI); addPlane(car, 0.28, 0.12, mHead, 0.95, 0.35, fz-0.002, Math.PI);
      var mDest = std({color:0x000000, emissive:new THREE.Color(1.0,0.62,0.2), emissiveIntensity:1.4});
      addPlane(car, 1.1, 0.22, mDest, 0, 2.42, fz-0.002, Math.PI);
      addPlane(car, 2.9, 0.12, mBand, 0, 0.84, fz-0.001, Math.PI);
    }
  }
  TRAIN.position.x = -3.3;
})();
/** frontZ = toạ độ z mặt đầu tàu; door = 0..1 độ mở cửa phía sân ga */
function setTrain(frontZ, door){
  TRAIN.visible = true;
  TRAIN.position.z = frontZ + 9.75;
  for(var i=0;i<TRAIN_DOORS.length;i++){
    var lv = TRAIN_DOORS[i];
    for(var j=0;j<lv.length;j++){ var o = lv[j]; o.g.position.z = o.z0 + o.q*0.63*(o.s>0 ? door : 0); }
  }
}
/** tàu vào ga: dừng ở zStop lúc tStop, phanh đều T giây; trước đó chạy v0 = 2d/T */
function arriveZ(t, tStop, zStop, d, Tb){
  var r = tStop - t; if(r <= 0) return zStop;
  if(r <= Tb) return zStop + d*(r/Tb)*(r/Tb);
  return zStop + d + (2*d/Tb)*(r - Tb);
}

/* ---- người chờ tàu buổi chiều (dáng người, ngược sáng, không mặt) ---- */
var PEOPLE = new THREE.Group(); P.add(PEOPLE);
(function(){
  var r = HFA.mulberry32(909);
  var coatCols = [0x1d2230,0x2b2724,0x3a3a3c,0x5a4a3a,0x23262a,0x4a2f2a,0x2e3a2e,0x6b6258];
  var prof = [[0.0,0.72],[0.16,0.74],[0.19,0.95],[0.20,1.20],[0.21,1.36],[0.19,1.44],[0.10,1.50],[0.05,1.52],[0.0,1.52]];
  var pts = prof.map(function(p){ return new THREE.Vector2(p[0],p[1]); });
  var bodyGeo = new THREE.LatheGeometry(pts, 20);
  var headGeo = new THREE.SphereGeometry(0.105, 20, 14);
  var legGeo = new THREE.CylinderGeometry(0.06, 0.055, 0.78, 10); legGeo.translate(0,0.39,0);
  var spots = [[1.4,-12],[0.3,-14.5],[2.0,-17],[-0.2,-20],[1.1,-23],[3.2,-26],[0.6,-30],[2.2,-34],[-0.1,-38],[1.5,-44],[3.3,-19],[-0.6,9.5],[1.8,8.5],[3.4,14]];
  for(var i=0;i<spots.length;i++){
    var g = new THREE.Group();
    var mc = std({color:coatCols[i%coatCols.length], roughness:0.85});
    var sc = 0.92 + r()*0.12;
    var b = new THREE.Mesh(bodyGeo, mc); b.scale.set(1, 1, 0.78); b.castShadow = true; g.add(b);
    var hd = new THREE.Mesh(headGeo, std({color:0x1a1512, roughness:0.9})); hd.position.y = 1.64; hd.castShadow = true; g.add(hd);
    for(var s=-1;s<=1;s+=2){ var lg = new THREE.Mesh(legGeo, std({color:0x15161a, roughness:0.8})); lg.position.set(s*0.085,0,0); lg.castShadow = true; g.add(lg); }
    if(r() < 0.5){ var bag = addBox(g, 0.1, 0.28, 0.32, std({color:0x2a201a, roughness:0.7}), 0.23, 0.82, 0); }
    g.scale.setScalar(sc);
    g.position.set(spots[i][0], 0, spots[i][1]);
    g.rotation.y = -Math.PI/2 + (r()-0.5)*1.2;
    g.userData.ph = r()*6.28;
    PEOPLE.add(g);
  }
})();
function setPeople(on, t){
  PEOPLE.visible = on;
  for(var i=0;i<PEOPLE.children.length;i++){ var g = PEOPLE.children[i]; g.rotation.z = Math.sin(t*0.5 + g.userData.ph)*0.012; }
}

/** m = 0 buổi sáng … 1 chiều muộn */
function setP(m, t){
  G.P.visible = true;
  var L = lerpL(L_MORN, L_EVE, m);
  setLight(L);
  mFluo.emissiveIntensity = lerp(1.4, 2.6, m);
  POSTER_MAIN.emissiveIntensity = lerp(0.85, 1.05, m);
  for(var i=0;i<POSTERS.length;i++) if(POSTERS[i] !== POSTER_MAIN) POSTERS[i].emissiveIntensity = lerp(0.5, 0.9, m);
  mVend.emissiveIntensity = lerp(0.8, 1.3, m);
  if(m < 0.5) setClock(9, 12 + Math.floor(t/60)); else setClock(17, 24 + Math.floor((t-628)/60));
  TRAIN.visible = false;
  setPeople(m > 0.5, t);
}

/* =========================================================================
 * SÂN KHẤU T — TRONG TOA TÀU (ghế dọc, cửa sổ, cánh đồng đã gặt trôi qua)
 * Toa: sàn y=0, trần 2.3, vách x=±1.4, z ∈ [-10,10]. Tàu chạy về -z → cảnh
 * ngoài trôi về +z. Camera ngồi phía +x nhìn sang cửa sổ phía -x.
 * ========================================================================= */
var T = grp('T');
(function(){
  var mFloor = std({map:noiseTex('#6f6c66','40,40,40',256,256,31,5000,0.2,[2,12],2), roughness:0.8});
  var mPanel = std({color:0xe8e2d6, roughness:0.55});
  var mCeil  = std({color:0xf2f0ea, roughness:0.7});
  var TXMOQ = canvasTex(128,128,function(cx,w,h){ cx.fillStyle='#2c4a78'; cx.fillRect(0,0,w,h);
    var r = HFA.mulberry32(41); for(var i=0;i<1600;i++){ cx.fillStyle='rgba(' + (r()<0.5?'20,30,60':'80,110,160') + ',0.5)'; cx.fillRect(r()*w,r()*h,2,2); } }, {repeat:[1,14]});
  var mMoq = std({map:TXMOQ, roughness:0.95});
  var mSt = std({color:0xb0b4b8, roughness:0.25, metalness:0.9});
  addBox(T, 2.8, 0.1, 20, mFloor, 0, -0.05, 0, false, true);
  addBox(T, 2.8, 0.08, 20, mCeil, 0, 2.34, 0, true, true);
  /* vách hai bên: phần dưới, phần trên, trụ giữa các cửa sổ (tạo lỗ cửa sổ thật để nắng đổ vào) */
  for(var s=-1; s<=1; s+=2){
    var x = s*1.42;
    addBox(T, 0.06, 0.95, 20, mPanel, x, 0.475, 0);
    addBox(T, 0.06, 0.45, 20, mPanel, x, 2.075, 0);
    for(var z=-10; z<=10.01; z+=2.5){ addBox(T, 0.08, 0.92, 0.7, mPanel, x, 1.41, z); }
    /* ghế dọc */
    addBox(T, 0.5, 0.12, 19, mMoq, s*1.13, 0.46, 0);
    var bk = addBox(T, 0.1, 0.42, 19, mMoq, s*1.34, 0.74, 0); bk.rotation.z = s*0.08;
    addBox(T, 0.46, 0.4, 19, std({color:0x9a9a98, roughness:0.5, metalness:0.4}), s*1.15, 0.2, 0);
    /* giá hành lý + tay vịn */
    addBox(T, 0.3, 0.02, 19, mSt, s*1.2, 1.98, 0, true, false);
    addBox(T, 0.03, 0.03, 19, mSt, s*0.95, 2.02, 0, true, false);
    for(var q=-9; q<=9; q+=0.75){
      var st = new THREE.Mesh(new THREE.TorusGeometry(0.07,0.012,8,20), std({color:0xeae6da, roughness:0.4}));
      st.position.set(s*0.95, 1.78, q); st.rotation.y = Math.PI/2; st.castShadow = true; T.add(st);
      var bd = new THREE.Mesh(new THREE.BoxGeometry(0.012,0.18,0.03), std({color:0x3c3c40, roughness:0.6}));
      bd.position.set(s*0.95, 1.93, q); T.add(bd);
    }
  }
  var mLight = std({color:0xffffff, emissive:new THREE.Color(1,1,0.97), emissiveIntensity:1.3});
  addBox(T, 0.18, 0.03, 19, mLight, -0.45, 2.29, 0, false, false);
  addBox(T, 0.18, 0.03, 19, mLight, 0.45, 2.29, 0, false, false);
  var mGlass = new THREE.MeshStandardMaterial({color:0xd8e6ea, roughness:0.05, metalness:0.1, transparent:true, opacity:0.08, depthWrite:false});
  for(var s2=-1; s2<=1; s2+=2) addPlane(T, 20, 0.92, mGlass, s2*1.41, 1.41, 0, Math.PI/2);
})();
/* cảnh ngoài cửa sổ: ruộng đã gặt (shader cuộn theo t), cột điện, núi xa */
var FIELD_U = { uOff:{value:0} };
var FIELD_MAT = new THREE.ShaderMaterial({
  uniforms: THREE.UniformsUtils.merge([THREE.UniformsLib.fog, { uOff:{value:0} }]),
  vertexShader: [
    'varying vec3 vW;', '#include <fog_pars_vertex>',
    'void main(){ vec4 w=modelMatrix*vec4(position,1.0); vW=w.xyz; vec4 mvPosition=viewMatrix*w; gl_Position=projectionMatrix*mvPosition;', '#include <fog_vertex>', '}'
  ].join('\n'),
  fragmentShader: [
    'uniform float uOff; uniform vec3 uSunCol,uAmb; varying vec3 vW;', '#include <fog_pars_fragment>', GLSL_NOISE,
    'void main(){ vec2 p=vec2(vW.x, vW.z+uOff);',
    ' vec2 cell=floor(p/vec2(28.0,34.0)); vec2 f=fract(p/vec2(28.0,34.0));',
    ' float rid=step(0.965,max(f.x,f.y)) + step(max(f.x,f.y),0.02);',
    ' float rows=0.5+0.5*sin(p.x*22.0+hsh(cell)*6.0);',
    ' vec3 soil=mix(vec3(0.20,0.14,0.09),vec3(0.30,0.22,0.13),vn(p*0.2));',
    ' vec3 stub=mix(vec3(0.46,0.36,0.18),vec3(0.62,0.50,0.26),hsh(cell));',
    ' vec3 c=mix(soil,stub,0.55+0.35*rows*vn(p*1.3));',
    ' float wet=step(0.8,hsh(cell+3.1)); c=mix(c,vec3(0.16,0.14,0.10),wet*0.5);',
    ' c=mix(c,vec3(0.24,0.30,0.12),rid);',
    ' vec3 col=c*(uAmb+uSunCol*0.55);',
    ' gl_FragColor=vec4(col,1.0);', '#include <fog_fragment>', '}'
  ].join('\n'),
  fog:true
});
FIELD_MAT.uniforms.uSunCol = SHARED.uSunCol; FIELD_MAT.uniforms.uAmb = SHARED.uAmb;
(function(){
  var gnd = new THREE.Mesh(new THREE.PlaneGeometry(1600, 1600), FIELD_MAT);
  gnd.rotation.x = -Math.PI/2; gnd.position.set(-802, -1.4, 0); T.add(gnd);
  var gnd2 = new THREE.Mesh(new THREE.PlaneGeometry(1600, 1600), FIELD_MAT);
  gnd2.rotation.x = -Math.PI/2; gnd2.position.set(802, -1.4, 0); T.add(gnd2);
})();
var TPOLES = [];
(function(){
  var mPole = std({color:0x7c7a74, roughness:0.8});
  for(var i=0;i<5;i++){
    var p = new THREE.Group();
    var c = new THREE.Mesh(new THREE.CylinderGeometry(0.14,0.16,9,10), mPole); c.position.y = 3.1; p.add(c);
    var a = new THREE.Mesh(new THREE.BoxGeometry(0.12,0.12,1.6), mPole); a.position.y = 7.2; p.add(a);
    p.position.x = -5.5; T.add(p); TPOLES.push(p);
  }
})();
var TFAR = new THREE.Group(); T.add(TFAR);
(function(){
  var r = HFA.mulberry32(515);
  var mHill = std({color:0x4a5a44, roughness:1});
  for(var i=0;i<26;i++){
    var h = new THREE.Mesh(new THREE.SphereGeometry(1, 20, 10), mHill);
    h.scale.set(60 + r()*80, 25 + r()*45, 60 + r()*90);
    h.position.set(-420 - r()*200, -10, -700 + i*56); TFAR.add(h);
  }
  var mHouse = std({color:0xd4cabb, roughness:0.9}), mRoofB = std({color:0x3c4450, roughness:0.7});
  for(var k=0;k<14;k++){
    var hs = new THREE.Group();
    addBox(hs, 8, 5, 10, mHouse, 0, 1.1, 0);
    var rf = new THREE.Mesh(new THREE.ConeGeometry(7.5, 3, 4), mRoofB); rf.rotation.y = Math.PI/4; rf.scale.set(1,1,1.3); rf.position.y = 5.1; hs.add(rf);
    hs.position.set(-60 - r()*220, -1.4, -700 + k*100 + r()*40); hs.userData.z0 = hs.position.z; TFAR.add(hs);
  }
})();
function setT(t, speed){
  G.T.visible = true;
  setLight(L_TRAIN);
  var off = t*speed;
  FIELD_MAT.uniforms.uOff.value = -off;
  for(var i=0;i<TPOLES.length;i++){ var z = ((i*42 + off) % 210) - 105; TPOLES[i].position.z = z; }
  for(var k=0;k<TFAR.children.length;k++){
    var o = TFAR.children[k];
    if(o.userData.z0 !== undefined){ o.position.z = ((o.userData.z0 + 700 + off) % 1400) - 700; }
  }
  TFAR.position.z = 0;
}

/* =========================================================================
 * SÂN KHẤU G — THUNG LŨNG LÁ ĐỎ (nơi chưa từng đến)
 * Sông chảy dọc trục z, tâm xr(z). Lối mòn bờ đông. Bậc đá dài lên nhà trọ.
 * ========================================================================= */
var Gg = grp('G');
function xr(z){ return 12*Math.sin(z*0.012) + 6*Math.sin(z*0.031 + 1.0); }
var STAIR = { z:-150, x0:0, x1:0, h0:0, h1:0, n:84 };
function HG0(x,z){
  var d = x - xr(z), ad = Math.abs(d);
  var h = 0.16*Math.pow(Math.max(ad-7,0), 1.32) - 1.0 + fbm2(x*0.02, z*0.02, 4)*12*(ad/(ad+30));
  if(ad < 8) h = -1.0 - 1.6*(1 - smooth(ad/8));
  return h;
}
STAIR.x0 = xr(STAIR.z) + 15; STAIR.x1 = xr(STAIR.z) + 42;
STAIR.h0 = HG0(STAIR.x0, STAIR.z); STAIR.h1 = STAIR.h0 + 22;
function HGa(x,z){
  var h = HG0(x,z);
  var dz = Math.abs(z - STAIR.z);
  if(x > STAIR.x0 - 2 && x < STAIR.x1 + 26 && dz < 16){
    var k = x < STAIR.x1 ? (x - STAIR.x0)/(STAIR.x1 - STAIR.x0) : 1;
    var target = STAIR.h0 + clamp(k,0,1)*(STAIR.h1 - STAIR.h0) - 0.25;
    var wid = x < STAIR.x1 ? 2.2 : 12;
    var bl = 1 - smoothstep(wid, wid + 4, dz);
    if(x < STAIR.x0) bl *= smooth((x - (STAIR.x0-2))/2);
    h = lerp(h, target, bl);
  }
  return h;
}
var TG = makeTerrain(900, 360, -150, HGa);
function HG(x,z){ return TG.h(x,z); }
(function(){
  var geo = TG.geo, pos = geo.attributes.position, nr = geo.attributes.normal, cols = new Float32Array(pos.count*3);
  for(var j=0;j<pos.count;j++){
    var ny = nr.getY(j), x2 = pos.getX(j), z2 = pos.getZ(j), y2 = pos.getY(j);
    var n = vnoise(x2*0.08, z2*0.08), ad = Math.abs(x2 - xr(z2));
    var c;
    if(ad < 9.5) c = [0.34 + n*0.08, 0.32 + n*0.07, 0.28 + n*0.06];
    else if(ny < 0.70) c = [0.30 + n*0.08, 0.27 + n*0.06, 0.24 + n*0.05];
    else c = [0.20 + n*0.08, 0.09 + n*0.04, 0.045 + n*0.02];
    cols[j*3] = c[0]; cols[j*3+1] = c[1]; cols[j*3+2] = c[2];
  }
  geo.setAttribute('color', new THREE.BufferAttribute(cols, 3));
  var m = new THREE.Mesh(geo, std({vertexColors:true, roughness:0.95, map:noiseTex('#ffffff','0,0,0',256,256,61,6000,0.25,[160,160],2)}));
  m.receiveShadow = true; Gg.add(m);
})();
/* rừng lá đỏ: tán cây lượn sóng + cây lá kim sẫm */
(function(){
  var r = HFA.mulberry32(1717);
  var crown = new THREE.SphereGeometry(1, 28, 18);
  var cp = crown.attributes.position, vc = new Float32Array(cp.count*3);
  for(var i=0;i<cp.count;i++){
    var x=cp.getX(i), y=cp.getY(i), z=cp.getZ(i);
    var cl = vnoise3(x*3.1+5, y*3.1, z*3.1), fine = vnoise3(x*9+1, y*9, z*9);
    var k = 0.80 + 0.26*cl + 0.06*fine;
    cp.setXYZ(i, x*k, y*k*0.82, z*k);
    var sh = 0.55 + 0.45*smooth((y+1)/2) ; var br = sh*(0.75 + 0.5*cl)*(0.9 + 0.2*fine);
    vc[i*3] = br; vc[i*3+1] = br; vc[i*3+2] = br;
  }
  crown.setAttribute('color', new THREE.BufferAttribute(vc,3));
  crown.computeVertexNormals();
  var N = 9000, N2 = 1800;
  var im = new THREE.InstancedMesh(crown, std({roughness:0.8, vertexColors:true}), N);
  var cone = new THREE.ConeGeometry(1, 3.2, 9); cone.translate(0, 1.6, 0);
  var im2 = new THREE.InstancedMesh(cone, std({color:0xffffff, roughness:0.9}), N2);
  var m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), sc = new THREE.Vector3(), ps = new THREE.Vector3(), col = new THREE.Color();
  var pal = [[0.55,0.06,0.03],[0.66,0.12,0.03],[0.75,0.24,0.04],[0.80,0.38,0.05],[0.82,0.55,0.08],[0.70,0.62,0.18],[0.42,0.07,0.04]];
  var k1 = 0, k2 = 0, tries = 0;
  while((k1 < N || k2 < N2) && tries < 40000){
    tries++;
    var z = -560 + r()*760, x = xr(z) + (r() < 0.5 ? -1 : 1)*(10 + Math.pow(r(),1.15)*260);
    if(Math.abs(z - STAIR.z) < 9 && x > STAIR.x0 - 20 && x < STAIR.x1 + 2) continue;
    if(z > STAIR.z && z < STAIR.z + 40 && x > STAIR.x0 - 24 && x < STAIR.x0 + 6) continue;
    if(Math.abs(z - STAIR.z) < 18 && x > STAIR.x1 - 2 && x < STAIR.x1 + 26) continue;
    var dP = Math.abs(x - (xr(z) + 11));
    if(dP < 6.0) continue;
    var y = HG(x, z);
    if(r() < 0.78 && k1 < N){
      var s = 1.8 + r()*2.2;
      ps.set(x, y + s*0.7, z); sc.set(s*(0.9+r()*0.3), s*(0.9+r()*0.3), s*(0.9+r()*0.3));
      q.setFromAxisAngle(new THREE.Vector3(0,1,0), r()*6.28);
      m4.compose(ps, q, sc); im.setMatrixAt(k1, m4);
      var p = pal[Math.floor(r()*pal.length)], v = 0.8 + r()*0.35;
      col.setRGB(p[0]*v, p[1]*v, p[2]*v); im.setColorAt(k1, col); k1++;
    } else if(k2 < N2){
      var s2 = 1.6 + r()*1.8;
      ps.set(x, y - 0.3, z); sc.set(s2, s2*(1.6 + r()*0.8), s2); q.identity();
      m4.compose(ps, q, sc); im2.setMatrixAt(k2, m4);
      var v2 = 0.7 + r()*0.3; col.setRGB(0.07*v2, 0.13*v2, 0.07*v2); im2.setColorAt(k2, col); k2++;
    }
  }
  im.count = k1; im2.count = k2;
  im.castShadow = true; im.receiveShadow = true; im2.castShadow = true; im2.receiveShadow = true;
  Gg.add(im); Gg.add(im2);
})();
/* sông */
var RIVER_MAT = new THREE.ShaderMaterial({
  uniforms: THREE.UniformsUtils.merge([THREE.UniformsLib.fog, { uT:{value:0}, uSky:{value:new THREE.Color(0.8,0.8,0.8)} }]),
  vertexShader: ['varying vec3 vW;', '#include <fog_pars_vertex>',
    'void main(){ vec4 w=modelMatrix*vec4(position,1.0); vW=w.xyz; vec4 mvPosition=viewMatrix*w; gl_Position=projectionMatrix*mvPosition;', '#include <fog_vertex>', '}'].join('\n'),
  fragmentShader: ['uniform float uT; uniform vec3 uSky,uSunCol,uAmb,uSunDir; varying vec3 vW;', '#include <fog_pars_fragment>', GLSL_NOISE,
    'void main(){ vec2 p=vW.xz*vec2(0.35,0.12)+vec2(0.0,uT*0.9);',
    ' float n=fbm(p)*0.6+fbm(p*3.1+vec2(3.0,uT*1.4))*0.4;',
    ' vec3 V=normalize(cameraPosition-vW); vec3 N=normalize(vec3((n-0.5)*0.5,1.0,(fbm(p+7.0)-0.5)*0.5));',
    ' float fr=0.04+0.96*pow(1.0-max(dot(N,V),0.0),5.0);',
    ' vec3 deep=vec3(0.05,0.13,0.13)*(uAmb*1.6+uSunCol*0.15);',
    ' vec3 col=mix(deep,uSky*0.9,fr);',
    ' vec3 Hh=normalize(V+normalize(uSunDir)); col+=uSunCol*pow(max(dot(N,Hh),0.0),180.0)*1.5;',
    ' float foam=smoothstep(0.66,0.8,n); col=mix(col,vec3(0.9,0.92,0.9)*(uAmb+uSunCol*0.5),foam*0.6);',
    ' gl_FragColor=vec4(col,1.0);', '#include <fog_fragment>', '}'].join('\n'),
  fog:true, side:THREE.DoubleSide
});
RIVER_MAT.uniforms.uSunCol = SHARED.uSunCol; RIVER_MAT.uniforms.uAmb = SHARED.uAmb; RIVER_MAT.uniforms.uSunDir = SHARED.uSunDir;
(function(){
  var zs = [], n = 220;
  var pos = [], idx = [];
  for(var i=0;i<=n;i++){
    var z = 190 - i*4;
    for(var j=0;j<=4;j++){ var v = j/4 - 0.5; pos.push(xr(z) + v*15, -1.45, z); }
  }
  for(var i2=0;i2<n;i2++) for(var j2=0;j2<4;j2++){ var a = i2*5+j2, b = a+5; idx.push(a,b,a+1, a+1,b,b+1); }
  var g = new THREE.BufferGeometry(); g.setAttribute('position', new THREE.Float32BufferAttribute(pos,3)); g.setIndex(idx);
  Gg.add(new THREE.Mesh(g, RIVER_MAT));
})();
/* lối mòn bờ đông */
(function(){
  var pos = [], idx = [], n = 200;
  for(var i=0;i<=n;i++){
    var z = 150 - i*3.4;
    var xc = xr(z) + 11 + Math.sin(z*0.05)*1.2;
    for(var j=0;j<=2;j++){ var x = xc + (j-1)*0.8; pos.push(x, HG(x,z) + 0.06, z); }
  }
  for(var i2=0;i2<n;i2++) for(var j2=0;j2<2;j2++){ var a=i2*3+j2, b=a+3; idx.push(a,b,a+1, a+1,b,b+1); }
  var g = new THREE.BufferGeometry(); g.setAttribute('position', new THREE.Float32BufferAttribute(pos,3)); g.setIndex(idx); g.computeVertexNormals();
  var m = new THREE.Mesh(g, std({color:0x7a6450, roughness:0.95, side:THREE.DoubleSide, polygonOffset:true, polygonOffsetFactor:-2, polygonOffsetUnits:-2}));
  m.receiveShadow = true; Gg.add(m);
})();
/* bậc đá dài + nhà trọ trên đỉnh */
var INN = new THREE.Group(); Gg.add(INN);
var INN_WIN = std({color:0x1a120a, emissive:new THREE.Color(1.0,0.72,0.38), emissiveIntensity:0.6, roughness:0.6});
(function(){
  var mStone = std({map:noiseTex('#8a857c','40,38,34',128,128,71,2500,0.35,[1,1],3), roughness:0.92});
  var n = STAIR.n, run = (STAIR.x1 - STAIR.x0)/n, rise = (STAIR.h1 - STAIR.h0)/n;
  var geo = new THREE.BoxGeometry(run*1.05, 0.5, 3.0);
  var im = new THREE.InstancedMesh(geo, mStone, n);
  var m4 = new THREE.Matrix4();
  for(var i=0;i<n;i++){ m4.makeTranslation(STAIR.x0 + (i+0.5)*run, STAIR.h0 + (i+1)*rise - 0.25, STAIR.z); im.setMatrixAt(i, m4); }
  im.castShadow = true; im.receiveShadow = true; INN.add(im);
  /* đèn lồng đá hai bên chân bậc */
  var mLan = std({color:0x77726a, roughness:0.9});
  for(var s=-1;s<=1;s+=2){
    addBox(INN, 0.35, 1.2, 0.35, mLan, STAIR.x0 - 0.8, STAIR.h0 + 0.6, STAIR.z + s*1.6);
    addBox(INN, 0.55, 0.12, 0.55, mLan, STAIR.x0 - 0.8, STAIR.h0 + 1.25, STAIR.z + s*1.6);
  }
  /* nhà trọ: tường gỗ tối + trát trắng, mái ngói */
  var bx = STAIR.x1 + 11, by = STAIR.h1, bz = STAIR.z;
  var mWood = std({color:0x3b2618, roughness:0.8}), mPl = std({color:0xd9d2c4, roughness:0.9});
  var mTile = std({color:0x2f3238, roughness:0.55, metalness:0.2});
  addBox(INN, 12, 4.2, 20, mPl, bx, by + 2.1, bz);
  addBox(INN, 12.2, 1.1, 20.2, mWood, bx, by + 0.55, bz);
  addBox(INN, 12.3, 0.3, 20.3, mWood, bx, by + 4.2, bz);
  addBox(INN, 11, 3.4, 18, mPl, bx + 0.4, by + 5.9, bz);
  function gable(w, h, len, y){
    var sh = new THREE.Shape(); sh.moveTo(-w/2, 0); sh.lineTo(w/2, 0); sh.lineTo(0, h); sh.lineTo(-w/2, 0);
    var g = new THREE.ExtrudeGeometry(sh, {depth:len, bevelEnabled:false}); g.translate(0, 0, -len/2);
    var m = new THREE.Mesh(g, mTile); m.position.set(bx, y, bz); m.castShadow = true; m.receiveShadow = true; INN.add(m);
  }
  addBox(INN, 13.8, 0.18, 21.8, mTile, bx, by + 4.36, bz);
  gable(13.4, 3.4, 21.4, by + 7.55);
  addBox(INN, 13.6, 0.16, 21.6, mTile, bx, by + 7.55, bz);
  for(var k=-3;k<=3;k++){
    addPlane(INN, 1.6, 1.3, INN_WIN, bx - 6.02, by + 2.4, bz + k*2.6, -Math.PI/2);
    addPlane(INN, 1.4, 1.1, INN_WIN, bx - 5.12, by + 6.0, bz + k*2.4, -Math.PI/2);
  }
})();
/* lá rơi — vị trí là hàm đóng của t */
var LEAVES;
(function(){
  var N = 420, r = HFA.mulberry32(333);
  var TXL = canvasTex(64,64,function(cx,w,h){
    cx.translate(32,32); cx.fillStyle='#ffffff'; cx.beginPath();
    for(var i=0;i<5;i++){ var a = -Math.PI/2 + i*Math.PI*2/5; cx.lineTo(Math.cos(a)*30, Math.sin(a)*30); var b = a + Math.PI/5; cx.lineTo(Math.cos(b)*12, Math.sin(b)*12); }
    cx.closePath(); cx.fill();
  });
  var geo = new THREE.PlaneGeometry(0.09, 0.09);
  var mat = std({map:TXL, alphaTest:0.5, side:THREE.DoubleSide, roughness:0.8});
  LEAVES = new THREE.InstancedMesh(geo, mat, N);
  var col = new THREE.Color();
  LEAVES.userData.p = [];
  for(var i=0;i<N;i++){
    var p = { x:(r()-0.5)*14, y0:r()*9, z:(r()-0.5)*18, v:0.35 + r()*0.3, ph:r()*6.28, sp:0.8 + r()*1.6, ax:r()*6.28 };
    LEAVES.userData.p.push(p);
    var c = [[0.62,0.08,0.03],[0.78,0.30,0.04],[0.85,0.55,0.08]][i%3]; col.setRGB(c[0],c[1],c[2]); LEAVES.setColorAt(i, col);
  }
  LEAVES.frustumCulled = false; Gg.add(LEAVES);
})();
function setLeaves(t, cx0, cy0, cz0){
  var ps = LEAVES.userData.p, m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), e = new THREE.Euler(), s = new THREE.Vector3(1,1,1), v = new THREE.Vector3();
  for(var i=0;i<ps.length;i++){
    var p = ps[i];
    var y = 9 - ((p.y0 + t*p.v) % 9);
    v.set(cx0 + p.x + Math.sin(t*0.6 + p.ph)*0.6, cy0 + y - 1.5, cz0 + p.z + Math.cos(t*0.4 + p.ph)*0.4);
    e.set(t*p.sp + p.ax, t*p.sp*0.7, p.ax); q.setFromEuler(e);
    m4.compose(v, q, s); LEAVES.setMatrixAt(i, m4);
  }
  LEAVES.instanceMatrix.needsUpdate = true;
}
/* sương sông (dùng chung shader sương với F — định nghĩa ở phần F) */

function setG(m, t){
  G.G.visible = true;
  setLight(lerpL(L_GORGE, L_GORGE_E, m));
  RIVER_MAT.uniforms.uT.value = t;
  RIVER_MAT.uniforms.uSky.value.setRGB(lerp(0.70,0.80,m), lerp(0.74,0.52,m), lerp(0.80,0.40,m));
  INN_WIN.emissiveIntensity = lerp(0.25, 1.6, m);
}

/* =========================================================================
 * SÂN KHẤU D — HÀNH LANG CỬA (những việc ĐÃ LÀM tắt dần; một cửa CHƯA LÀM còn sáng)
 * Hành lang x ∈ [-1.6,1.6], sàn y=0, cao 3.0, chạy về -z. Cửa cuối ở z=-62.
 * ========================================================================= */
var D = grp('D');
var DOORS = [];
var DOOR_END;
(function(){
  var mWallD = std({map:noiseTex('#4a4540','20,18,16',256,256,81,6000,0.25,[10,1.2],3), roughness:0.92});
  var mFloorD = std({map:canvasTex(256,256,function(cx,w,h){ cx.fillStyle='#3a281a'; cx.fillRect(0,0,w,h);
    for(var i=0;i<8;i++){ cx.fillStyle = i%2 ? '#43301f' : '#34241a'; cx.fillRect(i*32,0,31,h); cx.fillStyle='rgba(0,0,0,0.5)'; cx.fillRect(i*32+31,0,1,h); } }, {repeat:[1,24]}), roughness:0.32, metalness:0.05});
  addBox(D, 3.4, 0.1, 70, mFloorD, 0, -0.05, -30, false, true);
  addBox(D, 3.4, 0.1, 70, mWallD, 0, 3.05, -30, false, true);
  addBox(D, 0.1, 3.1, 70, mWallD, -1.65, 1.5, -30, true, true);
  addBox(D, 0.1, 3.1, 70, mWallD, 1.65, 1.5, -30, true, true);
  addBox(D, 3.4, 3.1, 0.1, mWallD, 0, 1.5, -63.2, true, true);
  var mFr = std({color:0x2a1c12, roughness:0.6});
  var mLeaf = std({color:0x4a3322, roughness:0.55});
  function door(x, z, ry, warm){
    var g = new THREE.Group(); g.position.set(x, 0, z); g.rotation.y = ry; D.add(g);
    addBox(g, 0.1, 2.3, 0.08, mFr, -0.5, 1.15, 0.03); addBox(g, 0.1, 2.3, 0.08, mFr, 0.5, 1.15, 0.03);
    addBox(g, 1.1, 0.1, 0.08, mFr, 0, 2.3, 0.03);
    addBox(g, 0.9, 2.2, 0.05, mLeaf, 0, 1.1, 0.0);
    var col = warm ? new THREE.Color(1.0,0.62,0.26) : new THREE.Color(0.70,0.84,1.0);
    var mG = std({color:0x111111, emissive:col, emissiveIntensity:1.0, roughness:0.4});
    var gl = addPlane(g, 0.56, 0.8, mG, 0, 1.55, 0.03);
    var mS = std({color:0x000000, emissive:col, emissiveIntensity:1.0});
    var st = addPlane(g, 0.9, 0.025, mS, 0, 0.015, 0.035);
    var sl = addPlane(g, 0.018, 2.18, mS, 0.455, 1.1, 0.035);
    return {g:g, mG:mG, mS:mS};
  }
  for(var i=0;i<8;i++){
    for(var s=-1;s<=1;s+=2){
      var z = -6 - i*6.5 - (s>0 ? 3.2 : 0);
      var d = door(s*1.59, z, s>0 ? -Math.PI/2 : Math.PI/2, true);
      d.z = z; d.s = s; DOORS.push(d);
    }
  }
  DOOR_END = door(0, -63.14, 0, false);
})();
function setD(camZ, t, endBoost){
  G.D.visible = true;
  setLight(L_CORR);
  var near = [];
  for(var i=0;i<DOORS.length;i++){
    var d = DOORS[i];
    /* cửa sáng lúc còn ở phía trước; camera đi qua rồi thì tắt dần trong ~3.5 s quãng đường */
    var passed = clamp((camZ - 1.0 - d.z)*-1, -99, 99);
    var k = 1 - smooth((d.z - camZ + 1.5) / -5.0 * -1);
    var lit = 1 - smooth((camZ - 1.5 - d.z) / -4.5);
    lit = clamp(lit, 0, 1);
    d.lit = lit;
    d.mG.emissiveIntensity = 0.03 + 1.25*lit;
    d.mS.emissiveIntensity = 0.03 + 2.2*lit;
  }
  DOOR_END.mG.emissiveIntensity = 1.6 + 0.8*endBoost;
  DOOR_END.mS.emissiveIntensity = 3.0 + 1.5*endBoost;
  /* 3 đèn điểm: 2 cửa ấm gần nhất phía trước còn sáng + cửa cuối */
  var cand = DOORS.filter(function(d){ return d.z < camZ && d.lit > 0.05; }).sort(function(a,b){ return b.z - a.z; });
  for(var j=0;j<2;j++){
    if(cand[j]){ PL[j].color.setRGB(1.0,0.62,0.30); PL[j].position.set(cand[j].s*1.2, 1.4, cand[j].z); PL[j].intensity = 1.6*cand[j].lit; PL[j].distance = 9; }
  }
  PL[2].color.setRGB(0.70,0.84,1.0); PL[2].position.set(0, 1.5, -61.5); PL[2].intensity = 2.2 + endBoost; PL[2].distance = 16;
}

/* =========================================================================
 * SÂN KHẤU F — ĐỒNG CỎ NGÃ RẼ (ẩn dụ chính của tập)
 * Nhánh TRÁI = "した後悔" (hổ phách, có dấu chân). Nhánh PHẢI = "しなかった後悔"
 * (xanh nhạt, cỏ mọc lên lối). Đoạn GẦN = hối tiếc gần đây, đoạn XA = cả đời.
 * ÁNH SÁNG LÀ DỮ LIỆU — không cột, không biểu đồ, không %.
 * Ba quy mô ngã rẽ = ba nghiên cứu: FO (1994, vừa) · F22 (2022, nhỏ) · F23 (2023, lớn nhất).
 * ========================================================================= */
function smoothstep(a,b,x){ return smooth((x-a)/(b-a)); }
var F = grp('F');
function HFa(x,z){
  var r = Math.sqrt(x*x + (z+80)*(z+80));
  var h = 1.5*Math.sin(x*0.011+0.5)*Math.cos(z*0.009) + 0.9*Math.sin(x*0.023 + z*0.017 + 1.3) + (fbm2(x*0.01+30, z*0.01, 3)-0.5)*3.2;
  h += smoothstep(250, 700, r) * (30 + 46*fbm2(x*0.004+7, z*0.004, 3));
  return h;
}
var TF = makeTerrain(2400, 440, -80, HFa);
function HF(x,z){ return TF.h(x,z); }
(function(){
  var geo = TF.geo, pos = geo.attributes.position, cols = new Float32Array(pos.count*3);
  for(var i=0;i<pos.count;i++){
    var x = pos.getX(i), z = pos.getZ(i);
    var n = fbm2(x*0.03, z*0.03, 3), n2 = vnoise(x*0.2, z*0.2), n3 = vnoise(x*0.011+4, z*0.011);
    var r = Math.sqrt(x*x + (z+80)*(z+80));
    var far = smoothstep(260, 620, r);
    var c0 = [0.22 + 0.08*n + 0.03*n2 + 0.04*n3, 0.21 + 0.06*n + 0.02*n3, 0.075 + 0.02*n];
    var c1 = [0.10 + 0.04*n, 0.12 + 0.04*n, 0.06 + 0.02*n];
    cols[i*3] = lerp(c0[0],c1[0],far); cols[i*3+1] = lerp(c0[1],c1[1],far); cols[i*3+2] = lerp(c0[2],c1[2],far);
  }
  geo.setAttribute('color', new THREE.BufferAttribute(cols,3));
  var tx = noiseTex('#ffffff','30,34,12',512,512,91,40000,0.5,[420,420],2);
  var m = new THREE.Mesh(geo, std({vertexColors:true, map:tx, roughness:0.95}));
  m.receiveShadow = true; F.add(m);
})();

/* ---- đường mòn: shader tự chiếu sáng + ánh sáng theo khoảng cách ---- */
var PATH_VS = [
  'attribute float aS,aSide,aV; varying float vS,vSide,vV; varying vec3 vW;', '#include <fog_pars_vertex>',
  'void main(){ vS=aS; vSide=aSide; vV=aV; vec4 w=modelMatrix*vec4(position,1.0); vW=w.xyz;',
  ' vec4 mvPosition=viewMatrix*w; gl_Position=projectionMatrix*mvPosition;', '#include <fog_vertex>', '}'
].join('\n');
var PATH_FS = [
  'uniform vec2 uL,uR; uniform float uTrunk,uOn,uFlR,uPulse,uPulseAmp,uGlowK,uLen,uDim;',
  'uniform vec3 uColL,uColR,uColT,uSunCol,uAmb,uSunDir;',
  'varying float vS,vSide,vV; varying vec3 vW;', '#include <fog_pars_fragment>', GLSL_NOISE,
  'float prof(){ if(vSide<0.5) return uTrunk; vec2 nf = vSide<1.5?uL:uR; float p=mix(nf.x,nf.y,smoothstep(0.08,0.92,vS)); if(vSide>1.5) p*=uFlR; return p; }',
  'void main(){',
  ' float av=abs(vV);',
  ' float edge=1.0-smoothstep(0.55,1.0,av+(vn(vW.xz*2.3)-0.5)*0.35);',
  ' float n=vn(vW.xz*1.7)*0.45+vn(vW.xz*6.3)*0.3+vn(vW.xz*21.0)*0.15+vn(vW.xz*90.0)*0.07+hsh(floor(vW.xz*400.0))*0.05;',
  ' vec3 dirt=mix(vec3(0.28,0.21,0.13),vec3(0.50,0.40,0.27),n);',
  ' if(vSide>1.5){ float gr=smoothstep(0.35,0.75,vn(vW.xz*2.7)+0.25*av); dirt=mix(dirt,vec3(0.20,0.23,0.09)*(0.8+0.4*n),0.35+0.5*gr); }',
  ' if(vSide<1.5){ float rut=smoothstep(0.1,0.0,abs(av-0.38)); dirt*=1.0-0.22*rut;',
  '   if(vSide>0.5){ float st=vS*uLen/0.72; float fi=floor(st); float fx=fract(st); float sd=mod(fi,2.0)*2.0-1.0;',
  '     vec2 q=vec2((fx-0.5)/0.30,(vV-sd*0.2)/0.11); float fp=1.0-smoothstep(0.6,1.0,length(q));',
  '     dirt*=1.0-0.38*fp*step(0.25,hsh(vec2(fi,3.0))); } }',
  ' vec3 col=dirt*(uAmb*1.25+uSunCol*max(uSunDir.y,0.0)*1.2)*uDim;',
  ' float p=prof();',
  ' vec3 gc=vSide<0.5?uColT:(vSide<1.5?uColL:uColR);',
  ' float core=1.0-smoothstep(0.0,0.95,av);',
  ' float pulse=vSide<0.5?0.0:uPulseAmp*exp(-pow((vS-uPulse)*7.0,2.0));',
  ' col+=gc*(p*(0.22+0.78*core)+pulse*core)*uGlowK*uOn;',
  ' gl_FragColor=vec4(col,edge);', '#include <fog_fragment>', '}'
].join('\n');
var HALO_FS = [
  'uniform vec2 uL,uR; uniform float uTrunk,uOn,uFlR,uPulse,uPulseAmp,uHalo;',
  'uniform vec3 uColL,uColR,uColT;',
  'varying float vS,vSide,vV; varying vec3 vW;',
  'float prof(){ if(vSide<0.5) return uTrunk; vec2 nf = vSide<1.5?uL:uR; float p=mix(nf.x,nf.y,smoothstep(0.08,0.92,vS)); if(vSide>1.5) p*=uFlR; return p; }',
  'void main(){ float p=prof(); float pulse=vSide<0.5?0.0:uPulseAmp*exp(-pow((vS-uPulse)*7.0,2.0));',
  ' vec3 gc=vSide<0.5?uColT:(vSide<1.5?uColL:uColR);',
  ' float f=exp(-vV*vV*3.2)*(1.0-smoothstep(0.85,1.0,abs(vV)));',
  ' gl_FragColor=vec4(gc*(p+pulse)*f*uHalo*uOn,1.0); }'
].join('\n');
var HALO_VS = 'attribute float aS,aSide,aV; varying float vS,vSide,vV; varying vec3 vW; void main(){ vS=aS; vSide=aSide; vV=aV; vec4 w=modelMatrix*vec4(position,1.0); vW=w.xyz; gl_Position=projectionMatrix*viewMatrix*w; }';
var MOTE_VS = [
  'attribute float aS,aSide,aPh; uniform float uT,uMaxPx,uScale; uniform vec2 uL,uR; uniform float uTrunk,uOn,uFlR,uPulse,uPulseAmp;',
  'varying float vB,vSide;',
  'float prof(){ if(aSide<0.5) return uTrunk; vec2 nf=aSide<1.5?uL:uR; float p=mix(nf.x,nf.y,smoothstep(0.08,0.92,aS)); if(aSide>1.5) p*=uFlR; return p; }',
  'void main(){ vec3 q=position;',
  ' q.y+=0.25+1.3*fract(aPh*7.13)+sin(uT*0.45+aPh*6.0)*0.18; q.x+=sin(uT*0.21+aPh*9.0)*0.35; q.z+=cos(uT*0.17+aPh*5.0)*0.35;',
  ' vec4 mv=modelViewMatrix*vec4(q,1.0); float d=-mv.z;',
  ' gl_PointSize=min(uMaxPx,(0.5+0.8*fract(aPh*3.7))*uScale/max(d,0.1));',
  ' float pulse=uPulseAmp*exp(-pow((aS-uPulse)*7.0,2.0));',
  ' vB=(prof()+pulse)*uOn*smoothstep(0.6,2.5,d)*(0.6+0.4*sin(uT*1.1+aPh*20.0)); vSide=aSide;',
  ' gl_Position=projectionMatrix*mv; }'
].join('\n');
var MOTE_FS = [
  'uniform vec3 uColL,uColR,uColT; varying float vB,vSide;',
  'void main(){ vec2 d=gl_PointCoord-0.5; float r=dot(d,d)*4.0; float a=exp(-r*4.0)*(1.0-step(1.0,r));',
  ' vec3 c=vSide<0.5?uColT:(vSide<1.5?uColL:uColR); gl_FragColor=vec4(c*a*vB*1.6,1.0); }'
].join('\n');

var COL_NEU = [1.0,0.80,0.55], COL_AMB = [1.0,0.42,0.08], COL_BLU = [0.34,0.58,1.0], COL_WW = [1.0,0.86,0.66];
var FORKS = [];
/** o: {x,z,len,w,rot,glowK,maxPx,moteScale,moteDen} */
function makeFork(o){
  var U = {
    uL:{value:new THREE.Vector2(0.5,0.5)}, uR:{value:new THREE.Vector2(0.5,0.5)}, uTrunk:{value:0.4}, uOn:{value:1}, uFlR:{value:1},
    uPulse:{value:-1}, uPulseAmp:{value:0}, uGlowK:{value:(o.glowK||1.4)*0.72}, uLen:{value:o.len}, uDim:{value:1},
    uColL:{value:new THREE.Color(COL_NEU[0],COL_NEU[1],COL_NEU[2])}, uColR:{value:new THREE.Color(COL_NEU[0],COL_NEU[1],COL_NEU[2])},
    uColT:{value:new THREE.Color(COL_NEU[0],COL_NEU[1],COL_NEU[2])},
    uMaxPx:{value:o.maxPx||9}, uScale:{value:o.moteScale||90}
  };
  var c = Math.cos(o.rot||0), s = Math.sin(o.rot||0), L = o.len;
  function toW(lx,lz){ return [o.x + lx*c - lz*s, o.z + lx*s + lz*c]; }
  var ctrl = [
    [[0.0, L*0.34],[0.03*L, L*0.17],[0.0, 0.0]],
    [[0.0,0.0],[-0.05*L,-0.14*L],[-0.17*L,-0.42*L],[-0.28*L,-0.72*L],[-0.34*L,-L]],
    [[0.0,0.0],[0.05*L,-0.14*L],[0.15*L,-0.45*L],[0.30*L,-0.74*L],[0.37*L,-L]]
  ];
  var lines = [];
  var pos = [], aS = [], aSide = [], aV = [], idx = [];
  var hpos = [], HW = o.haloW || 6;
  var mpos = [], mS = [], mSide = [], mPh = [];
  var rr = HFA.mulberry32(Math.floor((o.x+1000)*7 + (o.z+1000)*13));
  var base = 0;
  for(var b=0;b<3;b++){
    var curve = new THREE.CatmullRomCurve3(ctrl[b].map(function(p){ return new THREE.Vector3(p[0],0,p[1]); }));
    var segLen = b===0 ? L*0.34 : L*1.06;
    var M = Math.max(12, Math.ceil(segLen/0.9));
    var pts = curve.getSpacedPoints(M);
    var line = [];
    for(var i=0;i<=M;i++){
      var p = pts[i], pn = pts[Math.min(i+1,M)], pp = pts[Math.max(i-1,0)];
      var tx = pn.x-pp.x, tz = pn.z-pp.z, tl = Math.sqrt(tx*tx+tz*tz)||1;
      var nx = -tz/tl, nz = tx/tl;
      var sN = i/M;
      var wd = o.w*(b===0 ? 1 : (1 - 0.35*sN));
      var wc = toW(p.x, p.z);
      line.push(new THREE.Vector3(wc[0], HF(wc[0],wc[1]) + 0.08, wc[1]));
      for(var j=0;j<=4;j++){
        var v = j/2 - 1;
        var lx = p.x + nx*v*wd*0.5, lz = p.z + nz*v*wd*0.5;
        var w2 = toW(lx,lz);
        pos.push(w2[0], HF(w2[0],w2[1]) + 0.05, w2[1]);
        aS.push(b===0 ? 1 - sN : sN); aSide.push(b); aV.push(v);
        var hx = p.x + nx*v*wd*0.5*HW, hz = p.z + nz*v*wd*0.5*HW, w3 = toW(hx,hz);
        hpos.push(w3[0], HF(w3[0],w3[1]) + 0.12, w3[1]);
      }
    }
    for(var i2=0;i2<M;i2++) for(var j2=0;j2<4;j2++){ var a = base + i2*5 + j2, bb = a + 5; idx.push(a,bb,a+1, a+1,bb,bb+1); }
    base += (M+1)*5;
    lines.push(line);
    var nm = Math.floor(segLen*(o.moteDen||1.0)*(b===0?0.4:1));
    for(var k=0;k<nm;k++){
      var sk = rr(), pk = curve.getPointAt(sk);
      var ang = rr()*6.283, rad = (0.3 + rr()*1.1)*o.w;
      var wk = toW(pk.x + Math.cos(ang)*rad, pk.z + Math.sin(ang)*rad);
      mpos.push(wk[0], HF(wk[0],wk[1]), wk[1]); mS.push(b===0 ? 1-sk : sk); mSide.push(b); mPh.push(rr());
    }
  }
  var g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(pos,3));
  g.setAttribute('aS', new THREE.Float32BufferAttribute(aS,1));
  g.setAttribute('aSide', new THREE.Float32BufferAttribute(aSide,1));
  g.setAttribute('aV', new THREE.Float32BufferAttribute(aV,1));
  g.setIndex(idx);
  var mat = new THREE.ShaderMaterial({ uniforms:THREE.UniformsUtils.merge([THREE.UniformsLib.fog, {}]), vertexShader:PATH_VS, fragmentShader:PATH_FS,
    transparent:true, depthWrite:false, fog:true, side:THREE.DoubleSide, polygonOffset:true, polygonOffsetFactor:-4, polygonOffsetUnits:-4 });
  for(var k2 in U) mat.uniforms[k2] = U[k2];
  mat.uniforms.uSunCol = SHARED.uSunCol; mat.uniforms.uAmb = SHARED.uAmb; mat.uniforms.uSunDir = SHARED.uSunDir;
  var mesh = new THREE.Mesh(g, mat); mesh.renderOrder = 1; mesh.frustumCulled = false;
  var hg = new THREE.BufferGeometry();
  hg.setAttribute('position', new THREE.Float32BufferAttribute(hpos,3));
  hg.setAttribute('aS', g.attributes.aS); hg.setAttribute('aSide', g.attributes.aSide); hg.setAttribute('aV', g.attributes.aV);
  hg.setIndex(idx);
  var hm = new THREE.ShaderMaterial({ uniforms:{ uHalo:{value:o.halo||0.42} }, vertexShader:HALO_VS, fragmentShader:HALO_FS,
    transparent:true, depthWrite:false, side:THREE.DoubleSide, blending:THREE.AdditiveBlending, polygonOffset:true, polygonOffsetFactor:-2, polygonOffsetUnits:-2 });
  for(var k4 in U) hm.uniforms[k4] = U[k4];
  var halo = new THREE.Mesh(hg, hm); halo.renderOrder = 2; halo.frustumCulled = false;
  var mg = new THREE.BufferGeometry();
  mg.setAttribute('position', new THREE.Float32BufferAttribute(mpos,3));
  mg.setAttribute('aS', new THREE.Float32BufferAttribute(mS,1));
  mg.setAttribute('aSide', new THREE.Float32BufferAttribute(mSide,1));
  mg.setAttribute('aPh', new THREE.Float32BufferAttribute(mPh,1));
  var mm = new THREE.ShaderMaterial({ uniforms:{}, vertexShader:MOTE_VS, fragmentShader:MOTE_FS, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending });
  for(var k3 in U) mm.uniforms[k3] = U[k3];
  mm.uniforms.uT = SHARED.uT;
  var motes = new THREE.Points(mg, mm); motes.frustumCulled = false; motes.renderOrder = 2;
  var grpF = new THREE.Group(); grpF.add(mesh); grpF.add(halo); grpF.add(motes); F.add(grpF);
  var fk = { o:o, U:U, g:grpF, lines:lines,
    at:function(side, s){ var ln = lines[side]; var f = clamp(side===0 ? 1-s : s, 0, 1)*(ln.length-1); var i = Math.floor(f), t = f - i; var a = ln[i], bq = ln[Math.min(i+1, ln.length-1)]; return new THREE.Vector3(lerp(a.x,bq.x,t), lerp(a.y,bq.y,t), lerp(a.z,bq.z,t)); },
    center:function(){ var p = lines[0][lines[0].length-1]; return p.clone(); }
  };
  FORKS.push(fk);
  return fk;
}
/** st: {L:[n,f], R:[n,f], T, on, flR, cL, cR, cT, pulse, pAmp, dim} */
function setFork(fk, st){
  fk.g.visible = true;
  var U = fk.U;
  U.uL.value.set(st.L[0], st.L[1]); U.uR.value.set(st.R[0], st.R[1]);
  U.uTrunk.value = st.T != null ? st.T : 0.4; U.uOn.value = st.on != null ? st.on : 1; U.uFlR.value = st.flR != null ? st.flR : 1;
  var cL = st.cL || COL_NEU, cR = st.cR || COL_NEU, cT = st.cT || COL_NEU;
  U.uColL.value.setRGB(cL[0],cL[1],cL[2]); U.uColR.value.setRGB(cR[0],cR[1],cR[2]); U.uColT.value.setRGB(cT[0],cT[1],cT[2]);
  U.uPulse.value = st.pulse != null ? st.pulse : -1; U.uPulseAmp.value = st.pAmp || 0;
  U.uDim.value = st.dim != null ? st.dim : 1;
}
var FO  = makeFork({x:0,    z:0,   len:90,  w:1.6, rot:0,     glowK:1.45, maxPx:10, moteScale:95, moteDen:1.1});
var F22 = makeFork({x:-58,  z:-8,  len:46,  w:1.1, rot:0.12,  glowK:1.45, maxPx:8,  moteScale:80, moteDen:1.1});
var F23 = makeFork({x:105,  z:-6,  len:175, w:2.6, rot:-0.08, glowK:1.45, maxPx:11, moteScale:120, moteDen:1.4});
var F03 = [
  makeFork({x:-235, z:-430, len:80, w:3.2, rot:0.25,  glowK:1.6, maxPx:6, moteScale:200, moteDen:0.6}),
  makeFork({x:10,   z:-540, len:80, w:3.2, rot:0.0,   glowK:1.6, maxPx:6, moteScale:200, moteDen:0.6}),
  makeFork({x:240,  z:-440, len:80, w:3.2, rot:-0.25, glowK:1.6, maxPx:6, moteScale:200, moteDen:0.6})
];
var CITE = [];
(function(){
  var r = HFA.mulberry32(4040), n = 0, tries = 0;
  while(n < 38 && tries < 4000){
    tries++;
    var a = r()*6.283, rad = 150 + r()*260;
    var x = Math.cos(a)*rad, z = -80 + Math.sin(a)*rad;
    if(x > 20 && x < 220 && z > -220 && z < 60) continue;
    if(Math.abs(x) < 90 && z > -120 && z < 70) continue;
    var ok = true;
    for(var i=0;i<CITE.length;i++){ var c = CITE[i].o; if((c.x-x)*(c.x-x)+(c.z-z)*(c.z-z) < 60*60){ ok = false; break; } }
    if(!ok) continue;
    var fk = makeFork({x:x, z:z, len:26 + r()*16, w:1.6, rot:(r()-0.5)*1.4, glowK:1.6, maxPx:5, moteScale:120, moteDen:0.5});
    fk.flick = r(); fk.flOff = r() < 0.42;
    CITE.push(fk); n++;
  }
})();

/* ---- cỏ (instanced, lay theo gió — hàm của t) ---- */
var GRASS_VS = [
  'attribute vec3 aOff; attribute float aRot,aH,aC; attribute vec2 bo; attribute float ba;',
  'uniform float uT; varying float vY,vC; varying vec3 vW;', '#include <fog_pars_vertex>',
  'void main(){ float yy=position.y; float hh=aH*(0.75+0.5*fract(ba*3.7)); hh*=1.0-smoothstep(38.0,62.0,distance(cameraPosition,aOff));',
  ' float bx=position.x*0.06*(1.0-yy*0.9);',
  ' float an=aRot+ba; float c=cos(an), s=sin(an);',
  ' vec3 p=vec3(bx*c, yy*hh, bx*s); p.xz+=bo*0.09;',
  ' float bend=(sin(uT*1.1+aOff.x*0.31+aOff.z*0.19)*0.5+0.5)*0.30+0.12+sin(uT*2.3+aOff.x*1.7+aOff.z+ba)*0.05;',
  ' p.x+=bend*yy*yy*hh*0.8+bo.x*yy*hh*0.35; p.z+=bend*yy*yy*hh*0.35+bo.y*yy*hh*0.35;',
  ' vec4 w=modelMatrix*vec4(p+aOff,1.0); vW=w.xyz; vY=yy; vC=fract(aC+ba*0.37);',
  ' vec4 mvPosition=viewMatrix*w; gl_Position=projectionMatrix*mvPosition;', '#include <fog_vertex>', '}'
].join('\n');
var GRASS_FS = [
  'uniform vec3 uSunCol,uAmb,uSunDir; varying float vY,vC; varying vec3 vW;', '#include <fog_pars_fragment>',
  'void main(){ vec3 root=vec3(0.035,0.045,0.015); vec3 tipA=vec3(0.42,0.36,0.12), tipB=vec3(0.20,0.27,0.07);',
  ' vec3 c=mix(root,mix(tipA,tipB,vC),smoothstep(0.0,0.9,vY));',
  ' vec3 V=normalize(vW-cameraPosition); float bl=pow(max(dot(V,normalize(uSunDir))*-1.0+0.0,0.0),1.0);',
  ' float tr=pow(max(dot(-V,normalize(uSunDir)),0.0),3.0);',
  ' vec3 col=c*(uAmb*1.2+uSunCol*(0.45+0.25*vY))+uSunCol*vec3(1.0,0.85,0.45)*tr*vY*vY*0.35;',
  ' gl_FragColor=vec4(col,1.0);', '#include <fog_fragment>', '}'
].join('\n');
function distToFork(fk, x, z){
  var best = 1e9, side = -1, sBest = 0;
  for(var b=0;b<3;b++){
    var ln = fk.lines[b];
    for(var i=0;i<ln.length;i+=1){ var dx = ln[i].x - x, dz = ln[i].z - z; var d = dx*dx + dz*dz; if(d < best){ best = d; side = b; sBest = i/(ln.length-1); } }
  }
  return {d:Math.sqrt(best), side:side, s:sBest};
}
/* mặt nạ lưới 0.25 m quanh ngã rẽ: 1 = lòng đường (trục + nhánh trái), 2 = nhánh phải (cỏ mọc thưa)
 * — thay cho đo khoảng cách từng điểm (quá chậm, trang nạp > 10 s). */
function forkMask(fk, cx, cz, R, pad){
  var cell = 0.25, n = Math.ceil(R*2/cell) + 8, x0 = cx - R - 1, z0 = cz - R - 1;
  var m = new Uint8Array(n*n);
  for(var b=0;b<3;b++){
    var ln = fk.lines[b];
    for(var i=0;i<ln.length;i++){
      var sN = i/(ln.length-1);
      var code = (b===2 && sN > 0.06) ? 2 : 1;
      var rr = fk.o.w*(b===0 ? 1 : (1 - 0.35*sN))*0.55 + pad;
      var dense = 4;
      for(var q=0;q<dense;q++){
        var a = ln[i], bq = ln[Math.min(i+1, ln.length-1)], f = q/dense;
        var px = lerp(a.x,bq.x,f), pz = lerp(a.z,bq.z,f);
        var ix0 = Math.floor((px - rr - x0)/cell), ix1 = Math.ceil((px + rr - x0)/cell);
        var iz0 = Math.floor((pz - rr - z0)/cell), iz1 = Math.ceil((pz + rr - z0)/cell);
        for(var iz=Math.max(0,iz0); iz<=Math.min(n-1,iz1); iz++) for(var ix=Math.max(0,ix0); ix<=Math.min(n-1,ix1); ix++){
          var dx = x0 + ix*cell - px, dz = z0 + iz*cell - pz;
          if(dx*dx + dz*dz <= rr*rr){ var k = iz*n+ix; if(m[k] === 0 || code === 1) m[k] = code; }
        }
      }
    }
  }
  return function(x,z){ var ix = Math.round((x - x0)/cell), iz = Math.round((z - z0)/cell); if(ix<0||iz<0||ix>=n||iz>=n) return 0; return m[iz*n+ix]; };
}
function makeGrass(fk, cx, cz, R, N, seed){
  var mask = forkMask(fk, cx, cz, R, 0.15);
  var r = HFA.mulberry32(seed);
  var blade = new THREE.BufferGeometry();
  var bp = [], bi = [], bov = [], bav = [], rb = HFA.mulberry32(seed + 1);
  for(var k=0;k<4;k++){
    var base = k*9, ang = k*1.57 + rb()*0.8, ox = (rb()-0.5)*2, oz = (rb()-0.5)*2;
    for(var i=0;i<4;i++){ var y = i/4; bp.push(-0.5, y, 0,  0.5, y, 0); bov.push(ox,oz, ox,oz); bav.push(ang, ang); }
    bp.push(0, 1, 0); bov.push(ox,oz); bav.push(ang);
    for(var i2=0;i2<3;i2++){ var a2 = base + i2*2; bi.push(a2, a2+1, a2+2,  a2+1, a2+3, a2+2); }
    bi.push(base+6, base+7, base+8);
  }
  blade.setAttribute('position', new THREE.Float32BufferAttribute(bp,3)); blade.setIndex(bi);
  blade.setAttribute('bo', new THREE.Float32BufferAttribute(bov,2)); blade.setAttribute('ba', new THREE.Float32BufferAttribute(bav,1));
  var ig = new THREE.InstancedBufferGeometry();
  ig.index = blade.index; ig.attributes.position = blade.attributes.position; ig.attributes.bo = blade.attributes.bo; ig.attributes.ba = blade.attributes.ba;
  var off = [], rot = [], hh = [], cc = [];
  var n = 0, tries = 0;
  while(n < N && tries < N*4){
    tries++;
    var a = r()*6.283, rad = Math.sqrt(r())*R;
    var x = cx + Math.cos(a)*rad, z = cz + Math.sin(a)*rad;
    var mk = mask(x, z), hm = 0.35 + 0.65*smoothstep(R, R*0.62, rad);
    if(mk === 1) continue;
    if(mk === 2){ if(r() < 0.45) continue; hm *= 0.55; }
    off.push(x, HF(x,z) - 0.01, z); rot.push(r()*6.283); hh.push((0.26 + r()*0.3)*hm*(0.8 + 0.4*vnoise(x*0.15,z*0.15))); cc.push(r());
    n++;
  }
  ig.setAttribute('aOff', new THREE.InstancedBufferAttribute(new Float32Array(off),3));
  ig.setAttribute('aRot', new THREE.InstancedBufferAttribute(new Float32Array(rot),1));
  ig.setAttribute('aH', new THREE.InstancedBufferAttribute(new Float32Array(hh),1));
  ig.setAttribute('aC', new THREE.InstancedBufferAttribute(new Float32Array(cc),1));
  ig.instanceCount = n;
  var mat = new THREE.ShaderMaterial({ uniforms:THREE.UniformsUtils.merge([THREE.UniformsLib.fog, {}]), vertexShader:GRASS_VS, fragmentShader:GRASS_FS, side:THREE.DoubleSide, fog:true });
  mat.uniforms.uT = SHARED.uT; mat.uniforms.uSunCol = SHARED.uSunCol; mat.uniforms.uAmb = SHARED.uAmb; mat.uniforms.uSunDir = SHARED.uSunDir;
  var m = new THREE.Mesh(ig, mat); m.frustumCulled = false; F.add(m);
  return m;
}
var GRASS_O = makeGrass(FO, 0, -14, 46, 95000, 7001);
var GRASS_23 = makeGrass(F23, 108, -36, 52, 85000, 7002);

/* ---- cột sáng mảnh: mỗi cột = một người trả lời (32 ở FO, 2.600 ở F23) ---- */
var COLS_VS = [
  'attribute vec3 aOff; attribute float aPh,aHue; uniform float uGrow,uH,uWid,uT; varying float vY,vA,vHue; varying vec2 vUv;',
  'void main(){ float g=clamp(uGrow*1.35-aPh*0.35,0.0,1.0); g=g*g*(3.0-2.0*g);',
  ' vec4 mv=modelViewMatrix*vec4(aOff+vec3(0.0,position.y*uH*max(g,0.001),0.0),1.0);',
  ' float wid=max(uWid,-mv.z*0.0019); mv.x+=position.x*wid;',
  ' vY=position.y; vA=g*(0.8+0.2*sin(uT*0.9+aPh*40.0)); vHue=aHue; vUv=uv; gl_Position=projectionMatrix*mv; }'
].join('\n');
var COLS_FS = [
  'uniform vec3 uColL,uColR,uColW; uniform float uHueMix,uOp; varying float vY,vA,vHue; varying vec2 vUv;',
  'void main(){ float x=abs(vUv.x-0.5)*2.0; float core=exp(-x*x*5.0);',
  ' float fade=pow(1.0-vY,1.3)*smoothstep(0.0,0.04,vY);',
  ' vec3 c=mix(uColW,mix(uColL,uColR,vHue),uHueMix);',
  ' gl_FragColor=vec4(c*core*fade*vA*uOp,1.0); }'
].join('\n');
function makeColumns(fk, N, rMin, rMax, seed, hgt){
  var r = HFA.mulberry32(seed);
  var q = new THREE.PlaneGeometry(1,1); q.translate(0,0.5,0);
  var ig = new THREE.InstancedBufferGeometry(); ig.index = q.index; ig.attributes.position = q.attributes.position; ig.attributes.uv = q.attributes.uv;
  var off = [], ph = [], hue = [];
  var c = fk.center(), n = 0, tries = 0;
  var mask = forkMask(fk, c.x, c.z - rMax*0.35, rMax*1.3, 0.4 + fk.o.w*0.35);
  while(n < N && tries < N*20){
    tries++;
    var a = r()*6.283, rad = rMin + Math.sqrt(r())*(rMax - rMin);
    var x = c.x + Math.cos(a)*rad, z = c.z + Math.sin(a)*rad*1.25 - rad*0.35;
    if(mask(x, z)) continue;
    off.push(x, HF(x,z), z); ph.push(r()); hue.push(r() < 0.51 ? 0 : 1); n++;
  }
  ig.setAttribute('aOff', new THREE.InstancedBufferAttribute(new Float32Array(off),3));
  ig.setAttribute('aPh', new THREE.InstancedBufferAttribute(new Float32Array(ph),1));
  ig.setAttribute('aHue', new THREE.InstancedBufferAttribute(new Float32Array(hue),1));
  ig.instanceCount = n;
  var mat = new THREE.ShaderMaterial({
    uniforms:{ uGrow:{value:0}, uH:{value:hgt||2.2}, uWid:{value:0.16}, uT:SHARED.uT, uColL:{value:new THREE.Color(COL_AMB[0],COL_AMB[1],COL_AMB[2])},
      uColR:{value:new THREE.Color(COL_BLU[0],COL_BLU[1],COL_BLU[2])}, uColW:{value:new THREE.Color(1.0,0.9,0.75)}, uHueMix:{value:0}, uOp:{value:1.4} },
    vertexShader:COLS_VS, fragmentShader:COLS_FS, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending });
  var m = new THREE.Mesh(ig, mat); m.frustumCulled = false; m.renderOrder = 3; F.add(m);
  return m;
}
var COLS_O = makeColumns(FO, 32, 5, 13, 8801, 2.2);
var COLS_23 = makeColumns(F23, 2600, 6, 58, 8802, 2.2);
function setCols(m, grow, hueMix, op){ m.visible = grow > 0.001; m.material.uniforms.uGrow.value = grow; m.material.uniforms.uHueMix.value = hueMix || 0; m.material.uniforms.uOp.value = op != null ? op : 1.4; }

/* ---- sương: các tấm billboard mềm quay về camera (không phải lớp phẳng — nhìn thấp
 * sẽ lộ sọc ngang). Vị trí trong hộp đơn vị, nhóm MIST co giãn theo x/z. ---- */
var MIST_VS = [
  'attribute vec3 aOff; attribute float aSz,aPh; uniform float uH,uSize; varying vec2 vUv; varying float vPh,vNear;',
  'void main(){ vUv=uv; vPh=aPh;',
  ' vec3 c=(modelMatrix*vec4(aOff.x,0.0,aOff.z,1.0)).xyz + vec3(0.0, aOff.y*uH + uSize*aSz*0.25, 0.0);',
  ' vec4 mv=viewMatrix*vec4(c,1.0); mv.xy+=position.xy*uSize*aSz; vNear=smoothstep(1.0,6.0,-mv.z);',
  ' gl_Position=projectionMatrix*mv; }'
].join('\n');
var MIST_FS = ['uniform float uMist,uT; uniform vec3 uCol; varying vec2 vUv; varying float vPh,vNear;', GLSL_NOISE,
  'void main(){ vec2 d=vUv-0.5; float r=length(d)*2.0; float soft=1.0-smoothstep(0.2,1.0,r);',
  ' float n=fbm(vUv*2.6+vec2(vPh*13.0+uT*0.02, vPh*7.0));',
  ' float a=soft*smoothstep(0.25,0.75,n)*uMist*vNear; gl_FragColor=vec4(uCol,a*0.42); }'].join('\n');
var MIST_MAT;
var MIST = (function(){
  var q = new THREE.PlaneGeometry(1,1);
  var ig = new THREE.InstancedBufferGeometry(); ig.index = q.index; ig.attributes.position = q.attributes.position; ig.attributes.uv = q.attributes.uv;
  var r = HFA.mulberry32(6161), N = 90, off = [], sz = [], ph = [];
  for(var i=0;i<N;i++){ off.push(r()-0.5, r(), r()-0.5); sz.push(0.6 + r()*0.8); ph.push(r()); }
  ig.setAttribute('aOff', new THREE.InstancedBufferAttribute(new Float32Array(off),3));
  ig.setAttribute('aSz', new THREE.InstancedBufferAttribute(new Float32Array(sz),1));
  ig.setAttribute('aPh', new THREE.InstancedBufferAttribute(new Float32Array(ph),1));
  ig.instanceCount = N;
  MIST_MAT = new THREE.ShaderMaterial({ uniforms:{ uMist:{value:0}, uT:SHARED.uT, uH:{value:1}, uSize:{value:10}, uCol:{value:new THREE.Color(0.8,0.75,0.7)} },
    vertexShader:MIST_VS, fragmentShader:MIST_FS, transparent:true, depthWrite:false });
  var m = new THREE.Mesh(ig, MIST_MAT); m.frustumCulled = false; m.renderOrder = 4;
  var g = new THREE.Group(); g.add(m); F.add(g); return g;
})();
/** khối sương: tâm (x,z), kích thước sx×sz, lượng amt, cao hy (m) */
function setMist(x, z, sx, sz, amt, hy, rotY){
  MIST.visible = amt > 0.001;
  MIST.position.set(x, HF(x,z), z); MIST.rotation.y = rotY || 0;
  MIST.scale.set(sx, 1, sz);
  MIST_MAT.uniforms.uMist.value = amt;
  MIST_MAT.uniforms.uH.value = Math.max(0.05, hy*0.6);
  MIST_MAT.uniforms.uSize.value = Math.max(3, Math.min(sx, sz)*0.32) * (0.4 + 0.6*clamp(hy/2.6, 0, 1));
  var a = SHARED.uAmb.value, s = SHARED.uSunCol.value;
  MIST_MAT.uniforms.uCol.value.setRGB(a.r*1.1 + s.r*0.25, a.g*1.1 + s.g*0.25, a.b*1.1 + s.b*0.25);
}

/* ---- đá tảng trên nhánh phải của FO: "lý do đã ngần ngại" ---- */
var ROCKS = new THREE.Group(); F.add(ROCKS);
(function(){
  var geo = new THREE.IcosahedronGeometry(1, 4);
  var p = geo.attributes.position;
  for(var i=0;i<p.count;i++){
    var x=p.getX(i), y=p.getY(i), z=p.getZ(i);
    var k = 0.78 + 0.35*vnoise3(x*1.6+3, y*1.6, z*1.6) + 0.12*vnoise3(x*5, y*5+2, z*5);
    p.setXYZ(i, x*k, y*k*0.8, z*k);
  }
  geo.computeVertexNormals();
  var TXR = noiseTex('#9a948a','40,38,34',256,256,97,12000,0.4,[2,2],2);
  var mat = std({map:TXR, color:0xc8c2b8, roughness:0.9, bumpMap:TXR, bumpScale:0.04});
  var spots = [[0.42,-0.1,1.7,1.25],[0.47,0.55,1.25,0.95],[0.51,-0.45,0.9,0.7]];
  for(var j=0;j<spots.length;j++){
    var sp = spots[j], c = FO.at(2, sp[0]);
    var m = new THREE.Mesh(geo, mat); m.position.set(c.x + sp[1]*1.6, c.y + sp[3]*0.35, c.z); m.scale.set(sp[2], sp[3], sp[2]*1.1);
    m.rotation.y = j*1.7; m.castShadow = true; m.receiveShadow = true; ROCKS.add(m);
  }
})();

/* ---- cổng gỗ cuối nhánh trái của FO: "đã khép lại" ---- */
var GATE = new THREE.Group(); F.add(GATE);
var GATE_LEAVES = [];
(function(){
  var mW = std({color:0x5a3f2a, roughness:0.85, map:noiseTex('#8a6a4a','40,26,14',128,128,17,3000,0.5,[1,1],2)});
  var c = FO.at(1, 0.9), c2 = FO.at(1, 0.93);
  var dir = Math.atan2(c2.x - c.x, c2.z - c.z);
  GATE.position.copy(c); GATE.rotation.y = dir + Math.PI/2;
  var half = 1.15;
  for(var s=-1;s<=1;s+=2){
    addBox(GATE, 0.14, 1.5, 0.14, mW, s*half, 0.72, 0);
    for(var k=1;k<=3;k++){ addBox(GATE, 0.1, 1.15, 0.1, mW, s*(half + k*1.25), 0.55, 0); }
    addBox(GATE, 3.75, 0.07, 0.05, mW, s*(half + 1.87), 0.9, 0); addBox(GATE, 3.75, 0.07, 0.05, mW, s*(half + 1.87), 0.4, 0);
    var hinge = new THREE.Group(); hinge.position.set(s*(half - 0.07), 0, 0); GATE.add(hinge);
    var lw = half - 0.1;
    var leaf = new THREE.Group(); leaf.position.x = -s*lw/2; hinge.add(leaf);
    addBox(leaf, lw, 0.07, 0.04, mW, 0, 1.05, 0); addBox(leaf, lw, 0.07, 0.04, mW, 0, 0.3, 0);
    for(var q=0;q<4;q++) addBox(leaf, 0.06, 0.82, 0.03, mW, -lw/2 + 0.08 + q*(lw-0.16)/3, 0.68, 0.02);
    var br = addBox(leaf, Math.sqrt(lw*lw + 0.75*0.75)*0.95, 0.05, 0.03, mW, 0, 0.68, -0.02); br.rotation.z = s*Math.atan2(0.75, lw);
    GATE_LEAVES.push({h:hinge, s:s});
  }
})();
function setGate(open){ for(var i=0;i<GATE_LEAVES.length;i++){ GATE_LEAVES[i].h.rotation.y = GATE_LEAVES[i].s*open*1.35; } }

/* ---- vết nứt tự liền trên nhánh trái ---- */
var CRACK_MAT = new THREE.ShaderMaterial({
  uniforms:{ uCrack:{value:1}, uT:SHARED.uT },
  vertexShader:'varying vec2 vUv; void main(){ vUv=uv; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }',
  fragmentShader:['uniform float uCrack,uT; varying vec2 vUv;', GLSL_NOISE,
    'void main(){ float x=vUv.x; float y=vUv.y-0.5;',
    ' float yc=0.16*(fbm(vec2(x*3.0,1.7))-0.5)+0.06*(vn(vec2(x*18.0,4.0))-0.5);',
    ' float taper=1.0-pow(abs(x-0.5)*2.0,1.6);',
    ' float w=uCrack*0.07*taper+0.0001; float d=abs(y-yc);',
    ' float br=0.0; for(int i=0;i<3;i++){ float bx=0.25+float(i)*0.22; float by=yc+(x-bx)*(i==1?-0.9:0.8); float bd=abs(y-by); float m=step(bx,x)*step(x,bx+0.12); br=max(br,m*smoothstep(w*0.5,0.0,bd)); }',
    ' float core=max(smoothstep(w,w*0.25,d),br);',
    ' float rim=smoothstep(w*3.0,w,d)*step(0.001,uCrack)*taper;',
    ' vec3 glow=vec3(1.0,0.52,0.16)*(2.2+0.4*sin(uT*2.0));',
    ' vec3 col=mix(vec3(0.06,0.04,0.03),glow,core);',
    ' float a=max(core,rim*0.55);',
    ' gl_FragColor=vec4(col,a); }'].join('\n'),
  transparent:true, depthWrite:false, polygonOffset:true, polygonOffsetFactor:-8, polygonOffsetUnits:-8
});
var CRACK = new THREE.Mesh(new THREE.PlaneGeometry(2.6, 1.2), CRACK_MAT); F.add(CRACK); CRACK.renderOrder = 5;
(function(){
  var a = FO.at(1, 0.1), b = FO.at(1, 0.13);
  CRACK.position.set(a.x, a.y + 0.03, a.z);
  CRACK.rotation.order = 'YXZ';
  CRACK.rotation.y = Math.atan2(b.x - a.x, b.z - a.z) + Math.PI/2;
  CRACK.rotation.x = -Math.PI/2;
})();

/* ---- màn quét đo (tia sáng quét qua ngã rẽ) ---- */
var SCAN_MAT = new THREE.ShaderMaterial({
  uniforms:{ uOp:{value:0} },
  vertexShader:'varying vec2 vUv; void main(){ vUv=uv; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }',
  fragmentShader:'uniform float uOp; varying vec2 vUv; void main(){ float e=smoothstep(0.0,0.15,vUv.x)*smoothstep(1.0,0.85,vUv.x); float line=exp(-pow(vUv.y*28.0,2.0))*2.5+exp(-vUv.y*4.0)*0.18; gl_FragColor=vec4(vec3(0.85,0.92,1.0)*line*e*uOp,1.0); }',
  transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, side:THREE.DoubleSide
});
var SCAN = new THREE.Mesh(new THREE.PlaneGeometry(110, 7), SCAN_MAT); SCAN.renderOrder = 6; F.add(SCAN);

/* ---- hộp kính: "hứa đăng TRƯỚC khi thấy kết quả" ---- */
var GLASS = new THREE.Group(); F.add(GLASS);
(function(){
  var geo = new THREE.BoxGeometry(52, 10, 64);
  var m = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({color:0xcfe0ea, roughness:0.04, metalness:0.1, transparent:true, opacity:0.10, depthWrite:false, side:THREE.DoubleSide}));
  m.renderOrder = 7; GLASS.add(m);
  var e = new THREE.LineSegments(new THREE.EdgesGeometry(geo), new THREE.LineBasicMaterial({color:new THREE.Color(1.6,1.5,1.35), transparent:true, opacity:0.9}));
  GLASS.add(e);
})();

/* ---- đồng xu (cận cảnh) ---- */
var COIN = new THREE.Group(); F.add(COIN);
(function(){
  function face(seed, kind){
    return canvasTex(512,512,function(cx,w,h){
      cx.fillStyle='#8a8a86'; cx.fillRect(0,0,w,h);
      cx.strokeStyle='#d8d8d2'; cx.lineWidth=10; cx.beginPath(); cx.arc(256,256,236,0,6.283); cx.stroke();
      for(var i=0;i<72;i++){ var a=i/72*6.283; cx.fillStyle='#cfcfca'; cx.beginPath(); cx.arc(256+Math.cos(a)*212,256+Math.sin(a)*212,5,0,6.283); cx.fill(); }
      if(kind===0){
        cx.translate(256,256);
        for(var k=0;k<5;k++){ cx.save(); cx.rotate(k/5*6.283); cx.fillStyle='#e2e2dc'; cx.beginPath(); cx.ellipse(0,-78,46,82,0,0,6.283); cx.fill();
          cx.strokeStyle='#8a8a86'; cx.lineWidth=5; cx.beginPath(); cx.moveTo(0,-10); cx.lineTo(0,-150); cx.stroke(); cx.restore(); }
        cx.fillStyle='#bdbdb6'; cx.beginPath(); cx.arc(0,0,26,0,6.283); cx.fill();
      } else {
        cx.strokeStyle='#e2e2dc'; cx.lineWidth=26; cx.beginPath(); cx.arc(256,256,110,0,6.283); cx.stroke();
        cx.lineWidth=8; cx.beginPath(); cx.arc(256,256,160,0,6.283); cx.stroke();
      }
    });
  }
  var ta = face(1,0), tb = face(2,1);
  var rim = std({color:0xc9c6bd, roughness:0.32, metalness:0.65});
  var fa = std({color:0xd9d6cd, roughness:0.36, metalness:0.6, map:ta, bumpMap:ta, bumpScale:0.0004});
  var fb = std({color:0xd9d6cd, roughness:0.36, metalness:0.6, map:tb, bumpMap:tb, bumpScale:0.0004});
  var geo = new THREE.CylinderGeometry(0.0113, 0.0113, 0.0017, 64);
  var m = new THREE.Mesh(geo, [rim, fa, fb]); m.castShadow = true; m.receiveShadow = true; COIN.add(m);
})();

/* =========================================================================
 * ENV MAP vàng chiều cho đồng xu (kim loại cần môi trường để phản xạ)
 * ========================================================================= */
/* (đồng xu dùng kim loại bán phần — ánh nắng + hemi chiếu trực tiếp, không cần PMREM riêng) */

/* =========================================================================
 * CHỮ ĐỘNG (HTML) — nguồn nghiên cứu, câu trích, nhãn nhánh
 * Vùng an toàn: cách mép ≥ 80px; nhãn chiếu 3D bị kẹp trong y ≤ 62% khung
 * để không bao giờ chạm phụ đề (#sub ở đáy) hay nhãn chương.
 * ========================================================================= */
var KIN = {};
function kDef(id, cls, html, style){
  var d = document.createElement('div'); d.className = 'kt ' + cls; d.innerHTML = html;
  if(style) d.setAttribute('style', style);
  kinEl.appendChild(d); KIN[id] = {el:d, op:0, x:null, y:null, _o:-1};
}
function kOn(id, op){ var k = KIN[id]; if(op > k.op) k.op = op; }
var _pv = new THREE.Vector3();
function kAt(id, op, v, dy){
  if(op <= 0.001) return;
  _pv.copy(v).project(camera);
  if(_pv.z > 1) return;
  var k = KIN[id];
  k.op = Math.max(k.op, op);
  k.x = clamp((_pv.x*0.5 + 0.5)*W, 200, W - 200);
  k.y = clamp((-_pv.y*0.5 + 0.5)*H + (dy||0), 110, H*0.62);
}
function kFlush(){
  for(var id in KIN){
    var k = KIN[id], o = k.op;
    if(k._o !== o){ k.el.style.opacity = o.toFixed(3); k._o = o; }
    if(k.x != null){ k.el.style.left = k.x.toFixed(1) + 'px'; k.el.style.top = k.y.toFixed(1) + 'px'; }
    k.op = 0; k.x = null;
  }
}
kDef('s94', 'ks', 'Gilovich &amp; Medvec（1994）<small>Journal of Personality and Social Psychology</small>');
kDef('s95', 'ks', 'Gilovich &amp; Medvec（1995）<small>Psychological Review　後悔の仕組みを論じた論文</small>');
kDef('s03', 'ks', 'Gilovich ほか（2003）<small>日本・中国・ロシアで調査　Journal of Cross-Cultural Psychology</small>');
kDef('s22', 'ks', 'Yeung &amp; Feldman（2022）<small>Collabra: Psychology　オンライン調査・約1,000人</small>');
kDef('s23', 'ks', 'Richardson &amp; Gilovich（2023）<small>Royal Society Open Science　2,600人</small>');
kDef('lWeek', 'kl', 'この一週間の後悔');
kDef('lLife', 'kl', '人生全体の後悔');
kDef('lDid', 'kl', '<i style="background:#ffa24a"></i>した後悔');
kDef('lDidnt', 'kl', '<i style="background:#9cc2ff"></i>しなかった後悔');
kDef('lRecent', 'kl', 'ごく最近の後悔');
kDef('lBest', 'kl', '人生で一番の後悔');
kDef('lReason', 'kl', 'ためらった理由（怖さ・迷い）');
kDef('l32', 'kl', '元の研究　32人');
kDef('l2600', 'kl', '測り直し　2,600人');
kDef('lJP', 'kl', '日本'); kDef('lCN', 'kl', '中国'); kDef('lRU', 'kl', 'ロシア');
kDef('lJP2', 'kl', '日本（2003年・少人数）');
kDef('w1', 'kw', '謝る', 'right:90px;top:120px;');
kDef('w2', 'kw', 'やり直す', 'right:90px;top:210px;');
kDef('w3', 'kw', 'よかった点を探す', 'right:90px;top:300px;');
kDef('seal', 'kw', '結果を見る前に、分析方法と掲載を決める', 'left:50%;top:110px;transform:translateX(-50%);');
kDef('why1', 'kw', '時代のせい？', 'right:90px;top:120px;');
kDef('why2', 'kw', '聞いた相手のせい？', 'right:90px;top:210px;');
kDef('why3', 'kw', '聞き方のせい？', 'right:90px;top:300px;');

/* =========================================================================
 * TRẠNG THÁI ÁNH SÁNG NGÃ RẼ (ánh sáng = dữ liệu)
 * ========================================================================= */
var ST_NEU  = {L:[0.55,0.55], R:[0.55,0.55], T:0.42};
var ST_ORIG = {L:[1.05,0.16], R:[0.32,1.30], T:0.42, cL:COL_AMB, cR:COL_BLU};
var ST_Y22  = {L:[0.85,0.42], R:[0.48,0.78], T:0.40, cL:COL_AMB, cR:COL_BLU};
var ST_Y23  = {L:[1.10,0.78], R:[0.52,0.80], T:0.42, cL:COL_AMB, cR:COL_WW};
function stMix(A, B, p){
  return { L:mixArr(A.L,B.L,p), R:mixArr(A.R,B.R,p), T:lerp(A.T||0.4,B.T||0.4,p),
    cL:mixArr(A.cL||COL_NEU, B.cL||COL_NEU, p), cR:mixArr(A.cR||COL_NEU, B.cR||COL_NEU, p) };
}
function withOn(st, on){ var o = {}; for(var k in st) o[k] = st[k]; o.on = on; return o; }

/** bật sân khấu F: ẩn mọi phần phụ, bật FO + cỏ + đá + cổng */
function setF(L){
  G.F.visible = true;
  setLight(L);
  for(var i=0;i<FORKS.length;i++) FORKS[i].g.visible = false;
  COLS_O.visible = false; COLS_23.visible = false; MIST.visible = false;
  SCAN.visible = false; GLASS.visible = false; COIN.visible = false;
  CRACK.visible = true; CRACK_MAT.uniforms.uCrack.value = 1; ROCKS.visible = false; GATE.visible = true; setGate(1);
  GRASS_O.visible = true; GRASS_23.visible = true;
}
function citeAll(st, on, t, offT){
  for(var i=0;i<CITE.length;i++){
    var c = CITE[i];
    var o = on*smooth((t - (offT==null?-999:0) )*1) ;
    var g = on;
    if(offT != null && c.flOff){
      var t0 = offT + c.flick*5.0;
      var fl = t < t0 ? 1 : (t < t0 + 0.9 ? (Math.sin((t - t0)*38.0) > 0 ? 0.25 : 1.0) : 0.06);
      g *= fl;
    }
    setFork(c, withOn(st, g));
  }
}
function midV(a,b){ return new THREE.Vector3((a.x+b.x)/2, (a.y+b.y)/2, (a.z+b.z)/2); }
function up(v, dy){ return new THREE.Vector3(v.x, v.y + dy, v.z); }
function camV(p, l, fov, near){ cam(p.x,p.y,p.z, l.x,l.y,l.z, fov, near); }
function camVL(p0,l0,p1,l1,k,fov,near){
  k = clamp(k,0,1);
  cam(lerp(p0.x,p1.x,k),lerp(p0.y,p1.y,k),lerp(p0.z,p1.z,k), lerp(l0.x,l1.x,k),lerp(l0.y,l1.y,k),lerp(l0.z,l1.z,k), fov, near);
}
var V3 = function(x,y,z){ return new THREE.Vector3(x,y,z); };
/* camera trên đồng cỏ: độ cao TƯƠNG ĐỐI với mặt đất tại chỗ (đồng cỏ lượn ±2 m) */
function camF(px,py,pz, lx,ly,lz, fov, near){ cam(px, py + HF(px,pz), pz, lx, ly + HF(lx,lz), lz, fov, near); }
function camLerpF(A,B,p){ p = clamp(p,0,1);
  camF(lerp(A[0],B[0],p),lerp(A[1],B[1],p),lerp(A[2],B[2],p), lerp(A[3],B[3],p),lerp(A[4],B[4],p),lerp(A[5],B[5],p), lerp(A[6]||42,B[6]||42,p), A[7]||0.05); }
var C_O = FO.center(), C_22 = F22.center(), C_23 = F23.center();

/* =========================================================================
 * DANH SÁCH CẢNH — S(id, a, b, fn(u,T,dur), fadeIn, fadeOut)
 * u = GIÂY kể từ đầu cảnh. Mốc = cue.start thật trong timing.json.
 * ========================================================================= */
var SC = [];
function S(id, a, b, fn, fi, fo){ SC.push({id:id, a:a, b:b, fn:fn, fi:fi||0, fo:fo||0}); }

/* ---------- 第1章 — 入口 ---------- */
S('S01', 0, 13.62, function(u,T){          /* C01–C02: sân ga 9 giờ sáng, vắng */
  setP(0, T);
  camLerp([3.9,1.62,26, -1.2,1.25,-8, 44], [3.6,1.60,20.5, -1.8,1.2,-6, 44], u/13.6);
}, 1.2, 0.3);
S('S02', 13.62, 19.01, function(u,T){      /* C02: ghế băng, poster ở tường đối diện */
