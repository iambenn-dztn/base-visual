  stage.lens.uniforms.uVig.value = 0.36 - 0.12*ramp(T, 32, 36);
  cam(1.0,1.2,0.05, -7.1,1.24,0.0, lerp(13.5, 12.2, u/7.5));
}, 0, 0.35);
S('S05', 39.18, 50.64, function(u,T){      /* C05: thung lũng — nơi hẹn đi cùng mẹ */
  setG(0, T);
  var z0 = lerp(60, 25, u/11.5);
  cam(xr(z0) + 34, 42 - u*0.6, z0, xr(z0 - 140), 8, z0 - 140, 46);
}, 0.4, 0.3);
S('S06', 50.64, 63.61, function(u,T){      /* C06: lối ven sông vắng, lá rơi — năm này qua năm khác */
  setG(0, T);
  var z = lerp(34, 24, u/13), x = xr(z) + 11 + Math.sin(z*0.05)*1.2, y = HG(x, z) + 1.65;
  var zl = z - 26, xl = xr(zl) + 10.5;
  cam(x, y, z, xl, HG(xl,zl) + 1.9, zl, 50);
  LEAVES.visible = true; setLeaves(T, x, y, z - 7);
}, 0.3, 0.3);
S('S07', 63.61, 88.98, function(u,T){      /* C07–C08: hành lang — việc ĐÃ LÀM tắt dần khi đi qua */
  var cz = lerp(2, -38, ease(u/25.4)*0.35 + (u/25.4)*0.65);
  setD(cz, T, 0, 0);
  cam(0.12, 1.62, cz, 0.0, 1.5, cz - 12, 52);
}, 0.35, 0);
S('S08', 88.98, 97.24, function(u,T){      /* C09: cửa cuối — CHƯA LÀM vẫn sáng */
  var cz = lerp(-40, -47, u/8.3);
  setD(cz, T, ramp(T, 89, 92), ramp(T, 92.3, 95.2));
  cam(0, 1.58, cz, 0, 1.45, -63, 46);
}, 0, 0.35);
S('S09', 97.24, 105.29, function(u,T){     /* C09: tàu vào ga, che mất poster */
