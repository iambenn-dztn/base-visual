{
  "total": 847.3,
  "count": 311,
  "cues": [
    {
      "t": 0,
      "s": "平日の朝、九時を少し過ぎたころでした。"
    },
    {
      "t": 3.83,
      "s": "私は市役所の待合の椅子で、"
    },
    {
      "t": 6.46,
      "s": "自分の番号が呼ばれるのを待っていました。"
    },
    {
      "t": 10.49,
      "s": "窓口の人が、ある人を、"
    },
    {
      "t": 12.6,
      "s": "番号ではなく名前で呼びました。"
    },
    {
      "t": 15.47,
      "s": "どこにでもある苗字です。"
    },
    {
      "t": 17.78,
      "s": "立ち上がったのは、"
    },
    {
      "t": 19.5,
      "s": "まったく知らない若い男の人でした。"
    },
    {
      "t": 22.76,
      "s": "それなのに、私の体は、"
    },
    {
      "t": 25.23,
      "s": "その一瞬で固くなりました。"
    },
    {
      "t": 28.14,
      "s": "肩が上がって、息が浅くなる。"
    },
    {
      "t": 31.28,
      "s": "手の中の番号札を、強く握っていました。"
    },
    {
      "t": 35.54,
      "s": "その苗字は、"
    },
    {
      "t": 36.64,
      "s": "三十年前のある人と同じだったんです。"
    },
    {
      "t": 39.96,
      "s": "何があったのかは、ここでは申しません。"
    },
    {
      "t": 43.45,
      "s": "聞いただけで体が固くなる名前。"
    },
    {
      "t": 46.22,
      "s": "そういう名前を一つ持っている方は、"
    },
    {
      "t": 49.35,
      "s": "少なくないと思います。"
    },
    {
      "t": 51.37,
      "s": "ずいぶん前に、"
    },
    {
      "t": 52.84,
      "s": "身近な人から、"
    },
    {
      "t": 54.32,
      "s": "こう言われたことがあります。"
    },
    {
      "t": 57.27,
      "s": "もう許してあげなさい。"
    },
    {
      "t": 59.59,
      "s": "忘れたほうが、あなたが楽になるから。"
    },
    {
      "t": 63.38,
      "s": "やさしさから出た言葉でした。"
    },
    {
      "t": 66.29,
      "s": "私もそのとおりだと思って、"
    },
    {
      "t": 69,
      "s": "努力してきたつもりです。"
    },
    {
      "t": 71.49,
      "s": "思い出さないように。"
    },
    {
      "t": 73.57,
      "s": "話に出さないように。"
    },
    {
      "t": 75.65,
      "s": "それでも、"
    },
    {
      "t": 76.68,
      "s": "三十年たって、"
    },
    {
      "t": 78.11,
      "s": "知らない人の苗字ひとつで、"
    },
    {
      "t": 80.78,
      "s": "体はこうなるんです。"
    },
    {
      "t": 82.83,
      "s": "胸の奥に、重たい石をまだ抱えている。"
    },
    {
      "t": 86.52,
      "s": "そんな感じでした。"
    },
    {
      "t": 88.37,
      "s": "私はまだ、許せていないんだろうか。それとも、"
    },
    {
      "t": 92.38,
      "s": "許すというのは、"
    },
    {
      "t": 93.83,
      "s": "もともとこういうことではなかったんだろうか。"
    },
    {
      "t": 99.32,
      "s": "番号を待つあいだ、"
    },
    {
      "t": 100.97,
      "s": "私はあることを思い出していました。"
    },
    {
      "t": 104.1,
      "s": "許すということを、"
    },
    {
      "t": 105.75,
      "s": "何十年もまっすぐ調べて"
    },
    {
      "t": 107.78,
      "s": "きた人たちがいるんです。今日は、"
    },
    {
      "t": 110.72,
      "s": "その人たちが分けた三つの言葉の話をします。"
    },
    {
      "t": 114.58,
      "s": "アメリカのウィスコンシン大学に、"
    },
    {
      "t": 117.35,
      "s": "ロバート・エンライトという心理学者がいます。"
    },
    {
      "t": 121.16,
      "s": "許しというものを、"
    },
    {
      "t": 122.72,
      "s": "科学として調べはじめた最初のひと"
    },
    {
      "t": 125.5,
      "s": "りと言われる人です。"
    },
    {
      "t": 127.23,
      "s": "エンライトは千九百九十三年、"
    },
    {
      "t": 130.26,
      "s": "ヘブルという研究者と一緒に、"
    },
    {
      "t": 133.28,
      "s": "ある論文を出しています。"
    },
    {
      "t": 135.88,
      "s": "許しを手助けする試みを、"
    },
    {
      "t": 138.47,
      "s": "はじめて確かめた研究です。"
    },
    {
      "t": 141.28,
      "s": "相手は、年を重ねた女性たちでした。家族から、"
    },
    {
      "t": 146.09,
      "s": "理不尽な扱いを受けたことのある人たちです。"
    },
    {
      "t": 150.69,
      "s": "じつは、"
    },
    {
      "t": 151.53,
      "s": "エンライトの考え方で、"
    },
    {
      "t": 153.84,
      "s": "私がまず驚いたことがあります。"
    },
    {
      "t": 156.98,
      "s": "許しとは何かを言う前に、"
    },
    {
      "t": 159.5,
      "s": "許しではないものを、"
    },
    {
      "t": 161.59,
      "s": "とても丁寧に並べていたんです。"
    },
    {
      "t": 164.74,
      "s": "定義は、こうです。"
    },
    {
      "t": 166.67,
      "s": "不当に傷つけられた相手に対して、恨みや、"
    },
    {
      "t": 170.97,
      "s": "冷たい態度をとる権利。"
    },
    {
      "t": 173.33,
      "s": "それを、自分から手放そうとすること。"
    },
    {
      "t": 177.2,
      "s": "大事なのは、権利という言葉なんです。"
    },
    {
      "t": 180.82,
      "s": "恨むのは、"
    },
    {
      "t": 181.83,
      "s": "傷つけられた側の、"
    },
    {
      "t": 183.64,
      "s": "もっともな権利だ。"
    },
    {
      "t": 185.45,
      "s": "定義の中で、先にそう認めているわけです。"
    },
    {
      "t": 189.47,
      "s": "そのうえでエンライトは、"
    },
    {
      "t": 191.68,
      "s": "許しと取り違えられやすいものを、"
    },
    {
      "t": 194.62,
      "s": "一つずつ外していきます。"
    },
    {
      "t": 196.82,
      "s": "まず、相手のしたことを大目に見ること。"
    },
    {
      "t": 200.31,
      "s": "仕方なかったと、言い訳をしてあげること。"
    },
    {
      "t": 203.99,
      "s": "これは許しではありません。"
    },
    {
      "t": 206.38,
      "s": "大目に見るというのは、"
    },
    {
      "t": 208.34,
      "s": "そもそも不当なことはなかった、"
    },
    {
      "t": 211.01,
      "s": "と考えることだからです。"
    },
    {
      "t": 213.14,
      "s": "許しは反対に、"
    },
    {
      "t": 214.39,
      "s": "不当なことがあったと、"
    },
    {
      "t": 216.35,
      "s": "はっきり認めたところから始まるんです。"
    },
    {
      "t": 219.74,
      "s": "そして、二つ目の言葉です。忘れること。"
    },
    {
      "t": 223.46,
      "s": "ここが、"
    },
    {
      "t": 224.25,
      "s": "あの待合室で、"
    },
    {
      "t": 225.62,
      "s": "私がいちばん知りたかったところでした。"
    },
    {
      "t": 229.34,
      "s": "エンライトは、はっきりこう書いています。"
    },
    {
      "t": 233.31,
      "s": "許しは、忘れることではない。許した人が、"
    },
    {
      "t": 237.28,
      "s": "その出来事を忘れることは、まずない。"
    },
    {
      "t": 240.84,
      "s": "では、何が変わるのか。"
    },
    {
      "t": 242.89,
      "s": "同じ出来事を、"
    },
    {
      "t": 244.2,
      "s": "新しいやり方で思い出すようになる、"
    },
    {
      "t": 247.37,
      "s": "というんです。"
    },
    {
      "t": 248.67,
      "s": "記憶は、そのまま残ります。変わるのは、"
    },
    {
      "t": 252.21,
      "s": "思い出したときに、"
    },
    {
      "t": 253.89,
      "s": "そこにくっついてくる怒りのほうなんです。"
    },
    {
      "t": 257.63,
      "s": "それどころか、"
    },
    {
      "t": 259.02,
      "s": "エンライトは、"
    },
    {
      "t": 260.4,
      "s": "無理に忘れようとすることを、"
    },
    {
      "t": 263.18,
      "s": "許しとは別のものとして扱っています。"
    },
    {
      "t": 266.75,
      "s": "押し込めること。"
    },
    {
      "t": 268.33,
      "s": "なかったことにすること。"
    },
    {
      "t": 270.71,
      "s": "見ないようにすること。"
    },
    {
      "t": 272.89,
      "s": "どれも、許しに似ていて、許しではないもの。"
    },
    {
      "t": 277.04,
      "s": "そういう並びの中に、"
    },
    {
      "t": 279.01,
      "s": "忘れることが置かれているんです。"
    },
    {
      "t": 282.17,
      "s": "正直に言うと、私はここで、"
    },
    {
      "t": 284.67,
      "s": "なんというか、"
    },
    {
      "t": 286.02,
      "s": "少し笑ってしまいました。三十年、"
    },
    {
      "t": 289.11,
      "s": "一生懸命やってきたのは、"
    },
    {
      "t": 291.42,
      "s": "まさにその押し込めるほうだったからです。"
    },
    {
      "t": 295.26,
      "s": "あの、"
    },
    {
      "t": 295.86,
      "s": "許して忘れなさい、"
    },
    {
      "t": 297.67,
      "s": "という言葉は、"
    },
    {
      "t": 299.08,
      "s": "やさしさから出たものです。ですが、"
    },
    {
      "t": 302.5,
      "s": "その中には、"
    },
    {
      "t": 303.71,
      "s": "違う二つのことが、"
    },
    {
      "t": 305.52,
      "s": "一つにまとめて入っていたということなんです。"
    },
    {
      "t": 309.95,
      "s": "忘れられないから、まだ許せていない。"
    },
    {
      "t": 313.18,
      "s": "そう思いこんでいたのは、"
    },
    {
      "t": 315.33,
      "s": "私の落ち度ではありませんでした。"
    },
    {
      "t": 318.2,
      "s": "二つの言葉が、"
    },
    {
      "t": 319.46,
      "s": "はじめから絡まっていただけだったんです。"
    },
    {
      "t": 323.05,
      "s": "三つ目の言葉は、仲直りです。"
    },
    {
      "t": 325.94,
      "s": "研究の言葉では、和解と呼ばれます。私には、"
    },
    {
      "t": 330.27,
      "s": "この取り違えが、"
    },
    {
      "t": 331.92,
      "s": "じつはいちばん重たいものに思えます。"
    },
    {
      "t": 335.64,
      "s": "許すというと、"
    },
    {
      "t": 337.01,
      "s": "相手に会って、"
    },
    {
      "t": 338.39,
      "s": "許しますと伝えて、"
    },
    {
      "t": 340.15,
      "s": "もとの関係に戻る。"
    },
    {
      "t": 341.92,
      "s": "そういう場面を思い浮かべる方が、"
    },
    {
      "t": 345.06,
      "s": "多いと思います。"
    },
    {
      "t": 346.63,
      "s": "そう考えると、"
    },
    {
      "t": 348,
      "s": "許すこと自体が、"
    },
    {
      "t": 349.57,
      "s": "怖くなってしまいます。"
    },
    {
      "t": 351.72,
      "s": "エンライトは、ここもはっきり分けています。"
    },
    {
      "t": 355.58,
      "s": "和解というのは、二人の人が、"
    },
    {
      "t": 358.15,
      "s": "もう一度おたがいを信頼しあうことです。"
    },
    {
      "t": 361.64,
      "s": "ですから、両方がそろわないとできません。"
    },
    {
      "t": 365.32,
      "s": "許しは、ちがいます。"
    },
    {
      "t": 367.59,
      "s": "傷つけられた側の、"
    },
    {
      "t": 369.64,
      "s": "一人の中で起きることなんです。"
    },
    {
      "t": 373.04,
      "s": "相手が謝らなくても、"
    },
    {
      "t": 375.31,
      "s": "伝えなくても、起こりうる。"
    },
    {
      "t": 378.27,
      "s": "相手がもうこの世にいなくても、"
    },
    {
      "t": 381.67,
      "s": "起こりうるものなんです。"
    },
    {
      "t": 384.4,
      "s": "ですから、許しても、会わなくていいんです。"
    },
    {
      "t": 388.22,
      "s": "距離をとったままでいい。許すことは、"
    },
    {
      "t": 391.5,
      "s": "ひどい扱いをもう一度受け入れることではない。"
    },
    {
      "t": 395.5,
      "s": "エンライトの本には、"
    },
    {
      "t": 397.33,
      "s": "そのこともはっきり書かれています。"
    },
    {
      "t": 401.58,
      "s": "ここで、"
    },
    {
      "t": 402.33,
      "s": "もう一人の研究者に登場してもらいます。"
    },
    {
      "t": 405.91,
      "s": "バージニア・コモンウェルス大学の、"
    },
    {
      "t": 409.11,
      "s": "エベレット・ワージントンです。この人は、"
    },
    {
      "t": 412.88,
      "s": "許しをさらに二つに分けて考えました。"
    },
    {
      "t": 416.27,
      "s": "一つは、決めるほうの許しです。"
    },
    {
      "t": 419.43,
      "s": "仕返しをしない。"
    },
    {
      "t": 421.12,
      "s": "恨みで動かない。"
    },
    {
      "t": 422.8,
      "s": "そう決めることです。"
    },
    {
      "t": 424.91,
      "s": "もう一つは、気持ちのほうの許し。"
    },
    {
      "t": 428,
      "s": "怒りや恨みが、少しずつ、"
    },
    {
      "t": 430.31,
      "s": "思いやりのような別の感情に"
    },
    {
      "t": 432.82,
      "s": "入れかわっていくことです。"
    },
    {
      "t": 435.33,
      "s": "大事なのは、この二つが、"
    },
    {
      "t": 437.51,
      "s": "同じ速さで進むとはかぎらない、"
    },
    {
      "t": 440.23,
      "s": "ということなんです。"
    },
    {
      "t": 442.04,
      "s": "決めることは、ある日できます。ですが、"
    },
    {
      "t": 445.49,
      "s": "気持ちのほうは、"
    },
    {
      "t": 446.94,
      "s": "ずっと遅れてついてくることがある。"
    },
    {
      "t": 450.02,
      "s": "あの待合室で固くなった私の体は、たぶん、"
    },
    {
      "t": 454.2,
      "s": "この遅れてくるほうでした。"
    },
    {
      "t": 456.92,
      "s": "体が覚えていることは、"
    },
    {
      "t": 459.22,
      "s": "決心ひとつでは、"
    },
    {
      "t": 460.89,
      "s": "すぐには動かない。"
    },
    {
      "t": 462.77,
      "s": "私はそう受けとりました。"
    },
    {
      "t": 465.28,
      "s": "ワージントンは、許しの手順も作っています。"
    },
    {
      "t": 469.53,
      "s": "五つの段階の頭文字をとって、"
    },
    {
      "t": 472.36,
      "s": "リーチと呼ばれるものです。"
    },
    {
      "t": 474.99,
      "s": "その最初の一歩が、私には意外でした。"
    },
    {
      "t": 478.64,
      "s": "最初の一歩は、思い出すことなんです。"
    },
    {
      "t": 481.88,
      "s": "傷ついた出来事を、"
    },
    {
      "t": 483.5,
      "s": "できるだけ落ちついて、"
    },
    {
      "t": 485.47,
      "s": "ありのままに思い出す。"
    },
    {
      "t": 487.45,
      "s": "忘れることからではなく、"
    },
    {
      "t": 489.61,
      "s": "思い出すことから始まるんです。"
    },
    {
      "t": 492.31,
      "s": "エンライトの道のりも、同じ形をしています。"
    },
    {
      "t": 496.48,
      "s": "二十の段階を四つの時期に分けたもので、"
    },
    {
      "t": 500.25,
      "s": "その最初の時期は、"
    },
    {
      "t": 502.04,
      "s": "自分の傷と怒りに気づくことです。"
    },
    {
      "t": 505.22,
      "s": "二人の手順が、どちらも、"
    },
    {
      "t": 507.61,
      "s": "忘れる方向とは反対のところから始まっている。"
    },
    {
      "t": 511.98,
      "s": "私はここで、しばらく本を閉じていました。"
    },
    {
      "t": 515.96,
      "s": "リーチでは、そのあとに、"
    },
    {
      "t": 518.64,
      "s": "相手の事情を想像してみる段階。"
    },
    {
      "t": 521.99,
      "s": "許しを贈りものとして差し出す段階。"
    },
    {
      "t": 525.79,
      "s": "それを心に決める段階。"
    },
    {
      "t": 528.24,
      "s": "揺らいだときにも持ちこたえる段階が、"
    },
    {
      "t": 532.26,
      "s": "続きます。"
    },
    {
      "t": 533.38,
      "s": "正直に言うと、"
    },
    {
      "t": 534.82,
      "s": "贈りものという言い方は、"
    },
    {
      "t": 537.28,
      "s": "私にはまだ腑に落ちません。"
    },
    {
      "t": 539.95,
      "s": "傷つけられたほうが、"
    },
    {
      "t": 542,
      "s": "なぜ差し出す側に回るのか。"
    },
    {
      "t": 544.67,
      "s": "ここは、今の私にはわからないままです。"
    },
    {
      "t": 549.73,
      "s": "ワージントンには、もう一つ、"
    },
    {
      "t": 552.29,
      "s": "この回でどうしても"
    },
    {
      "t": 553.94,
      "s": "お伝えしたい論文があります。二千四年に、"
    },
    {
      "t": 557.6,
      "s": "シェーラーという研究者と"
    },
    {
      "t": 559.8,
      "s": "一緒に書いたものです。"
    },
    {
      "t": 561.81,
      "s": "その論文は、"
    },
    {
      "t": 563.15,
      "s": "許せないという状態を、"
    },
    {
      "t": 565.59,
      "s": "ストレスの反応として見ています。"
    },
    {
      "t": 569.15,
      "s": "恨み、苦さ、怒り、恐れ。"
    },
    {
      "t": 571.83,
      "s": "何度も思い返すうちに、それが重なっていく。"
    },
    {
      "t": 576.5,
      "s": "つまり、"
    },
    {
      "t": 577.31,
      "s": "心が狭いから起きるものではなく、"
    },
    {
      "t": 580.53,
      "s": "傷を受けたあとに起きる、"
    },
    {
      "t": 582.95,
      "s": "心と体の反応だということです。"
    },
    {
      "t": 585.97,
      "s": "そしてこの論文は、"
    },
    {
      "t": 587.87,
      "s": "その重さを軽くする道は、"
    },
    {
      "t": 590.4,
      "s": "許しだけではない、"
    },
    {
      "t": 592.31,
      "s": "と整理しているんです。"
    },
    {
      "t": 594.63,
      "s": "許しは、いくつもある道の一つだ、と。"
    },
    {
      "t": 598.43,
      "s": "ほかの道として挙げられているのは、たとえば、"
    },
    {
      "t": 602.84,
      "s": "謝罪や償いを求めること。"
    },
    {
      "t": 605.24,
      "s": "法や社会の場で、筋を通してもらうこと。"
    },
    {
      "t": 609.04,
      "s": "起きたことを受け入れて、"
    },
    {
      "t": 611.45,
      "s": "自分の暮らしを先へ進めること。"
    },
    {
      "t": 614.45,
      "s": "許さないまま、"
    },
    {
      "t": 615.88,
      "s": "別の道で少しずつ軽くなっていく人もいる。"
    },
    {
      "t": 619.98,
      "s": "少なくともこの論文の整理では、"
    },
    {
      "t": 623.05,
      "s": "それは失敗ではなく、"
    },
    {
      "t": 625.09,
      "s": "別の道のひとつなんです。"
    },
    {
      "t": 629.02,
      "s": "ここで、あの胸の奥の石の話に戻ります。"
    },
    {
      "t": 633.22,
      "s": "新しいやり方で思い出す、"
    },
    {
      "t": 635.87,
      "s": "というエンライトの言葉を、私なりに、"
    },
    {
      "t": 639.85,
      "s": "こんなふうに受けとりました。"
    },
    {
      "t": 642.94,
      "s": "石は、なくならないんです。"
    },
    {
      "t": 645.46,
      "s": "三十年前のことは、"
    },
    {
      "t": 647.21,
      "s": "三十年前にたしかに起きました。"
    },
    {
      "t": 650.12,
      "s": "それを消すことは、誰にもできません。"
    },
    {
      "t": 653.62,
      "s": "変わるのは、持ち方のほうです。"
    },
    {
      "t": 656.44,
      "s": "胸に抱えこんで、引きずるように歩く。"
    },
    {
      "t": 659.81,
      "s": "その持ち方から、"
    },
    {
      "t": 661.32,
      "s": "そっと足もとに下ろして、"
    },
    {
      "t": 663.57,
      "s": "横に置いておく持ち方へ。"
    },
    {
      "t": 665.83,
      "s": "石は、まだ見えるところにあります。"
    },
    {
      "t": 669.55,
      "s": "ときどき目に入ります。"
    },
    {
      "t": 671.97,
      "s": "ですが、もう肩にはのっていない。"
    },
    {
      "t": 675.47,
      "s": "歩くのを止めてもいない。"
    },
    {
      "t": 678.1,
      "s": "許しも、ほかの道も、"
    },
    {
      "t": 680.46,
      "s": "変えているのはこの持ち方なのだと、"
    },
    {
      "t": 684.48,
      "s": "私は思っています。"
    },
    {
      "t": 686.61,
      "s": "石そのものではなく。"
    },
    {
      "t": 688.97,
      "s": "あの朝の待合室に、戻ってきます。"
    },
    {
      "t": 692.47,
      "s": "電子音が鳴って、"
    },
    {
      "t": 694.21,
      "s": "また誰かの名前が呼ばれました。"
    },
    {
      "t": 697.48,
      "s": "正直に言えば、体は、また少し固くなりました。"
    },
    {
      "t": 701.87,
      "s": "三つの言葉を知っても、"
    },
    {
      "t": 704.06,
      "s": "それは消えませんでした。"
    },
    {
      "t": 706.46,
      "s": "消えます、とは言えません。"
    },
    {
      "t": 709.05,
      "s": "ですが、そのあとが違いました。"
    },
    {
      "t": 712.52,
      "s": "まだ忘れていない。"
    },
    {
      "t": 714.61,
      "s": "だから、まだ許せていない。"
    },
    {
      "t": 717.62,
      "s": "あの声が、今度は出てこなかったんです。"
    },
    {
      "t": 722.01,
      "s": "忘れることと、許すことは、べつの言葉です。"
    },
    {
      "t": 726.45,
      "s": "許すことと、"
    },
    {
      "t": 727.72,
      "s": "会って仲直りすることも、"
    },
    {
      "t": 730.26,
      "s": "べつの言葉です。"
    },
    {
      "t": 731.95,
      "s": "そして許すことは、"
    },
    {
      "t": 733.86,
      "s": "重さを下ろす道の、一つです。"
    },
    {
      "t": 737.99,
      "s": "ここで、"
    },
    {
      "t": 738.91,
      "s": "はっきり申し上げておきたいことがあります。"
    },
    {
      "t": 743.75,
      "s": "この回は、許しなさい、"
    },
    {
      "t": 746.29,
      "s": "という話ではありません。"
    },
    {
      "t": 749.05,
      "s": "許さなくていい、と勧める話でもありません。"
    },
    {
      "t": 753.89,
      "s": "エンライトの本の一冊は、"
    },
    {
      "t": 756.16,
      "s": "英語の題名を訳すと、"
    },
    {
      "t": 758.05,
      "s": "許しは選択である、"
    },
    {
      "t": 759.75,
      "s": "というものです。"
    },
    {
      "t": 761.26,
      "s": "選べるということは、"
    },
    {
      "t": 763.15,
      "s": "今は選ばない、"
    },
    {
      "t": 764.47,
      "s": "という選び方もあるということです。"
    },
    {
      "t": 767.68,
      "s": "それから、ここまでの話には限りがあります。"
    },
    {
      "t": 771.94,
      "s": "二人の手順は、"
    },
    {
      "t": 773.36,
      "s": "心理学の中で試されてきた、"
    },
    {
      "t": 776,
      "s": "一つの枠組みです。誰にでも、"
    },
    {
      "t": 778.84,
      "s": "どんな傷にも効く、"
    },
    {
      "t": 780.67,
      "s": "決まった道順ではありません。"
    },
    {
      "t": 783.51,
      "s": "深い傷ほど、長い時間がかかります。"
    },
    {
      "t": 787.06,
      "s": "何十年もかかる人もいますし、"
    },
    {
      "t": 789.98,
      "s": "許さないまま暮らしていく人もいます。"
    },
    {
      "t": 793.74,
      "s": "それが間違いだと言える根拠を、"
    },
    {
      "t": 796.87,
      "s": "私は見つけられませんでした。"
    },
    {
      "t": 799.79,
      "s": "そして、この話は治療ではありません。"
    },
    {
      "t": 803.02,
      "s": "その重さが、"
    },
    {
      "t": 804.09,
      "s": "眠りや毎日の暮らしにまで届いているなら、"
    },
    {
      "t": 807.68,
      "s": "カウンセラーや、"
    },
    {
      "t": 809.12,
      "s": "心の専門のお医者さんに話してみてください。"
    },
    {
      "t": 812.88,
      "s": "それは、誰かと一緒に持っていい重さなんです。"
    },
    {
      "t": 818.31,
      "s": "番号が呼ばれて、私は立ち上がりました。"
    },
    {
      "t": 822.07,
      "s": "石は、まだそこにあります。ですが、あの朝は、"
    },
    {
      "t": 826.42,
      "s": "それを少しだけ足もとに置いて、"
    },
    {
      "t": 829.38,
      "s": "窓口まで歩いていくことができました。"
    },
    {
      "t": 832.93,
      "s": "忘れられないのは、"
    },
    {
      "t": 834.57,
      "s": "許せていないしるしではありませんでした。"
    },
    {
      "t": 838.21,
      "s": "許した人も、ほとんどの場合、覚えている。"
    },
    {
      "t": 841.84,
      "s": "研究が分けた三つの言葉は、"
    },
    {
      "t": 844.21,
      "s": "そのことを教えてくれていたんです。"
    }
  ]
}