{
  "slug": "omoide-yasashii",
  "fps": 30,
  "totalDuration": 847.7,
  "dryRun": true,
  "narration": null,
  "lang": "ja",
  "voice": {
    "provider": "gpt-sovits-local",
    "voice_name": "keita",
    "lang": "ja",
    "speed": 0.95,
    "seed": 42
  },
  "cues": [
    {
      "id": "C01",
      "chapter": "第1章 — 入口",
      "text": "よく晴れた午後でした。戸を開け放してあって、風が通っていました。",
      "file": null,
      "start": 0,
      "duration": 6.53
    },
    {
      "id": "C02",
      "chapter": null,
      "text": "その日、私はずっと後回しにしていたことをしていました。遺品の整理です。何か月も、手がつけられずにいたんです。",
      "file": null,
      "start": 6.53,
      "duration": 11.02
    },
    {
      "id": "C03",
      "chapter": null,
      "text": "押し入れの奥から、古い写真の箱が出てきました。蓋に埃がたまっています。それを払って、開けました。",
      "file": null,
      "start": 17.55,
      "duration": 9.8
    },
    {
      "id": "C04",
      "chapter": null,
      "text": "日が斜めに入ってきていて、光の筋がはっきり見えました。その中を、細かい埃がゆっくり流れていくんです。",
      "file": null,
      "start": 27.35,
      "duration": 10.2
    },
    {
      "id": "C05",
      "chapter": null,
      "text": "写真を畳の上に広げていると、隣に座っていた孫が、こう聞きました。",
      "file": null,
      "start": 37.55,
      "duration": 6.53
    },
    {
      "id": "C06",
      "chapter": null,
      "text": "おじいちゃんって、どんな人だったの。",
      "file": null,
      "start": 44.08,
      "duration": 3.67
    },
    {
      "id": "C07",
      "chapter": null,
      "text": "私は、答えはじめました。あの人はね、と。",
      "file": null,
      "start": 48.95,
      "duration": 4.08
    },
    {
      "id": "C08",
      "chapter": null,
      "text": "ところが、話しているうちに、自分の声が妙に聞こえてきたんです。",
      "file": null,
      "start": 53.03,
      "duration": 6.33
    },
    {
      "id": "C09",
      "chapter": null,
      "text": "私は、いい話ばかりしていました。声も軽い。それどころか、笑っていたんです。",
      "file": null,
      "start": 59.36,
      "duration": 7.55
    },
    {
      "id": "C10",
      "chapter": null,
      "text": "そこで、口が止まりました。",
      "file": null,
      "start": 66.91,
      "duration": 2.65
    },
    {
      "id": "C11",
      "chapter": null,
      "text": "なぜなら、私はちゃんと覚えているからです。あの頃が、いつも穏やかだったわけではないことを。",
      "file": null,
      "start": 71.06,
      "duration": 9.18
    },
    {
      "id": "C12",
      "chapter": null,
      "text": "やりくりに苦しかった年もありました。もうだめかもしれない、とそのときは思った言い争いもありました。",
      "file": null,
      "start": 80.24,
      "duration": 10
    },
    {
      "id": "C13",
      "chapter": null,
      "text": "忘れてはいないんです。ただ、それが先に出てこなかった。出てきたのは、いい話の方でした。",
      "file": null,
      "start": 90.24,
      "duration": 8.78
    },
    {
      "id": "C14",
      "chapter": null,
      "text": "私は、都合のいいところだけを話しているのだろうか。",
      "file": null,
      "start": 99.02,
      "duration": 5.1
    },
    {
      "id": "C15",
      "chapter": null,
      "text": "薄情になったから、あの頃が優しく見えるのだろうか。",
      "file": null,
      "start": 104.12,
      "duration": 5.1
    },
    {
      "id": "C16",
      "chapter": null,
      "text": "正直に言うと、その午後、私は孫に嘘を渡してしまった気がしていました。",
      "file": null,
      "start": 109.22,
      "duration": 6.94
    },
    {
      "id": "C17",
      "chapter": "第2章 — 測った人たち",
      "text": "それで、私は調べてみることにしました。そうしたら、思いがけないことがわかったんです。",
      "file": null,
      "start": 116.16,
      "duration": 8.57
    },
    {
      "id": "C18",
      "chapter": null,
      "text": "この、昔が優しく見えるという感じ。これを、実際に測ってみた人たちがいました。",
      "file": null,
      "start": 124.73,
      "duration": 7.76
    },
    {
      "id": "C19",
      "chapter": null,
      "text": "やり方は、とても素朴なものです。日記を使うんです。",
      "file": null,
      "start": 132.49,
      "duration": 5.1
    },
    {
      "id": "C20",
      "chapter": null,
      "text": "参加した人は毎日、その日にあった出来事を書きとめます。うれしかったこと、いやだったこと、どちらもです。",
      "file": null,
      "start": 137.59,
      "duration": 10.41
    },
    {
      "id": "C21",
      "chapter": null,
      "text": "そして大事なのがここなんです。書いたその場で、その出来事の感情の強さに点をつけておく。",
      "file": null,
      "start": 148,
      "duration": 8.78
    },
    {
      "id": "C22",
      "chapter": null,
      "text": "つまり、あとから思い出してつけた点ではありません。出来事が起きた、その日のうちの点なんです。",
      "file": null,
      "start": 156.78,
      "duration": 9.39
    },
    {
      "id": "C23",
      "chapter": null,
      "text": "それから何か月かたって、もう一度、同じ出来事を読み返してもらいます。そして今どう感じるか、また点をつける。",
      "file": null,
      "start": 166.17,
      "duration": 10.82
    },
    {
      "id": "C24",
      "chapter": null,
      "text": "これで、当時の点と今の点を並べて比べられるわけです。感想ではなく、数字として。",
      "file": null,
      "start": 176.99,
      "duration": 7.96
    },
    {
      "id": "C25",
      "chapter": null,
      "text": "この方法で集まった記録が、どれくらいあったか。八つの日記研究。参加した人が、二百二十九人。",
      "file": null,
      "start": 184.95,
      "duration": 9.18
    },
    {
      "id": "C26",
      "chapter": null,
      "text": "書きとめられた出来事は、二万三千二百二件。追いかけた期間は、短いもので一年半、長いもので二年半ほどです。",
      "file": null,
      "start": 194.13,
      "duration": 10.61
    },
    {
      "id": "C27",
      "chapter": null,
      "text": "これをまとめたのが、ウォーカーとスコウロンスキーとトンプソンという三人で、二〇〇三年の論文です。",
      "file": null,
      "start": 204.74,
      "duration": 9.8
    },
    {
      "id": "C28",
      "chapter": null,
      "text": "題は、こうついていました。人生は心地よい。そして記憶が、それを保つのを手伝っている。",
      "file": null,
      "start": 214.54,
      "duration": 8.57
    },
    {
      "id": "C29",
      "chapter": null,
      "text": "では、二万件を超える記録は、何を示したのか。",
      "file": null,
      "start": 223.11,
      "duration": 4.49
    },
    {
      "id": "C30",
      "chapter": null,
      "text": "まず、どちらの感情も薄れていました。うれしかったことも、いやだったことも、当時ほどの強さではなくなる。",
      "file": null,
      "start": 227.6,
      "duration": 10.41
    },
    {
      "id": "C31",
      "chapter": null,
      "text": "ここまでは、たぶん誰でも思うところです。違いは、その先にありました。",
      "file": null,
      "start": 238.01,
      "duration": 6.94
    },
    {
      "id": "C32",
      "chapter": null,
      "text": "いやだったことの方が、先に薄れていたんです。",
      "file": null,
      "start": 244.95,
      "duration": 4.49
    },
    {
      "id": "C33",
      "chapter": null,
      "text": "両方薄れる。でも、速さが違う。つらい方が早く軽くなって、うれしい方がゆっくり残る。",
      "file": null,
      "start": 249.44,
      "duration": 8.37
    },
    {
      "id": "C34",
      "chapter": null,
      "text": "この差には、名前がついています。フェージング・アフェクト・バイアス。感情が薄れていく、その傾きのことです。",
      "file": null,
      "start": 257.81,
      "duration": 10.82
    },
    {
      "id": "C35",
      "chapter": null,
      "text": "名づけたのは、ウォーカーとフォーグルとトンプソンで、一九九七年のことでした。",
      "file": null,
      "start": 268.63,
      "duration": 7.76
    },
    {
      "id": "C36",
      "chapter": null,
      "text": "ただ、ここに一つ、私がいちばん誤解していたところがあります。",
      "file": null,
      "start": 276.39,
      "duration": 6.12
    },
    {
      "id": "C37",
      "chapter": null,
      "text": "薄れているのは、記憶そのものではありません。",
      "file": null,
      "start": 282.51,
      "duration": 4.49
    },
    {
      "id": "C38",
      "chapter": null,
      "text": "出来事は覚えています。いつのことか、どこでのことか、何を言われたか。細かいところまで残っている。",
      "file": null,
      "start": 287,
      "duration": 9.8
    },
    {
      "id": "C39",
      "chapter": null,
      "text": "薄れていくのは、その記憶にくっついていた感情の強さの方なんです。",
      "file": null,
      "start": 296.8,
      "duration": 6.53
    },
    {
      "id": "C40",
      "chapter": null,
      "text": "記憶と、記憶についた感情。この二つは、別々のものとして測れる。研究はそれを、別々に測っていました。",
      "file": null,
      "start": 303.33,
      "duration": 10
    },
    {
      "id": "C41",
      "chapter": null,
      "text": "あの言い争いを、私は忘れてなどいない。ただ、思い出したときの胸の締めつけが、当時ほどではない。それだけなんです。",
      "file": null,
      "start": 313.33,
      "duration": 11.43
    },
    {
      "id": "C42",
      "chapter": "第3章 — 深いところ",
      "text": "さて、ここからが、私にとっていちばん意外だったところです。",
      "file": null,
      "start": 324.76,
      "duration": 5.92
    },
    {
      "id": "C43",
      "chapter": null,
      "text": "この働きは、いつから始まるのか。",
      "file": null,
      "start": 330.68,
      "duration": 3.27
    },
    {
      "id": "C44",
      "chapter": null,
      "text": "私は、何年もかかるものだと思っていました。歳月が薬になる、と言いますから。",
      "file": null,
      "start": 333.95,
      "duration": 7.55
    },
    {
      "id": "C45",
      "chapter": null,
      "text": "ところが、半日ほどで、もう始まっていました。",
      "file": null,
      "start": 341.5,
      "duration": 4.49
    },
    {
      "id": "C46",
      "chapter": null,
      "text": "出来事が起きて、十二時間ほど。そのあたりで、もう差がつきはじめている。そして三か月たっても、ちゃんと測れる。",
      "file": null,
      "start": 345.99,
      "duration": 11.02
    },
    {
      "id": "C47",
      "chapter": null,
      "text": "これを調べたのが、ギボンズとリーとウォーカーで、二〇一一年の研究です。論文の題が、そのまま結論になっていました。",
      "file": null,
      "start": 357.01,
      "duration": 11.43
    },
    {
      "id": "C48",
      "chapter": null,
      "text": "フェージング・アフェクト・バイアスは十二時間以内に始まり、三か月続く。そういう題なんです。",
      "file": null,
      "start": 368.44,
      "duration": 9.18
    },
    {
      "id": "C49",
      "chapter": null,
      "text": "つまり、頑張って忘れようとしたから始まるのではありません。そんな指示を出した覚えがなくても、もう動いているんです。",
      "file": null,
      "start": 377.62,
      "duration": 11.63
    },
    {
      "id": "C50",
      "chapter": null,
      "text": "ここで、私はこう思いました。それは本当に薄れているのだろうか、と。",
      "file": null,
      "start": 389.25,
      "duration": 6.73
    },
    {
      "id": "C51",
      "chapter": null,
      "text": "人は、昔の自分の気持ちを大げさに覚えていることがあります。この差も、ただの思い違いではないのか。",
      "file": null,
      "start": 395.98,
      "duration": 9.8
    },
    {
      "id": "C52",
      "chapter": null,
      "text": "実は、この反論は研究者自身がしていました。答えられるように、方法が組んであったんです。",
      "file": null,
      "start": 405.78,
      "duration": 8.78
    },
    {
      "id": "C53",
      "chapter": null,
      "text": "最初の点は、出来事が起きたその日につけてあります。あとから記憶をたどった数字ではないので、思い違いでは説明がつかないんです。",
      "file": null,
      "start": 414.56,
      "duration": 12.65
    },
    {
      "id": "C54",
      "chapter": null,
      "text": "そして、もう一つ。私はこれを知って、少し驚きました。",
      "file": null,
      "start": 427.21,
      "duration": 5.31
    },
    {
      "id": "C55",
      "chapter": null,
      "text": "うれしい出来事といやな出来事は、起きた時点での感情の強さが、ほぼ同じだったんです。",
      "file": null,
      "start": 432.52,
      "duration": 8.37
    },
    {
      "id": "C56",
      "chapter": null,
      "text": "つまり、最初から楽しい方が強かったわけではない。同じ高さから始まって、下りていく速さだけが違っていた。",
      "file": null,
      "start": 440.89,
      "duration": 10.41
    },
    {
      "id": "C57",
      "chapter": null,
      "text": "この整理をしたのが、ウォーカーとスコウロンスキーの二〇〇九年の論文です。",
      "file": null,
      "start": 451.3,
      "duration": 7.35
    },
    {
      "id": "C58",
      "chapter": null,
      "text": "その論文には、変わった題がついていました。フェージング・アフェクト・バイアス。それは一体、何のためにあるのか。",
      "file": null,
      "start": 458.65,
      "duration": 11.22
    },
    {
      "id": "C59",
      "chapter": null,
      "text": "つまり、こういう問いです。これは記憶の故障なのか、それとも、そうなるようにできているのか。",
      "file": null,
      "start": 469.87,
      "duration": 9.18
    },
    {
      "id": "C60",
      "chapter": null,
      "text": "著者たちの答えは、後者でした。",
      "file": null,
      "start": 479.05,
      "duration": 3.06
    },
    {
      "id": "C61",
      "chapter": null,
      "text": "これは、記憶が壊れているのではない。人が立ち直っていくための、健康な働きが記憶の中で動いている。その現れだ、と。",
      "file": null,
      "start": 482.11,
      "duration": 11.43
    },
    {
      "id": "C62",
      "chapter": null,
      "text": "私は、この一行を読んで、しばらく画面から目を離しました。",
      "file": null,
      "start": 493.54,
      "duration": 5.71
    },
    {
      "id": "C63",
      "chapter": null,
      "text": "都合よく話を作っていると思っていました。そうではなかったんです。",
      "file": null,
      "start": 499.25,
      "duration": 6.53
    },
    {
      "id": "C64",
      "chapter": null,
      "text": "あなたが薄情になったのではありません。心が、そう働くようにできているんです。",
      "file": null,
      "start": 505.78,
      "duration": 7.76
    },
    {
      "id": "C65",
      "chapter": null,
      "text": "そして、ここからは私たちの年代に関わる話です。",
      "file": null,
      "start": 515.04,
      "duration": 4.69
    },
    {
      "id": "C66",
      "chapter": null,
      "text": "二〇二四年に、サイコロジー・アンド・エイジングという学術誌に載った研究があります。年齢とこの働きの関係を調べたものです。",
      "file": null,
      "start": 519.73,
      "duration": 12.24
    },
    {
      "id": "C67",
      "chapter": null,
      "text": "どの年代にも、この働きはありました。若い人にも、ちゃんとある。",
      "file": null,
      "start": 531.97,
      "duration": 6.33
    },
    {
      "id": "C68",
      "chapter": null,
      "text": "ただ、年齢が高いほど、その働きは強くなっていました。",
      "file": null,
      "start": 538.3,
      "duration": 5.31
    },
    {
      "id": "C69",
      "chapter": null,
      "text": "そして、その差を説明していたのは、体の衰えでも、気分の良し悪しでもありませんでした。",
      "file": null,
      "start": 543.61,
      "duration": 8.57
    },
    {
      "id": "C70",
      "chapter": null,
      "text": "楽しかった出来事を、どれだけ大事なことだと思っているか。差を生んでいたのは、そこだったんです。",
      "file": null,
      "start": 552.18,
      "duration": 9.59
    },
    {
      "id": "C71",
      "chapter": null,
      "text": "年を重ねた人ほど、いい日をいい日として、重く受け取っている。そういうことでした。",
      "file": null,
      "start": 561.77,
      "duration": 8.16
    },
    {
      "id": "C72",
      "chapter": null,
      "text": "ここで、言っておかなければならないことが二つあります。わかっていないことの方です。",
      "file": null,
      "start": 569.93,
      "duration": 8.37
    },
    {
      "id": "C73",
      "chapter": null,
      "text": "一つめ。これらの研究は、その多くがアメリカで行われました。参加したのも、大学生が中心です。",
      "file": null,
      "start": 578.3,
      "duration": 9.18
    },
    {
      "id": "C74",
      "chapter": null,
      "text": "世界の十の文化で同じ傾向が見つかった、という研究もあります。二〇一五年のものです。",
      "file": null,
      "start": 587.48,
      "duration": 8.37
    },
    {
      "id": "C75",
      "chapter": null,
      "text": "ですが、日本人を対象にした大規模な研究は、まだ十分ではありません。ここは、はっきりそう申し上げておきます。",
      "file": null,
      "start": 595.85,
      "duration": 10.82
    },
    {
      "id": "C76",
      "chapter": null,
      "text": "二つめ。この働きは、いつでも同じように回るわけではないんです。",
      "file": null,
      "start": 606.67,
      "duration": 6.33
    },
    {
      "id": "C77",
      "chapter": null,
      "text": "不安や気分の落ち込みが重いとき、この差が小さくなることが知られています。",
      "file": null,
      "start": 613,
      "duration": 7.35
    },
    {
      "id": "C78",
      "chapter": null,
      "text": "落ち込みの度合いが高いグループでは、この働きが出ていませんでした。つらい記憶も楽しい記憶も、同じ速さで薄れていた。二〇〇三年の、別の研究です。",
      "file": null,
      "start": 620.35,
      "duration": 14.49
    },
    {
      "id": "C79",
      "chapter": null,
      "text": "ですから、もし何年たっても少しも軽くならない、という方がいらしたら。",
      "file": null,
      "start": 634.84,
      "duration": 6.94
    },
    {
      "id": "C80",
      "chapter": null,
      "text": "それは、あなたの心が弱いからではありません。この働き自体が、うまく回らなくなることがある。そういうことが、研究でわかっているんです。",
      "file": null,
      "start": 641.78,
      "duration": 13.47
    },
    {
      "id": "C81",
      "chapter": null,
      "text": "そういうときは、一人で抱えずに、お医者さんに相談していい話なんです。それは弱さではなく、体の調子の話と同じことなんです。",
      "file": null,
      "start": 655.25,
      "duration": 12.24
    },
    {
      "id": "C82",
      "chapter": null,
      "text": "それから、この研究にはもう一つ、私が好きな発見がありました。",
      "file": null,
      "start": 667.49,
      "duration": 6.12
    },
    {
      "id": "C83",
      "chapter": null,
      "text": "つらかった出来事は、人に話したときの方が、早く軽くなっていたんです。",
      "file": null,
      "start": 673.61,
      "duration": 6.94
    },
    {
      "id": "C84",
      "chapter": null,
      "text": "そして、楽しかった出来事は、人に話しても薄れない。むしろ、保たれる。",
      "file": null,
      "start": 680.55,
      "duration": 6.94
    },
    {
      "id": "C85",
      "chapter": null,
      "text": "一人で何度も思い返すのとは、違う結果になる。これも、あの二〇〇九年の論文に書かれていました。",
      "file": null,
      "start": 687.49,
      "duration": 9.39
    },
    {
      "id": "C86",
      "chapter": null,
      "text": "ということは、です。亡くなった人のことを誰かに話して聞かせるのは、気休めではないということなんです。測れる働きがある。",
      "file": null,
      "start": 696.88,
      "duration": 12.04
    },
    {
      "id": "C87",
      "chapter": "第4章 — 帰り道",
      "text": "さて、あの午後の話に戻ります。",
      "file": null,
      "start": 708.92,
      "duration": 3.06
    },
    {
      "id": "C88",
      "chapter": null,
      "text": "日はだいぶ低くなっていました。畳の上の光の筋が、部屋の奥まで伸びて、色が濃くなっています。",
      "file": null,
      "start": 711.98,
      "duration": 9.18
    },
    {
      "id": "C89",
      "chapter": null,
      "text": "写真の箱は、開けたままです。孫は、まだそこに座っていました。私の答えを待っている顔で。",
      "file": null,
      "start": 721.16,
      "duration": 8.78
    },
    {
      "id": "C90",
      "chapter": null,
      "text": "私は、話の続きをしました。今度は、自分が何をしているのかわかったうえで。",
      "file": null,
      "start": 729.94,
      "duration": 7.35
    },
    {
      "id": "C91",
      "chapter": null,
      "text": "いい話をするのは、嘘をつくことではありません。先に出てくるものが、そちらだというだけのことなんです。",
      "file": null,
      "start": 737.29,
      "duration": 10.2
    },
    {
      "id": "C92",
      "chapter": null,
      "text": "それから私は、もう少しだけ本当のことを足しました。あの頃は大変な年もあってね、と。",
      "file": null,
      "start": 747.49,
      "duration": 8.37
    },
    {
      "id": "C93",
      "chapter": null,
      "text": "不思議なもので、その話をしても、声は重くなりませんでした。覚えてはいる。でも、もう痛くないんです。",
      "file": null,
      "start": 755.86,
      "duration": 10
    },
    {
      "id": "C94",
      "chapter": null,
      "text": "今日お話ししたことで、覚えて帰っていただきたいのは、一つだけです。",
      "file": null,
      "start": 765.86,
      "duration": 6.73
    },
    {
      "id": "C95",
      "chapter": null,
      "text": "いやな記憶そのものは、消えません。消えるのは、それにくっついていた感情の強さだけです。しかも、つらい方が先に薄れる。",
      "file": null,
      "start": 772.59,
      "duration": 11.84
    },
    {
      "id": "C96",
      "chapter": null,
      "text": "これは、誰かが慰めのために言い出した話ではありません。二万三千二百二件の日記の記録から、測られたことなんです。",
      "file": null,
      "start": 784.43,
      "duration": 11.22
    },
    {
      "id": "C97",
      "chapter": null,
      "text": "ですから、あの人の記憶が薄れたのではないんです。覚えていることは、ちゃんとそこに残っている。下りていったのは、重さの方だけです。",
      "file": null,
      "start": 795.65,
      "duration": 13.06
    },
    {
      "id": "C98",
      "chapter": null,
      "text": "そして、これは私たちだけの話でもありません。",
      "file": null,
      "start": 808.71,
      "duration": 4.49
    },
    {
      "id": "C99",
      "chapter": null,
      "text": "古い写真を前にして、あの頃はよかったと言っている人が、今この時間にも、どこかの家に座っています。その人にも、同じことが起きているんです。",
      "file": null,
      "start": 813.2,
      "duration": 13.88
    },
    {
      "id": "C100",
      "chapter": null,
      "text": "昔が優しく見えるのは、あなたが自分をだましているからではありません。",
      "file": null,
      "start": 829.08,
      "duration": 6.94
    },
    {
      "id": "C101",
      "chapter": null,
      "text": "重たかったものが下に落ちるまで、あなたが十分に遠くまで歩いてきた。それだけのことなんです。",
      "file": null,
      "start": 836.02,
      "duration": 9.18
    }
  ]
}