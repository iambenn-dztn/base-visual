    },
    {
      "t": 297.98,
      "s": "いた感情の強さの方なんです。"
    },
    {
      "t": 300.32,
      "s": "記憶と、記憶についた感情。"
    },
    {
      "t": 303.42,
      "s": "この二つは、別々のものとして測れる。"
    },
    {
      "t": 307.72,
      "s": "研究はそれを、別々に測っていました。"
    },
    {
      "t": 312.02,
      "s": "あの言い争いを、私は忘れてなどいない。ただ、"
    },
    {
      "t": 316.62,
      "s": "思い出したときの胸の締めつけが、"
    },
    {
      "t": 319.96,
      "s": "当時ほどではない。"
    },
    {
      "t": 321.84,
      "s": "それだけなんです。"
    },
    {
      "t": 323.72,
      "s": "さて、ここからが、"
    },
    {
      "t": 325.58,
      "s": "私にとっていちばん意外だったところです。"
    },
    {
      "t": 329.7,
      "s": "この働きは、いつから始まるのか。"
    },
    {
      "t": 333.2,
      "s": "私は、何年もかかるものだと思っていました。"
    },
    {
      "t": 337.78,
      "s": "歳月が薬になる、と言いますから。"
    },
    {
      "t": 341.28,
      "s": "ところが、半日ほどで、もう始まっていました。"
    },
    {
      "t": 345.47,
      "s": "出来事が起きて、十二時間ほど。"
    },
    {
      "t": 348.67,
      "s": "そのあたりで、もう差がつきはじめている。"
    },
    {
      "t": 352.94,
      "s": "そして三か月たっても、ちゃんと測れる。"
    },
    {
      "t": 356.99,
      "s": "これを調べたのが、"
    },
    {
      "t": 358.48,
      "s": "ギボンズとリーとウォーカーで、"
    },
    {
      "t": 360.97,
      "s": "二〇一一年の研究です。"
    },
    {
      "t": 362.8,
      "s": "論文の題が、そのまま結論になっていました。"
    },
    {
      "t": 366.27,
      "s": "フェージング・アフェクト・バイアスは"
    },
    {
      "t": 369.3,
      "s": "十二時間以内に始まり、三か月続く。"
    },
    {
      "t": 372.16,
      "s": "そういう題なんです。"
    },
    {
      "t": 373.84,
      "s": "つまり、"
    },
    {
      "t": 374.51,
      "s": "頑張って忘れようとしたから"
    },
    {
      "t": 376.67,
      "s": "始まるのではありません。"
    },
    {
      "t": 378.66,
      "s": "そんな指示を出した覚えがなくても、"
    },
    {
      "t": 381.49,
      "s": "もう動いているんです。"
    },
    {
      "t": 383.32,
      "s": "ここで、私はこう思いました。"
    },
    {
      "t": 386.18,
      "s": "それは本当に薄れているのだろうか、と。"
    },
    {
      "t": 390.06,
      "s": "人は、"
    },
    {
      "t": 390.67,
      "s": "昔の自分の気持ちを大げさに"
    },
    {
      "t": 393.32,
      "s": "覚えていることがあります。"
    },
    {
      "t": 395.97,
      "s": "この差も、ただの思い違いではないのか。"
    },
    {
      "t": 399.86,
      "s": "実は、この反論は研究者自身がしていました。"
    },
    {
      "t": 403.93,
      "s": "答えられるように、方法が組んであったんです。"
    },
    {
      "t": 408.19,
      "s": "最初の点は、"
    },
    {
      "t": 409.26,
      "s": "出来事が起きたその日につけてあります。"
    },
    {
      "t": 412.65,
      "s": "あとから記憶をたどった数字ではないので、"
    },
    {
      "t": 416.22,
      "s": "思い違いでは説明がつかないんです。"
    },
    {
      "t": 419.26,
      "s": "そして、もう一つ。"
    },
    {
      "t": 421.17,
      "s": "私はこれを知って、少し驚きました。"
    },
    {
      "t": 424.78,
      "s": "うれしい出来事といやな出来事は、"
    },
    {
      "t": 427.78,
      "s": "起きた時点での感情の強さが、"
    },
    {
      "t": 430.41,
      "s": "ほぼ同じだったんです。"
    },
    {
      "t": 432.48,
      "s": "つまり、"
    },
    {
      "t": 433.25,
      "s": "最初から楽しい方が強かったわけではない。"
    },
    {
      "t": 437.12,
      "s": "同じ高さから始まって、"
    },
    {
      "t": 439.25,
      "s": "下りていく速さだけが違っていた。"
    },
    {
      "t": 442.35,
      "s": "この整理をしたのが、ウォーカーと"
    },
    {
      "t": 445.15,
      "s": "スコウロンスキーの二〇〇九年の論文です。"
    },
    {
      "t": 448.64,
      "s": "その論文には、変わった題がついていました。"
    },
    {
      "t": 452.65,
      "s": "フェージング・アフェクト・バイアス。"
    },
    {
      "t": 456.09,
      "s": "それは一体、何のためにあるのか。"
    },
    {
      "t": 459.14,
      "s": "つまり、こういう問いです。"
    },
    {
      "t": 461.49,
      "s": "これは記憶の故障なのか、それとも、"
    },
    {
      "t": 464.57,
      "s": "そうなるようにできているのか。"
    },
    {
      "t": 467.29,
      "s": "著者たちの答えは、後者でした。"
    },
    {
      "t": 470.53,
      "s": "これは、記憶が壊れているのではない。"
    },
    {
      "t": 474.39,
      "s": "人が立ち直っていくための、"
    },
    {
      "t": 477.18,
      "s": "健康な働きが記憶の中で動いている。"
    },
    {
      "t": 480.83,
      "s": "その現れだ、と。"
    },
    {
      "t": 482.55,
      "s": "私は、"
    },
    {
      "t": 483.2,
      "s": "この一行を読んで、"
    },
    {
      "t": 485.17,
      "s": "しばらく画面から目を離しました。"
    },
    {
      "t": 488.65,
      "s": "都合よく話を作っていると思っていました。"
    },
    {
      "t": 492.39,
      "s": "そうではなかったんです。"
    },
    {
      "t": 494.63,
      "s": "あなたが薄情になったのではありません。"
    },
    {
      "t": 497.9,
      "s": "心が、そう働くようにできているんです。"
    },
    {
      "t": 502.67,
      "s": "そして、"
    },
    {
      "t": 503.57,
      "s": "ここからは私たちの年代に関わる話です。"
    },
    {
      "t": 507.82,
      "s": "二〇二四年に、"
    },
    {
      "t": 509.1,
      "s": "サイコロジー・アンド・エイジングと"
    },
    {
      "t": 512.22,
      "s": "いう学術誌に載った研究があります。"
    },
    {
      "t": 515.34,
      "s": "年齢とこの働きの関係を調べたものです。"
    },
    {
      "t": 518.82,
      "s": "どの年代にも、この働きはありました。"
    },
    {
      "t": 522.07,
      "s": "若い人にも、ちゃんとある。"
    },
    {
      "t": 524.42,
      "s": "ただ、"
    },
    {
      "t": 525.07,
      "s": "年齢が高いほど、"
    },
    {
      "t": 526.79,
      "s": "その働きは強くなっていました。"
    },
    {
      "t": 530.02,
      "s": "そして、"
    },
    {
      "t": 530.78,
      "s": "その差を説明していたのは、"
    },
    {
      "t": 533.24,
      "s": "体の衰えでも、"
    },
    {
      "t": 534.57,
      "s": "気分の良し悪しでもありませんでした。"
    },
    {
      "t": 537.98,
      "s": "楽しかった出来事を、"
    },
    {
      "t": 539.72,
      "s": "どれだけ大事なことだと思っているか。"
    },
    {
      "t": 542.87,
      "s": "差を生んでいたのは、そこだったんです。"
    },
    {
      "t": 546.18,
      "s": "年を重ねた人ほど、"
    },
    {
      "t": 547.97,
      "s": "いい日をいい日として、"
    },
    {
      "t": 550.16,
      "s": "重く受け取っている。"
    },
    {
      "t": 552.15,
      "s": "そういうことでした。"
    },
    {
      "t": 554.14,
      "s": "ここで、"
    },
    {
      "t": 554.84,
      "s": "言っておかなければならないこと"
    },
    {
      "t": 557.47,
      "s": "が二つあります。"
    },
    {
      "t": 558.87,
      "s": "わかっていないことの方です。"
    },
    {
      "t": 561.32,
      "s": "一つめ。"
    },
    {
      "t": 562.2,
      "s": "これらの研究は、"
    },
    {
      "t": 563.97,
      "s": "その多くがアメリカで行われました。"
    },
    {
      "t": 567.71,
      "s": "参加したのも、大学生が中心です。"
    },
    {
      "t": 571.25,
      "s": "世界の十の文化で同じ傾向が見つかった、"
    },
    {
      "t": 575.11,
      "s": "という研究もあります。"
    },
    {
      "t": 577.35,
      "s": "二〇一五年のものです。"
    },
    {
      "t": 579.58,
      "s": "ですが、"
    },
    {
      "t": 580.37,
      "s": "日本人を対象にした大規模な研究は、"
    },
    {
      "t": 583.71,
      "s": "まだ十分ではありません。"
    },
    {
      "t": 586.07,
      "s": "ここは、はっきりそう申し上げておきます。"
    },
    {
      "t": 590.01,
      "s": "二つめ。この働きは、"
    },
    {
      "t": 591.94,
      "s": "いつでも同じように回るわけではないんです。"
    },
    {
      "t": 595.99,
      "s": "不安や気分の落ち込みが重いとき、"
    },
    {
      "t": 598.71,
      "s": "この差が小さくなることが知られています。"
    },
    {
      "t": 602.09,
      "s": "落ち込みの度合いが高いグループでは、"
    },
    {
      "t": 605.99,
      "s": "この働きが出ていませんでした。"
    },
    {
      "t": 609.24,
      "s": "つらい記憶も楽しい記憶も、"
    },
    {
      "t": 612.06,
      "s": "同じ速さで薄れていた。"
    },
    {
      "t": 614.45,
      "s": "二〇〇三年の、別の研究です。"
    },
    {
      "t": 617.49,
      "s": "ですから、"
    },
    {
      "t": 618.56,
      "s": "もし何年たっても少しも軽くならない、"
    },
    {
      "t": 622.39,
      "s": "という方がいらしたら。"
    },
    {
      "t": 624.74,
      "s": "それは、あなたの心が弱いからではありません。"
    },
    {
      "t": 628.94,
      "s": "この働き自体が、"
    },
    {
      "t": 630.47,
      "s": "うまく回らなくなることがある。"
    },
    {
      "t": 633.33,
      "s": "そういうことが、研究でわかっているんです。"
    },
    {
      "t": 637.34,
      "s": "そういうときは、"
    },
    {
      "t": 638.87,
      "s": "一人で抱えずに、"
    },
    {
      "t": 640.4,
      "s": "お医者さんに相談していい話なんです。"
    },
    {
      "t": 643.83,
      "s": "それは弱さではなく、"
    },
    {
      "t": 645.74,
      "s": "体の調子の話と同じことなんです。"
    },
    {
      "t": 648.79,
      "s": "それから、"
    },
    {
      "t": 649.75,
      "s": "この研究にはもう一つ、"
    },
    {
      "t": 651.85,
      "s": "私が好きな発見がありました。"
    },
    {
      "t": 654.52,
      "s": "つらかった出来事は、"
    },
    {
      "t": 656.24,
      "s": "人に話したときの方が、"
    },
    {
      "t": 658.13,
      "s": "早く軽くなっていたんです。"
    },
    {
      "t": 660.37,
      "s": "そして、"
    },
    {
      "t": 661.22,
      "s": "楽しかった出来事は、"
    },
    {
      "t": 663.36,
      "s": "人に話しても薄れない。"
    },
    {
      "t": 665.7,
      "s": "むしろ、保たれる。"
    },
    {
      "t": 667.62,
      "s": "一人で何度も思い返すのとは、違う結果になる。"
    },
    {
      "t": 671.88,
      "s": "これも、"
    },
    {
      "t": 672.66,
      "s": "あの二〇〇九年の論文に書かれていました。"
    },
    {
      "t": 676.53,
      "s": "ということは、です。"
    },
    {
      "t": 678.37,
      "s": "亡くなった人のことを"
    },
    {
      "t": 680.22,
      "s": "誰かに話して聞かせるのは、"
    },
    {
      "t": 682.62,
      "s": "気休めではないということなんです。"
    },
    {
      "t": 685.75,
      "s": "測れる働きがある。"
    },
    {
      "t": 687.4,
      "s": "さて、あの午後の話に戻ります。"
    },
    {
      "t": 691.15,
      "s": "日はだいぶ低くなっていました。"
    },
    {
      "t": 694.16,
      "s": "畳の上の光の筋が、"
    },
    {
      "t": 695.97,
      "s": "部屋の奥まで伸びて、"
    },
    {
      "t": 697.97,
      "s": "色が濃くなっています。"
    },
    {
      "t": 700.18,
      "s": "写真の箱は、開けたままです。"
    },
    {
      "t": 703.14,
      "s": "孫は、まだそこに座っていました。"
    },
    {
      "t": 706.53,
      "s": "私の答えを待っている顔で。"
    },
    {
      "t": 709.28,
      "s": "私は、話の続きをしました。今度は、"
    },
    {
      "t": 712.98,
      "s": "自分が何をしているのかわかったうえで。"
    },
    {
      "t": 717.11,
      "s": "いい話をするのは、"
    },
    {
      "t": 718.7,
      "s": "嘘をつくことではありません。"
    },
    {
      "t": 721.18,
      "s": "先に出てくるものが、"
    },
    {
      "t": 722.94,
      "s": "そちらだというだけのことなんです。"
    },
    {
      "t": 725.95,
      "s": "それから私は、"
    },
    {
      "t": 727.4,
      "s": "もう少しだけ本当のことを足しました。"
    },
    {
      "t": 731.15,
      "s": "あの頃は大変な年もあってね、と。"
    },
    {
      "t": 734.47,
      "s": "不思議なもので、"
    },
    {
      "t": 736.38,
      "s": "その話をしても、"
    },
    {
      "t": 738.29,
      "s": "声は重くなりませんでした。"
    },
    {
      "t": 741.39,
      "s": "覚えてはいる。"
    },
    {
      "t": 743.07,
      "s": "でも、もう痛くないんです。"
    },
    {
      "t": 746.17,
      "s": "今日お話ししたことで、"
    },
    {
      "t": 748.04,
      "s": "覚えて帰っていただきたいのは、"
    },
    {
      "t": 750.58,
      "s": "一つだけです。"
    },
    {
      "t": 751.77,
      "s": "いやな記憶そのものは、消えません。"
    },
    {
      "t": 755.18,
      "s": "消えるのは、"
    },
    {
      "t": 756.39,
      "s": "それにくっついていた感情の強さだけです。"
    },
    {
      "t": 760.4,
      "s": "しかも、つらい方が先に薄れる。"
    },
    {
      "t": 763.42,
      "s": "これは、"
    },
    {
      "t": 764.14,
      "s": "誰かが慰めのために"
    },
    {
      "t": 765.76,
      "s": "言い出した話ではありません。"
    },
    {
      "t": 768.29,
      "s": "二万三千二百二件の日記の記録から、"
    },
    {
      "t": 771.36,
      "s": "測られたことなんです。"
    },
    {
      "t": 773.34,
      "s": "ですから、"
    },
    {
      "t": 774.27,
      "s": "あの人の記憶が薄れたのではないんです。"
    },
    {
      "t": 777.8,
      "s": "覚えていることは、ちゃんとそこに残っている。"
    },
    {
      "t": 781.89,
      "s": "下りていったのは、重さの方だけです。"
    },
    {
      "t": 785.23,
      "s": "そして、これは私たちだけの話でもありません。"
    },
    {
      "t": 789.3,
      "s": "古い写真を前にして、"
    },
    {
      "t": 791.33,
      "s": "あの頃はよかったと言っている人が、"
    },
    {
      "t": 794.78,
      "s": "今この時間にも、"
    },
    {
      "t": 796.4,
      "s": "どこかの家に座っています。"
    },
    {
      "t": 799.04,
      "s": "その人にも、同じことが起きているんです。"
    },
    {
      "t": 805.07,
      "s": "昔が優しく見えるのは、"
    },
    {
      "t": 806.86,
      "s": "あなたが自分をだまして"
    },
    {
      "t": 808.65,
      "s": "いるからではありません。"
    },
    {
      "t": 810.6,
      "s": "重たかったものが下に落ちるまで、"
    },
    {
      "t": 813.45,
      "s": "あなたが十分に遠くまで歩いてきた。"
    },
    {
      "t": 816.47,
      "s": "それだけのことなんです。"
    }
  ]
}