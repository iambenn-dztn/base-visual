{
  "total": 821.08,
  "count": 303,
  "cues": [
    {
      "t": 0,
      "s": "よく晴れた午後でした。"
    },
    {
      "t": 2.27,
      "s": "戸を開け放してあって、風が通っていました。"
    },
    {
      "t": 6.61,
      "s": "その日、"
    },
    {
      "t": 7.43,
      "s": "私はずっと後回しにして"
    },
    {
      "t": 9.67,
      "s": "いたことをしていました。"
    },
    {
      "t": 12.11,
      "s": "遺品の整理です。"
    },
    {
      "t": 13.75,
      "s": "何か月も、手がつけられずにいたんです。"
    },
    {
      "t": 17.62,
      "s": "押し入れの奥から、"
    },
    {
      "t": 19.67,
      "s": "古い写真の箱が出てきました。"
    },
    {
      "t": 22.86,
      "s": "蓋に埃がたまっています。"
    },
    {
      "t": 25.6,
      "s": "それを払って、開けました。"
    },
    {
      "t": 28.56,
      "s": "日が斜めに入ってきていて、"
    },
    {
      "t": 30.98,
      "s": "光の筋がはっきり見えました。その中を、"
    },
    {
      "t": 34.51,
      "s": "細かい埃がゆっくり流れていくんです。"
    },
    {
      "t": 37.85,
      "s": "写真を畳の上に広げていると、"
    },
    {
      "t": 40.8,
      "s": "隣に座っていた孫が、"
    },
    {
      "t": 42.91,
      "s": "こう聞きました。"
    },
    {
      "t": 44.59,
      "s": "おじいちゃんって、どんな人だったの。"
    },
    {
      "t": 49.18,
      "s": "私は、答えはじめました。あの人はね、と。"
    },
    {
      "t": 54.14,
      "s": "ところが、"
    },
    {
      "t": 55.13,
      "s": "話しているうちに、"
    },
    {
      "t": 56.9,
      "s": "自分の声が妙に聞こえてきたんです。"
    },
    {
      "t": 60.25,
      "s": "私は、いい話ばかりしていました。声も軽い。"
    },
    {
      "t": 64.98,
      "s": "それどころか、笑っていたんです。"
    },
    {
      "t": 68.58,
      "s": "そこで、口が止まりました。"
    },
    {
      "t": 73.57,
      "s": "なぜなら、私はちゃんと覚えているからです。"
    },
    {
      "t": 77.4,
      "s": "あの頃が、"
    },
    {
      "t": 78.31,
      "s": "いつも穏やかだったわけではないことを。"
    },
    {
      "t": 81.77,
      "s": "やりくりに苦しかった年もありました。"
    },
    {
      "t": 84.76,
      "s": "もうだめかもしれない、"
    },
    {
      "t": 86.59,
      "s": "とそのときは思った言い争いもありました。"
    },
    {
      "t": 89.91,
      "s": "忘れてはいないんです。"
    },
    {
      "t": 92.53,
      "s": "ただ、それが先に出てこなかった。"
    },
    {
      "t": 96.34,
      "s": "出てきたのは、いい話の方でした。"
    },
    {
      "t": 100.16,
      "s": "私は、"
    },
    {
      "t": 100.78,
      "s": "都合のいいところだけを話しているのだろうか。"
    },
    {
      "t": 105.31,
      "s": "薄情になったから、"
    },
    {
      "t": 107,
      "s": "あの頃が優しく見えるのだろうか。"
    },
    {
      "t": 110.01,
      "s": "正直に言うと、その午後、"
    },
    {
      "t": 112.77,
      "s": "私は孫に嘘を渡してしまった気がしていました。"
    },
    {
      "t": 117.84,
      "s": "それで、私は調べてみることにしました。"
    },
    {
      "t": 121.55,
      "s": "そうしたら、"
    },
    {
      "t": 122.72,
      "s": "思いがけないことがわかったんです。"
    },
    {
      "t": 126.04,
      "s": "この、昔が優しく見えるという感じ。"
    },
    {
      "t": 129.68,
      "s": "これを、実際に測ってみた人たちがいました。"
    },
    {
      "t": 134.18,
      "s": "やり方は、とても素朴なものです。"
    },
    {
      "t": 137.64,
      "s": "日記を使うんです。"
    },
    {
      "t": 139.59,
      "s": "参加した人は毎日、"
    },
    {
      "t": 141.14,
      "s": "その日にあった出来事を書きとめます。"
    },
    {
      "t": 144.24,
      "s": "うれしかったこと、"
    },
    {
      "t": 145.79,
      "s": "いやだったこと、"
    },
    {
      "t": 147.16,
      "s": "どちらもです。"
    },
    {
      "t": 148.37,
      "s": "そして大事なのがここなんです。"
    },
    {
      "t": 151.19,
      "s": "書いたその場で、"
    },
    {
      "t": 152.69,
      "s": "その出来事の感情の強さに点をつけておく。"
    },
    {
      "t": 156.45,
      "s": "つまり、"
    },
    {
      "t": 157.15,
      "s": "あとから思い出してつけた点ではありません。"
    },
    {
      "t": 160.84,
      "s": "出来事が起きた、その日のうちの点なんです。"
    },
    {
      "t": 164.52,
      "s": "それから何か月かたって、もう一度、"
    },
    {
      "t": 167.89,
      "s": "同じ出来事を読み返してもらいます。"
    },
    {
      "t": 171.26,
      "s": "そして今どう感じるか、また点をつける。"
    },
    {
      "t": 175.02,
      "s": "これで、"
    },
    {
      "t": 175.89,
      "s": "当時の点と今の点を並べて比べられるわけです。"
    },
    {
      "t": 180.7,
      "s": "感想ではなく、数字として。"
    },
    {
      "t": 183.55,
      "s": "この方法で集まった記録が、"
    },
    {
      "t": 186.55,
      "s": "どれくらいあったか。"
    },
    {
      "t": 188.85,
      "s": "八つの日記研究。"
    },
    {
      "t": 190.69,
      "s": "参加した人が、二百二十九人。"
    },
    {
      "t": 193.92,
      "s": "書きとめられた出来事は、二万三千二百二件。"
    },
    {
      "t": 198.47,
      "s": "追いかけた期間は、"
    },
    {
      "t": 200.42,
      "s": "短いもので一年半、"
    },
    {
      "t": 202.36,
      "s": "長いもので二年半ほどです。"
    },
    {
      "t": 205.17,
      "s": "これをまとめたのが、"
    },
    {
      "t": 206.98,
      "s": "ウォーカーとスコウロンスキーと"
    },
    {
      "t": 209.71,
