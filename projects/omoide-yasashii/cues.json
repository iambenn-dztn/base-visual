    },
    {
      "t": 213.88,
      "s": "題は、こうついていました。"
    },
    {
      "t": 216.62,
      "s": "人生は心地よい。"
    },
    {
      "t": 218.3,
      "s": "そして記憶が、それを保つのを手伝っている。"
    },
    {
      "t": 222.72,
      "s": "では、二万件を超える記録は、何を示したのか。"
    },
    {
      "t": 228,
      "s": "まず、どちらの感情も薄れていました。"
    },
    {
      "t": 231.32,
      "s": "うれしかったことも、"
    },
    {
      "t": 233.17,
      "s": "いやだったことも、"
    },
    {
      "t": 234.83,
      "s": "当時ほどの強さではなくなる。"
    },
    {
      "t": 237.42,
      "s": "ここまでは、たぶん誰でも思うところです。"
    },
    {
      "t": 241.46,
      "s": "違いは、その先にありました。"
    },
    {
      "t": 244.29,
      "s": "いやだったことの方が、先に薄れていたんです。"
    },
    {
      "t": 248.49,
      "s": "両方薄れる。"
    },
    {
      "t": 249.95,
      "s": "でも、速さが違う。"
    },
    {
      "t": 252.14,
      "s": "つらい方が早く軽くなって、"
    },
    {
      "t": 255.31,
      "s": "うれしい方がゆっくり残る。"
    },
    {
      "t": 258.47,
      "s": "この差には、名前がついています。"
    },
    {
      "t": 261.77,
      "s": "フェージング・アフェクト・バイアス。"
    },
    {
      "t": 265.49,
      "s": "感情が薄れていく、その傾きのことです。"
    },
    {
      "t": 269.41,
      "s": "名づけたのは、"
    },
    {
      "t": 270.76,
      "s": "ウォーカーとフォーグルとトンプソンで、"
    },
    {
      "t": 274.42,
      "s": "一九九七年のことでした。"
    },
    {
      "t": 276.73,
      "s": "ただ、ここに一つ、"
    },
    {
      "t": 278.47,
      "s": "私がいちばん誤解していたところがあります。"
    },
    {
      "t": 282.52,
      "s": "薄れているのは、記憶そのものではありません。"
    },
    {
      "t": 286.45,
      "s": "出来事は覚えています。"
    },
    {
      "t": 288.4,
      "s": "いつのことか、"
    },
    {
      "t": 289.64,
      "s": "どこでのことか、"
    },
    {
      "t": 291.06,
      "s": "何を言われたか。"
    },
    {
      "t": 292.49,
      "s": "細かいところまで残っている。"
    },
    {
      "t": 294.98,
      "s": "薄れていくのは、"
    },
    {
      "t": 296.31,
