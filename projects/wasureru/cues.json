    {
      "t": 425.23,
      "s": "たくさんのものがつながっています。"
    },
    {
      "t": 428.64,
      "s": "焼きたての匂い、朝の早い仕事、店先の棚。"
    },
    {
      "t": 432.65,
      "s": "ところが名字は、"
    },
    {
      "t": 433.98,
      "s": "その人に貼られた札のようなものです。"
    },
    {
      "t": 436.99,
      "s": "意味の糸が、ほとんどついていない。だから、"
    },
    {
      "t": 440.49,
      "s": "たぐり寄せる手がかりが"
    },
    {
      "t": 442.32,
      "s": "少ないということなんです。"
    },
    {
      "t": 444.5,
      "s": "名前が抜けやすいのは、"
