    {
      "t": 104.35,
      "s": "そもそも、忘れるとはどういうことなのか。"
    },
    {
      "t": 108.7,
      "s": "最初に出会ったのは、"
    },
    {
      "t": 110.76,
      "s": "私の思い込みとは逆の考え方でした。"
    },
    {
      "t": 114.28,
      "s": "二〇一七年に、"
    },
    {
      "t": 115.5,
      "s": "ニューロンという神経科学の学術誌に"
