    {
      "t": 452.54,
      "s": "別の話だったんです。"
    },
    {
      "t": 454.25,
      "s": "そして、ここからが、"
    },
    {
      "t": 455.86,
      "s": "私にとっていちばん大事なところでした。"
    },
    {
      "t": 458.93,
      "s": "人の顔を見て名前が出てくるまでには、"
    },
    {
      "t": 462.03,
      "s": "順番があると考えられています。"
    },
    {
      "t": 464.61,
      "s": "一九八六年に、"
    },
    {
      "t": 465.82,
      "s": "ブルースとヤングというイギリスの心理学者が"
    },
    {
      "t": 469.44,
      "s": "まとめた考え方です。"
    },
    {
      "t": 471.16,
      "s": "まず、この顔は知っている、と感じる。"
