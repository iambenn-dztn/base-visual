    {
      "t": 474.84,
      "s": "次に、この人が誰なのかがわかる。"
    },
    {
      "t": 478.12,
      "s": "昔の職場の人だ、世話になった人だ、と。"
    },
    {
      "t": 482,
      "s": "名前は、その後です。"
    },
    {
      "t": 484.05,
      "s": "いちばん最後なんです。"
    },
    {
      "t": 486.3,
      "s": "これを裏づける記録があります。一九八五年、"
    },
    {
      "t": 490.34,
      "s": "ヤングたちは二十二人に、七週間、"
    },
    {
      "t": 493.42,
      "s": "人を見分けるときのつまずきを"
    },
    {
      "t": 496.12,
      "s": "書きとめてもらいました。"
    },
    {
      "t": 498.43,
      "s": "集まった記録は、九百二十二件です。"
    },
    {
      "t": 501.7,
      "s": "誰なのかはわかっているのに、"
    },
    {
      "t": 504.6,
      "s": "名前が出てこない。"
    },
    {
      "t": 506.47,
      "s": "そういう記録は、たくさんありました。"
    },
    {
      "t": 510.21,
      "s": "では、その逆はどうだったか。"
    },
    {
      "t": 513.1,
      "s": "名前は出てくるのに、"
    },
    {
      "t": 514.95,
      "s": "その人が誰なのかわからない。"
    },
    {
      "t": 518.52,
      "s": "そういう記録は、一件もなかったんです。"
    },
    {
      "t": 523.35,
      "s": "名前は、"
    },
    {
      "t": 524.12,
      "s": "その人の記憶の入り口ではありませんでした。"
    },
    {
      "t": 528.17,
      "s": "いちばん奥にある、最後の扉だったんです。"
    },
    {
      "t": 532.03,
      "s": "あの朝、最後の扉は開きませんでした。ですが、"
    },
    {
      "t": 536.5,
      "s": "その手前の扉は、"
    },
    {
      "t": 538.13,
      "s": "全部開いていたわけです。顔も、"
    },
    {
      "t": 541.17,
      "s": "あの晩の缶コーヒーも、"
    },
    {
      "t": 543.41,
      "s": "あの人が自分にとって誰なのかも。"
    },
    {
      "t": 546.66,
      "s": "ここで一つ、"
    },
    {
      "t": 547.59,
      "s": "はっきりお伝えして"
    },
    {
      "t": 548.99,
