    },
    {
      "t": 556.94,
      "s": "国立長寿医療研究センターの説明でも、"
    },
    {
      "t": 560.5,
      "s": "この二つは別のものとして扱われています。"
    },
    {
      "t": 564.46,
      "s": "一つは、年齢とともに起きる物忘れです。"
    },
    {
      "t": 568.11,
      "s": "うっかりは増えても、"
    },
    {
      "t": 570.03,
      "s": "毎日の暮らしは変わらずに回っていきます。"
    },
    {
      "t": 573.88,
      "s": "もう一つは、"
    },
    {
      "t": 575.03,
      "s": "病気によるもので、"
    },
    {
      "t": 576.76,
      "s": "暮らしそのものに支障が"
    },
    {
      "t": 578.87,
      "s": "出てくることがあります。"
    },
    {
      "t": 581.19,
      "s": "これは診断ではありません。"
    },
    {
      "t": 583.84,
      "s": "もしご自身やご家族の物忘れが、"
    },
    {
      "t": 586.89,
      "s": "日常生活に支障が出るほど心配な場合は、"
    },
    {
      "t": 590.76,
      "s": "迷わず医師にご相談ください。"
    },
    {
      "t": 595.08,
      "s": "そのうえで、もう一つ、"
    },
    {
      "t": 596.9,
      "s": "知っておいていただきたい研究があります。"
    },
    {
      "t": 600.21,
      "s": "二〇一〇年に、"
    },
    {
      "t": 601.45,
      "s": "アメリカのアイオワ大学のファインスタインたち"
    },
    {
      "t": 605.34,
      "s": "が、"
    },
    {
      "t": 605.69,
      "s": "米国科学アカデミー紀要と"
    },
    {
      "t": 607.82,
      "s": "いう学術誌に発表したものです。"
    },
    {
      "t": 610.47,
      "s": "協力したのは、"
    },
    {
      "t": 611.82,
      "s": "脳の海馬が傷ついていて、"
    },
    {
      "t": 614.13,
      "s": "新しい出来事をほとんど覚えて"
    },
    {
      "t": 616.83,
      "s": "おけない五人の方々です。"
    },
    {
      "t": 619.14,
      "s": "その方々に、"
    },
    {
      "t": 620.45,
      "s": "二十分ほどの悲しい映画や、"
    },
    {
      "t": 623.3,
      "s": "楽しい映画を見てもらいました。"
    },
    {
      "t": 626.58,
      "s": "涙を流す人も、"
    },
    {
      "t": 628.12,
      "s": "声を上げて笑う人もいたそうです。"
    },
    {
      "t": 631.62,
      "s": "しばらくすると、"
    },
    {
      "t": 633.07,
      "s": "映画の中身は、"
    },
    {
      "t": 634.34,
      "s": "ほとんど思い出せなくなっていました。ですが、"
    },
    {
      "t": 638.33,
      "s": "そのとき生まれた悲しさや楽しさは、"
    },
    {
      "t": 641.41,
      "s": "中身を忘れたあとも続いていたんです。"
    },
    {
      "t": 644.67,
      "s": "何を見たのかは消えても、"
    },
    {
      "t": 646.91,
      "s": "どう感じたのかは残っていた。"
    },
    {
      "t": 649.52,
      "s": "出来事の記録と、"
    },
    {
      "t": 651.01,
      "s": "そのとき動いた気持ちは、"
    },
    {
      "t": 653.24,
      "s": "同じ道を通って残るわけで"
    },
    {
      "t": 655.48,
      "s": "はないということです。"
    },
    {
      "t": 657.53,
      "s": "ただ、これは五人だけの研究です。"
    },
    {
      "t": 660.7,
      "s": "特別な状況にある方々で、"
    },
    {
      "t": 663.08,
      "s": "そのまま私たちに当てはめることはできません。"
    },
    {
      "t": 667.43,
      "s": "気持ちがどれくらい残るのかも、"
    },
    {
      "t": 670.4,
      "s": "正直に言うと、"
    },
    {
      "t": 671.79,
      "s": "まだよくわかっていないんです。"
    },
    {
      "t": 674.76,
      "s": "それでも、"
    },
    {
      "t": 675.63,
      "s": "これを読んだとき、"
    },
    {
      "t": 677.19,
      "s": "私はあの人の笑顔を思い出していました。"
    },
    {
      "t": 680.49,
      "s": "名前は出なくても、"
    },
    {
      "t": 682.06,
      "s": "懐かしいという気持ちだけは、"
    },
    {
      "t": 684.49,
      "s": "振り向いた瞬間に届いていたからです。"
    },
    {
      "t": 687.62,
      "s": "あの朝の郵便局に、もう一度戻ります。"
    },
    {
      "t": 691.76,
      "s": "名前が出てこなかった、あの数分間。"
    },
    {
      "t": 695.66,
      "s": "私は何をしていたのか。"
    },
    {
      "t": 698.2,
      "s": "お互いの近況を話していました。"
    },
    {
      "t": 701.07,
      "s": "あの頃の課長はどうしているかと聞き合って、"
    },
    {
      "t": 705.09,
      "s": "二人で少し笑いました。"
    },
    {
      "t": 707.19,
      "s": "別れ際に、あの人は、"
    },
    {
      "t": 709.36,
      "s": "会えてよかった、"
    },
    {
      "t": 711.09,
      "s": "と言いました。"
    },
    {
      "t": 712.61,
      "s": "私も同じことを言いました。"
    },
    {
      "t": 715.42,
      "s": "本心からです。"
    },
    {
      "t": 716.94,
      "s": "名前という最後の扉は、閉まったままでした。"
    },
    {
      "t": 721.07,
      "s": "でもその手前には、"
    },
    {
      "t": 722.84,
      "s": "あの人が誰なのかも、"
    },
    {
      "t": 724.81,
      "s": "一緒に働いた時間の温かさも、"
    },
    {
      "t": 727.57,
      "s": "ちゃんとあったんです。"
    },
    {
      "t": 729.73,
      "s": "名前は、その日の夜になって出てきました。"
    },
    {
      "t": 734.19,
      "s": "台所で米を研いでいるときに、ふっと。"
    },
    {
      "t": 738.19,
      "s": "私は一人で、ああ、と声を出していました。"
    },
    {
      "t": 744.13,
      "s": "今日のお話で、"
    },
    {
      "t": 745.44,
      "s": "持ち帰っていただきたいことは一つです。"
    },
    {
      "t": 749,
      "s": "人の顔を見て、"
    },
    {
      "t": 750.38,
      "s": "名前が出てくるのは、"
    },
    {
      "t": 752.36,
      "s": "いちばん最後。"
    },
    {
      "t": 753.74,
      "s": "九百二十二件の記録の中に、"
    },
    {
      "t": 756.31,
      "s": "名前だけが出てきて、"
    },
    {
      "t": 758.28,
      "s": "その人が誰かわからないという例は、"
    },
    {
      "t": 761.64,
      "s": "一つもありませんでした。"
    },
    {
      "t": 764.01,
      "s": "ですから、"
    },
    {
      "t": 764.88,
      "s": "名前が出てこないとき、"
    },
    {
      "t": 766.8,
      "s": "その手前にあるものは、"
    },
    {
      "t": 768.72,
      "s": "たいていもう届いているんです。"
    },
    {
      "t": 771.34,
      "s": "この人を知っている。この人は、"
    },
    {
      "t": 773.96,
      "s": "自分にとってこういう人だ、"
    },
    {
      "t": 776.23,
      "s": "という感覚です。"
    },
    {
      "t": 779.6,
      "s": "名前は、奥の扉に掛かった小さな札です。"
    },
    {
      "t": 783.38,
      "s": "札が一枚見つからない朝があっても、"
    },
    {
      "t": 786.76,
      "s": "その手前の扉は、"
    },
    {
      "t": 788.35,
      "s": "ちゃんと開いているんです。"
    }
  ]
}