{
  "total": 867.24,
  "count": 319,
  "cues": [
    {
      "t": 0,
      "s": "朝の六時前でした。"
    },
    {
      "t": 1.88,
      "s": "家の中はまだ暗く、"
    },
    {
      "t": 3.77,
      "s": "廊下の冷たさが足の裏に残っています。"
    },
    {
      "t": 7.53,
      "s": "私は仏壇の前に座って、両側の扉を開けます。"
    },
    {
      "t": 11.78,
      "s": "この動作だけは、もう考えなくてもできます。"
    },
    {
      "t": 16.02,
      "s": "茶湯をさげて、新しい水に替えます。"
    },
    {
      "t": 19.8,
      "s": "線香を一本立て、鈴を一度だけ鳴らします。"
    },
    {
      "t": 24.24,
      "s": "それから、私は話しかけます。"
    },
    {
      "t": 27.69,
      "s": "声に出して、です。"
    },
    {
      "t": 29.92,
      "s": "今朝は冷えましたね、と。"
    },
    {
      "t": 32.72,
      "s": "庭の柿に、今年も実がつきましたよ、と。"
    },
    {
      "t": 37.14,
      "s": "昨日あったことを、二つか三つ。"
    },
    {
      "t": 40.64,
      "s": "そのとき、廊下を誰かが通りました。"
    },
    {
      "t": 44.65,
      "s": "足音が、後ろで半秒だけ止まったんです。"
    },
    {
      "t": 49.13,
      "s": "そして、何も言わずに行ってしまいました。"
    },
    {
      "t": 52.99,
      "s": "台所で、水の音がしはじめます。"
    },
    {
      "t": 55.89,
      "s": "私はそのまま、線香の煙を見ていました。"
    },
    {
      "t": 59.98,
      "s": "まっすぐ上がって、"
    },
    {
      "t": 61.91,
      "s": "途中でふっと崩れる、あの煙です。"
    },
    {
      "t": 65.35,
      "s": "返事がないことは、わかっています。"
    },
    {
      "t": 69,
      "s": "それでも毎朝、話しかけている。"
    },
    {
      "t": 72.23,
      "s": "私は、誰に向かって話しているんだろう。"
    },
    {
      "t": 76.62,
      "s": "正直に言うと、"
    },
    {
      "t": 78.24,
      "s": "そのとき初めて、"
    },
    {
      "t": 80.09,
      "s": "自分でも少し怖くなりました。"
    },
    {
      "t": 83.33,
      "s": "こんなことをしている自分は、"
    },
    {
      "t": 85.36,
      "s": "おかしいんでしょうか。"
    },
    {
      "t": 88.44,
      "s": "その朝、私はそれを調べはじめたんです。"
    },
    {
      "t": 92.71,
      "s": "最初にやってみたのは、"
    },
    {
      "t": 95.04,
      "s": "調べものではありません。"
    },
    {
      "t": 97.58,
      "s": "頭の中で、ひとつ試したんです。"
    },
    {
      "t": 100.75,
      "s": "あの人は、もうお腹がすかない。"
    },
    {
      "t": 104.44,
      "s": "これは思い描けます。"
    },
    {
      "t": 106.9,
      "s": "冬でも寒くない。"
    },
    {
      "t": 108.86,
      "s": "これも描けます。"
    },
    {
      "t": 110.83,
      "s": "足も痛くない。"
    },
    {
      "t": 112.43,
      "s": "息も苦しくない。"
    },
    {
      "t": 114.26,
      "s": "ここまでは、すっと入ってきます。"
    },
    {
      "t": 117.91,
      "s": "では、こうです。"
    },
    {
      "t": 119.45,
      "s": "あの人は、もう何も思っていない。"
    },
    {
      "t": 122.54,
      "s": "何も知らないし、何も望んでいない。"
    },
    {
      "t": 125.82,
      "s": "そこで、私の頭は止まりました。"
    },
    {
      "t": 129.51,
      "s": "文字としては読めます。"
    },
    {
      "t": 132.21,
      "s": "ですが、中身が、どうしても浮かんでこない。"
    },
    {
      "t": 137.37,
      "s": "なんというか、壁に手をついたような感じです。"
    },
    {
      "t": 141.25,
      "s": "ここから先は、想像が入っていかないんです。"
    },
    {
      "t": 144.96,
      "s": "そして、その止まる場所を測った人がいました。"
    },
    {
      "t": 149.23,
      "s": "ジェシー・ベリングという研究者です。"
    },
    {
      "t": 151.94,
      "s": "二〇〇二年、"
    },
    {
      "t": 152.84,
      "s": "「ジャーナル・オブ・コグニション・アンド・カ"
    },
    {
      "t": 156.15,
      "s": "ルチャー」と"
    },
    {
      "t": 157.05,
      "s": "いう学術誌に出しました。"
    },
    {
      "t": 158.86,
      "s": "やり方は簡単です。"
    },
    {
      "t": 160.68,
      "s": "ある人物が亡くなる短い物語を読ませ、"
    },
    {
      "t": 164.32,
      "s": "そのあとで質問をしていきます。"
    },
    {
      "t": 167.35,
      "s": "この人は、まだ喉が渇いていますか。"
    },
    {
      "t": 171.12,
      "s": "まだ眠くなりますか。"
    },
    {
      "t": 173.34,
      "s": "こういう体の質問には、ほとんどが、"
    },
    {
      "t": 177.12,
      "s": "いいえです。"
    },
    {
      "t": 178.45,
      "s": "ところが、"
    },
    {
      "t": 179.46,
      "s": "質問を心に移すと、"
    },
    {
      "t": 181.29,
      "s": "答えが変わります。"
    },
    {
      "t": 183.11,
      "s": "この人は、奥さんを愛していますか。"
    },
    {
      "t": 186.56,
      "s": "自分が死んだことを知っていますか。"
    },
    {
      "t": 190,
      "s": "はい、という答えが、ぐっと増えます。"
    },
    {
      "t": 194.13,
      "s": "しかも、ここが肝心なところなんですが。"
    },
    {
      "t": 198.48,
      "s": "「死ねば意識はそこで終わりだ」と、"
    },
    {
      "t": 201.58,
      "s": "自分でそう答えていた人たちでも、"
    },
    {
      "t": 204.49,
      "s": "同じように答えてしまうんです。"
    },
    {
      "t": 207.22,
      "s": "自分の考えと、口から出る答えが、ずれている。"
    },
    {
      "t": 211.78,
      "s": "信じている、いないの問題ではなかったんです。"
    },
    {
      "t": 216.35,
      "s": "ベリングは、この食い違いに説明をつけました。"
    },
    {
      "t": 220.66,
      "s": "シミュレーション制約、という言い方です。"
    },
    {
      "t": 224.57,
      "s": "私たちの頭は、"
    },
    {
      "t": 225.96,
      "s": "いろいろなことを中で再生できます。"
    },
    {
      "t": 229.35,
      "s": "冷たい水に手を入れたらどうなるか。"
    },
    {
      "t": 232.73,
      "s": "実際にやらなくても、再生できます。"
    },
    {
      "t": 236.12,
      "s": "ですが、再生できないものが一つだけあります。"
    },
    {
      "t": 240.47,
      "s": "自分が一度も入ったことのない状態です。"
    },
    {
      "t": 244.24,
      "s": "何も感じていない状態を、"
    },
    {
      "t": 246.61,
      "s": "私は経験したことがありません。"
    },
    {
      "t": 249.59,
      "s": "材料がないので、再生できない。"
    },
    {
      "t": 252.74,
      "s": "それでも頭は、"
    },
    {
      "t": 254.2,
      "s": "空白のままにしておけず、"
    },
    {
      "t": 256.72,
      "s": "いちばん近いものを当てはめます。"
    },
    {
      "t": 260.08,
      "s": "知っている、思っている、聞いている、を。"
    },
    {
      "t": 264.27,
      "s": "つまり、"
    },
    {
      "t": 265.03,
      "s": "亡くなった人を「どこかで"
    },
    {
      "t": 267.3,
      "s": "聞いている人」として扱うのは、"
    },
    {
      "t": 270.14,
      "s": "信仰の話ではないんです。"
    },
    {
      "t": 272.41,
      "s": "頭の作りの、できないことの話なんですね。"
    },
    {
      "t": 276.19,
      "s": "ここは正直に申し上げます。"
    },
    {
      "t": 278.88,
      "s": "これは仮説です。"
    },
    {
      "t": 280.54,
      "s": "証明された事実ではありません。"
    },
    {
      "t": 283.65,
      "s": "二〇〇七年には、"
    },
    {
      "t": 285.49,
      "s": "別の説明を出した研究者もいます。想像の妨げ、"
    },
    {
      "t": 290.53,
      "s": "という捉え方で、"
    },
    {
      "t": 292.37,
      "s": "仕組みの読み方が違うんです。"
    },
    {
      "t": 295.58,
      "s": "ですから、"
    },
    {
      "t": 296.56,
      "s": "そういう説がある、"
    },
    {
      "t": 298.32,
      "s": "とだけ申し上げます。ただ、"
    },
    {
      "t": 300.87,
      "s": "私が止まったあの場所に、"
    },
    {
      "t": 303.22,
      "s": "名前がついていたことは確かでした。"
    },
    {
      "t": 306.55,
      "s": "少なくとも、私ひとりの癖ではなかった。"
    },
    {
      "t": 310.62,
      "s": "それだけでも、"
    },
    {
      "t": 312.12,
      "s": "その朝の私には、"
    },
    {
      "t": 313.84,
      "s": "ずいぶん違って感じられたんです。"
    },
    {
      "t": 319.25,
      "s": "ですが、"
    },
    {
      "t": 319.97,
      "s": "ここで私はもう一つ、"
    },
    {
      "t": 321.78,
      "s": "引っかかったんです。"
    },
    {
      "t": 323.59,
      "s": "もしこれが、"
    },
    {
      "t": 324.63,
      "s": "人間の頭に備わった作りなのだとしたら。"
    },
    {
      "t": 327.93,
      "s": "どうしてこの世には、"
    },
    {
      "t": 329.67,
      "s": "「もう忘れなさい」と"
    },
    {
      "t": 331.41,
      "s": "言う人がいるんでしょうか。"
    },
    {
      "t": 333.67,
      "s": "そろそろ前を向きなさい。"
    },
    {
      "t": 335.88,
      "s": "いつまでも引きずるのはよくない。法事の席で、"
    },
    {
      "t": 339.94,
      "s": "こういう言葉を聞いた方は、"
    },
    {
      "t": 342.34,
      "s": "多いと思います。"
    },
    {
      "t": 343.81,
      "s": "あの言葉にも、実は出どころがありました。"
    },
    {
      "t": 348.01,
      "s": "ここからは、"
    },
    {
      "t": 349.27,
      "s": "ある学問が百年かけて考えを変えていく話です。"
    },
    {
      "t": 353.9,
      "s": "さかのぼると、一九一七年です。"
    },
    {
      "t": 357.22,
      "s": "フロイトが「喪とメランコリー」と"
    },
    {
      "t": 360.77,
      "s": "いう論文を書きました。"
    },
    {
      "t": 363.21,
      "s": "悲しみの仕事とは、"
    },
    {
      "t": 365.01,
      "s": "亡くなった人に向いた心の結びつきを、"
    },
    {
      "t": 368.6,
      "s": "少しずつほどく作業である。"
    },
    {
      "t": 371.19,
      "s": "責めるつもりはありません。"
    },
    {
      "t": 374.17,
      "s": "百年前の見取り図です。"
    },
    {
      "t": 376.69,
      "s": "ただ、これが驚くほど長く残りました。"
    },
    {
      "t": 380.82,
      "s": "二十世紀のあいだ、"
    },
    {
      "t": 382.83,
      "s": "欧米の研究はこの線で進みます。"
    },
    {
      "t": 386.18,
      "s": "断ち切れた人は立ち直った人。"
    },
    {
      "t": 389.31,
      "s": "断ち切れない人は、まだ途中の人。"
    },
    {
      "t": 392.88,
      "s": "「もう忘れなさい」という、あの一言。"
    },
    {
      "t": 396.67,
      "s": "誰かの冷たさではなくて、"
    },
    {
      "t": 399.2,
      "s": "この百年の物差しが、"
    },
    {
      "t": 401.31,
      "s": "日常の言い方になって"
    },
    {
      "t": 403.41,
      "s": "降りてきたものなんですね。"
    },
    {
      "t": 406.15,
      "s": "その物差しが、ひっくり返った年があります。"
    },
    {
      "t": 411.37,
      "s": "一九九六年です。"
    },
    {
      "t": 413.36,
      "s": "クラス、"
    },
    {
      "t": 414.02,
      "s": "シルバーマン、"
    },
    {
      "t": 415.18,
      "s": "ニックマンの三人が"
    },
    {
      "t": 416.67,
      "s": "編んだ『コンティニューイング・ボンズ』、"
    },
    {
      "t": 419.98,
      "s": "続いていく絆、"
    },
    {
      "t": 421.14,
      "s": "という本が出ました。"
    },
    {
      "t": 422.81,
      "s": "二十人を超える研究者が、"
    },
    {
      "t": 425.18,
      "s": "いろいろな土地の遺族を"
    },
    {
      "t": 427.35,
      "s": "調べた報告を持ち寄った本です。"
    },
    {
      "t": 430.31,
      "s": "見えてきたのは、こうでした。"
    },
    {
      "t": 433.08,
      "s": "立ち直っていった人たちの多くが、"
    },
    {
      "t": 436.1,
      "s": "絆を断ち切ってなどいなかった。"
    },
    {
      "t": 438.92,
      "s": "写真に話しかけ、"
    },
    {
      "t": 440.43,
      "s": "心の中で相談しながら、"
    },
    {
      "t": 442.5,
      "s": "それでも前へ進んでいたんです。"
    },
    {
      "t": 445.33,
      "s": "私がいちばん唸ったのは、次の指摘です。"
    },
    {
      "t": 449.01,
      "s": "断ち切れという百年の物差しは、"
    },
    {
      "t": 451.91,
      "s": "人が実際に何をしているかを"
    },
    {
      "t": 454.43,
      "s": "調べて出たものではなかった。"
    },
    {
      "t": 457.14,
      "s": "つまり一九九六年に起きたのは、"
    },
    {
      "t": 460.36,
      "s": "新しい発見ではありません。"
    },
    {
      "t": 463.16,
      "s": "人がずっとやっていたことを、"
    },
    {
      "t": 466.17,
      "s": "学問がようやく見に行った、"
    },
    {
      "t": 468.96,
      "s": "ということなんです。"
    },
    {
      "t": 471.11,
      "s": "ただ、"
    },
    {
      "t": 471.72,
      "s": "話を都合よく終わらせないために、"
    },
    {
      "t": 474.99,
      "s": "境目をはっきりさせます。"
    },
    {
      "t": 477.44,
      "s": "では絆は保てば保つほどいいのか。"
    },
    {
      "t": 480.71,
      "s": "そこまでは言えていません。"
    },
    {
      "t": 483.36,
      "s": "ナイジェル・フィールドという研究者たちが、"
    },
    {
      "t": 487.35,
      "s": "二〇〇六年ごろに一つの区別を出しています。"
    },
    {
      "t": 491.35,
      "s": "内在化と、外在化です。"
    },
    {
      "t": 493.44,
      "s": "内在化は、"
    },
    {
      "t": 494.5,
      "s": "亡くなった人の記憶を支えにしている状態。"
    },
    {
      "t": 498.76,
      "s": "あの人ならこう言うだろうな、"
    },
    {
      "t": 501.74,
      "s": "と思いながら、"
    },
    {
      "t": 503.23,
      "s": "自分の足で歩く形です。"
    },
    {
      "t": 505.57,
      "s": "外在化は、"
    },
    {
      "t": 506.62,
      "s": "その人がまだ外の世界に"
    },
    {
      "t": 508.91,
      "s": "いるかのように振る舞う状態。調べると、"
    },
    {
      "t": 512.89,
      "s": "内在化のほうが、"
    },
    {
      "t": 514.56,
      "s": "落ち着いていく経過と重なりやすかった。"
    },
    {
      "t": 518.52,
      "s": "ただし、これは重なりやすいというだけです。"
    },
    {
      "t": 522.44,
      "s": "どちらがどちらを引き起こしているかは、"
    },
    {
      "t": 526,
      "s": "わかりません。"
    },
    {
      "t": 527.3,
      "s": "苦しいから外へ出るのか、"
    },
    {
      "t": 529.55,
      "s": "外へ出るから苦しいのか。"
    },
    {
      "t": 531.8,
      "s": "順番が決まっていないんです。"
    },
    {
      "t": 534.18,
      "s": "ですから、人を見分ける物差しには使えません。"
    },
    {
      "t": 537.92,
      "s": "もっと正直なところを言います。二〇二三年、"
    },
    {
      "t": 542.33,
      "s": "「デス・スタディーズ」という学術誌に、"
    },
    {
      "t": 546.33,
      "s": "大きな総説が出ました。"
    },
    {
      "t": 548.64,
      "s": "ヒューソンたちが、"
    },
    {
      "t": 550.4,
      "s": "七十九本の研究を集めて読み直したものです。"
    },
    {
      "t": 554.52,
      "s": "絆を保つのと手放すのと、"
    },
    {
      "t": 556.87,
      "s": "どちらが人を楽にするのか。"
    },
    {
      "t": 559.42,
      "s": "結論は、まだわからない、でした。"
    },
    {
      "t": 562.55,
      "s": "私は、"
    },
    {
      "t": 563.15,
      "s": "この「わからない」を隠さないでおきます。"
    },
    {
      "t": 567.13,
      "s": "わかったことにすると、"
    },
    {
      "t": 569.32,
      "s": "この話は急に、"
    },
    {
      "t": 570.71,
      "s": "何かを売る人の話に似てきますから。"
    },
    {
      "t": 574.1,
      "s": "私は仏壇のほうへ向き直りました。"
    },
    {
      "t": 577.1,
      "s": "そして、ようやく気がついたんです。"
    },
    {
      "t": 580.28,
      "s": "一九九六年の本が名前をつけたもの。それを、"
    },
    {
      "t": 584.97,
      "s": "この箱は、"
    },
    {
      "t": 586.09,
      "s": "ずっと前からやっていました。"
    },
    {
      "t": 589.22,
      "s": "仏壇が、"
    },
    {
      "t": 590.05,
      "s": "身分の高い家だけのものではなく、"
    },
    {
      "t": 593.37,
      "s": "ふつうの家に入ったのは、"
    },
    {
      "t": 595.86,
      "s": "江戸のころです。"
    },
    {
      "t": 597.52,
      "s": "きっかけは、信仰の高まりではありません。"
    },
    {
      "t": 601.85,
      "s": "寺請制度、"
    },
    {
      "t": 602.93,
      "s": "そして檀家制度という、"
    },
    {
      "t": 605.3,
      "s": "幕府の宗教統制です。"
    },
    {
      "t": 607.47,
      "s": "どの家もどこかの寺の檀家になること。"
    },
    {
      "t": 611.36,
      "s": "上から降りてきた決まりごとです。ですが、"
    },
    {
      "t": 615.43,
      "s": "その箱が、その後、"
    },
    {
      "t": 617.26,
      "s": "別の働きをしはじめました。"
    },
    {
      "t": 619.91,
      "s": "仏壇は、忘れなさいとは言いません。"
    },
    {
      "t": 622.93,
      "s": "思いつめていなさいとも言わない。"
    },
    {
      "t": 625.77,
      "s": "その絆に、置き場所を与えたんです。"
    },
    {
      "t": 629.24,
      "s": "座る場所と、"
    },
    {
      "t": 630.47,
      "s": "決まった時刻と、"
    },
    {
      "t": 632.1,
      "s": "手を動かす仕事を。"
    },
    {
      "t": 633.94,
      "s": "水を替える。火をつける。鈴を鳴らす。"
    },
    {
      "t": 638.59,
      "s": "声に出して話す。"
    },
    {
      "t": 640.66,
      "s": "全部、体を使う仕事です。"
    },
    {
      "t": 643.76,
      "s": "心に抱えたままだと、"
    },
    {
      "t": 645.75,
      "s": "それは一日じゅう出てきます。ですが、"
    },
    {
      "t": 649.34,
      "s": "置き場所があると、"
    },
    {
      "t": 651.14,
      "s": "そこへ持っていける。"
    },
    {
      "t": 653.14,
      "s": "一つだけ、気をつけたいことがあります。"
    },
    {
      "t": 656.73,
      "s": "だから日本のほうが進んでいた、"
    },
    {
      "t": 659.57,
      "s": "という話にはしたくないんです。"
    },
    {
      "t": 662.39,
      "s": "欧米にも、"
    },
    {
      "t": 663.44,
      "s": "亡くなった人に話しかける人は"
    },
    {
      "t": 666.36,
      "s": "いくらでもいます。"
    },
    {
      "t": 668.25,
      "s": "墓の前で、写真の前で、同じことをしています。"
    },
    {
      "t": 672.85,
      "s": "違ったのは、"
    },
    {
      "t": 673.99,
      "s": "そこに家具の形を"
    },
    {
      "t": 675.51,
      "s": "した置き場所があったかどうか。"
    },
    {
      "t": 678.37,
      "s": "二つの道が、別々に歩いて、同じところに出た。"
    },
    {
      "t": 682.56,
      "s": "そう思っています。"
    },
    {
      "t": 686.25,
      "s": "気がつくと、"
    },
    {
      "t": 687.45,
      "s": "障子がすっかり明るくなっていました。"
    },
    {
      "t": 691.06,
      "s": "畳の上を、桟の影が渡りきっています。"
    },
    {
      "t": 694.67,
      "s": "線香は短くなって、"
    },
    {
      "t": 696.41,
      "s": "湯呑みのお茶は冷めていました。"
    },
    {
      "t": 699.3,
      "s": "私はまだ、同じ場所に座っています。"
    },
    {
      "t": 702.57,
      "s": "開けた扉も、"
    },
    {
      "t": 703.83,
      "s": "立てた線香も、"
    },
    {
      "t": 705.31,
      "s": "朝と変わっていません。"
    },
    {
      "t": 707.63,
      "s": "変わったのは、"
    },
    {
      "t": 709.1,
      "s": "自分が何をしているのかを、"
    },
    {
      "t": 711.84,
      "s": "私が知っている、"
    },
    {
      "t": 713.52,
      "s": "というところだけです。"
    },
    {
      "t": 715.85,
      "s": "私は、"
    },
    {
      "t": 716.34,
      "s": "あの人が聞いていると"
    },
    {
      "t": 717.97,
      "s": "申し上げるつもりはありません。"
    },
    {
      "t": 720.41,
      "s": "それは、わからないことです。"
    },
    {
      "t": 722.69,
      "s": "わからないことを、"
    },
    {
      "t": 724.16,
      "s": "わかったようには言いません。"
    },
    {
      "t": 726.44,
      "s": "ですが、わかっていることが二つあります。"
    },
    {
      "t": 730.68,
      "s": "一つ目は、私の頭が、"
    },
    {
      "t": 732.81,
      "s": "そういうふうに作られていること。"
    },
    {
      "t": 736.2,
      "s": "何も感じていない状態だけは、"
    },
    {
      "t": 739.1,
      "s": "どうしても思い描けない。"
    },
    {
      "t": 741.58,
      "s": "これは私の弱さではなくて、人間の頭の、"
    },
    {
      "t": 745.51,
      "s": "もともとの形です。"
    },
    {
      "t": 747.37,
      "s": "二つ目は、こうです。"
    },
    {
      "t": 749.45,
      "s": "この話しかける時間が、"
    },
    {
      "t": 751.74,
      "s": "たしかに何かを変えている。"
    },
    {
      "t": 754.44,
      "s": "変わっているのは、"
    },
    {
      "t": 756.31,
      "s": "あちら側ではなくて、"
    },
    {
      "t": 758.39,
      "s": "こちら側なんです。"
    },
    {
      "t": 760.26,
      "s": "声に出したあとのほうが、"
    },
    {
      "t": 762.75,
      "s": "少しだけ息がしやすい。"
    },
    {
      "t": 765.03,
      "s": "その日の段取りも、つけやすい。"
    },
    {
      "t": 768.14,
      "s": "私自身に起きていることです。"
    },
    {
      "t": 771.04,
      "s": "そして、この箱は、"
    },
    {
      "t": 772.69,
      "s": "そのために置かれていました。"
    },
    {
      "t": 775.27,
      "s": "名前をつけた人より、"
    },
    {
      "t": 777.11,
      "s": "ずっと前から、"
    },
    {
      "t": 778.39,
      "s": "ここにあったんです。"
    },
    {
      "t": 780.22,
      "s": "一つだけ、付け加えておきます。"
    },
    {
      "t": 783.48,
      "s": "仏壇には、終わりの日がありません。"
    },
    {
      "t": 787.18,
      "s": "法事には日付があります。"
    },
    {
      "t": 789.93,
      "s": "済めば、次まで間が空きます。"
    },
    {
      "t": 793.13,
      "s": "ですが仏壇は、明日の朝もそこにあります。"
    },
    {
      "t": 797.71,
      "s": "その次の朝も、そこにあります。"
    },
    {
      "t": 801.15,
      "s": "終わりの日がないというのは、"
    },
    {
      "t": 803.49,
      "s": "この箱の欠けたところではなくて、"
    },
    {
      "t": 806.17,
      "s": "この箱がしている仕事そのものなんですね。"
    },
    {
      "t": 809.51,
      "s": "悲しみを済ませる道具ではなく、"
    },
    {
      "t": 812.14,
      "s": "続いていくものと一緒に暮らすための場所。"
    },
    {
      "t": 815.66,
      "s": "そういうことだったんだと思います。"
    },
    {
      "t": 818.63,
      "s": "あの朝、廊下で足音が止まったこと。"
    },
    {
      "t": 821.92,
      "s": "あれはたぶん、"
    },
    {
      "t": 823.28,
      "s": "笑われていたのでも、"
    },
    {
      "t": 825.22,
      "s": "心配されていたのでもありません。"
    },
    {
      "t": 828.33,
      "s": "どう声をかけたらいいか、"
    },
    {
      "t": 830.77,
      "s": "わからなかっただけなんでしょう。"
    },
    {
      "t": 834.03,
      "s": "今の私になら、答えられます。"
    },
    {
      "t": 836.87,
      "s": "変ではありません。"
    },
    {
      "t": 838.66,
      "s": "三百年ほど前から、"
    },
    {
      "t": 840.44,
      "s": "この国の数え切れない家の朝に、"
    },
    {
      "t": 843.42,
      "s": "同じことが起きていました。"
    },
    {
      "t": 846,
      "s": "そして、"
    },
    {
      "t": 846.78,
      "s": "それを説明する言葉のほうが、"
    },
    {
      "t": 849.51,
      "s": "二十世紀の終わりに、"
    },
    {
      "t": 851.46,
      "s": "ようやく追いついてきた。"
    },
    {
      "t": 853.8,
      "s": "それだけの話なんです。"
    },
    {
      "t": 855.95,
      "s": "私は冷めたお茶を飲みほして、"
    },
    {
      "t": 858.72,
      "s": "立ち上がりました。"
    },
    {
      "t": 860.51,
      "s": "扉は開けたままにしておきます。"
    },
    {
      "t": 863.48,
      "s": "明日の朝も、また話しかけるつもりです。"
    }
  ]
}