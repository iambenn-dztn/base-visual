{
  "total": 827.92,
  "count": 302,
  "cues": [
    {
      "t": 0,
      "s": "台風が来る前の日の、午後二時でした。"
    },
    {
      "t": 4.01,
      "s": "私は庭で、"
    },
    {
      "t": 5.12,
      "s": "植木鉢を家の中に入れようとしていました。"
    },
    {
      "t": 9.57,
      "s": "大きな素焼きの鉢が、三つあります。"
    },
    {
      "t": 13.25,
      "s": "一つ目は、なんとか運べました。"
    },
    {
      "t": 16.49,
      "s": "二つ目を持ち上げたところで、腰の奥に、"
    },
    {
      "t": 20.6,
      "s": "ぴりっとしたものが走りました。"
    },
    {
      "t": 23.84,
      "s": "縁側に腰をおろして、携帯電話を出しました。"
    },
    {
      "t": 28.28,
      "s": "車で三十分ほどのところに、"
    },
    {
      "t": 31.03,
      "s": "息子が住んでいます。"
    },
    {
      "t": 33.15,
      "s": "明日の朝、少しだけ手を貸してもらえないか。"
    },
    {
      "t": 37.17,
      "s": "鉢を中に入れたいんだ。"
    },
    {
      "t": 39.27,
      "s": "そこまで打って、指が止まりました。"
    },
    {
      "t": 42.52,
      "s": "読み返しているうちに、頭の中で、"
    },
    {
      "t": 45.54,
      "s": "別の場面が始まっていたんです。"
    },
    {
      "t": 48.38,
      "s": "息子が、仕事の合間に画面を見る。"
    },
    {
      "t": 52.31,
      "s": "小さくため息をつく。"
    },
    {
      "t": 54.76,
      "s": "休みの日の予定を、頭の中で組み直している。"
    },
    {
      "t": 59.91,
      "s": "その場面は、なぜか薄暗いんです。"
    },
    {
      "t": 63.59,
      "s": "天井が低くて、廊下が、"
    },
    {
      "t": 66.13,
      "s": "奥へ行くほど細くなっていく。"
    },
    {
      "t": 69.35,
      "s": "突き当たりには、"
    },
    {
      "t": 70.83,
      "s": "すりガラスのような壁が一枚あります。"
    },
    {
      "t": 74.16,
      "s": "その向こうに、"
    },
    {
      "t": 75.46,
      "s": "困った顔の息子が、"
    },
    {
      "t": 77.12,
      "s": "ぼんやりと見えている。"
    },
    {
      "t": 79.16,
      "s": "そこまで思い浮かべたところで、私は、"
    },
    {
      "t": 82.36,
      "s": "打った文字を、"
    },
    {
      "t": 83.61,
      "s": "一つずつ消していきました。"
    },
    {
      "t": 85.92,
      "s": "二つ目の鉢は、"
    },
    {
      "t": 87.33,
      "s": "腰をかばいながら、"
    },
    {
      "t": 89.15,
      "s": "一人で引きずるようにして運びました。"
    },
    {
      "t": 92.78,
      "s": "三つ目は、動かせないまま、庭に残しました。"
    },
    {
      "t": 97.01,
      "s": "夕方、雨戸を閉めながら、ふと思いました。"
    },
    {
      "t": 101.19,
      "s": "鉢を一つ運ぶのを、手伝ってほしい。"
    },
    {
      "t": 104.74,
      "s": "ただ、それだけのことです。"
    },
    {
      "t": 107.46,
      "s": "なぜ、"
    },
    {
      "t": 108.01,
      "s": "人に頼むのは、"
    },
    {
      "t": 109.29,
      "s": "これほど難しいんでしょうか。"
    },
    {
      "t": 111.86,
      "s": "実は、"
    },
    {
      "t": 112.56,
      "s": "この難しさを、"
    },
    {
      "t": 114.21,
      "s": "正面から測った人たちがいます。"
    },
    {
      "t": 117.73,
      "s": "気持ちの問題としてではなく、数字として、"
    },
    {
      "t": 122.43,
      "s": "です。"
    },
    {
      "t": 123.13,
      "s": "今日は、その話をします。"
    },
    {
      "t": 127.43,
      "s": "その夜、一つ試してみたことがあります。"
    },
    {
      "t": 131.63,
      "s": "立場を、入れ替えてみたんです。"
    },
    {
      "t": 134.95,
      "s": "もし息子のほうから、同じことを頼まれたら。"
    },
    {
      "t": 138.87,
      "s": "父さん、明日、ちょっと手を貸してくれないか。"
    },
    {
      "t": 142.97,
      "s": "私は、断るでしょうか。"
    },
    {
      "t": 145.03,
      "s": "実を言うと、考えるまでもありませんでした。"
    },
    {
      "t": 149.16,
      "s": "行きます。"
    },
    {
      "t": 150.15,
      "s": "何時に行けばいい、と聞き返すと思います。"
    },
    {
      "t": 154.07,
      "s": "では、なぜ息子のほうは違うと思ったのか。"
    },
    {
      "t": 157.98,
      "s": "自分なら引き受けることを、"
    },
    {
      "t": 160.53,
      "s": "相手は嫌がるはずだと、"
    },
    {
      "t": 162.68,
      "s": "私はどこで決めたんでしょう。"
    },
    {
      "t": 165.42,
      "s": "このことを、実験で確かめた人たちがいます。"
    },
    {
      "t": 169.55,
      "s": "アメリカの心理学者、"
    },
    {
      "t": 171.52,
      "s": "フランシス・フリンさんと、"
    },
    {
      "t": 174.08,
      "s": "バネッサ・ボーンズさんです。"
    },
    {
      "t": 176.83,
      "s": "二千八年に、"
    },
    {
      "t": 177.97,
      "s": "社会心理学の専門誌に出た論文です。"
    },
    {
      "t": 181.2,
      "s": "題名をそのまま訳すと、"
    },
    {
      "t": 183.3,
      "s": "助けが要るなら、"
    },
    {
      "t": 184.82,
      "s": "とにかく頼んでみなさい、となります。"
    },
    {
      "t": 188.24,
      "s": "やり方は、とても単純でした。大学生に、"
    },
    {
      "t": 191.78,
      "s": "キャンパスを歩いている見知らぬ人へ、"
    },
    {
      "t": 195.13,
      "s": "頼みごとをしてもらうんです。"
    },
    {
      "t": 197.74,
      "s": "アンケートに答えてもらう。"
    },
    {
      "t": 200.49,
      "s": "携帯電話を少し貸してもらう。"
    },
    {
      "t": 203.45,
      "s": "体育館まで、一緒に歩いて案内してもらう。"
    },
    {
      "t": 207.68,
      "s": "ただし、"
    },
    {
      "t": 208.46,
      "s": "頼みに行く前に、"
    },
    {
      "t": 210.02,
      "s": "一つだけ予想を書いてもらいます。"
    },
    {
      "t": 213.13,
      "s": "何人に声をかければ、"
    },
    {
      "t": 215.08,
      "s": "引き受けてくれる人が集まるか。"
    },
    {
      "t": 218,
      "s": "たとえば、携帯電話の実験です。"
    },
    {
      "t": 221.17,
      "s": "三人に貸してもらうまでに、"
    },
    {
      "t": 223.92,
      "s": "十人ほどには声をかけることになるだろう。"
    },
    {
      "t": 228.15,
      "s": "多くの人が、そう予想しました。"
    },
    {
      "t": 231.32,
      "s": "実際に歩いてみると、六人ほどで足りたんです。"
    },
    {
      "t": 236.73,
      "s": "予想の、六割ほどの人数です。"
    },
    {
      "t": 240.18,
      "s": "アンケートでも、道案内でも、"
    },
    {
      "t": 242.85,
      "s": "同じ向きのずれが出ました。"
    },
    {
      "t": 245.33,
      "s": "引き受けてくれる見込みを、"
    },
    {
      "t": 247.8,
      "s": "みんな低く見積もっていた。論文には、"
    },
    {
      "t": 251.23,
      "s": "そのずれが最大で"
    },
    {
      "t": 252.76,
      "s": "五十パーセントほどにのぼった、"
    },
    {
      "t": 255.62,
      "s": "と書かれています。"
    },
    {
      "t": 257.33,
      "s": "ボーンズさんは、"
    },
    {
      "t": 258.92,
      "s": "その後も十年ほど、"
    },
    {
      "t": 260.71,
      "s": "この種の実験を続けました。"
    },
    {
      "t": 263.29,
      "s": "声をかけた見知らぬ人は、"
    },
    {
      "t": 265.67,
      "s": "合わせて一万四千人を超えるそうです。"
    },
    {
      "t": 269.25,
      "s": "それでも、ずれは消えませんでした。"
    },
    {
      "t": 272.74,
      "s": "まとめると、平均でおよそ四十八パーセント。"
    },
    {
      "t": 277.06,
      "s": "ほぼ半分を、見誤っていたことになります。"
    },
    {
      "t": 281.16,
      "s": "正直に言うと、"
    },
    {
      "t": 282.53,
      "s": "この数字を読んだとき、"
    },
    {
      "t": 284.68,
      "s": "私は少し笑ってしまいました。"
    },
    {
      "t": 287.42,
      "s": "縁側で打った文字を消した、"
    },
    {
      "t": 289.96,
      "s": "あの指のことを思い出したからです。"
    },
    {
      "t": 293.28,
      "s": "では、なぜ、そこまで見誤るのか。"
    },
    {
      "t": 296.85,
      "s": "同じ論文の最後の実験が、"
    },
    {
      "t": 299.53,
      "s": "その理由を調べています。"
    },
    {
      "t": 302.21,
      "s": "頼む側の人は、相手が、はい、"
    },
    {
      "t": 305.35,
      "s": "と言ったあとの手間を数えていました。"
    },
    {
      "t": 309.39,
      "s": "時間を取られる。"
    },
    {
      "t": 311.19,
      "s": "休みがつぶれる。"
    },
    {
      "t": 312.98,
      "s": "ところが、"
    },
    {
      "t": 313.99,
      "s": "頼まれた側の人が頭の中で重く見ていたのは、"
    },
    {
      "t": 318.26,
      "s": "別のものだったんです。"
    },
    {
      "t": 320.49,
      "s": "いいえ、と言うときの、気まずさです。"
    },
    {
      "t": 324.14,
      "s": "目の前の人の頼みを断る。"
    },
    {
      "t": 326.85,
      "s": "相手をがっかりさせる。"
    },
    {
      "t": 329.33,
      "s": "冷たい人だと思われるかもしれない。"
    },
    {
      "t": 333.16,
      "s": "これが、案外重いんです。"
    },
    {
      "t": 335.87,
      "s": "つまり、"
    },
    {
      "t": 336.66,
      "s": "頼む側と頼まれる側は、"
    },
    {
      "t": 338.84,
      "s": "同じ一つの頼みごとについて、"
    },
    {
      "t": 341.61,
      "s": "別々の計算をしていたということです。"
    },
    {
      "t": 345.17,
      "s": "頼む側は、"
    },
    {
      "t": 346.28,
      "s": "引き受ける重さだけを、"
    },
    {
      "t": 348.73,
      "s": "秤に載せている。"
    },
    {
      "t": 350.51,
      "s": "頼まれる側は、断る重さも、"
    },
    {
      "t": 353.4,
      "s": "同じ秤に載せている。"
    },
    {
      "t": 355.63,
      "s": "この説明は、私にはすっと腑に落ちました。"
    },
    {
      "t": 359.74,
      "s": "縁側の私が量っていたのも、"
    },
    {
      "t": 362.41,
      "s": "息子の手間だけでした。"
    },
    {
      "t": 364.66,
      "s": "息子の秤に、もう一つ何が載っているのか。"
    },
    {
      "t": 368.77,
      "s": "考えてもいなかったんです。"
    },
    {
      "t": 372.92,
      "s": "ただ、ここで私は、一つ引っかかりました。"
    },
    {
      "t": 377.32,
      "s": "断るのが気まずいから、引き受ける。それなら、"
    },
    {
      "t": 381.11,
      "s": "なんというか、息子は結局、"
    },
    {
      "t": 383.35,
      "s": "しかたなく来るということにならないか。"
    },
    {
      "t": 386.62,
      "s": "はい、が増えるのはわかりました。"
    },
    {
      "t": 389.9,
      "s": "ですが、その中身が我慢なのだとしたら。"
    },
    {
      "t": 393.8,
      "s": "それは、あまりうれしい話ではありません。"
    },
    {
      "t": 397.9,
      "s": "この疑問に、まっすぐ答えた研究があります。"
    },
    {
      "t": 401.56,
      "s": "アメリカの心理学者、"
    },
    {
      "t": 403.31,
      "s": "ニコラス・エプリーさんと、"
    },
    {
      "t": 405.57,
      "s": "シュアン・ジャオさんです。"
    },
    {
      "t": 407.85,
      "s": "二千二十二年に、"
    },
    {
      "t": 409.4,
      "s": "サイコロジカル・サイエンスと"
    },
    {
      "t": 412.1,
      "s": "いう学術誌に出ました。"
    },
    {
      "t": 414.23,
      "s": "題名を訳すと、"
    },
    {
      "t": 415.59,
      "s": "助けてみたら、"
    },
    {
      "t": 416.94,
      "s": "思いのほかうれしかった。"
    },
    {
      "t": 419.26,
      "s": "六つの実験に、"
    },
    {
      "t": 420.79,
      "s": "合わせて二千百十八人が参加しています。"
    },
    {
      "t": 424.93,
      "s": "一つ目の実験の舞台は、公園でした。"
    },
    {
      "t": 428.16,
      "s": "来ていた人たちにインスタントカメラを渡して、"
    },
    {
      "t": 432.33,
      "s": "こう頼みます。"
    },
    {
      "t": 433.65,
      "s": "誰か知らない人に声をかけて、"
    },
    {
      "t": 436.4,
      "s": "あなたの写真を一枚、"
    },
    {
      "t": 438.36,
      "s": "撮ってもらってください。"
    },
    {
      "t": 440.73,
      "s": "集まったのは五十人です。"
    },
    {
      "t": 443.25,
      "s": "そのうち四十七人は、"
    },
    {
      "t": 445.35,
      "s": "最初に声をかけた人が、"
    },
    {
      "t": 447.65,
      "s": "そのまま引き受けてくれました。"
    },
    {
      "t": 450.8,
      "s": "残りの三人も、"
    },
    {
      "t": 452.13,
      "s": "二人目で引き受けてもらえています。"
    },
    {
      "t": 455.36,
      "s": "断られたまま終わった人は、"
    },
    {
      "t": 457.83,
      "s": "一人もいなかったんです。"
    },
    {
      "t": 460.11,
      "s": "研究チームは、"
    },
    {
      "t": 461.52,
      "s": "頼む前の人に、"
    },
    {
      "t": 462.94,
      "s": "相手がどう感じると思うかを尋ねていました。"
    },
    {
      "t": 467.17,
      "s": "そして、"
    },
    {
      "t": 467.98,
      "s": "写真を撮った側の人にも、"
    },
    {
      "t": 470.4,
      "s": "あとから尋ねました。"
    },
    {
      "t": 472.41,
      "s": "二つの答えは、三つの点で、"
    },
    {
      "t": 475.19,
      "s": "きれいにずれていました。"
    },
    {
      "t": 477.76,
      "s": "頼む側は、"
    },
    {
      "t": 478.67,
      "s": "相手が引き受けたいと思う気持ちを、"
    },
    {
      "t": 481.77,
      "s": "低く見ていた。"
    },
    {
      "t": 483.05,
      "s": "手伝ったあとの相手の気分がどれだけいいかも、"
    },
    {
      "t": 487.06,
      "s": "低く見ていた。"
    },
    {
      "t": 488.35,
      "s": "そして、"
    },
    {
      "t": 489.09,
      "s": "相手がどれだけ迷惑に感じるかは、"
    },
    {
      "t": 492.07,
      "s": "高く見ていました。"
    },
    {
      "t": 493.75,
      "s": "三つとも、頼むのをためらわせる向きです。"
    },
    {
      "t": 497.46,
      "s": "公園だけではありません。実験室で、"
    },
    {
      "t": 500.63,
      "s": "作業を多く抱えた人と、"
    },
    {
      "t": 502.69,
      "s": "手の空いている人を組ませたときにも、"
    },
    {
      "t": 506.05,
      "s": "同じずれが出ています。"
    },
    {
      "t": 508.1,
      "s": "では、頼む側は何を見誤っていたのか。"
    },
    {
      "t": 511.48,
      "s": "エプリーさんたちの答えは、こうでした。"
    },
    {
      "t": 515.05,
      "s": "頼む側は、"
    },
    {
      "t": 515.99,
      "s": "相手が引き受ける理由を、"
    },
    {
      "t": 518.25,
      "s": "断れないからだと考えている。"
    },
    {
      "t": 520.89,
      "s": "しかたなく、というわけです。"
    },
    {
      "t": 523.53,
      "s": "ところが、"
    },
    {
      "t": 524.43,
      "s": "頼まれた側の中で大きく動いていたのは、"
    },
    {
      "t": 527.84,
      "s": "助けたい、"
    },
    {
      "t": 528.74,
      "s": "という気持ちのほうだったんです。"
    },
    {
      "t": 531.62,
      "s": "エプリーさんは、こう説明しています。"
    },
    {
      "t": 535.08,
      "s": "頼まれた人は、手間のことも考える。"
    },
    {
      "t": 538.35,
      "s": "けれど同時に、"
    },
    {
      "t": 539.69,
      "s": "自分は助けになれる人だと見込まれた、"
    },
    {
      "t": 543.15,
      "s": "とも感じている。"
    },
    {
      "t": 544.69,
      "s": "私は、ここでしばらく読む手が止まりました。"
    },
    {
      "t": 548.63,
      "s": "頼むというのは、"
    },
    {
      "t": 550.13,
      "s": "相手の時間をもらうことだと、"
    },
    {
      "t": 552.76,
      "s": "ずっと思っていました。"
    },
    {
      "t": 554.83,
      "s": "それは、間違いではありません。"
    },
    {
      "t": 557.74,
      "s": "ですが、半分だけでした。"
    },
    {
      "t": 560.06,
