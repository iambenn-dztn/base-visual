{
  "slug": "hitori-no-naka",
  "fps": 30,
  "totalDuration": 846.57,
  "dryRun": true,
  "narration": null,
  "lang": "ja",
  "voice": {
    "provider": "gpt-sovits-local",
    "voice_name": "keita",
