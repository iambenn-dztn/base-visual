    {
      "t": 790.92,
      "s": "別の物差しの上に載っているからなんです。"
    },
    {
      "t": 796.32,
      "s": "大事な人たちのまん中で"
    },
    {
      "t": 798.08,
      "s": "寂しさを感じたとしても、それは、"
