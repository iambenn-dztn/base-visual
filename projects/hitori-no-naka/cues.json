{
  "total": 811.41,
  "count": 309,
  "cues": [
    {
      "t": 0,
      "s": "夜の十一時でした。"
    },
    {
      "t": 1.9,
      "s": "お盆が終わって、"
    },
    {
      "t": 3.58,
      "s": "子どもも孫も、"
    },
    {
      "t": 5.06,
      "s": "夕方には帰っていったあとのことです。"
    },
    {
      "t": 8.85,
      "s": "三日のあいだ、この部屋はずっと賑やかでした。"
    },
    {
      "t": 13.39,
      "s": "孫が畳の上で寝てしまって、"
    },
    {
      "t": 16.08,
      "s": "誰かが座布団を枕にしてやっていました。"
    },
    {
      "t": 19.99,
      "s": "その三日が終わって、"
    },
    {
      "t": 21.81,
      "s": "玄関で手を振って、"
    },
    {
      "t": 23.45,
      "s": "車が角を曲がるまで見ていました。"
    },
    {
      "t": 26.37,
      "s": "それから、家の中に戻ったんです。"
    },
    {
      "t": 29.29,
      "s": "茶碗を洗って、"
    },
    {
      "t": 30.84,
      "s": "湯のみを片づけて、"
    },
    {
      "t": 32.83,
      "s": "座布団を畳んでいきました。一枚、二枚。"
    },
    {
      "t": 37.03,
      "s": "手はもう勝手に動いています。"
    },
    {
      "t": 40.11,
      "s": "五枚目を畳んでいたときです。"
    },
    {
      "t": 42.77,
      "s": "何の前ぶれもなく、"
    },
    {
      "t": 44.48,
      "s": "胸のあたりに、"
    },
    {
      "t": 45.8,
      "s": "すうっと空いたところができました。"
    },
    {
      "t": 49.03,
      "s": "おかしな言い方になりますが、"
    },
    {
      "t": 51.12,
      "s": "その空いたところは、"
    },
    {
      "t": 52.61,
      "s": "はじめてそこにできたも"
    },
    {
      "t": 54.25,
      "s": "のではありませんでした。"
    },
    {
      "t": 56.03,
      "s": "みんながまだそこに座っていたとき。"
    },
    {
      "t": 59.4,
      "s": "笑い声のまん中にいたとき。"
    },
    {
      "t": 61.98,
      "s": "あのときにも、同じものが、"
    },
    {
      "t": 64.56,
      "s": "確かにあったんです。"
    },
    {
      "t": 66.54,
      "s": "そして、"
    },
    {
      "t": 67.33,
      "s": "そう気づいたすぐあとに、"
    },
    {
      "t": 69.69,
      "s": "もう一つの声がやってきました。"
    },
    {
      "t": 72.65,
      "s": "自分で自分に言う声です。"
    },
    {
      "t": 75.01,
      "s": "これだけ家族がいてくれるのに、"
    },
    {
      "t": 77.74,
      "s": "私は何を贅沢なことを思っているんだろう。"
    },
    {
      "t": 81.39,
      "s": "薄情な人間なんじゃないだろうか。"
    },
    {
      "t": 85.79,
      "s": "この声のことを、"
    },
    {
      "t": 87.17,
      "s": "私は長いあいだ、"
    },
    {
      "t": 88.54,
      "s": "誰にも言ったことがありませんでした。言えば、"
    },
    {
      "t": 92.32,
      "s": "きっと責められると思っていたからです。"
    },
    {
      "t": 95.59,
      "s": "ですが、"
    },
    {
      "t": 96.42,
      "s": "この十年ほどのあいだに、"
    },
    {
      "t": 98.9,
      "s": "この胸の空いたところを、"
    },
    {
      "t": 101.39,
      "s": "まっすぐ調べた人たちがいます。"
    },
    {
      "t": 104.49,
      "s": "今日は、その話をします。"
    },
    {
      "t": 106.98,
      "s": "まず、"
    },
    {
      "t": 107.45,
      "s": "おかしな点をはっきりさせておきたいんです。"
    },
    {
      "t": 110.77,
      "s": "人が多いほど寂しくないはずだ。"
    },
    {
      "t": 113.13,
      "s": "ふつうはそう考えます。"
    },
    {
      "t": 114.87,
      "s": "ところが、実際はそうなっていません。"
    },
    {
      "t": 118.02,
      "s": "人に囲まれた三日間のまん中で、"
    },
    {
      "t": 120.65,
      "s": "あの空いたところはちゃんとありました。"
    },
    {
      "t": 123.98,
      "s": "そのうえ、逆のことも起きます。"
    },
    {
      "t": 127.01,
      "s": "一日じゅう誰とも話さなかった日に、なぜか、"
    },
    {
      "t": 131.26,
      "s": "ひどく落ちついていることがある。"
    },
    {
      "t": 134.49,
      "s": "庭の草を抜いて、"
    },
    {
      "t": 136.28,
      "s": "お茶を飲んで、"
    },
    {
      "t": 137.84,
      "s": "それで一日が終わる。"
    },
    {
      "t": 140.08,
      "s": "人はいないのに、寂しくない。"
    },
    {
      "t": 143.2,
      "s": "こういう日が、確かにあるんです。"
    },
    {
      "t": 146.78,
      "s": "つまり、"
    },
    {
      "t": 147.51,
      "s": "「人がどれだけいるか」で"
    },
    {
      "t": 149.7,
      "s": "寂しさを説明しようとすると、片っぽうも、"
    },
    {
      "t": 153.35,
      "s": "もう片っぽうも、"
    },
    {
      "t": 154.81,
      "s": "合わなくなります。"
    },
    {
      "t": 156.45,
      "s": "ここで、"
    },
    {
      "t": 157.29,
      "s": "カナダで行われたある調査のこと"
    },
    {
      "t": 160.42,
      "s": "を思い出しました。"
    },
    {
      "t": 162.3,
      "s": "四十五歳から八十五歳まで、"
    },
    {
      "t": 165.02,
      "s": "三万七十九人を集めた調査です。"
    },
    {
      "t": 168.16,
      "s": "メネックさんたちの研究チームが、"
    },
    {
      "t": 170.99,
      "s": "二千二十年に『プロス・ワン』と"
    },
    {
      "t": 173.64,
      "s": "いう学術誌に出した報告です。"
    },
    {
      "t": 176.12,
      "s": "この調査が上手だったのは、"
    },
    {
      "t": 178.54,
      "s": "二つのことを、"
    },
    {
      "t": 179.84,
      "s": "わざわざ別々に尋ねたところなんです。"
    },
    {
      "t": 183.19,
      "s": "一つ目は、実際にどれくらい人と会っているか。"
    },
    {
      "t": 187.55,
      "s": "家族と話す回数、"
    },
    {
      "t": 189.14,
      "s": "近所づきあい、"
    },
    {
      "t": 190.53,
      "s": "何かの集まりに出ているかどうか。"
    },
    {
      "t": 193.7,
      "s": "これは外から数えられます。"
    },
    {
      "t": 196.58,
      "s": "会った人の数、出かけた回数。こちらを、"
    },
    {
      "t": 200.79,
      "s": "研究では社会的な孤立と呼んでいます。"
    },
    {
      "t": 204.77,
      "s": "二つ目は、まったく別のことです。"
    },
    {
      "t": 208.27,
      "s": "あなたは今、寂しいと感じていますか。"
    },
    {
      "t": 212.2,
      "s": "こちらは、本人にしか分かりません。"
    },
    {
      "t": 215.92,
      "s": "外から数える物差しと、"
    },
    {
      "t": 217.99,
      "s": "内側でしか測れない物差し。"
    },
    {
      "t": 220.43,
      "s": "この二つを、同じにせずに分けたんです。"
    },
    {
      "t": 224,
      "s": "そうやって三万人あまりを並べてみたら、"
    },
    {
      "t": 227.36,
      "s": "人は四つの欄に分かれました。"
    },
    {
      "t": 229.84,
      "s": "この四つが、今日いちばん大事なところです。"
    },
    {
      "t": 233.55,
      "s": "いちばん多かったのは、"
    },
    {
      "t": 235.71,
      "s": "孤立してもいないし、"
    },
    {
      "t": 237.67,
      "s": "寂しくもない人。"
    },
    {
      "t": 239.23,
      "s": "七十四・七パーセント。"
    },
    {
      "t": 241.39,
      "s": "四人のうち三人です。"
    },
    {
      "t": 243.35,
      "s": "次が、十五・六パーセント。"
    },
    {
      "t": 246.02,
      "s": "この人たちは、"
    },
    {
      "t": 247.45,
      "s": "人づきあいの数でいえば少ないほうに入ります。"
    },
    {
      "t": 251.97,
      "s": "ですが、寂しいとは感じていない。"
    },
    {
      "t": 255.25,
      "s": "外から見れば、心配されるほうの側です。"
    },
    {
      "t": 258.95,
      "s": "訪ねてくる人も少ない。"
    },
    {
      "t": 261.09,
      "s": "それでも本人は、これでいい、と言っている。"
    },
    {
      "t": 265.18,
      "s": "そしてその次が、六・七パーセントです。"
    },
    {
      "t": 269.45,
      "s": "人づきあいの数は足りている。"
    },
    {
      "t": 272.59,
      "s": "数えれば、まわりに人はいる。"
    },
    {
      "t": 275.73,
      "s": "それなのに、寂しい。"
    },
    {
      "t": 277.98,
      "s": "最後の三・〇パーセントが、その両方。"
    },
    {
      "t": 281.73,
      "s": "孤立していて、寂しくもある人たちです。"
    },
    {
      "t": 285.68,
      "s": "二番目と三番目が、"
    },
    {
      "t": 287.5,
      "s": "ちょうど反対を向いています。"
    },
    {
      "t": 290.34,
      "s": "人は少ないのに寂しくない人と、"
    },
    {
      "t": 293.37,
      "s": "人はいるのに寂しい人。"
    },
    {
      "t": 295.6,
      "s": "合わせて二割を超えます。"
    },
    {
      "t": 299.2,
      "s": "私がしばらく動けなくなったのは、"
    },
    {
      "t": 302.71,
      "s": "三番目の欄でした。"
    },
    {
      "t": 304.68,
      "s": "六・七パーセント。"
    },
    {
      "t": 306.66,
      "s": "人がいるのに寂しい人。"
    },
    {
      "t": 309.07,
      "s": "あの晩、"
    },
    {
      "t": 309.8,
      "s": "五枚目の座布団のところで私がいた場所が、"
    },
    {
      "t": 313.45,
      "s": "報告書の中に、"
    },
    {
      "t": 314.72,
      "s": "ちゃんと欄として載っていたということです。"
    },
    {
      "t": 318.55,
      "s": "正直に言うと、私はそこで少しほっとしました。"
    },
    {
      "t": 323.15,
      "s": "名前がついていて、人数が数えてある。"
    },
    {
      "t": 326.91,
      "s": "それだけのことなんですが。"
    },
    {
      "t": 329.63,
      "s": "人といる量と、寂しさの量。この二つは、"
    },
    {
      "t": 333.65,
      "s": "もともと別々の物差しで測られて"
    },
    {
      "t": 336.83,
      "s": "いるということなんです。"
    },
    {
      "t": 339.37,
      "s": "では、"
    },
    {
      "t": 340,
      "s": "その内側の物差しのほうは、"
    },
    {
      "t": 342.74,
      "s": "いったい何を測っているのか。"
    },
    {
      "t": 345.69,
      "s": "ここからが、もう一段深いところです。"
    },
    {
      "t": 349.49,
      "s": "アメリカにカシオポという研究者がいました。"
    },
    {
      "t": 353.89,
      "s": "ジョン・カシオポ。"
    },
    {
      "t": 355.77,
      "s": "寂しさというものを、生涯かけて調べた人です。"
    },
    {
      "t": 360.37,
      "s": "この人の見方が、少し変わっていました。"
    },
    {
      "t": 363.81,
      "s": "寂しさを、性格の問題として見なかったんです。"
    },
    {
      "t": 367.79,
      "s": "信号として見ました。"
    },
    {
      "t": 369.61,
      "s": "たとえば、お腹がすく。喉が渇く。"
    },
    {
      "t": 373.28,
      "s": "指をぶつければ痛い。"
    },
    {
      "t": 375.57,
      "s": "どれも気持ちのいいものではありません。"
    },
    {
      "t": 379.92,
      "s": "ですが、"
    },
    {
      "t": 380.74,
      "s": "お腹がすくのは、"
    },
    {
      "t": 382.38,
      "s": "心が弱いからではありませんね。"
    },
    {
      "t": 385.46,
      "s": "そろそろ食べるころですよ、"
    },
    {
      "t": 388.13,
      "s": "と体が知らせているだけです。"
    },
    {
      "t": 391.01,
      "s": "痛みも同じで、あるから手を引っこめられる。"
    },
    {
      "t": 395.32,
      "s": "カシオポは、寂しさをその列に並べました。"
    },
    {
      "t": 399.91,
      "s": "飢えと、渇きと、痛みと、同じ列に。"
    },
    {
      "t": 403.82,
      "s": "三つではなく、四つ目として。"
    },
    {
      "t": 407.03,
      "s": "なぜそんな信号があるのか。遠い昔、"
    },
    {
      "t": 410.38,
      "s": "人が群れから離れることは、"
    },
    {
      "t": 412.94,
      "s": "そのまま命に関わったからだ、"
    },
    {
      "t": 415.7,
      "s": "という考え方です。"
    },
    {
      "t": 417.47,
      "s": "一人になった者に、"
    },
    {
      "t": 419.34,
      "s": "うずくような感じを起こさせて、"
    },
    {
      "t": 422.45,
      "s": "群れのほうへ引き戻す。"
    },
    {
      "t": 424.74,
      "s": "その役目を負った仕組みだ、と。"
    },
    {
      "t": 427.85,
      "s": "大事なのは、その信号が何によって鳴るかです。"
    },
    {
      "t": 432.08,
      "s": "人の数ではありません。"
    },
    {
      "t": 434.19,
      "s": "つながりが足りて"
    },
    {
      "t": 435.73,
      "s": "いるかどうかの感じのほうです。"
    },
    {
      "t": 438.61,
      "s": "この見方でいくと、話がひっくり返ります。"
    },
    {
      "t": 442.43,
      "s": "寂しさを感じる力があるということは、"
    },
    {
      "t": 445.87,
      "s": "人とつながる力が、"
    },
    {
      "t": 447.58,
      "s": "まだ生きているということになる。"
    },
    {
      "t": 450.64,
      "s": "壊れているから鳴るのではありません。"
    },
    {
      "t": 453.96,
      "s": "働いているから鳴るんです。"
    },
    {
      "t": 456.37,
      "s": "火災報知機と同じで、鳴らないほうが困る。"
    },
    {
      "t": 461.23,
      "s": "ただ、"
    },
    {
      "t": 461.82,
      "s": "この信号には、"
    },
    {
      "t": 463.2,
      "s": "少し厄介なところもあります。"
    },
    {
      "t": 465.95,
      "s": "ここも、隠さずに言っておきたいところです。"
    },
    {
      "t": 470.07,
      "s": "ホークリーさんとカシオポが、"
    },
    {
      "t": 472.44,
      "s": "二千十年に『行動医学年報』と"
    },
    {
      "t": 474.81,
      "s": "いう専門誌にまとめた総説があります。"
    },
    {
      "t": 477.85,
      "s": "そこに、こんなことが書かれています。"
    },
    {
      "t": 480.9,
      "s": "寂しさを感じているとき、人は、"
    },
    {
      "t": 483.67,
      "s": "まわりから拒まれる気配に、"
    },
    {
      "t": 486.06,
      "s": "ふだんより敏感になる。"
    },
    {
      "t": 488.09,
      "s": "これ自体は、身を守るための働きです。"
    },
    {
      "t": 491.76,
      "s": "もう一度突き放されたら、こたえます。"
    },
    {
      "t": 495.44,
      "s": "だから先に身構えておく。"
    },
    {
      "t": 497.9,
      "s": "困るのは、"
    },
    {
      "t": 498.84,
      "s": "この身構えが、"
    },
    {
      "t": 500.17,
      "s": "意識より下のところで、"
    },
    {
      "t": 502.24,
      "s": "自動で働いてしまうことなんです。"
    },
    {
      "t": 505.27,
      "s": "瞬きと同じで、"
    },
    {
      "t": 506.59,
      "s": "気づいたときには、"
    },
    {
      "t": 508.29,
      "s": "もう動いている。"
    },
    {
      "t": 509.8,
      "s": "だから、"
    },
    {
      "t": 510.57,
      "s": "あくびを一つ見て、"
    },
    {
      "t": 512.3,
      "s": "退屈させてしまったかと思う。"
    },
    {
      "t": 514.99,
      "s": "返事が短かっただけで、"
    },
    {
      "t": 517.1,
      "s": "冷たくされたように感じる。"
    },
    {
      "t": 519.6,
      "s": "相手は、ただ眠かっただけかもしれません。"
    },
    {
      "t": 523.71,
      "s": "ですが、"
    },
    {
      "t": 524.54,
      "s": "その場でそこまで考えられる人は、"
    },
    {
      "t": 527.83,
      "s": "そういません。"
    },
    {
      "t": 529.27,
      "s": "そして、ほんの少しだけ、自分から引きます。"
    },
    {
      "t": 534.06,
      "s": "ひとこと言うのをやめる。"
    },
    {
      "t": 536.8,
      "s": "誘いを一度だけ断る。"
    },
    {
      "t": 539.09,
      "s": "ごく小さな動きです。"
    },
    {
      "t": 541.37,
      "s": "すると相手も、深く誘わなくなる。"
    },
    {
      "t": 544.9,
      "s": "そうして、また同じところに戻ってくる。"
    },
    {
      "t": 549.09,
      "s": "この一周を、"
    },
    {
      "t": 550.42,
      "s": "研究では輪になった道にたとえています。"
    },
    {
      "t": 554.62,
      "s": "ここで一つ、"
    },
    {
      "t": 555.56,
      "s": "はっきりさせておきたいことがあります。"
    },
    {
      "t": 558.55,
      "s": "この輪は、"
    },
    {
      "t": 559.33,
      "s": "あなたがやっている失敗ではありません。"
    },
    {
      "t": 562.32,
      "s": "誰にでも起こりうることなんです。"
    },
    {
      "t": 565.49,
      "s": "身を守る仕組みが、"
    },
    {
      "t": 567.28,
      "s": "少しだけ熱心に働きすぎている。"
    },
    {
      "t": 570.25,
      "s": "それだけのことなんです。"
    },
    {
      "t": 572.63,
      "s": "あなたが引いたのではなくて、"
    },
    {
      "t": 575.04,
      "s": "引かせる仕組みのほうが、"
    },
    {
      "t": 577.11,
      "s": "先に動いていた。"
    },
    {
      "t": 578.49,
      "s": "しかもそれは、"
    },
    {
      "t": 579.69,
      "s": "あなたを守るために働いていました。"
    },
    {
      "t": 582.62,
      "s": "自分を責めていた人が、"
    },
    {
      "t": 584.59,
      "s": "これを聞いて、"
    },
    {
      "t": 585.85,
      "s": "もう一つ責める種を増やしてしまうなら、"
    },
    {
      "t": 589.26,
      "s": "私はこの話をしないほうが"
    },
    {
      "t": 591.41,
      "s": "ましだと思っています。"
    },
    {
      "t": 594.86,
      "s": "そのうえで、"
    },
    {
      "t": 595.84,
      "s": "この話のどこまでが分かっていて、"
    },
    {
      "t": 598.46,
      "s": "どこからが分かっていないのかを申し上げます。"
    },
    {
      "t": 602.05,
      "s": "まず、"
    },
    {
      "t": 602.66,
      "s": "今の輪の話は、"
    },
    {
      "t": 604.07,
      "s": "多くの人を見たときの傾向です。"
    },
    {
      "t": 607.1,
      "s": "一人ひとりの運命ではありません。"
    },
    {
      "t": 610.33,
      "s": "その中に入って、"
    },
    {
      "t": 611.95,
      "s": "また出ていった人は大勢います。"
    },
    {
      "t": 614.98,
      "s": "輪と申し上げましたが、"
    },
    {
      "t": 617.2,
      "s": "閉じきった輪ではありません。"
    },
    {
      "t": 620.02,
      "s": "どの人の道にも、"
    },
    {
      "t": 621.63,
      "s": "脇へ抜ける枝道がついています。"
    },
    {
      "t": 624.65,
      "s": "次に、"
    },
    {
      "t": 625.2,
      "s": "四つの欄の調査は、"
    },
    {
      "t": 626.85,
      "s": "カナダで行われたものです。"
    },
    {
      "t": 629.23,
      "s": "日本の数字ではありません。"
    },
    {
      "t": 631.61,
      "s": "そのまま持ってくることはできません。"
    },
    {
      "t": 634.9,
      "s": "それから、あの調査は、"
    },
    {
      "t": 637.12,
      "s": "ある一時点で全員に尋ねたものです。"
    },
    {
      "t": 640.55,
      "s": "同じ人を何年も追いかけて、"
    },
    {
      "t": 643.17,
      "s": "変わっていく様子を見たものではない。"
    },
    {
      "t": 646.8,
      "s": "そして、いちばん正直なところを言います。"
    },
    {
      "t": 650.83,
      "s": "どうすればこの感じが必ず消えるのか。"
    },
    {
      "t": 654.46,
      "s": "そこまでは、まだ分かっていません。"
    },
    {
      "t": 657.88,
      "s": "分かっているのは、"
