    {
      "t": 669.34,
      "s": "一つだけ添えておきます。"
    },
    {
      "t": 671.42,
      "s": "この感じが長く続いて、"
    },
    {
      "t": 673.32,
      "s": "眠りや食事にまで届いているようなら、"
    },
    {
      "t": 676.43,
      "s": "それはお医者さんに話していいことです。"
    },
    {
      "t": 679.72,
      "s": "一人で抱える決まりは、どこにもありません。"
    },
    {
      "t": 683.35,
      "s": "あの晩の和室に、戻ってきました。畳の上に、"
    },
    {
      "t": 687.86,
      "s": "五枚目の座布団が、"
    },
    {
      "t": 689.8,
      "s": "まだ畳まれずに置いてあります。"
    },
    {
      "t": 693.02,
      "s": "今度は、すぐには畳みませんでした。"
    },
    {
      "t": 696.21,
      "s": "少しのあいだ、そこに座っていました。"
    },
    {
      "t": 699.58,
      "s": "胸の空いたところは、まだあります。"
    },
    {
      "t": 702.9,
      "s": "消えてはいません。"
    },
    {
      "t": 704.66,
      "s": "消えます、とは言えません。"
    },
    {
      "t": 707.21,
      "s": "そこは、正直に申し上げておきます。"
    },
    {
      "t": 710.53,
      "s": "ですが、"
    },
    {
      "t": 711.28,
      "s": "あの晩と違っていることが、"
    },
    {
      "t": 713.73,
      "s": "三つありました。"
    },
    {
      "t": 715.23,
      "s": "一つ。"
    },
    {
      "t": 715.83,
      "s": "この空いたところには、"
    },
    {
      "t": 718.01,
      "s": "名前がついていて、"
    },
    {
      "t": 719.8,
      "s": "数えた人がいて、"
    },
    {
      "t": 721.39,
      "s": "報告書の中に欄があります。"
    },
    {
      "t": 723.98,
      "s": "私がはじめてではなかった。"
    },
    {
      "t": 726.57,
      "s": "あの晩、"
    },
    {
      "t": 727.33,
      "s": "これを言ったら責められると思っていました。"
    },
    {
      "t": 731.31,
      "s": "ですが、"
    },
    {
      "t": 732.07,
      "s": "責められるどころか、"
    },
    {
      "t": 733.96,
      "s": "数えられていたんです。"
    },
    {
      "t": 736.05,
      "s": "二つ。これは、"
    },
    {
      "t": 737.47,
      "s": "壊れたところから出て"
    },
    {
      "t": 739.51,
      "s": "いる音ではありませんでした。"
    },
    {
      "t": 742.35,
      "s": "まだ働いているところから出ている音でした。"
    },
    {
      "t": 746.62,
      "s": "鳴っているのは、つながりたいという側です。"
    },
    {
      "t": 750.51,
      "s": "どうでもよくなった人の胸には、"
    },
    {
      "t": 753.3,
      "s": "この音は立ちません。"
    },
    {
      "t": 755.15,
      "s": "三つ。"
    },
    {
      "t": 755.76,
      "s": "そしてこれが、私にはいちばん効きました。"
    },
    {
      "t": 759.86,
      "s": "この空いたところは、"
    },
    {
      "t": 761.91,
      "s": "あの三日間と、"
    },
    {
      "t": 763.34,
      "s": "何も矛盾していなかったんです。"
    },
    {
      "t": 766.41,
      "s": "孫が畳で寝てしまったこと。"
    },
    {
      "t": 769.41,
      "s": "みんなで笑ったこと。"
    },
    {
      "t": 771.72,
      "s": "玄関で手を振ったこと。"
    },
    {
      "t": 774.26,
      "s": "あれは全部、本当のことです。"
    },
    {
      "t": 777.49,
      "s": "そして、"
    },
    {
      "t": 778.23,
      "s": "そのまん中に空いたところがあったことも、"
