{
  "total": 815.59,
  "count": 286,
  "cues": [
    {
      "t": 0,
      "s": "月曜日の朝でした。"
    },
    {
      "t": 2.12,
      "s": "定年を迎えて、最初の月曜日です。"
    },
    {
      "t": 5.88,
      "s": "目覚ましは、かけていませんでした。"
    },
    {
      "t": 8.97,
      "s": "それなのに私は、"
    },
    {
      "t": 10.42,
      "s": "六時半ちょうどに目を覚ましました。"
    },
    {
      "t": 13.51,
      "s": "四十年、そうしてきたからです。"
    },
    {
      "t": 16.24,
      "s": "顔を洗って、気がつくと、"
    },
    {
      "t": 18.47,
      "s": "ワイシャツに袖を通していました。"
    },
    {
      "t": 21.44,
      "s": "ネクタイにも手が伸びて、"
    },
    {
      "t": 23.67,
      "s": "そこでやっと止まりました。"
    },
    {
      "t": 26.09,
      "s": "玄関まで行って、"
    },
    {
      "t": 27.62,
      "s": "靴をはこうとして、"
    },
    {
      "t": 29.35,
      "s": "立ちつくしました。"
    },
    {
      "t": 31.08,
      "s": "行く場所が、ないんです。"
    },
    {
      "t": 33.38,
      "s": "家の中には、私ひとりでした。"
    },
    {
      "t": 36.53,
      "s": "机の上には、名刺入れが置いたままです。"
    },
    {
      "t": 40.81,
      "s": "肩書きの入った名刺が、"
    },
    {
      "t": 43.28,
      "s": "まだ何十枚も残っていました。"
    },
    {
      "t": 46.42,
      "s": "九時になりました。"
    },
    {
      "t": 48.39,
      "s": "朝礼が始まる時間です。"
    },
    {
      "t": 50.81,
      "s": "電話は鳴りません。"
    },
    {
      "t": 52.78,
      "s": "部長、と私を呼ぶ人は、どこにもいません。"
    },
    {
      "t": 57.17,
      "s": "さびしい、というのとは、少し違いました。"
    },
    {
      "t": 61.85,
      "s": "なんというか、足もとが抜けたような感じです。"
    },
    {
      "t": 67.01,
      "s": "四十年、待っていたはずの朝なのに、です。"
    },
    {
      "t": 73.18,
      "s": "そのとき、ひとつの問いが浮かびました。"
    },
    {
      "t": 76.56,
      "s": "私は、これから何と呼ばれるんだろう。"
    },
    {
      "t": 79.77,
      "s": "部長ではない。"
    },
    {
      "t": 81.31,
      "s": "会社の人でもない。"
    },
    {
      "t": 83.29,
      "s": "では、何なのか。"
    },
    {
      "t": 85.05,
      "s": "正直に言うと、"
    },
    {
      "t": 86.59,
      "s": "答えがひとつも出てきませんでした。"
    },
    {
      "t": 90.33,
      "s": "それで、調べてみたんです。"
    },
    {
      "t": 93.34,
      "s": "人が長く続けた役割を離れるとき、"
    },
    {
      "t": 97.04,
      "s": "何が起きるのか。"
    },
    {
      "t": 98.89,
      "s": "それを本気で調べた人はいるのか、と。"
    },
    {
      "t": 103.06,
      "s": "いました。"
    },
    {
      "t": 104.16,
      "s": "しかもその人は、自分自身が、"
    },
    {
      "t": 107.26,
      "s": "大きな役割を離れた人でした。"
    },
    {
      "t": 110.35,
      "s": "アメリカの社会学者に、"
    },
    {
      "t": 112.3,
      "s": "ヘレン・ローズ・エボーという人がいます。"
    },
    {
      "t": 115.85,
      "s": "若いころ、カトリックの修道女でした。"
    },
    {
      "t": 119.05,
      "s": "何年も修道院で暮らしたあと、"
    },
    {
      "t": 121.87,
      "s": "彼女はその道を離れました。"
    },
    {
      "t": 124.49,
      "s": "そして社会学者になり、結婚して、"
    },
    {
      "t": 127.71,
      "s": "母親になっています。"
    },
    {
      "t": 129.72,
      "s": "一九七〇年代、"
    },
    {
      "t": 131.3,
      "s": "彼女は博士論文のために、"
    },
    {
      "t": 134.02,
      "s": "同じように修道院を"
    },
    {
      "t": 136.06,
      "s": "離れた女性たちの話を聞きました。すると、"
    },
    {
      "t": 140.58,
      "s": "離れ方に、"
    },
    {
      "t": 141.71,
      "s": "よく似た順番があったんです。"
    },
    {
      "t": 144.88,
      "s": "そこで、対象を広げました。離婚した人。"
    },
    {
      "t": 150.63,
      "s": "刑務所を出た人。"
    },
    {
      "t": 153.05,
      "s": "お酒をやめた人。"
    },
    {
      "t": 155.46,
      "s": "医者や警察官をやめた人。"
    },
    {
      "t": 159.09,
      "s": "そして、定年で退職した人です。"
    },
    {
      "t": 163.63,
      "s": "話を聞いたのは、合わせて百八十五人。"
    },
    {
      "t": 167.49,
      "s": "それをまとめた本が、一九八八年に出ています。"
    },
    {
      "t": 172.2,
      "s": "題は、ビカミング・アン・エックス。"
    },
    {
      "t": 176.12,
      "s": "訳すと、元の何者かになる、という意味です。"
    },
    {
      "t": 180.96,
      "s": "エボーはこれを、役割からの離脱と呼びました。"
    },
    {
      "t": 185.51,
      "s": "英語では、ロール・イグジットです。"
    },
    {
      "t": 189.02,
      "s": "彼女によると、"
    },
    {
      "t": 190.33,
      "s": "人が大きな役割を離れるときには、"
    },
    {
      "t": 193.33,
      "s": "およそ四つの段階があるということです。"
    },
    {
      "t": 196.89,
      "s": "ひとつめは、最初の疑いです。今の役割が、"
    },
    {
      "t": 200.86,
      "s": "どこか自分に合わなくなってきた、"
    },
    {
      "t": 204.04,
      "s": "と感じはじめる時期です。"
    },
    {
      "t": 206.41,
      "s": "ふたつめは、ほかの道を探す時期です。"
    },
    {
      "t": 210.34,
      "s": "もしこれをやめたら、自分は何になれるのか。"
    },
    {
      "t": 214.93,
      "s": "あれこれ考えます。"
    },
    {
      "t": 216.9,
      "s": "みっつめは、転機です。"
    },
    {
      "t": 219.32,
      "s": "ある出来事をきっかけに、"
    },
    {
      "t": 221.97,
      "s": "もう戻らない、"
    },
    {
      "t": 223.51,
      "s": "と決まる瞬間があるんです。"
    },
    {
      "t": 226.37,
      "s": "そしてよっつめが、元の自分をつくる段階です。"
    },
    {
      "t": 232.35,
      "s": "元修道女。元警察官。元部長。"
    },
    {
      "t": 236.16,
      "s": "元という字のついた自分を、"
    },
    {
      "t": 239.69,
      "s": "新しく組み立てていくわけです。"
    },
    {
      "t": 243.77,
      "s": "私が手を止めたのは、"
    },
    {
      "t": 245.65,
      "s": "この四つめに入る手前の時期のことでした。"
    },
    {
      "t": 249.4,
      "s": "古い役割は、もう終わった。"
    },
    {
      "t": 252.15,
      "s": "でも、新しい自分は、まだできていない。"
    },
    {
      "t": 256.16,
      "s": "そのあいだの時間のことです。"
    },
    {
      "t": 259.12,
      "s": "この時期を、"
    },
    {
      "t": 260.22,
      "s": "エボーの話し手たちは、"
    },
    {
      "t": 262.24,
      "s": "立場が違うのに、"
    },
    {
      "t": 263.7,
      "s": "よく似た言葉で語っていたそうです。"
    },
    {
      "t": 266.82,
      "s": "真空、という言葉です。"
    },
    {
      "t": 268.84,
      "s": "地面のない、宙に浮いたような時間。"
    },
    {
      "t": 272.08,
      "s": "いつもの日課が途切れて、"
    },
    {
      "t": 274.37,
      "s": "どう振る舞えばいいのか、"
    },
    {
      "t": 276.66,
      "s": "誰も教えてくれない時間です。"
    },
    {
      "t": 279.33,
      "s": "あの月曜日の九時は、まさにそれでした。"
    },
    {
      "t": 283.22,
      "s": "会社の人ではない。"
    },
    {
      "t": 285.06,
      "s": "でも、ほかの何者でもない。"
    },
    {
      "t": 287.73,
      "s": "私はちょうど、"
    },
    {
      "t": 289.16,
      "s": "その真空の中に立っていたわけです。"
    },
    {
      "t": 292.63,
      "s": "もうひとつ、"
    },
    {
      "t": 293.83,
      "s": "エボーが書いていることがあります。"
    },
    {
      "t": 297.23,
      "s": "役割を離れても、元の役割は、"
    },
    {
      "t": 300.03,
      "s": "きれいには消えない、"
    },
    {
      "t": 302.03,
      "s": "ということです。"
    },
    {
      "t": 303.63,
      "s": "彼女はこれを、役割の名残、"
    },
    {
      "t": 306.1,
      "s": "ロール・レジデュアルと呼んでいます。"
    },
    {
      "t": 309.51,
      "s": "元の役割は、"
    },
    {
      "t": 310.65,
      "s": "その人の中に、"
    },
    {
      "t": 311.97,
      "s": "しばらく残り続けるんです。"
    },
    {
      "t": 314.44,
      "s": "目覚ましなしで、六時半に起きる。"
    },
    {
      "t": 318.03,
      "s": "ワイシャツに手が伸びる。"
    },
    {
      "t": 320.72,
      "s": "実は、あれが名残だったんです。"
    },
    {
      "t": 324.09,
      "s": "四十年ぶんの役割が、体の中で、"
    },
    {
      "t": 327.45,
      "s": "まだ動いていたということです。"
    },
    {
      "t": 330.82,
      "s": "ただ、"
    },
    {
      "t": 331.46,
      "s": "正直に言うと、この本には、"
    },
    {
      "t": 334.21,
      "s": "私には腑に落ちないところもありました。"
    },
    {
      "t": 338.24,
      "s": "エボーが主に調べたのは、"
    },
    {
      "t": 340.79,
      "s": "自分で決めて役割を離れた人たちなんです。"
    },
    {
      "t": 345.03,
      "s": "疑って、迷って、決める。"
    },
    {
      "t": 347.58,
      "s": "その順番は、自分で選んだ人のものです。"
    },
    {
      "t": 351.61,
      "s": "定年は、そうではありません。"
    },
    {
      "t": 354.51,
      "s": "やめる日は、暦が決めています。"
    },
    {
      "t": 357.61,
      "s": "疑いも迷いもないまま、"
    },
    {
      "t": 359.89,
      "s": "ある朝いきなり真空に入る。私はむしろ、"
    },
    {
      "t": 363.82,
      "s": "そういう人のほうが多いような気がしています。"
    },
    {
      "t": 368.36,
      "s": "では、真空のあと、人は何になるのか。ここで、"
    },
    {
      "t": 373.29,
      "s": "もうひとり、"
    },
    {
      "t": 374.63,
      "s": "別の研究者の考えに行き当たりました。"
    },
    {
      "t": 378.66,
      "s": "ロバート・アチュリーという、"
    },
    {
      "t": 381.35,
      "s": "アメリカの老年学者です。"
    },
    {
      "t": 383.65,
      "s": "一九八九年に、"
    },
    {
      "t": 384.99,
      "s": "ジェロントロジストという老年学の専門誌で、"
    },
    {
      "t": 389.02,
      "s": "ひとつの理論をまとめました。"
    },
    {
      "t": 391.71,
      "s": "名前は、継続性の理論。題を訳すと、"
    },
    {
      "t": 395.78,
      "s": "ふつうの老い方についての、"
    },
    {
      "t": 398.9,
      "s": "継続性の理論、となります。"
    },
    {
      "t": 402.01,
      "s": "老年学には、こういう見方がありました。"
    },
    {
      "t": 405.97,
      "s": "仕事がその人の中心なのだから、"
    },
    {
      "t": 409.09,
      "s": "仕事を失えば、自分を失う。"
    },
    {
      "t": 411.8,
      "s": "だから定年は危機になる、というものです。"
    },
    {
      "t": 415.96,
      "s": "アチュリーは、そこに別の見方を出しました。"
    },
    {
      "t": 420.99,
      "s": "人は年を重ねても、"
    },
    {
      "t": 423.15,
      "s": "自分の内側と外側の形を、"
    },
    {
      "t": 426.03,
      "s": "できるだけ保とうとする。"
    },
    {
      "t": 428.9,
      "s": "そう考えたんです。"
    },
    {
      "t": 431.06,
      "s": "内側の継続性というのは、"
    },
    {
      "t": 433.8,
      "s": "考え方や好み、気質、"
    },
    {
      "t": 436.08,
      "s": "身につけた技のことです。"
    },
    {
      "t": 438.82,
      "s": "外側の継続性は、"
    },
    {
      "t": 440.65,
      "s": "住む場所や人との関係、"
    },
    {
      "t": 443.16,
      "s": "ふだんの活動のことです。"
    },
    {
      "t": 445.9,
      "s": "大事なのは、これが、"
    },
    {
      "t": 447.79,
      "s": "変わらないという意味ではないことです。"
    },
    {
      "t": 451.37,
      "s": "変わるときにも、"
    },
    {
      "t": 452.88,
      "s": "人は自分の過去とつながる形で変わろうとする。"
    },
    {
      "t": 457.02,
      "s": "それを継続性と呼んでいるんです。"
    },
    {
      "t": 460.03,
      "s": "アチュリーは、この考えを、"
    },
    {
      "t": 462.48,
      "s": "机の上だけで作ったわけではありません。"
    },
    {
      "t": 466.06,
      "s": "オハイオ州の小さな町で、"
    },
    {
      "t": 468.33,
      "s": "千人を超える人を、"
    },
    {
      "t": 470.02,
      "s": "二十年あまり追いかけた調査に"
    },
    {
      "t": 472.66,
      "s": "かかわっています。"
    },
    {
      "t": 474.36,
      "s": "その調査では、多くの人が、"
    },
    {
      "t": 476.86,
      "s": "退職にうまく適応していたと報告されています。"
    },
    {
      "t": 481.08,
      "s": "仕事がなくなっても、"
    },
    {
      "t": 483,
      "s": "その人らしさは、"
    },
    {
      "t": 484.53,
      "s": "別の形で続いていたわけです。"
    },
    {
      "t": 487.22,
      "s": "たとえば、長く技術者だった人。"
    },
    {
      "t": 490.37,
      "s": "定年のあとも、"
    },
    {
      "t": 491.85,
      "s": "壊れたものを見ると、"
    },
    {
      "t": 493.95,
      "s": "つい直し方を考えてしまう。"
    },
    {
      "t": 496.68,
      "s": "先生だった人は、"
    },
    {
      "t": 498.36,
      "s": "相手が孫に変わっても、"
    },
    {
      "t": 500.68,
      "s": "やはり説明がていねいです。"
    },
    {
      "t": 503.41,
      "s": "ここで私は、"
    },
    {
      "t": 504.46,
      "s": "エボーとアチュリーが、"
    },
    {
      "t": 506.39,
      "s": "少し違うことを言っているのに気づきました。"
    },
    {
      "t": 510.06,
      "s": "エボーが見ていたのは、離れることの重さです。"
    },
    {
      "t": 514.64,
      "s": "真空があり、名残があり、"
    },
    {
      "t": 517.14,
      "s": "元の自分を組み立て直す手間がある。"
    },
    {
      "t": 520.68,
      "s": "アチュリーが見ていたのは、"
    },
    {
      "t": 523.01,
      "s": "離れても続いていくもののほうです。"
    },
    {
      "t": 526.05,
      "s": "正直に言うと、"
    },
    {
      "t": 527.76,
      "s": "どちらが正しいのか、"
    },
    {
      "t": 530.2,
      "s": "私には決められません。"
    },
    {
      "t": 532.88,
      "s": "たぶん、両方とも本当なんだと思います。"
    },
    {
      "t": 537.52,
      "s": "失ったものは、確かにある。"
    },
    {
      "t": 540.69,
      "s": "でも、全部ではない。"
    },
    {
      "t": 543.12,
      "s": "では、失ったのは何で、残ったのは何なのか。"
    },
    {
      "t": 547.29,
      "s": "その境目を考えていて、"
    },
    {
      "t": 549.48,
      "s": "役割という言葉そのものを、"
    },
    {
      "t": 552.06,
      "s": "調べ直してみたんです。"
    },
    {
      "t": 554.25,
      "s": "社会学では、"
    },
    {
      "t": 555.38,
      "s": "役割というものを、"
    },
    {
      "t": 557.07,
      "s": "ある立場にいる人に、"
    },
    {
      "t": 558.95,
      "s": "まわりが寄せる期待のまとまりとして考えます。"
    },
    {
      "t": 563.08,
      "s": "古くは一九三六年、"
    },
    {
      "t": 565.09,
      "s": "アメリカの人類学者ラルフ・リントンが、"
    },
    {
      "t": 569.33,
      "s": "地位と役割を分けて論じました。"
    },
    {
      "t": 572.68,
      "s": "地位は、席のようなものです。役割は、"
    },
    {
      "t": 576.33,
      "s": "その席に座った人に"
    },
    {
      "t": 578.15,
      "s": "求められる振る舞いのことです。"
    },
    {
      "t": 581.19,
      "s": "部長という席には、"
    },
    {
      "t": 582.93,
      "s": "決める人であってほしい、"
    },
    {
      "t": 585.24,
      "s": "という期待がついています。"
    },
    {
      "t": 587.75,
      "s": "父親という席には、"
    },
    {
      "t": 589.49,
      "s": "頼れる人であってほしい、"
    },
    {
      "t": 591.8,
      "s": "という期待がついています。"
    },
    {
      "t": 594.31,
      "s": "つまり役割とは、もともと、"
    },
    {
      "t": 597.2,
      "s": "まわりの人が私に必要と"
    },
    {
      "t": 599.64,
      "s": "していたものの形なんです。"
    },
    {
      "t": 602.53,
      "s": "会社が回るために。"
    },
    {
      "t": 604.53,
      "s": "家族が回るために。"
    },
    {
      "t": 606.53,
      "s": "そう考えると、"
    },
    {
      "t": 607.91,
      "s": "あの月曜日に起きたことが、"
    },
    {
      "t": 610.48,
      "s": "少し違って見えてきました。"
    },
    {
      "t": 613.04,
      "s": "部長という呼び名が消えたのは、会社が、"
    },
    {
      "t": 616.33,
      "s": "もうその形を私に必要としなくなったからです。"
    },
    {
      "t": 620.15,
      "s": "私という人間が、消えたからではありません。"
    },
    {
      "t": 623.79,
      "s": "呼び名は、いつも向こう側から来ていました。"
    },
    {
      "t": 628.08,
      "s": "部長、と呼ぶのは部下です。"
    },
    {
      "t": 630.74,
      "s": "お父さん、と呼ぶのは子どもです。"
    },
    {
      "t": 634.02,
      "s": "呼ぶ人がいなくなれば、呼び名は止まります。"
    },
    {
      "t": 638.31,
      "s": "でも、呼ばれる前から、私はいました。"
    },
    {
      "t": 642.24,
      "s": "部長になる前にも、"
    },
    {
      "t": 644.2,
      "s": "私は何かを好きになり、"
    },
    {
      "t": 646.6,
      "s": "何かに腹を立てていました。"
    },
    {
      "t": 649.44,
      "s": "アチュリーが内側の継続性と呼んだのは、"
    },
    {
      "t": 653.21,
      "s": "そこなんです。役割は、"
    },
    {
      "t": 655.4,
      "s": "私がまわりのために引き受けていた形でした。"
    },
    {
      "t": 659.57,
      "s": "私そのものでは、なかったんです。"
    },
    {
      "t": 662.75,
      "s": "ただ、ここは、"
    },
    {
      "t": 663.91,
      "s": "はっきり言っておかないといけません。"
    },
    {
      "t": 666.91,
      "s": "エボーの話も、"
    },
    {
      "t": 668.13,
      "s": "アチュリーの理論も、"
    },
    {
      "t": 669.87,
      "s": "多くの人に見られる傾向を描いたものです。"
    },
    {
      "t": 673.34,
      "s": "ひとりひとりに当ては"
    },
    {
      "t": 675.08,
      "s": "まる決まりではありません。"
    },
    {
      "t": 677.34,
      "s": "アチュリーの理論には、"
    },
    {
      "t": 679.25,
      "s": "男性の働き方を基準にしすぎている、"
    },
    {
      "t": 682.21,
      "s": "病気を抱えた人の老い方が抜けている、"
    },
    {
      "t": 685.34,
      "s": "という批判も出されています。"
    },
    {
      "t": 687.77,
      "s": "真空が数か月で終わる人もいれば、"
    },
    {
      "t": 691.27,
      "s": "何年も続く人もいます。"
    },
    {
      "t": 693.68,
      "s": "名残が、ずっと消えない人もいます。"
    },
    {
      "t": 697.41,
      "s": "それも、この過程のひとつの形です。"
    },
    {
      "t": 701.13,
      "s": "遅れているわけでも、"
    },
    {
      "t": 703.32,
      "s": "失敗したわけでもありません。"
    },
    {
      "t": 706.38,
      "s": "それから、いくつかの月曜日が過ぎました。"
    },
    {
      "t": 710.66,
      "s": "私は今でも、六時半に目が覚めます。"
    },
    {
      "t": 714.19,
      "s": "名残は、まだ残っています。"
    },
    {
      "t": 716.9,
      "s": "それを無理に消そうとは、思わなくなりました。"
    },
    {
      "t": 721.47,
      "s": "九時になっても、電話は鳴りません。"
    },
    {
      "t": 725.28,
      "s": "部長、と呼ぶ人も、やはりいません。"
    },
    {
      "t": 729.09,
      "s": "あの最初の月曜日と、同じ朝です。"
    },
    {
      "t": 732.67,
      "s": "ただ、ある朝、気づいたことがあります。"
    },
    {
      "t": 736.56,
      "s": "新聞を読みながら、"
    },
    {
      "t": 738.4,
      "s": "私は赤いペンを持っていました。"
    },
    {
      "t": 741.48,
      "s": "数字の合わない記事に、印をつけていたんです。"
    },
    {
      "t": 745.98,
      "s": "誰に頼まれたわけでもありません。"
    },
    {
      "t": 749.19,
      "s": "見せる相手もいません。"
    },
    {
      "t": 751.39,
      "s": "それでも、手が勝手に動いていました。"
    },
    {
      "t": 755,
      "s": "四十年、書類の数字を確かめてきた手です。"
    },
    {
      "t": 758.71,
      "s": "部長の席がなくなっても、"
    },
    {
      "t": 760.94,
      "s": "確かめずにいられない私は、"
    },
    {
      "t": 763.35,
      "s": "ちゃんとここに残っていました。"
    },
    {
      "t": 766.13,
      "s": "これを何と呼べばいいのか、"
    },
    {
      "t": 768.74,
      "s": "私なりに考えても、"
    },
    {
      "t": 770.55,
      "s": "まだうまく言えません。"
    },
    {
      "t": 772.75,
      "s": "アチュリーなら、"
    },
    {
      "t": 774.36,
      "s": "内側の継続性と呼ぶのだと思います。"
    },
    {
      "t": 777.76,
      "s": "私は、これから何と呼ばれるんだろう。"
    },
    {
      "t": 781.46,
      "s": "あの朝の問いには、実は、"
    },
    {
      "t": 783.93,
      "s": "まだ答えが出ていません。"
    },
    {
      "t": 786.4,
      "s": "ただ、問いの向きが変わりました。"
    },
    {
      "t": 789.22,
      "s": "何と呼ばれるか、ではありません。"
    },
    {
      "t": 792.05,
      "s": "誰にも呼ばれない九時に、"
    },
    {
      "t": 794.17,
      "s": "自分が何をしているか、です。"
    },
    {
      "t": 798.13,
      "s": "部長という呼び名は、"
    },
    {
      "t": 800.05,
      "s": "会社が私を必要とした四十年のあいだ、"
    },
    {
      "t": 803.51,
      "s": "預かっていた名前でした。"
    },
    {
      "t": 805.81,
      "s": "その名前を返したあとも、"
    },
    {
      "t": 808.09,
      "s": "赤いペンを持つ私は、"
    },
    {
      "t": 809.98,
      "s": "ここにいます。"
    },
    {
      "t": 811.31,
      "s": "名前がつく前から、ずっと、ここにいたんです。"
    }
  ]
}