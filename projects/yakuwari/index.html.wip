};
SHOT.S37 = function(u, t){   /* C51 Linton 1936 */
  deskLight(1); deskProps([BOOK_LIN]);
  var p = ease(u/9.6);
  setCam(-30+lerp(0.3,0.22,p), lerp(1.08,1.0,p), lerp(0.36,0.3,p), -30-0.02, 0.78, 0.02, 38);
  tagSet(tagREl, 'ラルフ・リントン（1936）', '地位（status）と役割（role）を分けた', win(t, 565.1, 572.2, 0.7));
