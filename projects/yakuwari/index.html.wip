  setCalendar(fl);
  var k = ramp(t, 359.9, 362.6);
  HOLE.visible = false;
  sun.intensity *= (1-k); hemi.intensity *= lerp(1,0.05,k); fill.intensity *= (1-k); RM.paperM.color.multiplyScalar(lerp(1,0.05,k)); RM.beamM.uniforms.uOp.value *= (1-k);
  roomDust(t, 1-k);
  key.position.set(0.25, 2.3, -0.6); key.target.position.set(0.18, 1.33, -1.79); key.intensity = 0.9*k; key.angle = 0.3; key.penumbra = 0.9;
  var p = ease(u/16.8);
  setCam(0.21, 1.34, lerp(-0.6,-0.72,p), 0.18, 1.3, -1.79, 38);
};

/* ---------- CHƯƠNG 3 — 役割という席 ---------- */
SHOT.S28 = function(u, t){   /* C35 sau 真空: ma-nơ-canh xa, 部長 vẫn lơ lửng */
