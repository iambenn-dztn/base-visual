SHOT.S30 = function(u, t){   /* C38 "かつての見方": bỏ tấm 仕事 → thân rỗng (giả định cũ) */
  voidLight(0.9, t); show('figOld');
  figPose(FIG2, t);
  FX.sat = 0.3; FX.mul = [1.04,1.0,0.94];
  var k = ramp(t, 409.2, 411.4);
  plateSet(PL2, {off:0.35*k, dy:-0.25*k*k, rx:0.6*k});
  PL2.mat.opacity = 1 - ramp(t, 410.4, 411.8); PL2.mat.transparent = true; PL2.pivot.visible = PL2.mat.opacity > 0.01;
  CLAY2.opacity = lerp(1, 0.06, ramp(t, 410.8, 413.0));
  FIG2_SHELL.userData.m.uniforms.uOp.value = 1.4*ramp(t, 410.8, 413.0);
  var p = ease(u/14);
  setCam(lerp(0.7,0.5,p), 1.35, lerp(3.4,2.9,p), 0, 1.15, 0, 36);
  tagSet(tagREl, 'かつての見方', '仕事を失えば、自分を失う', win(t, 406.0, 415.5, 0.7));
};
SHOT.S31 = function(u, t){   /* C39–C41 hai sợi continuity: nội/ngoại, đổi hướng ở 定年 nhưng không đứt */
  show('threads'); scene.environment = envVoid;
  bgMat.uniforms.uTop.value.setRGB(0.012,0.013,0.02); bgMat.uniforms.uBot.value.setRGB(0.003,0.003,0.005);
  var rev = lerp(0.02, TH.gs, ramp(t, 416.2, 425.0)) + (1-TH.gs)*ramp(t, 446.2, 455.0);
  TH.inM.uniforms.uRev.value = rev; TH.outM.uniforms.uRev.value = rev;
  TH.inM.uniforms.uHi.value = 0.6*win(t, 431.1, 438.4, 0.8); TH.outM.uniforms.uHi.value = 0.6*win(t, 438.9, 445.6, 0.8);
  TH.inM.uniforms.uI.value = 1.0; TH.outM.uniforms.uI.value = 1.0;
  var inT = [431.3, 433.8, 435.0, 436.2], outT = [439.0, 440.7, 443.2];
  for(var i=0;i<TH.chips.length;i++){ var c = TH.chips[i]; var t0 = c.g===0 ? inT[c.i] : outT[c.i]; c.m.material.opacity = ramp(t, t0, t0+0.8) * (1 - ramp(t, 446, 448.2));   /* tắt hẳn trước khi máy lia phải (không để nhãn bị cắt mép khung) */ }
  TH.gateM.opacity = 0.8*ramp(t, 424, 426); TH.gateLab.material.opacity = ramp(t, 424, 426);
  /* máy đi theo đầu sợi: quá khứ → dừng ở vùng nhãn + cổng → sang phải thấy chỗ đổi hướng */
  var cx0 = lerp(-3.4, -1.2, ramp(t, 416.0, 425.5)) + 2.3*ramp(t, 446.0, 456.0);
  setCam(cx0, 1.6, 60+5.4, cx0, 1.35, 60-0.3, 50);
  for(var j=0;j<TH.chips.length;j++) faceCam(TH.chips[j].m);
  faceCam(TH.gate);   /* nhóm cổng ở gốc THR (không xoay) → quay theo máy là đủ */
  thrDust(t, 0.8);
  bloomPass.strength = 0.7;
  tagSet(tagREl, '内側の継続性・外側の継続性', 'アチュリー（1989）', win(t, 423.2, 445.4, 0.8));
  tagSet(tagLEl, '継続性 ≠ 変わらないこと', '過去とつながる形で変わる', win(t, 447.8, 459.5, 0.8));
};
SHOT.S32 = function(u, t){   /* C42–C43 Ohio: 20 chồng phiếu theo năm, hơn 1.000 người */
  voidLight(0.85, t); show('stacks');
  key.position.set(0.0, 5.0, 2.5); key.target.position.set(0, 0.2, -1.4); key.angle = 0.75;
  stacksSet(ramp(t, 466.2, 473.8), ramp(t, 474.4, 477.6));
  for(var i=0;i<1;i++){ faceCam(SK.lab1); faceCam(SK.lab2); }
  SK.lab1.material.opacity = ramp(t,466.5,467.5); SK.lab2.material.opacity = ramp(t,473.3,474.2);
  var p = ease(u/27.2);
  setCam(lerp(-1.1,0.9,p), lerp(1.35,1.2,p), lerp(3.1,2.9,p), 0, 0.2, -1.2, 50);
  faceCam(SK.lab1); faceCam(SK.lab2);
  tagSet(tagREl, 'オハイオ州の縦断調査', '千人を超える人を、二十年あまり', win(t, 466.1, 486.6, 0.8));
  tagSet(tagLEl, '多くの人が、退職にうまく適応', '', win(t, 476.9, 486.6, 0.8));
};
SHOT.S33 = function(u, t){   /* C44 "技術者だった人" → "先生だった人": cùng một chuyển động máy (match cut) */
  deskDay();
  var a = t < 496.68, t0 = a ? 487.22 : 496.68, dur = a ? 9.46 : 6.73;
  if(a){ deskProps([FIXIT]); FIXIT.userData.sd.rotation.y = 0.5 + 0.25*Math.sin(t*0.6); } else deskProps([PICBOOK]);
  var p = ease((t-t0)/dur);
  setCam(-30+lerp(0.42,0.3,p), lerp(1.12,1.02,p), lerp(0.5,0.4,p), -30+0.02, 0.77, 0.02, 38);
};
SHOT.S34 = function(u, t){   /* C45–C48 khung đôi: trái Ebaugh (sức nặng), phải Atchley (cái tiếp nối) */
  figBase(t, 0.9); show('mini'); show('divider');
  FIGG.position.set(-0.95, 0, 0);
  key.target.position.set(-0.4, 1.0, 0); key.angle = 0.62;
  var L = 1 - 0.55*win(t, 520.7, 525.8, 1.0), R = 1 - 0.6*win(t, 510.1, 520.4, 1.0);
  var sag = win(t, 510.1, 520.4, 1.4);
  buchoFloat(t, 1); if(PL.bucho.center){ PL.bucho.pivot.position.y -= 0.05*sag; PL.bucho.pivot.rotation.z += 0.08*sag; }
  PL.bucho.mat.emissive.setRGB(0.25*bump(t,537.5,540.5), 0.16*bump(t,537.5,540.5), 0.06*bump(t,537.5,540.5));
  key.intensity *= L; rim.intensity *= L;
  MINI.userData.a.uniforms.uRev.value = 1; MINI.userData.b.uniforms.uRev.value = 1;
  MINI.userData.a.uniforms.uI.value = 0.9*R + 0.4*bump(t,540.7,543.1); MINI.userData.b.uniforms.uI.value = 0.9*R + 0.4*bump(t,540.7,543.1);
  RESID.material.uniforms.uI.value = 1.0*L; GEN_MARK.material.opacity = 0.5*L;
  DIVIDER.position.set(0.02, 1.5, 0.2); faceCam(DIVIDER);
  var p = ease(u/39.7);
  setCam(0, lerp(1.25,1.3,p), lerp(5.4,5.0,p), 0, 1.15, 0, 36);
  faceCam(DIVIDER);
  tagSet(tagLEl, 'エボー', '離れることの重さ', win(t, 510.1, 542.6, 0.8)*lerp(1,0.55,win(t,520.7,525.8,1)));
  tagSet(tagREl, 'アチュリー', '離れても続いていくもの', win(t, 520.7, 542.6, 0.8));
};
SHOT.S35 = function(u, t){   /* C49 từ điển: やくわり【役割】 */
