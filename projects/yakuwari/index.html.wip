};
SHOT.S50 = function(u, t){   /* C72 "預かっていた名前" — dòng 部長 bóc khỏi danh thiếp, bay đi (trả lại) */
  roomLight(0.8, 0.6); FX.mul = [0.8,0.8,0.8]; bloomPass.strength = 0.3;
  CLOSECARD.visible = true; RM.cardCase.visible = false;
  var k = ramp(t, 800.3, 805.3);
  cardState(k > 0.0 ? 1 : 0, 1, 0);
  CC.liftHold.visible = true;
  /* vị trí dòng 部長 trên danh thiếp: canvas (330..450, 270) / 1100×660 */
  var lx = ((390/1100) - 0.5)*CARD_W, lz = ((270/660) - 0.5)*CARD_H;
  plateSet(CC.lift, {});
  CC.liftHold.position.set(lx + 0.035*k, 0.0006 + 0.022*k, lz - 0.012*k);
  CC.liftHold.rotation.set(-Math.PI/2 + 0.45*k, 0.25*k, 0.15*k);
  CC.lift.mat.opacity = 1 - ramp(t, 804.6, 805.8); CC.lift.mat.transparent = true;
  CC.liftHold.visible = t >= 800.2;
  var c = CLOSECARD.position, p = ease(u/7.7);
  setCam(c.x+lerp(0.02,0.01,p), c.y+lerp(0.11,0.14,p), c.z+lerp(0.09,0.11,p), c.x+0.008*k, c.y+0.008*k, c.z-0.006, 36);
};
SHOT.S51 = function(u, t){   /* C73–C74 "赤いペンを持つ私は、ここにいます" → lùi ra, nắng tràn */
  var k = ramp(t, 811.3, 815.6);
  roomLight(0.82 + 0.1*k, 0.6); meClothes('cardi'); RM.cardCase.visible = false; NEWS.g.visible = true; newsInk(3.0);
  meSeiza(t, 0.2, 0.7);
  PEN2.visible = true;
  meCore.material.uniforms.uI.value = 0.55;
  setClock(WALLCLOCK, 9*3600+6*60+(t-805.8));
  var p = ease((t-805.81)/5.5);
  if(t < 811.31) setCam(lerp(0.3,0.25,p), 1.0, lerp(-0.25,-0.32,p), 0.72, 0.8, 1.15, 36);
  else setCam(lerp(0.25,1.45,k), lerp(1.0,1.9,k), lerp(-0.32,-1.45,k), lerp(0.72,0.3,k), lerp(0.8,0.7,k), lerp(1.15,0.6,k), lerp(36,50,k));
  bloomPass.strength = 0.42 + 0.25*k;
};

