var SHOT_LIST = [
  ['S01',0],['S02',5.88],['S03',16.24],['S04',26.09],['S05',33.38],['S06',46.42],['S07',57.17],['S08',73.18],['S09',79.77],['S10',90.33],
  ['S11',110.35],['S12',129.72],['S13',144.88],['S14',172.20],['S15',189.02],['S16',196.89],['S17',206.41],['S18',216.90],['S19',226.37],
  ['S20',243.77],['S21',268.84],['S22',279.33],['S23',292.63],['S24',314.44],['S25',330.82],['S26',338.24],['S27',351.61],
  ['S28',368.36],['S29',378.66],['S30',402.01],['S31',415.96],['S32',460.03],['S33',487.22],['S34',503.41],['S35',543.12],['S36',554.25],
  ['S37',563.08],['S38',572.68],['S39',606.53],['S40',613.04],['S41',623.79],['S42',638.31],['S43',662.75],
  ['S44',706.38],['S45',721.47],['S46',732.67],['S47',745.98],['S48',755.00],['S49',766.13],['S50',798.13],['S51',805.81]
];
var SC = {}, SCENE_KEYS = [];
(function(){ for(var i=0;i<SHOT_LIST.length;i++){ var k = SHOT_LIST[i][0]; SCENE_KEYS.push(k);
  SC[k] = [SHOT_LIST[i][1], i+1<SHOT_LIST.length ? SHOT_LIST[i+1][1] : SCENE_END]; } })();
/** loc(): GIÂY trôi qua trong shot k (KHÔNG phải tỉ lệ 0–1) — override tại tập, không sửa hf-astro.js. */
function loc(t,k){ var w = SC[k]; return Math.min(w[1]-w[0], Math.max(0, t-w[0])); }
function sceneAt(t){ for(var i=SCENE_KEYS.length-1;i>=0;i--){ if(t >= SC[SCENE_KEYS[i]][0]) return SCENE_KEYS[i]; } return 'S01'; }
/* chuyển liền mạch (không nhúng tối) · chuyển chương (nhúng tối dài) */
var NO_DIP = {S16:1, S17:1, S18:1, S19:1, S20:1, S23:1};
var LONG_DIP = {S11:1, S28:1, S44:1, S15:1};

/* nhãn chương — mốc THẬT (cue.start + LEAD_S) vì applyChapter tra theo _tReal */
var CHAPTERS = [
  {t:0.00 + LEAD_S + 0.3, x:'第1章　月曜日の九時'},
  {t:110.35 + LEAD_S, x:'第2章　「元」になる人たち'},
  {t:368.36 + LEAD_S, x:'第3章　役割という席'},
  {t:706.38 + LEAD_S, x:'第4章　帰り道'}
];

/* =========================================================================
 * PHỤ ĐỀ — sinh bởi scripts/gen-captions.mjs (đừng sửa tay)
 * ========================================================================= */
const CUES=[
 {t:2.00,s:"月曜日の朝でした。"},
 {t:4.12,s:"定年を迎えて、最初の月曜日です。"},
 {t:7.88,s:"目覚ましは、かけていませんでした。"},
 {t:10.97,s:"それなのに私は、"},
 {t:12.42,s:"六時半ちょうどに目を覚ましました。"},
 {t:15.51,s:"四十年、そうしてきたからです。"},
 {t:18.24,s:"顔を洗って、気がつくと、"},
 {t:20.47,s:"ワイシャツに袖を通していました。"},
 {t:23.44,s:"ネクタイにも手が伸びて、"},
 {t:25.67,s:"そこでやっと止まりました。"},
 {t:28.09,s:"玄関まで行って、"},
 {t:29.62,s:"靴をはこうとして、"},
 {t:31.35,s:"立ちつくしました。"},
 {t:33.08,s:"行く場所が、ないんです。"},
 {t:35.38,s:"家の中には、私ひとりでした。"},
 {t:38.53,s:"机の上には、名刺入れが置いたままです。"},
 {t:42.81,s:"肩書きの入った名刺が、"},
 {t:45.28,s:"まだ何十枚も残っていました。"},
 {t:48.42,s:"九時になりました。"},
 {t:50.39,s:"朝礼が始まる時間です。"},
 {t:52.81,s:"電話は鳴りません。"},
 {t:54.78,s:"部長、と私を呼ぶ人は、どこにもいません。"},
 {t:59.17,s:"さびしい、というのとは、少し違いました。"},
 {t:63.85,s:"なんというか、足もとが抜けたような感じです。"},
 {t:69.01,s:"四十年、待っていたはずの朝なのに、です。"},
 {t:75.18,s:"そのとき、ひとつの問いが浮かびました。"},
 {t:78.56,s:"私は、これから何と呼ばれるんだろう。"},
 {t:81.77,s:"部長ではない。"},
 {t:83.31,s:"会社の人でもない。"},
 {t:85.29,s:"では、何なのか。"},
 {t:87.05,s:"正直に言うと、"},
 {t:88.59,s:"答えがひとつも出てきませんでした。"},
 {t:92.33,s:"それで、調べてみたんです。"},
 {t:95.34,s:"人が長く続けた役割を離れるとき、"},
 {t:99.04,s:"何が起きるのか。"},
 {t:100.89,s:"それを本気で調べた人はいるのか、と。"},
 {t:105.06,s:"いました。"},
 {t:106.16,s:"しかもその人は、自分自身が、"},
 {t:109.26,s:"大きな役割を離れた人でした。"},
 {t:112.35,s:"アメリカの社会学者に、"},
 {t:114.30,s:"ヘレン・ローズ・エボーという人がいます。"},
 {t:117.85,s:"若いころ、カトリックの修道女でした。"},
 {t:121.05,s:"何年も修道院で暮らしたあと、"},
 {t:123.87,s:"彼女はその道を離れました。"},
 {t:126.49,s:"そして社会学者になり、結婚して、"},
 {t:129.71,s:"母親になっています。"},
 {t:131.72,s:"一九七〇年代、"},
 {t:133.30,s:"彼女は博士論文のために、"},
 {t:136.02,s:"同じように修道院を"},
 {t:138.06,s:"離れた女性たちの話を聞きました。すると、"},
 {t:142.58,s:"離れ方に、"},
 {t:143.71,s:"よく似た順番があったんです。"},
 {t:146.88,s:"そこで、対象を広げました。離婚した人。"},
 {t:152.63,s:"刑務所を出た人。"},
 {t:155.05,s:"お酒をやめた人。"},
 {t:157.46,s:"医者や警察官をやめた人。"},
 {t:161.09,s:"そして、定年で退職した人です。"},
 {t:165.63,s:"話を聞いたのは、合わせて百八十五人。"},
 {t:169.49,s:"それをまとめた本が、一九八八年に出ています。"},
 {t:174.20,s:"題は、ビカミング・アン・エックス。"},
 {t:178.12,s:"訳すと、元の何者かになる、という意味です。"},
 {t:182.96,s:"エボーはこれを、役割からの離脱と呼びました。"},
 {t:187.51,s:"英語では、ロール・イグジットです。"},
 {t:191.02,s:"彼女によると、"},
 {t:192.33,s:"人が大きな役割を離れるときには、"},
 {t:195.33,s:"およそ四つの段階があるということです。"},
 {t:198.89,s:"ひとつめは、最初の疑いです。今の役割が、"},
 {t:202.86,s:"どこか自分に合わなくなってきた、"},
 {t:206.04,s:"と感じはじめる時期です。"},
 {t:208.41,s:"ふたつめは、ほかの道を探す時期です。"},
 {t:212.34,s:"もしこれをやめたら、自分は何になれるのか。"},
 {t:216.93,s:"あれこれ考えます。"},
 {t:218.90,s:"みっつめは、転機です。"},
 {t:221.32,s:"ある出来事をきっかけに、"},
 {t:223.97,s:"もう戻らない、"},
 {t:225.51,s:"と決まる瞬間があるんです。"},
 {t:228.37,s:"そしてよっつめが、元の自分をつくる段階です。"},
 {t:234.35,s:"元修道女。元警察官。元部長。"},
 {t:238.16,s:"元という字のついた自分を、"},
 {t:241.69,s:"新しく組み立てていくわけです。"},
 {t:245.77,s:"私が手を止めたのは、"},
 {t:247.65,s:"この四つめに入る手前の時期のことでした。"},
 {t:251.40,s:"古い役割は、もう終わった。"},
 {t:254.15,s:"でも、新しい自分は、まだできていない。"},
 {t:258.16,s:"そのあいだの時間のことです。"},
 {t:261.12,s:"この時期を、"},
 {t:262.22,s:"エボーの話し手たちは、"},
 {t:264.24,s:"立場が違うのに、"},
 {t:265.70,s:"よく似た言葉で語っていたそうです。"},
 {t:268.82,s:"真空、という言葉です。"},
 {t:270.84,s:"地面のない、宙に浮いたような時間。"},
 {t:274.08,s:"いつもの日課が途切れて、"},
 {t:276.37,s:"どう振る舞えばいいのか、"},
 {t:278.66,s:"誰も教えてくれない時間です。"},
 {t:281.33,s:"あの月曜日の九時は、まさにそれでした。"},
 {t:285.22,s:"会社の人ではない。"},
 {t:287.06,s:"でも、ほかの何者でもない。"},
 {t:289.73,s:"私はちょうど、"},
 {t:291.16,s:"その真空の中に立っていたわけです。"},
 {t:294.63,s:"もうひとつ、"},
 {t:295.83,s:"エボーが書いていることがあります。"},
 {t:299.23,s:"役割を離れても、元の役割は、"},
 {t:302.03,s:"きれいには消えない、"},
 {t:304.03,s:"ということです。"},
 {t:305.63,s:"彼女はこれを、役割の名残、"},
 {t:308.10,s:"ロール・レジデュアルと呼んでいます。"},
 {t:311.51,s:"元の役割は、"},
 {t:312.65,s:"その人の中に、"},
 {t:313.97,s:"しばらく残り続けるんです。"},
 {t:316.44,s:"目覚ましなしで、六時半に起きる。"},
 {t:320.03,s:"ワイシャツに手が伸びる。"},
 {t:322.72,s:"実は、あれが名残だったんです。"},
 {t:326.09,s:"四十年ぶんの役割が、体の中で、"},
 {t:329.45,s:"まだ動いていたということです。"},
 {t:332.82,s:"ただ、"},
 {t:333.46,s:"正直に言うと、この本には、"},
 {t:336.21,s:"私には腑に落ちないところもありました。"},
 {t:340.24,s:"エボーが主に調べたのは、"},
 {t:342.79,s:"自分で決めて役割を離れた人たちなんです。"},
 {t:347.03,s:"疑って、迷って、決める。"},
 {t:349.58,s:"その順番は、自分で選んだ人のものです。"},
 {t:353.61,s:"定年は、そうではありません。"},
 {t:356.51,s:"やめる日は、暦が決めています。"},
 {t:359.61,s:"疑いも迷いもないまま、"},
 {t:361.89,s:"ある朝いきなり真空に入る。私はむしろ、"},
 {t:365.82,s:"そういう人のほうが多いような気がしています。"},
 {t:370.36,s:"では、真空のあと、人は何になるのか。ここで、"},
 {t:375.29,s:"もうひとり、"},
 {t:376.63,s:"別の研究者の考えに行き当たりました。"},
 {t:380.66,s:"ロバート・アチュリーという、"},
 {t:383.35,s:"アメリカの老年学者です。"},
 {t:385.65,s:"一九八九年に、"},
 {t:386.99,s:"ジェロントロジストという老年学の専門誌で、"},
 {t:391.02,s:"ひとつの理論をまとめました。"},
 {t:393.71,s:"名前は、継続性の理論。題を訳すと、"},
 {t:397.78,s:"ふつうの老い方についての、"},
 {t:400.90,s:"継続性の理論、となります。"},
 {t:404.01,s:"老年学には、こういう見方がありました。"},
 {t:407.97,s:"仕事がその人の中心なのだから、"},
 {t:411.09,s:"仕事を失えば、自分を失う。"},
 {t:413.80,s:"だから定年は危機になる、というものです。"},
 {t:417.96,s:"アチュリーは、そこに別の見方を出しました。"},
 {t:422.99,s:"人は年を重ねても、"},
 {t:425.15,s:"自分の内側と外側の形を、"},
 {t:428.03,s:"できるだけ保とうとする。"},
 {t:430.90,s:"そう考えたんです。"},
 {t:433.06,s:"内側の継続性というのは、"},
 {t:435.80,s:"考え方や好み、気質、"},
 {t:438.08,s:"身につけた技のことです。"},
 {t:440.82,s:"外側の継続性は、"},
 {t:442.65,s:"住む場所や人との関係、"},
 {t:445.16,s:"ふだんの活動のことです。"},
 {t:447.90,s:"大事なのは、これが、"},
 {t:449.79,s:"変わらないという意味ではないことです。"},
 {t:453.37,s:"変わるときにも、"},
 {t:454.88,s:"人は自分の過去とつながる形で変わろうとする。"},
 {t:459.02,s:"それを継続性と呼んでいるんです。"},
 {t:462.03,s:"アチュリーは、この考えを、"},
 {t:464.48,s:"机の上だけで作ったわけではありません。"},
 {t:468.06,s:"オハイオ州の小さな町で、"},
 {t:470.33,s:"千人を超える人を、"},
 {t:472.02,s:"二十年あまり追いかけた調査に"},
 {t:474.66,s:"かかわっています。"},
 {t:476.36,s:"その調査では、多くの人が、"},
 {t:478.86,s:"退職にうまく適応していたと報告されています。"},
 {t:483.08,s:"仕事がなくなっても、"},
 {t:485.00,s:"その人らしさは、"},
 {t:486.53,s:"別の形で続いていたわけです。"},
 {t:489.22,s:"たとえば、長く技術者だった人。"},
 {t:492.37,s:"定年のあとも、"},
 {t:493.85,s:"壊れたものを見ると、"},
 {t:495.95,s:"つい直し方を考えてしまう。"},
 {t:498.68,s:"先生だった人は、"},
 {t:500.36,s:"相手が孫に変わっても、"},
 {t:502.68,s:"やはり説明がていねいです。"},
 {t:505.41,s:"ここで私は、"},
 {t:506.46,s:"エボーとアチュリーが、"},
 {t:508.39,s:"少し違うことを言っているのに気づきました。"},
 {t:512.06,s:"エボーが見ていたのは、離れることの重さです。"},
 {t:516.64,s:"真空があり、名残があり、"},
 {t:519.14,s:"元の自分を組み立て直す手間がある。"},
 {t:522.68,s:"アチュリーが見ていたのは、"},
 {t:525.01,s:"離れても続いていくもののほうです。"},
 {t:528.05,s:"正直に言うと、"},
 {t:529.76,s:"どちらが正しいのか、"},
 {t:532.20,s:"私には決められません。"},
 {t:534.88,s:"たぶん、両方とも本当なんだと思います。"},
 {t:539.52,s:"失ったものは、確かにある。"},
 {t:542.69,s:"でも、全部ではない。"},
 {t:545.12,s:"では、失ったのは何で、残ったのは何なのか。"},
 {t:549.29,s:"その境目を考えていて、"},
 {t:551.48,s:"役割という言葉そのものを、"},
 {t:554.06,s:"調べ直してみたんです。"},
 {t:556.25,s:"社会学では、"},
 {t:557.38,s:"役割というものを、"},
 {t:559.07,s:"ある立場にいる人に、"},
 {t:560.95,s:"まわりが寄せる期待のまとまりとして考えます。"},
 {t:565.08,s:"古くは一九三六年、"},
 {t:567.09,s:"アメリカの人類学者ラルフ・リントンが、"},
 {t:571.33,s:"地位と役割を分けて論じました。"},
 {t:574.68,s:"地位は、席のようなものです。役割は、"},
 {t:578.33,s:"その席に座った人に"},
 {t:580.15,s:"求められる振る舞いのことです。"},
 {t:583.19,s:"部長という席には、"},
 {t:584.93,s:"決める人であってほしい、"},
 {t:587.24,s:"という期待がついています。"},
 {t:589.75,s:"父親という席には、"},
 {t:591.49,s:"頼れる人であってほしい、"},
 {t:593.80,s:"という期待がついています。"},
 {t:596.31,s:"つまり役割とは、もともと、"},
 {t:599.20,s:"まわりの人が私に必要と"},
 {t:601.64,s:"していたものの形なんです。"},
 {t:604.53,s:"会社が回るために。"},
 {t:606.53,s:"家族が回るために。"},
 {t:608.53,s:"そう考えると、"},
 {t:609.91,s:"あの月曜日に起きたことが、"},
 {t:612.48,s:"少し違って見えてきました。"},
 {t:615.04,s:"部長という呼び名が消えたのは、会社が、"},
 {t:618.33,s:"もうその形を私に必要としなくなったからです。"},
 {t:622.15,s:"私という人間が、消えたからではありません。"},
 {t:625.79,s:"呼び名は、いつも向こう側から来ていました。"},
 {t:630.08,s:"部長、と呼ぶのは部下です。"},
 {t:632.74,s:"お父さん、と呼ぶのは子どもです。"},
 {t:636.02,s:"呼ぶ人がいなくなれば、呼び名は止まります。"},
 {t:640.31,s:"でも、呼ばれる前から、私はいました。"},
 {t:644.24,s:"部長になる前にも、"},
 {t:646.20,s:"私は何かを好きになり、"},
 {t:648.60,s:"何かに腹を立てていました。"},
 {t:651.44,s:"アチュリーが内側の継続性と呼んだのは、"},
 {t:655.21,s:"そこなんです。役割は、"},
 {t:657.40,s:"私がまわりのために引き受けていた形でした。"},
 {t:661.57,s:"私そのものでは、なかったんです。"},
 {t:664.75,s:"ただ、ここは、"},
 {t:665.91,s:"はっきり言っておかないといけません。"},
 {t:668.91,s:"エボーの話も、"},
 {t:670.13,s:"アチュリーの理論も、"},
 {t:671.87,s:"多くの人に見られる傾向を描いたものです。"},
 {t:675.34,s:"ひとりひとりに当ては"},
 {t:677.08,s:"まる決まりではありません。"},
 {t:679.34,s:"アチュリーの理論には、"},
 {t:681.25,s:"男性の働き方を基準にしすぎている、"},
 {t:684.21,s:"病気を抱えた人の老い方が抜けている、"},
 {t:687.34,s:"という批判も出されています。"},
 {t:689.77,s:"真空が数か月で終わる人もいれば、"},
 {t:693.27,s:"何年も続く人もいます。"},
 {t:695.68,s:"名残が、ずっと消えない人もいます。"},
 {t:699.41,s:"それも、この過程のひとつの形です。"},
 {t:703.13,s:"遅れているわけでも、"},
 {t:705.32,s:"失敗したわけでもありません。"},
 {t:708.38,s:"それから、いくつかの月曜日が過ぎました。"},
 {t:712.66,s:"私は今でも、六時半に目が覚めます。"},
 {t:716.19,s:"名残は、まだ残っています。"},
 {t:718.90,s:"それを無理に消そうとは、思わなくなりました。"},
 {t:723.47,s:"九時になっても、電話は鳴りません。"},
 {t:727.28,s:"部長、と呼ぶ人も、やはりいません。"},
 {t:731.09,s:"あの最初の月曜日と、同じ朝です。"},
 {t:734.67,s:"ただ、ある朝、気づいたことがあります。"},
 {t:738.56,s:"新聞を読みながら、"},
 {t:740.40,s:"私は赤いペンを持っていました。"},
 {t:743.48,s:"数字の合わない記事に、印をつけていたんです。"},
 {t:747.98,s:"誰に頼まれたわけでもありません。"},
 {t:751.19,s:"見せる相手もいません。"},
 {t:753.39,s:"それでも、手が勝手に動いていました。"},
 {t:757.00,s:"四十年、書類の数字を確かめてきた手です。"},
 {t:760.71,s:"部長の席がなくなっても、"},
 {t:762.94,s:"確かめずにいられない私は、"},
 {t:765.35,s:"ちゃんとここに残っていました。"},
 {t:768.13,s:"これを何と呼べばいいのか、"},
 {t:770.74,s:"私なりに考えても、"},
 {t:772.55,s:"まだうまく言えません。"},
 {t:774.75,s:"アチュリーなら、"},
 {t:776.36,s:"内側の継続性と呼ぶのだと思います。"},
 {t:779.76,s:"私は、これから何と呼ばれるんだろう。"},
 {t:783.46,s:"あの朝の問いには、実は、"},
 {t:785.93,s:"まだ答えが出ていません。"},
 {t:788.40,s:"ただ、問いの向きが変わりました。"},
 {t:791.22,s:"何と呼ばれるか、ではありません。"},
 {t:794.05,s:"誰にも呼ばれない九時に、"},
 {t:796.17,s:"自分が何をしているか、です。"},
 {t:800.13,s:"部長という呼び名は、"},
 {t:802.05,s:"会社が私を必要とした四十年のあいだ、"},
 {t:805.51,s:"預かっていた名前でした。"},
 {t:807.81,s:"その名前を返したあとも、"},
 {t:810.09,s:"赤いペンを持つ私は、"},
 {t:811.98,s:"ここにいます。"},
 {t:813.31,s:"名前がつく前から、ずっと、ここにいたんです。"}
];

/* =========================================================================
 * VÒNG CHÍNH — renderAtTime(t) TẤT ĐỊNH THUẦN
 * ========================================================================= */
/* Lần vẽ đầu bên trong HFA.makeTimeline bị bỏ qua: frame 0 là màn đen intro (uFade=0), còn biên dịch
 * ~30 shader (ANGLE/D3D) mất 3–4s — để nó rơi vào lần seek đầu, NGOÀI giới hạn điều hướng 10s
 * của HyperFrames (đã đo: tải trang 8–16s khi máy bận → snapshot fail 'Navigation timeout'). */
var _BOOT = true;
function renderAtTime(t){
  /* LEADTAIL:APPLIED — dịch timeline sang phải 2s cho intro lặng.
     Cảnh vẫn dùng mốc gốc của timing.json; chỉ tới muộn hơn 2s. */
  var _tReal = t;                    /* thời gian THẬT của video, cho phụ đề */
  t = Math.max(0, t - 2);   /* thời gian CẢNH, đã trừ intro */

  if(_BOOT) return;
  t = clamp(t, 0, SCENE_END);
  UT.value = t;
  resetFrame();
  var key = sceneAt(t);
  SHOT[key](loc(t, key), t);
  var dip = 1, idx = SCENE_KEYS.indexOf(key);
  var a = SC[key][0], b = SC[key][1];
  var dl = LONG_DIP[key] ? 0.9 : 0.3;
  if(idx > 0 && !NO_DIP[key]) dip = Math.min(dip, smooth((t - a)/dl)*0.88 + 0.12*(LONG_DIP[key]?0:1));
  var nk = SCENE_KEYS[idx+1], dl2 = (nk && LONG_DIP[nk]) ? 0.9 : 0.3;
  if(nk && !NO_DIP[nk]) dip = Math.min(dip, smooth((b - t)/dl2)*0.88 + 0.12*((nk && LONG_DIP[nk])?0:1));
  lens.uniforms.uFade.value = smooth(t/1.4) * dip;
  lens.uniforms.uT.value = t;
  grade.uniforms.uSat.value = FX.sat; grade.uniforms.uMul.value.set(FX.mul[0], FX.mul[1], FX.mul[2]);
  /* near theo khoảng cách nhìn: bộ đệm sâu của target MSAA hữu hạn — near quá nhỏ làm các lớp mỏng (trang lịch, mực) z-fight */
  camera.near = clamp(camera.position.distanceTo(_look)*0.05, 0.004, 0.15);
  camera.updateProjectionMatrix();
  USCALE.value = H/(2*Math.tan(camera.fov*Math.PI/360));
  bg.position.copy(camera.position);
  FIG.root.updateMatrixWorld(true); FIG.spine.localToWorld(CORE_UNI.uCoreP.value.copy(CORE_LOCAL));
  HFA.applySubtitle(subEl, CUES, _tReal);
  /* LEADTAIL:APPLIED — màn hình đen 5s cuối: nhạc chạy tiếp, hình tắt dần. */
  (function(){
    var ob = document.getElementById('outro-black');
    if(!ob) return;
    var f = (_tReal - 817.65) / 1.2;         /* 1.2s chuyển sang đen */
    ob.style.opacity = String(Math.max(0, Math.min(1, f)));
  })();
  HFA.applyChapter(chapEl, CHAPTERS, _tReal, 5.5);
  composer.render();
}

/* ⚠ Dòng đăng ký phải nằm NGUYÊN DẠNG trong file này — StaticGuard quét VĂN BẢN.
 * Khoá trùng ĐÚNG data-composition-id của div gốc. */
if(!GLYPH_OK && fontReady()) GLYPH_OK = true;
window.__timelines = window.__timelines || {};
window.__timelines["yakuwari"] = HFA.makeTimeline("yakuwari", TOTAL, renderAtTime);
_BOOT = false;
</script>
</body>
</html>
