PL.otto = makePlate('夫',    {a:0.062, b:0.062, th0:0.05, th1:1.55, y0:-0.215, y1:-0.085, thick:0.009, relief:0.005, nu:120}, 13);
PL.senpai = makePlate('先輩', {a:0.062, b:0.062, th0:-1.6, th1:-0.1, y0:-0.26, y1:-0.05, thick:0.009, relief:0.005, nu:120, vertical:true}, 14);
FIG.spine.add(PL.bucho.pivot); FIG.spine.add(PL.chichi.pivot);
