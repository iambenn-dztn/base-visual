  var keyTex = canvasTex(256,256,function(cx,w,h){ cx.fillStyle = '#e6e1d6'; cx.fillRect(0,0,w,h); cx.fillStyle = '#b8b2a4';
    for(var i=0;i<4;i++) for(var j=0;j<3;j++){ cx.fillRect(40+j*62, 60+i*46, 44, 30); }
    cx.fillStyle = '#5a5650'; cx.fillRect(40,14,176,30); });
  var pad = new THREE.Mesh(new THREE.PlaneGeometry(0.1,0.1), new THREE.MeshStandardMaterial({map:keyTex, roughness:0.5})); pad.rotation.x = -Math.PI/2-0.12; pad.position.set(0.04,0.677,0.02); g.add(pad);
  /* tay nghe: thân cong + hai đầu loe (nghe/nói) — một khối ống nắn, không ghép cầu */
  var hsP = []; for(var hi=0;hi<=24;hi++){ var z = -0.1 + hi*(0.2/24); var e = Math.abs(z)/0.1; hsP.push(new THREE.Vector3(0, 0.012*Math.pow(e,6), z)); }
  var hsC = new THREE.CatmullRomCurve3(hsP);
  var hsG = new THREE.TubeGeometry(hsC, 40, 0.017, 16, false); var hsA = hsG.attributes.position;
  for(var hj=0;hj<hsA.count;hj++){ var zz = hsA.getZ(hj), ee = Math.abs(zz)/0.1; var sw = 1 + 0.7*Math.pow(clamp((ee-0.7)/0.3,0,1),1.5); var cy0 = 0.012*Math.pow(ee,6); hsA.setX(hj, hsA.getX(hj)*sw*1.35); hsA.setY(hj, cy0 + (hsA.getY(hj)-cy0)*sw); }
  hsG.computeVertexNormals();
  var hs = new THREE.Mesh(hsG, ivory); hs.position.set(-0.075,0.692,0); hs.castShadow = true; g.add(hs);
  var cap1 = new THREE.Mesh(new THREE.CircleGeometry(0.028,24), ivory); cap1.scale.set(1.35,1,1); cap1.rotation.y = Math.PI; cap1.position.set(-0.075,0.704,-0.1); g.add(cap1);
  var cap2 = cap1.clone(); cap2.rotation.y = 0; cap2.position.z = 0.1; g.add(cap2);
  var cord = []; for(var ci=0;ci<=240;ci++){ var s = ci/240, a = s*Math.PI*2*28; cord.push(new THREE.Vector3(-0.15 + 0.012*Math.cos(a), 0.64 + 0.012*Math.sin(a) - 0.03*Math.sin(s*Math.PI), 0.09 - s*0.16)); }
  var cordM = new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(cord), 600, 0.0022, 6, false), ivory); g.add(cordM);
  var lcd = new THREE.Mesh(new THREE.PlaneGeometry(0.07,0.022), new THREE.MeshStandardMaterial({color:0x7c8a74, roughness:0.3})); lcd.rotation.x = -Math.PI/2-0.12; lcd.position.set(0.04,0.679,-0.055); g.add(lcd);
  var led = new THREE.Mesh(new THREE.SphereGeometry(0.004,8,6), new THREE.MeshBasicMaterial({color:0x221010})); led.position.set(0.08,0.68,-0.06); g.add(led);
})();

/* ---- lịch treo tường: 10月→3月, 3月31日 khoanh đỏ 「定年退職」 ---- */
var CAL_MONTHS = [10,11,12,1,2,3,4];   /* 4月 = trang sau cùng, hiện ở chương 1/4 (tháng đầu sau nghỉ hưu) */
var CAL = {pages:[]};
(function buildCalendar(){
  var g = new THREE.Group(); g.position.set(0.18, 1.62, -1.79); ROOM.add(g); CAL.g = g;
  var nail = new THREE.Mesh(new THREE.SphereGeometry(0.006,8,6), std(0x777777,0.3,0.9)); nail.position.set(0,0.02,0.01); g.add(nail);
  var back = new THREE.Mesh(new THREE.BoxGeometry(0.42,0.6,0.004), std(0xf0ece4,0.9)); back.position.set(0,-0.3,0.003); back.castShadow = true; g.add(back);
  function pageTex(mo, finalPage){
    return canvasTex(700,1000,function(cx,w,h){
      cx.fillStyle = '#f8f6f1'; cx.fillRect(0,0,w,h);
      cx.fillStyle = '#2a2622'; cx.textAlign = 'center'; cx.textBaseline = 'middle';
      cx.font = '700 150px '+JP; cx.fillText(mo+'月', w/2, 150);
      var days = ['日','月','火','水','木','金','土']; cx.font = '400 34px '+JP;
      for(var d=0;d<7;d++){ cx.fillStyle = d===0 ? '#b8322a' : (d===6 ? '#2f5a9a' : '#2a2622'); cx.fillText(days[d], 70+d*93, 300); }
      var first = {10:3,11:6,12:1,1:4,2:0,3:0,4:3}[mo], nd = {10:31,11:30,12:31,1:31,2:28,3:31,4:30}[mo];
      cx.font = '700 44px '+JP;
      for(var k=1;k<=nd;k++){ var idx = first + k - 1, col = idx%7, row = Math.floor(idx/7);
        cx.fillStyle = col===0 ? '#b8322a' : (col===6 ? '#2f5a9a' : '#2a2622');
        cx.fillText(String(k), 70+col*93, 380+row*100); }
      if(finalPage){
        var idx2 = first + 30, c2 = idx2%7, r2 = Math.floor(idx2/7), px = 70+c2*93, py = 380+r2*100;
        cx.strokeStyle = '#c0281c'; cx.lineWidth = 7; cx.beginPath(); cx.ellipse(px, py, 44, 38, -0.1, 0, 7); cx.stroke();
        cx.fillStyle = '#c0281c'; cx.font = '700 40px '+JP; cx.textAlign = 'center'; cx.fillText('定年退職', Math.min(px, w-110), py+62);
      }
    });
  }
  for(var i=0;i<CAL_MONTHS.length;i++){
    var hinge = new THREE.Group(); hinge.position.set(0,-0.01,0.006 + (CAL_MONTHS.length-i)*0.0022); g.add(hinge);
    var pm = new THREE.MeshStandardMaterial({roughness:0.85, side:THREE.DoubleSide});
    (function(pm, mo, fin){ glyphAsset(function(){ if(pm.map) pm.map.dispose(); pm.map = pageTex(mo, fin); pm.needsUpdate = true; }); })(pm, CAL_MONTHS[i], CAL_MONTHS[i]===3);
    var pg = new THREE.Mesh(new THREE.PlaneGeometry(0.4,0.57), pm); pg.position.y = -0.295; pg.castShadow = true; hinge.add(pg);
    CAL.pages.push(hinge);
  }
  var ring = new THREE.Mesh(new THREE.BoxGeometry(0.42,0.02,0.012), std(0x333333,0.4,0.6)); ring.position.set(0,-0.005,0.01); g.add(ring);
})();
/** lật lịch: p ∈ [0, N-1] — trang i lật lên khi p vượt i (xoay quanh mép trên, như lịch thật) */
function setCalendar(p){
  for(var i=0;i<CAL.pages.length;i++){
    var k = clamp(p - i, 0, 1);
    var e = k*k*(3-2*k);
    CAL.pages[i].rotation.x = -e*2.6;
    CAL.pages[i].visible = k < 0.999;
  }
}

/* ---- đèn nắng ô cửa: cột sáng thể tích + bụi (chỉ trong phòng) ---- */
var SUN_DIR = new THREE.Vector3(1.0,-0.42,0.16).normalize();
(function buildBeam(){
  var bm = new THREE.ShaderMaterial({
    uniforms:{ uOp:{value:1}, uT:UT, uCol:{value:new THREE.Color(1.0,0.93,0.8)} },
    vertexShader:'attribute float aL; varying float vL; varying vec3 vW; void main(){ vL=aL; vec4 w=modelMatrix*vec4(position,1.0); vW=w.xyz; gl_Position=projectionMatrix*viewMatrix*w; }',
    fragmentShader:'uniform float uOp,uT; uniform vec3 uCol; varying float vL; varying vec3 vW;'+
      'void main(){ float n=0.8+0.2*sin(vW.y*3.1+vW.z*2.3+uT*0.2); float a=(1.0-vL)*0.05*n; gl_FragColor=vec4(uCol*a*uOp,1.0); }',
    transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, side:THREE.DoubleSide });
  /* khe mở: z∈[-0.9,0], y∈[0.05,1.82], tại x=-1.8 */
  var c0 = [[-1.8,0.08,-0.88],[-1.8,0.08,-0.02],[-1.8,1.8,-0.02],[-1.8,1.8,-0.88]];
  var pos = [], al = [];
  for(var i=0;i<4;i++){ pos.push(c0[i][0],c0[i][1],c0[i][2]); al.push(0); }
  for(var j=0;j<4;j++){ var s = 1.8*0.0 + c0[j][1]/Math.abs(SUN_DIR.y); pos.push(c0[j][0]+SUN_DIR.x*s, c0[j][1]+SUN_DIR.y*s, c0[j][2]+SUN_DIR.z*s); al.push(1); }
  var idx = [0,1,5, 0,5,4, 1,2,6, 1,6,5, 2,3,7, 2,7,6, 3,0,4, 3,4,7];
  var g = new THREE.BufferGeometry(); g.setAttribute('position', new THREE.Float32BufferAttribute(pos,3)); g.setAttribute('aL', new THREE.Float32BufferAttribute(al,1)); g.setIndex(idx);
  var m = new THREE.Mesh(g, bm); m.renderOrder = 10; ROOM.add(m); RM.beamM = bm;
  var dust = makeDyn(900, {maxPx:4, near:0.25});
  var rd = HFA.mulberry32(91), B = [];
  for(var q=0;q<900;q++){ var y0 = 0.1 + rd()*1.7, along = rd()*(y0/Math.abs(SUN_DIR.y)); B.push(-1.8 + SUN_DIR.x*along, y0 + SUN_DIR.y*along, -0.86 + rd()*0.82 + SUN_DIR.z*along, rd(), 0.003+rd()*0.004); }
  dust.userData.B = B; ROOM.add(dust); RM.dust = dust;
})();
function roomDust(t, amt){
  var d = RM.dust, P = d.geometry.attributes.position.array, A = d.geometry.attributes.aA.array, C = d.geometry.attributes.aC.array, S = d.geometry.attributes.aS.array, B = d.userData.B;
  for(var i=0;i<900;i++){ var b = i*5, ph = B[b+3]*6.283;
    P[i*3] = B[b] + 0.03*Math.sin(t*0.13+ph); P[i*3+1] = B[b+1] + 0.02*Math.sin(t*0.09+ph*1.7); P[i*3+2] = B[b+2] + 0.03*Math.cos(t*0.11+ph);
    A[i] = amt*(0.5+0.5*Math.sin(t*0.7+ph*3.0)); C[i*3]=1.0; C[i*3+1]=0.93; C[i*3+2]=0.8; S[i] = B[b+4]; }
  dynCommit(d);
}

/* ---- futon + đồng hồ báo thức cạnh gối ---- */
var FUTON = new THREE.Group(); ROOM.add(FUTON); RM.futon = FUTON;
var FUT_P = new THREE.Vector3(-0.55, 0, 0.35);
(function buildFuton(){
  FUTON.position.copy(FUT_P);
  function roundBox(w,h,d,rad,col){ var g = new THREE.BoxGeometry(w,h,d,12,4,24), P = g.attributes.position, v = new THREE.Vector3();
    for(var i=0;i<P.count;i++){ v.fromBufferAttribute(P,i); var ax = Math.abs(v.x)-(w/2-rad), ay = Math.abs(v.y)-(h/2-rad*0.6), az = Math.abs(v.z)-(d/2-rad);
      var ox = Math.max(0,ax), oy = Math.max(0,ay), oz = Math.max(0,az), L = Math.sqrt(ox*ox+oy*oy+oz*oz);
      if(L>0){ var k = Math.min(L, rad)/L; v.x = Math.sign(v.x)*((w/2-rad) + ox*k*0.85); v.z = Math.sign(v.z)*((d/2-rad) + oz*k*0.85); if(ay>0) v.y = Math.sign(v.y)*((h/2-rad*0.6)+oy*k*0.85); }
      P.setXYZ(i, v.x, v.y, v.z); }
    g.computeVertexNormals(); var m = new THREE.Mesh(g, col); m.castShadow = true; m.receiveShadow = true; return m; }
  var sheet = canvasTex(256,256,function(cx,w,h){ cx.fillStyle = '#e9e6de'; cx.fillRect(0,0,w,h); }, [1,1]);
  var mat = roundBox(1.0,0.09,2.0,0.05, new THREE.MeshStandardMaterial({map:sheet, roughness:0.95})); mat.position.y = 0.045; FUTON.add(mat);
  var pil = roundBox(0.45,0.1,0.26,0.05, std(0xd9d2c0,0.92)); pil.position.set(0,0.13,-0.72); FUTON.add(pil);
  /* 掛け布団 phủ hai chân tới hông — mặt lưới dịch chuyển theo khối chân (hàm, không vật lý) */
  var ktex = canvasTex(512,512,function(cx,w,h){ cx.fillStyle = '#6f8298'; cx.fillRect(0,0,w,h); var q = HFA.mulberry32(3);
    cx.strokeStyle = 'rgba(230,236,244,0.35)'; cx.lineWidth = 3; for(var i=0;i<40;i++){ var x = q()*w, y = q()*h; cx.beginPath(); cx.arc(x,y,10+q()*18,0,7); cx.stroke(); } });
  var kg = new THREE.PlaneGeometry(1.2,1.25,48,48); kg.rotateX(-Math.PI/2);
  var P = kg.attributes.position;
  for(var i=0;i<P.count;i++){ var x = P.getX(i), z = P.getZ(i);
    var legs = 0.11*Math.exp(-Math.pow((x-0.09)/0.09,2)) + 0.11*Math.exp(-Math.pow((x+0.09)/0.09,2)) + 0.07*Math.exp(-Math.pow(x/0.2,2));
    var edge = Math.min(1, (0.6-Math.abs(x))/0.12);
    var y = 0.1 + legs*clamp((z+0.62)/0.2,0,1) * clamp(edge,0,1) + 0.012*Math.sin(x*18+z*7) - 0.08*Math.pow(clamp((Math.abs(x)-0.48)/0.12,0,1),2);
    P.setY(i, y); }
  kg.computeVertexNormals();
  var kake = new THREE.Mesh(kg, new THREE.MeshStandardMaterial({map:ktex, roughness:0.9, side:THREE.DoubleSide})); kake.position.set(0,0,0.36); kake.castShadow = true; kake.receiveShadow = true; FUTON.add(kake);
  FUTON.userData.kake = kake;
})();
var ALARM = makeClock(0.05, 0.045, 0xd9d4ca, false);
ALARM.position.set(0.07, 0.056, -0.42); ALARM.rotation.set(-0.05, 0.25, 0); ROOM.add(ALARM);
(function(){ /* chân + nút gạt OFF */
  var ftM = std(0x8a8478,0.5);
  var f1 = new THREE.Mesh(new THREE.BoxGeometry(0.02,0.012,0.02), ftM); f1.position.set(-0.03,-0.052,0); ALARM.add(f1);
  var f2 = f1.clone(); f2.position.x = 0.03; ALARM.add(f2);
  var sw = new THREE.Mesh(new THREE.BoxGeometry(0.012,0.008,0.02), std(0x3a3a3a,0.5)); sw.position.set(-0.02,0.056,-0.005); ALARM.add(sw);
})();

/* ---- ME: 私 — 60 tuổi, tóc bạc ---- */
var ME = buildHuman({skin:0xc49e82, top:0xe9e7e2, bot:0x55575c, hair:0x8e8a84, collar:0xf0eee8, shoe:0x2a3040});
ROOM.add(ME.root);
var SHIRT_COL = new THREE.Color(0xe9e7e2), PJ_COL = new THREE.Color(0x8d9aa8), CARDI_COL = new THREE.Color(0x7a6450);
function meClothes(kind){
  var c = kind === 'pj' ? PJ_COL : (kind === 'cardi' ? CARDI_COL : SHIRT_COL);
  ME.M.top.color.copy(c);
  ME.M.bot.color.set(kind === 'pj' ? 0x7d8a98 : 0x55575c);
  ME.M.collar.color.set(kind === 'cardi' ? 0xf0eee8 : (kind==='pj' ? 0x8d9aa8 : 0xf0eee8));
}
/* quầng lõi trên người thật (chương 4): cùng màu, cùng cỡ với lõi của ma-nơ-canh */
var meCore = makeGlow(CORE_COL, 0.0, 0.06, 0.22, true);   /* không kiểm độ sâu: sáng XUYÊN qua ngực áo */
meCore.position.set(0, 0.36, 0.05); ME.spine.add(meCore);
/* vệt "名残" trên ngực áo thật (C31): viền tấm bảng mờ, cùng hình với tấm 部長 */
var meResid = null;   /* dựng sau khi có hình tấm đồng */

/* ---- BÀN TAY cận cảnh + bút đỏ + báo ---- */
var HANDP = buildHand(0xc49e82, 0x7a6450);
var PEN = new THREE.Group();
(function(){
  var red = std(0xb3231a, 0.35, 0.1);
  var body = new THREE.Mesh(new THREE.CylinderGeometry(0.0055,0.0055,0.13,20), red); body.position.y = 0.075; PEN.add(body);
  var grip = new THREE.Mesh(new THREE.CylinderGeometry(0.006,0.0058,0.035,20), std(0x2a2a2a,0.7)); grip.position.y = 0.022; PEN.add(grip);
  var cone = new THREE.Mesh(new THREE.ConeGeometry(0.0058,0.012,20), std(0xc8c8c8,0.3,0.9)); cone.rotation.x = Math.PI; cone.position.y = 0.0; PEN.add(cone);
  var clip = new THREE.Mesh(new THREE.BoxGeometry(0.002,0.04,0.003), std(0xc8c8c8,0.3,0.9)); clip.position.set(0,0.12,0.0065); PEN.add(clip);
  PEN.traverse(function(o){ if(o.isMesh) o.castShadow = true; });
})();
var HANDRIG = new THREE.Group(); HANDRIG.add(HANDP); HANDRIG.add(PEN);
/* bút nằm giữa ngón cái và ngón trỏ: đầu bút là gốc của rig */
PEN.rotation.set(0, 0, 0.62); PEN.position.set(0,0,0);
/* Đặt bàn tay theo bút (đầu bút = gốc rig): khớp điểm kẹp P1 và khe ngón P2 của bàn tay vào trục bút,
 * mu tay hướng lên-phải. Tay PHẢI = gương trục z (three tự lật frontFace khi det<0). */
(function(){
  var V = THREE.Vector3;
  var P1 = new V(0.122,-0.032,0.036), P2 = new V(0.03,0.028,0.048);
  var d = P1.clone().sub(P2).normalize(), tip = P1.clone().addScaledVector(d, 0.036);
  var tipS = new V(tip.x, tip.y, -tip.z), dS = new V(d.x, d.y, -d.z);
  var e1 = dS.clone().negate(), e2 = new V(0,1,0).addScaledVector(e1, -e1.y).normalize(), e3 = new V().crossVectors(e1, e2);
  var a = new V(-Math.sin(0.62), Math.cos(0.62), 0), hint = new V(0.25, 0.55, 0.8).normalize();
  var f2 = hint.clone().addScaledVector(a, -hint.dot(a)).normalize(), f3 = new V().crossVectors(a, f2);
  var L = new THREE.Matrix4().makeBasis(e1, e2, e3), Tg = new THREE.Matrix4().makeBasis(a, f2, f3);
  var R = new THREE.Matrix4().multiplyMatrices(Tg, new THREE.Matrix4().copy(L).transpose());
  HANDP.quaternion.setFromRotationMatrix(R); HANDP.scale.set(1,1,-1);
  HANDP.position.copy(tipS.applyMatrix4(R).negate());
})();
handPenPose(HANDP, 0);
ROOM.add(HANDRIG); RM.handRig = HANDRIG;

/* báo: nền chữ dựng một lần; mực đỏ vẽ trên canvas RIÊNG theo t (không chữ → không phụ thuộc font) */
var NEWS = {};
(function buildNews(){
  var g = new THREE.Group(); g.position.set(TABLE_P.x+0.05, TABLE_TOP_Y+0.001, TABLE_P.z+0.12); g.rotation.y = -0.12; ROOM.add(g); NEWS.g = g;
  var baseM = new THREE.MeshStandardMaterial({roughness:0.9});
  glyphAsset(function(){
    if(baseM.map) baseM.map.dispose();
    baseM.map = canvasTex(1400,1000,function(cx,w,h){
      cx.fillStyle = '#e8e3d6'; cx.fillRect(0,0,w,h);
      cx.fillStyle = '#1e1c1a'; cx.textBaseline = 'top';
      cx.font = '700 64px '+JP; cx.fillText('市の予算、前年比で見直しへ', 60, 40);
      cx.fillRect(60,125,w-120,3);
      var q = HFA.mulberry32(404);
      var body = '市は二〇二五年度の一般会計予算案を発表した。総額は八百四十二億円で、前年度より三・二％増えた。内訳をみると、福祉関係が三百十二億円、教育関係が百五十八億円、道路などの整備が九十六億円となっている。前年度の福祉関係は二百九十八億円で、増加率は四・七％とされる。';
      cx.font = '400 30px '+JP;
      var cols = 6, colW = (w-120)/cols, y0 = 160;
      for(var c=0;c<cols;c++){ var x0 = 60 + c*colW; var line = 0;
        for(var L=0; L<22; L++){ var off = Math.floor(q()*(body.length-18)); cx.fillText(body.substr(off, 7), x0+8, y0 + L*36); } }
      /* số liệu nổi bật để khoanh: ba ô số */
      cx.font = '700 40px '+JP; cx.fillStyle = '#1e1c1a';
      cx.fillText('842億円', 300, 470); cx.fillText('3.2％', 720, 470); cx.fillText('4.7％', 1030, 690);
    });
    baseM.needsUpdate = true;
  });
  var paper = new THREE.Mesh(new THREE.PlaneGeometry(0.56,0.4), baseM); paper.rotation.x = -Math.PI/2; paper.receiveShadow = true; g.add(paper);
  /* lớp mực đỏ */
  var ink = document.createElement('canvas'); ink.width = 1400; ink.height = 1000;
  var inkTx = new THREE.CanvasTexture(ink); inkTx.encoding = THREE.sRGBEncoding; inkTx.anisotropy = MAXANI;
  var inkM = new THREE.MeshBasicMaterial({map:inkTx, transparent:true, depthWrite:false, color:new THREE.Color(0.62,0.6,0.58)});
  var inkP = new THREE.Mesh(new THREE.PlaneGeometry(0.56,0.4), inkM); inkP.rotation.x = -Math.PI/2; inkP.position.y = 0.0006; g.add(inkP);
  NEWS.ink = ink; NEWS.inkTx = inkTx; NEWS.lastKey = '';
  /* ba vòng khoanh (px trên canvas) */
  NEWS.circles = [[375,492,105,44],[775,492,85,44],[1085,712,85,44]];
})();
/** mực đỏ tại tiến độ k ∈ [0,3]: vòng i vẽ dần khi k vượt i. Trả về điểm đầu bút (canvas px). */
function newsInk(k){
  var key = k.toFixed(3);
  var C = NEWS.circles, tip = null;
  var cx = NEWS.ink.getContext('2d',{willReadFrequently:true});
  if(key !== NEWS.lastKey){
    cx.clearRect(0,0,1400,1000);
    cx.strokeStyle = '#c1261c'; cx.lineWidth = 7; cx.lineCap = 'round';
    for(var i=0;i<C.length;i++){ var p = clamp(k - i, 0, 1); if(p <= 0) continue;
      cx.beginPath(); var a0 = -2.4, a1 = a0 + p*Math.PI*2.15;
      for(var s=0;s<=60;s++){ var a = a0 + (a1-a0)*s/60, rr = 1 + 0.04*Math.sin(a*3+i);
        var x = C[i][0] + Math.cos(a)*C[i][2]*rr, y = C[i][1] + Math.sin(a)*C[i][3]*rr; if(s===0) cx.moveTo(x,y); else cx.lineTo(x,y); }
      cx.stroke(); }
    NEWS.inkTx.needsUpdate = true; NEWS.lastKey = key;
  }
  var j = Math.min(C.length-1, Math.floor(clamp(k,0,2.999))), pp = clamp(k - j, 0, 1);
  var aa = -2.4 + pp*Math.PI*2.15;
  return [C[j][0] + Math.cos(aa)*C[j][2], C[j][1] + Math.sin(aa)*C[j][3], pp>0 && pp<1 ? 1 : 0];
}
/** điểm canvas (px) → world trên mặt báo */
function newsWorld(px, py, out){
  _va.set((px/1400 - 0.5)*0.56, 0, (py/1000 - 0.5)*0.4);
  NEWS.g.updateMatrixWorld(true);
  return out.copy(_va).applyMatrix4(NEWS.g.matrixWorld);
}

/* ---------------- 玄関 (C04) — đặt xa phòng, không che nhau ---------------- */
var GEN = reg('genkan', new THREE.Group()); GEN.position.set(30,0,0);
(function buildGenkan(){
  var r = HFA.mulberry32(700);
  var tileTex = canvasTex(1024,1024,function(cx,w,h){ cx.fillStyle = '#4a4744'; cx.fillRect(0,0,w,h);
    for(var i=0;i<4;i++) for(var j=0;j<4;j++){ var v = 70 + Math.floor(r()*18); cx.fillStyle = 'rgb('+v+','+(v-2)+','+(v-5)+')'; cx.fillRect(i*256+3,j*256+3,250,250);
    } addNoise(cx, w, h, 701, 30); }, [3,2]);
  var tile = new THREE.Mesh(new THREE.PlaneGeometry(2.4,1.6), new THREE.MeshStandardMaterial({map:tileTex, roughness:0.35})); tile.rotation.x = -Math.PI/2; tile.position.set(0,0,0.8); tile.receiveShadow = true; GEN.add(tile);
  /* sàn gỗ nâng + 上がり框 */
  var fl = boxIn(GEN, 2.4,0.2,2.0, 0,0.1,-1.0, std(0x8a6a4a,0.5)); fl.material.map = RM.woodM.map;
  var kamachi = boxIn(GEN, 2.4,0.2,0.1, 0,0.1,0.02, std(0x5a3c22,0.35));
  boxIn(GEN, 0.1,2.4,3.6, -1.25,1.2,0, RM.wallM); boxIn(GEN, 0.1,2.4,3.6, 1.25,1.2,0, RM.wallM);
  boxIn(GEN, 2.6,2.6,0.1, 0,1.3,-2.0, RM.wallM);   /* tường cuối hành lang */
  var glow = new THREE.Mesh(new THREE.PlaneGeometry(0.8,1.9), new THREE.MeshBasicMaterial({color:new THREE.Color(0.9,0.85,0.75)})); glow.position.set(0.55,1.15,-1.94); GEN.add(glow);   /* cửa phòng khách hé sáng */
  /* cửa kéo kính mờ phía trước — sáng buổi sáng */
  var door = new THREE.Mesh(new THREE.PlaneGeometry(1.6,2.0), new THREE.MeshBasicMaterial({color:new THREE.Color(1.7,1.66,1.58)})); door.position.set(0,1.0,1.62); door.rotation.y = Math.PI; GEN.add(door);
  var frM = std(0x3a342e,0.5);
  boxIn(GEN, 0.05,2.0,0.05, -0.8,1.0,1.6, frM); boxIn(GEN, 0.05,2.0,0.05, 0.8,1.0,1.6, frM); boxIn(GEN, 0.05,2.0,0.05, 0,1.0,1.6, frM);
  for(var k=1;k<5;k++) boxIn(GEN, 1.6,0.02,0.03, 0,k*0.4,1.6, frM, true);
  /* giày da: cầu nắn thành giày (một khối liền), đế tách màu */
  /* giày da: đế = đường viền bàn chân đùn dày; thân = cùng đường viền đùn có vát lớn (bo tròn),
   * nắn cao dần về gót; miệng giày là lỗ tối phía sau; gót tách khối. Một khối liền, không ghép cầu. */
  function footOutline(scale){
    var sh = new THREE.Shape(), n = 40, pts = [];
    for(var i=0;i<=n;i++){ var a = i/n*Math.PI*2;
      var z = Math.sin(a) >= 0 ? 0.135*Math.sin(a) : 0.13*Math.sin(a);
      var zz = z/0.135, w = 0.047*(1 - 0.28*zz*zz*(zz>0?1.4:0.6)) * (1 + 0.1*Math.max(0,zz-0.1)*(Math.cos(a)<0?1:0));
      pts.push(new THREE.Vector2(Math.cos(a)*w*scale, z*scale)); }
    sh.setFromPoints(pts); return sh;
  }
  function shoe(){
    var grp = new THREE.Group();
    var leather = new THREE.MeshStandardMaterial({color:0x3b2417, roughness:0.3, metalness:0.0, envMapIntensity:1.2});
    var ug = new THREE.ExtrudeGeometry(footOutline(0.86), {depth:0.03, bevelEnabled:true, bevelThickness:0.028, bevelSize:0.012, bevelSegments:6, curveSegments:40});
    ug.rotateX(-Math.PI/2);   /* đùn theo +y; toạ độ shape (x, z) → (x, -?, ...) */
    var P = ug.attributes.position;
    for(var i=0;i<P.count;i++){ var x = P.getX(i), y = P.getY(i), z = -P.getZ(i);
      var hz = 0.7 + 0.55*clamp((-z+0.02)/0.13,0,1);          /* cao dần về gót */
      var toe = clamp((z-0.06)/0.07,0,1);
      y = y*hz*(1 - 0.35*toe) + 0.004*toe;                     /* mũi giày thấp, hơi vểnh */
      P.setXYZ(i, x, y + 0.012, z); }
    ug.computeVertexNormals();
    var up = new THREE.Mesh(ug, leather); up.castShadow = true; up.receiveShadow = true; grp.add(up);
    var sg = new THREE.ExtrudeGeometry(footOutline(0.93), {depth:0.012, bevelEnabled:false, curveSegments:40}); sg.rotateX(-Math.PI/2);
    var SP = sg.attributes.position; for(var j=0;j<SP.count;j++) SP.setZ(j, -SP.getZ(j));
    sg.computeVertexNormals();
    var sole = new THREE.Mesh(sg, std(0x1b1512,0.7)); sole.castShadow = true; sole.receiveShadow = true; grp.add(sole);
    var heel = new THREE.Mesh(new THREE.BoxGeometry(0.068,0.018,0.06), std(0x1b1512,0.7)); heel.position.set(0,-0.006,-0.095); grp.add(heel);
    var open = new THREE.Mesh(new THREE.CircleGeometry(1,40), std(0x0b0807,0.95)); open.scale.set(0.03,0.052,1); open.rotation.x = -Math.PI/2 + 0.18; open.position.set(0,0.083,-0.075); grp.add(open);
    var lace = new THREE.Mesh(new THREE.PlaneGeometry(0.03,0.04), std(0x140d09,0.6)); lace.rotation.x = -Math.PI/2 + 0.55; lace.position.set(0,0.072,-0.005); grp.add(lace);
    grp.position.y = 0.012;
    return grp;
  }
  var s1 = shoe(); s1.position.set(-0.07,0.018,0.32); s1.rotation.y = 0.04; GEN.add(s1);
  var s2 = shoe(); s2.position.set(0.07,0.018,0.32); s2.rotation.y = -0.04; GEN.add(s2);
  GEN.userData.me = buildHuman({skin:0xc49e82, top:0xe9e7e2, bot:0x55575c, hair:0x8e8a84, collar:0xf0eee8, shoe:0x2a3040});
  GEN.add(GEN.userData.me.root);
})();

/* =========================================================================
 * KHÔNG GIAN TRỪU TƯỢNG (chương 2–3): nền tối trung tính ấm, một vũng sáng từ trên
 * ========================================================================= */
var VOID = reg('void', new THREE.Group());
var VD = {};
(function buildVoid(){
  var flTex = canvasTex(1024,1024,function(cx,w,h){ var q = HFA.mulberry32(501);
    var g = cx.createRadialGradient(w/2,h/2,10,w/2,h/2,w/2); g.addColorStop(0,'#2a2622'); g.addColorStop(0.05,'#1c1916'); g.addColorStop(0.11,'#070606'); g.addColorStop(0.2,'#000000'); g.addColorStop(1,'#000000');
    cx.fillStyle = g; cx.fillRect(0,0,w,h);
    addNoise(cx, w, h, 503, 10); });
  VD.floorM = new THREE.MeshStandardMaterial({map:flTex, roughness:0.92, metalness:0.0, transparent:true, opacity:1, envMapIntensity:0.0});
  var fl = new THREE.Mesh(new THREE.CircleGeometry(40, 96), VD.floorM); fl.rotation.x = -Math.PI/2; fl.receiveShadow = true; VOID.add(fl); VD.floor = fl;
  /* bụi lơ lửng — chiều sâu cho khoảng tối (hàm của t, không tích luỹ) */
  var N = 1400, d = makeDyn(N, {maxPx:5, near:0.6}), rd = HFA.mulberry32(502), B = [];
  for(var i=0;i<N;i++){ var a = rd()*6.283, rr = 0.6 + Math.pow(rd(),0.6)*7.5; B.push(Math.cos(a)*rr, 0.05+rd()*3.8, Math.sin(a)*rr - 0.5, rd(), 0.004+rd()*0.008); }
  d.userData.B = B; VOID.add(d); VD.dust = d;
})();
function voidDust(t, amt, rise){
  var d = VD.dust, P = d.geometry.attributes.position.array, A = d.geometry.attributes.aA.array, C = d.geometry.attributes.aC.array, S = d.geometry.attributes.aS.array, B = d.userData.B;
  for(var i=0;i<1400;i++){ var b = i*5, ph = B[b+3]*6.283;
    var y = B[b+1] + (rise||0)*((t*0.05 + B[b+3]*4.0) % 4.0);
    P[i*3] = B[b] + 0.05*Math.sin(t*0.11+ph); P[i*3+1] = y % 4.0; P[i*3+2] = B[b+2] + 0.05*Math.cos(t*0.09+ph);
    A[i] = amt*(0.35+0.35*Math.sin(t*0.5+ph*3.0)); C[i*3]=0.9; C[i*3+1]=0.8; C[i*3+2]=0.66; S[i] = B[b+4]; }
  dynCommit(d);
}

/* ---- vật liệu thạch cao / ma-nơ-canh có "lõi" phát sáng xuyên thịt ----
 * onBeforeCompile: cộng phát xạ = màu lõi × I × exp(-d²/σ²), d = khoảng cách từ điểm
 * bề mặt (world) tới tâm lõi → ngực sáng từ bên trong như đá alabaster. */
var CORE_UNI = { uCoreP:{value:new THREE.Vector3(0,-50,0)}, uCoreI:{value:0}, uCoreC:{value:new THREE.Color(CORE_COL[0],CORE_COL[1],CORE_COL[2])}, uFade:{value:1} };
function clayMaterial(col){
  var m = new THREE.MeshStandardMaterial({color:col, roughness:0.58, metalness:0.0});
  m.onBeforeCompile = function(sh){
    sh.uniforms.uCoreP = CORE_UNI.uCoreP; sh.uniforms.uCoreI = CORE_UNI.uCoreI; sh.uniforms.uCoreC = CORE_UNI.uCoreC;
    sh.vertexShader = sh.vertexShader.replace('#include <common>', '#include <common>\nvarying vec3 vWP;')
      .replace('#include <worldpos_vertex>', '#include <worldpos_vertex>\nvWP = (modelMatrix * vec4(transformed,1.0)).xyz;');
    sh.fragmentShader = sh.fragmentShader.replace('#include <common>', '#include <common>\nvarying vec3 vWP; uniform vec3 uCoreP; uniform float uCoreI; uniform vec3 uCoreC;')
      .replace('#include <emissivemap_fragment>', '#include <emissivemap_fragment>\n{ float cd = length(vWP - uCoreP); totalEmissiveRadiance += uCoreC * uCoreI * (0.9*exp(-cd*cd/0.012) + 0.35*exp(-cd*cd/0.06)); }');
  };
  return m;
}
var CLAY = clayMaterial(0x958e84);
CLAY.bumpMap = canvasTex(512,512,function(cx,w,h){ var q = HFA.mulberry32(611); cx.fillStyle = '#808080'; cx.fillRect(0,0,w,h);
  addNoise(cx, w, h, 612, 40); }, [4,4], true);
CLAY.bumpScale = 0.0025;

/** ma-nơ-canh: cùng bộ khung người nhưng một chất liệu, đầu nhẵn (không chi tiết mặt) */
function buildFigure(mat){
  var f = { root:new THREE.Group(), meshes:[] };
  function c2(r0,r1,h){ return cyl(r0,r1,h,mat,28); }
  function b2(r,sx,sy,sz){ return ball(r,sx,sy,sz,mat); }
  var hips = new THREE.Group(); hips.position.y = 0.92; f.root.add(hips); f.hips = hips;
  var spine = new THREE.Group(); hips.add(spine); f.spine = spine;
  var prof = [[0.0,-0.10],[0.13,-0.10],[0.165,-0.05],[0.172,0.05],[0.162,0.17],[0.158,0.27],[0.176,0.37],[0.192,0.43],[0.186,0.475],[0.15,0.51],[0.085,0.532],[0.052,0.54],[0.0,0.545]];
  var torso = new THREE.Mesh(new THREE.LatheGeometry(prof.map(function(p){ return new THREE.Vector2(p[0],p[1]); }), 56), mat);
  torso.scale.set(1.12,1,0.66); torso.castShadow = true; torso.receiveShadow = true; spine.add(torso);
  var neck = c2(0.046,0.052,0.12); neck.position.y = 0.575; spine.add(neck);
  var head = new THREE.Group(); head.position.y = 0.60; spine.add(head); f.head = head;
  var sk = new THREE.Mesh(HEAD_SMOOTH, mat); sk.scale.setScalar(1.06); sk.position.y = 0.115; sk.castShadow = true; sk.receiveShadow = true; head.add(sk);
  function arm(sx){
    var sh = new THREE.Group(); sh.position.set(sx*0.192,0.455,0); spine.add(sh);
    sh.add(b2(0.054,1,1,1));
    var ua = c2(0.049,0.043,0.30); ua.position.y = -0.15; sh.add(ua);
    var el = new THREE.Group(); el.position.y = -0.30; sh.add(el);
    el.add(b2(0.043,1,1,1));
    var fa = c2(0.042,0.033,0.26); fa.position.y = -0.13; el.add(fa);
    var hd = b2(0.034,1,2.1,1.4); hd.position.y = -0.31; el.add(hd);
    return {sh:sh, el:el};
  }
  var aL = arm(1), aR = arm(-1); f.shL = aL.sh; f.elL = aL.el; f.shR = aR.sh; f.elR = aR.el;
  function leg(sx){
    var hp = new THREE.Group(); hp.position.set(sx*0.092,-0.04,0); hips.add(hp);
    var th = c2(0.078,0.060,0.44); th.position.y = -0.22; hp.add(th);
    var kn = new THREE.Group(); kn.position.y = -0.44; hp.add(kn);
    kn.add(b2(0.059,1,1,1));
    var sn = c2(0.057,0.045,0.40); sn.position.y = -0.20; kn.add(sn);
    var ft = b2(0.05,1.05,0.75,2.4); ft.position.set(0,-0.43,0.05); kn.add(ft);
    return {hp:hp, kn:kn};
  }
  var lL = leg(1), lR = leg(-1); f.hpL = lL.hp; f.knL = lL.kn; f.hpR = lR.hp; f.knR = lR.kn;
  return f;
}
function figPose(f, br){  /* đứng trung tính + thở rất nhẹ (hàm của t) */
  f.spine.rotation.set(0.01*Math.sin(br*0.8), 0, 0);
  f.head.rotation.set(-0.03, 0, 0);
  f.shL.rotation.set(0.02, 0, 0.09); f.shR.rotation.set(0.02, 0, -0.09);
  f.elL.rotation.set(-0.1, 0, 0); f.elR.rotation.set(-0.1, 0, 0);
  f.hpL.rotation.set(0, 0, 0.02); f.hpR.rotation.set(0, 0, -0.02);
  f.knL.rotation.set(0, 0, 0); f.knR.rotation.set(0, 0, 0);
}

/* ---- TẤM ĐỒNG CONG, CHỮ NỔI KHỐI THẬT ------------------------------------
 * Mặt cong = cung elip quanh trục y (ôm thân/cánh tay). Mặt trước dịch chuyển đỉnh
 * theo heightmap glyph (chữ nổi ~6mm + gờ viền) → khối chữ có bề dày thật, bắt sáng
 * ở mọi góc, KHÔNG phải billboard. Mặt sau + 4 cạnh đóng kín → tấm có độ dày.
 */
function plateHeight(txt, cw, ch, vertical){
  var cv = document.createElement('canvas'); cv.width = cw; cv.height = ch;
  var cx = cv.getContext('2d',{willReadFrequently:true});
  cx.fillStyle = '#000'; cx.fillRect(0,0,cw,ch);
  /* gờ viền nổi */
  var ins = Math.min(cw,ch)*0.07, rr = Math.min(cw,ch)*0.08;
  cx.strokeStyle = '#7a7a7a'; cx.lineWidth = Math.min(cw,ch)*0.035;
  cx.beginPath(); cx.moveTo(ins+rr,ins); cx.lineTo(cw-ins-rr,ins); cx.quadraticCurveTo(cw-ins,ins,cw-ins,ins+rr); cx.lineTo(cw-ins,ch-ins-rr); cx.quadraticCurveTo(cw-ins,ch-ins,cw-ins-rr,ch-ins);
  cx.lineTo(ins+rr,ch-ins); cx.quadraticCurveTo(ins,ch-ins,ins,ch-ins-rr); cx.lineTo(ins,ins+rr); cx.quadraticCurveTo(ins,ins,ins+rr,ins); cx.stroke();
  cx.fillStyle = '#fff'; cx.textAlign = 'center'; cx.textBaseline = 'middle';
  if(vertical){
    var chars = txt.split(''), fs = Math.min(cw*0.62, (ch*0.78)/chars.length);
    cx.font = '700 '+Math.floor(fs)+'px '+JP;
    for(var i=0;i<chars.length;i++) cx.fillText(chars[i], cw/2, ch/2 + (i-(chars.length-1)/2)*fs*1.02);
  } else {
    var fs2 = ch*0.62; cx.font = '700 '+Math.floor(fs2)+'px '+JP;
    var wd = cx.measureText(txt).width; if(wd > cw*0.8){ fs2 *= cw*0.8/wd; cx.font = '700 '+Math.floor(fs2)+'px '+JP; }
    cx.fillText(txt, cw/2, ch/2 + fs2*0.04);
  }
  /* làm mềm mép → gờ vát (bevel) cho khối chữ */
  var cv2 = document.createElement('canvas'); cv2.width = cw; cv2.height = ch;
  var c2 = cv2.getContext('2d',{willReadFrequently:true}); c2.filter = 'blur('+Math.max(1.2, Math.min(cw,ch)*0.006)+'px)'; c2.drawImage(cv,0,0);
  return cv2;
}
function brassTextures(hcv, seed){
  /* Dựng bằng phép hoà trộn canvas (GPU) thay vì vòng lặp từng điểm ảnh:
   *   màu = đồng xỉn × patina  +  h × (đồng bóng − đồng xỉn)
   *   độ nhám (kênh G) = |0.62 − 0.36·h|  → chữ nổi bóng hơn nền (được chạm tay nhiều năm) */
  var cw = hcv.width, ch = hcv.height, q = HFA.mulberry32(seed);
  var hd = hcv.getContext('2d',{willReadFrequently:true}).getImageData(0,0,cw,ch).data;
  var nc = document.createElement('canvas'); nc.width = 32; nc.height = Math.max(6, Math.round(32*ch/cw));
  var nx = nc.getContext('2d',{willReadFrequently:true}), nid = nx.createImageData(nc.width, nc.height);
  for(var i=0;i<nid.data.length;i+=4){ var v = 150 + 105*q(); nid.data[i] = v; nid.data[i+1] = v*0.97; nid.data[i+2] = v*0.9; nid.data[i+3] = 255; }
  nx.putImageData(nid,0,0);
  function copyTint(fill){ var t = document.createElement('canvas'); t.width = cw; t.height = ch; var x = t.getContext('2d',{willReadFrequently:true}); x.drawImage(hcv,0,0); x.globalCompositeOperation = 'multiply'; x.fillStyle = fill; x.fillRect(0,0,cw,ch); return t; }
  var col = document.createElement('canvas'); col.width = cw; col.height = ch; var cc = col.getContext('2d',{willReadFrequently:true});
  cc.fillStyle = 'rgb(118,88,49)'; cc.fillRect(0,0,cw,ch);
  cc.globalCompositeOperation = 'multiply'; cc.imageSmoothingEnabled = true; cc.drawImage(nc,0,0,cw,ch);
  cc.globalCompositeOperation = 'source-over'; addNoise(cc, cw, ch, seed+1, 14);
  cc.globalCompositeOperation = 'lighter'; cc.drawImage(copyTint('rgb(136,114,64)'),0,0);
  var rgh = document.createElement('canvas'); rgh.width = cw; rgh.height = ch; var rc = rgh.getContext('2d',{willReadFrequently:true});
  rc.fillStyle = 'rgb(0,158,0)'; rc.fillRect(0,0,cw,ch);
  rc.globalCompositeOperation = 'difference'; rc.drawImage(copyTint('rgb(0,92,0)'),0,0);
  var tc = new THREE.CanvasTexture(col); tc.encoding = THREE.sRGBEncoding; tc.anisotropy = MAXANI;
  var tr = new THREE.CanvasTexture(rgh); tr.anisotropy = MAXANI;
  return {map:tc, rough:tr, data:hd, cw:cw, ch:ch};
}
/** dựng hình học tấm. o: {a,b,th0,th1,y0,y1,thick,relief,nu} — toạ độ cục bộ của khung cha */
function plateGeometry(o, hdata){
  var nu = o.nu || 220, arc = 0;
  for(var s=0;s<32;s++){ var t0 = lerp(o.th0,o.th1,s/32), t1 = lerp(o.th0,o.th1,(s+1)/32); arc += Math.hypot(o.a*(Math.sin(t1)-Math.sin(t0)), o.b*(Math.cos(t1)-Math.cos(t0))); }
  var hgt = o.y1 - o.y0, nv = Math.max(24, Math.round(nu*hgt/arc));
  var pos = [], uvs = [], idx = [];
  function hs(u,v){ if(!hdata) return 0; var x = Math.min(hdata.cw-1, Math.floor(u*(hdata.cw-1))), y = Math.min(hdata.ch-1, Math.floor((1-v)*(hdata.ch-1))); return hdata.data[(y*hdata.cw+x)*4]/255; }
  function P(u,v,off){ var th = lerp(o.th0,o.th1,u), y = lerp(o.y0,o.y1,v);
    var nx = Math.sin(th)/o.a, nz = Math.cos(th)/o.b, L = Math.hypot(nx,nz); nx/=L; nz/=L;
    return [o.a*Math.sin(th) + nx*off, y, o.b*Math.cos(th) + nz*off]; }
  var i, j, p;
  /* mặt trước */
  for(j=0;j<=nv;j++) for(i=0;i<=nu;i++){ var u = i/nu, v = j/nv; p = P(u,v, o.thick + o.relief*hs(u,v)); pos.push(p[0],p[1],p[2]); uvs.push(u,v); }
  for(j=0;j<nv;j++) for(i=0;i<nu;i++){ var a0 = j*(nu+1)+i, a1 = a0+1, a2 = a0+nu+1, a3 = a2+1; idx.push(a0,a1,a3, a0,a3,a2); }
  var base = pos.length/3;
  /* mặt sau */
  for(j=0;j<=nv;j++) for(i=0;i<=nu;i++){ p = P(i/nu,j/nv,0); pos.push(p[0],p[1],p[2]); uvs.push(i/nu*0.02+0.01, j/nv*0.02+0.01); }
  for(j=0;j<nv;j++) for(i=0;i<nu;i++){ var b0 = base+j*(nu+1)+i, b1 = b0+1, b2 = b0+nu+1, b3 = b2+1; idx.push(b0,b3,b1, b0,b2,b3); }
  /* bốn cạnh (dải riêng để pháp tuyến cạnh sắc) */
  function strip(pts){ var s0 = pos.length/3;
    for(var k=0;k<pts.length;k++){ var q1 = P(pts[k][0],pts[k][1],0), q2 = P(pts[k][0],pts[k][1],o.thick); pos.push(q1[0],q1[1],q1[2], q2[0],q2[1],q2[2]); uvs.push(0.01,0.01, 0.02,0.02); }
    for(var k2=0;k2<pts.length-1;k2++){ var c0 = s0+k2*2, c1 = c0+1, c2 = c0+2, c3 = c0+3; idx.push(c0,c2,c3, c0,c3,c1); } }
  var e1=[],e2=[],e3=[],e4=[];
  for(i=0;i<=nu;i++){ e1.push([i/nu,0]); e3.push([1-i/nu,1]); }
  for(j=0;j<=nv;j++){ e2.push([1,j/nv]); e4.push([0,1-j/nv]); }
  strip(e1); strip(e2); strip(e3); strip(e4);
  var g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(pos,3));
  g.setAttribute('uv', new THREE.Float32BufferAttribute(uvs,2));
  g.setIndex(idx); g.computeVertexNormals();
  /* tâm tấm (mặt ngoài, giữa) để đặt pivot */
  var cth = (o.th0+o.th1)/2, cy = (o.y0+o.y1)/2, cp = P(0.5,0.5,o.thick*0.5);
  var nx0 = Math.sin(cth)/o.a, nz0 = Math.cos(cth)/o.b, L0 = Math.hypot(nx0,nz0);
  g.translate(-cp[0], -cp[1], -cp[2]);
  return {geo:g, center:new THREE.Vector3(cp[0],cp[1],cp[2]), normal:new THREE.Vector3(nx0/L0,0,nz0/L0), arc:arc};
}
/** tấm đồng hoàn chỉnh (pivot group). Glyph + hình học dựng lại khi font về. */
function makePlate(txt, o, seed){
  var pivot = new THREE.Group();
  var mat = new THREE.MeshStandardMaterial({color:0xffffff, metalness:0.92, roughness:1.0, envMapIntensity:1.25});
  var mesh = new THREE.Mesh(new THREE.BufferGeometry(), mat); mesh.castShadow = true; mesh.receiveShadow = true; pivot.add(mesh);
  var info = {pivot:pivot, mesh:mesh, mat:mat, o:o, txt:txt};
  glyphAsset(function(){
    var arcEst = Math.abs(o.th1-o.th0)*(o.a+o.b)/2, hgt = o.y1-o.y0;
    var cw = o.vertical ? Math.round(512*arcEst/hgt) : 768, ch = o.vertical ? 512 : Math.round(768*hgt/arcEst);
    var hc = plateHeight(txt, cw, ch, o.vertical);
    var bt = brassTextures(hc, seed);
    var pg = plateGeometry(o, bt);
    if(mesh.geometry) mesh.geometry.dispose();
    mesh.geometry = pg.geo;
    if(mat.map){ mat.map.dispose(); mat.roughnessMap.dispose(); }
    mat.map = bt.map; mat.roughnessMap = bt.rough; mat.needsUpdate = true;
    info.center = o.local ? new THREE.Vector3() : pg.center; info.normal = pg.normal;
    pivot.position.copy(info.center);
  });
  return info;
}

/* ---- FIGURE chính + 4 tấm ---- */
var FIGG = reg('fig', new THREE.Group());
