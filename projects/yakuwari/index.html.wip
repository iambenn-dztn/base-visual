  });
}
function hairColorTex(base){
  return canvasTex(512,256,function(cx,w,h){ cx.fillStyle = base; cx.fillRect(0,0,w,h); var r = HFA.mulberry32(66);
    cx.lineWidth = 1; cx.strokeStyle = 'rgba(225,222,215,0.40)'; cx.beginPath(); for(var i=0;i<1600;i++){ var x=r()*w, y=r()*h; cx.moveTo(x,y); cx.lineTo(x+(r()-0.5)*6, y+8+r()*10); } cx.stroke();
    cx.strokeStyle = 'rgba(30,28,26,0.30)'; cx.beginPath(); for(var j=0;j<1600;j++){ var x2=r()*w, y2=r()*h; cx.moveTo(x2,y2); cx.lineTo(x2+(r()-0.5)*6, y2+8+r()*10); } cx.stroke(); }, null, true);
}
var CLOTH_BUMP = canvasTex(256,256,function(cx,w,h){ var r = HFA.mulberry32(314); cx.fillStyle = '#808080'; cx.fillRect(0,0,w,h);
  for(var y=0;y<h;y+=3){ cx.fillStyle = 'rgba(0,0,0,0.12)'; cx.fillRect(0,y,w,1); }
