    var r = ramp(t, 318.1, 319.6); _vc.set(-0.55, 1.62, -1.38); aimArm(ME, 'L', _vc, r, 0.25);
    setCam(0.5, 1.52, -0.45, -0.52, 1.5, -1.45, 40);
  } else {
