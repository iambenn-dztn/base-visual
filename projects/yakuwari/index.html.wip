function place(f, x, z, heading, y){ f.root.position.set(x, y||0, z); f.root.rotation.set(0, heading, 0); }

/* ---- BÀN TAY CẬN CẢNH (cầm bút) ------------------------------------------
 * Gốc ở cổ tay; lòng bàn tay trải theo +x (về phía ngón), mu tay = +y, ngón cái phía +z.
 * Ngón gập quanh trục z CỤC BỘ tại gốc từng đốt (gập về -y = về phía lòng tay) —
 * đúng khớp bản lề, không xoay quanh trục dọc ngón (tránh bàn tay "xoắn ốc").
 */
function capsuleGeo(r0, r1, len){
  var pts = [], n = 8, i, a;
  for(i=0;i<=n;i++){ a = -Math.PI/2 + (i/n)*Math.PI/2; pts.push(new THREE.Vector2(Math.cos(a)*r0, r0 + Math.sin(a)*r0)); }
  for(i=0;i<=n;i++){ a = (i/n)*Math.PI/2; pts.push(new THREE.Vector2(Math.cos(a)*r1, len - r1 + Math.sin(a)*r1)); }
  var g = new THREE.LatheGeometry(pts, 20);
  g.rotateZ(-Math.PI/2);   /* trục dọc → +x */
  return g;
}
function buildHand(skinCol, sleeveCol){
  var skin = std(skinCol, 0.6), sleeve = std(sleeveCol, 0.9);
  sleeve.bumpMap = CLOTH_BUMP; sleeve.bumpScale = 0.01;
  var H = new THREE.Group();
  /* lòng/mu bàn tay: cầu nắn thành khối dẹt bo tròn (dịch chuyển đỉnh, một khối liền) */
  var pg = new THREE.SphereGeometry(1, 40, 28), P = pg.attributes.position, v = new THREE.Vector3();
  for(var i=0;i<P.count;i++){
    v.fromBufferAttribute(P,i);
    var x = v.x, y = v.y, z = v.z;
    var sq = Math.sign(x)*Math.pow(Math.abs(x),0.75), sz = Math.sign(z)*Math.pow(Math.abs(z),0.8);
    var px = 0.047 + sq*0.050, py = y*0.016*(1.0 - 0.25*Math.max(0,x)), pz = sz*(0.040 + 0.004*x);
    if(y > 0) py += 0.004*(1-Math.abs(z));   /* mu tay hơi vồng */
    P.setXYZ(i, px, py, pz);
  }
  pg.computeVertexNormals();
  var palm = new THREE.Mesh(pg, skin); palm.castShadow = true; palm.receiveShadow = true; H.add(palm);
  /* cổ tay + ống tay áo */
  var wr = new THREE.Mesh(capsuleGeo(0.026,0.024,0.06), skin); wr.scale.set(1,0.75,1.25); wr.position.set(-0.04,0,0); H.add(wr);
  var sl = new THREE.Mesh(new THREE.CylinderGeometry(0.043,0.05,0.34,24), sleeve); sl.rotation.z = Math.PI/2; sl.position.set(-0.19,0.002,0); sl.castShadow = true; H.add(sl);
  var cuff = new THREE.Mesh(new THREE.TorusGeometry(0.041,0.006,8,24), sleeve); cuff.rotation.y = Math.PI/2; cuff.position.set(-0.022,0.002,0); H.add(cuff);
  var fingers = [];
  var spec = [ /* z gốc, dài 3 đốt, bán kính */
    {z: 0.029, L:[0.043,0.026,0.021], r:0.0088},
    {z: 0.010, L:[0.048,0.029,0.022], r:0.0092},
    {z:-0.010, L:[0.044,0.027,0.021], r:0.0086},
    {z:-0.028, L:[0.034,0.021,0.018], r:0.0076}
  ];
  spec.forEach(function(s){
    var base = new THREE.Group(); base.position.set(0.094, 0.001, s.z); H.add(base);
    var segs = [], parent = base, r = s.r;
    for(var k=0;k<3;k++){
      var j = new THREE.Group(); if(k>0) j.position.x = s.L[k-1] - r*0.6; parent.add(j);
      var m = new THREE.Mesh(capsuleGeo(r, r*0.9, s.L[k]), skin); m.position.x = -r*0.6; m.castShadow = true; j.add(m);
      if(k===2){ var nail = new THREE.Mesh(new THREE.SphereGeometry(r*0.75,12,8), std(0xd7b3a2,0.35)); nail.scale.set(1.3,0.35,0.9); nail.position.set(s.L[k]-r*1.6, r*0.72, 0); j.add(nail); }
      segs.push(j); parent = j; r *= 0.9;
    }
    fingers.push(segs);
  });
  /* ngón cái: gốc ở mép lòng tay phía +z, chĩa chéo (+x,+z) và hơi xuống */
  var tb = new THREE.Group(); tb.position.set(0.012,-0.006,0.036); H.add(tb);
  tb.rotation.set(-0.6, -0.75, -0.25);
  var th = [], par = tb, tr = 0.0115, TL = [0.040,0.032,0.026];
  for(var q=0;q<3;q++){
    var jj = new THREE.Group(); if(q>0) jj.position.x = TL[q-1] - tr*0.6; par.add(jj);
    var mm = new THREE.Mesh(capsuleGeo(tr, tr*0.9, TL[q]), skin); mm.position.x = -tr*0.6; mm.castShadow = true; jj.add(mm);
    th.push(jj); par = jj; tr *= 0.9;
  }
  H.userData = {fingers:fingers, thumb:th, skin:skin, sleeve:sleeve};
  return H;
}
/** tư thế cầm bút kiểu nắm hờ: bốn ngón gập vào lòng, bút đi qua khe ngón cái – đốt giữa ngón trỏ.
 * (Đã thử kiểu ba ngón kẹp: ở cỡ cận cảnh đọc thành "móng vuốt" — kiểu nắm hờ đọc rõ là tay cầm bút.) */
var _THB_TGT = new THREE.Vector3(0.122,-0.03,0.052), _THB_X = new THREE.Vector3(1,0,0), _thbD = new THREE.Vector3();
function handPenPose(Hd, wig){
  var F = Hd.userData.fingers, T = Hd.userData.thumb; wig = wig||0;
  var curls = [[0.95+wig,1.05,0.6],[1.2,1.25,0.8],[1.35,1.3,0.85],[1.45,1.3,0.9]];
  for(var i=0;i<4;i++) for(var k=0;k<3;k++) F[i][k].rotation.set(0,0,-curls[i][k]);
  var base = T[0].parent;
  _thbD.copy(_THB_TGT).sub(base.position).normalize();
  base.quaternion.setFromUnitVectors(_THB_X, _thbD);
  T[0].rotation.set(0,0,0.05); T[1].rotation.set(0,0,-0.15); T[2].rotation.set(0,0,-0.2);
}

/* =========================================================================
 * NHÓM CẢNH — registry: mỗi frame ẩn tất cả, shot bật đúng cái nó cần
 * ========================================================================= */
var G = {};
function reg(name, obj){ G[name] = obj; obj.visible = false; scene.add(obj); return obj; }
function show(name){ G[name].visible = true; return G[name]; }
function boxIn(grp, w,h,d,x,y,z,m, noShadow){ var b = new THREE.Mesh(new THREE.BoxGeometry(w,h,d), m); b.position.set(x,y,z); b.castShadow = !noShadow; b.receiveShadow = true; grp.add(b); return b; }

/* ---------------- CĂN PHÒNG 八畳 (chương 1, 4, và chèn ở 2–3) --------------
 * Sàn 3.6×3.6 m: x∈[-1.8,1.8], z∈[-1.8,1.8]. Tường trái x=-1.8 là 障子 có một cánh
 * mở → nắng sáng chiếu thành vệt trên chiếu. Tường sau z=-1.8: 長押 treo sơ mi + cà vạt,
 * đồng hồ treo tường, lịch. Tường phải x=+1.8: 襖 + tủ nhỏ có điện thoại bàn.
 */
var ROOM = reg('room', new THREE.Group());
var RM = {};
(function buildRoom(){
  var r = HFA.mulberry32(0x1a7a);
  /* chiếu tatami: sợi cói + viền 畳縁 */
  var tatamiTex = canvasTex(2048,2048,function(cx,w,h){
    var s = w/3.6;
    var mats = [[0,0,1.8,0.9,0],[1.8,0,1.8,0.9,0],[0,0.9,0.9,1.8,1],[0.9,0.9,0.9,1.8,1],[1.8,0.9,0.9,1.8,1],[2.7,0.9,0.9,1.8,1],[0,2.7,1.8,0.9,0],[1.8,2.7,1.8,0.9,0]];
    mats.forEach(function(m){
      var x0=m[0]*s, y0=m[1]*s, mw=m[2]*s, mh=m[3]*s;
      var base = 150 + Math.floor(r()*14);
      cx.fillStyle = 'rgb('+base+','+(base-6)+','+(base-58)+')'; cx.fillRect(x0,y0,mw,mh);
      /* sợi dệt: vân theo chiều dài chiếu */
      for(var k=0;k<(m[4]?mw:mh);k+=3){
        var g = Math.floor(r()*40) - 20;
        cx.fillStyle = 'rgba('+(120+g)+','+(115+g)+','+(60+g)+',0.5)';
        if(m[4]) cx.fillRect(x0+k, y0, 1.4, mh); else cx.fillRect(x0, y0+k, mw, 1.4);
      }
      /* viền vải hai cạnh dài */
      cx.fillStyle = '#2b2a24';
      if(m[4]){ cx.fillRect(x0, y0, 14, mh); cx.fillRect(x0+mw-14, y0, 14, mh); }
      else { cx.fillRect(x0, y0, mw, 14); cx.fillRect(x0, y0+mh-14, mw, 14); }
      cx.strokeStyle = 'rgba(40,36,28,0.6)'; cx.lineWidth = 2; cx.strokeRect(x0+1,y0+1,mw-2,mh-2);
    });
  });
  var tatamiBump = canvasTex(512,512,function(cx,w,h){ cx.fillStyle = '#808080'; cx.fillRect(0,0,w,h);
    for(var y=0;y<h;y+=2){ cx.fillStyle = (y%4===0)?'rgba(255,255,255,0.35)':'rgba(0,0,0,0.35)'; cx.fillRect(0,y,w,1); } }, [8,8], true);
  var flM = new THREE.MeshStandardMaterial({map:tatamiTex, roughness:0.82, bumpMap:tatamiBump, bumpScale:0.004});
  var fl = new THREE.Mesh(new THREE.PlaneGeometry(3.6,3.6), flM); fl.rotation.x = -Math.PI/2; fl.receiveShadow = true; ROOM.add(fl);
  RM.floorM = flM;
  /* tường vữa cát 聚楽壁 */
  var plaster = canvasTex(512,512,function(cx,w,h){ var q = HFA.mulberry32(77); cx.fillStyle = '#b9a88c'; cx.fillRect(0,0,w,h);
    addNoise(cx, w, h, 78, 38); }, [3,3]);
  var wallM = new THREE.MeshStandardMaterial({map:plaster, roughness:0.95, bumpMap:plaster, bumpScale:0.002});
  var woodM = std(0x7a5a3c, 0.55), woodD = std(0x5a3f28, 0.5);
  var woodTex = canvasTex(512,512,function(cx,w,h){ var q = HFA.mulberry32(21);
    cx.fillStyle = '#8a6848'; cx.fillRect(0,0,w,h);
    for(var i=0;i<220;i++){ var y = q()*h; cx.strokeStyle = 'rgba(60,38,22,'+(0.08+q()*0.15)+')'; cx.lineWidth = 1+q()*2; cx.beginPath(); cx.moveTo(0,y); cx.bezierCurveTo(w*0.3,y+(q()-0.5)*14,w*0.6,y+(q()-0.5)*14,w,y+(q()-0.5)*8); cx.stroke(); } });
  woodM.map = woodTex; woodD.map = woodTex; woodM.color.setRGB(1,1,1); woodD.color.setRGB(0.7,0.62,0.55);
  RM.woodM = woodM;
  boxIn(ROOM, 3.8,2.4,0.1, 0,1.2,-1.85, wallM);                 /* tường sau */
  /* tường phải x=+1.8: 襖 (4 cánh) */
  var fusumaTex = canvasTex(512,1024,function(cx,w,h){ var q = HFA.mulberry32(88);
    cx.fillStyle = '#d8cfbd'; cx.fillRect(0,0,w,h);
    addNoise(cx, w, h, 89, 16);
    cx.strokeStyle = 'rgba(150,130,100,0.35)'; cx.lineWidth = 3;
    for(var k=0;k<5;k++){ cx.beginPath(); var y0 = 620+k*40; cx.moveTo(0,y0); cx.bezierCurveTo(w*0.3,y0-60,w*0.6,y0+50,w,y0-20); cx.stroke(); }
    cx.fillStyle = '#5a4630'; cx.beginPath(); cx.ellipse(w*0.82,h*0.5,14,34,0,0,7); cx.fill(); });
  var fusM = new THREE.MeshStandardMaterial({map:fusumaTex, roughness:0.9});
  for(var fi=0;fi<4;fi++){ var fz = -1.35 + fi*0.9;
    var fp = boxIn(ROOM, 0.04,1.8,0.9, 1.84,0.9,fz, fusM);
    boxIn(ROOM, 0.05,1.8,0.03, 1.83,0.9,fz-0.435, woodD); boxIn(ROOM, 0.05,1.8,0.03, 1.83,0.9,fz+0.435, woodD); }
  boxIn(ROOM, 0.1,0.6,3.8, 1.87,2.1,0, wallM);                  /* 小壁 trên 襖 */
  boxIn(ROOM, 0.09,0.07,3.6, 1.8,1.83,0, woodM);                /* 鴨居 phải */
  /* tường trái x=-1.8: 障子 bốn cánh, cánh thứ 2 mở (trượt chồng lên cánh 1) */
  boxIn(ROOM, 0.1,0.6,3.8, -1.87,2.1,0, wallM);
  boxIn(ROOM, 0.09,0.07,3.6, -1.8,1.83,0, woodM);
  boxIn(ROOM, 0.12,0.05,3.6, -1.82,0.025,0, woodM);             /* 敷居 */
  var shojiPaper = canvasTex(512,1024,function(cx,w,h){ var q = HFA.mulberry32(12); cx.fillStyle = '#f4efe4'; cx.fillRect(0,0,w,h);
    addNoise(cx, w, h, 13, 10); });
  /* giấy 障子 phát sáng (ánh sáng ngoài xuyên qua) — HDR vừa đủ, bloom mềm */
  RM.paperM = new THREE.MeshBasicMaterial({map:shojiPaper, color:new THREE.Color(1.6,1.55,1.45)});
  var latM = std(0xcdb690, 0.6);
  function shoji(z0){
    var g = new THREE.Group(); g.position.set(-1.84, 0, z0);
    var pp = new THREE.Mesh(new THREE.PlaneGeometry(0.9,1.78), RM.paperM); pp.rotation.y = Math.PI/2; pp.position.set(-0.005,0.94,0); g.add(pp);
    boxIn(g, 0.035,1.8,0.03, 0.01,0.93,-0.435, latM); boxIn(g, 0.035,1.8,0.03, 0.01,0.93,0.435, latM);
    boxIn(g, 0.035,0.03,0.9, 0.01,0.05,0, latM); boxIn(g, 0.035,0.03,0.9, 0.01,1.82,0, latM);
    for(var i=1;i<3;i++) boxIn(g, 0.02,1.78,0.012, 0.012,0.93,-0.45+i*0.3, latM, true);
    for(var j=1;j<9;j++) boxIn(g, 0.02,0.012,0.88, 0.012,0.05+j*0.197,0, latM, true);
    ROOM.add(g); return g;
  }
  shoji(-1.35); var sOpen = shoji(-0.45); sOpen.position.set(-1.80,0,-1.35+0.02); /* cánh mở trượt ra sau cánh 1 */
  shoji(0.45); shoji(1.35);
  /* khe mở: thấy ngoài vườn buổi sáng (HDR) */
  var outTex = canvasTex(512,512,function(cx,w,h){
    var g = cx.createLinearGradient(0,0,0,h); g.addColorStop(0,'#e9f0f4'); g.addColorStop(0.55,'#f2efe4'); g.addColorStop(1,'#b8b39a');
    cx.fillStyle = g; cx.fillRect(0,0,w,h); var q = HFA.mulberry32(5);
    for(var i=0;i<60;i++){ cx.fillStyle = 'rgba('+(90+Math.floor(q()*40))+','+(120+Math.floor(q()*40))+',80,0.35)'; cx.beginPath(); cx.ellipse(q()*w, h*0.45+q()*h*0.3, 20+q()*50, 30+q()*50, 0, 0, 7); cx.fill(); } });
  RM.outM = new THREE.MeshBasicMaterial({map:outTex, color:new THREE.Color(2.4,2.35,2.2), fog:false});
  var out = new THREE.Mesh(new THREE.PlaneGeometry(6,4), RM.outM); out.rotation.y = Math.PI/2; out.position.set(-3.2,1.2,-0.4); ROOM.add(out);
  boxIn(ROOM, 0.1,2.4,0.05, -1.9,1.2,-1.83, woodM);   /* 柱 góc */
  boxIn(ROOM, 0.1,2.4,0.05, -1.9,1.2,1.83, woodM);
  /* 長押 trên tường sau */
  boxIn(ROOM, 3.6,0.09,0.05, 0,1.92,-1.78, woodM);
  boxIn(ROOM, 0.1,2.4,0.1, 1.78,1.2,-1.78, woodM); boxIn(ROOM, 0.1,2.4,0.1, -1.78,1.2,-1.78, woodM);
  /* trần gỗ */
  var ceil = boxIn(ROOM, 3.8,0.08,3.8, 0,2.44,0, std(0x9a7d5c,0.8)); ceil.material.map = woodTex; RM.ceil = ceil;
  /* tường trước (sau lưng camera phần lớn các shot) */
  boxIn(ROOM, 3.8,2.4,0.1, 0,1.2,1.85, wallM);
  /* nền ngoài để khe cửa không lộ đen */
  RM.wallM = wallM;
})();

/* ---- đồng hồ treo tường (kim giây = motif chính) ---- */
function makeClockFace(big){
  return canvasTex(1024,1024,function(cx,w,h){
    var c = w/2; cx.fillStyle = '#f3efe6'; cx.beginPath(); cx.arc(c,c,c-4,0,7); cx.fill();
    cx.strokeStyle = '#2a2622'; cx.lineCap = 'butt';
    for(var i=0;i<60;i++){ var a = i/60*Math.PI*2, L = i%5===0 ? 60 : 22; cx.lineWidth = i%5===0 ? 14 : 5;
      cx.beginPath(); cx.moveTo(c+Math.sin(a)*(c-30), c-Math.cos(a)*(c-30)); cx.lineTo(c+Math.sin(a)*(c-30-L), c-Math.cos(a)*(c-30-L)); cx.stroke(); }
    cx.fillStyle = '#2a2622'; cx.textAlign = 'center'; cx.textBaseline = 'middle'; cx.font = '700 110px '+JP;
    for(var n=1;n<=12;n++){ var a2 = n/12*Math.PI*2; cx.fillText(String(n), c+Math.sin(a2)*(c-160), c-Math.cos(a2)*(c-160)+6); }
    if(!big){ cx.font = '400 40px '+JP; cx.fillText('QUARTZ', c, c+200); }
  });
}
function makeClock(radius, depth, rimCol, big){
  var g = new THREE.Group();
  var rimM = std(rimCol, 0.45, 0.2);
  var body = new THREE.Mesh(new THREE.CylinderGeometry(radius*1.08, radius*1.1, depth, 64), rimM); body.rotation.x = Math.PI/2; body.castShadow = true; g.add(body);
  var faceM = new THREE.MeshStandardMaterial({roughness:0.6});
  glyphAsset(function(){ if(faceM.map) faceM.map.dispose(); faceM.map = makeClockFace(big); faceM.needsUpdate = true; });
  var face = new THREE.Mesh(new THREE.CircleGeometry(radius, 64), faceM); face.position.z = depth/2+0.001; face.receiveShadow = true; g.add(face);
  var glass = new THREE.Mesh(new THREE.CircleGeometry(radius*1.02, 64), new THREE.MeshStandardMaterial({color:0xffffff, roughness:0.05, metalness:0.0, transparent:true, opacity:0.08}));
  glass.position.z = depth/2+0.012; g.add(glass);
  var handM = std(0x1e1b18, 0.4);
  function hand(len, wid, col){ var hg = new THREE.Group(); var m = new THREE.Mesh(new THREE.BoxGeometry(wid, len, 0.003), col||handM); m.position.y = len*0.42; m.castShadow = true; hg.add(m); hg.position.z = depth/2+0.004; g.add(hg); return hg; }
  g.userData.h = hand(radius*0.55, radius*0.06); g.userData.h.position.z += 0.001;
  g.userData.m = hand(radius*0.82, radius*0.04); g.userData.m.position.z += 0.003;
  g.userData.s = hand(radius*0.9, radius*0.012, std(0xa8281e,0.4)); g.userData.s.position.z += 0.005;
  var cap = new THREE.Mesh(new THREE.CylinderGeometry(radius*0.04,radius*0.04,0.006,16), std(0xa8281e,0.4)); cap.rotation.x = Math.PI/2; cap.position.z = depth/2+0.012; g.add(cap);
  return g;
}
/** giờ theo giây-trong-ngày; kim giây quét liên tục (quartz sweep), không giật */
function setClock(ck, secDay){
  var s = secDay % 60, m = (secDay/60) % 60, h = (secDay/3600) % 12;
  ck.userData.s.rotation.z = -s/60*Math.PI*2;
  ck.userData.m.rotation.z = -m/60*Math.PI*2;
  ck.userData.h.rotation.z = -h/12*Math.PI*2;
}
var WALLCLOCK = makeClock(0.16, 0.05, 0x5a4028, true);
WALLCLOCK.position.set(0.95, 2.14, -1.77); ROOM.add(WALLCLOCK);

/* ---- sơ mi trắng + cà vạt trên móc, treo ở 長押 ---- */
(function buildHanger(){
  var g = new THREE.Group(); g.position.set(-0.55, 1.92, -1.70); ROOM.add(g); RM.hanger = g;
  var hk = new THREE.Mesh(new THREE.TorusGeometry(0.03,0.004,8,20,Math.PI*1.4), std(0x9a9a9a,0.3,0.9)); hk.position.set(0,-0.0,0.02); hk.rotation.z = -0.5; g.add(hk);
  var bar = new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3([new THREE.Vector3(-0.21,-0.16,0.02),new THREE.Vector3(-0.1,-0.08,0.02),new THREE.Vector3(0,-0.05,0.02),new THREE.Vector3(0.1,-0.08,0.02),new THREE.Vector3(0.21,-0.16,0.02)]),32,0.011,10,false), std(0x7a5436,0.5));
  bar.castShadow = true; g.add(bar);
  /* thân áo: tấm cong có bề dày, cổ + nẹp nút vẽ trên texture */
  /* áo vest xanh than (bộ đồ đi làm 40 năm) — ve áo + hai nút vẽ trên texture */
  var shirtTex = canvasTex(512,768,function(cx,w,h){
    cx.fillStyle = '#262e3e'; cx.fillRect(0,0,w,h);
    cx.fillStyle = 'rgba(255,255,255,0.03)'; for(var y=0;y<h;y+=3) cx.fillRect(0,y,w,1);
    cx.fillStyle = '#e9e6de'; cx.beginPath(); cx.moveTo(w/2-70,60); cx.lineTo(w/2+70,60); cx.lineTo(w/2,330); cx.fill();
    cx.strokeStyle = '#161c28'; cx.lineWidth = 8; cx.beginPath(); cx.moveTo(w/2-78,50); cx.lineTo(w/2-8,360); cx.lineTo(w/2-40,470); cx.moveTo(w/2+78,50); cx.lineTo(w/2+8,360); cx.lineTo(w/2+40,470); cx.stroke();
    cx.fillStyle = '#10141c'; cx.beginPath(); cx.arc(w/2+6,500,9,0,7); cx.fill(); cx.beginPath(); cx.arc(w/2+6,600,9,0,7); cx.fill();
    cx.strokeStyle = 'rgba(0,0,0,0.35)'; cx.lineWidth = 3; cx.beginPath(); cx.moveTo(70,560); cx.lineTo(180,560); cx.moveTo(w-70,560); cx.lineTo(w-180,560); cx.stroke();
  });
  var sh = new THREE.Shape();
  sh.moveTo(-0.07,0); sh.lineTo(-0.2,-0.05); sh.lineTo(-0.27,-0.1); sh.lineTo(-0.3,-0.55); sh.lineTo(-0.24,-0.56); sh.lineTo(-0.21,-0.22);
  sh.lineTo(-0.2,-0.78); sh.lineTo(0.2,-0.78); sh.lineTo(0.21,-0.22); sh.lineTo(0.24,-0.56); sh.lineTo(0.3,-0.55); sh.lineTo(0.27,-0.1); sh.lineTo(0.2,-0.05); sh.lineTo(0.07,0); sh.lineTo(0,-0.06); sh.lineTo(-0.07,0);
  var sg = new THREE.ExtrudeGeometry(sh, {depth:0.04, bevelEnabled:true, bevelThickness:0.01, bevelSize:0.008, bevelSegments:3, curveSegments:4});
  var P = sg.attributes.position; for(var i=0;i<P.count;i++){ var x = P.getX(i), y = P.getY(i); P.setZ(i, P.getZ(i) - 0.05*x*x/0.09 + 0.01*Math.sin(y*20)); }
  sg.computeVertexNormals();
  /* UV phẳng theo x,y cho mặt trước */
  var uv = sg.attributes.uv; for(var j=0;j<uv.count;j++){ uv.setXY(j, (P.getX(j)+0.3)/0.6, (P.getY(j)+0.78)/0.78); }
  var shirt = new THREE.Mesh(sg, new THREE.MeshStandardMaterial({map:shirtTex, roughness:0.85})); shirt.position.set(0,-0.1,-0.01); shirt.castShadow = true; shirt.receiveShadow = true; g.add(shirt);
  /* cổ áo */
  var col = new THREE.Mesh(new THREE.TorusGeometry(0.075,0.018,8,24,Math.PI*1.2), std(0x262e3e,0.8)); col.rotation.set(Math.PI/2-0.3,0,Math.PI*0.9); col.scale.set(1,0.8,1); col.position.set(0,-0.10,0.03); g.add(col);
  /* cà vạt: hình thon có bề dày, sọc chéo */
  var tieTex = canvasTex(128,512,function(cx,w,h){ cx.fillStyle = '#1f2a44'; cx.fillRect(0,0,w,h); cx.strokeStyle = '#6e5a3a'; cx.lineWidth = 6;
    for(var k=-20;k<30;k++){ cx.beginPath(); cx.moveTo(0,k*26); cx.lineTo(w,k*26+60); cx.stroke(); } });
  var ts = new THREE.Shape(); ts.moveTo(-0.018,0); ts.lineTo(0.018,0); ts.lineTo(0.045,-0.5); ts.lineTo(0,-0.56); ts.lineTo(-0.045,-0.5); ts.lineTo(-0.018,0);
  var tg = new THREE.ExtrudeGeometry(ts, {depth:0.006, bevelEnabled:true, bevelThickness:0.002, bevelSize:0.002, bevelSegments:2});
  var tuv = tg.attributes.uv, tp = tg.attributes.position; for(var q=0;q<tuv.count;q++){ tuv.setXY(q, (tp.getX(q)+0.05)/0.1, (tp.getY(q)+0.56)/0.56); }
  var tie = new THREE.Mesh(tg, new THREE.MeshStandardMaterial({map:tieTex, roughness:0.45})); tie.position.set(0,-0.12,0.045); tie.castShadow = true; g.add(tie);
  var knot = new THREE.Mesh(new THREE.SphereGeometry(0.022,16,12), tie.material); knot.scale.set(1,1.2,0.6); knot.position.set(0,-0.115,0.05); g.add(knot);
  RM.tie = tie;
})();

/* ---- bàn thấp ちゃぶ台 + 名刺入れ + danh thiếp ---- */
var TABLE_P = new THREE.Vector3(0.7, 0, 0.45);
(function buildTable(){
  var g = new THREE.Group(); g.position.copy(TABLE_P); ROOM.add(g); RM.table = g;
  var top = new THREE.Mesh(new THREE.CylinderGeometry(0.45,0.45,0.03,64), RM.woodM); top.position.y = 0.315; top.castShadow = true; top.receiveShadow = true; g.add(top);
  var edge = new THREE.Mesh(new THREE.CylinderGeometry(0.44,0.44,0.05,64,1,true), std(0x5a3f28,0.5)); edge.position.y = 0.28; g.add(edge);
  for(var i=0;i<4;i++){ var a = i*Math.PI/2+Math.PI/4; var leg = new THREE.Mesh(new THREE.BoxGeometry(0.04,0.28,0.04), std(0x5a3f28,0.5)); leg.position.set(Math.cos(a)*0.3,0.14,Math.sin(a)*0.3); leg.castShadow = true; g.add(leg); }
  /* 座布団 */
  var zb = new THREE.Mesh(new THREE.BoxGeometry(0.55,0.06,0.6), std(0x6b2f2a,0.9)); zb.position.set(0,0.03,0.72); zb.receiveShadow = true; g.add(zb); RM.zabuton = zb;
})();
var TABLE_TOP_Y = 0.33;

/* danh thiếp — texture chữ dựng qua glyphAsset (font phải về trước) */
var CARD_W = 0.091, CARD_H = 0.055;
var CARD_LINES = {co:'〇〇産業株式会社', dept:'営業本部', title:'部長', name:'〇〇 〇〇'};
function drawCard(cx, w, h, show){
  show = show || {co:1, dept:1, title:1, name:1};
  cx.fillStyle = '#f7f5ef'; cx.fillRect(0,0,w,h);
  cx.fillStyle = '#2a2622'; cx.textBaseline = 'middle';
  cx.textAlign = 'left';
