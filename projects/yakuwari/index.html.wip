  var torso = new THREE.Mesh(tg, M.top); torso.scale.set(1.12,1,0.66); torso.castShadow = true; torso.receiveShadow = true; spine.add(torso); f.torso = torso;
  var neck = cyl(0.048,0.052,0.12,M.skin); neck.position.y = 0.575; spine.add(neck);
  var head = new THREE.Group(); head.position.y = 0.60; spine.add(head); f.head = head;
  var skull = new THREE.Mesh(HEAD_GEO, M.face); skull.scale.setScalar(1.05); skull.position.y = 0.115; skull.castShadow = true; skull.receiveShadow = true; head.add(skull);
  var hairG = new THREE.Mesh(HEAD_GEO, M.hairS); hairG.scale.set(1.05*1.045, 1.05*1.035, 1.05*1.05); hairG.position.set(0,0.119,-0.002); hairG.castShadow = true; head.add(hairG);
  var collar = new THREE.Mesh(new THREE.TorusGeometry(0.064,0.019,10,28), o.collar ? std(o.collar,0.8) : M.top);
  collar.rotation.x = Math.PI/2 - 0.25; collar.scale.set(1.05,0.85,1); collar.position.set(0,0.528,0.004); collar.castShadow = true; spine.add(collar);
  M.collar = collar.material;
  var earL = ball(0.02,0.55,1.45,1.0,M.skin); earL.position.set(0.093,0.112,-0.004); head.add(earL);
