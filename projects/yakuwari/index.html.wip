    roomLight(DAWN+0.14, 0); meClothes('pj'); meFuton(-1.5, t);
    setClock(ALARM, 6*3600+30*60 - 2 + (t-314.44)); setClock(WALLCLOCK, 6*3600+30*60);
    setCam(0.3, 0.12, -0.18, 0.07, 0.07, -0.42, 34);
  } else if(t < 320.72){
    roomLight(0.45, 0); meClothes('shirt');
