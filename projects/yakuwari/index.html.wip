  function leg(sx){
    var hp = new THREE.Group(); hp.position.set(sx*0.092,-0.04,0); hips.add(hp);
    var th = cyl(0.078,0.060,0.44,M.bot); th.position.y = -0.22; hp.add(th);
    var kn = new THREE.Group(); kn.position.y = -0.44; hp.add(kn);
