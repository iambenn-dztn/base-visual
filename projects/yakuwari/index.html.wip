/* sách mở (C10) — hai trang cong + chữ in (glyph) */
var OPENBOOK = new THREE.Group(); DESK.add(OPENBOOK);
(function(){
  var pm = new THREE.MeshStandardMaterial({roughness:0.9, side:THREE.DoubleSide});
  glyphAsset(function(){ if(pm.map) pm.map.dispose(); pm.map = canvasTex(1024,720,function(cx,w,h){
    cx.fillStyle = '#efe7d4'; cx.fillRect(0,0,w,h); cx.fillStyle = '#2a2622';
    var q = HFA.mulberry32(51);
    for(var side=0; side<2; side++){ var x0 = side*w/2 + 60;
      for(var L=0; L<22; L++){ var len = 330 + q()*60; if(L%7===6) len *= 0.5; cx.fillRect(x0, 70+L*27, len, 7); } }
    cx.fillStyle = 'rgba(0,0,0,0.12)'; cx.fillRect(w/2-10,0,20,h); }); pm.needsUpdate = true; });
  var g = new THREE.PlaneGeometry(0.44,0.3,40,4); var P = g.attributes.position;
  for(var i=0;i<P.count;i++){ var x = P.getX(i); P.setZ(i, 0.018*(1-Math.pow(Math.abs(x)/0.22,1.6)) - 0.012*Math.exp(-x*x/0.0004)); }
  g.computeVertexNormals();
  var m = new THREE.Mesh(g, pm); m.rotation.x = -Math.PI/2; m.position.y = DK.topY+0.012; m.receiveShadow = true; OPENBOOK.add(m);
  var cov = new THREE.Mesh(new THREE.BoxGeometry(0.46,0.006,0.31), std(0x2c3a4a,0.6)); cov.position.y = DK.topY+0.003; OPENBOOK.add(cov);
  OPENBOOK.position.set(0.05,0,0.12);
})();
/* máy ghi âm cuộn băng (thập niên 1970) + sổ tay */
var TAPE = new THREE.Group(); DESK.add(TAPE);
(function(){
  var body = boxIn(TAPE, 0.34,0.09,0.26, 0,DK.topY+0.045,0, std(0x7a7066,0.5,0.3));
  var face = boxIn(TAPE, 0.33,0.004,0.25, 0,DK.topY+0.092,0, std(0x2a2826,0.6,0.2));
  var reelTex = canvasTex(256,256,function(cx,w,h){ cx.fillStyle = 'rgba(0,0,0,0)'; cx.clearRect(0,0,w,h);
    cx.fillStyle = '#b8bcbf'; cx.beginPath(); cx.arc(128,128,124,0,7); cx.fill();
    cx.globalCompositeOperation = 'destination-out';
    for(var i=0;i<3;i++){ var a = i*2.094; cx.beginPath(); cx.arc(128+Math.cos(a)*70,128+Math.sin(a)*70,34,0,7); cx.fill(); }
    cx.beginPath(); cx.arc(128,128,10,0,7); cx.fill();
    cx.globalCompositeOperation = 'source-over'; cx.fillStyle = '#4a3a2a'; cx.beginPath(); cx.arc(128,128,48,0,7); cx.fill(); cx.fillStyle = '#b8bcbf'; cx.beginPath(); cx.arc(128,128,18,0,7); cx.fill(); });
  var rm = new THREE.MeshStandardMaterial({map:reelTex, transparent:true, alphaTest:0.3, metalness:0.7, roughness:0.35, side:THREE.DoubleSide});
  TAPE.userData.reels = [];
  [-0.085, 0.085].forEach(function(x, i){
    var tapeDisk = new THREE.Mesh(new THREE.CylinderGeometry(i===0?0.058:0.042, i===0?0.058:0.042, 0.008, 40), std(0x3a2a1c,0.5)); tapeDisk.position.set(x, DK.topY+0.1, -0.02); TAPE.add(tapeDisk);
    var r = new THREE.Mesh(new THREE.CircleGeometry(0.07,40), rm); r.rotation.x = -Math.PI/2; r.position.set(x, DK.topY+0.106, -0.02); TAPE.add(r); TAPE.userData.reels.push(r);
  });
  var head = boxIn(TAPE, 0.06,0.02,0.02, 0,DK.topY+0.1,0.07, std(0x9a9a9a,0.3,0.8));
  for(var k=0;k<4;k++) boxIn(TAPE, 0.03,0.012,0.02, -0.09+k*0.06,DK.topY+0.1,0.105, std(0x1a1a1a,0.5));
  TAPE.position.set(-0.25,0,-0.05); TAPE.rotation.y = 0.25;
})();
var NOTE = new THREE.Group(); DESK.add(NOTE);
var NOTE_TX = [];
(function(){
  /* 5 trạng thái: 0 = chỉ dòng ghi chép; 1..4 = sơ đồ 1→2→3→4 hiện dần (dựng sẵn, không vẽ trong render) */
  for(var s=0;s<5;s++) (function(s){
    var holder = {tx:null}; NOTE_TX.push(holder);
    glyphAsset(function(){ if(holder.tx) holder.tx.dispose(); holder.tx = canvasTex(800,1100,function(cx,w,h){
      cx.fillStyle = '#f1ead6'; cx.fillRect(0,0,w,h);
      cx.strokeStyle = 'rgba(90,120,160,0.35)'; cx.lineWidth = 2; for(var L=0;L<26;L++){ cx.beginPath(); cx.moveTo(40,90+L*38); cx.lineTo(w-30,90+L*38); cx.stroke(); }
      cx.strokeStyle = 'rgba(40,40,70,0.75)'; cx.lineWidth = 3; var q = HFA.mulberry32(61);
      for(var L2=0;L2<13;L2++){ var x = 60, y = 80+L2*38; cx.beginPath(); cx.moveTo(x,y);
        var len = 380 + q()*260; for(var k=0;k<len;k+=6){ cx.lineTo(x+k, y - 6 - Math.abs(Math.sin(k*0.21+q()*3))*10*(0.4+q()*0.6)); } cx.stroke(); }
      if(s>0){ cx.font = '700 64px '+JP; cx.fillStyle = 'rgba(30,30,60,0.9)'; cx.textAlign = 'center'; cx.textBaseline = 'middle';
        var X = [140,300,460,620], Y = 820;
        for(var i=0;i<s;i++){ cx.strokeStyle = 'rgba(30,30,60,0.85)'; cx.lineWidth = 4; cx.beginPath(); cx.arc(X[i],Y,44,0,7); cx.stroke(); cx.fillText(String(i+1), X[i], Y+3);
          if(i>0){ cx.beginPath(); cx.moveTo(X[i-1]+50,Y); cx.lineTo(X[i]-52,Y); cx.stroke(); cx.beginPath(); cx.moveTo(X[i]-52,Y); cx.lineTo(X[i]-66,Y-10); cx.moveTo(X[i]-52,Y); cx.lineTo(X[i]-66,Y+10); cx.stroke(); } } }
    }); });
  })(s);
  var nm = new THREE.MeshStandardMaterial({roughness:0.9});
  var pg = new THREE.Mesh(new THREE.PlaneGeometry(0.2,0.275), nm); pg.rotation.x = -Math.PI/2; pg.position.y = DK.topY+0.006; pg.receiveShadow = true; NOTE.add(pg);
  var cov = new THREE.Mesh(new THREE.BoxGeometry(0.205,0.005,0.28), std(0x3a2a22,0.7)); cov.position.y = DK.topY+0.0025; NOTE.add(cov);
  NOTE.userData.m = nm; NOTE.position.set(0.2,0,0.08); NOTE.rotation.y = -0.15;
  var pen = new THREE.Mesh(new THREE.CylinderGeometry(0.005,0.005,0.14,12), std(0x1a1a1a,0.3,0.5)); pen.rotation.set(Math.PI/2,0,0.6); pen.position.set(0.33,DK.topY+0.008,0.12); NOTE.add(pen);
})();
function setNote(s){ var h = NOTE_TX[clamp(Math.floor(s),0,4)]; if(h && h.tx && NOTE.userData.m.map !== h.tx){ NOTE.userData.m.map = h.tx; NOTE.userData.m.needsUpdate = true; } }
/* từ điển mở ở mục 役割 */
var DICT = new THREE.Group(); DESK.add(DICT);
(function(){
  var pm = new THREE.MeshStandardMaterial({roughness:0.9, side:THREE.DoubleSide});
  glyphAsset(function(){ if(pm.map) pm.map.dispose(); pm.map = canvasTex(1400,1000,function(cx,w,h){
    cx.fillStyle = '#eee7d6'; cx.fillRect(0,0,w,h); var q = HFA.mulberry32(71);
    cx.fillStyle = '#2a2622'; cx.textBaseline = 'top';
    for(var side=0; side<2; side++){ var x0 = side*w/2+50;
      for(var L=0; L<30; L++){ if(side===1 && L>=8 && L<=16) continue; var len = 200 + q()*380; cx.fillStyle = 'rgba(42,38,34,0.55)'; cx.fillRect(x0 + (L%5===0?0:30), 60+L*30, len, 9); } }
    /* mục từ */
    var x1 = w/2+60, y1 = 300;
    cx.fillStyle = '#1e1c1a'; cx.font = '700 58px '+JP; cx.fillText('やくわり【役割】', x1, y1);
    cx.font = '400 34px '+JP;
    cx.fillText('①割り当てられた役目。', x1+20, y1+86);
    cx.fillText('②社会学で、ある地位にある人に', x1+20, y1+136);
    cx.fillText('　期待される行動の型。', x1+20, y1+180);
    cx.fillStyle = 'rgba(0,0,0,0.12)'; cx.fillRect(w/2-12,0,24,h); }); pm.needsUpdate = true; });
  var g = new THREE.PlaneGeometry(0.5,0.36,40,4); var P = g.attributes.position;
  for(var i=0;i<P.count;i++){ var x = P.getX(i); P.setZ(i, 0.02*(1-Math.pow(Math.abs(x)/0.25,1.6)) - 0.012*Math.exp(-x*x/0.0004)); }
  g.computeVertexNormals();
  var m = new THREE.Mesh(g, pm); m.rotation.x = -Math.PI/2; m.position.y = DK.topY+0.05; m.receiveShadow = true; DICT.add(m);
  var blk = new THREE.Mesh(new THREE.BoxGeometry(0.52,0.05,0.37), [std(0xe8e0cc,0.9),std(0xe8e0cc,0.9),std(0x2a1a14,0.6),std(0x2a1a14,0.6),std(0xe8e0cc,0.9),std(0xe8e0cc,0.9)]);
  blk.position.y = DK.topY+0.025; blk.castShadow = true; DICT.add(blk);
})();
/* tĩnh vật "vẫn là mình": (a) đồng hồ mở nắp + tua vít + kính lão; (b) sách tranh + giấy ghi chú */
var FIXIT = new THREE.Group(); DESK.add(FIXIT);
(function(){
  var cloth = new THREE.Mesh(new THREE.PlaneGeometry(0.6,0.45), std(0x3a4a3e,0.95)); cloth.rotation.x = -Math.PI/2; cloth.position.y = DK.topY+0.001; cloth.receiveShadow = true; FIXIT.add(cloth);
  var ck = makeClock(0.11, 0.04, 0x6a4a2c, true); ck.rotation.x = -Math.PI/2; ck.position.set(-0.05, DK.topY+0.02, 0.0); FIXIT.add(ck); setClock(ck, 3*3600+17*60+42);
  FIXIT.userData.ck = ck;
  /* mặt sau tháo rời, bánh răng nhỏ */
  var back = new THREE.Mesh(new THREE.CylinderGeometry(0.115,0.115,0.004,48), std(0x4a3a2a,0.6)); back.position.set(0.17, DK.topY+0.002, -0.08); FIXIT.add(back);
  var brass = std(0xc0964e,0.35,0.9);
  for(var i=0;i<3;i++){ var gear = new THREE.Mesh(new THREE.CylinderGeometry(0.014+i*0.006,0.014+i*0.006,0.003,18), brass); gear.position.set(0.14+i*0.035, DK.topY+0.004, 0.09-i*0.01); gear.castShadow = true; FIXIT.add(gear); }
  var sd = new THREE.Group(); var hnd = new THREE.Mesh(new THREE.CylinderGeometry(0.009,0.009,0.08,16), std(0xb3231a,0.4)); hnd.rotation.z = Math.PI/2; sd.add(hnd);
  var shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.0025,0.0025,0.08,10), std(0xcfcfcf,0.2,0.95)); shaft.rotation.z = Math.PI/2; shaft.position.x = 0.08; sd.add(shaft);
  sd.position.set(0.05, DK.topY+0.01, 0.15); sd.rotation.y = 0.5; FIXIT.add(sd); FIXIT.userData.sd = sd;
  /* kính lão */
  var gl = new THREE.Group(); var frame = std(0x2a2522,0.4,0.3);
  [-0.032,0.032].forEach(function(x){ var r = new THREE.Mesh(new THREE.TorusGeometry(0.024,0.0025,8,32), frame); r.position.x = x; gl.add(r);
    var lensM = new THREE.Mesh(new THREE.CircleGeometry(0.023,32), new THREE.MeshStandardMaterial({color:0xffffff, transparent:true, opacity:0.12, roughness:0.02})); lensM.position.x = x; gl.add(lensM); });
  var br = new THREE.Mesh(new THREE.CylinderGeometry(0.002,0.002,0.018,8), frame); br.rotation.z = Math.PI/2; gl.add(br);
  gl.rotation.x = -Math.PI/2+0.15; gl.position.set(-0.2, DK.topY+0.012, 0.14); FIXIT.add(gl);
  FIXIT.userData.glasses = gl;
})();
var PICBOOK = new THREE.Group(); DESK.add(PICBOOK);
(function(){
  var pm = new THREE.MeshStandardMaterial({roughness:0.85, side:THREE.DoubleSide});
  glyphAsset(function(){ if(pm.map) pm.map.dispose(); pm.map = canvasTex(1200,800,function(cx,w,h){
    cx.fillStyle = '#f6efdc'; cx.fillRect(0,0,w,h);
    /* tranh: mặt trời, đồi, cây */
    cx.fillStyle = '#f2b640'; cx.beginPath(); cx.arc(250,220,90,0,7); cx.fill();
    cx.fillStyle = '#7fb069'; cx.beginPath(); cx.moveTo(0,h); cx.quadraticCurveTo(300,420,600,h); cx.fill();
    cx.fillStyle = '#5a8a52'; cx.beginPath(); cx.moveTo(250,h); cx.quadraticCurveTo(700,380,1200,h); cx.fill();
    cx.fillStyle = '#8a5a3a'; cx.fillRect(860,420,30,200); cx.fillStyle = '#4a7a42'; cx.beginPath(); cx.arc(875,390,90,0,7); cx.fill();
    cx.fillStyle = '#2a2622'; cx.font = '700 50px '+JP; cx.textAlign = 'center'; cx.fillText('おひさま', 250, 380);
    cx.fillStyle = 'rgba(0,0,0,0.1)'; cx.fillRect(w/2-10,0,20,h); }); pm.needsUpdate = true; });
  var g = new THREE.PlaneGeometry(0.42,0.28,30,3); var P = g.attributes.position;
  for(var i=0;i<P.count;i++){ var x = P.getX(i); P.setZ(i, 0.012*(1-Math.pow(Math.abs(x)/0.21,1.6))); }
  g.computeVertexNormals();
  var m = new THREE.Mesh(g, pm); m.rotation.x = -Math.PI/2; m.position.y = DK.topY+0.01; m.receiveShadow = true; PICBOOK.add(m);
  var cov = new THREE.Mesh(new THREE.BoxGeometry(0.44,0.006,0.29), std(0xd8543a,0.6)); cov.position.y = DK.topY+0.003; PICBOOK.add(cov);
  /* giấy ghi chú: sơ đồ giải thích tay vẽ (mũi tên: mặt trời → cây) */
  var nm = new THREE.MeshStandardMaterial({roughness:0.9});
  glyphAsset(function(){ if(nm.map) nm.map.dispose(); nm.map = canvasTex(400,400,function(cx,w,h){ cx.fillStyle = '#f7e27a'; cx.fillRect(0,0,w,h);
    cx.strokeStyle = '#2a3a6a'; cx.lineWidth = 6; cx.lineCap = 'round';
    cx.beginPath(); cx.arc(90,100,40,0,7); cx.stroke();
    for(var k=0;k<8;k++){ var a = k*0.785; cx.beginPath(); cx.moveTo(90+Math.cos(a)*52,100+Math.sin(a)*52); cx.lineTo(90+Math.cos(a)*68,100+Math.sin(a)*68); cx.stroke(); }
    cx.beginPath(); cx.moveTo(150,140); cx.quadraticCurveTo(230,160,270,250); cx.stroke(); cx.beginPath(); cx.moveTo(270,250); cx.lineTo(248,236); cx.moveTo(270,250); cx.lineTo(276,226); cx.stroke();
    cx.fillStyle = '#4a7a42'; cx.beginPath(); cx.arc(300,300,40,0,7); cx.fill(); cx.fillStyle = '#8a5a3a'; cx.fillRect(292,330,16,50);
    cx.fillStyle = '#2a3a6a'; cx.font = '700 40px '+JP; cx.fillText('ひかり', 30, 360); }); nm.needsUpdate = true; });
  var note = new THREE.Mesh(new THREE.PlaneGeometry(0.09,0.09), nm); note.rotation.set(-Math.PI/2,0,0.2); note.position.set(0.28, DK.topY+0.002, 0.12); PICBOOK.add(note);
  var cray = new THREE.Mesh(new THREE.CylinderGeometry(0.005,0.005,0.07,12), std(0x3a6ab0,0.6)); cray.rotation.set(Math.PI/2,0,1.1); cray.position.set(0.2, DK.topY+0.005, 0.2); PICBOOK.add(cray);
  var gl2 = FIXIT.userData.glasses.clone(); gl2.position.set(-0.27, DK.topY+0.012, 0.12); gl2.rotation.z = 0.4; PICBOOK.add(gl2);
})();

/* ---- tu viện: ô cửa vòm đá, tràng hạt trên bệ, khăn tu gấp (C12–C13) ---- */
var CONV = reg('conv', new THREE.Group()); CONV.position.set(0,0,-40);
var CV = {};
(function buildConvent(){
  var stone = canvasTex(1024,1024,function(cx,w,h){ var q = HFA.mulberry32(81); cx.fillStyle = '#8a8276'; cx.fillRect(0,0,w,h);
    for(var row=0; row<16; row++){ var off = (row%2)*64; for(var col=-1; col<9; col++){ var v = 110 + Math.floor(q()*40);
      cx.fillStyle = 'rgb('+v+','+(v-6)+','+(v-16)+')'; cx.fillRect(col*128+off+3, row*64+3, 122, 58); } }
    addNoise(cx, w, h, 82, 40); }, [2,2]);
  var wallM = new THREE.MeshStandardMaterial({map:stone, roughness:0.9, bumpMap:stone, bumpScale:0.01});
  /* tường có lỗ vòm */
  var sh = new THREE.Shape(); sh.moveTo(-2.5,0); sh.lineTo(2.5,0); sh.lineTo(2.5,3.6); sh.lineTo(-2.5,3.6); sh.lineTo(-2.5,0);
  var hole = new THREE.Path(); hole.moveTo(-0.45,1.0); hole.lineTo(0.45,1.0); hole.lineTo(0.45,2.2); hole.absarc(0,2.2,0.45,0,Math.PI,false); hole.lineTo(-0.45,1.0);
  sh.holes.push(hole);
  var wg = new THREE.ExtrudeGeometry(sh, {depth:0.5, bevelEnabled:false, curveSegments:24});
  var uv = wg.attributes.uv, P = wg.attributes.position; for(var i=0;i<uv.count;i++) uv.setXY(i, (P.getX(i)+P.getZ(i))*0.4, P.getY(i)*0.4);
  var wall = new THREE.Mesh(wg, wallM); wall.position.z = -0.5; wall.castShadow = true; wall.receiveShadow = true; CONV.add(wall);
  var sill = boxIn(CONV, 1.1,0.06,0.62, 0,0.97,-0.22, wallM);
  var skyT = canvasTex(512,512,function(cx,w,h){ var g = cx.createLinearGradient(0,0,0,h); g.addColorStop(0,'#dfe8ef'); g.addColorStop(0.6,'#f1ece0'); g.addColorStop(1,'#a8a48e'); cx.fillStyle = g; cx.fillRect(0,0,w,h);
    var q = HFA.mulberry32(7); for(var i=0;i<40;i++){ cx.fillStyle = 'rgba(110,130,100,0.4)'; cx.beginPath(); cx.ellipse(q()*w, h*0.62+q()*h*0.3, 30+q()*60, 40+q()*50, 0,0,7); cx.fill(); } });
  var sky = new THREE.Mesh(new THREE.PlaneGeometry(4,4), new THREE.MeshBasicMaterial({map:skyT, color:new THREE.Color(1.25,1.22,1.15)})); sky.position.set(0,2,-2.5); CONV.add(sky);
  /* tràng hạt: hạt gỗ trên đường cong + thánh giá nhỏ */
  var beadM = std(0x3a2418,0.35), crossM = std(0x8a7a60,0.3,0.8);
  var curve = new THREE.CatmullRomCurve3([new THREE.Vector3(-0.2,0,0.05),new THREE.Vector3(-0.1,0,-0.08),new THREE.Vector3(0.05,0,-0.1),new THREE.Vector3(0.16,0,0.0),new THREE.Vector3(0.08,0,0.1),new THREE.Vector3(-0.06,0,0.1),new THREE.Vector3(-0.2,0,0.05)], true);
  var rg = new THREE.Group(); rg.position.set(-0.12, 1.012, -0.1); CONV.add(rg);
  for(var k=0;k<59;k++){ var p = curve.getPointAt(k/59); var b = new THREE.Mesh(new THREE.SphereGeometry(k%11===0?0.0075:0.0055,12,8), beadM); b.position.copy(p); b.castShadow = true; rg.add(b); }
  for(var k2=0;k2<6;k2++){ var b2 = new THREE.Mesh(new THREE.SphereGeometry(0.0055,12,8), beadM); b2.position.set(-0.2+0.0+k2*0.0, 0, 0.05+k2*0.016); rg.add(b2); }
  var cr = new THREE.Group(); cr.position.set(-0.2,0.002,0.17); rg.add(cr);
  var c1 = new THREE.Mesh(new THREE.BoxGeometry(0.008,0.004,0.05), crossM); cr.add(c1); var c2 = new THREE.Mesh(new THREE.BoxGeometry(0.03,0.004,0.008), crossM); c2.position.z = -0.008; cr.add(c2);
  /* khăn tu (veil) gấp: mặt lưới dày có nếp */
  var vg = new THREE.PlaneGeometry(0.34,0.26,30,24); vg.rotateX(-Math.PI/2); var VP = vg.attributes.position;
  for(var j=0;j<VP.count;j++){ var x = VP.getX(j), z = VP.getZ(j); VP.setY(j, 0.03 + 0.012*Math.sin(x*40)*Math.exp(-z*z*20) + 0.02*Math.exp(-Math.pow(x/0.12,2))*0.5 - 0.02*Math.pow(Math.abs(z)/0.13,4)); }
  vg.computeVertexNormals();
  var veil = new THREE.Mesh(vg, std(0x1a1c22,0.85)); veil.position.set(0.2, 1.0, -0.12); veil.rotation.y = -0.2; veil.castShadow = true; veil.receiveShadow = true; CONV.add(veil);
  var band = new THREE.Mesh(new THREE.BoxGeometry(0.34,0.012,0.04), std(0xeeeae0,0.8)); band.position.set(0.2, 1.045, -0.02); band.rotation.y = -0.2; CONV.add(band);
  /* cột sáng qua ô vòm */
  CV.beam = new THREE.Mesh(new THREE.CylinderGeometry(0.42,0.55,3.0,32,1,true), new THREE.ShaderMaterial({ uniforms:{uOp:{value:1}},
    vertexShader:'varying vec2 vU; void main(){ vU=uv; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }',
    fragmentShader:'uniform float uOp; varying vec2 vU; void main(){ gl_FragColor=vec4(vec3(1.0,0.92,0.78)*0.035*vU.y*uOp,1.0); }',
    transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, side:THREE.DoubleSide }));
  CV.beam.rotation.x = -1.15; CV.beam.position.set(0,1.2,0.9); CONV.add(CV.beam);
})();

/* =========================================================================
 * 185 phiếu phỏng vấn (C15–C16) — InstancedMesh, sáng theo nhóm khi lời gọi tên
 * (KHÔNG gán số lượng cho từng nhóm: nguồn chỉ cho tổng 185 — nhóm chia đều minh hoạ)
 * ========================================================================= */
var CARDS = reg('cards', new THREE.Group());
var CD = {N:185, cat:[], pos:[]};
(function buildCards(){
  var tex = canvasTex(256,360,function(cx,w,h){ cx.fillStyle = '#e9e2d0'; cx.fillRect(0,0,w,h);
    cx.fillStyle = 'rgba(160,60,50,0.7)'; cx.fillRect(0,40,w,3);
    cx.fillStyle = 'rgba(40,40,60,0.55)'; var q = HFA.mulberry32(91);
    for(var L=0;L<12;L++){ cx.fillRect(18, 62+L*24, 80+q()*140, 5); } });
  var m = new THREE.MeshStandardMaterial({map:tex, roughness:0.85});
  var im = new THREE.InstancedMesh(new THREE.BoxGeometry(0.06,0.002,0.085), m, CD.N);
  im.castShadow = true; im.receiveShadow = true;
  var q = HFA.mulberry32(185), o = new THREE.Object3D(), k = 0;
  var order = []; for(var i=0;i<CD.N;i++) order.push(i%6);
  for(var s=order.length-1;s>0;s--){ var j = Math.floor(q()*(s+1)); var tmp = order[s]; order[s] = order[j]; order[j] = tmp; }
  for(var r=0;r<11;r++) for(var c=0;c<17;c++){ if(k>=CD.N) break;
    var x = (c-8)*0.074 + (q()-0.5)*0.008, z = (r-5)*0.1 + (q()-0.5)*0.008;
    o.position.set(x, 0.002 + q()*0.001, z); o.rotation.set(0, (q()-0.5)*0.08, 0); o.updateMatrix(); im.setMatrixAt(k, o.matrix);
    im.setColorAt(k, new THREE.Color(0.2,0.19,0.18)); CD.cat.push(order[k]); CD.pos.push(new THREE.Vector3(x,0,z)); k++; }
  im.instanceMatrix.needsUpdate = true; im.instanceColor.needsUpdate = true;
  CARDS.add(im); CD.im = im;
})();
var _cc = new THREE.Color();
function cardsLight(lv){  /* lv[cat] ∈ [0,1] */
  for(var i=0;i<CD.N;i++){ var l = lv[CD.cat[i]]; _cc.setRGB(0.13 + 0.62*l, 0.12 + 0.52*l, 0.11 + 0.36*l); CD.im.setColorAt(i, _cc); }
  CD.im.instanceColor.needsUpdate = true;
}

/* ---- bốn bậc đá (C33: "疑って、迷って、決める" — trình tự của người TỰ CHỌN rời đi) ---- */
var STONES = reg('stones', new THREE.Group());
var ST = {s:[], lab:[]};
(function buildStones(){
  var names = ['１　最初の疑い','２　ほかの道を探す','３　転機','４　元の自分をつくる'];
  var q = HFA.mulberry32(404);
  for(var i=0;i<4;i++){
    var g = new THREE.CylinderGeometry(0.34,0.38,0.12,40,2); var P = g.attributes.position, v = new THREE.Vector3();
    for(var k=0;k<P.count;k++){ v.fromBufferAttribute(P,k); var a = Math.atan2(v.z,v.x); var rr = 1 + 0.08*Math.sin(a*3+i) + 0.05*Math.sin(a*7+i*2); v.x *= rr; v.z *= rr*0.8; if(v.y>0) v.y += 0.015*Math.sin(v.x*20)*Math.cos(v.z*18); P.setXYZ(k,v.x,v.y,v.z); }
    g.computeVertexNormals();
    var m = new THREE.MeshStandardMaterial({color:0x6a645c, roughness:0.8, emissive:new THREE.Color(0,0,0)});
    var st = new THREE.Mesh(g, m); st.position.set(-1.6 + i*1.05, 0.06, 0.5 - i*0.9); st.castShadow = true; st.receiveShadow = true; STONES.add(st); ST.s.push(st);
    var lb = labelPlane(names[i], 0.27, '#f4ead8', {fpx:84}); lb.position.set(st.position.x, 0.62, st.position.z); STONES.add(lb); ST.lab.push(lb);
  }
})();

/* =========================================================================
 * SỢI CONTINUITY (Atchley): hai sợi bện — nội (ấm) · ngoại (lam nhạt) — đi từ quá khứ
 * xa tới hiện tại, qua "cổng 定年" thì ĐỔI HƯỚNG nhưng KHÔNG ĐỨT.
 * ========================================================================= */
var THR = reg('threads', new THREE.Group()); THR.position.set(0,0,60);
var TH = {};
(function buildThreads(){
  var C = [new THREE.Vector3(-7.2,0.9,-2.2), new THREE.Vector3(-4.8,1.25,-1.4), new THREE.Vector3(-2.5,0.95,-0.7), new THREE.Vector3(-0.4,1.1,-0.2),
           new THREE.Vector3(0.9,1.25,0.0), new THREE.Vector3(2.0,1.75,0.1), new THREE.Vector3(3.0,2.45,0.0), new THREE.Vector3(4.4,2.8,-0.4)];
  var center = new THREE.CatmullRomCurve3(C); TH.center = center;
  var N = 900, inner = [], outer = [];
  var up = new THREE.Vector3(0,1,0), tng = new THREE.Vector3(), side = new THREE.Vector3(), up2 = new THREE.Vector3();
  for(var i=0;i<=N;i++){ var s = i/N; var p = center.getPointAt(s); center.getTangentAt(s, tng);
    side.crossVectors(tng, up).normalize(); up2.crossVectors(side, tng).normalize();
    var ph = s*125.0, R = 0.11;
    inner.push(p.clone().addScaledVector(side, Math.cos(ph)*R).addScaledVector(up2, Math.sin(ph)*R));
    outer.push(p.clone().addScaledVector(side, Math.cos(ph+Math.PI)*R).addScaledVector(up2, Math.sin(ph+Math.PI)*R)); }
  function thread(pts, col){
    var m = new THREE.ShaderMaterial({ uniforms:{uCol:{value:new THREE.Color(col[0],col[1],col[2])}, uI:{value:1}, uRev:{value:1}, uT:UT, uHi:{value:0}},
      vertexShader:'varying vec2 vU; varying vec3 vN; varying vec3 vV; void main(){ vU=uv; vec4 w=modelMatrix*vec4(position,1.0); vN=normalize(mat3(modelMatrix)*normal); vV=normalize(cameraPosition-w.xyz); gl_Position=projectionMatrix*viewMatrix*w; }',
      fragmentShader:'uniform vec3 uCol; uniform float uI,uRev,uT,uHi; varying vec2 vU; varying vec3 vN; varying vec3 vV;'+
        'void main(){ if(vU.x>uRev) discard; float f=abs(dot(normalize(vN),normalize(vV))); float core=0.35+0.9*pow(f,2.0);'+
        ' float pulse=0.85+0.15*sin(vU.x*120.0-uT*1.2); float head=smoothstep(uRev-0.03,uRev,vU.x)*1.5;'+
        ' gl_FragColor=vec4(uCol*(core*pulse+head+uHi)*uI,1.0); }' });
    var tube = new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 2400, 0.03, 8, false), m);
    THR.add(tube); return m;
  }
  TH.inM = thread(inner, [1.0,0.72,0.42]);
  TH.outM = thread(outer, [0.55,0.72,0.95]);
  /* cổng 定年: khung chữ nhật mảnh phát sáng đứng ngang đường đi */
  /* cổng đặt ở chỗ đường bắt đầu đổi hướng (x ≈ 0.6) */
  var gsS = 0.5; for(var k0=0;k0<=200;k0++){ var pk = center.getPointAt(k0/200); if(pk.x >= 0.6){ gsS = k0/200; break; } } TH.gs = gsS;
  var gs = center.getPointAt(gsS), gt = new THREE.Vector3(); center.getTangentAt(gsS, gt);
  /* mốc 定年: một vạch sáng đứng cắt ngang sợi (luôn quay về máy) + nhãn phía trên */
  var gate = new THREE.Group(); gate.position.copy(gs); THR.add(gate); TH.gate = gate;
  var gm = new THREE.MeshBasicMaterial({color:new THREE.Color(1.5,1.35,1.1), transparent:true, opacity:0.8, depthWrite:false});
  var bar = new THREE.Mesh(new THREE.PlaneGeometry(0.025, 1.3), gm); gate.add(bar);
  TH.gateM = gm;
  var gl = labelPlane('定年', 0.36, '#f4ead8', {fpx:96}); gl.position.set(0, 0.9, 0); gate.add(gl); TH.gateLab = gl;
  /* nhãn dọc sợi */
  TH.chips = [];
  var inTxt = ['考え方','好み','気質','身につけた技'], outTxt = ['住む場所','人との関係','ふだんの活動'];
  inTxt.forEach(function(s, i){ var p = center.getPointAt(0.2 + i*0.085); var lb = labelPlane(s, 0.36, '#ffd9a6', {fpx:84}); lb.position.set(p.x, p.y+0.6+0.2*(i%2), p.z); THR.add(lb); TH.chips.push({m:lb, g:0, i:i}); });
  outTxt.forEach(function(s, i){ var p = center.getPointAt(0.22 + i*0.125); var lb = labelPlane(s, 0.36, '#c4daf4', {fpx:84}); lb.position.set(p.x, p.y-0.6-0.18*(i%2), p.z); THR.add(lb); TH.chips.push({m:lb, g:1, i:i}); });
  /* sao bụi nền */
  var dust = makeDyn(1200, {maxPx:4, near:0.5}), rd = HFA.mulberry32(77), B = [];
  for(var k=0;k<1200;k++){ var s2 = rd(); var p2 = center.getPointAt(s2); B.push(p2.x+(rd()-0.5)*9, p2.y+(rd()-0.5)*5, p2.z+(rd()-0.5)*9, rd(), 0.006+rd()*0.01); }
  dust.userData.B = B; THR.add(dust); TH.dust = dust;
})();
function thrDust(t, amt){
  var d = TH.dust, P = d.geometry.attributes.position.array, A = d.geometry.attributes.aA.array, C = d.geometry.attributes.aC.array, S = d.geometry.attributes.aS.array, B = d.userData.B;
  for(var i=0;i<1200;i++){ var b = i*5, ph = B[b+3]*6.283;
    P[i*3] = B[b] + 0.08*Math.sin(t*0.1+ph); P[i*3+1] = B[b+1] + 0.06*Math.sin(t*0.08+ph*1.3); P[i*3+2] = B[b+2];
    A[i] = amt*(0.3+0.3*Math.sin(t*0.4+ph*2.0)); C[i*3]=0.8; C[i*3+1]=0.8; C[i*3+2]=0.85; S[i] = B[b+4]; }
  dynCommit(d);
}

/* ---- chồng phiếu khảo sát theo năm (C42–C43: >1.000 người, 20 năm, Ohio) ---- */
var STACKS = reg('stacks', new THREE.Group());
var SK = {s:[], m:[]};
(function buildStacks(){
  var side = canvasTex(64,512,function(cx,w,h){ cx.fillStyle = '#e8e2d2'; cx.fillRect(0,0,w,h); for(var y=0;y<h;y+=3){ cx.fillStyle = 'rgba(0,0,0,'+(0.05+0.08*((y*7)%5)/5)+')'; cx.fillRect(0,y,w,1); } }, [1,1]);
  var topT = canvasTex(256,360,function(cx,w,h){ cx.fillStyle = '#efe9da'; cx.fillRect(0,0,w,h); cx.fillStyle = 'rgba(40,40,60,0.5)'; for(var L=0;L<10;L++){ cx.fillRect(20,40+L*30,150+((L*37)%60),5); cx.strokeStyle='rgba(40,40,60,0.5)'; cx.strokeRect(200,34+L*30,16,16);} });
  for(var i=0;i<20;i++){
    var a = -0.9 + i*0.095, R = 3.2;
    var mat = new THREE.MeshStandardMaterial({map:side, roughness:0.9, emissive:new THREE.Color(0,0,0)});
    var topM = new THREE.MeshStandardMaterial({map:topT, roughness:0.85, emissive:new THREE.Color(0,0,0)});
    var bx = new THREE.Mesh(new THREE.BoxGeometry(0.21,1,0.297), [mat,mat,topM,mat,mat,mat]);
    var g = new THREE.Group(); g.position.set(Math.sin(a)*R, 0, -Math.cos(a)*R + 1.5); g.rotation.y = -a; g.add(bx);
    bx.castShadow = true; bx.receiveShadow = true;
    STACKS.add(g); SK.s.push({g:g, b:bx, h:0.34 + 0.05*Math.sin(i*1.7)}); SK.m.push(mat, topM);
  }
  SK.lab1 = labelPlane('1年目', 0.17, '#e8dfcf', {fpx:72}); STACKS.add(SK.lab1);
  SK.lab2 = labelPlane('20年目', 0.17, '#e8dfcf', {fpx:72}); STACKS.add(SK.lab2);
  var p0 = SK.s[0].g.position, p1 = SK.s[19].g.position;
  SK.lab1.position.set(p0.x, 0.6, p0.z+0.05); SK.lab2.position.set(p1.x, 0.6, p1.z+0.05);
})();
function stacksSet(grow, warm){
  for(var i=0;i<20;i++){ var s = SK.s[i]; var k = clamp(grow*20.8 - i, 0, 1), e = k*k*(3-2*k);
    var h = Math.max(0.002, s.h*e); s.b.scale.set(1, h, 1); s.b.position.y = h/2; s.g.visible = e > 0.001; }
  for(var j=0;j<SK.m.length;j++){ var on = (j >> 1) % 7 !== 3 ? 1 : 0.15; SK.m[j].emissive.setRGB(0.34*warm*on, 0.2*warm*on, 0.06*warm*on); }   /* 多くの人 — không phải tất cả */
}

/* =========================================================================
 * 席: (a) văn phòng kiểu 島型 — bàn 部長 ở đầu, biển tên đồng; (b) bàn ăn gia đình, ghế 上座
 * Nhìn TỪ TRÊN CAO (khác hẳn khung "ghế trống ngang tầm mắt" của ep06).
 * ========================================================================= */
var OFFICE = reg('office', new THREE.Group()); OFFICE.position.set(60,0,0);
var OF = {};
function officeChair(col){
  var g = new THREE.Group(), m = std(col,0.7), met = std(0x444444,0.35,0.7);
  var seat = new THREE.Mesh(new THREE.BoxGeometry(0.46,0.07,0.44), m); seat.position.y = 0.46; seat.castShadow = true; g.add(seat);
  var back = new THREE.Mesh(new THREE.BoxGeometry(0.44,0.52,0.06), m); back.position.set(0,0.8,-0.2); back.rotation.x = -0.1; back.castShadow = true; g.add(back);
  var st = new THREE.Mesh(new THREE.CylinderGeometry(0.025,0.025,0.36,12), met); st.position.y = 0.26; g.add(st);
  for(var i=0;i<5;i++){ var a = i*1.2566; var leg = new THREE.Mesh(new THREE.BoxGeometry(0.3,0.025,0.04), met); leg.position.set(Math.cos(a)*0.15,0.06,Math.sin(a)*0.15); leg.rotation.y = -a; g.add(leg); }
  return g;
}
(function buildOffice(){
  var carpet = canvasTex(512,512,function(cx,w,h){ var q = HFA.mulberry32(3); for(var i=0;i<8;i++) for(var j=0;j<8;j++){ var v = 64+Math.floor(q()*14); cx.fillStyle = 'rgb('+(v-6)+','+v+','+(v+6)+')'; cx.fillRect(i*64,j*64,64,64); }
    addNoise(cx, w, h, 4, 20); }, [8,6]);
  var fl = new THREE.Mesh(new THREE.PlaneGeometry(12,9), new THREE.MeshStandardMaterial({map:carpet, roughness:0.95})); fl.rotation.x = -Math.PI/2; fl.receiveShadow = true; OFFICE.add(fl);
  var deskM = std(0xcfcac0,0.45), legM = std(0x777777,0.4,0.6), mon = std(0x151515,0.4);
  function desk(x,z,rot,w){ var g = new THREE.Group(); g.position.set(x,0,z); g.rotation.y = rot; OFFICE.add(g);
    boxIn(g, w||1.2,0.03,0.7, 0,0.72,0, deskM); boxIn(g, 0.04,0.7,0.6, -(w||1.2)/2+0.03,0.36,0, legM); boxIn(g, 0.04,0.7,0.6, (w||1.2)/2-0.03,0.36,0, legM);
    boxIn(g, 0.5,0.32,0.03, 0,0.97,-0.2, mon); boxIn(g, 0.06,0.1,0.06, 0,0.79,-0.2, mon);
    var pap = boxIn(g, 0.21,0.01,0.297, 0.35,0.74,0.08, std(0xf0ece2,0.9)); pap.rotation.y = 0.2;
    var ch = officeChair(0x2a2e36); ch.position.set(0,0,0.6); ch.rotation.y = Math.PI; g.add(ch);
    return g; }
  for(var i=0;i<4;i++){ desk(-1.5+i*1.25, -0.4, Math.PI, 1.2); desk(-1.5+i*1.25, 0.4, 0, 1.2); }
  /* bàn 部長: ở đầu, quay mặt về các dãy */
  var bd = new THREE.Group(); bd.position.set(3.6,0,0); bd.rotation.y = -Math.PI/2; OFFICE.add(bd); OF.bucho = bd;
  var bdM = std(0x5a3c28,0.4); bdM.map = RM.woodM.map;
  boxIn(bd, 1.6,0.04,0.8, 0,0.74,0, bdM); boxIn(bd, 1.6,0.7,0.04, 0,0.37,-0.37, bdM); boxIn(bd, 0.05,0.72,0.78, -0.77,0.36,0, bdM); boxIn(bd, 0.05,0.72,0.78, 0.77,0.36,0, bdM);
  var ch2 = officeChair(0x1a1a1e); ch2.scale.set(1.12,1.12,1.12); ch2.position.set(0,0,-0.7); bd.add(ch2); OF.chair = ch2;
  /* biển tên để bàn — cùng chất liệu đồng với tấm trên ma-nơ-canh (nối liên tưởng) */
  var np = makePlate('部長', {a:3.0, b:3.0, th0:-0.028, th1:0.028, y0:-0.035, y1:0.035, thick:0.012, relief:0.004, nu:160, local:true}, 21);
  var npHold = new THREE.Group(); npHold.position.set(0, 0.8, 0.25); npHold.rotation.x = -0.35; bd.add(npHold);
  np.pivot.rotation.y = 0; npHold.add(np.pivot); OF.np = np; OF.npHold = npHold;
  var stand = new THREE.Mesh(new THREE.BoxGeometry(0.2,0.03,0.05), std(0x2a1a12,0.4)); stand.position.set(0,0.755,0.26); bd.add(stand);
  /* cửa sổ sau lưng bàn 部長 — rèm lá sáng */
  var blinds = canvasTex(256,512,function(cx,w,h){ cx.fillStyle = '#f2f2ee'; cx.fillRect(0,0,w,h); cx.fillStyle = 'rgba(120,120,120,0.35)'; for(var y=0;y<h;y+=16) cx.fillRect(0,y,w,3); });
  var win = new THREE.Mesh(new THREE.PlaneGeometry(3.2,1.8), new THREE.MeshBasicMaterial({map:blinds, color:new THREE.Color(0.95,0.95,0.92)})); win.position.set(4.9,1.4,0); win.rotation.y = -Math.PI/2; OFFICE.add(win);
  /* nhãn kỳ vọng lơ lửng trên ghế 部長 */
  OF.exp1 = labelPlane('決める人であってほしい', 0.42, '#ffe2b8', {fpx:84, bg:'rgba(12,10,8,0.62)'}); OF.exp1.position.set(3.0, 1.75, -0.2); OFFICE.add(OF.exp1);
  OF.exp0 = labelPlane('役割 ＝ 求められる振る舞い', 0.36, '#efe6d6', {fpx:84, bg:'rgba(12,10,8,0.62)'}); OF.exp0.position.set(2.7, 1.3, 0.9); OFFICE.add(OF.exp0);
  OF.seatLab = labelPlane('地位 ＝ 席', 0.36, '#efe6d6', {fpx:84, bg:'rgba(12,10,8,0.62)'}); OF.seatLab.position.set(3.0, 1.75, -0.2); OFFICE.add(OF.seatLab);
})();
var FAMILY = reg('family', new THREE.Group()); FAMILY.position.set(90,0,0);
var FM = {};
(function buildFamily(){
  var fl = new THREE.Mesh(new THREE.PlaneGeometry(8,8), new THREE.MeshStandardMaterial({map:RM.woodM.map, roughness:0.5, color:0xb09070})); fl.rotation.x = -Math.PI/2; fl.receiveShadow = true; FAMILY.add(fl);
  var tm = std(0x6a4a30,0.45); tm.map = RM.woodM.map;
  boxIn(FAMILY, 1.5,0.04,0.85, 0,0.72,0, tm);
  [[-0.7,-0.38],[0.7,-0.38],[-0.7,0.38],[0.7,0.38]].forEach(function(p){ boxIn(FAMILY, 0.05,0.7,0.05, p[0],0.35,p[1], tm); });
  function chair(x,z,rot){ var g = new THREE.Group(); g.position.set(x,0,z); g.rotation.y = rot; FAMILY.add(g);
    boxIn(g, 0.42,0.04,0.42, 0,0.44,0, tm); boxIn(g, 0.42,0.5,0.03, 0,0.7,-0.2, tm);
    [[-0.19,-0.19],[0.19,-0.19],[-0.19,0.19],[0.19,0.19]].forEach(function(p){ boxIn(g, 0.035,0.44,0.035, p[0],0.22,p[1], tm); }); return g; }
  FM.head = chair(1.05,0,-Math.PI/2);  /* 上座 — đầu bàn */
  chair(-0.35,0.62,Math.PI); chair(0.35,0.62,Math.PI); chair(-0.35,-0.62,0); chair(0.35,-0.62,0);
  /* chén trà của bố ở đầu bàn */
  var cup = new THREE.Mesh(new THREE.LatheGeometry([[0,0],[0.03,0],[0.034,0.01],[0.04,0.08],[0.037,0.08],[0.031,0.012],[0,0.012]].map(function(p){ return new THREE.Vector2(p[0],p[1]); }),32), std(0x4a5a6a,0.3));
  cup.position.set(0.58,0.74,0); cup.castShadow = true; FAMILY.add(cup);
  for(var i=0;i<4;i++){ var bowl = new THREE.Mesh(new THREE.SphereGeometry(0.05,20,12,0,Math.PI*2,0,Math.PI/2), std(0xe8e0d0,0.3)); bowl.rotation.x = Math.PI; bowl.position.set(-0.35+(i%2)*0.7, 0.79, (i<2?0.25:-0.25)); FAMILY.add(bowl); }
  var lampM = new THREE.MeshBasicMaterial({color:new THREE.Color(3.5,2.7,1.8)}); var bl = new THREE.Mesh(new THREE.SphereGeometry(0.05,16,12), lampM); bl.position.set(0,1.88,0); FAMILY.add(bl);
  var shd = new THREE.Mesh(new THREE.ConeGeometry(0.22,0.16,32,1,true), new THREE.MeshStandardMaterial({color:0xefe2c8, roughness:0.6, side:THREE.DoubleSide, emissive:new THREE.Color(0.5,0.35,0.18)})); shd.position.set(0,1.95,0); FAMILY.add(shd);
  var cdd = new THREE.Mesh(new THREE.CylinderGeometry(0.004,0.004,1.2,6), std(0x1a1a1a,0.6)); cdd.position.set(0,2.62,0); FAMILY.add(cdd);
  FM.exp = labelPlane('頼れる人であってほしい', 0.36, '#ffe2b8', {fpx:84, bg:'rgba(12,10,8,0.62)'}); FM.exp.position.set(1.0, 1.45, 0.1); FAMILY.add(FM.exp);
})();

/* =========================================================================
 * DÒNG KỲ VỌNG: hạt chảy từ các điểm sáng xung quanh (người cần mình) vào tấm đồng.
 * Nhóm A (công ty) bên phải → 部長/先輩. Nhóm B (gia đình) bên trái → 父/夫.
 * ========================================================================= */
var STR = reg('strands', new THREE.Group());
var SR = {src:[], N:2600};
(function buildStrands(){
  var q = HFA.mulberry32(707);
  for(var i=0;i<14;i++){ var grp = i<8 ? 0 : 1; var a = grp===0 ? (-0.2 + (i/7)*1.9) : (Math.PI - 0.2 - ((i-8)/5)*1.6);
    var R = 3.2 + q()*2.2, y = 0.4 + q()*2.0;
    var p = new THREE.Vector3(Math.cos(a)*R, y, -Math.abs(Math.sin(a))*R*0.8 - 0.8 + (grp===0?0.0:0.0));
    var gl = makeGlow(grp===0 ? [0.95,0.85,0.7] : [1.0,0.74,0.5], 0.0, 0.05, 0.25); gl.position.copy(p); STR.add(gl);
    SR.src.push({p:p, grp:grp, g:gl, tgt: grp===0 ? (i%3===0 ? 'senpai' : 'bucho') : (i%2===0 ? 'chichi' : 'otto'), ph:q()}); }
  var d = makeDyn(SR.N, {maxPx:9, near:0.3}); STR.add(d); SR.d = d;
  SR.meta = []; for(var k=0;k<SR.N;k++) SR.meta.push(Math.floor(q()*14), q(), 0.012+q()*0.012, (q()-0.5)*0.5);
})();
var _tp = {bucho:new THREE.Vector3(), chichi:new THREE.Vector3(), otto:new THREE.Vector3(), senpai:new THREE.Vector3()};
/** amp = [cường độ nhóm A, nhóm B]; srcOn[i] = độ sáng từng nguồn (null = theo amp) */
function strandsSet(t, amp, srcOn){
  FIG.root.updateMatrixWorld(true);
  for(var k in _tp){ PL[k].pivot.getWorldPosition(_tp[k]); }
  var P = SR.d.geometry.attributes.position.array, A = SR.d.geometry.attributes.aA.array, C = SR.d.geometry.attributes.aC.array, S = SR.d.geometry.attributes.aS.array;
  for(var i=0;i<SR.src.length;i++){ var s = SR.src[i]; var on = srcOn ? srcOn[i] : amp[s.grp]; s.on = on; s.g.material.uniforms.uI.value = 1.1*on*(0.9+0.1*Math.sin(t*1.3+s.ph*6)); }
  for(var j=0;j<SR.N;j++){ var m = j*4, si = SR.meta[m], s2 = SR.src[si], tg = _tp[s2.tgt];
    var u = (t*0.16 + SR.meta[m+1]) % 1;
    var cx = (s2.p.x + tg.x)*0.5 + SR.meta[m+3], cy = Math.max(s2.p.y, tg.y) + 0.8, cz = (s2.p.z + tg.z)*0.5 + 0.6;
    var a = (1-u)*(1-u), b = 2*u*(1-u), c = u*u;
    P[j*3] = a*s2.p.x + b*cx + c*tg.x; P[j*3+1] = a*s2.p.y + b*cy + c*tg.y; P[j*3+2] = a*s2.p.z + b*cz + c*tg.z;
    A[j] = s2.on * Math.sin(u*Math.PI) * 1.6;
    if(s2.grp===0){ C[j*3]=1.0; C[j*3+1]=0.9; C[j*3+2]=0.72; } else { C[j*3]=1.0; C[j*3+1]=0.76; C[j*3+2]=0.5; }
    S[j] = SR.meta[m+2]; }
  dynCommit(SR.d);
}

/* ---- những lõi xa (C62: mỗi người một nhịp) ---- */
var FAR = reg('far', new THREE.Group());
var FR = [];
(function(){ var q = HFA.mulberry32(909);
  for(var i=0;i<9;i++){ var a = -1.3 + i*0.33 + (q()-0.5)*0.1, R = 5 + q()*6;
    var g = makeGlow(CORE_COL, 0.0, 0.09, 0.3); g.position.set(Math.sin(a)*R*0.8, 0.9+q()*1.4, -Math.cos(a)*R*0.8 - 1); FAR.add(g);
    FR.push({g:g, rate:0.08 + q()*0.5, delay:q()*6}); }
})();

/* ---- ma-nơ-canh thứ hai cho "cách nhìn cũ" (C38): tấm 仕事 ở tim; bỏ tấm → thân rỗng ---- */
var FIGO = reg('figOld', new THREE.Group());
var CLAY2 = new THREE.MeshStandardMaterial({color:0x9a948a, roughness:0.6, transparent:true, opacity:1});
var FIG2 = buildFigure(CLAY2); FIGO.add(FIG2.root);
var PL2 = makePlate('仕事', {a:0.232, b:0.150, th0:-0.86, th1:0.86, y0:0.295, y1:0.475, thick:0.016, relief:0.007, nu:220}, 31);
FIG2.spine.add(PL2.pivot);
var FIG2_SHELL = new THREE.Group(); FIGO.add(FIG2_SHELL);
(function(){ /* đường viền rỗng (fresnel) hiện khi thân mờ đi */
  var sm = new THREE.ShaderMaterial({ uniforms:{uCol:{value:new THREE.Color(0.7,0.72,0.78)}, uOp:{value:0}},
    vertexShader:'varying vec3 vN; varying vec3 vV; void main(){ vec4 w=modelMatrix*vec4(position,1.0); vN=normalize(mat3(modelMatrix)*normal); vV=normalize(cameraPosition-w.xyz); gl_Position=projectionMatrix*viewMatrix*w; }',
    fragmentShader:'uniform vec3 uCol; uniform float uOp; varying vec3 vN; varying vec3 vV; void main(){ float f=pow(1.0-abs(dot(normalize(vN),normalize(vV))),2.4); gl_FragColor=vec4(uCol*f*uOp,1.0); }',
    transparent:true, depthWrite:false, blending:THREE.AdditiveBlending });
  FIG2.root.traverse(function(o){ if(o.isMesh && o.material === CLAY2){ var c = new THREE.Mesh(o.geometry, sm); c.position.copy(o.position); c.rotation.copy(o.rotation); c.scale.copy(o.scale); c.scale.multiplyScalar(1.002); o.parent.add(c); } });
  FIG2_SHELL.userData.m = sm;
})();

/* ---- bộ sợi ngắn cho khung đôi (C45–C48) + vạch chia ---- */
var MINI = reg('mini', new THREE.Group()); MINI.position.set(1.05,0.12,0); MINI.scale.set(1.35,1.02,1.35);
(function(){
  var C = [new THREE.Vector3(-0.1,0.3,-3.5), new THREE.Vector3(0.3,0.8,-2.0), new THREE.Vector3(0.0,1.2,-0.8), new THREE.Vector3(-0.3,1.35,0.0), new THREE.Vector3(-0.2,1.9,0.6)];
  var center = new THREE.CatmullRomCurve3(C), inner = [], outer = [], tng = new THREE.Vector3(), side = new THREE.Vector3(), up2 = new THREE.Vector3(), up = new THREE.Vector3(0,1,0);
  for(var i=0;i<=400;i++){ var s = i/400, p = center.getPointAt(s); center.getTangentAt(s,tng); side.crossVectors(tng,up).normalize(); up2.crossVectors(side,tng).normalize();
    var ph = s*26, R = 0.07; inner.push(p.clone().addScaledVector(side,Math.cos(ph)*R).addScaledVector(up2,Math.sin(ph)*R)); outer.push(p.clone().addScaledVector(side,-Math.cos(ph)*R).addScaledVector(up2,-Math.sin(ph)*R)); }
  function th(pts, col){ var m = TH.inM.clone(); m.uniforms = THREE.UniformsUtils.clone(TH.inM.uniforms); m.uniforms.uT = UT; m.uniforms.uCol.value.setRGB(col[0],col[1],col[2]);
    var tb = new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts), 700, 0.012, 8, false), m); MINI.add(tb); return m; }
  MINI.userData.a = th(inner, [1.0,0.72,0.42]); MINI.userData.b = th(outer, [0.55,0.72,0.95]);
})();
var DIVIDER = reg('divider', new THREE.Mesh(new THREE.PlaneGeometry(0.006, 3.2), new THREE.MeshBasicMaterial({color:new THREE.Color(1.4,1.3,1.15), transparent:true, opacity:0.7})));

/* ---- cận cảnh danh thiếp: hai lớp chồng để hoà giữa các trạng thái đã dựng sẵn ---- */
var CC = {tex:[]};
var CLOSECARD = new THREE.Group(); ROOM.add(CLOSECARD);
(function(){
  var states = [{co:1,dept:1,title:1,name:1},{co:1,dept:1,title:0,name:1},{co:0,dept:0,title:0,name:1}];
  states.forEach(function(st, i){ CC.tex.push(null);
    glyphAsset(function(){ if(CC.tex[i]) CC.tex[i].dispose(); CC.tex[i] = canvasTex(1100,660,function(cx,w,h){ drawCard(cx,w,h,st); }); if(CC.mA) { CC.mA.needsUpdate = true; } }); });
  CC.mA = new THREE.MeshStandardMaterial({roughness:0.8});
  CC.mB = new THREE.MeshStandardMaterial({roughness:0.8, transparent:true, opacity:0, depthWrite:false});
  var a = new THREE.Mesh(new THREE.BoxGeometry(CARD_W,0.0004,CARD_H), [std(0xf2f0ea,0.8),std(0xf2f0ea,0.8),CC.mA,std(0xf2f0ea,0.8),std(0xf2f0ea,0.8),std(0xf2f0ea,0.8)]);
  a.receiveShadow = true; a.castShadow = true; CLOSECARD.add(a);
  var b = new THREE.Mesh(new THREE.PlaneGeometry(CARD_W,CARD_H), CC.mB); b.rotation.x = -Math.PI/2; b.position.y = 0.00025; CLOSECARD.add(b);
  CLOSECARD.position.set(TABLE_P.x-0.12, TABLE_TOP_Y+0.0003, TABLE_P.z+0.2); CLOSECARD.rotation.y = -0.2;
  /* chữ 部長 "trả lại": tấm đồng mỏng tí hon bóc khỏi danh thiếp (C72) */
  CC.lift = makePlate('部長', {a:4.0, b:4.0, th0:-0.0036, th1:0.0036, y0:-0.0055, y1:0.0055, thick:0.0008, relief:0.0005, nu:120, local:true}, 41);
  CC.liftHold = new THREE.Group(); CLOSECARD.add(CC.liftHold); CC.liftHold.add(CC.lift.pivot);
})();
function cardState(a, b, mix){
  if(CC.tex[a] && CC.mA.map !== CC.tex[a]){ CC.mA.map = CC.tex[a]; CC.mA.needsUpdate = true; }
  if(CC.tex[b] && CC.mB.map !== CC.tex[b]){ CC.mB.map = CC.tex[b]; CC.mB.needsUpdate = true; }
  CC.mB.opacity = mix;
}
/* ---- tài liệu văn phòng ngày trước (C68, hồi tưởng) — cùng chỗ tờ báo ---- */
var DOC = new THREE.Group(); ROOM.add(DOC);
(function(){
  var m = new THREE.MeshStandardMaterial({roughness:0.9});
  glyphAsset(function(){ if(m.map) m.map.dispose(); m.map = canvasTex(1000,1400,function(cx,w,h){
    cx.fillStyle = '#f1ecdf'; cx.fillRect(0,0,w,h); cx.fillStyle = '#1e1c1a'; cx.textBaseline = 'middle';
    cx.font = '700 54px '+JP; cx.fillText('営業本部　月次報告', 70, 90); cx.fillRect(70,140,w-140,3);
    cx.font = '400 34px '+JP; var rows = ['売上高','前年同月比','受注件数','粗利益','販管費','営業利益'], v = ['1,284','103.2%','412','386','241','145'];
    for(var i=0;i<rows.length;i++){ var y = 230+i*90; cx.fillText(rows[i], 90, y); cx.fillText(v[i], 620, y); cx.fillStyle='rgba(0,0,0,0.25)'; cx.fillRect(70,y+40,w-140,2); cx.fillStyle='#1e1c1a'; }
    cx.strokeStyle = '#c1261c'; cx.lineWidth = 7; cx.lineCap = 'round';
    cx.beginPath(); cx.ellipse(680,320,110,44,0,0,7); cx.stroke();
    cx.beginPath(); cx.moveTo(850,500); cx.lineTo(880,540); cx.lineTo(940,460); cx.stroke();
    cx.beginPath(); cx.ellipse(680,680,110,44,0,0,7); cx.stroke();
    cx.fillStyle = 'rgba(0,0,0,0.5)'; var q = HFA.mulberry32(5);
    for(var L=0;L<12;L++){ cx.fillRect(90, 820+L*44, 300+q()*450, 8); }
  }); m.needsUpdate = true; });
  var p = new THREE.Mesh(new THREE.PlaneGeometry(0.297,0.42), m); p.rotation.x = -Math.PI/2; p.receiveShadow = true; DOC.add(p);
  DOC.position.set(TABLE_P.x+0.05, TABLE_TOP_Y+0.0012, TABLE_P.z+0.12); DOC.rotation.y = -0.12;
})();
/* ---- "những bản thân khác" thoáng qua quanh vai (C21) ---- */
var MOTES = makeDyn(420, {maxPx:9, near:0.3}); FIGG.add(MOTES);
/* "bản thân khác": ba quầng sáng mờ ngoài vai, hiện rồi tan (không phải chữ mới) */
var ALT = []; [[-0.62,1.62,0.05],[0.66,1.72,0.0],[0.08,2.12,-0.25]].forEach(function(p){ var g = makeGlow([0.78,0.86,1.0], 0.0, 0.07, 0.3, true); g.position.set(p[0],p[1],p[2]); FIGG.add(g); ALT.push(g); });
var MO_B = []; (function(){ var q = HFA.mulberry32(222); for(var i=0;i<420;i++){ var c = i%3; var cx = [-0.55,0.6,0.05][c], cy = [1.55,1.7,1.95][c], cz = [0.15,0.05,-0.2][c];
  MO_B.push(cx+gauss(q)*0.07, cy+gauss(q)*0.12, cz+gauss(q)*0.06, q(), c); } })();
function motesSet(t, amp){
  var P = MOTES.geometry.attributes.position.array, A = MOTES.geometry.attributes.aA.array, C = MOTES.geometry.attributes.aC.array, S = MOTES.geometry.attributes.aS.array;
  for(var i=0;i<420;i++){ var b = i*5, ph = MO_B[b+3]*6.283, a = amp[MO_B[b+4]];
    P[i*3] = MO_B[b] + 0.02*Math.sin(t*0.6+ph); P[i*3+1] = MO_B[b+1] + 0.03*Math.sin(t*0.4+ph); P[i*3+2] = MO_B[b+2];
    A[i] = a*(0.5+0.5*Math.sin(t*1.1+ph*2)); C[i*3]=0.85; C[i*3+1]=0.88; C[i*3+2]=1.0; S[i] = 0.012; }
  dynCommit(MOTES);
}
/* ---- vòng tối "sàn biến mất" (C07, C28) — mặt phẳng đen có lỗ tròn mép mềm ---- */
var HOLE = new THREE.Mesh(new THREE.PlaneGeometry(12,12), new THREE.ShaderMaterial({
  uniforms:{uC:{value:new THREE.Vector2(0,0)}, uR:{value:10}, uOp:{value:1}},
  vertexShader:'varying vec2 vP; void main(){ vec4 w=modelMatrix*vec4(position,1.0); vP=w.xz; gl_Position=projectionMatrix*viewMatrix*w; }',
  fragmentShader:'uniform vec2 uC; uniform float uR,uOp; varying vec2 vP; void main(){ float d=length(vP-uC); float a=smoothstep(uR, uR+0.45, d); gl_FragColor=vec4(0.0,0.0,0.0,a*uOp); }',
  transparent:true, depthWrite:false }));
HOLE.rotation.x = -Math.PI/2; HOLE.position.y = 0.006; HOLE.renderOrder = 5; ROOM.add(HOLE);
/* ---- bút cho cảnh trung (bàn tay khối) ---- */
var PEN2 = PEN.clone(); PEN2.scale.setScalar(1.0); ME.elR.add(PEN2); PEN2.position.set(0.0,-0.33,0.02); PEN2.rotation.set(0.9,0,0.3);

/* =========================================================================
 * CAMERA + TIỆN ÍCH
 * ========================================================================= */
var _look = new THREE.Vector3();
function setCam(px,py,pz, tx,ty,tz, fov){ camera.position.set(px,py,pz); _look.set(tx,ty,tz); camera.lookAt(_look); camera.fov = fov || FOV0; }
function camLerp(p, A, B){ var q = []; for(var i=0;i<7;i++) q.push(A[i] + (B[i]-A[i])*p); setCam(q[0],q[1],q[2],q[3],q[4],q[5],q[6]); }
function handheld(t, amt){ camera.position.x += (Math.sin(t*0.71)*0.004 + Math.sin(t*1.93)*0.0015)*amt; camera.position.y += Math.sin(t*0.53+1.1)*0.0035*amt; }
function orbitCam(cx,cy,cz, rad, th, h, tx,ty,tz, fov){ setCam(cx + rad*Math.sin(th), cy + h, cz + rad*Math.cos(th), tx,ty,tz, fov); }
function faceCam(o){ o.quaternion.copy(camera.quaternion); }
function tagSet(el, title, sub, op){
  var html = '<b>'+title+'</b>' + (sub ? '<i>'+sub+'</i>' : '');
  if(el._h !== html){ el.innerHTML = html; el._h = html; }
  el.style.opacity = clamp(op,0,1).toFixed(3);
}
function bigSet(txt, sub, op){
  var html = txt + (sub ? '<i>'+sub+'</i>' : '');
  if(bigEl._h !== html){ bigEl.innerHTML = html; bigEl._h = html; }
  bigEl.style.opacity = clamp(op,0,1).toFixed(3);
}

/* =========================================================================
 * TRẠNG THÁI CHUNG MỖI FRAME — mọi thứ một shot sửa đều được đặt lại ở đây
 * (render phân tán có thể bắt đầu ở bất kỳ frame nào)
 * ========================================================================= */
var FX = { sat:1, mul:[1,1,1] };
var DESK_PROPS = [BOOK_EX, JOURNAL, BOOK_LIN, STACK, OPENBOOK, TAPE, NOTE, DICT, FIXIT, PICBOOK];
function resetFrame(){
  for(var k in G) G[k].visible = false;
  FX.sat = 1; FX.mul = [1,1,1];
  camera.up.set(0,1,0);
  hemi.intensity = 0; sun.intensity = 0; key.intensity = 0; rim.intensity = 0; fill.intensity = 0; lamp.intensity = 0; amb.intensity = 0;
  hemi.color.set(0xdfe4ea); hemi.groundColor.set(0x5e5448);
  key.angle = 0.55; key.penumbra = 0.7; key.distance = 30; key.color.set(0xfff0dc);
  bgMat.uniforms.uTop.value.setRGB(0,0,0); bgMat.uniforms.uBot.value.setRGB(0,0,0);
  bloomPass.strength = 0.5;
  tagSet(tagLEl, '', '', 0); tagSet(tagREl, '', '', 0); bigSet('', '', 0);
  /* phòng */
  FUTON.visible = false; ALARM.visible = true; ME.root.visible = false; HANDRIG.visible = false; NEWS.g.visible = false; DOC.visible = false;
  CLOSECARD.visible = false; RM.cardCase.visible = true; RM.table.visible = true; RM.dust.visible = true; HOLE.visible = false; PEN2.visible = false;
  meCore.material.uniforms.uI.value = 0; meResid.material.uniforms.uI.value = 0;
  ROOM.position.set(0,0,0);
  /* ma-nơ-canh */
  FIGG.position.set(0,0,0); FIG.root.position.set(0,0,0); FIG.root.rotation.set(0,0,0);
  plateSet(PL.bucho, {}); plateSet(PL.chichi, {}); plateSet(PL.otto, {}); plateSet(PL.senpai, {});
  SEAM.material.uniforms.uI.value = 0; RESID.material.uniforms.uI.value = 0; GEN_MARK.material.opacity = 0; GEN_MARK.visible = true;
  CORE_UNI.uCoreI.value = 0; figCore.material.uniforms.uI.value = 0; MOTES.visible = false; for(var ai=0; ai<ALT.length; ai++) ALT[ai].material.uniforms.uI.value = 0;
  RM.ceil.visible = true; setCalendar(6);
  FIG.root.updateMatrixWorld(true); FIG.spine.localToWorld(CORE_UNI.uCoreP.value.copy(CORE_LOCAL));
  VD.floorM.opacity = 1; VD.floor.visible = true; VD.dust.visible = true;
  for(var d=0; d<DESK_PROPS.length; d++) DESK_PROPS[d].visible = false;
  CLAY2.opacity = 1; FIG2_SHELL.userData.m.uniforms.uOp.value = 0; plateSet(PL2, {});
  if(OF.np.mat) OF.np.mat.color.setScalar(1); HANDP.userData.sleeve.color.set(0x7a6450); CC.liftHold.visible = false;
}
function deskProps(list){ for(var i=0;i<list.length;i++) list[i].visible = true; }
/* ---- ánh sáng từng "thế giới" ---- */
var _tgt = new THREE.Vector3();
function roomLight(k, warm){
  show('room'); scene.environment = envRoom; warm = warm||0;
  _tgt.set(-0.2, 0.3, -0.45);
  sun.position.copy(_tgt).addScaledVector(SUN_DIR, -9); sun.target.position.copy(_tgt);
  sun.color.setRGB(lerp(0.62,1.0,k), lerp(0.72,0.9+0.02*warm,k), lerp(0.95,0.76-0.08*warm,k));
  sun.intensity = lerp(0.12, 2.1, k);
  hemi.color.setRGB(lerp(0.55,0.95,k), lerp(0.62,0.92,k), lerp(0.8,0.86,k)); hemi.groundColor.setRGB(0.36,0.32,0.26);
  hemi.intensity = lerp(0.1, 0.46, k);
  fill.position.set(0.9, 1.9, 1.0); fill.intensity = lerp(0.06, 0.22, k); fill.distance = 6;
  var pv = lerp(0.16, 1.6, k); RM.paperM.color.setRGB(pv, pv*lerp(1.02,0.97,k), pv*lerp(1.1,0.9-0.05*warm,k));
  var ov = lerp(0.25, 2.4, k); RM.outM.color.setRGB(ov*lerp(0.85,1,k), ov*lerp(0.9,0.98,k), ov*lerp(1.1,0.92,k));
  RM.beamM.uniforms.uOp.value = lerp(0.15, 1.0, k); RM.beamM.uniforms.uCol.value.setRGB(1.0, 0.93-0.02*warm, 0.8-0.08*warm);
  roomDust(UT.value, lerp(0.2, 1.0, k));
  bloomPass.strength = 0.42;
}
function voidLight(br, t){
  show('void'); scene.environment = envVoid;
  key.position.set(1.3, 4.6, 2.9); key.target.position.set(0, 0.9, 0); key.intensity = 1.45*br; key.angle = 0.3; key.penumbra = 0.85; key.color.set(0xffefd8);
  rim.position.set(-3, 3.2, -4.5); rim.target.position.set(0, 1.0, 0); rim.intensity = 0.6*br;
  fill.position.set(-0.8, 1.3, 2.6); fill.intensity = 0.22*br; fill.distance = 8;
  amb.intensity = 0.1; amb.color.set(0x3a3a44); hemi.intensity = 0.04;
  bgMat.uniforms.uTop.value.setRGB(0.028,0.025,0.022); bgMat.uniforms.uBot.value.setRGB(0.006,0.005,0.005);
  voidDust(t, 0.6*br, 0);
  bloomPass.strength = 0.55;
}
function deskLight(on){
  show('desk'); scene.environment = envDesk;
  lamp.position.copy(DK.lampPos); lamp.intensity = 2.8*on; lamp.distance = 3.2;
  amb.intensity = 0.06; amb.color.set(0x404858); hemi.intensity = 0.03;
  bloomPass.strength = 0.5;
}
function deskDay(){
  show('desk'); scene.environment = envRoom;
  _tgt.set(-30, 0.76, 0); sun.position.set(-30-3.0, 4.2, -1.8); sun.target.position.copy(_tgt); sun.intensity = 1.05; sun.color.set(0xfff1de);
  hemi.intensity = 0.28; hemi.color.set(0xe8eef4); fill.position.set(-29.2,1.6,1.0); fill.intensity = 0.15;
  bgMat.uniforms.uTop.value.setRGB(0.05,0.045,0.04); bgMat.uniforms.uBot.value.setRGB(0.02,0.018,0.016);
  bloomPass.strength = 0.4;
}
/* ---- tư thế người trong phòng ---- */
function meStand(x, z, heading, extra){ ME.root.visible = true; place(ME, x, z, heading); var p = {hp:-0.02}; if(extra) for(var k in extra) p[k] = extra[k]; pose(ME, p); }
function meFuton(lean, t){
  ME.root.visible = true; FUTON.visible = true;
  place(ME, FUT_P.x, FUT_P.z, 0, 0.055);
  pose(ME, {floor:true, lean:lean, hp:0.1*clamp(-lean,0,1.5)/1.5 + 0.02*Math.sin(t*0.4), aLx:-0.15*(1-clamp(-lean/1.5,0,1)), aRx:-0.15*(1-clamp(-lean/1.5,0,1))});
}
function meSeiza(t, lean, reach){
  ME.root.visible = true; RM.zabuton.visible = true;
  place(ME, TABLE_P.x, TABLE_P.z+0.74, Math.PI);
  pose(ME, {seiza:true, lean:lean||0.18, hp:0.35, aLx:-0.55, aRx:-0.55, eL:-1.0, eR:-0.9});
  if(reach){ newsWorld(NEWS.circles[1][0], NEWS.circles[1][1], _vc); _vc.y += 0.03; aimArm(ME, 'R', _vc, reach, 0.9); }
}

/* =========================================================================
 * 51 SHOT — SHOT[k](u, t)   u = giây trong shot · t = giây cảnh tuyệt đối
 * ========================================================================= */
var SHOT = {};
var DAWN = 0.08;

/* ---------- CHƯƠNG 1 — 月曜日の九時 ---------- */
SHOT.S01 = function(u, t){   /* C01 phòng 八畳 lúc rạng sáng — một người trên futon */
  roomLight(DAWN + 0.05*lin(t,0,5.88), 0);
  meClothes('pj'); meFuton(-1.5, t);
  setClock(ALARM, 6*3600+29*60+44+t);
  setClock(WALLCLOCK, 6*3600+29*60+44+t);
  var p = ease(u/5.88);
  setCam(lerp(1.55,1.35,p), lerp(1.75,1.6,p), lerp(1.55,1.4,p), -0.55, 0.15, 0.1, 44);
};
SHOT.S02 = function(u, t){   /* C02 đồng hồ báo thức 6:30 đúng — không reo · rồi ngồi dậy */
  roomLight(DAWN + 0.08 + 0.06*lin(t,5.88,16.24), 0);
  meClothes('pj');
  var sec = 6*3600+30*60 + (t - 10.42);
  setClock(ALARM, sec); setClock(WALLCLOCK, sec);
  if(t < 12.9){
    meFuton(-1.5 + 0.06*ramp(t,10.5,12.5), t);
    var p = ease(u/7.0);
    setCam(lerp(0.33,0.27,p), 0.12, lerp(-0.12,-0.2,p), 0.07, 0.07, -0.42, 34);
  } else {
    var s = ramp(t, 12.9, 14.9);
    meFuton(lerp(-1.45, -0.06, s), t);
    ME.head.rotation.x = lerp(0.1, 0.05, s);
    setCam(0.75, 0.95, 1.75, -0.55, 0.55, 0.3, 40);
    handheld(t, 0.6);
  }
};
SHOT.S03 = function(u, t){   /* C03 sơ mi đã mặc; tay vươn tới cà vạt rồi dừng */
  roomLight(0.45, 0);
  meClothes('shirt');
  setClock(WALLCLOCK, 6*3600+48*60+t);
  meStand(-0.42, -1.12, Math.PI, {hp:0.05});
  var reach = ramp(t, 21.5, 23.4) * (1 - ramp(t, 24.6, 25.9));
  var stop = 1 - 0.35*ramp(t,23.0,23.7);
  if(reach > 0.001){ _vc.set(-0.55, 1.6, lerp(-1.25, -1.42, stop)); aimArm(ME, 'L', _vc, reach, 0.35); }
  ME.head.rotation.x = 0.12 + 0.08*reach;
  var p = ease(u/9.85);
  setCam(lerp(0.55,0.42,p), 1.52, lerp(-0.35,-0.5,p), -0.52, 1.5, -1.45, 40);
  handheld(t, 0.7);
};
SHOT.S04 = function(u, t){   /* C04 玄関: giày da xếp sẵn; một bước chân rồi đứng lại */
  show('genkan'); scene.environment = envRoom;
  var gm = GEN.userData.me; gm.root.visible = true;
  place(gm, 0, -0.26, 0, 0.2);
  var step = ramp(t, 27.4, 28.9) * (1 - ramp(t, 29.6, 31.0));
  pose(gm, {lRx:-0.55*step, kR:0.7*step, hp:0.15, aLx:0.03, aRx:0.03});
  _tgt.set(30, 0.3, 0.3); sun.position.set(30.3, 2.4, 4.5); sun.target.position.copy(_tgt); sun.intensity = 1.2; sun.color.set(0xfff2e2);
  hemi.intensity = 0.3; fill.position.set(30, 1.8, 0.8); fill.intensity = 0.1;
  var p = ease(u/7.29);
  setCam(30+lerp(0.48,0.42,p), lerp(0.34,0.3,p), lerp(1.08,0.98,p), 30-0.02, 0.2, 0.0, 44);
};
SHOT.S05 = function(u, t){   /* C05 một mình trong nhà · 名刺入れ trên bàn */
  roomLight(0.55, 0);
  meClothes('shirt'); setClock(WALLCLOCK, 8*3600+40*60+(t-33.38)*8);
  if(t < 36.53){
    meStand(-0.25, -0.35, -Math.PI/2 - 0.35, {hp:0.02});
    var p = ease(u/3.2);
    setCam(1.55, 2.05, 1.6, lerp(-0.2,-0.3,p), 0.75, lerp(-0.4,-0.45,p), 50);
  } else {
    var q = ease((t-36.53)/9.9);
    var c = RM.cardCase.position;
    setCam(c.x+lerp(0.26,0.13,q), TABLE_TOP_Y+lerp(0.2,0.13,q), c.z+lerp(0.3,0.22,q), c.x+0.01, TABLE_TOP_Y+0.005, c.z+0.07, 34);
    handheld(t, 0.4);
  }
};
SHOT.S06 = function(u, t){   /* C06 chín giờ · điện thoại im · không ai gọi 部長 */
  roomLight(0.62, 0);
  meClothes('shirt');
  var sec = 9*3600 + (t - 47.4);
  setClock(WALLCLOCK, sec); setClock(ALARM, sec);
  if(t < 50.81){
    setCam(0.95, 2.12, -1.28, 0.95, 2.14, -1.77, 34);
  } else if(t < 52.78){
    var p = ease((t-50.81)/2.0);
    setCam(lerp(0.95,0.98,p), 0.98, lerp(-1.05,-1.12,p), 1.45, 0.66, -1.4, 34);
  } else {
    meStand(-0.9, -0.25, -Math.PI/2 - 0.2, {hp:0.02});
    var q = ease((t-52.78)/4.4);
    setCam(1.55, 1.45, lerp(1.45,1.3,q), -0.8, 1.05, -0.4, 44);
  }
  handheld(t, 0.5);
};
SHOT.S07 = function(u, t){   /* C07 nhìn thẳng xuống: "足もとが抜けた" — sàn quanh chân tối dần */
  roomLight(0.62, 0);
  meClothes('shirt'); setClock(WALLCLOCK, 9*3600+(t-47.4));
  RM.table.visible = false; RM.cardCase.visible = false;
  meStand(0.0, -0.25, -Math.PI/2 - 0.25, {hp:0.1});
  HOLE.visible = true; HOLE.material.uniforms.uC.value.set(0.0, -0.25);
  var k = ramp(t, 61.9, 66.5);
  HOLE.material.uniforms.uR.value = lerp(3.4, 0.36, k);
  sun.intensity *= lerp(1, 0.35, k); hemi.intensity *= lerp(1, 0.25, k); RM.beamM.uniforms.uOp.value *= lerp(1, 0.2, k);
  key.position.set(0.3, 2.35, -0.1); key.target.position.set(0, 0, -0.25); key.intensity = 1.3*k; key.angle = 0.42; key.penumbra = 0.8;
  camera.up.set(-1, 0, 0); RM.ceil.visible = false;
  var h = lerp(3.6, 4.4, ease(u/16));
  setCam(0.0, h, -0.25, 0.0, 0.0, -0.2501, 40);
};
SHOT.S08 = function(u, t){   /* C08 "私は、これから何と呼ばれるんだろう" — nghiêng mặt bên 障子 */
  roomLight(0.66, 0);
  meClothes('shirt');
  meStand(-1.25, -0.38, -Math.PI/2 + 0.15, {hp:-0.06});
  var p = ease(u/6.6);
  setCam(lerp(-1.58,-1.54,p), 1.64, lerp(0.3,0.22,p), -1.24, 1.6, -0.38, 36);
  handheld(t, 0.5);
};
SHOT.S09 = function(u, t){   /* C09 "部長ではない。会社の人でもない" — dòng chữ trên danh thiếp nhạt đi */
  roomLight(0.66, 0);
  CLOSECARD.visible = true; RM.cardCase.visible = false; FX.mul = [0.82,0.82,0.82]; bloomPass.strength = 0.3;
  var a1 = ramp(t, 79.9, 81.2), a2 = ramp(t, 81.4, 83.0);
  if(t < 81.35) cardState(0, 1, a1); else cardState(1, 2, a2);
  var c = CLOSECARD.position, p = ease(u/10.5);
  setCam(c.x+lerp(0.02,0.0,p), c.y+lerp(0.12,0.1,p), c.z+lerp(0.1,0.07,p), c.x, c.y, c.z-0.004, 34);
  handheld(t, 0.3);
};
SHOT.S10 = function(u, t){   /* C10–C11 tìm hiểu: chồng sách dưới đèn bàn, trang sách mở */
  deskLight(1); deskProps([STACK, OPENBOOK]);
  var p = ease(u/20);
  var push = ramp(t, 103.0, 109.8);
  setCam(-30+lerp(0.55,0.25,p), lerp(1.25,1.1,p) - 0.25*push, lerp(0.75,0.45,p) - 0.2*push, -30+0.05, 0.77, 0.1, lerp(40,30,push));
  handheld(t, 0.3);
};

/* ---------- CHƯƠNG 2 — 「元」になる人たち ---------- */
SHOT.S11 = function(u, t){   /* C12–C13 ô cửa tu viện, tràng hạt, khăn tu đã gấp */
  show('conv'); scene.environment = envRoom;
  _tgt.set(0, 0.95, -40+0.2); sun.position.set(0.6, 3.6, -40-5.5); sun.target.position.copy(_tgt); sun.intensity = 2.0; sun.color.set(0xfff0da);
  hemi.intensity = 0.16; hemi.color.set(0xc8d0dc); fill.position.set(0, 1.6, -40+1.5); fill.intensity = 0.12;
  var p = ease(u/19.4);
  setCam(lerp(0.12,0.35,p), lerp(1.12,1.3,p), -40+lerp(0.22,1.35,p), lerp(-0.08,0.0,p), lerp(1.02,1.35,p), -40-0.2, lerp(34,44,p));
  bloomPass.strength = 0.6;
};
SHOT.S12 = function(u, t){   /* C14 thập niên 1970: băng từ quay, sổ ghi — rồi sơ đồ 1→4 */
  deskLight(1); deskProps([TAPE, NOTE]);
  TAPE.userData.reels[0].rotation.z = t*1.3; TAPE.userData.reels[1].rotation.z = t*1.9;
  var s = t < 140.6 ? 0 : 1 + Math.floor(clamp((t-140.6)/0.75, 0, 3.99));
  setNote(s);
  var p = ease(u/15.2);
  if(t < 140.0) setCam(-30+lerp(-0.55,-0.35,p), lerp(1.12,1.05,p), lerp(0.45,0.4,p), -30-0.2, 0.8, -0.02, 38);
  else { var q = ease((t-140)/4.9); setCam(-30+0.22, lerp(1.2,1.12,q), 0.34, -30+0.2, 0.76, 0.08, 36); }
  handheld(t, 0.3);
};
SHOT.S13 = function(u, t){   /* C15–C16 185 phiếu: các nhóm lần lượt sáng · "185人" · gom lại thành sách */
  voidLight(0.9, t); show('cards'); VD.dust.visible = false;
  key.position.set(0.4, 3.6, 1.2); key.target.position.set(0, 0, 0); key.angle = 0.42; key.intensity = 1.1;
  var lv = [0.55, ramp(t,147.8,149.0), ramp(t,150.8,151.9), ramp(t,153.2,154.3), ramp(t,155.6,156.8), ramp(t,160.0,161.2)];
  var all = ramp(t, 163.7, 165.0);
  for(var i=0;i<6;i++) lv[i] = Math.max(lv[i], all);
  cardsLight(lv);
  /* gom: 167.5 → 171.5 */
  var g = ramp(t, 167.6, 171.2), o = new THREE.Object3D();
  if(g > 0){ for(var j=0;j<CD.N;j++){ var p0 = CD.pos[j]; var h = j*0.0021; o.position.set(lerp(p0.x, 0, g), lerp(0.002, 0.002+h, g), lerp(p0.z, 0, g)); o.rotation.set(0, lerp(0, (j%7-3)*0.02, g), 0); o.updateMatrix(); CD.im.setMatrixAt(j, o.matrix); } CD.im.instanceMatrix.needsUpdate = true; }
  else { for(var j2=0;j2<CD.N;j2++){ var p1 = CD.pos[j2]; o.position.set(p1.x, 0.002, p1.z); o.rotation.set(0,0,0); o.updateMatrix(); CD.im.setMatrixAt(j2, o.matrix); } CD.im.instanceMatrix.needsUpdate = true; }
  var n = Math.round(185*ease((t-163.8)/2.2));
  bigSet(n+'人', '聞き取りの対象', win(t, 163.8, 171.0, 0.8));
  var p = ease(u/27.3);
  setCam(lerp(0.15,0.0,p), lerp(1.95,1.6,p), lerp(1.25,1.05,p), 0, 0, lerp(-0.12,-0.18,p), 44);
};
SHOT.S14 = function(u, t){   /* C17–C18 Becoming an Ex (1988) */
  deskLight(1); deskProps([BOOK_EX]);
  var th = lerp(-0.5, 0.35, ease(u/16.8));
  orbitCam(-30+0.0, 0.76, 0.02, 0.42, th, lerp(0.34,0.26,ease(u/16.8)), -30+0.0, 0.77, 0.02, 38);
  tagSet(tagREl, '元の何者かになる', 'Becoming an Ex（エボー 1988）', win(t, 176.2, 180.7, 0.8));
  tagSet(tagLEl, '役割からの離脱', 'role exit', win(t, 181.2, 188.6, 0.8));
};
function figBase(t, br){
  voidLight(br, t); show('fig');
  figPose(FIG, t);
}
/* 部長 tách ra rồi lơ lửng (từ giai đoạn 4, C23, tới lúc rơi ở C56) */
function buchoFloat(t, k){
  var bob = 0.012*Math.sin(t*0.7);
  plateSet(PL.bucho, {off:0.10*k + 0.006, dx:0.2*k, dy:-0.03*k + bob*k, rx:-0.05*k, ry:0.55*k, rz:0.04*k});
}
SHOT.S15 = function(u, t){   /* C19 ma-nơ-canh mặc các tấm đồng — "四つの段階" */
  figBase(t, 1);
  var p = ease(u/7.9);
  setCam(lerp(1.6,1.1,p), lerp(1.55,1.45,p), lerp(5.6,4.4,p), 0, 1.05, 0, 36);
  tagSet(tagREl, '役割から離れる、四つの段階', 'エボー（1988）', win(t, 193.4, 196.6, 0.7));
};
SHOT.S16 = function(u, t){   /* C20 giai đoạn 1: 最初の疑い — đường chỉ sáng quanh 部長, hé một khe */
  figBase(t, 1);
  SEAM.material.uniforms.uI.value = 3.2*ramp(t,198.3,199.5); SEAM.material.uniforms.uRun.value = lerp(0, 1.04, ramp(t, 198.3, 201.2));
  plateSet(PL.bucho, {off:0.007*ramp(t, 201.0, 204.0)});
  var p = ease(u/9.5);
  setCam(lerp(0.62,0.5,p), lerp(1.42,1.38,p), lerp(1.25,1.05,p), 0.0, 1.33, 0.1, 34);
  tagSet(tagREl, '１　最初の疑い', '', win(t, 197.0, 206.0, 0.7));
};
SHOT.S17 = function(u, t){   /* C21 giai đoạn 2: ほかの道 — ánh sáng mờ thoáng qua quanh vai rồi tan */
  figBase(t, 1);
  SEAM.material.uniforms.uI.value = 1.2; SEAM.material.uniforms.uRun.value = 1.04;
  plateSet(PL.bucho, {off:0.007});
  var a = bump(t, 209.8, 212.8), b = bump(t, 212.4, 215.6), c = bump(t, 210.8, 214.6);
  ALT[0].material.uniforms.uI.value = 0.45*a; ALT[1].material.uniforms.uI.value = 0.45*b; ALT[2].material.uniforms.uI.value = 0.3*c;
  var p = ease(u/10.5);
  setCam(lerp(-0.9,-0.6,p), lerp(1.55,1.5,p), lerp(3.0,2.6,p), 0, 1.3, 0, 38);
  tagSet(tagREl, '２　ほかの道を探す', '', win(t, 206.5, 216.5, 0.7));
};
SHOT.S18 = function(u, t){   /* C22 giai đoạn 3: 転機 — một cú rùng mình qua mọi tấm */
  figBase(t, 1);
  SEAM.material.uniforms.uI.value = 1.2; SEAM.material.uniforms.uRun.value = 1.04;
  var sh = (t > 221.9) ? Math.sin((t-221.9)*26)*Math.exp(-(t-221.9)*4.0) : 0;
  var flash = bump(t, 221.9, 223.2);
  plateSet(PL.bucho, {off:0.007 + 0.006*sh + 0.012*flash});
  plateSet(PL.chichi, {off:0.004*sh}); plateSet(PL.otto, {off:0.003*sh}); plateSet(PL.senpai, {off:0.003*sh});
  SEAM.material.uniforms.uI.value = 1.2 + 2.0*flash;
  setCam(0.0, 1.2, 3.3, 0, 1.0, 0, 36);
  tagSet(tagREl, '３　転機', '', win(t, 217.0, 226.0, 0.7));
};
SHOT.S19 = function(u, t){   /* C23 giai đoạn 4: 部長 tách ra, lơ lửng · dấu 元 mảnh hiện lên ngực */
  figBase(t, 1);
  var k = ramp(t, 227.6, 231.8);
  buchoFloat(t, k);
  SEAM.material.uniforms.uI.value = 1.2*(1-k); SEAM.material.uniforms.uRun.value = 1.04;
  GEN_MARK.material.opacity = ramp(t, 234.9, 236.8);
  var th = lerp(0.9, -0.35, ease(u/17.4));
  orbitCam(0, 1.0, 0, 2.6, th, 0.45, 0, 1.15, 0, 36);
  tagSet(tagREl, '４　元の自分をつくる', '元修道女・元警察官・元部長', win(t, 226.5, 243.2, 0.7));
};
SHOT.S20 = function(u, t){   /* C24–C26 "手前の時期" — máy trôi vào khe giữa ngực và tấm 部長 */
  figBase(t, 0.9);
  buchoFloat(t, 1);
  GEN_MARK.material.opacity = 1;
  var p = ease(u/25);
  setCam(lerp(-0.95,-0.4,p), lerp(1.5,1.36,p), lerp(2.0,0.85,p), lerp(0.05,0.12,p), 1.3, lerp(0.1,0.18,p), lerp(38,34,p));
  tagSet(tagREl, t < 262 ? '古い役割は終わり、新しい自分はまだ' : '真空', t < 262 ? '' : 'vacuum（話し手たちの言葉）', t < 262 ? win(t, 249.5, 258.8, 0.8) : win(t, 266.9, 268.6, 0.6));
};
SHOT.S21 = function(u, t){   /* C27 真空: sàn biến mất, thân nổi nhẹ, bụi trôi lên */
  figBase(t, 0.85);
  buchoFloat(t, 1); GEN_MARK.material.opacity = 1;
  var k = ramp(t, 268.9, 271.4);
  VD.floorM.opacity = 1 - k;
  FIG.root.position.y = 0.13*ramp(t, 269.2, 273.5) + 0.01*Math.sin(t*0.6);
  voidDust(t, 0.7, 0.6*k);
  bgMat.uniforms.uTop.value.setRGB(0.02,0.019,0.02); bgMat.uniforms.uBot.value.setRGB(0.0,0.0,0.0);
  var p = ease(u/10.5);
  setCam(lerp(1.3,1.6,p), lerp(0.35,0.2,p), lerp(3.0,3.3,p), 0, 1.05, 0, 40);
  tagSet(tagREl, '真空', '地面のない、宙に浮いたような時間', win(t, 269.0, 278.8, 0.7));
};
SHOT.S22 = function(u, t){   /* C28 "あの月曜日の九時は、まさにそれ" — phòng thật tan vào bóng tối quanh ông */
  roomLight(0.62, 0); meClothes('shirt');
  setClock(WALLCLOCK, 9*3600 + 90 + (t-279.33));
  meStand(0.1, -0.35, 0.35, {hp:0.08});
  var k = ramp(t, 283.2, 289.4);
  HOLE.visible = true; HOLE.material.uniforms.uC.value.set(0.1, -0.35); HOLE.material.uniforms.uR.value = lerp(4.0, 0.42, k);
  sun.intensity *= lerp(1, 0.0, k); hemi.intensity *= lerp(1, 0.08, k); fill.intensity *= (1-k);
  RM.paperM.color.multiplyScalar(lerp(1, 0.05, k)); RM.outM.color.multiplyScalar(lerp(1,0.05,k)); RM.beamM.uniforms.uOp.value *= (1-k);
  roomDust(t, 1-k);
  key.position.set(0.9, 2.35, 0.6); key.target.position.set(0.1, 0.8, -0.35); key.intensity = 1.4*k; key.angle = 0.38;
  var p = ease(u/13.3);
  setCam(lerp(1.35,1.2,p), 1.32, lerp(1.5,1.3,p), 0.05, 1.05, -0.4, 44);
};
SHOT.S23 = function(u, t){   /* C29–C30 名残: viền sáng mờ của tấm còn bám trên ngực */
  figBase(t, 0.9);
