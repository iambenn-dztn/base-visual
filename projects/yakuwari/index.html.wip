SHOT.S26 = function(u, t){   /* C33 bốn bậc đá của người TỰ CHỌN rời đi: 疑って、迷って、決める */
  voidLight(0.8, t); show('stones');
  key.position.set(-1.0, 4.2, 2.2); key.target.position.set(-0.1, 0, -0.85); key.angle = 0.7;
  var on = [ramp(t,345.0,345.7), ramp(t,346.0,346.7), ramp(t,346.8,347.5), ramp(t,347.6,348.4)];
  for(var i=0;i<4;i++){ var v = 0.08 + 0.55*on[i]; ST.s[i].material.emissive.setRGB(v*0.5, v*0.36, v*0.2); ST.lab[i].material.opacity = 0.3 + 0.7*on[i]; faceCam(ST.lab[i]); }
  var p = ease(u/13.4);
  setCam(lerp(2.3,2.0,p), lerp(2.3,2.1,p), lerp(2.9,2.6,p), -0.1, 0.3, -0.85, 46);
  for(var j=0;j<4;j++) faceCam(ST.lab[j]);
  tagSet(tagREl, '自分で選んだ離脱', 'エボーが主に調べた人たち', win(t, 340.8, 351.2, 0.7));
};
SHOT.S27 = function(u, t){   /* C34 "やめる日は、暦が決めています" — lịch tự lật tới 3月31日 */
  roomLight(0.55, 0);
