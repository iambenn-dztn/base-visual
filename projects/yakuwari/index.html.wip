function faceTex(skin){
  return canvasTex(1024,512,function(cx,w,h){
    cx.fillStyle = skin; cx.fillRect(0,0,w,h);
    var cxm = w*0.5;
    cx.fillStyle = 'rgba(170,80,70,0.10)'; [[-120,300],[120,300]].forEach(function(q){ cx.beginPath(); cx.ellipse(cxm+q[0],q[1],46,30,0,0,7); cx.fill(); });
    cx.lineCap = 'round';
    [-1,1].forEach(function(sd){
      var gE = cx.createRadialGradient(cxm+sd*55,250,2,cxm+sd*55,250,34); gE.addColorStop(0,'rgba(60,40,35,0.16)'); gE.addColorStop(1,'rgba(60,40,35,0)');
      cx.fillStyle = gE; cx.fillRect(cxm+sd*55-40,210,80,80);
      cx.strokeStyle = 'rgba(95,82,76,0.5)'; cx.lineWidth = 5; cx.beginPath(); cx.moveTo(cxm+sd*30,228); cx.quadraticCurveTo(cxm+sd*56,219,cxm+sd*82,227); cx.stroke();
      /* nếp nhăn khoé mắt — người 60+ */
      cx.strokeStyle = 'rgba(120,90,80,0.22)'; cx.lineWidth = 2;
      for(var k=0;k<3;k++){ cx.beginPath(); cx.moveTo(cxm+sd*(86+k*2),232+k*7); cx.lineTo(cxm+sd*(104+k*3),226+k*9); cx.stroke(); }
      cx.strokeStyle = 'rgba(80,55,48,0.35)'; cx.lineWidth = 3; cx.beginPath(); cx.moveTo(cxm+sd*28,196); cx.quadraticCurveTo(cxm+sd*58,186,cxm+sd*88,194); cx.stroke();
    });
    cx.strokeStyle = 'rgba(120,85,75,0.2)'; cx.lineWidth = 3;
    [-1,1].forEach(function(sd){ cx.beginPath(); cx.moveTo(cxm+sd*38,300); cx.quadraticCurveTo(cxm+sd*52,330,cxm+sd*40,352); cx.stroke(); });
    cx.fillStyle = 'rgba(150,85,75,0.14)'; cx.beginPath(); cx.ellipse(cxm,338,24,6,0,0,7); cx.fill();
  }, null, true);
}
function hairAlpha(){
  return canvasTex(512,256,function(cx,w,h){
    cx.fillStyle = '#000'; cx.fillRect(0,0,w,h); cx.fillStyle = '#fff';
    for(var x=0;x<w;x++){ var u = x/w, sd = Math.abs(u-0.5)/0.5;
      var vh = 0.25 + 0.35*Math.pow(sd,1.5);
      var ear = Math.exp(-Math.pow((sd-0.5)/0.075,2));
