    var b = makeBook(w, h, th, function(cx,w2,h2){ cx.fillStyle = '#333'; cx.fillRect(0,0,w2,h2); }, cols[i]); b.position.set(-0.45+(q()-0.5)*0.02, y+th/2+0.003, -0.15); b.rotation.y = (q()-0.5)*0.3; STACK.add(b); y += th+0.006; }
