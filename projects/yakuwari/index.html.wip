/** đặt tư thế — mọi góc là hàm thuần của tham số truyền vào */
function pose(f, p){
  p = p || {};
  var hy = p.floor ? 0.14 : (p.seated ? 0.50 : 0.92 + (p.bob||0));
  f.hips.position.set(0, hy, 0);
  f.spine.rotation.set(p.lean||0, p.twist||0, p.roll||0);
  f.head.rotation.set(p.hp||0, p.hy||0, p.hr||0);
  f.shL.quaternion.identity(); f.shR.quaternion.identity();
  f.shL.rotation.set(p.aLx!=null ? p.aLx : 0.02, 0, p.aLz!=null ? p.aLz : 0.07);
  f.shR.rotation.set(p.aRx!=null ? p.aRx : 0.02, 0, p.aRz!=null ? p.aRz : -0.07);
  f.elL.rotation.set(p.eL!=null ? p.eL : -0.12, 0, 0);
  f.elR.rotation.set(p.eR!=null ? p.eR : -0.12, 0, 0);
  if(p.floor){          /* ngồi bệt, duỗi chân (trong chăn) */
    f.hpL.rotation.set(-1.50, 0, 0.06); f.hpR.rotation.set(-1.50, 0, -0.06);
    f.knL.rotation.set(0.06, 0, 0); f.knR.rotation.set(0.06, 0, 0);
  } else if(p.seiza){   /* ngồi kiểu Nhật trên đệm, trước bàn thấp */
    f.hips.position.y = 0.30;
    f.hpL.rotation.set(-1.45, 0, 0.1); f.hpR.rotation.set(-1.45, 0, -0.1);
    f.knL.rotation.set(2.75, 0, 0); f.knR.rotation.set(2.75, 0, 0);
  } else if(p.seated){
    f.hpL.rotation.set(-1.52, 0, 0.05); f.hpR.rotation.set(-1.52, 0, -0.05);
    f.knL.rotation.set(1.52, 0, 0); f.knR.rotation.set(1.52, 0, 0);
  } else {
    f.hpL.rotation.set(p.lLx||0, 0, 0.015); f.hpR.rotation.set(p.lRx||0, 0, -0.015);
    f.knL.rotation.set(p.kL||0, 0, 0); f.knR.rotation.set(p.kR||0, 0, 0);
  }
}
var _qa = new THREE.Quaternion(), _qb = new THREE.Quaternion(), _va = new THREE.Vector3(), _vb = new THREE.Vector3(), _vc = new THREE.Vector3();
var _DOWN = new THREE.Vector3(0,-1,0);
/** xoay khớp vai để cả cánh tay chỉ về điểm world `target` (trộn k với tư thế đang có) */
function aimArm(f, side, target, k, bend){
  var sh = side === 'L' ? f.shL : f.shR;
  f.root.updateMatrixWorld(true);
  sh.getWorldPosition(_va);
  _vb.copy(target).sub(_va).normalize();
  sh.parent.getWorldQuaternion(_qa); _qa.invert();
  _vb.applyQuaternion(_qa);
  _qb.setFromUnitVectors(_DOWN, _vb);
  sh.quaternion.slerp(_qb, k);
