    setCam(h3.x+lerp(0.34,0.3,q), h3.y+lerp(0.2,0.18,q), h3.z+lerp(0.22,0.2,q), h3.x-0.03, h3.y+0.02, h3.z-0.02, 34);
  } else {
    setClock(WALLCLOCK, 9*3600+4*60+(t-792.05));
    setCam(0.95, 2.12, -1.3, 0.95, 2.14, -1.77, 36);
  }
