function officeLight(k, spot){
  show('office'); scene.environment = envRoom;
  hemi.intensity = 0.2*k; hemi.color.set(0xd8dde4);
  sun.position.set(60+9, 4.5, 1.5); _tgt.set(60+2.0, 0, 0); sun.target.position.copy(_tgt); sun.intensity = 0.7*k; sun.color.set(0xeef2f6);
  key.position.set(60+3.6, 4.2, 0.2); key.target.position.set(60+3.6, 0.7, 0); key.intensity = 2.2*spot; key.angle = 0.42; key.penumbra = 0.6;
  bgMat.uniforms.uTop.value.setRGB(0.02,0.02,0.022);
}
SHOT.S38 = function(u, t){   /* C52–C54 席: 部長席 ở đầu dãy bàn · 上座 bàn ăn · kỳ vọng dồn về (会社/家族) */
  if(t < 587.75){
    officeLight(1, 1);
    OF.seatLab.material.opacity = win(t, 572.8, 580.9, 0.8); OF.exp0.material.opacity = win(t, 576.4, 581.0, 0.8);
    OF.exp1.material.opacity = ramp(t, 582.9, 584.0) * (t > 581.0 ? 1 : 0);
    var p = ease((t-572.68)/15.1);
    setCam(60+lerp(-1.6,-1.0,p), lerp(3.9,3.5,p), lerp(3.4,3.0,p), 60+lerp(1.8,2.6,p), 0.7, 0.2, 44);
    faceCam(OF.seatLab); faceCam(OF.exp0); faceCam(OF.exp1);
  } else if(t < 594.31){
    show('family'); scene.environment = envRoom;
    fill.position.set(90, 1.85, 0); fill.intensity = 1.5; fill.distance = 5; hemi.intensity = 0.14;
    key.position.set(90+1.05, 3.8, 0.2); key.target.position.set(90+1.05, 0.5, 0); key.intensity = 1.2; key.angle = 0.35;
    FM.exp.material.opacity = ramp(t, 589.5, 590.6);
    var q = ease((t-587.75)/6.6);
    setCam(90+lerp(-1.5,-1.2,q), lerp(2.9,2.7,q), lerp(2.3,2.1,q), 90+0.55, 0.8, 0.05, 44);
    faceCam(FM.exp);
  } else {
    figBase(t, 0.9); show('strands'); buchoFloat(t, 1); RESID.material.uniforms.uI.value = 1.0; GEN_MARK.material.opacity = 0.4;
    var A = 0.6 + 0.6*win(t, 602.5, 604.4, 0.6), B = 0.6 + 0.6*win(t, 604.5, 606.5, 0.6);
    strandsSet(t, [A, B]);
    var r = ease((t-594.31)/12.2);
    setCam(lerp(-0.8,-0.4,r), lerp(1.9,1.7,r), lerp(5.6,5.0,r), 0, 1.2, -0.5, 44);
    tagSet(tagREl, 'まわりの人が必要としていた形', '', win(t, 597.3, 606.0, 0.7));
  }
};
SHOT.S39 = function(u, t){   /* C55 "少し違って見えてきました" — ngồi trước bàn thấp */
  roomLight(0.7, 0.2); meClothes('shirt'); RM.cardCase.visible = true;
  setClock(WALLCLOCK, 9*3600+25*60);
  meSeiza(t, 0.12, 0);
  var p = ease(u/6.5);
  setCam(lerp(-0.2,-0.1,p), 1.02, lerp(-0.45,-0.35,p), 0.72, 0.82, 1.15, 40);
  handheld(t, 0.4);
};
SHOT.S40 = function(u, t){   /* C56 bàn 部長 tắt dần — rồi tấm 部長 rơi xuống, có trọng lượng */
  if(t < 620.15){
    var k = ramp(t, 614.0, 618.8);
    officeLight(1 - 0.5*k, 1 - 0.85*k);
    OF.exp1.material.opacity = 1 - ramp(t, 613.4, 616.6); OF.seatLab.material.opacity = 0; OF.exp0.material.opacity = 0;
    if(OF.np.mat) OF.np.mat.color.setScalar(lerp(1, 0.45, k));
    var p = ease((t-613.04)/7.1);
    setCam(60+lerp(1.7,2.0,p), lerp(1.9,1.75,p), lerp(2.2,1.9,p), 60+3.5, 0.9, -0.1, 42);
    faceCam(OF.exp1);
  } else {
    figBase(t, 0.95); RESID.material.uniforms.uI.value = 1.0; GEN_MARK.material.opacity = 0.35;
    var fk = clamp((t - 620.5)/2.3, 0, 1), fc = fallCurve(fk);
    buchoFloat(620.5, 1);
    if(PL.bucho.center){
      var base = PL.bucho.pivot.position.y;
      var floorY = -0.92 + 0.02;
      PL.bucho.pivot.position.y = lerp(floorY, base, fc[0]);
      PL.bucho.pivot.position.z += 0.1*fc[1];
      PL.bucho.pivot.rotation.x = lerp(PL.bucho.pivot.rotation.x, -1.45, fc[1]);
    }
    var q = ease((t-620.15)/3.64);
    setCam(lerp(1.9,2.0,q), lerp(1.0,0.95,q), lerp(2.9,3.0,q), 0.1, 0.78, 0.1, 44);
  }
};
function buchoOnFloor(){
  if(!PL.bucho.center) return;
  buchoFloat(620.5, 1);
  PL.bucho.pivot.position.y = -0.92 + 0.02; PL.bucho.pivot.position.z += 0.1; PL.bucho.pivot.rotation.x = -1.45;
}
SHOT.S41 = function(u, t){   /* C57 tên gọi đến từ phía bên kia — nguồn tắt thì tên dừng; 先輩 rơi theo */
  figBase(t, 0.95); show('strands'); buchoOnFloor(); RESID.material.uniforms.uI.value = 1.0; GEN_MARK.material.opacity = 0.3;
  var on = [];
  var aHi = 1 + 0.5*win(t, 628.1, 630.6, 0.6), bHi = 1 + 0.5*win(t, 630.8, 633.9, 0.6);
  var aOff = 1 - ramp(t, 634.0, 636.0);
  for(var i=0;i<SR.src.length;i++) on.push(SR.src[i].grp === 0 ? 0.8*aHi*aOff : 0.8*bHi);
  strandsSet(t, [0,0], on);
  var fk = clamp((t - 635.4)/2.0, 0, 1), fc = fallCurve(fk);
  if(PL.senpai.center) plateSet(PL.senpai, {off:0.03*ramp(t,634.4,635.4)});
  if(fk > 0 && PL.senpai.center){
    /* khung vai: sàn ở y ≈ -(0.92+0.455) */
    var y0 = PL.senpai.center.y, floorY = -(0.92+0.455) + 0.015;
    PL.senpai.pivot.position.y = lerp(floorY, y0, fc[0]); PL.senpai.pivot.position.x -= 0.12*fc[1]; PL.senpai.pivot.rotation.z = 1.3*fc[1];
  }
  var p = ease(u/14.5);
  setCam(lerp(0.9,0.4,p), lerp(2.1,1.9,p), lerp(6.2,5.4,p), 0, 1.1, -0.6, 44);
};
SHOT.S42 = function(u, t){   /* C58–C59 LÕI hiện ra — hình dạng cố định từ đây tới hết tập */
  figBase(t, 0.95); buchoOnFloor();
  if(PL.senpai.center){ plateSet(PL.senpai, {}); PL.senpai.pivot.position.y = -(0.92+0.455)+0.015; PL.senpai.pivot.position.x -= 0.12; PL.senpai.pivot.rotation.z = 1.3; }
  RESID.material.uniforms.uI.value = 0.9*(1 - ramp(t, 639.0, 642.0)); GEN_MARK.material.opacity = 0.25*(1 - ramp(t, 638.4, 640.0));
  var c = ramp(t, 638.5, 642.4);
  key.intensity *= lerp(1, 0.55, c); fill.intensity *= lerp(1, 0.5, c);
  CORE_UNI.uCoreI.value = 1.5*c; figCore.material.uniforms.uI.value = 0.62*c;
  var p = ease((t-638.31)/11.0), q = ramp(t, 655.4, 662.0);
  var near = [0.35, 1.36, 0.95], far = [0.9, 1.3, 2.8];
  setCam(lerp(near[0],far[0],q)+lerp(0.25,0,p)*(1-q), lerp(near[1],far[1],q), lerp(lerp(1.3,near[2],p),far[2],q), 0, lerp(1.28,1.12,q), 0.05, lerp(34,38,q));
  tagSet(tagREl, '内側の継続性', '考え方・好み・気質・身につけた技', win(t, 649.5, 662.3, 0.8));
};
SHOT.S43 = function(u, t){   /* C60–C62 giới hạn nghiên cứu: xa dần · mỗi người một nhịp */
  figBase(t, 0.8); show('far'); buchoOnFloor();
