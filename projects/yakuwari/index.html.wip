figCore.position.copy(CORE_LOCAL); FIG.spine.add(figCore);
/* đường chỉ sáng quanh mép tấm 部長 (giai đoạn 1: "đường nứt") + dấu 名残 */
function plateOutline(o, off, seg){
  var pts = [], n = seg||80, i;
  function P(u,v){ var th = lerp(o.th0,o.th1,u), y = lerp(o.y0,o.y1,v); var nx = Math.sin(th)/o.a, nz = Math.cos(th)/o.b, L = Math.hypot(nx,nz);
    return new THREE.Vector3(o.a*Math.sin(th)+nx/L*off, y, o.b*Math.cos(th)+nz/L*off); }
  for(i=0;i<=n;i++) pts.push(P(i/n,0)); for(i=1;i<=n/4;i++) pts.push(P(1,i/(n/4)));
  for(i=1;i<=n;i++) pts.push(P(1-i/n,1)); for(i=1;i<=n/4;i++) pts.push(P(0,1-i/(n/4)));
  return pts;
}
function glowLine(pts, col, r){
  var curve = new THREE.CatmullRomCurve3(pts, true);
  var m = new THREE.ShaderMaterial({ uniforms:{uCol:{value:new THREE.Color(col[0],col[1],col[2])}, uI:{value:0}, uT:UT, uRun:{value:1}},
    vertexShader:'varying vec2 vU; void main(){ vU=uv; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }',
    fragmentShader:'uniform vec3 uCol; uniform float uI,uRun; varying vec2 vU; void main(){ float run = smoothstep(uRun, uRun-0.04, vU.x); gl_FragColor=vec4(uCol*uI*run,1.0); }',
    transparent:true, depthWrite:false, blending:THREE.AdditiveBlending });
  var tube = new THREE.Mesh(new THREE.TubeGeometry(curve, pts.length*2, r, 6, true), m); tube.renderOrder = 25;
  return tube;
}
var SEAM = glowLine(plateOutline(PL.bucho.o, 0.001, 120), [1.0,0.8,0.52], 0.0016); FIG.spine.add(SEAM);
var RESID = glowLine(plateOutline({a:0.214,b:0.132,th0:-0.86,th1:0.86,y0:0.295,y1:0.475}, 0.0, 120), [1.0,0.74,0.46], 0.0022); FIG.spine.add(RESID);
/* ⚠ RESID bám bề mặt thân (a,b nhỏ hơn tấm) — chỉ hiện sau khi tấm đã rời ngực */
