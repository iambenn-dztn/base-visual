meResid = glowLine(plateOutline({a:0.222,b:0.14,th0:-0.86,th1:0.86,y0:0.295,y1:0.475}, 0.0, 120), [1.0,0.74,0.46], 0.0022);
ME.spine.add(meResid);

/** đặt trạng thái tấm: off = tách ra theo pháp tuyến (m), side = trôi ngang, rot = nghiêng, drop = rơi (0..1) */
function plateSet(pl, s){
  s = s || {};
  if(!pl.center) return;
  var n = pl.normal, c = pl.center;
  var off = s.off||0, fall = s.fall||0;
  pl.pivot.visible = s.vis !== false;
  pl.pivot.position.set(c.x + n.x*off + (s.dx||0), c.y + (s.dy||0), c.z + n.z*off + (s.dz||0));
  pl.pivot.rotation.set(s.rx||0, s.ry||0, s.rz||0);
  pl.mat.opacity = s.op!=null ? s.op : 1; pl.mat.transparent = pl.mat.opacity < 0.999;
  pl.mat.emissive = pl.mat.emissive || new THREE.Color(); pl.mat.emissive.setRGB((s.glow||0)*0.9,(s.glow||0)*0.62,(s.glow||0)*0.3);
}
/** rơi có trọng lượng (khung spine, sàn ở y = -0.92): gia tốc, chạm sàn, nảy nhỏ, nằm yên */
function fallCurve(k){  /* k: 0..1 thời gian rơi chuẩn hoá → [độ cao 1..0, góc nghiêng 0..1] */
  if(k <= 0) return [1, 0];
  var tHit = 0.62;
  if(k < tHit){ var q = k/tHit; return [1 - q*q, q*q]; }
  var r = (k - tHit)/(1-tHit);
  var b = 0.07*Math.abs(Math.sin(r*Math.PI*1.6))*Math.exp(-r*4.5);
  return [b, 1];
}

/* =========================================================================
 * ĐẠO CỤ "NGUỒN": bàn đọc ban đêm dưới đèn bàn — sách/tạp chí/băng từ/từ điển
 * ========================================================================= */
var DESK = reg('desk', new THREE.Group()); DESK.position.set(-30,0,0);
var DK = {};
(function buildDesk(){
  var wt = canvasTex(1024,512,function(cx,w,h){ var q = HFA.mulberry32(31);
    cx.fillStyle = '#4a3222'; cx.fillRect(0,0,w,h);
    for(var i=0;i<300;i++){ var y = q()*h; cx.strokeStyle = 'rgba(25,14,8,'+(0.1+q()*0.2)+')'; cx.lineWidth = 1+q()*3; cx.beginPath(); cx.moveTo(0,y); cx.bezierCurveTo(w*0.3,y+(q()-0.5)*20,w*0.7,y+(q()-0.5)*20,w,y+(q()-0.5)*10); cx.stroke(); }
    for(var k=0;k<60;k++){ cx.strokeStyle = 'rgba(120,80,50,0.12)'; cx.lineWidth = 2; var y2 = q()*h; cx.beginPath(); cx.moveTo(0,y2); cx.lineTo(w,y2+(q()-0.5)*6); cx.stroke(); } }, [1,1]);
  var top = boxIn(DESK, 1.8,0.04,1.0, 0,0.74,0, new THREE.MeshStandardMaterial({map:wt, roughness:0.38}));
  DK.topY = 0.76;
  /* đèn bàn (lamp) — chao kim loại, bóng ấm HDR */
  var lg = new THREE.Group(); lg.position.set(0.62,DK.topY,-0.3); DESK.add(lg);
  var metal = std(0x2b3a36,0.35,0.7);
  var bs = new THREE.Mesh(new THREE.CylinderGeometry(0.08,0.09,0.02,32), metal); bs.position.y = 0.01; lg.add(bs);
  var arm1 = new THREE.Mesh(new THREE.CylinderGeometry(0.008,0.008,0.4,12), metal); arm1.position.set(0,0.2,0); arm1.rotation.z = 0.25; lg.add(arm1);
  var arm2 = new THREE.Mesh(new THREE.CylinderGeometry(0.008,0.008,0.3,12), metal); arm2.position.set(-0.12,0.42,0.02); arm2.rotation.z = 1.2; lg.add(arm2);
  var shade = new THREE.Mesh(new THREE.ConeGeometry(0.09,0.14,32,1,true), new THREE.MeshStandardMaterial({color:0x2b3a36, metalness:0.7, roughness:0.35, side:THREE.DoubleSide}));
  shade.position.set(-0.26,0.40,0.03); shade.rotation.z = -0.5; lg.add(shade);
  var bulb = new THREE.Mesh(new THREE.SphereGeometry(0.025,16,12), new THREE.MeshBasicMaterial({color:new THREE.Color(5,3.8,2.4)})); bulb.position.set(-0.27,0.36,0.03); lg.add(bulb);
  DK.lampPos = new THREE.Vector3(-30+0.62-0.27, DK.topY+0.36, -0.3+0.03);
  DK.lampG = lg;
})();
/** sách bìa cứng: bìa = texture chữ, gáy, ruột giấy */
function makeBook(w, h, th, coverFn, col, spineTxt){
  var g = new THREE.Group();
  var coverM = new THREE.MeshStandardMaterial({roughness:0.55});
  glyphAsset(function(){ if(coverM.map) coverM.map.dispose(); coverM.map = canvasTex(Math.round(900*w/h), 900, coverFn); coverM.needsUpdate = true; });
  var sideM = std(col, 0.6), pageM = new THREE.MeshStandardMaterial({color:0xefe8d6, roughness:0.9, bumpMap:CLOTH_BUMP, bumpScale:0.001});
  var body = new THREE.Mesh(new THREE.BoxGeometry(w, th, h), [pageM, sideM, coverM, sideM, pageM, pageM]);
  body.castShadow = true; body.receiveShadow = true; g.add(body);
  /* bìa dày nhô ra một chút ở ba cạnh */
  var cv = new THREE.Mesh(new THREE.BoxGeometry(w+0.006, 0.003, h+0.008), [sideM,sideM,coverM,sideM,sideM,sideM]); cv.position.y = th/2; cv.castShadow = true; g.add(cv);
  var cb = new THREE.Mesh(new THREE.BoxGeometry(w+0.006, 0.003, h+0.008), sideM); cb.position.y = -th/2; g.add(cb);
  var sp = new THREE.Mesh(new THREE.BoxGeometry(0.004, th+0.006, h+0.008), sideM); sp.position.x = -w/2-0.002; g.add(sp);
  g.userData.coverM = coverM;
  return g;
}
function coverText(cx, w, h, lines, bgA, bgB, fg){
  var gr = cx.createLinearGradient(0,0,0,h); gr.addColorStop(0,bgA); gr.addColorStop(1,bgB); cx.fillStyle = gr; cx.fillRect(0,0,w,h);
  var q = HFA.mulberry32(9); for(var i=0;i<5000;i++){ cx.fillStyle = 'rgba(255,255,255,0.03)'; cx.fillRect(q()*w,q()*h,2,2); }
  cx.fillStyle = fg; cx.textAlign = 'center'; cx.textBaseline = 'middle';
  for(var k=0;k<lines.length;k++){ var L = lines[k]; cx.font = (L[2]||700)+' '+L[1]+'px '+JP; cx.fillStyle = L[3]||fg; cx.fillText(L[0], w/2, L[4]*h); }
}
