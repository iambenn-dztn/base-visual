  handheld(t, 0.4);
};
SHOT.S48 = function(u, t){   /* C68 hồi tưởng: tài liệu văn phòng — cùng một bàn tay, cùng một nét khoanh */
  roomLight(0.75, 0.6); RM.cardCase.visible = false;
  var mem = t < 760.94;
  if(mem){
    DOC.visible = true; HANDRIG.visible = true;
    FX.sat = 0.45; FX.mul = [1.12, 0.98, 0.78];
    var a = -2.4 + ramp(t, 755.6, 758.2)*Math.PI*2.1;
    _va.set((680 + Math.cos(a)*110)/1000 - 0.5, 0, (680 + Math.sin(a)*44)/1400 - 0.5);
    _va.x *= 0.297; _va.z *= 0.42; DOC.updateMatrixWorld(true); _vc.copy(_va).applyMatrix4(DOC.matrixWorld);
    HANDRIG.position.copy(_vc); HANDRIG.position.y = TABLE_TOP_Y + 0.0014;
    HANDRIG.rotation.set(0, Math.PI/2 - 0.12, 0); handPenPose(HANDP, 0.03*Math.sin(t*2));
    HANDP.userData.sleeve.color.set(0x2a3242);
    FX.mul = [0.8,0.76,0.66];
    var hh = HANDRIG.position, p = ease((t-755)/5.9);
    setCam(hh.x+lerp(0.3,0.25,p), hh.y+lerp(0.38,0.33,p), hh.z+lerp(0.38,0.33,p), hh.x-0.04, hh.y, hh.z-0.04, 36);
  } else {
    HANDP.userData.sleeve.color.set(0x7a6450);
    newsHand(3.0, t);
    FX.mul = [0.78,0.78,0.78];
    var h2 = HANDRIG.position, q = ease((t-760.94)/5.2);
    setCam(h2.x+lerp(0.25,0.22,q), h2.y+lerp(0.33,0.3,q), h2.z+lerp(0.33,0.3,q), h2.x-0.05, h2.y, h2.z-0.04, 36);
  }
  handheld(t, 0.3);
};
SHOT.S49 = function(u, t){   /* C69–C71 lõi về lại người thật · câu hỏi đổi hướng · 9 giờ không ai gọi */
  roomLight(0.8, 0.6); meClothes('cardi'); RM.cardCase.visible = false;
  HANDP.userData.sleeve.color.set(0x7a6450);
