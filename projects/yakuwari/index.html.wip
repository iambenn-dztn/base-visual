  for(var i=0;i<FR.length;i++){ var f = FR[i]; var s = clamp((t - 688.0 - f.delay)*f.rate, 0, 1); f.g.material.uniforms.uI.value = 0.9*ease(s); }
  var p = ease(u/43.6);
  setCam(lerp(0.2,0.0,p), lerp(1.45,2.3,p), lerp(3.2,10.5,p), 0, lerp(1.1,1.0,p), -1.0, 40);
  tagSet(tagREl, '多くの人に見られる傾向', 'ひとりひとりに当てはまる決まりではない', win(t, 669.9, 677.0, 0.8));
  tagSet(tagLEl, '批判もある', '男性の働き方が基準／病気を抱えた人が抜けている', win(t, 677.4, 687.3, 0.8));
};

/* ---------- CHƯƠNG 4 — 帰り道 ---------- */
SHOT.S44 = function(u, t){   /* C63–C64 "いくつかの月曜日" — cùng góc S01, ánh sáng ấm hơn */
  var W4 = 0.6;
  meClothes('pj');
  if(t < 710.66){
    roomLight(0.2 + 0.05*lin(t,706.4,710.7), W4); meFuton(-1.5, t);
    setClock(ALARM, 6*3600+29*60+54+(t-706.38)); setClock(WALLCLOCK, 6*3600+29*60+54+(t-706.38));
    var p = ease((t-706.38)/4.3);
    setCam(lerp(1.5,1.4,p), lerp(1.72,1.64,p), lerp(1.52,1.44,p), -0.55, 0.15, 0.1, 44);
  } else if(t < 714.19){
    roomLight(0.26, W4); meFuton(-1.5, t);
    setClock(ALARM, 6*3600+30*60+(t-710.66));
    setCam(0.3, 0.12, -0.18, 0.07, 0.07, -0.42, 34);
  } else {
    roomLight(0.3, W4);
    var s = ramp(t, 714.4, 716.6); meFuton(lerp(-1.45, -0.06, s), t);
    setCam(0.75, 0.95, 1.75, -0.55, 0.55, 0.3, 40);
  }
  handheld(t, 0.5);
};
SHOT.S45 = function(u, t){   /* C65 九時 — 電話は鳴らない — 同じ朝 */
  roomLight(0.72, 0.6); meClothes('cardi');
  var sec = 9*3600 + (t - 722.3); setClock(WALLCLOCK, sec);
  if(t < 725.28){ setCam(0.95, 2.12, -1.28, 0.95, 2.14, -1.77, 34); }
  else if(t < 729.09){ var p = ease((t-725.28)/3.8); setCam(lerp(0.95,0.98,p), 0.98, lerp(-1.05,-1.12,p), 1.45, 0.66, -1.4, 34); }
  else { meStand(-0.9, -0.25, -Math.PI/2 - 0.2, {hp:0.02}); var q = ease((t-729.09)/3.6); setCam(1.55, 1.45, lerp(1.45,1.35,q), -0.8, 1.05, -0.4, 44); }
  handheld(t, 0.5);
};
function newsHand(k, t){
  NEWS.g.visible = true; HANDRIG.visible = true;
  var tip = newsInk(k);
  newsWorld(tip[0], tip[1], _vc);
  HANDRIG.position.copy(_vc); HANDRIG.position.y = TABLE_TOP_Y + 0.0012 + 0.004*(1-tip[2]);
  HANDRIG.rotation.set(0, Math.PI/2 - 0.12 + 0.05*Math.sin(t*0.9), 0);
  handPenPose(HANDP, 0.04*Math.sin(t*2.1));
}
SHOT.S46 = function(u, t){   /* C66 tờ báo + bút đỏ: khoanh những con số không khớp */
  roomLight(0.75, 0.6); RM.cardCase.visible = false;
  var k = 0.02 + ramp(t, 741.6, 743.7) + ramp(t, 743.9, 745.8);
  newsHand(k, t);
  FX.mul = [0.78,0.78,0.78];
  var h = HANDRIG.position, p = ease(u/13.3);
  /* máy qua vai phải người viết (POV) — thấy tay, bút và các con số được khoanh */
  setCam(h.x+lerp(0.3,0.24,p), h.y+lerp(0.4,0.33,p), h.z+lerp(0.4,0.33,p), h.x-lerp(0.02,0.05,p), h.y, h.z-0.04, 36);
  handheld(t, 0.3);
};
SHOT.S47 = function(u, t){   /* C67 một mình, không ai nhờ — tay vẫn tự động */
  roomLight(0.78, 0.6); meClothes('cardi'); RM.cardCase.visible = false; NEWS.g.visible = true;
  newsInk(2.0 + ramp(t, 749.4, 752.6));
  meSeiza(t, 0.28, 0.85 + 0.05*Math.sin(t*1.7));
