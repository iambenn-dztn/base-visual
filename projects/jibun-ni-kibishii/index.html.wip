  gAdu:     makeLabel('地域で暮らす大人\n400人', {px:96, h:0.36, col:CW}),
  gMed:     makeLabel('瞑想を続ける人\n172人', {px:96, h:0.36, col:CW}),
  oSelf:    makeLabel('自分へのやさしさ', {px:40, h:0.22, col:'#ffe0a8', weight:'400'}),
  oOther:   makeLabel('人への思いやり', {px:40, h:0.22, col:'#ffc2a8', weight:'400'}),
  fight:    makeLabel('戦う', {px:66, h:0.34, col:CC}),
