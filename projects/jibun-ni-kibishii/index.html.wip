};

/* ---------------- CHƯƠNG 3 ---------------- */
var P_FIGHT = {lean:0.10, aLx:-0.95, eL:-1.35, aRx:-0.95, eR:-1.35, aLz:-0.18, aRz:0.18, lLx:0.12, lRx:-0.12, hp:-0.02};
var P_FLEE  = {twist:0.45, hy:0.9, lean:0.05, lLx:0.30, kL:0.2, aLx:0.25, aRx:-0.3, hp:0.0};
var P_FREEZE= {aLz:0.02, aRz:-0.02, aLx:0.0, aRx:0.0, eL:-0.05, eR:-0.05, hp:0.10, lean:0.02};
function threatPose(t, t1, t2, t3){
  var a = ramp(t, t1, t1 + 0.5), b = ramp(t, t2, t2 + 0.5), c = ramp(t, t3, t3 + 0.6);
  var p = mixPose(fullPose({}), fullPose(P_FIGHT), a);
  p = mixPose(p, fullPose(P_FLEE), b);
  p = mixPose(p, fullPose(P_FREEZE), c);
  return p;
}
SH.C29 = function(u, t){   /* đánh, chạy, hay đứng sững */
  voidBase(1, 0);
  spot(coldSpot, 0.8, 6.2, 1.6, 0, 0, 0, 42, 0.30, 0.12);
  spotBeam(beamCold, coldSpot, 0.10);
  figV(figS, 0, 0, 0, threatPose(t, 356.15, 357.03, 358.13));
  var p = u/dur('C29');
  camV(lerp(-0.6, 0.5, p), lerp(0.7, 0.8, p), lerp(6.2, 5.2, p), 0, 1.55, 0, 38);
  lblV(L.fight, -1.9, 2.95, 0, win(t, 356.15, 361.8, 0.35));
  lblV(L.flee, 0, 3.35, 0, win(t, 357.03, 361.8, 0.35));
  lblV(L.freeze, 1.9, 2.95, 0, win(t, 358.13, 361.8, 0.35));
};
SH.C30 = function(u, t){   /* bạn thất bại: mình không bị đe doạ, không thủ thế */
  voidBase(1, 0.6);
  on('bench'); benchV.position.set(VX - 2.2, 0, -0.4);
  figV(figF, -2.55, -0.4, 0.3, {sit:1, hp:0.45, lean:0.26, aLx:-0.45, eL:-1.1, aRx:-0.45, eR:-1.1, aLz:-0.2, aRz:0.2});
  figV(figS, 1.4, 0.6, -1.9, {hp:0.08});
  spot(topSpot, 0, 7, 2, -0.4, 0, 0, 9, 0.62, 0.8);
  spot(warmSpot, -2.0, 5.5, 1.5, -2.2, 0, -0.4, 14, 0.38, 0.9);
  spotBeam(beamWarm, warmSpot, 0.05);
  var p = u/dur('C30');
  camV(lerp(0.3, -0.2, p), 1.75, lerp(7.6, 7.0, p), -0.5, 1.1, 0, 40);
};
SH.C31 = function(u, t){   /* thương người đang yếu: tới ngồi cạnh */
  voidBase(1, 0.8);
  on('bench'); benchV.position.set(VX - 2.2, 0, -0.4);
  figV(figF, -2.55, -0.4, 0.3, {sit:1, hp:lerp(0.45, 0.28, ramp(t, 381, 384)), lean:0.22, aLx:-0.45, eL:-1.1, aRx:-0.45, eR:-1.1, aLz:-0.2, aRz:0.2, hy:lerp(0, 0.3, ramp(t, 382, 385))});
  var w0 = CS.C31 + 0.3, w1 = 379.6;
  var wk = clamp((t - w0)/(w1 - w0), 0, 1), we = ease(wk);
  var sx = lerp(1.4, -1.72, we), sz = lerp(0.6, -0.30, we);
  var head = Math.atan2(-2.55 - 1.4, -0.4 - 0.6);
  var dist = Math.hypot(1.4 - (-1.72), 0.6 - (-0.30))*we;
  var sit = ramp(t, 379.8, 381.4);
  var ps = mixPose(walkPose(dist, wk < 1 ? 1 : 0), {sit:1, hp:0.14, hy:0.55, lean:0.10, aLx:-0.40, eL:-1.0, aRx:-0.40, eR:-1.0, aLz:-0.15, aRz:0.15}, sit);
  var hd = lerp(head, 0.3, ramp(t, 379.2, 380.4));
  figV(figS, sx, sz, hd, ps);
  on('bench');
  spot(topSpot, 0, 7, 2, -0.4, 0, 0, 7, 0.62, 0.8);
  var wk2 = ramp(t, 379.5, 383.0);
  spot(warmSpot, -1.9, 5.5, 1.6, -2.2, 0, -0.4, 14 + 26*wk2, 0.40, 0.9);
  spotBeam(beamWarm, warmSpot, 0.05 + 0.08*wk2);
  var p = u/dur('C31');
  camV(lerp(0.6, -0.6, p), lerp(1.8, 1.5, p), lerp(7.2, 5.2, p), lerp(-0.6, -2.0, p), 1.0, -0.2, 40);
};
SH.C32 = function(u, t){   /* khi người thất bại là chính mình: đèn lạnh bật, thủ thế */
  voidBase(1, 0);
  var c = ramp(t, 391.1, 391.5);
  spot(topSpot, 0, 7, 2, 0, 0, 0, 7*(1 - c), 0.6, 0.8);
  spot(coldSpot, 0.6, 6.2, 1.2, 0, 0, 0, 48*c, 0.28, 0.1);
  spotBeam(beamCold, coldSpot, 0.12*c);
  var br = ramp(t, 397.3, 399.2);
  figV(figS, 0, 0, 0.2, mixPose({hp:0.06}, {aLz:0.02, aRz:-0.02, eL:-0.3, eR:-0.3, aLx:-0.2, aRx:-0.2, hp:-0.04, lean:-0.03, lLx:0.1, lRx:-0.1}, br));
  var p = u/dur('C32');
  camV(lerp(2.4, 1.8, p), lerp(1.3, 1.1, p), lerp(5.4, 4.6, p), 0, 1.35, 0, 38);
};
SH.C33 = function(u, t){   /* thế thủ quay VÀO trong: cái bóng phán xét tách ra, đổ bóng lên mình */
  voidBase(1, 0);
  var sp = ramp(t, 401.4, 403.6);
  var bow = ramp(t, 404.0, 406.6);
  figV(figS, 0, 0.6, 0.4, {hp:lerp(0.06, 0.48, bow), lean:lerp(0, 0.24, bow), aLz:0.03, aRz:-0.03});
  var jz = lerp(0.6, -0.8, sp), jx = lerp(0, -0.5, sp);
  figV(figJ, jx, jz, 0.4, {hp:0.12, lean:-0.02, aLz:0.03, aRz:-0.03}, sp);
  var hit = 0.55 + 0.45*(bump(t, 406.6, 407.6) + bump(t, 408.1, 409.1) + bump(t, 409.8, 411.2));
  spot(coldSpot, jx - 0.5, 4.8, jz - 2.2, 0, 0, 0.9, 58*hit*sp + 10, 0.30, 0.1);
  spotBeam(beamCold, coldSpot, 0.12*hit);
  spot(warmSpot, 1.6, 4.5, 3.2, 0, 0, 0.6, 5, 0.3, 0.9);
  var p = u/dur('C33');
  camV(lerp(3.6, 3.2, p), 1.5, lerp(2.6, 2.2, p), -0.3, 1.2, 0.0, 38);
};
SH.C34 = function(u, t){   /* không phải ác ý — là người canh gác, quay mặt ra ngoài bóng tối */
  voidBase(1, 0.2);
  var turn = ramp(t, 418.7, 420.8);
  figV(figS, 0, 0.6, 0.4, {hp:0.44, lean:0.22, aLz:0.03, aRz:-0.03});
  figV(figJ, -0.5, -0.8, lerp(0.4, 0.4 + Math.PI, turn), {hp:lerp(0.12, 0.0, turn), aLz:0.05, aRz:-0.05});
  figV(figF, -1.0, -9.5, 0.1, {hp:0.1}, 0.9);
  var soft = ramp(t, 419.0, 423.0);
  spot(coldSpot, -0.9, 4.8, -3.0, 0, 0, 0.9, lerp(56, 34, soft), lerp(0.30, 0.36, soft), lerp(0.1, 0.45, soft));
  spotBeam(beamCold, coldSpot, lerp(0.12, 0.08, soft));
  spot(warmSpot, -1.0, 5, -8, -1.0, 0, -9.5, 10, 0.3, 0.9);
  var p = u/dur('C34');
  camV(lerp(2.2, 1.4, p), lerp(0.9, 1.1, p), lerp(4.4, 5.4, p), -0.6, 1.3, -1.2, 40);
};
SH.C35 = function(u, t){   /* Longe et al. 2010 — NeuroImage */
  on('paper'); paperLights(1);
  showPaper('longe10', 0.0, 0.02, 0.12);
  var p = u/dur('C35');
  camP(lerp(0.05, 0.12, p), lerp(0.92, 0.88, p), lerp(-0.34, -0.30, p), 0.0, 0.76, 0.02, 32);
  showLabel(L.src10, PX + 0.0, 0.845, 0.0, win(t, 428.4, SC.C35[1] + 1, 0.5));
};
SH.C36 = function(u, t){   /* trong máy chụp: đọc tình huống thất bại */
  on('scan'); scanLights(); sunS.intensity = 0.7; hemiS.intensity = 0.35; scene.environment = envDay;
  bgMat.uniforms.uTop.value.setRGB(0.5,0.55,0.6); bgMat.uniforms.uBot.value.setRGB(0.3,0.32,0.34);
  var sl = ramp(t, CS.C36 + 0.3, CS.C36 + 4.0);
  figShow(patient, 1);
  patient.root.position.set(SX, 1.04, lerp(1.65, 0.95, sl)); patient.root.rotation.set(-Math.PI/2, 0, 0);
  pose(patient, {aLz:0.12, aRz:-0.12});
  var p = u/dur('C36');
  setCam(SX + lerp(1.7, 1.4, p), lerp(1.55, 1.45, p), lerp(2.3, 1.9, p), SX, 1.05, lerp(0.1, -0.4, p), 40);
};
function headCam(p){ setCam(HX + lerp(0.25, 0.05, p), 1.25, lerp(4.6, 4.2, p), HX + 0.05, 1.2, 0, 40); }
SH.C37 = function(u, t){   /* tự trách: vùng trước-trán sáng lạnh */
  bgMat.uniforms.uTop.value.setRGB(0.006,0.008,0.014);
  brainA.position.set(HX, 0.0, 0); brainA.rotation.set(0, Math.PI/2, 0); brainA.scale.setScalar(9);
  var c = ramp(t, 451.2, 454.0);
  setBrain(brainA, t, c, 0, 0, 1);
  headCam(u/dur('C37'));
  showLabel(L.lCrit, HX + 0.05, 2.62, 0.3, win(t, CS.C37 + 0.2, SC.C37[1] + 1, 0.5));
};
SH.C38 = function(u, t){   /* tự trấn an: vùng thái dương & thuỳ đảo sáng ấm */
  bgMat.uniforms.uTop.value.setRGB(0.012,0.009,0.006);
  brainA.position.set(HX, 0.0, 0); brainA.rotation.set(0, Math.PI/2, 0); brainA.scale.setScalar(9);
  setBrain(brainA, t, 1 - ramp(t, CS.C38, CS.C38 + 1.5), ramp(t, 463.3, 466.0), 0, 1);
  var p = u/dur('C38');
  setCam(HX + lerp(0.6, 0.9, p), lerp(1.1, 1.05, p), lerp(3.9, 3.5, p), HX + 0.2, 1.05, 0, 40);
  showLabel(L.lReas, HX + 0.05, 2.62, 0.3, win(t, CS.C38 + 0.3, SC.C38[1] + 1, 0.5));
};
SH.C39 = function(u, t){   /* cùng một "dụng cụ": tự an ủi & thương người */
  bgMat.uniforms.uTop.value.setRGB(0.012,0.009,0.006);
  brainA.position.set(HX - 1.45, 0.25, 0); brainA.rotation.set(0, Math.PI/2, 0); brainA.scale.setScalar(6.2);
  brainB.position.set(HX + 1.45, 0.25, 0); brainB.rotation.set(0, Math.PI/2, 0); brainB.scale.setScalar(6.2);
  var s = 0.85 + 0.15*Math.sin(t*1.4);
  setBrain(brainA, t, 0, s*(0.6 + 0.4*ramp(t, 478.7, 480.5)), 0, 0.9);
  setBrain(brainB, t, 0, s*ramp(t, 479.0, 481.0), 0, 0.9);
  var p = u/dur('C39');
  setCam(HX, 1.05, lerp(5.8, 5.4, p), HX, 1.0, 0, 40);
  showLabel(L.lSelfR, HX - 1.45, 2.35, 0.3, win(t, 478.7, SC.C39[1] + 1, 0.5));
  showLabel(L.lOthC, HX + 1.45, 2.35, 0.3, win(t, 481.1, SC.C39[1] + 1, 0.5));
};
SH.C40 = function(u, t){   /* nhưng đừng tin trọn: "nơi sáng" ≠ nội tâm */
  bgMat.uniforms.uTop.value.setRGB(0.008,0.008,0.009);
  brainA.position.set(HX, 0.0, 0); brainA.rotation.set(0, Math.PI/2, 0); brainA.scale.setScalar(9);
  var bl = ramp(t, 489.5, 497.5);
  setBrain(brainA, t, 0, 1 - 0.5*bl, bl, lerp(1, 0.45, bl));
  var p = u/dur('C40');
  setCam(HX + lerp(0.2, 0.0, p), 1.2, lerp(4.1, 5.2, p), HX + 0.05, 1.15, 0, 40);
};
/* tia ấm đi ra ngoài (tới "cái bóng thứ ba") — C41, C58, C59 */
function outwardBeam(t, I, turnK, selfX){
  var sx = VX - 1.6, sy = 1.36, sz = 0;
  var fx = VX + 4.2, fz = -2.4, xx = VX + (selfX != null ? selfX : -3.2), xz = 1.0;
  var tx = lerp(fx, xx, turnK), ty = lerp(1.3, 1.1, turnK), tz = lerp(fz, xz, turnK);
  setBeam(beamOut, sx + 0.05, sy, sz, tx, ty, tz, 0.55, 0.18*I, 0xffc27e);
  warmPt.position.set(tx, 1.4, tz + 0.3); warmPt.intensity = 5*I;
}
SH.C41 = function(u, t){   /* sức tử tế đã có sẵn — chỉ là hướng ra ngoài */
  voidBase(1, 0.4);
  figV(figS, -1.6, 0, Math.PI/2 - 0.35, {hp:0.04});
  figV(figF, 4.2, -2.4, -Math.PI/2 + 0.4, {hp:0.1}, 0.95);
  var I = 0.3 + 0.7*ramp(t, 508.6, 510.5);
  outwardBeam(t, I, 0);
  spot(warmSpot, 4.0, 5.5, -1.0, 4.2, 0, -2.4, 18*I, 0.3, 0.9);
  rimV.intensity = 0.8;
  var p = u/dur('C41');
  camV(lerp(-1.0, 0.4, p), lerp(1.5, 1.7, p), lerp(6.6, 7.4, p), 1.0, 1.25, -0.8, 40);
};
SH.C42 = function(u, t){   /* niềm tin "mềm với mình thì hư" — người canh đứng thẳng */
  voidBase(1, 0);
  figV(figJ, 0, 0, 0.0, {hp:-0.02, aLz:0.03, aRz:-0.03, lean:-0.02});
  figV(figS, 0.7, -1.4, -0.3, {hp:lerp(0.44, 0.22, ramp(t, 536.0, 538.5)), lean:0.18}, 0.95);
  spot(coldSpot, 0.4, 6.2, 1.8, 0, 0, 0, 46, 0.26, 0.12);
  spotBeam(beamCold, coldSpot, 0.09);
  var p = u/dur('C42');
  var a = -0.35 + 0.6*p;
  camV(Math.sin(a)*6.0, lerp(1.2, 1.5, p), Math.cos(a)*6.0, 0.2, 1.45, -0.4, 40);
  lblV(L.belief, 0, 2.85, 0.4, win(t, 527.9, SC.C42[1] + 1, 0.5));
};
SH.C43 = function(u, t){   /* Breines & Chen 2012 */
  on('paper'); paperLights(1);
  showPaper('breines12', 0.02, 0.0, -0.18);
  var p = u/dur('C43');
  camP(lerp(-0.35, -0.28, p), lerp(0.88, 0.95, p), lerp(0.22, 0.30, p), 0.02, 0.755, 0.0, 30);
  showLabel(L.src12, PX + 0.02, 0.88, 0.0, win(t, 540.3, SC.C43[1] + 1, 0.5));
};
function deskBase(k){
  on('desk'); deskLights(); testSheet.visible = true; noteCard.rotation.set(-Math.PI/2, 0, 0); lampD.intensity = 1.35*k; ambD.intensity = 0.3*k; scene.environment = envLamp;
  bgMat.uniforms.uTop.value.setRGB(0.02,0.02,0.022);
}
SH.C44 = function(u, t){   /* bài kiểm tra từ vựng khó — hầu như ai cũng vấp */
  deskBase(1);
  noteCard.position.set(0.9, 0.748, 0.2);
  var stop = ramp(t, 556.1, 557.5);
  var px = lerp(0.02 + 0.03*Math.sin(t*2.2), 0.03, stop), pz = lerp(-0.10 + (t - CS.C44)*0.012, -0.02, stop);
  pencil.position.set(px + 0.09, 0.76 + 0.012*(1 - stop)*Math.abs(Math.sin(t*6)), pz + 0.05); pencil.rotation.set(0, -0.6, 0.18);
  var p = u/dur('C44');
  setCam(DX + lerp(0.10, 0.05, p), lerp(1.25, 1.12, p), lerp(0.42, 0.36, p), DX + 0.0, 0.74, 0.02, 36);
};
SH.C45 = function(u, t){   /* một tấm thiệp với lời tự thương */
  deskBase(1.05);
  var sl = ramp(t, 563.5, 566.5);
  noteCard.position.set(lerp(0.55, 0.13, sl), 0.749, lerp(0.30, 0.14, sl)); noteCard.rotation.set(-Math.PI/2, 0, lerp(-0.4, -0.08, sl));
  pencil.position.set(0.12, 0.752, -0.04); pencil.rotation.set(0, -0.6, 0);
  var p = u/dur('C45');
  setCam(DX + lerp(0.25, 0.18, p), lerp(1.05, 0.98, p), lerp(0.42, 0.38, p), DX + 0.1, 0.745, 0.12, 34);
};
SH.C46 = function(u, t){   /* được tự thương → học LÂU hơn */
  deskBase(1);
  noteCard.position.set(0.9, 0.748, 0.2);
  pencil.position.set(-0.6, 0.752, 0.3);
  var nA = Math.floor(clamp((t - 579.3)/0.27, 0, CARD_N)), nB = Math.floor(clamp((t - 579.3)/0.5, 0, 12));
  for(var i=0;i<CARD_N;i++){
    if(i < nA){ cardsA[i].visible = true; cardsA[i].position.set(-0.62 + i*0.062, 0.747 + 0.0015*(i%2), -0.02); cardsA[i].rotation.y = 0.04*Math.sin(i*1.9); }
    if(i < nB){ cardsB[i].visible = true; cardsB[i].position.set(-0.62 + i*0.062, 0.747 + 0.0015*(i%2), 0.16); cardsB[i].rotation.y = 0.04*Math.sin(i*2.3); }
  }
  testSheet.visible = false;
  var p = u/dur('C46');
  setCam(DX + 0.05, lerp(1.30, 1.22, p), lerp(0.72, 0.66, p), DX + 0.05, 0.74, 0.06, 40);
  showLabel(L.study, DX + 0.05, 0.93, -0.12, win(t, 576.6, SC.C46[1] + 1, 0.5));
  showLabel(L.grpA, DX - 0.48, 0.80, -0.02, win(t, 579.3, SC.C46[1] + 1, 0.5));
  showLabel(L.grpB, DX - 0.52, 0.80, 0.16, win(t, 579.3, SC.C46[1] + 1, 0.5));
};
SH.C47 = function(u, t){   /* niềm tin tan ra */
  voidBase(1, 0.6);
  figV(figS, 0, -1.2, 0, {hp:0.02});
  spot(warmSpot, 0.6, 6, 0.8, 0, 0, -1.2, 20, 0.36, 0.9);
  spotBeam(beamWarm, warmSpot, 0.05);
  camV(0, 1.9, lerp(6.4, 6.0, u/dur('C47')), 0, 1.9, 0, 40);
  var d = ramp(t, 588.8, 591.2);
  lblV(L.belief, 0, 2.6, 0.6, 1 - d);
  var lw = L.belief.userData.w, lh = L.belief.userData.h;
  for(var i=0;i<500;i++){ var q = R26[i];
    var x = (q[0]-0.5)*lw, y = (q[1]-0.5)*lh*0.6;
    var dd = clamp(d*1.4 - q[2]*0.4, 0, 1);
    ptsSet(burstP, i, VX + x + (q[3]-0.5)*1.6*dd, 2.6 + y + 0.9*dd*dd + 0.3*dd*Math.sin(q[0]*20), 0.6 + (q[2]-0.5)*0.8*dd, 0.9, 1.1, 1.5, (d > 0 ? 1 : 0)*(1 - dd)*0.8, 0.03);
  }
  ptsDone(burstP);
  var p = u/dur('C47');
  camV(0, 1.9, lerp(6.4, 6.0, p), 0, 1.9, 0, 40);
};
SH.C48 = function(u, t){   /* chuẩn KHÔNG thấp hơn — khác ở chỗ không dồn mình tới đường cùng */
  voidBase(1, 0.4);
  var ln = ramp(t, 593.5, 595.5);
  on('stdLine'); stdLine.position.set(VX, 2.6, 0); stdLine.material.opacity = ln; stdLine.scale.x = 0.2 + 0.8*ln;
  var press = ramp(t, 601.3, 603.5);
  figV(figS, -1.4, 0, 0.25, {hp:lerp(0.0, -0.05, press), aLx:-0.2, aRx:-0.2});
  figV(figX, 1.4, 0, -0.25, {hp:lerp(0.0, 0.5, press), lean:lerp(0, 0.24, press), aLz:0.03, aRz:-0.03});
  spot(warmSpot, -1.6, 5.5, 2.0, -1.4, 0, 0, 12 + 18*press, 0.34, 0.9);
  spot(coldSpot, 1.9, 5.8, 0.8, 1.4, 0, 0, 55*press, 0.26, 0.1);
  spotBeam(beamWarm, warmSpot, 0.04 + 0.05*press);
  spotBeam(beamCold, coldSpot, 0.12*press);
  spot(topSpot, 0, 7, 2, 0, 0, 0, 6, 0.6, 0.8);
  var p = u/dur('C48');
  camV(0, 1.8, lerp(7.2, 6.8, p), 0, 1.6, 0, 40);
  lblV(L.stdL, 0, 2.92, 0, win(t, 595.8, SC.C48[1] + 1, 0.5));
};
SH.C49 = function(u, t){   /* tự nuông chiều: ánh xám đục — không phải điều ta nói */
  voidBase(1, 0.3);
  figV(figS, -0.6, 0.4, lerp(0.2, -0.1, ramp(t, 616.0, 618.5)), {hp:0.04, hy:lerp(0.0, 0.6, bump(t, 613.5, 619.0))});
  var g = win(t, 612.9, 619.6, 1.0);
  greyPt.position.set(VX + 1.6, 1.2, 0.2); greyPt.intensity = 6*g;
  setBeam(beamGrey, VX + 1.7, 5.5, 0.0, VX + 1.6, 0, 0.2, 1.2, 0.22*g, 0x9a9a94);
  spot(warmSpot, -0.8, 5.5, 2.2, -0.6, 0, 0.4, 14, 0.34, 0.9);
  var p = u/dur('C49');
  camV(lerp(0.2, 0.5, p), 1.6, lerp(6.0, 5.6, p), 0.4, 1.3, 0, 40);
  lblV(L.indulge, 1.6, 2.7, 0.2, 0.9*g);
};
SH.C50 = function(u, t){   /* "nghỉ đã, rồi thử lại" — ngồi xuống, rồi đứng dậy bước tiếp */
  voidBase(1, 0.8);
  on('bench'); benchV.position.set(VX, 0, -0.3);
  var sit = ramp(t, 627.6, 628.8)*(1 - ramp(t, 629.6, 630.9));
  var step = ramp(t, 630.9, 633.0);
  var p0 = mixPose({hp:0.2, lean:0.05}, {sit:1, hp:0.24, lean:0.16, aLx:-0.4, eL:-1.0, aRx:-0.4, eR:-1.0, aLz:-0.15, aRz:0.15}, sit);
  var pw = mixPose(p0, walkPose(step*1.1, step < 1 ? 1 : 0), step);
  pw.hp = lerp(pw.hp, 0.0, step);
  figV(figS, 0.1 + 0.0, -0.3 + step*1.1, 0, pw);
  spot(warmSpot, 0.6, 5.6, 2.4, 0, 0, 0.2, 30, 0.44, 0.9);
  spotBeam(beamWarm, warmSpot, 0.06);
  var p = u/dur('C50');
  camV(lerp(3.2, 2.8, p), 1.4, lerp(3.6, 3.9, p), 0, 0.95, 0, 38);
};
SH.C51 = function(u, t){   /* tự thương hại: vòng khép → mở ra, nối với những người khác */
  voidBase(1, 0.4);
  figV(figS, 0, 0, 0, {hp:lerp(0.42, 0.10, ramp(t, 641.1, 644.1)), lean:lerp(0.18, 0.02, ramp(t, 641.1, 644.1))});
  spot(topSpot, 0, 6.5, 1.2, 0, 0, 0, 12, 0.34, 0.6);
  var open = ramp(t, 641.1, 643.6);
  for(var i=0;i<320;i++){ var a = i/320*6.283;
    var gap = open*1.2, da = Math.abs(((a - Math.PI*0.5 + Math.PI) % 6.283) - Math.PI);
    var vis = da < gap ? 0 : 1;
    ptsSet(ringP, i, VX + Math.cos(a)*1.05, 0.05 + 0.02*Math.sin(t*2 + i), Math.sin(a)*1.05, 0.7, 0.9, 1.5, vis*(0.9 - 0.3*open), 0.06); }
  ptsDone(ringP);
  othersSet(t, 0.35 + 0.65*open, lerp(0.15, 0.6, open), 0, 0, 0);
  var r2 = ramp(t, 644.1, 646.0);
  setPillarW(1, VX, 0, -3.0, 1, r2, 0.8, 0.4*r2);
  var p = u/dur('C51');
  camV(lerp(0.0, 0.8, p), lerp(3.2, 2.6, p), lerp(6.8, 7.6, p), 0, 0.9, -0.6, 40);
  lblV(L.pity, 0, 2.55, 0, win(t, 633.3, 641.0, 0.5));
};
SH.C52 = function(u, t){   /* Warren, Smeets & Neff 2016 → hai lối đi */
  if(t < 660.2){
    on('paper'); paperLights(1);
    showPaper('warren16', 0.02, 0.02, 0.2);
    var p = (t - CS.C52)/(660.2 - CS.C52);
    camP(lerp(0.30, 0.38, p), lerp(1.05, 0.98, p), lerp(-0.25, -0.12, p), 0.02, 0.755, 0.02, 32);
    showLabel(L.src16, PX + 0.02, 0.88, 0.02, win(t, 649.4, 661.0, 0.5));
    FX.dip = smooth((660.2 - t)/0.3);
  } else {
    voidBase(1, 0.5);
    figV(figS, 0, 2.0, Math.PI, {hp:0.06});
    spot(topSpot, 0, 7, 3.5, 0, 0, 2.0, 8, 0.4, 0.8);
    var a1 = ramp(t, 660.3, 662.5), a2 = ramp(t, 668.0, 670.0);
    for(var i=0;i<700;i++){ var q = R26[i]; var left = i < 350; var k = (i % 350)/350;
      var ph = (k + t*0.05*(left ? 1 : 1.2)) % 1;
      var dx = left ? -1 : 1, s = ph*14;
      var x = dx*(0.3 + s*0.55) + (q[0]-0.5)*0.35, z = 1.6 - s + (q[1]-0.5)*0.35;
      var c = left ? [0.55, 0.75, 1.5] : [1.9, 1.35, 0.75];
      var amt = left ? a1 : a2;
      ptsSet(pathP, i, VX + x, 0.04, z, c[0], c[1], c[2], amt*(ph < amt ? 1 : 0)*(1 - ph*0.6)*(left ? 0.85 : 1), 0.05);
    }
    ptsDone(pathP);
    var p2 = (t - 660.2)/(SC.C52[1] - 660.2);
    camV(0, lerp(4.2, 4.6, p2), lerp(6.4, 7.0, p2), 0, 0.4, -4.0, 40);
    lblV(L.risk, -3.8, 1.6, -5.5, win(t, 660.5, SC.C52[1] + 1, 0.5));
    lblV(L.resil, 3.8, 1.6, -5.5, win(t, 668.0, SC.C52[1] + 1, 0.5));
    FX.dip = smooth((t - 660.2)/0.3);
  }
};
SH.C53 = function(u, t){   /* tương quan ≠ nhân quả */
  voidBase(1, 0.3);
  spot(topSpot, 0, 7, 2, 0, 0, 0, 5, 0.7, 0.8);
  var x0 = lerp(-3.0, 1.5, (t - CS.C53)/dur('C53'));
  var ay = 1.6 + 0.08*Math.sin(t*1.6), by = 1.0 + 0.08*Math.sin(t*1.6 + 0.3);
  showSprite(orbs[0], VX + x0 - 0.7, ay, 0, 1, 0.8);
  showSprite(orbs[1], VX + x0 + 0.7, by, 0, 1, 0.8);
  var p = u/dur('C53');
  camV(x0*0.5, 1.6, 6.2, x0*0.5, 1.4, 0, 40);
  lblV(L.corr, x0*0.5, 2.75, 0, win(t, 680.9, 683.6, 0.4));
  var ph = Math.floor((t - 683.77)/1.2) % 2;
  var ar = t > 683.77 ? 1 : 0;
  lblV(L.arrowAB, x0, (ay + by)/2, 0, ar*(ph === 0 ? 0.9 : 0));
  lblV(L.arrowBA, x0, (ay + by)/2, 0, ar*(ph === 1 ? 0.9 : 0));
  lblV(L.cause, x0*0.5, 2.75, 0, win(t, 683.8, SC.C53[1] + 1, 0.4));
};
SH.C54 = function(u, t){   /* thí nghiệm ngắn vs. mấy chục năm */
  voidBase(1, 0.3);
  spot(topSpot, 0, 7, 3, 0, 0, 1, 6, 0.6, 0.8);
  on('shortSeg'); shortSeg.position.set(VX - 1.0, 0.05, 2.2); shortSeg.scale.set(1, 1, 1);
  var ln = ramp(t, 694.2, 698.0);
  for(var i=0;i<600;i++){ var k = i/599; var z = 2.2 - k*38;
    ptsSet(lineP, i, VX - 1.0 + 0.25, 0.05, z, 1.0, 1.0, 1.05, (k < ln ? 1 : 0)*0.8*(1 - k*0.5), 0.05); }
  ptsDone(lineP);
  var p = u/dur('C54');
  camV(lerp(1.6, 2.2, p), lerp(1.1, 1.4, p), lerp(5.4, 5.8, p), -1.0, 0.3, -3.0, 40);
  lblV(L.shortX, -1.0, 0.75, 2.2, win(t, 691.0, SC.C54[1] + 1, 0.5));
  lblV(L.longX, -0.75, 0.9, -8.0, win(t, 694.3, SC.C54[1] + 1, 0.5));
};

/* ---------------- CHƯƠNG 4 — đường về ---------------- */
SH.C55 = function(u, t){   /* xe buýt gần tới trạm — cùng góc máy với C06 (khép vòng) */
  busBase(t, 1);
  busPeople(t, meBusPose(t, {hp:0.08}));
  if(t < 712.85){
    var p = (t - CS.C55)/(712.85 - CS.C55);
    camB(lerp(-4.4, -3.4, p), 1.56, lerp(0.40, 0.28, p), 0.6, 1.12, -0.75, 44);
  } else {
    var p2 = (t - 712.85)/(SC.C55[1] - 712.85);
    camB(lerp(1.20, 1.02, p2), 1.32, -0.24, 0.0, 1.30, -0.92, lerp(32, 29, p2));
  }
};
SH.C56 = function(u, t){   /* trong kính: "nếu người bạn kể chuyện của tôi" */
  busBase(t, 0.6);
  scene.fog.color.setRGB(0.12, 0.13, 0.14); scene.fog.near = 2.5; scene.fog.far = 18;
  bgMat.uniforms.uTop.value.setRGB(0.12,0.13,0.14); bgMat.uniforms.uBot.value.setRGB(0.09,0.09,0.10);
  var meP = meBusPose(t, {hp:0.10, hy:0.8});
  busPeople(t, meP);
  var fr = ramp(t, 724.0, 727.0);
  reflect(0.28, 0.30*fr, meP, {sit:1, hp:lerp(0.1, 0.45, ramp(t, 729.0, 731.0)), lean:0.2, aLx:-0.45, eL:-1.1, aRx:-0.45, eR:-1.1, aLz:-0.15, aRz:0.15});
  FX.sat = 0.85; FX.mul = [1.04, 1.0, 0.96];
  var p = u/dur('C56');
  camB(lerp(-0.72, -0.60, p), 1.46, lerp(-0.08, -0.14, p), 0.50, 1.30, -1.55, 36);
};
SH.C57 = function(u, t){   /* ký ức quán sáng nay: cùng một câu */
  cafeBase(1.08, 0.9);
  FX.mul = [1.06, 1.0, 0.92]; bloomPass.strength = 0.8; FX.sat = 0.92;
  var talk = win(t, 737.0, 741.0, 0.5);
  var me = mixPose(ME_REST, {lean:0.16, hp:0.02 + 0.04*Math.sin(t*5.0)*talk}, talk);
  cafePeople(t, mixPose(FR_HOLD, {hp:0.08}, 0.6), me, 1);
  var p = u/dur('C57');
  camC(lerp(1.80, 1.55, p), 1.20, lerp(0.14, 0.04, p), -0.55, 1.02, 0.0, 34);
};
SH.C58 = function(u, t){   /* không phải học điều mới — chỉ là hướng */
  voidBase(1, 0.5);
  figV(figS, -1.6, 0, Math.PI/2 - 0.35, {hp:0.04});
  figV(figF, 4.2, -2.4, -Math.PI/2 + 0.4, {hp:0.1}, 0.95);
  figV(figX, -3.2, 1.0, 0.6, {hp:0.46, lean:0.22}, ramp(t, 752.2, 754.5));
  outwardBeam(t, 1, 0);
  spot(warmSpot, 4.0, 5.5, -1.0, 4.2, 0, -2.4, 18, 0.3, 0.9);
  spot(coldSpot, -3.4, 5.5, 2.2, -3.2, 0, 1.0, 40*ramp(t, 752.2, 754.5), 0.24, 0.1);
  var p = u/dur('C58');
  camV(lerp(0.4, -0.2, p), lerp(1.7, 1.8, p), lerp(7.4, 8.4, p), lerp(1.0, 0.0, p), 1.25, -0.4, 42);
};
SH.C59 = function(u, t){   /* thì thầm với chính mình — tia ấm quay về phía mình */
  if(t < 766.43){
    busBase(t, 1.05);
    FX.mul = [1.04, 1.0, 0.95];
    var meP = meBusPose(t, {hp:0.12, hy:0.74});
    busPeople(t, meP);
    reflect(0.14, 0, meP, null);
    var p = (t - CS.C59)/(766.43 - CS.C59);
    camB(lerp(0.95, 0.85, p), 1.34, lerp(-0.28, -0.32, p), -0.05, 1.33, -0.92, lerp(26, 24, p));
    FX.dip = smooth((766.43 - t)/0.3);
  } else {
    voidBase(1, 0.7);
    var turn = ramp(t, 766.6, 769.2);
    figV(figS, -1.6, 0, lerp(Math.PI/2 - 0.35, -1.0, turn), {hp:0.04});
    figV(figF, 4.2, -2.4, -Math.PI/2 + 0.4, {hp:0.1}, 0.95*(1 - turn*0.5));
    var lift = ramp(t, 768.5, 770.8);
    figV(figX, -3.2, 1.0, 0.6, {hp:lerp(0.46, 0.18, lift), lean:lerp(0.22, 0.06, lift)});
    outwardBeam(t, 1, turn, -3.2);
    spot(coldSpot, -3.4, 5.5, 2.2, -3.2, 0, 1.0, 40*(1 - turn), 0.24, 0.1);
    spot(warmSpot, -2.4, 5.5, 2.4, -3.2, 0, 1.0, 30*turn, 0.38, 0.9);
    spotBeam(beamWarm, warmSpot, 0.07*turn);
    var p2 = (t - 766.43)/(SC.C59[1] - 766.43);
    camV(lerp(-0.4, -1.2, p2), 1.7, lerp(7.6, 7.0, p2), -1.6, 1.2, 0.2, 42);
    FX.dip = smooth((t - 766.43)/0.3);
  }
};
SH.C60 = function(u, t){   /* tiếng canh gác vẫn còn — nhưng nghe khác */
  voidBase(1, 0.8);
  figV(figX, -0.5, 0.5, 0.15, {hp:0.10, lean:0.04});
  figV(figJ, 0.6, 0.2, -0.1, {hp:0.02});
  spot(warmSpot, 0.2, 6, 2.6, 0, 0, 0.3, 32, 0.44, 0.9);
  spotBeam(beamWarm, warmSpot, 0.06);
  spot(coldSpot, 1.2, 6, 0.4, 0.6, 0, 0.2, 10*(1 - ramp(t, 774.0, 778.0)), 0.2, 0.3);
  var p = u/dur('C60');
  camV(lerp(-0.8, 0.6, p), 1.55, lerp(5.2, 4.8, p), 0.05, 1.25, 0.3, 38);
};
SH.C61 = function(u, t){   /* trên xe, bình thường — lời nhắn: tìm chuyên gia khi cần */
  busBase(t, 1);
  busPeople(t, meBusPose(t, {hy:0.35, hp:0.04}));
  var p = u/dur('C61');
  camB(lerp(4.4, 3.9, p), 1.62, lerp(0.45, 0.35, p), -0.6, 1.1, -0.7, 40);
};
SH.C62 = function(u, t){   /* xe dừng, cửa mở, 私 đứng dậy */
  busBase(t, 1.05);
  var open = ramp(t, 807.9, 809.2);
  G.doorL.position.x = 2.2 - 0.5*open; G.doorR.position.x = 2.75 + 0.5*open;
  var up = ramp(t, 810.0, 812.2), turn = ramp(t, 812.0, 813.6);
  var mp = mixPose(meBusPose(t, {hy:lerp(0.35, 0.0, up)}), {sit:0, hp:0.02, aLx:0.02, aRx:0.02, eL:-0.12, eR:-0.12, aLz:0.07, aRz:-0.07, lean:0}, up);
  fig(meB, BX + 0.02 + 0.3*up, -0.82 + 0.35*up + 0.5*turn, lerp(Math.PI/2, Math.PI*0.25, turn), mp);
  fig(paxB, BX - 3.0, 0.82, Math.PI/2, {sit:1, lean:0.12, hp:0.38, aLx:-0.5, eL:-1.1, aRx:-0.5, eR:-1.1, aLz:-0.1, aRz:0.1});
  var p = u/dur('C62');
  camB(lerp(-2.6, -2.2, p), 1.6, lerp(0.55, 0.45, p), 1.2, 1.1, 0.1, 42);
  FX.flash = 0.10*open;
};

/* ranh giới shot: nhúng tối ngắn khi ĐỔI BỘ CẢNH (cùng bộ thì cắt thẳng) */
var SET_OF = {C01:'cafe',C02:'cafe',C03:'cafe',C04:'cafe',C05:'cafe',C06:'bus',C07:'bus',C08:'bus',C09:'bus',
  C10:'paper',C11:'void',C12:'void',C13:'void',C14:'void',C15:'paper',C16:'void',C17:'void',C18:'void',C19:'void',C20:'void',C21:'void',
  C22:'cafe',C23:'void',C24:'paper',C25:'void',C26:'void',C27:'void',C28:'void',C29:'void',C30:'void',C31:'void',C32:'void',C33:'void',C34:'void',
  C35:'paper',C36:'scan',C37:'head',C38:'head',C39:'head',C40:'head',C41:'void',C42:'void',C43:'paper',C44:'desk',C45:'desk',C46:'desk',
  C47:'void',C48:'void',C49:'void',C50:'void',C51:'void',C52:'paper',C53:'void',C54:'void',C55:'bus',C56:'bus',C57:'cafe',C58:'void',
