/* đèn VOID — giàn chung: spotA (lạnh, có bóng), spotB (ấm, có bóng), spotC (đỉnh), rimL, ambL, ptA/ptB/ptC */
var coldSpot = spotA, warmSpot = spotB, topSpot = spotC, rimV = rimL, ambV = ambL, warmPt = ptA, greyPt = ptB, pillarLight = ptC;
function voidLights(){
  spotCfg(spotA, 0xd8e6ff, 30, 1.2); spotCfg(spotB, 0xffb676, 30, 1.2); spotCfg(spotC, 0xe8e4dc, 30, 1.2);
  rimL.position.set(VX, 3, -8); rimL.target.position.set(VX, 1, 0);
