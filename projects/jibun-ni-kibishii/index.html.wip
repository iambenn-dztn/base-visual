    cx.textAlign = 'left'; cx.fillStyle = '#1a1a1a'; cx.font = '700 30px Georgia, serif'; cx.fillText((i+1)+'.  '+words[i], 90, y);
    for(var c=0;c<4;c++){ var x = 560 + c*110; cx.strokeStyle = '#333'; cx.lineWidth = 2; cx.beginPath(); cx.arc(x, y-10, 15, 0, 7); cx.stroke();
      cx.fillStyle = '#333'; cx.font = '22px Georgia, serif'; cx.fillText('ABCD'[c], x+22, y-2);
