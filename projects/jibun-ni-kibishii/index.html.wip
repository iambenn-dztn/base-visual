/* phố trôi ngoài cửa sổ: đoạn dài L lặp lại, vị trí = hàm của quãng đường */
var TOWN_L = 72;
var townMats = [std(0xcfc6b5,0.9), std(0xb9b4ab,0.9), std(0xd9d2c3,0.9), std(0xa89f8f,0.9), std(0xe3ddd0,0.9)];
var roofMats = [std(0x3f4a55,0.7), std(0x5a4038,0.7), std(0x4b4f52,0.7)];
function buildTownSeg(seed){
  var g = new THREE.Group(), r = HFA.mulberry32(seed);
  var road = new THREE.Mesh(new THREE.PlaneGeometry(TOWN_L, 5), std(0x55575a, 0.95)); road.rotation.x = -Math.PI/2; road.position.set(0, -0.45, -3.5); road.receiveShadow = true; g.add(road);
  var walk = new THREE.Mesh(new THREE.PlaneGeometry(TOWN_L, 2.2), std(0x9e9a92, 0.9)); walk.rotation.x = -Math.PI/2; walk.position.set(0, -0.3, -7.0); g.add(walk);
  var curb = box(TOWN_L, 0.15, 0.2, std(0xbdb9b0,0.8)); curb.position.set(0, -0.37, -5.9); g.add(curb);
  var yard = new THREE.Mesh(new THREE.PlaneGeometry(TOWN_L, 30), std(0x6f7a5a, 0.95)); yard.rotation.x = -Math.PI/2; yard.position.set(0, -0.32, -23); g.add(yard);
  var x = -TOWN_L/2 + 2;
  while(x < TOWN_L/2 - 6){
    var w = 6 + r()*5, d = 6 + r()*4, h = 5 + r()*3.5, z = -10.5 - d/2 - r()*3;
    var hb = box(w, h, d, townMats[Math.floor(r()*townMats.length)]); hb.position.set(x + w/2, -0.3 + h/2, z); hb.castShadow = false; g.add(hb);
    var roof = new THREE.Mesh(new THREE.CylinderGeometry(0.01, d*0.62, 1.6, 4, 1), roofMats[Math.floor(r()*roofMats.length)]);
    roof.rotation.y = Math.PI/4; roof.scale.set(w/d*1.0, 1, 1); roof.position.set(x + w/2, -0.3 + h + 0.8, z); g.add(roof);
    for(var wy=1.2; wy<h-1; wy+=2.6){ for(var wx=x+1.2; wx<x+w-1.2; wx+=2.2){ var wn = box(1.1, 1.1, 0.05, std(r()<0.5 ? 0x4c5660 : 0x6c7780, 0.15, 0.3)); wn.position.set(wx+0.5, -0.3+wy+0.5, z + d/2 + 0.02); g.add(wn); } }
    if(r() < 0.55){ var tr = new THREE.Group(); var tk = cyl(0.12, 0.16, 2.6, std(0x4a3a2c,0.9)); tk.position.y = 1.0; tr.add(tk);
      for(var b=0;b<4;b++){ var lf = ball(1.1 + r()*0.6, 1, 0.85, 1, std(r()<0.5 ? 0x4f6b38 : 0x5d7a44, 0.9)); lf.position.set((r()-0.5)*1.2, 2.6 + r()*1.0, (r()-0.5)*1.2); tr.add(lf); }
      tr.position.set(x + w + 0.8, -0.3, -9.2); g.add(tr); }
    var fence = box(w, 1.0, 0.12, std(0xb8b2a6,0.9)); fence.position.set(x + w/2, 0.2, -8.3); g.add(fence);
    x += w + 1.5 + r()*2;
  }
  for(var px=-TOWN_L/2; px<TOWN_L/2; px+=18){ var up = cyl(0.13, 0.15, 10, std(0x8f8c86,0.8)); up.position.set(px + 3, 4.6, -6.2); g.add(up);
    var arm = box(0.12, 0.12, 1.4, std(0x6a6862,0.8)); arm.position.set(px + 3, 8.8, -6.2); g.add(arm); }
  var wire = box(TOWN_L, 0.02, 0.02, std(0x222222,0.8)); wire.position.set(0, 8.7, -5.6); g.add(wire);
  var wire2 = box(TOWN_L, 0.02, 0.02, std(0x222222,0.8)); wire2.position.set(0, 8.4, -6.8); g.add(wire2);
  return g;
}
var townL = new THREE.Group(); bus.add(townL);
var townR = new THREE.Group(); townR.scale.z = -1; bus.add(townR);
var TOWN_SEGS = [];
(function(){ for(var k=-1;k<=1;k++){ var a = buildTownSeg(51); a.userData.k = k; townL.add(a); TOWN_SEGS.push(a);
  var b = buildTownSeg(77); b.userData.k = k; townR.add(b); TOWN_SEGS.push(b); } })();
/* quãng đường xe đi: v0 hằng, giảm tốc khi vào trạm (C62) — nghiệm đóng, không tích luỹ */
var BUS_V = 7.5;
function busDist(t){
  var t1 = CS.C62 - 1.0, t2 = CS.C62 + 5.0;
  var d = BUS_V*t;
  if(t > t1){ var a = Math.min(t, t2) - t1; d -= BUS_V*(a*a/(2*(t2-t1))); }
  if(t > t2) d -= BUS_V*(t - t2)*1.0 - 0;   /* đứng yên sau t2 */
  return d;
}
function busSpeedK(t){ var t1 = CS.C62 - 1.0, t2 = CS.C62 + 5.0; return 1 - clamp((t-t1)/(t2-t1), 0, 1); }
function setTown(t){
  var d = busDist(t), off = -(d % TOWN_L);
  for(var i=0;i<TOWN_SEGS.length;i++){ var s = TOWN_SEGS[i]; s.position.x = off + s.userData.k*TOWN_L; }
}
/* bóng cột điện / cây quét qua mặt (hàm của quãng đường) */
function busShade(t){
  var d = busDist(t);
  var a = ((d + 9) % 18) - 9, b = ((d*0.83 + 5) % 11) - 5.5;
  return 1 - 0.55*Math.exp(-a*a/0.35) - 0.35*Math.exp(-b*b/2.2);
}
