const CUES=[
 {t:2.00,s:"朝の十時ごろでした。"},
 {t:4.09,s:"駅前の小さな喫茶店で、"},
 {t:6.39,s:"古い友人と向かい合って座っていました。"},
 {t:10.37,s:"友人はコーヒーに手をつけないまま、"},
 {t:13.87,s:"ある失敗の話をしていました。もう何日も、"},
 {t:17.98,s:"そのことばかり考えてしまう、"},
 {t:20.86,s:"と言うんです。"},
 {t:22.30,s:"私は、ほとんど考えずに答えていました。"},
 {t:25.97,s:"「誰にでもあることだよ。"},
 {t:28.29,s:"あなたが悪いわけじゃない」。"},
 {t:30.98,s:"言葉を探す必要は、ありませんでした。"},
 {t:34.29,s:"口から、そのまま出てきたんです。"},
 {t:37.23,s:"友人は少し笑って、"},
 {t:38.88,s:"やっとカップを持ち上げました。"},
 {t:41.64,s:"友人の失敗を、"},
 {t:42.94,s:"私は少しも重いとは思いませんでした。"},
 {t:46.28,s:"誰だって、そういう日はあります。"},
 {t:49.25,s:"本気で、そう思っていたんです。"},
 {t:52.04,s:"帰りのバスで、窓の外を見ていたときです。"},
 {t:56.36,s:"ふと、何年も前のことを思い出しました。"},
 {t:60.47,s:"私も、あれとよく似た失敗をしていたんです。"},
 {t:65.01,s:"そして、そのことで、"},
 {t:67.17,s:"今もときどき自分を責めています。"},
 {t:70.63,s:"あのとき自分に向けた言葉は、"},
 {t:73.25,s:"よく覚えています。"},
 {t:74.94,s:"「どうしてあんなことをしたんだ。"},
 {t:77.94,s:"しっかりしろ」。"},
 {t:80.92,s:"誰にでもあることだよ。この一言を、"},
 {t:83.98,s:"私は自分には、"},
 {t:85.24,s:"一度も言ったことがありませんでした。"},
 {t:88.48,s:"友達にはすぐ言えるのに、自分には言えない。"},
 {t:92.25,s:"バスに揺られながら、"},
 {t:94.05,s:"なぜなんだろう、"},
 {t:95.49,s:"と考えはじめました。"},
 {t:97.29,s:"実は、"},
 {t:97.94,s:"このずれを正面から調べた研究者がいます。"},
 {t:102.31,s:"そして答えは、性格の話ではありませんでした。"},
 {t:107.10,s:"今日は、その話をします。"},
 {t:109.72,s:"テキサス大学に、"},
 {t:111.22,s:"クリスティン・ネフという心理学者がいます。"},
 {t:115.17,s:"この人が、"},
 {t:116.11,s:"一つの問いかけを紹介しているんです。"},
 {t:119.49,s:"大事な友達が、あなたにこう言ったとします。"},
 {t:123.90,s:"「私は本当にだめだ。"},
 {t:125.99,s:"どうしてあんなことをしたんだろう」。"},
 {t:129.77,s:"あなたは、何と答えますか。"},
 {t:132.50,s:"多くの人は、"},
 {t:133.75,s:"すぐにやさしい言葉を返すはずです。"},
 {t:137.28,s:"そんなことないよ。"},
 {t:139.16,s:"誰にでもある。"},
 {t:140.61,s:"まずはゆっくり休んで。"},
 {t:142.90,s:"では、同じ一文を、"},
 {t:145.05,s:"自分が自分に言ったときはどうか。"},
 {t:148.88,s:"多くの人は、そのまま受け取ってしまいます。"},
 {t:153.89,s:"そうだ、私はだめなんだ、と。"},
 {t:157.23,s:"同じ一文なのに、"},
 {t:158.96,s:"相手が変わるだけで、"},
 {t:161.12,s:"返事がまるで逆になるんです。"},
 {t:164.14,s:"ネフさんは二千三年に、"},
 {t:166.19,s:"自分へのやさしさを測る物差しを作りました。"},
 {t:170.10,s:"セルフ・コンパッション尺度という、"},
 {t:173.27,s:"質問に答えていく形のものです。"},
 {t:176.07,s:"質問は二十六あります。"},
 {t:178.44,s:"つらいとき、自分に思いやりを向けているか。"},
 {t:182.98,s:"失敗したとき、自分だけがだめだと感じるか。"},
 {t:187.51,s:"そういう問いです。"},
 {t:189.46,s:"この物差しは、"},
 {t:190.74,s:"自分へのやさしさを、"},
 {t:192.56,s:"三つの柱に分けて考えています。"},
 {t:195.29,s:"一つ目は、自分へのやさしさ。"},
 {t:198.45,s:"その反対側にあるのが、自分を裁く心です。"},
 {t:202.96,s:"失敗した自分を、"},
 {t:204.76,s:"厳しい言葉で叩くかどうか、"},
 {t:207.70,s:"ということです。"},
 {t:209.49,s:"二つ目は、"},
 {t:210.67,s:"つらさは誰にでもある、"},
 {t:213.26,s:"という感覚です。"},
 {t:215.15,s:"反対側は、孤立。"},
 {t:217.04,s:"こんな目にあうのは自分だけだ、"},
 {t:220.57,s:"と感じることですね。"},
 {t:222.94,s:"三つ目は、マインドフルネスと呼ばれています。"},
 {t:227.21,s:"少し難しい言葉ですが、"},
 {t:229.34,s:"つらい気持ちを打ち消しもせず、"},
 {t:232.26,s:"飲みこまれもしない、"},
 {t:234.20,s:"ということです。"},
 {t:235.75,s:"その反対側が、気持ちとの一体化です。"},
 {t:239.23,s:"「失敗した」が、"},
 {t:240.78,s:"いつのまにか「私は失敗そのものだ」に"},
 {t:244.26,s:"すり替わってしまう状態なんです。"},
 {t:247.36,s:"あの喫茶店で私が友人に言ったことを、"},
 {t:251.08,s:"私なりに並べ直してみます。"},
 {t:253.77,s:"「誰にでもある」は、二つ目の柱でした。"},
 {t:257.69,s:"「あなたが悪いわけじゃない」は、"},
 {t:261.00,s:"一つ目と三つ目です。失敗と、"},
 {t:263.89,s:"その人そのものを、"},
 {t:265.75,s:"分けて見ていたわけです。"},
 {t:268.23,s:"つまり私は、三つの柱を、"},
 {t:270.47,s:"友人に向かってはちゃんと使えていたんです。"},
 {t:274.40,s:"自分に向かってだけ、"},
 {t:276.27,s:"一本も立っていませんでした。"},
 {t:280.05,s:"もう一つ、気になる研究があります。"},
 {t:283.29,s:"ネフさんとポミエさんが"},
 {t:285.38,s:"二千十三年に出したもので、"},
 {t:287.85,s:"九百人あまりを、"},
 {t:289.37,s:"三つのグループに分けて調べています。"},
 {t:292.80,s:"大学生と、"},
 {t:293.77,s:"地域で暮らす大人と、"},
 {t:295.70,s:"瞑想を続けている人たち。"},
 {t:298.02,s:"自分へのやさしさと、"},
 {t:299.95,s:"人への思いやりが、"},
 {t:301.69,s:"どれくらい結びついているかを見たんです。"},
 {t:305.55,s:"大学生では、"},
 {t:306.64,s:"人への思いやりと、"},
 {t:308.27,s:"自分へのやさしさのあいだに、"},
 {t:310.82,s:"はっきりしたつながりが出ませんでした。"},
 {t:314.27,s:"大人と、"},
 {t:314.99,s:"瞑想をする人たちでは、"},
 {t:316.99,s:"つながりが見えました。"},
 {t:318.99,s:"人にやさしくできることと、"},
 {t:321.48,s:"自分にやさしくできることは、"},
 {t:324.16,s:"同じ一つの力ではない。少なくとも、"},
 {t:327.41,s:"自動でついてくるものではない、"},
 {t:330.28,s:"ということなんです。"},
 {t:332.19,s:"正直に言うと、"},
 {t:333.56,s:"これを読んで少しほっとしました。"},
 {t:336.70,s:"人にだけやさしい自分が、"},
 {t:339.05,s:"特別にゆがんでいるわけではなかったんです。"},
 {t:343.16,s:"では、"},
 {t:343.82,s:"なぜ自分にだけ、"},
 {t:345.58,s:"厳しい声が出てくるのか。"},
 {t:348.23,s:"ここからが、いちばん深いところです。"},
 {t:352.20,s:"ネフさんは、こう説明しています。"},
 {t:355.72,s:"人は危ないと感じると、戦うか、逃げるか、"},
 {t:360.13,s:"固まるか。"},
 {t:361.23,s:"体が、身を守る構えに入ります。"},
 {t:364.54,s:"友達が失敗したとき、"},
 {t:366.61,s:"私たち自身は脅かされていません。"},
 {t:369.92,s:"だから、構えに入らずにすみます。"},
 {t:373.23,s:"そのかわりに、別の仕組みが動くんです。"},
 {t:377.16,s:"弱っている仲間を気づかって、"},
 {t:380.03,s:"そばに寄りそう仕組みです。"},
 {t:382.70,s:"家族や仲間が互いを守るために育ってきたもの、"},
 {t:387.21,s:"とネフさんは言います。"},
 {t:389.46,s:"ところが、"},
 {t:390.60,s:"失敗したのが自分だと、"},
 {t:393.10,s:"話が変わります。"},
 {t:394.92,s:"脅かされているのは、自分そのものです。"},
 {t:399.25,s:"体は、身を守る構えのほうに入ります。"},
 {t:403.35,s:"そして、その構えが、"},
 {t:405.48,s:"外ではなく内側に向かうんです。"},
 {t:408.68,s:"自分を叩いて、"},
 {t:410.17,s:"しゃんとさせて、"},
 {t:411.88,s:"二度と間違えないようにしようとする。"},
 {t:415.73,s:"つまり、"},
 {t:416.42,s:"あの厳しい声は、"},
 {t:417.79,s:"意地悪で出ているのではありません。"},
 {t:420.71,s:"なんというか、見張りのようなものなんです。"},
 {t:424.32,s:"もう危ない目にあわないように、身構えている。"},
 {t:429.26,s:"この違いを、"},
 {t:430.35,s:"脳の中で見ようとした研究があります。"},
 {t:433.61,s:"二千十年に、"},
 {t:434.70,s:"イギリスのチームが『ニューロイメージ』と"},
 {t:438.33,s:"いう専門誌に出したものです。"},
 {t:440.87,s:"参加者は装置の中で、失敗の場面を読みます。"},
 {t:444.87,s:"そして、"},
 {t:445.63,s:"自分を責めるつもりで考えたり、"},
 {t:448.48,s:"励ますつもりで考えたりします。"},
 {t:451.34,s:"自分を責めているとき、"},
 {t:453.22,s:"よく動いていたのは、"},
 {t:454.93,s:"間違いを見つけて処理したり、"},
 {t:457.32,s:"行動にブレーキをかけたりする働きと、"},
 {t:460.39,s:"結びつけられてきた場所でした。"},
 {t:462.95,s:"自分を励ましているときは、"},
 {t:465.28,s:"別の場所が動いていました。"},
 {t:467.62,s:"研究チームは、"},
 {t:468.87,s:"人に思いやりや共感を向けるときと、"},
 {t:471.93,s:"よく似た場所だと述べています。"},
 {t:474.62,s:"正直なところ、"},
 {t:476.04,s:"私にとっては、"},
 {t:477.45,s:"ここがいちばん大きな発見でした。"},
 {t:480.69,s:"自分を励ますとき、脳は、"},
 {t:483.12,s:"人を思いやるときの道具を使っているらしい、"},
 {t:487.38,s:"ということなんです。"},
 {t:489.40,s:"ただ、"},
 {t:489.96,s:"脳の場所の話は、"},
 {t:491.46,s:"少し割り引いて聞いておきたいと思っています。"},
 {t:495.57,s:"ある場所が動いたことと、"},
 {t:497.81,s:"心の中で起きていることを、"},
 {t:500.24,s:"そのまま同じにはできませんから。"},
 {t:503.23,s:"それでも、"},
 {t:504.38,s:"ネフさんの説明と、この研究は、"},
 {t:507.84,s:"同じ方向を指しています。"},
 {t:510.61,s:"やさしくする力は、もうあるんです。"},
 {t:514.52,s:"ただ、外にしか向いていない。"},
 {t:519.24,s:"では、"},
 {t:519.86,s:"その向きを自分に変えることに、"},
 {t:522.98,s:"なぜこんなに抵抗があるのか。"},
 {t:525.89,s:"心のどこかで、こう思っているからです。"},
 {t:529.85,s:"自分に甘くしたら、だめになる。"},
 {t:532.97,s:"厳しくしていないと、怠けて、"},
 {t:535.88,s:"同じ失敗をくり返す。"},
 {t:537.96,s:"実は私も、ずっとそう思ってきました。"},
 {t:541.69,s:"この思いこみを、"},
 {t:543.12,s:"実験で確かめた人たちがいます。"},
 {t:545.81,s:"カリフォルニア大学バークレー校の、"},
 {t:548.85,s:"ブレインズさんとチェンさんです。"},
 {t:551.71,s:"二千十二年の報告です。"},
 {t:553.68,s:"参加者は、まず難しい単語のテストを受けます。"},
 {t:558.12,s:"ほとんどの人が、うまくできません。"},
 {t:561.56,s:"わざと、そう作ってあるんです。"},
 {t:564.59,s:"そのあと、"},
 {t:565.55,s:"ある人たちにだけ、"},
 {t:567.28,s:"自分を思いやる言葉を渡しました。"},
 {t:570.36,s:"こういうテストでは誰でもつまずく、"},
 {t:573.62,s:"自分に厳しくしすぎないで、"},
 {t:576.12,s:"という言葉です。"},
 {t:577.65,s:"それから、"},
 {t:578.55,s:"もう一度テストがあると伝えて、"},
 {t:581.26,s:"勉強する時間をとってもらいます。"},
 {t:584.14,s:"思いやる言葉を受けた人たちのほうが、"},
 {t:587.39,s:"長く勉強したんです。"},
 {t:589.19,s:"甘くしたら怠ける、"},
 {t:590.83,s:"という思いこみとは、"},
 {t:592.64,s:"逆の結果だったんです。"},
 {t:594.65,s:"ネフさん自身の二千三年の調査でも、"},
 {t:597.78,s:"自分にやさしい人の、"},
 {t:599.62,s:"自分に求める基準は低くありませんでした。"},
 {t:603.30,s:"違っていたのは、"},
 {t:604.77,s:"届かなかったときに"},
 {t:606.43,s:"追いつめすぎないことのほうでした。"},
 {t:609.56,s:"ここで、"},
 {t:610.32,s:"ネフさんがいつも分けておく言葉が、"},
 {t:613.58,s:"二つあります。"},
 {t:614.91,s:"一つは、自分を甘やかすこと。"},
 {t:617.59,s:"その場は楽でも、"},
 {t:619.12,s:"あとで自分のために"},
 {t:620.84,s:"ならないことをすることです。"},
 {t:623.52,s:"友達が落ちこんでいたら、"},
 {t:625.89,s:"何もしなくていいよ、"},
 {t:627.87,s:"とは言いませんね。"},
 {t:629.65,s:"まず休んで、それからまたやってみよう。"},
 {t:633.41,s:"そう言うはずです。"},
 {t:635.19,s:"もう一つは、自分をあわれむこと。"},
 {t:638.20,s:"自分の苦しみだけを見て、"},
 {t:640.46,s:"ほかの人も同じように苦しんで"},
 {t:643.09,s:"いることを忘れてしまう状態です。"},
 {t:646.10,s:"二つ目の柱は、"},
 {t:647.41,s:"ちょうどその反対にあたるわけです。"},
 {t:650.60,s:"二千十六年には、"},
 {t:652.21,s:"ウォレンさん、"},
 {t:653.63,s:"スメーツさん、"},
 {t:655.04,s:"ネフさんの三人が、"},
 {t:656.85,s:"精神科のお医者さん向けの専門誌に"},
 {t:660.08,s:"論文をまとめています。"},
 {t:662.30,s:"自分を厳しく責める傾向は、"},
 {t:664.92,s:"うつや不安など、"},
 {t:666.54,s:"さまざまな心の不調と重なりやすい。"},
 {t:669.97,s:"自分へのやさしさは、"},
 {t:671.98,s:"立ち直る力と結びついていた、"},
 {t:674.81,s:"という整理です。"},
 {t:677.58,s:"ただ、わかっていないこともあります。"},
 {t:680.85,s:"こうした研究の多くは、"},
 {t:682.86,s:"並んで起きることを見たものです。"},
 {t:685.77,s:"どちらが原因なのかは、"},
 {t:687.77,s:"まだ議論が続いています。"},
 {t:689.96,s:"それから、"},
 {t:690.97,s:"バークレーの実験は、"},
 {t:692.99,s:"大学生を相手にした短いものです。"},
 {t:696.23,s:"何十年も自分を責めてきた人に、"},
 {t:699.26,s:"同じことが起きるのかどうか。"},
 {t:702.10,s:"そこは、この実験だけではわかりません。"},
 {t:705.94,s:"バスが、家の近くの停留所に近づいていました。"},
 {t:710.50,s:"窓の外は、さっきと同じ、朝の町です。私は、"},
 {t:714.85,s:"何年も前のあの失敗を、"},
 {t:717.12,s:"もう一度思い出してみました。ただ今度は、"},
 {t:721.27,s:"ネフさんの問いかけの形にしてみたんです。"},
 {t:725.41,s:"今朝の友人が、もし私のあの話をしていたら。"},
 {t:729.27,s:"「どうしてあんなことをしたんだろう」と、"},
 {t:732.95,s:"うつむいていたら。"},
 {t:734.61,s:"私は、何と言うだろう。"},
 {t:736.63,s:"答えは、すぐに出ました。"},
 {t:739.05,s:"今朝、喫茶店で言ったのと、同じ言葉です。"},
 {t:743.07,s:"考える必要は、やっぱりありませんでした。"},
 {t:747.10,s:"新しいことを覚えたわけでは、ないんです。"},
 {t:751.17,s:"やり方は、もう知っていました。"},
 {t:754.22,s:"今朝も、ちゃんと使っていました。"},
 {t:757.47,s:"向きが、外にしか向いていなかっただけでした。"},
 {t:763.42,s:"誰にでもあることだよ。"},
 {t:765.54,s:"バスを降りる前に、小さな声で、"},
 {t:768.43,s:"その言葉をはじめて"},
 {t:770.17,s:"自分のほうへ向けてみました。"},
 {t:772.87,s:"見張りの声が、消えたわけではありません。"},
 {t:776.06,s:"それでも、"},
 {t:776.86,s:"私を守ろうとして鳴って"},
 {t:778.61,s:"いた声だと知ってから聞くと、"},
 {t:780.85,s:"少し違って聞こえました。"},
 {t:782.77,s:"一つだけ、添えておきます。"},
 {t:785.24,s:"自分へのやさしさは、"},
 {t:787.15,s:"よく調べられた心の道具の一つで、"},
 {t:790.19,s:"何でも治す方法ではありません。"},
 {t:793.05,s:"自分を責める気持ちが長く続いて、"},
 {t:796.10,s:"眠りや食事にまで響いているなら、"},
 {t:799.14,s:"それは心の専門家に相談していいことです。"},
 {t:804.91,s:"友達にかけるあの言葉は、"},
 {t:807.25,s:"友達のためだけのものではありませんでした。"},
 {t:811.34,s:"人を思いやるときの道具は、"},
 {t:813.88,s:"自分に向けても働くらしい。"},
 {t:816.41,s:"研究が見せてくれたのは、そういうことでした。"}
];

/* =========================================================================
 * VÒNG CHÍNH — renderAtTime(t) TẤT ĐỊNH THUẦN
 * ========================================================================= */
function renderAtTime(t){
  /* LEADTAIL:APPLIED — dịch timeline sang phải 2s cho intro lặng.
     Cảnh vẫn dùng mốc gốc của timing.json; chỉ tới muộn hơn 2s. */
  var _tReal = t;                    /* thời gian THẬT của video, cho phụ đề */
  t = Math.max(0, t - 2);   /* thời gian CẢNH, đã trừ intro */

  t = clamp(t, 0, SCENE_END);
  UT.value = t;
  resetFrame();
  var key = sceneAt(t);
  SH[key](loc(t, key), t);
  /* nhúng tối ngắn ở ranh giới shot khi đổi bộ cảnh */
  var dip = FX.dip, idx = SCENE_KEYS.indexOf(key);
  var a = SC[key][0], b = SC[key][1];
  var prev = SCENE_KEYS[idx-1], next = SCENE_KEYS[idx+1];
  if(prev && (SET_END[prev] || SET_OF[prev]) !== SET_OF[key]) dip = Math.min(dip, smooth((t - a)/0.30)*0.9 + 0.1);
  if(next && (SET_END[key] || SET_OF[key]) !== SET_OF[next]) dip = Math.min(dip, smooth((b - t)/0.30)*0.9 + 0.1);
  lens.uniforms.uFade.value = smooth(t/1.4) * dip;
  lens.uniforms.uFlash.value = FX.flash;
  lens.uniforms.uT.value = t;
  grade.uniforms.uSat.value = FX.sat; grade.uniforms.uMul.value.set(FX.mul[0], FX.mul[1], FX.mul[2]);
  camera.updateProjectionMatrix();
  USCALE.value = H/(2*Math.tan(camera.fov*Math.PI/360));
  bg.position.copy(camera.position);

  HFA.applySubtitle(subEl, CUES, _tReal);
  /* LEADTAIL:APPLIED — màn hình đen 5s cuối: nhạc chạy tiếp, hình tắt dần. */
  (function(){
    var ob = document.getElementById('outro-black');
    if(!ob) return;
    var f = (_tReal - 820.76) / 1.2;         /* 1.2s chuyển sang đen */
    ob.style.opacity = String(Math.max(0, Math.min(1, f)));
  })();
  HFA.applyChapter(chapEl, CHAPTERS, _tReal, 5.5);
  /* frame đen hoàn toàn (intro lặng) → chỉ xoá màn hình đen, KHÔNG chạy composer:
   * nạp trang không phải biên dịch shader/bloom (snapshot GL phần mềm giới hạn 10s).
   * Vẫn tất định: cùng t → cùng frame đen. */
  if(lens.uniforms.uFade.value <= 0.002 && FX.flash <= 0.002){
    renderer.setRenderTarget(null); renderer.setClearColor(0x000000, 1); renderer.clear(true, true, true);
    return;
  }
  composer.render();
}

/* ⚠ Dòng đăng ký phải nằm NGUYÊN DẠNG trong file này — StaticGuard quét VĂN BẢN.
 * Khoá trùng ĐÚNG data-composition-id của div gốc. */
window.__timelines = window.__timelines || {};
window.__timelines["jibun-ni-kibishii"] = HFA.makeTimeline("jibun-ni-kibishii", TOTAL, renderAtTime);
</script>
</body>
</html>
