<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1920, height=1080">
<title>友達には言えるのに、自分には言えないのはなぜか｜研究の答え — HyperFrames</title>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>
<style>
  /* Font Nhật NHÚNG — "Segoe UI" KHÔNG có glyph CJK. Khai ở đây + #sub/#chap + textTex(). */
  @font-face{font-family:'BIZ UDPGothic';src:url('assets/fonts/BIZUDPGothic-Bold.ttf') format('truetype');font-weight:700;font-display:block;}
  @font-face{font-family:'BIZ UDPGothic';src:url('assets/fonts/BIZUDPGothic-Regular.ttf') format('truetype');font-weight:400;font-display:block;}
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{width:1920px;height:1080px;overflow:hidden;background:#000;font-family:'BIZ UDPGothic',sans-serif;}
  #root{position:relative;width:1920px;height:1080px;background:#000;}
  #c{position:absolute;inset:0;display:block;z-index:0;}
  /* nhãn chương GÓC TRÊN-TRÁI, tách khỏi phụ đề ở đáy (ràng buộc A), lề >= 80px (ràng buộc C) */
  #chap{position:absolute;left:4.6%;top:7%;z-index:18;color:#F4EFE6;font-family:'BIZ UDPGothic',sans-serif;font-size:34px;font-weight:700;letter-spacing:6px;opacity:0;text-shadow:0 2px 18px rgba(0,0,0,.96),0 0 3px rgba(0,0,0,.9);white-space:nowrap;}
  #sub{position:absolute;left:50%;bottom:7.4%;transform:translateX(-50%);z-index:20;
    text-align:center;color:#f4f2ee;font-family:'BIZ UDPGothic',sans-serif;
    font-size:56px;font-weight:700;line-height:1.35;
    text-shadow:0 3px 20px rgba(0,0,0,.97),0 0 4px rgba(0,0,0,.97);
    display:table;width:auto;max-width:90%;white-space:nowrap;margin-left:auto;margin-right:auto;
    padding:.26em 1.15em;border-radius:10px;
    background:radial-gradient(ellipse 100% 96% at 50% 50%,rgba(0,0,0,.66) 0%,rgba(0,0,0,.58) 42%,rgba(0,0,0,.28) 76%,rgba(0,0,0,0) 100%);}
  #err{position:absolute;left:12px;top:12px;z-index:99;color:#ff9090;background:rgba(0,0,0,.82);padding:8px 10px;font:12px/1.5 monospace;max-width:90%;white-space:pre-wrap;border-radius:8px;display:none;}
</style>
</head>
<body>
<div id="root" data-composition-id="jibun-ni-kibishii" data-start="0" data-duration="825.76" data-width="1920" data-height="1080">
  <canvas id="c" class="clip" data-start="0.01" data-duration="825.76" data-track-index="0"></canvas>
  <audio id="narr" class="clip" data-start="0" data-duration="825.76" data-track-index="1" src="projects/jibun-ni-kibishii/voice/narration_mixed.mp3"></audio>
  <div id="chap" data-layout-allow-occlusion=""></div>
  <div id="sub" data-layout-allow-occlusion=""></div>
  <div id="err"></div>
<div id="outro-black" style="position:absolute;inset:0;z-index:90;background:#000;opacity:0;pointer-events:none"></div>
</div>
<script>
/* ===== HFA:BEGIN — sinh tự động bởi scripts/inject-lib.mjs, ĐỪNG SỬA TAY ===== */
/* ============================================================================
 * hf-astro.js — bộ khung dùng chung cho composition Du Mục Vũ Trụ
 *
 * Trích từ các tập ĐÃ RENDER VÀ VERIFY (01–07). Trước khi có file này, mỗi tập
 * tự dựng lại cùng một đoạn code (mulberry32, ACESFilmic, composer+bloom, lens
 * pass, starfield, tra phụ đề, driver timeline) — nên bug đã sửa ở tập này lại
 * tái xuất ở tập sau. Dùng file này thay vì chép tay.
 *
 * CÁCH DÙNG: KHÔNG nạp bằng thẻ script ngoài. Preview/render server của HyperFrames
 *      không phục vụ file .js tuỳ ý trong project — nó trả về SPA shell HTML cho
 *      đường dẫn đó, browser parse "doctype html" thành lỗi cú pháp và tập chết
 *      (đã kiểm chứng: curl -D- trả về 200 text/html, 593 byte). Composition phải
 *      TỰ CHỨA. Nhúng bằng:
 *
 *          node scripts/inject-lib.mjs --html index.html
 *
 *      Lệnh này dán nội dung file này vào đầu khối code của tập, giữa hai mốc
 *      HFA:BEGIN / HFA:END. Chạy lại được nhiều lần. Định nghĩa một global: HFA.
 *      Yêu cầu three.min.js + EffectComposer/RenderPass/ShaderPass/UnrealBloomPass
 *      đã nạp trước đó.
 *
 * LUẬT TẤT ĐỊNH: file này không dùng Date.now / performance.now / Math.random /
 * requestAnimationFrame / setTimeout. Mọi thứ là hàm thuần của t hoặc của seed.
 * ========================================================================== */
(function (global) {
  'use strict';

  var HFA = {};

  /* ---- PRNG có seed ------------------------------------------------------
   * Math.random() bị cấm (render phải tất định). Mỗi cụm vật thể dùng MỘT
   * seed riêng — dùng chung một chuỗi cho hai cụm thì thêm/bớt hạt ở cụm này
   * sẽ xê dịch layout cụm kia.
   */
  HFA.mulberry32 = function (a) {
    return function () {
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      var t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  };

  /* ---- helper toán -------------------------------------------------------- */
  HFA.clamp = function (x, a, b) { return Math.min(b, Math.max(a, x)); };

  HFA.smooth = function (x) { x = HFA.clamp(x, 0, 1); return x * x * (3 - 2 * x); };

  /** Bao lồi mềm: 0 ngoài [a,b], lên/xuống mượt trong dải f giây ở hai mép.
   *
   * Hoà chéo đặt ĐỐI XỨNG quanh mốc cảnh: cảnh chỉ nhú lên từ a-f/2 và tắt hẳn
   * ở b+f/2, nên hai cảnh liền nhau chồng đúng f giây và tổng trọng số luôn = 1
   * (không chớp đen). Bản cũ dùng a-f .. a+f với mẫu số 2f: cảnh mới hiện sớm
   * cả f giây trước mốc và cảnh cũ nán lại thêm f giây sau mốc, tổng thời gian
   * dính hình là 2f — chuyển cảnh nhoè, hình cue trước còn đọng khi lời đã sang
   * ý mới. Xem tập mat-trang t=167,33s (Trái Đất + Sao Hoả + Mặt Trăng chồng nhau).
   */
  HFA.band = function (t, a, b, f) {
    f = f || 0.8;
    var h = f * 0.5;
    if (t < a - h || t > b + h) return 0;
    var up = HFA.smooth((t - (a - h)) / f);
    var dn = HFA.smooth(((b + h) - t) / f);
    return Math.min(1, Math.min(up, dn));
  };

  /* ---- cửa sổ cảnh --------------------------------------------------------
   * SC = {A:[start,end], B:[...], ...} theo GIÂY THẬT (lấy từ timing.json cue.start).
   * Trả về loc(t,k) ∈ [0,1] (tiến độ trong cảnh) và inSc(t,k).
   */
  HFA.scenes = function (SC) {
    return {
      SC: SC,
      loc: function (t, k) {
        var w = SC[k];
        return Math.min(1, Math.max(0, (t - w[0]) / (w[1] - w[0])));
      },
      inSc: function (t, k) { var w = SC[k]; return t >= w[0] && t < w[1]; }
    };
  };

  /* ---- shader lens — PASS CUỐI, kiêm luôn tone mapping + mã hoá sRGB --------
   *
   * ⚠ VÌ SAO PASS NÀY PHẢI TỰ TONE MAP:
   * three.js chỉ chèn ACES + sRGB vào shader của VẬT LIỆU nó tự dựng. Một
   * ShaderMaterial thô trong ShaderPass KHÔNG được chèn — nên khi pass cuối ghi
   * ra màn hình, ảnh chưa hề được mã hoá sRGB.
   * Đo thật (xám #808080, r128): vẽ thẳng = 197, qua EffectComposer = 143.
   * Sai lệch đó là lý do các tập 01–07 ra tối hơn và sai gamma.
   *
   * Vì vậy chuỗi mới là: cảnh vẽ TUYẾN TÍNH vào target HDR (không tone map)
   * → bloom ăn giá trị HDR thật → pass này mới ACES + sRGB ở bước cuối.
   * Bloom đứng TRƯỚC tone mapping mới đúng thứ tự điện ảnh: vùng cực sáng
   * (quang cầu, đĩa bồi tụ) chưa bị nén ngọn nên quầng sáng nở tự nhiên.
   *
   * Thứ tự trong shader: CA → vignette → fade (đều ở TUYẾN TÍNH, vì chúng là
   * phơi sáng) → ACES → sRGB → grain + flash (ở không gian hiển thị, vì grain
   * phim và chớp trắng là hiện tượng của bản in, không phải của ánh sáng).
   * Grain seed theo t, KHÔNG theo đồng hồ — cùng t phải cho cùng frame.
   */
  HFA.LensShader = {
    uniforms: {
      tDiffuse: { value: null }, uT: { value: 0 }, uVig: { value: 0.34 },
      uCA: { value: 0.0015 }, uGrain: { value: 0.045 },
      uFade: { value: 1.0 }, uFlash: { value: 0.0 },
      uExposure: { value: 1.02 }, uToneMap: { value: 1.0 }
    },
    vertexShader:
      'varying vec2 vUv;void main(){vUv=uv;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}',
    fragmentShader: [
      'varying vec2 vUv;uniform sampler2D tDiffuse;',
      'uniform float uT,uVig,uCA,uGrain,uFade,uFlash,uExposure,uToneMap;',
      'float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}',
      // ACES — SAO CHÉP ĐÚNG bản three.js r128 dùng cho ACESFilmicToneMapping
      // (ma trận vào/ra + RRTAndODTFit + tiền tỉ lệ /0.6). KHÔNG dùng xấp xỉ
      // Narkowicz: nó sáng hơn ~4% ở vùng trung, đo được (206 vs 197 trên xám
      // giữa) và sẽ lệch với mọi tài liệu/preset tính theo three.js.
      'vec3 rrt(vec3 v){vec3 a=v*(v+0.0245786)-0.000090537;',
      '  vec3 b=v*(0.983729*v+0.4329510)+0.238081;return a/b;}',
      'vec3 aces(vec3 color){',
      '  const mat3 mIn=mat3(0.59719,0.07600,0.02840, 0.35458,0.90834,0.13383, 0.04823,0.01566,0.83777);',
      '  const mat3 mOut=mat3(1.60475,-0.10208,-0.00327, -0.53108,1.10813,-0.07276, -0.07367,-0.00605,1.07602);',
      '  color/=0.6;',
      '  color=mIn*color; color=rrt(color); color=mOut*color;',
      '  return clamp(color,0.0,1.0);}',
      // tuyến tính → sRGB, đúng công thức chuẩn (không phải pow(1/2.2) cho nhanh)
      'vec3 toSRGB(vec3 c){c=max(c,vec3(0.0));',
      '  return mix(c*12.92,1.055*pow(c,vec3(1.0/2.4))-0.055,step(vec3(0.0031308),c));}',
      'void main(){',
      '  vec2 d=vUv-0.5;float r=dot(d,d);',
      '  vec2 off=d*uCA*(1.0+r*2.2);',
      '  vec3 col;',
      '  col.r=texture2D(tDiffuse,vUv+off).r;',
      '  col.g=texture2D(tDiffuse,vUv).g;',
      '  col.b=texture2D(tDiffuse,vUv-off).b;',
      // --- còn ở TUYẾN TÍNH: vignette + fade là phơi sáng ---
      '  float vig=smoothstep(1.02,uVig,r*2.0);',
      '  col*=mix(1.0,vig,0.85);',
      '  col*=uFade;',
      // --- tone map + mã hoá hiển thị ---
      '  col=mix(col*uExposure,aces(col*uExposure),uToneMap);',
      '  col=toSRGB(col);',
      // --- không gian hiển thị: grain + chớp trắng ---
      '  float g=h(vUv*vec2(1920.0,1080.0)+fract(uT)*97.3)-0.5;',
      '  col+=g*uGrain;',
      '  col=mix(col,vec3(1.0,0.98,0.94),uFlash);',
      '  gl_FragColor=vec4(clamp(col,0.0,1.0),1.0);',
      '}'
    ].join('\n')
  };

  /* ---- dựng sân khấu ------------------------------------------------------
   * Trả về {renderer, scene, camera, composer, bloom, lens, W, H, loadTex}.
   * Ánh sáng mặc định (amb/key/rim) tắt được bằng opt.lights=false.
   */
  HFA.createStage = function (opt) {
    opt = opt || {};
    var W = opt.width || 1920, H = opt.height || 1080;
    var canvas = typeof opt.canvas === 'string'
      ? document.getElementById(opt.canvas)
      : (opt.canvas || document.getElementById('c'));

    var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: false });
    renderer.setPixelRatio(1);
    renderer.setSize(W, H);
    renderer.setClearColor(opt.clearColor != null ? opt.clearColor : 0x08080a, 1);

    // Tone mapping + sRGB CỐ Ý tắt ở đây: cả hai được làm ở pass lens cuối cùng.
    // Bật ở đây thì cảnh bị nén dải TRƯỚC khi bloom nhìn thấy (quầng sáng bẹt),
    // rồi lại không được mã hoá sRGB lúc ghi ra màn hình (xem chú thích LensShader).
    renderer.toneMapping = THREE.NoToneMapping;
    renderer.outputEncoding = THREE.LinearEncoding;

    var scene = new THREE.Scene();
    var camera = new THREE.PerspectiveCamera(
      opt.fov || 46, W / H, opt.near || 0.05, opt.far || 60000);
    camera.position.set(0, 0, 60);

    if (opt.lights !== false) {
      var amb = new THREE.AmbientLight(0x232838, 0.85); scene.add(amb);
      var key = new THREE.DirectionalLight(0xffe8d2, 1.05); key.position.set(6, 4, 8); scene.add(key);
      var rim = new THREE.DirectionalLight(0x6f9cff, 0.4); rim.position.set(-8, -3, -6); scene.add(rim);
      scene.userData.lights = { amb: amb, key: key, rim: rim };
    }

    /* --- render target: MSAA + HDR -------------------------------------------
     * `antialias:true` ở trên CHỈ tác dụng lên framebuffer mặc định. Đi qua
     * EffectComposer là vẽ vào target offscreen, và target đó KHÔNG multisample
     * theo mặc định — nên cờ antialias thành vô nghĩa và mọi rìa bị răng cưa.
     * WebGLMultisampleRenderTarget (có từ r111) khôi phục MSAA thật.
     * HalfFloat giữ giá trị >1.0 để bloom ăn được highlight HDR thật.
     */
    var samples = opt.msaa != null ? opt.msaa : 4;
    var rtOpts = {
      minFilter: THREE.LinearFilter,
      magFilter: THREE.LinearFilter,
      format: THREE.RGBAFormat,
      type: opt.hdr === false ? THREE.UnsignedByteType : THREE.HalfFloatType
    };
    var rt;
    if (samples > 0 && typeof THREE.WebGLMultisampleRenderTarget === 'function') {
      rt = new THREE.WebGLMultisampleRenderTarget(W, H, rtOpts);
      rt.samples = samples;
    } else {
      rt = new THREE.WebGLRenderTarget(W, H, rtOpts);
      if (samples > 0) console.warn('[hf-astro] không có WebGLMultisampleRenderTarget — chạy không MSAA.');
    }

    var composer = new THREE.EffectComposer(renderer, rt);
    composer.addPass(new THREE.RenderPass(scene, camera));

    /* Ngưỡng bloom: cảnh giờ là HDR TUYẾN TÍNH, không còn bị nén về [0,1] như
     * trước. Highlight thật nằm TRÊN 1.0, nên ngưỡng cũ 0.62 (chỉnh cho ảnh đã
     * tone map) sẽ làm cả những vùng sáng vừa cũng loé. Mặc định nâng lên 1.0. */
    var bloom = new THREE.UnrealBloomPass(
      new THREE.Vector2(W, H),
      opt.bloomStrength != null ? opt.bloomStrength : 0.78,
      opt.bloomRadius != null ? opt.bloomRadius : 0.7,
      opt.bloomThreshold != null ? opt.bloomThreshold : (opt.hdr === false ? 0.62 : 1.0));
    composer.addPass(bloom);

    // Bản sao uniforms để hai stage không dùng chung state.
    var lensDef = {
      uniforms: THREE.UniformsUtils.clone(HFA.LensShader.uniforms),
      vertexShader: HFA.LensShader.vertexShader,
      fragmentShader: HFA.LensShader.fragmentShader
    };
    var lens = new THREE.ShaderPass(lensDef);
    lens.renderToScreen = true;
    lens.uniforms.uExposure.value = opt.exposure != null ? opt.exposure : 1.02;
    composer.addPass(lens);

    var texLoader = new THREE.TextureLoader();
    texLoader.setCrossOrigin('anonymous');
    function loadTex(path, enc) {
      var tx = texLoader.load(path);
      if (enc) tx.encoding = enc;
      tx.anisotropy = renderer.capabilities.getMaxAnisotropy();
      return tx;
    }

    var stage = {
      renderer: renderer, scene: scene, camera: camera,
      composer: composer, bloom: bloom, lens: lens, rt: rt,
      W: W, H: H, loadTex: loadTex,
      clearColor: opt.clearColor != null ? opt.clearColor : 0x08080a
    };

    /* --- environment map (IBL) ----------------------------------------------
     * MeshStandardMaterial là vật liệu PBR: nó phản xạ MÔI TRƯỜNG. Không có
     * envMap thì kim loại và bề mặt bóng mất gần hết thông tin phản xạ, chỉ còn
     * highlight từ đèn → ra chất nhựa sơn. (Tập "Vàng" là ví dụ rõ nhất.)
     * Dựng một bầu trời tối có vài đốm sáng, nướng qua PMREM MỘT LẦN lúc khởi
     * tạo → tất định, không phụ thuộc t, mọi MeshStandardMaterial hưởng ngay
     * qua scene.environment mà không phải sửa từng vật liệu.
     */
    if (opt.environment !== false) {
      stage.environment = HFA.buildEnvironment(renderer, scene, opt.environmentSeed || 4242);
    }

    return stage;
  };

  /** Bầu trời sao mờ nướng thành envMap PMREM. Trả về texture (đã gán scene.environment). */
  HFA.buildEnvironment = function (renderer, scene, seed) {
    var pr = HFA.mulberry32(seed);
    var cv = document.createElement('canvas');
    cv.width = 512; cv.height = 256;
    var cx = cv.getContext('2d');

    // nền: gradient rất tối, hơi lạnh ở dưới, ấm nhạt ở trên (ánh sáng thiên hà)
    var gr = cx.createLinearGradient(0, 0, 0, 256);
    gr.addColorStop(0, '#0a0d16'); gr.addColorStop(0.5, '#070910'); gr.addColorStop(1, '#05060b');
    cx.fillStyle = gr; cx.fillRect(0, 0, 512, 256);

    // dải Ngân Hà mờ vắt ngang → cho phản xạ có hướng, tránh env phẳng lì
    var bandGr = cx.createLinearGradient(0, 96, 0, 160);
    bandGr.addColorStop(0, 'rgba(70,80,110,0)');
    bandGr.addColorStop(0.5, 'rgba(120,130,165,0.30)');
    bandGr.addColorStop(1, 'rgba(70,80,110,0)');
    cx.fillStyle = bandGr; cx.fillRect(0, 96, 512, 64);

    // vài nguồn sáng nhỏ để kim loại có điểm loé
    for (var i = 0; i < 220; i++) {
      var x = pr() * 512, y = pr() * 256, s = pr() < 0.06 ? 2.2 : 1.0;
      var b = 0.35 + pr() * 0.65;
      cx.fillStyle = 'rgba(255,252,245,' + b.toFixed(3) + ')';
      cx.fillRect(x, y, s, s);
    }

    var tex = new THREE.CanvasTexture(cv);
    tex.mapping = THREE.EquirectangularReflectionMapping;
    tex.encoding = THREE.sRGBEncoding;

    var pmrem = new THREE.PMREMGenerator(renderer);
    pmrem.compileEquirectangularShader();
    var env = pmrem.fromEquirectangular(tex).texture;
    pmrem.dispose();
    tex.dispose();

    scene.environment = env;   // KHÔNG gán scene.background — nền do starfield lo
    return env;
  };

  /* ---- CHỌN MÀU SAO CHO SỐNG SÓT QUA ACES ---------------------------------
   * Bài học đo được ở tập 08, tốn 3 vòng sửa mới ra. Đọc trước khi chọn bảng màu.
   *
   * ACES nén mạnh vùng sáng. Càng đẩy độ sáng lên, sắc càng bị kéo về trắng/xám.
   * Nên SẮC PHẢI ĐẾN TỪ TỈ LỆ GIỮA CÁC KÊNH, không đến từ độ sáng.
   *
   * Đo thật (bão hoà còn lại sau khi qua chuỗi ACES của three.js r128):
   *   (0.42, 0.60, 1.05)  → còn 11–25%  → ra XÁM BÊ TÔNG. Đừng dùng.
   *   (0.10, 0.32, 1.00)  → còn 37–67%  → ra LAM THẬT.
   *
   * Quy tắc rút ra:
   *   - Kênh yếu nên ≤ 0.2× kênh mạnh. Nâng kênh yếu lên là giết sắc.
   *   - Kênh mạnh giữ quanh 1.0, đừng hơn.
   *   - Muốn SÁNG hơn thì tăng emissive (vượt ngưỡng bloom), ĐỪNG nâng kênh yếu.
   *
   * Hệ quả cho chữ và sơ đồ: bloom làm NHOÈ MẤT NÉT CHỮ. Nét biểu đồ và typo phải
   * để DƯỚI ngưỡng bloom (<1.0). Muốn chữ rõ hơn thì tăng độ dày nét, không tăng
   * emissive.
   *
   * Chống cháy trắng: giữ diện tích có luminance >0.85 (sau tonemap) dưới ~12%
   * khung. Cần một vùng sáng rộng thì đẩy bằng SỐ LƯỢNG hạt nhỏ, đừng đẩy bằng
   * độ sáng của hạt lớn.
   */
  HFA.saturationAfterACES = function (r, g, b) {
    // Ước lượng nhanh xem một màu tuyến tính có giữ được sắc sau ACES không.
    // Trả về {before, after} ∈ [0,1]. after < 0.3 nghĩa là sẽ ra xám.
    function aces(v) {
      // xấp xỉ đủ dùng để SO SÁNH các màu với nhau (không phải bản đầy đủ)
      return Math.max(0, Math.min(1, (v * (2.51 * v + 0.03)) / (v * (2.43 * v + 0.59) + 0.14)));
    }
    function sat(x, y, z) {
      var mx = Math.max(x, y, z), mn = Math.min(x, y, z);
      return mx <= 0 ? 0 : (mx - mn) / mx;
    }
    return { before: sat(r, g, b), after: sat(aces(r), aces(g), aces(b)) };
  };

  /* ---- sprite hạt tròn mềm (tránh hạt vuông) ------------------------------ */
  HFA.dotTex = function (rr, gg, bb) {
    var cv = document.createElement('canvas');
    cv.width = cv.height = 64;
    var cx = cv.getContext('2d');
    var gr = cx.createRadialGradient(32, 32, 0, 32, 32, 32);
    gr.addColorStop(0, 'rgba(' + rr + ',' + gg + ',' + bb + ',1)');
    gr.addColorStop(0.4, 'rgba(' + rr + ',' + gg + ',' + bb + ',0.55)');
    gr.addColorStop(1, 'rgba(0,0,0,0)');
    cx.fillStyle = gr; cx.fillRect(0, 0, 64, 64);
    var tx = new THREE.CanvasTexture(cv);
    tx.encoding = THREE.sRGBEncoding;
    return tx;
  };

  /* ---- BỐN LỖI ĐÃ LÀM CHẾT HÀNG CHỤC CẢNH — đọc trước khi dựng tập mới -----
   *
   * Cả bốn đều KHÔNG bị `hyperframes validate` bắt, vì validate chỉ lấy vài mẫu
   * thời gian. Chúng chỉ lộ ra khi render ảnh và NHÌN. Rút từ tập 09–12.
   *
   * 1. BIẾN BỊ CHE (shadowing).
   *    Tập "nước": một mesh tên `grain` bị che bởi `var grain = 0.040` (lượng
   *    grain của lens) khai báo ngay trong renderAtTime → mọi cảnh từ S19 trở đi
   *    chết. Đặt tên mesh khác hẳn tên biến cục bộ; đối chiếu danh sách biến
   *    top-level với biến trong renderAtTime trước khi giao.
   *
   * 2. GỌI UNIFORM KHÔNG TỒN TẠI.
   *    Tập "photon": gọi `.uniforms.uEm` trên kết quả của HFA.buildStars — hàm
   *    đó CHỈ có `uOp`. Ném TypeError, 17 cảnh liên tiếp đứng hình. Kiểm API
   *    thư viện trước khi gọi, đừng đoán tên uniform.
   *
   * 3. SAI TỈ LỆ SÂN KHẤU.
   *    Tập "nước": nguyên tử r=1.30 đặt trên mặt cầu r=140 với camera cách 2.7
   *    → hai quả cầu phủ kín khung, ống liên kết thành tấm phẳng. Tính trước
   *    tỉ lệ vật thể so với khoảng cách camera, đừng chỉnh mò sau.
   *
   * 4. CHỮ QUÁ NHỎ KHÔNG ĐỌC NỔI.
   *    Tập "nước": chữ cao 0.42 world ở khoảng cách camera 28 → ra dưới 18px
   *    trên 1080p. Cần ≥26px. Với mỗi shot có chữ, tính trước
   *    `px ≈ (h_world / (2 * d * tan(fov/2))) * 1080` rồi mới chốt camera.
   *    Muốn chữ rõ hơn thì TĂNG ĐỘ DÀY NÉT, đừng tăng emissive — bloom làm
   *    nhoè mất nét chữ. Giữ chữ và sơ đồ DƯỚI ngưỡng bloom 1.0.
   */

  /* ---- CHỮ TIẾNG VIỆT TRÊN CANVAS: CANVAS PHẢI ĐỦ CAO CHO DẤU ------------
   *
   * Lỗi hệ thống, đo được ở tập quasar: 72/121 nhãn bị CẮT MẤT DẤU.
   *
   * Cơ chế: canvas 2D đặt `textBaseline='middle'` canh em-box vào giữa chiều
   * cao canvas. Nhưng dấu tiếng Việt nhô RA NGOÀI em-box — mũ/sắc/huyền/ngã/hỏi
   * nhô lên trên cap-height (chồng hai tầng như `ế`, `ộ`), dấu nặng thụt xuống
   * dưới baseline. Canvas chật thì chữ cái vẫn vẽ, dấu rơi ra ngoài vùng vẽ.
   * Triệu chứng: "vài chục nghìn ly" render ra "vai chuc nghin ly" dù mã nguồn
   * viết đúng dấu.
   *
   * Ngưỡng an toàn đo được: `hpx >= fpx * 2.4 * số_dòng`.
   * ⚠ Ngưỡng 2.0 KHÔNG đủ — một nhãn ở tỉ lệ 2.09 vẫn bị cắt.
   *
   * Nới canvas kéo theo HAI hệ quả phải xử cùng lúc, nếu không sẽ hỏng kiểu khác:
   *   1. Tỉ lệ khung của plane phải tính theo chiều cao THẬT sau khi nở, không
   *      theo `hpx` gốc — nếu không mọi chữ bị KÉO GIÃN NGANG.
   *   2. Trần bù `glyphFrac` phải chia cho hệ số nở — canvas cao hơn làm
   *      glyphFrac tụt, trần giữ nguyên thì chữ NHỎ ĐI THẬT (đo được 32px → 21px).
   *
   * Dùng `HFA.canvasHeightForText` khi tự dựng nhãn canvas.
   *
   * ---- CHỮ NHẬT (kanji/kana) THÌ KHÁC ------------------------------------
   * Kanji KHÔNG có dấu nhô ra ngoài em-box: chữ nằm gọn trong hộp vuông.
   * Đo thật ngày 2026-09-21 (BIZ UDPGothic 700, headless Chrome, "位牌と仏壇"):
   *   ascent 27.7px + descent 27.3px = 55.0px ở font 56px → tỉ lệ ~0.98.
   * Tức hệ số 2.4 của tiếng Việt CẤP DƯ hơn gấp đôi. Không gây cắt chữ, nhưng
   * canvas cao gấp đôi làm `glyphFrac` tụt một nửa → chữ NHỎ ĐI THẬT trên màn
   * hình (đúng cơ chế đã ghi ở hệ quả 2 bên trên). Vì thế tách hệ số theo chữ.
   * Vẫn để dư 1.45 cho phần nhô của 〜 ー ゛ ゜ và chữ Latin lẫn trong câu Nhật.
   */
  var CJK_RE = /[぀-ヿ㐀-䶿一-鿿＀-￯]/;

  /** true nếu chuỗi có chữ Nhật (kana/kanji/toàn角). */
  HFA.isCJK = function (s) { return CJK_RE.test(String(s || '')); };

  /**
   * Chiều cao canvas tối thiểu cho nhãn chữ.
   * @param fontPx cỡ chữ px
   * @param lines  số dòng
   * @param requestedHpx chiều cao mong muốn (lấy max)
   * @param text   (tuỳ chọn) chữ sẽ vẽ — có chữ Nhật thì dùng hệ số 1.45 thay vì 2.4.
   *               Bỏ trống = giữ nguyên hành vi cũ (2.4) cho các tập tiếng Việt.
   */
  HFA.canvasHeightForText = function (fontPx, lines, requestedHpx, text) {
    var k = (text != null && HFA.isCJK(text)) ? 1.45 : 2.4;
    var need = Math.ceil(fontPx * k * (lines || 1));
    return Math.max(requestedHpx || 0, need);
  };

  /** px ước tính của một vật cao `hWorld` ở khoảng cách `dist`, camera fov độ.
   *
   * ⚠ HÀM NÀY ĐO PLANE, KHÔNG ĐO CHỮ. Với nhãn vẽ bằng canvas texture, chữ dài
   * làm font bị thu nhỏ cho vừa canvas trong khi plane vẫn giữ nguyên kích
   * thước → glyph thật chỉ chiếm 55–62% chiều cao plane. Đo được ở tập quasar:
   * hàm báo 49px trong khi chữ trên frame render chỉ **4px**.
   *
   * Với nhãn canvas, truyền `glyphFrac` (tỉ lệ chiều cao glyph / chiều cao
   * plane, thường 0.55–0.68) làm tham số thứ 5, hoặc tốt hơn: cho `textTex`
   * trả về glyphFrac thật rồi chia hWorld cho nó khi dựng plane.
   *
   * Cách đáng tin duy nhất vẫn là ĐO TRÊN FRAME ĐÃ RENDER. Ngưỡng đọc được:
   * ≥26px @1080p.
   */
  HFA.estimatePx = function (hWorld, dist, fovDeg, screenH, glyphFrac) {
    var f = (fovDeg || 46) * Math.PI / 180;
    var px = (hWorld / (2 * dist * Math.tan(f / 2))) * (screenH || 1080);
    return px * (glyphFrac == null ? 1 : glyphFrac);
  };

  /* ---- starfield màu theo nhiệt độ ----------------------------------------
   * ⚠ BÁN KÍNH: radius PHẢI lớn hơn khoảng cách camera XA NHẤT trong cả timeline.
   * Camera bay ra ngoài quả cầu sao → nhìn thấy "quả bóng vũ trụ" bo tròn. Đây là
   * lỗi đã xảy ra thật. Truyền opt.maxCamDist để bật cảnh báo tự động.
   * Hằng số trong gl_PointSize phải BẰNG ĐÚNG radius, nếu không sao đổi độ to khi
   * đổi bán kính — nên nó được nội suy vào shader ngay dưới đây.
   */
  HFA.buildStars = function (opt) {
    opt = opt || {};
    var R = opt.radius || 9000;
    var N = opt.count || 3600;
    var pr = HFA.mulberry32(opt.seed || 20260808);

    if (opt.maxCamDist && R <= opt.maxCamDist * 1.5) {
      console.warn('[hf-astro] starfield radius ' + R + ' quá nhỏ so với camera xa nhất ' +
        opt.maxCamDist + ' — sẽ lộ "quả bóng vũ trụ". Tăng radius lên >' +
        Math.ceil(opt.maxCamDist * 2) + ' (và giữ < camera.far).');
    }

    var pos = new Float32Array(N * 3), col = new Float32Array(N * 3), siz = new Float32Array(N);
    var tmp = new THREE.Vector3();
    for (var i = 0; i < N; i++) {
      var u = pr(), v = pr();
      var theta = Math.acos(2 * u - 1), phi = 2 * Math.PI * v;
      tmp.set(Math.sin(theta) * Math.cos(phi), Math.cos(theta) * 0.8, Math.sin(theta) * Math.sin(phi))
        .normalize().multiplyScalar(R);
      pos[i * 3] = tmp.x; pos[i * 3 + 1] = tmp.y; pos[i * 3 + 2] = tmp.z;

      // màu theo nhiệt độ: xanh nóng → trắng → vàng nhạt
      var tt = pr(), c = new THREE.Color();
      if (tt < 0.14) c.setRGB(0.6, 0.72, 1.0);
      else if (tt < 0.5) c.setRGB(0.85, 0.9, 1.0);
      else if (tt < 0.8) c.setRGB(0.9, 0.92, 1.0);
      else c.setRGB(0.8, 0.82, 0.95);
      c.multiplyScalar(0.3 + pr() * 0.5);
      col[i * 3] = c.r; col[i * 3 + 1] = c.g; col[i * 3 + 2] = c.b;

      siz[i] = (pr() < 0.05 ? 2.6 : 1.0) * (0.8 + pr() * 1.4);
    }

    var g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    g.setAttribute('color', new THREE.BufferAttribute(col, 3));
    g.setAttribute('aS', new THREE.BufferAttribute(siz, 1));

    var m = new THREE.ShaderMaterial({
      uniforms: { uOp: { value: 1 } },
      transparent: true, depthWrite: false, blending: THREE.AdditiveBlending,
      vertexShader:
        'attribute float aS;attribute vec3 color;varying vec3 vC;' +
        'void main(){vC=color;vec4 mv=modelViewMatrix*vec4(position,1.0);' +
        'gl_PointSize=aS*(' + R.toFixed(1) + '/-mv.z);gl_Position=projectionMatrix*mv;}',
      fragmentShader:
        'varying vec3 vC;uniform float uOp;' +
        'void main(){vec2 d=gl_PointCoord-0.5;float r=length(d);' +
        'float a=smoothstep(0.5,0.0,r);gl_FragColor=vec4(vC,a*uOp);}'
    });

    var pts = new THREE.Points(g, m);
    pts.userData.radius = R;
    return pts;
  };

  /* ---- TÍCH LUỸ ĐA MẪU: khử răng cưa + motion blur thật -------------------
   *
   * Chỉ làm được vì renderAtTime(t) là HÀM THUẦN, không trạng thái: gọi lại với
   * t nào cũng cho đúng kết quả của t đó. Render offline nên được phép trả giá
   * bằng thời gian để đổi lấy chất lượng — đây là thứ engine realtime không có.
   *
   * Mỗi frame xuất ra lấy N mẫu:
   *   - t rải đều trong khoảng 1/fps      → MOTION BLUR thật theo quỹ đạo
   *   - camera lệch dưới-một-pixel        → SUPERSAMPLING, khử cả răng cưa
   *     shader/specular mà MSAA không xử lý được
   * rồi cộng trung bình.
   *
   * Giá: thời gian capture ×N. Nháp để samples=1, bản giao hàng đặt 4.
   *
   * CÁCH DÙNG — trong file tập:
   *   HFA.enableAccumulation(stage, {samples:4, fps:30});
   *   ... window.__time""lines[id] = HFA.makeTimeline(id, TOTAL, renderAtTime);
   * makeTimeline tự phát hiện stage đã bật tích luỹ nếu bạn truyền stage:
   *   HFA.makeTimeline(id, TOTAL, renderAtTime, stage)
   */
  HFA.enableAccumulation = function (stage, o) {
    o = o || {};
    var N = Math.max(1, o.samples || 1);
    if (N === 1) {
      // tắt tích luỹ → PHẢI trả composer về chế độ vẽ thẳng ra màn hình,
      // nếu không màn hình đen (không pass nào ghi ra nữa).
      stage.accum = null;
      stage.composer.renderToScreen = true;
      return stage;
    }

    /* Chuyển hướng đầu ra composer vào texture thay vì màn hình.
     * ⚠ PHẢI đặt trên COMPOSER, không phải trên pass: EffectComposer.render()
     * gán lại pass.renderToScreen mỗi frame theo công thức
     *   pass.renderToScreen = composer.renderToScreen && làPassCuốiCùng
     * nên mọi thiết lập trực tiếp lên lens.renderToScreen đều bị xoá. (Đo được:
     * đặt trên pass thì cả read/write buffer đều chứa dữ liệu TRƯỚC lens.) */
    stage.composer.renderToScreen = false;

    var rtOpts = {
      minFilter: THREE.LinearFilter, magFilter: THREE.LinearFilter,
      format: THREE.RGBAFormat, type: THREE.HalfFloatType
    };
    var accumRT = new THREE.WebGLRenderTarget(stage.W, stage.H, rtOpts);

    // quad toàn màn hình dùng để cộng dồn rồi để xuất ra
    var quadScene = new THREE.Scene();
    var quadCam = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    var quadMat = new THREE.ShaderMaterial({
      uniforms: { tSrc: { value: null }, uWeight: { value: 1 / N } },
      transparent: true, depthTest: false, depthWrite: false,
      blending: THREE.CustomBlending,
      blendEquation: THREE.AddEquation,
      blendSrc: THREE.OneFactor, blendDst: THREE.OneFactor,   // cộng thuần
      vertexShader: 'varying vec2 vUv;void main(){vUv=uv;gl_Position=vec4(position.xy,0.0,1.0);}',
      fragmentShader: 'varying vec2 vUv;uniform sampler2D tSrc;uniform float uWeight;' +
        'void main(){gl_FragColor=vec4(texture2D(tSrc,vUv).rgb*uWeight,1.0);}'
    });
    quadScene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), quadMat));

    var outMat = new THREE.ShaderMaterial({
      uniforms: { tSrc: { value: accumRT.texture } },
      depthTest: false, depthWrite: false,
      vertexShader: 'varying vec2 vUv;void main(){vUv=uv;gl_Position=vec4(position.xy,0.0,1.0);}',
      fragmentShader: 'varying vec2 vUv;uniform sampler2D tSrc;' +
        'void main(){gl_FragColor=vec4(texture2D(tSrc,vUv).rgb,1.0);}'
    });
    var outScene = new THREE.Scene();
    outScene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), outMat));

    stage.accum = {
      samples: N, fps: o.fps || 30,
      rt: accumRT, quadScene: quadScene, quadCam: quadCam,
      quadMat: quadMat, outScene: outScene
    };
    return stage;
  };

  /* Vị trí lệch subpixel — chuỗi Halton (2,3): phân bố đều hơn ngẫu nhiên,
   * và tất định tuyệt đối (không đụng tới PRNG chung). */
  function halton(i, b) {
    var f = 1, r = 0;
    while (i > 0) { f /= b; r += f * (i % b); i = Math.floor(i / b); }
    return r;
  }

  /** Vẽ MỘT frame tại t. Tự dùng tích luỹ nếu stage đã bật, không thì vẽ thẳng. */
  HFA.renderFrame = function (stage, renderAtTime, t) {
    var acc = stage && stage.accum;
    if (!acc) { renderAtTime(t); return; }   // renderAtTime tự gọi composer.render()

    var r = stage.renderer, cam = stage.camera, N = acc.samples;
    var dt = 1 / acc.fps;
    var prevAutoClear = r.autoClear;

    // xoá bộ tích luỹ ĐÚNG MỘT LẦN, trước vòng lặp
    r.setRenderTarget(acc.rt);
    r.setClearColor(0x000000, 1);
    r.clear(true, true, true);
    r.setRenderTarget(null);

    for (var i = 0; i < N; i++) {
      // lệch dưới-một-pixel (Halton, tất định)
      var jx = halton(i + 1, 2) - 0.5, jy = halton(i + 1, 3) - 0.5;
      cam.setViewOffset(stage.W, stage.H, jx, jy, stage.W, stage.H);

      // trải t trong đúng một frame → motion blur
      var tt = t + ((i + 0.5) / N - 0.5) * dt;
      r.setClearColor(stage.clearColor, 1);   // trả màu nền cho RenderPass
      renderAtTime(tt < 0 ? 0 : tt);

      /* ⚠ autoClear PHẢI tắt ở đây.
       * renderer.autoClear mặc định TRUE → mỗi r.render() xoá sạch target trước
       * khi vẽ. Cộng dồn mà không tắt thì 3 mẫu đầu bị xoá, chỉ mẫu cuối sống
       * sót và nó mang trọng số 1/N → ảnh tối đúng N lần. (Đã dính lỗi này:
       * ảnh ra tối bằng 1/4 với N=4.) */
      // pass cuối có needsSwap=true nên sau render(), kết quả nằm ở readBuffer
      acc.quadMat.uniforms.tSrc.value = stage.composer.readBuffer.texture;
      r.autoClear = false;
      r.setRenderTarget(acc.rt);
      r.render(acc.quadScene, acc.quadCam);
      r.setRenderTarget(null);
      r.autoClear = prevAutoClear;
    }

    cam.clearViewOffset();
    r.setClearColor(stage.clearColor, 1);
    r.render(acc.outScene, acc.quadCam);   // xuất ra màn hình
  };

  /* ---- phụ đề -------------------------------------------------------------
   * CUES = [{t, s}] do scripts/gen-captions.mjs sinh, đã cắt sẵn MỘT DÒNG:
   * ≤42 ký tự với tiếng Việt, ≤22 ký tự toàn角 với tiếng Nhật (chữ Nhật rộng gấp đôi).
   * Đừng cắt tay và đừng đổi mảng này bằng tay.
   */
  HFA.subtitleAt = function (CUES, t) {
    var s = '';
    for (var i = 0; i < CUES.length; i++) {
      if (CUES[i].t <= t + 0.001) s = CUES[i].s; else break;
    }
    return s;
  };

  HFA.applySubtitle = function (el, CUES, t) {
    if (!el) return;
    var s = HFA.subtitleAt(CUES, t);
    if (el.textContent !== s) el.textContent = s;   // chỉ ghi khi đổi
  };

  /* ---- nhãn chương --------------------------------------------------------
   * marks = [{t, x:'CHƯƠNG 1'}, ...]; hiện `hold` giây rồi tắt mượt.
   */
  HFA.applyChapter = function (el, marks, t, hold) {
    if (!el) return 0;
    hold = hold || 5.5;
    var show = 0, txt = '';
    for (var i = 0; i < marks.length; i++) {
      var m = marks[i];
      if (t >= m.t && t < m.t + hold) {
        show = HFA.band(t, m.t + 0.3, m.t + hold - 0.7, 0.6);
        txt = m.x;
      }
    }
    if (el.textContent !== txt) el.textContent = txt;
    el.style.opacity = show.toFixed(3);
    return show;
  };

  /* ---- fade vào/ra toàn cục ----------------------------------------------- */
  HFA.globalFade = function (t, TOTAL, inSec, outSec) {
    return HFA.smooth(t / (inSec || 1.5)) * HFA.smooth((TOTAL - t) / (outSec || 3.0));
  };

  /* ---- dựng timeline ------------------------------------------------------
   * ⚠ HÀM NÀY KHÔNG TỰ ĐĂNG KÝ — và đó là chủ ý.
   * StaticGuard của HyperFrames QUÉT VĂN BẢN file composition để tìm chuỗi
   * `window.__timelines`. Giấu phần đăng ký vào thư viện này làm guard báo
   * "Missing window.__timelines registration" và render ra frame tĩnh.
   * (Đã kiểm chứng bằng hyperframes validate.)
   *
   * Vì vậy file tập PHẢI tự viết hai dòng đăng ký. Mẫu (thay SLUG bằng slug thật,
   * và viết bằng cú pháp ngoặc vuông bình thường — ở đây tách chữ để chính bản
   * hướng dẫn này không bị StaticGuard đếm nhầm thành một đăng ký có thật):
   *
   *     window.__time""lines = window.__time""lines || {};
   *     window.__time""lines[ "SLUG" ] = HFA.makeTimeline("SLUG", TOTAL, renderAtTime);
   *
   * SLUG phải trùng data-composition-id của div gốc.
   * (StaticGuard quét VĂN BẢN, kể cả trong comment — đừng viết ví dụ đăng ký
   *  nguyên dạng ở bất kỳ đâu trong file dùng chung này.)
   *
   * Đổi lại, hàm này lo phần dễ sai: driver clk tuyến tính, bọc try/catch để
   * lỗi hiện lên #err (thay vì ra frame đen không rõ lý do), và vẽ frame đầu.
   */
  HFA.makeTimeline = function (id, TOTAL, renderAtTime, stage) {
    if (!document.querySelector('[data-composition-id="' + id + '"]')) {
      console.warn('[hf-astro] không thấy [data-composition-id="' + id + '"] — ' +
        'khoá timeline phải trùng id của div gốc.');
    }
    function safeRender(t) {
      try {
        // truyền stage (đã enableAccumulation) → mỗi frame lấy N mẫu
        if (stage && stage.accum) HFA.renderFrame(stage, renderAtTime, t);
        else renderAtTime(t);
      } catch (err) {
        var eb = document.getElementById('err');
        if (eb) {
          eb.style.display = 'block';
          eb.textContent = 'renderAtTime@' + t.toFixed(2) + ': ' + err.message;
        }
        throw err;
      }
    }
    var tl = gsap.timeline({ paused: true });
    var clk = { t: 0 };
    tl.to(clk, { t: TOTAL, duration: TOTAL, ease: 'none', onUpdate: function () { safeRender(clk.t); } }, 0);
    safeRender(0);          // vẽ frame đầu
    return tl;
  };

  global.HFA = HFA;
})(window);
/* ===== HFA:END ===== */


/* ============================================================================
 * 友達には言えるのに、自分には言えないのはなぜか｜研究の答え
 * slug: jibun-ni-kibishii · 62 cue = 62 shot (một cue một shot) · 4 chương
 *
 * Nguồn thời gian: projects/jibun-ni-kibishii/timing.json (giọng THẬT). KHÔNG remap.
 * Mốc shot = cue.start thật (bảng CS dưới, sinh từ timing.json). Mốc sự kiện TRONG shot
 * neo vào mốc phụ đề cues.json (thời gian CẢNH tuyệt đối) → hình không trễ lời (lỗi số 2).
 *
 * ⚠⚠ QUY ƯỚC THỜI GIAN CỦA FILE NÀY (lỗi "pass mà sai" số 1):
 *   loc(t,k) trả GIÂY trôi qua trong shot (KHÔNG phải tỉ lệ 0–1) — override tại tập.
 *   Hàm shot SH[k](u, t): u = giây trong shot (chỉ cho chuyển động máy),
 *   t = giây CẢNH tuyệt đối. Sự kiện hình viết theo t tuyệt đối.
 *
 * Storyboard.md của tập được viết cho một bản kịch bản CŨ (tàu điện, đồng nghiệp, 54 cue).
 * Hình ở đây bám bản kịch bản CUỐI (quán cà phê → xe buýt, 62 cue) + đề xuất hình
 * trong METADATA script.md; mượn các motif storyboard còn khớp (hai bóng cùng một dáng,
 * ánh sáng lạnh/ấm, mạng điểm sáng trong đầu, đường "chuẩn" nằm ngang, vòng khép→mở).
 *
 * Bộ cảnh (mỗi bộ một vùng không gian riêng + đèn riêng, bật/tắt theo shot):
 *   CAFE  x=0     quán cà phê sáng 10h, bàn đôi cạnh cửa sổ
 *   BUS   x=100   xe buýt tuyến, phố buổi sáng trôi ngoài cửa sổ
 *   VOID  x=200   không gian "hai cái bóng" — sàn tối, đèn lạnh/ấm có bóng đổ thật
 *   PAPER x=300   bàn đọc: bài báo gốc dưới đèn bàn
 *   SCAN  x=400   máy chụp não (fMRI)
 *   HEAD  x=500   mạng điểm sáng trong đầu (ẩn dụ, không giải phẫu chi tiết)
 *   DESK  x=600   bài kiểm tra từ vựng của Breines & Chen
 *
 * Tất định: không rAF/Date.now/Math.random/setTimeout/+= dt. Ngẫu nhiên = mulberry32.
 * ========================================================================== */
var SLUG = "jibun-ni-kibishii";
var TOTAL = 825.76;
/*CS:BEGIN*/
var CS={C01:0,C02:8.37,C03:20.3,C04:28.98,C05:39.64,C06:50.04,C07:68.63,C08:78.92,C09:95.29,C10:107.72,C11:117.49,C12:130.5,C13:140.9,C14:155.23,C15:162.14,C16:174.07,C17:187.46,C18:193.29,C19:207.49,C20:220.94,C21:233.75,C22:245.36,C23:266.23,C24:278.05,C25:290.8,C26:303.55,C27:316.99,C28:330.19,C29:341.16,C30:362.54,C31:375.16,C32:387.46,C33:401.35,C34:413.73,C35:427.26,C36:438.87,C37:449.34,C38:460.95,C39:472.62,C40:487.4,C41:501.23,C42:517.24,C43:539.69,C44:551.68,C45:562.59,C46:575.65,C47:587.19,C48:592.65,C49:607.56,C50:621.52,C51:633.19,C52:648.6,C53:675.58,C54:687.96,C55:703.94,C56:723.41,C57:734.63,C58:745.1,C59:761.42,C60:770.87,C61:780.77,C62:802.91};
var SCENE_END=818.7;
/*CS:END*/
var LEAD_S = 2;           /* intro lặng (audio.json.lead) — nhãn chương tra theo thời gian THẬT */
var W = 1920, H = 1080;

var clamp = HFA.clamp, smooth = HFA.smooth, band = HFA.band;
function ease(x){ x = clamp(x,0,1); return x*x*x*(x*(x*6-15)+10); }
function ramp(t,a,b){ return ease((t-a)/(b-a)); }
function lin(t,a,b){ return clamp((t-a)/(b-a),0,1); }
function lerp(a,b,p){ return a+(b-a)*p; }
function bump(t,a,b){ var x = clamp((t-a)/(b-a),0,1); return Math.sin(x*Math.PI); }
function win(t,a,b,f){ return band(t,a,b,f||0.6); }

/* ---- 62 shot — một cue một shot ------------------------------------------ */
var SCENE_KEYS = [], SC = {};
(function(){
  var ids = Object.keys(CS).sort(function(a,b){ return CS[a]-CS[b]; });
  for(var i=0;i<ids.length;i++){ SCENE_KEYS.push(ids[i]); SC[ids[i]] = [CS[ids[i]], i+1<ids.length ? CS[ids[i+1]] : SCENE_END]; }
})();
/** loc(): GIÂY trôi qua trong shot k (KHÔNG phải tỉ lệ) — override, không sửa hf-astro.js. */
function loc(t,k){ var w = SC[k]; return Math.min(w[1]-w[0], Math.max(0, t-w[0])); }
function dur(k){ return SC[k][1]-SC[k][0]; }
function sceneAt(t){
  for(var i=SCENE_KEYS.length-1;i>=0;i--){ if(t >= SC[SCENE_KEYS[i]][0]) return SCENE_KEYS[i]; }
  return SCENE_KEYS[0];
}

/* nhãn chương — mốc THẬT (cue.start + LEAD_S) vì applyChapter tra theo _tReal */
var CHAPTERS = [
  {t:CS.C01 + LEAD_S + 0.3, x:'第1章　入口'},
  {t:CS.C10 + LEAD_S, x:'第2章　三つの柱'},
  {t:CS.C29 + LEAD_S, x:'第3章　見張りの声'},
  {t:CS.C55 + LEAD_S, x:'第4章　帰り道'}
];

/* =========================================================================
 * SÂN KHẤU
 * ========================================================================= */
var stage = HFA.createStage({
  canvas:'c', width:W, height:H, fov:40, near:0.03, far:3000,
  clearColor:0x000000, lights:false, environment:false,
  bloomStrength:0.55, bloomRadius:0.62, bloomThreshold:1.0, exposure:1.0
});
var renderer = stage.renderer, scene = stage.scene, camera = stage.camera, composer = stage.composer;
var lens = stage.lens, bloomPass = stage.bloom;
lens.uniforms.uCA.value = 0.0007;
lens.uniforms.uGrain.value = 0.028;
lens.uniforms.uVig.value = 0.40;
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
var MAXANI = renderer.capabilities.getMaxAnisotropy();
var subEl = document.getElementById('sub');
var chapEl = document.getElementById('chap');

/* ---- pass chỉnh màu (bão hoà / nhân kênh) — tuyến tính, TRƯỚC lens ---- */
var grade = new THREE.ShaderPass({
  uniforms:{ tDiffuse:{value:null}, uSat:{value:1.0}, uMul:{value:new THREE.Vector3(1,1,1)} },
  vertexShader:'varying vec2 vUv;void main(){vUv=uv;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}',
  fragmentShader:'varying vec2 vUv;uniform sampler2D tDiffuse;uniform float uSat;uniform vec3 uMul;'+
    'void main(){vec4 c=texture2D(tDiffuse,vUv);float l=dot(c.rgb,vec3(0.2126,0.7152,0.0722));'+
    'gl_FragColor=vec4(max(mix(vec3(l),c.rgb,uSat)*uMul,0.0),1.0);}'
});
composer.insertPass(grade, 2);

/* ---- nền: cầu gradient bám camera ---- */
var bgMat = new THREE.ShaderMaterial({
  uniforms:{ uTop:{value:new THREE.Color(0,0,0)}, uBot:{value:new THREE.Color(0,0,0)} },
  side:THREE.BackSide, depthWrite:false, fog:false,
  vertexShader:'varying vec3 vP;void main(){vP=normalize(position);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}',
  fragmentShader:'uniform vec3 uTop,uBot;varying vec3 vP;void main(){float k=smoothstep(-0.5,0.7,vP.y);gl_FragColor=vec4(mix(uBot,uTop,k),1.0);}'
});
var bg = new THREE.Mesh(new THREE.SphereGeometry(1500, 32, 16), bgMat);
bg.renderOrder = -100; bg.frustumCulled = false; scene.add(bg);

/* fog: LUÔN có (đổi null↔Fog làm biên dịch lại shader) — chỉ đổi near/far/màu theo shot */
scene.fog = new THREE.Fog(0x000000, 900, 1400);

/* ---- envMap PMREM — ba "phòng": ngày (quán, xe), tối (VOID), đèn bàn (PAPER/DESK) ---- */
function makeEnv(top, mid, bot, blobs){
  var cv = document.createElement('canvas'); cv.width = 512; cv.height = 256;
  var cx = cv.getContext('2d');
  var gr = cx.createLinearGradient(0,0,0,256);
  gr.addColorStop(0, top); gr.addColorStop(0.5, mid); gr.addColorStop(1, bot);
  cx.fillStyle = gr; cx.fillRect(0,0,512,256);
  for(var i=0;i<blobs.length;i++){ var b = blobs[i]; cx.fillStyle = b[4]; cx.fillRect(b[0],b[1],b[2],b[3]); }
  var tx = new THREE.CanvasTexture(cv);
  tx.mapping = THREE.EquirectangularReflectionMapping; tx.encoding = THREE.sRGBEncoding;
  var pm = new THREE.PMREMGenerator(renderer); pm.compileEquirectangularShader();
  var env = pm.fromEquirectangular(tx).texture; pm.dispose(); tx.dispose();
  return env;
}
var envDay = makeEnv('#8d9296','#6c665e','#3a342d',
  [[0,60,130,80,'#f2f0ea'],[180,60,90,80,'#e8e6e0'],[300,70,60,70,'#c9c3b8'],[420,10,60,12,'#fff4dc']]);
/* MỘT envMap duy nhất: nướng PMREM rất đắt khi chụp bằng GL phần mềm (snapshot vượt 10s).
 * Phòng tối/đèn bàn không nướng riêng — thay bằng envMapIntensity theo bộ cảnh (setEnvIntensity). */
var envDark = envDay, envLamp = envDay;
scene.environment = envDay;

/* =========================================================================
 * CHỮ: canvas texture, font BIZ UDPGothic.
 * Mỗi nhãn GIỮ canvas + hàm vẽ → khi font về (fonts.ready) vẽ lại ĐÚNG canvas cũ và
 * needsUpdate; kích thước mặt phẳng CỐ ĐỊNH theo ước lượng (không đo bằng font dự phòng),
 * chữ co vừa khung nếu đo thật rộng hơn → nhãn không đổi cỡ giữa các frame (lỗi 6).
 * Mọi nhãn dựng MỘT LẦN trong block dựng, không dựng lười trong renderAtTime.
 * ========================================================================== */
var JP_FONT = '"BIZ UDPGothic",sans-serif';
var CANVAS_ALL = [];   /* {cv, draw, tx} — vẽ lại khi font về */
function regCanvas(cv, draw, tx){ CANVAS_ALL.push({cv:cv, draw:draw, tx:tx}); }
function redrawAll(){
  for(var i=0;i<CANVAS_ALL.length;i++){ var c = CANVAS_ALL[i]; c.draw(c.cv.getContext('2d'), c.cv.width, c.cv.height); c.tx.needsUpdate = true; }
}
if(document.fonts){
  if(document.fonts.load){ document.fonts.load('700 96px "BIZ UDPGothic"'); document.fonts.load('400 96px "BIZ UDPGothic"'); }
  if(document.fonts.ready) document.fonts.ready.then(function(){
    redrawAll();
    var tl = window.__timelines && window.__timelines["jibun-ni-kibishii"];
    if(typeof renderAtTime === 'function') renderAtTime(tl ? tl.time() : 0);
  });
}
/** ước lượng bề rộng (em) — kanji/kana 1em, Latin/số ~0.6em */
function estEm(s){ var w = 0; for(var i=0;i<s.length;i++){ var c = s.charCodeAt(i); w += (c > 0x2e80) ? 1.0 : (c === 32 ? 0.3 : 0.6); } return w; }
var LABELS = [];
/** nhãn chữ phẳng trong 3D. o: {h: cao glyph (m), col, weight, glow, gain} */
function makeLabel(txt, o){
  o = o || {};
  var fpx = 96, lines = String(txt).split('\n');
  var em = 0; for(var i=0;i<lines.length;i++) em = Math.max(em, estEm(lines[i]));
  var cw = Math.ceil(em*fpx*1.08 + fpx*0.9), ch = HFA.canvasHeightForText(fpx, lines.length, 0, txt);
  var cv = document.createElement('canvas'); cv.width = Math.min(4096, cw); cv.height = ch;
  var col = o.col || '#f4efe6', weight = o.weight || '700';
  var tx = new THREE.CanvasTexture(cv); tx.encoding = THREE.sRGBEncoding; tx.minFilter = THREE.LinearFilter; tx.anisotropy = MAXANI;
  function draw(cx, w, h){
    cx.clearRect(0,0,w,h);
    var f = weight+' '+fpx+'px '+JP_FONT; cx.font = f;
    var widest = 0; for(var j=0;j<lines.length;j++) widest = Math.max(widest, cx.measureText(lines[j]).width);
    var avail = w - fpx*0.6, sx = widest > avail ? avail/widest : 1;
    cx.save(); cx.translate(w/2, h/2); cx.scale(sx, 1);
    cx.textAlign = 'center'; cx.textBaseline = 'middle';
    cx.shadowColor = o.glow || 'rgba(0,0,0,0.9)'; cx.shadowBlur = fpx*0.28;
    cx.fillStyle = col;
    var lh = fpx*1.3, y0 = -lh*(lines.length-1)/2;
    for(var k=0;k<lines.length;k++) cx.fillText(lines[k], 0, y0 + k*lh);
    cx.restore();
  }
  draw(cv.getContext('2d'), cv.width, cv.height);
  regCanvas(cv, draw, tx);
  var glyphFrac = (fpx*lines.length + fpx*0.3*(lines.length-1))/cv.height;
  var hh = (o.h || 0.2)/glyphFrac, ww = hh*cv.width/cv.height;
  var m = new THREE.MeshBasicMaterial({map:tx, transparent:true, depthWrite:false, depthTest:false,
    opacity:0, side:THREE.DoubleSide, fog:false});
  m.color.setScalar(o.gain || 1.22);
  var p = new THREE.Mesh(new THREE.PlaneGeometry(ww, hh), m);
  p.renderOrder = 40; p.visible = false; p.frustumCulled = false;
  p.userData.w = ww; p.userData.h = hh; p.userData.h0 = o.h || 0.2; p.userData.px = o.px || 56;
  scene.add(p); LABELS.push(p);
  return p;
}
/** bật nhãn: vị trí world, độ mờ, quay mặt song song mặt phẳng ảnh */
/* Nhãn neo vào điểm 3D nhưng VẼ theo pixel màn hình: chiếu điểm neo ra NDC, kẹp vào
 * vùng an toàn (lề >= 70px, không xuống vùng phụ đề y > 860px — ràng buộc A/C), rồi
 * đặt mặt phẳng cách camera D=2m với cỡ glyph cố định p.userData.px. Cỡ chữ không đổi
 * theo khoảng cách → không có nhãn khổng lồ khi camera sát vật. */
var _lv = new THREE.Vector3();
function showLabel(p, x, y, z, op){
  if(op <= 0.002){ p.visible = false; return; }
  camera.updateMatrixWorld();
  _lv.set(x, y, z).project(camera);
  if(_lv.z > 1){ p.visible = false; return; }
  var th = Math.tan(camera.fov*Math.PI/360), asp = camera.aspect, D = 2.0;
  var visH = 2*D*th, sc = (p.userData.px/1080*visH)/p.userData.h0;
  var mX = 70/960;
  var hwN = (p.userData.w*sc)/(visH*asp);
  if(hwN*2 > 2 - 2*mX){ sc *= (2 - 2*mX)/(hwN*2); hwN = 1 - mX; }
  var hhN = (p.userData.h*sc)/visH;
  var top = 1 - 70/540 - hhN, bot = -1 + 2*(1080-860)/1080 + hhN;
  var nx = clamp(_lv.x, -1 + mX + hwN, 1 - mX - hwN), ny = clamp(_lv.y, bot, top);
  _lv.set(nx*th*asp*D, ny*th*D, -D).applyMatrix4(camera.matrixWorld);
  p.visible = true; p.position.copy(_lv); p.quaternion.copy(camera.quaternion); p.scale.setScalar(sc);
  p.material.opacity = op;
}
function hideLabels(){ for(var i=0;i<LABELS.length;i++) LABELS[i].visible = false; }

/* canvas texture tiện dụng (keep=true → vẽ lại khi font về) */
function canvasTex(w, h, draw, rep, linear, keep){
  var cv = document.createElement('canvas'); cv.width = w; cv.height = h;
  draw(cv.getContext('2d'), w, h);
  var tx = new THREE.CanvasTexture(cv); tx.encoding = linear ? THREE.LinearEncoding : THREE.sRGBEncoding; tx.anisotropy = MAXANI;
  if(rep){ tx.wrapS = tx.wrapT = THREE.RepeatWrapping; tx.repeat.set(rep[0], rep[1]); }
  if(keep) regCanvas(cv, draw, tx);
  return tx;
}

/* ---- sprite chấm mềm ---- */
var DOT = canvasTex(64,64,function(cx){ var g = cx.createRadialGradient(32,32,0,32,32,32);
  g.addColorStop(0,'rgba(255,255,255,1)'); g.addColorStop(0.35,'rgba(255,255,255,0.45)'); g.addColorStop(1,'rgba(255,255,255,0)');
  cx.fillStyle = g; cx.fillRect(0,0,64,64); });
function glowSprite(col, size){
  var s = new THREE.Sprite(new THREE.SpriteMaterial({map:DOT, color:col, transparent:true, opacity:0,
    blending:THREE.AdditiveBlending, depthWrite:false, fog:false}));
  s.scale.setScalar(size||1); s.renderOrder = 25; s.visible = false; scene.add(s);
  return s;
}
function showSprite(s, x, y, z, op, size){ if(op <= 0.002){ s.visible = false; return; } s.visible = true; s.position.set(x,y,z); s.material.opacity = op; if(size) s.scale.setScalar(size); }

/* =========================================================================
 * SHADER DÙNG CHUNG
 * ========================================================================= */
var UT = {value:0};
var USCALE = {value: H/(2*Math.tan(40*Math.PI/360))};

/* hạt: kích thước kẹp uMaxPx + mờ khi quá gần camera (lỗi "pass mà sai" số 5) */
var PT_VS = [
  'attribute float aS; attribute vec3 aC; attribute float aA;',
  'uniform float uScale,uMaxPx,uNear,uGain;',
  'varying vec3 vC; varying float vA;',
  'void main(){',
  '  vec4 mv = modelViewMatrix * vec4(position,1.0);',
  '  float z = -mv.z;',
  '  float px = aS * uScale / max(z, 0.001);',
  '  gl_PointSize = clamp(px, 1.0, uMaxPx);',
  '  gl_Position = projectionMatrix * mv;',
  '  vA = aA * smoothstep(uNear*0.4, uNear, z) * min(1.0, px/1.2);',
  '  vC = aC * uGain;',
  '}'].join('\n');
var PT_FS = [
  'uniform float uOp; varying vec3 vC; varying float vA;',
  'void main(){ vec2 q = gl_PointCoord - 0.5; float r2 = dot(q,q)*4.0; if(r2>1.0) discard;',
  '  float a = max(exp(-r2*3.0) - 0.05, 0.0);',
  '  gl_FragColor = vec4(vC, a*vA*uOp); }'].join('\n');
/** đám hạt động: N điểm, ghi position/màu/alpha trên CPU mỗi frame (hàm thuần của t) */
function makePoints(N, o){
  o = o || {};
  var g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.BufferAttribute(new Float32Array(N*3), 3));
  g.setAttribute('aC', new THREE.BufferAttribute(new Float32Array(N*3).fill(1), 3));
  g.setAttribute('aS', new THREE.BufferAttribute(new Float32Array(N).fill(o.size||0.03), 1));
  g.setAttribute('aA', new THREE.BufferAttribute(new Float32Array(N).fill(1), 1));
  var m = new THREE.ShaderMaterial({
    uniforms:{ uScale:USCALE, uMaxPx:{value:o.maxPx||18}, uNear:{value:o.near||0.4}, uGain:{value:o.gain||1}, uOp:{value:1} },
    vertexShader:PT_VS, fragmentShader:PT_FS, transparent:true, depthWrite:false,
    depthTest:o.depthTest!==false, blending:THREE.AdditiveBlending });
  var p = new THREE.Points(g, m); p.frustumCulled = false; p.renderOrder = o.order||22; p.visible = false;
  p.userData.N = N; scene.add(p);
  return p;
}
function ptsSet(p, i, x, y, z, r, g, b, a, s){
  var P = p.geometry.attributes.position.array, C = p.geometry.attributes.aC.array, A = p.geometry.attributes.aA.array;
  P[i*3]=x; P[i*3+1]=y; P[i*3+2]=z; C[i*3]=r; C[i*3+1]=g; C[i*3+2]=b; A[i]=a;
  if(s != null) p.geometry.attributes.aS.array[i] = s;
}
function ptsDone(p){ var g = p.geometry.attributes; g.position.needsUpdate = true; g.aC.needsUpdate = true; g.aA.needsUpdate = true; g.aS.needsUpdate = true; p.visible = true; }

/* ---- nón sáng thể tích giả: cộng, lõi sáng hơn rìa theo góc nhìn ---- */
var BEAM_VS = 'varying float vAl; varying vec3 vN; varying vec3 vV; varying vec3 vW;'+
  'void main(){ vAl = -position.y; vec4 w = modelMatrix*vec4(position,1.0); vW = w.xyz;'+
  ' vN = normalize(mat3(modelMatrix)*normal); vV = normalize(cameraPosition - w.xyz); gl_Position = projectionMatrix*viewMatrix*w; }';
var BEAM_FS = 'uniform vec3 uCol; uniform float uI, uT, uFall, uEdge; varying float vAl; varying vec3 vN; varying vec3 vV; varying vec3 vW;'+
  'void main(){ float a = clamp(vAl,0.0,1.0);'+
  ' float core = pow(abs(dot(normalize(vN), normalize(vV))), uEdge);'+
  ' float fall = pow(1.0 - a*0.85, uFall) * smoothstep(0.0, 0.05, a);'+
  ' float mote = 0.88 + 0.12*sin(vW.y*6.0 - uT*0.5 + vW.x*2.3 + vW.z*1.7);'+
  ' gl_FragColor = vec4(uCol * uI * core * fall * mote, 1.0); }';
/** nón: đỉnh tại gốc, trục -y cục bộ dài 1, bán kính đáy 1 → scale theo frame */
function makeBeam(col){
  var g = new THREE.ConeGeometry(1, 1, 64, 1, true); g.translate(0, -0.5, 0);
  var m = new THREE.ShaderMaterial({ uniforms:{ uCol:{value:new THREE.Color(col)}, uI:{value:0}, uT:UT, uFall:{value:1.2}, uEdge:{value:1.8} },
    vertexShader:BEAM_VS, fragmentShader:BEAM_FS, transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, side:THREE.DoubleSide, fog:false });
  var b = new THREE.Mesh(g, m); b.frustumCulled = false; b.renderOrder = 15; b.visible = false; scene.add(b);
  return b;
}
var _bv = new THREE.Vector3(), _DOWN = new THREE.Vector3(0,-1,0);
function setBeam(b, ax, ay, az, bx, by, bz, r, I, col){
  if(I <= 0.001){ b.visible = false; return; }
  b.visible = true; b.position.set(ax, ay, az);
  _bv.set(bx-ax, by-ay, bz-az); var L = _bv.length(); _bv.divideScalar(L);
  b.quaternion.setFromUnitVectors(_DOWN, _bv); b.scale.set(r, L, r);
  b.material.uniforms.uI.value = I*0.45;
  if(col) b.material.uniforms.uCol.value.setHex(col);
}

/* =========================================================================
 * NGƯỜI — một bộ khung (khớp cầu, chi trụ thon), mượn từ tập wasureru đã kiểm.
 * Hướng mặt: +z cục bộ. Vai/hông xoay quanh GỐC chi (bài học bàn tay xoắn ốc).
 * o.sil = true → "cái bóng": một vật liệu tối, đầu trơn (không mặt/tóc/tai) —
 * storyboard cấm vẽ mặt/biểu cảm trên bóng.
 * ========================================================================= */
function std(col, rough, metal){ return new THREE.MeshStandardMaterial({color:col, roughness:rough!=null?rough:0.8, metalness:metal||0}); }
function cyl(r0, r1, h, mat, seg){ var m = new THREE.Mesh(new THREE.CylinderGeometry(r0, r1, h, seg||20), mat); m.castShadow = true; m.receiveShadow = true; return m; }
function ball(r, sx, sy, sz, mat){ var m = new THREE.Mesh(new THREE.SphereGeometry(r, 24, 16), mat); m.scale.set(sx,sy,sz); m.castShadow = true; m.receiveShadow = true; return m; }
function box(w, h, d, mat){ var m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat); m.castShadow = true; m.receiveShadow = true; return m; }
function gsn(x,y,z,cx,cy,cz,sx,sy,sz){ var a=(x-cx)/sx, b=(y-cy)/sy, c=(z-cz)/sz; return Math.exp(-(a*a+b*b+c*c)); }
var HEAD_GEO = (function(){
  var g = new THREE.SphereGeometry(0.1, 72, 54); g.rotateY(-Math.PI/2);
  var P = g.attributes.position, v = new THREE.Vector3();
  for(var i=0;i<P.count;i++){
    v.fromBufferAttribute(P,i).normalize(); var x=v.x, y=v.y, z=v.z, f=Math.max(0,z);
    var sx=0.90, sy=1.13, sz=1.02;
    if(y < 0){ var k=-y; sx *= 1-0.22*k*k; sz *= 1-0.06*k*k; }
    if(z < 0 && y > -0.35) sz *= 1+0.07*(-z);
    var r = 1.0;
    r += 0.075*gsn(x,y,z, 0,-0.04,1, 0.085,0.26,0.22)*f;
    r += 0.075*gsn(x,y,z, 0,-0.21,1, 0.11,0.08,0.2)*f;
    r -= 0.055*(gsn(x,y,z, 0.31,0.05,0.95, 0.15,0.09,0.2)+gsn(x,y,z,-0.31,0.05,0.95, 0.15,0.09,0.2))*f;
    r += 0.030*(gsn(x,y,z, 0.30,0.19,0.95, 0.22,0.06,0.2)+gsn(x,y,z,-0.30,0.19,0.95, 0.22,0.06,0.2))*f;
    r += 0.028*(gsn(x,y,z, 0.55,-0.16,0.8, 0.17,0.14,0.2)+gsn(x,y,z,-0.55,-0.16,0.8, 0.17,0.14,0.2))*f;
    r += 0.030*gsn(x,y,z, 0,-0.64,0.78, 0.17,0.11,0.2)*f;
    r -= 0.016*gsn(x,y,z, 0,-0.42,0.93, 0.19,0.035,0.2)*f;
    P.setXYZ(i, x*0.1*r*sx, y*0.1*r*sy, z*0.1*r*sz);
  }
  g.computeVertexNormals(); return g;
})();
/* đầu trơn cho "cái bóng" */
var SIL_HEAD_GEO = (function(){
  var g = new THREE.SphereGeometry(0.1, 48, 36);
  var P = g.attributes.position, v = new THREE.Vector3();
  for(var i=0;i<P.count;i++){
    v.fromBufferAttribute(P,i).normalize(); var sx=0.92, sy=1.14, sz=1.04;
    if(v.y < 0){ var k=-v.y; sx *= 1-0.22*k*k; }
    P.setXYZ(i, v.x*0.1*sx, v.y*0.1*sy, v.z*0.1*sz);
  }
  g.computeVertexNormals(); return g;
})();
function faceTex(skin){
  return canvasTex(1024,512,function(cx,w,h){
    cx.fillStyle = skin; cx.fillRect(0,0,w,h);
    var cxm = w*0.5;
    cx.fillStyle = 'rgba(170,80,70,0.10)'; [[-120,300],[120,300]].forEach(function(q){ cx.beginPath(); cx.ellipse(cxm+q[0],q[1],46,30,0,0,7); cx.fill(); });
    cx.lineCap = 'round';
    [-1,1].forEach(function(sd){
      var gE = cx.createRadialGradient(cxm+sd*55,250,2,cxm+sd*55,250,34); gE.addColorStop(0,'rgba(60,40,35,0.13)'); gE.addColorStop(1,'rgba(60,40,35,0)');
      cx.fillStyle = gE; cx.fillRect(cxm+sd*55-40,210,80,80);
      cx.strokeStyle = 'rgba(95,82,76,0.45)'; cx.lineWidth = 5; cx.beginPath(); cx.moveTo(cxm+sd*30,228); cx.quadraticCurveTo(cxm+sd*56,219,cxm+sd*82,227); cx.stroke();
    });
    cx.fillStyle = 'rgba(150,85,75,0.12)'; cx.beginPath(); cx.ellipse(cxm,332,24,6,0,0,7); cx.fill();
  }, null, true);
}
function hairAlpha(){
  return canvasTex(512,256,function(cx,w,h){
    cx.fillStyle = '#000'; cx.fillRect(0,0,w,h); cx.fillStyle = '#fff';
    for(var x=0;x<w;x++){ var u = x/w, sd = Math.abs(u-0.5)/0.5;
      var vh = 0.27 + 0.33*Math.pow(sd,1.5);
      var ear = Math.exp(-Math.pow((sd-0.5)/0.075,2));
      vh -= 0.07*ear;
      cx.fillRect(x, 0, 1, Math.floor(vh*h)); }
  });
}
function hairColorTex(base){
  return canvasTex(512,256,function(cx,w,h){ cx.fillStyle = base; cx.fillRect(0,0,w,h); var r = HFA.mulberry32(66);
    for(var i=0;i<2600;i++){ var x=r()*w, y=r()*h, g=r(); cx.strokeStyle = g<0.35 ? 'rgba(210,208,202,0.35)' : 'rgba(20,18,16,0.35)'; cx.lineWidth = 1; cx.beginPath(); cx.moveTo(x,y); cx.lineTo(x+(r()-0.5)*6, y+8+r()*10); cx.stroke(); } }, null, true);
}
var CLOTH_BUMP = canvasTex(256,256,function(cx,w,h){ var r = HFA.mulberry32(314); cx.fillStyle = '#808080'; cx.fillRect(0,0,w,h);
  for(var y=0;y<h;y+=3){ cx.fillStyle = 'rgba(0,0,0,0.12)'; cx.fillRect(0,y,w,1); }
  for(var i=0;i<6000;i++){ var g = Math.floor(r()*255); cx.fillStyle = 'rgba('+g+','+g+','+g+',0.25)'; cx.fillRect(r()*w, r()*h, 1+r()*2, 1+r()*2); } }, [6,6], true);

function buildHuman(o){
  var M;
  if(o.sil){
    var sm = new THREE.MeshStandardMaterial({color:o.silCol||0x202226, roughness:0.58, metalness:0.0, transparent:true, opacity:1});
    M = {skin:sm, top:sm, bot:sm, hair:sm, shoe:sm, face:sm, hairS:sm, sil:sm};
  } else {
    M = { skin:std(o.skin||0xc39a7e,0.62), top:std(o.top,0.86), bot:std(o.bot,0.82), hair:std(o.hair||0x6a6661,0.92), shoe:std(0x28221e,0.5) };
    M.top.bumpMap = CLOTH_BUMP; M.top.bumpScale = 0.004; M.bot.bumpMap = CLOTH_BUMP; M.bot.bumpScale = 0.003;
    var hc = '#'+new THREE.Color(o.hair||0x6a6661).getHexString();
    M.face = new THREE.MeshStandardMaterial({ map:faceTex('#'+new THREE.Color(o.skin||0xc39a7e).getHexString()), roughness:0.6 });
    M.hairS = new THREE.MeshStandardMaterial({ map:hairColorTex(hc), alphaMap:hairAlpha(), alphaTest:0.5, roughness:0.78, side:THREE.FrontSide });
    if(o.transparent){ ['skin','top','bot','hair','shoe','face','hairS'].forEach(function(k){ M[k].transparent = true; M[k].opacity = 0; M[k].depthWrite = false; M[k].alphaTest = 0; }); }
  }
  var f = { root:new THREE.Group(), M:M, meshes:[], sil:!!o.sil };
  var hips = new THREE.Group(); hips.position.y = 0.92; f.root.add(hips); f.hips = hips;
  var spine = new THREE.Group(); hips.add(spine); f.spine = spine;
  var prof = [[0.0,-0.10],[0.13,-0.10],[0.165,-0.05],[0.172,0.05],[0.162,0.17],[0.158,0.27],[0.176,0.37],[0.192,0.43],[0.186,0.475],[0.15,0.51],[0.085,0.532],[0.052,0.54],[0.0,0.545]];
  var tg = new THREE.LatheGeometry(prof.map(function(p){ return new THREE.Vector2(p[0],p[1]); }), 40);
  var torso = new THREE.Mesh(tg, M.top); torso.scale.set(1.12,1,0.66); torso.castShadow = true; torso.receiveShadow = true; spine.add(torso);
  var neck = cyl(0.048,0.052,0.12,M.skin); neck.position.y = 0.575; spine.add(neck);
  var head = new THREE.Group(); head.position.y = 0.60; spine.add(head); f.head = head;
  if(o.sil){
    var sk = new THREE.Mesh(SIL_HEAD_GEO, M.sil); sk.scale.setScalar(1.08); sk.position.y = 0.115; sk.castShadow = true; sk.receiveShadow = true; head.add(sk);
  } else {
    var skull = new THREE.Mesh(HEAD_GEO, M.face); skull.scale.setScalar(1.05); skull.position.y = 0.115; skull.castShadow = true; skull.receiveShadow = true; head.add(skull);
    var hairG = new THREE.Mesh(HEAD_GEO, M.hairS); hairG.scale.set(1.05*1.045, 1.05*1.035, 1.05*1.05); hairG.position.set(0,0.119,-0.002); hairG.castShadow = true; head.add(hairG);
    var collar = new THREE.Mesh(new THREE.TorusGeometry(0.064,0.019,10,28), M.top);
    collar.rotation.x = Math.PI/2 - 0.25; collar.scale.set(1.05,0.85,1); collar.position.set(0,0.528,0.004); collar.castShadow = true; spine.add(collar);
    var earL = ball(0.02,0.55,1.45,1.0,M.skin); earL.position.set(0.093,0.112,-0.004); head.add(earL);
    var earR = ball(0.02,0.55,1.45,1.0,M.skin); earR.position.set(-0.093,0.112,-0.004); head.add(earR);
  }
  function arm(sx){
    var sh = new THREE.Group(); sh.position.set(sx*0.192,0.455,0); spine.add(sh);
    sh.add(ball(0.056,1,1,1,M.top));
    var ua = cyl(0.050,0.044,0.30,M.top); ua.position.y = -0.15; sh.add(ua);
    var el = new THREE.Group(); el.position.y = -0.30; sh.add(el);
    el.add(ball(0.045,1,1,1,M.top));
    var fa = cyl(0.043,0.035,0.26,M.top); fa.position.y = -0.13; el.add(fa);
    var hand = ball(0.034,1,2.1,1.45,M.skin); hand.position.y = -0.31; el.add(hand);
    return {sh:sh, el:el, hand:hand};
  }
  var aL = arm(1), aR = arm(-1); f.shL = aL.sh; f.elL = aL.el; f.shR = aR.sh; f.elR = aR.el; f.handL = aL.hand; f.handR = aR.hand;
  function leg(sx){
    var hp = new THREE.Group(); hp.position.set(sx*0.092,-0.04,0); hips.add(hp);
    var th = cyl(0.078,0.060,0.44,M.bot); th.position.y = -0.22; hp.add(th);
    var kn = new THREE.Group(); kn.position.y = -0.44; hp.add(kn);
    kn.add(ball(0.060,1,1,1,M.bot));
    var sn = cyl(0.058,0.046,0.40,M.bot); sn.position.y = -0.20; kn.add(sn);
    var ft = ball(0.05,1.05,0.8,2.5,M.shoe); ft.position.set(0,-0.43,0.05); kn.add(ft);
    return {hp:hp, kn:kn};
  }
  var lL = leg(1), lR = leg(-1); f.hpL = lL.hp; f.knL = lL.kn; f.hpR = lR.hp; f.knR = lR.kn;
  f.root.traverse(function(x){ if(x.isMesh) f.meshes.push(x); });
  f.root.visible = false;
  scene.add(f.root);
  return f;
}
/** đặt tư thế — mọi góc là hàm thuần của tham số. p.sit ∈ [0,1] trộn đứng↔ngồi. */
function pose(f, p){
  p = p || {};
  var s = p.sit != null ? p.sit : (p.seated ? 1 : 0);
  f.hips.position.set(0, lerp(0.92 + (p.bob||0), 0.50, s), 0);
  f.spine.rotation.set(p.lean||0, p.twist||0, p.roll||0);
  f.head.rotation.set(p.hp||0, p.hy||0, p.hr||0);
  f.shL.rotation.set(p.aLx!=null ? p.aLx : 0.02, p.aLy||0, p.aLz!=null ? p.aLz : 0.07);
  f.shR.rotation.set(p.aRx!=null ? p.aRx : 0.02, p.aRy||0, p.aRz!=null ? p.aRz : -0.07);
  f.elL.rotation.set(p.eL!=null ? p.eL : -0.12, 0, 0);
  f.elR.rotation.set(p.eR!=null ? p.eR : -0.12, 0, 0);
  f.hpL.rotation.set(lerp(p.lLx||0, -1.52, s), 0, lerp(0.015, 0.05, s)); f.hpR.rotation.set(lerp(p.lRx||0, -1.52, s), 0, lerp(-0.015, -0.05, s));
  f.knL.rotation.set(lerp(p.kL||0, 1.52, s), 0, 0); f.knR.rotation.set(lerp(p.kR||0, 1.52, s), 0, 0);
}
/** chu kỳ bước đi theo quãng đường (không tích luỹ theo frame) */
function walkPose(dist, amt){
  var ph = dist * 6.2831853 / 1.35, s = Math.sin(ph);
  return { lLx:0.40*s*amt, lRx:-0.40*s*amt, kL:0.55*Math.max(0,Math.sin(ph+1.3))*amt, kR:0.55*Math.max(0,Math.sin(ph+1.3+Math.PI))*amt,
    aLx:-0.28*s*amt, aRx:0.28*s*amt, bob:-0.018*Math.abs(Math.cos(ph))*amt, eL:-0.25, eR:-0.25 };
}
var POSE_DEF = {aLz:0.07, aRz:-0.07, eL:-0.12, eR:-0.12, aLx:0.02, aRx:0.02};
function mixPose(a, b, k){
  var o = {}, key;
  for(key in a) o[key] = a[key];
  for(key in b){ var va = a[key]!=null ? a[key] : (POSE_DEF[key]!=null ? POSE_DEF[key] : 0); o[key] = lerp(va, b[key], k); }
  return o;   /* overlay: khoá không có trong b giữ nguyên giá trị của a */
}
/** tư thế ĐỦ khoá (điền mặc định) — dùng khi nối chuỗi tư thế để khoá cũ trả về mặc định */
var POSE_KEYS = ['lean','twist','roll','hp','hy','hr','aLx','aLy','aLz','aRx','aRy','aRz','eL','eR','lLx','lRx','kL','kR','bob'];
function fullPose(p){ var o = {}; for(var i=0;i<POSE_KEYS.length;i++){ var k = POSE_KEYS[i]; o[k] = p[k]!=null ? p[k] : (POSE_DEF[k]!=null ? POSE_DEF[k] : 0); } if(p.sit!=null) o.sit = p.sit; return o; }
function place(f, x, z, heading, y){ f.root.position.set(x, y||0, z); f.root.rotation.set(0, heading, 0); }
function figShow(f, op){
  op = op == null ? 1 : op;
  f.root.visible = op > 0.004;
  if(f.sil){ f.M.sil.opacity = op; f.M.sil.depthWrite = op > 0.98; }
}

/* =========================================================================
 * REGISTRY — mỗi frame tắt hết, shot bật đúng cái nó cần
 * ========================================================================= */
var G = {};
function reg(name, obj){ G[name] = obj; obj.visible = false; scene.add(obj); return obj; }
function on(name){ G[name].visible = true; return G[name]; }
function setCam(px,py,pz, lx,ly,lz, fov){ camera.position.set(px,py,pz); camera.lookAt(lx,ly,lz); if(fov) camera.fov = fov; }
/* =========================================================================
 * GIÀN ĐÈN DÙNG CHUNG — mỗi bộ cảnh tự cấu hình lại (vị trí/màu/tầm) mỗi frame.
 * Ít đèn = shader MeshStandard gọn + chỉ 3 shadow map → nạp trang nhanh, render nhanh.
 * Số đèn KHÔNG đổi giữa các shot (chỉ đổi intensity) → không biên dịch lại shader.
 * ========================================================================= */
var sunL = new THREE.DirectionalLight(0xffffff, 0);
sunL.castShadow = true; sunL.shadow.mapSize.set(2048,2048); sunL.shadow.bias = -0.0005; sunL.shadow.normalBias = 0.02;
scene.add(sunL); scene.add(sunL.target);
function sunSet(col, px,py,pz, tx,ty,tz, half, far){
  sunL.color.setHex(col); sunL.position.set(px,py,pz); sunL.target.position.set(tx,ty,tz);
  var c = sunL.shadow.camera;
  if(c.right !== half || c.far !== far){ c.left = -half; c.right = half; c.top = half; c.bottom = -half; c.near = 0.5; c.far = far; c.updateProjectionMatrix(); }
}
var rimL = new THREE.DirectionalLight(0x9fb4d8, 0); scene.add(rimL); scene.add(rimL.target);
var hemiL = new THREE.HemisphereLight(0xffffff, 0x444444, 0); scene.add(hemiL);
function hemiSet(sky, ground){ hemiL.color.setHex(sky); hemiL.groundColor.setHex(ground); }
var ambL = new THREE.AmbientLight(0x1e2230, 0); scene.add(ambL);
var spotA = new THREE.SpotLight(0xffffff, 0, 30, 0.4, 0.2, 1.2);
spotA.castShadow = true; spotA.shadow.mapSize.set(2048,2048); spotA.shadow.bias = -0.0004; spotA.shadow.camera.near = 0.3;
scene.add(spotA); scene.add(spotA.target);
var spotB = new THREE.SpotLight(0xffffff, 0, 30, 0.5, 0.85, 1.2);
spotB.castShadow = true; spotB.shadow.mapSize.set(1024,1024); spotB.shadow.bias = -0.0005; spotB.shadow.radius = 4; spotB.shadow.camera.near = 0.3;
scene.add(spotB); scene.add(spotB.target);
var spotC = new THREE.SpotLight(0xffffff, 0, 30, 0.5, 0.6, 1.2); scene.add(spotC); scene.add(spotC.target);
var ptA = new THREE.PointLight(0xffffff, 0, 6, 1.5); scene.add(ptA);
var ptB = new THREE.PointLight(0xffffff, 0, 6, 1.5); scene.add(ptB);
var ptC = new THREE.PointLight(0xffffff, 0, 6, 1.5); scene.add(ptC);
function ptSet(L, col, x,y,z, dist, decay){ L.color.setHex(col); L.position.set(x,y,z); L.distance = dist; L.decay = decay; }
function spotCfg(L, col, dist, decay){ L.color.setHex(col); L.distance = dist; L.decay = decay; }

/* FX mỗi frame — reset trong resetFrame() */
var FX = { sat:1, mul:[1,1,1], flash:0, bloom:0.55 };

/* =========================================================================
 * TEXTURE VẬT LIỆU (dựng một lần)
 * ========================================================================= */
function woodTex(seed, base, dark, w, h, planks){
  return canvasTex(w, h, function(cx){
    var r = HFA.mulberry32(seed);
    cx.fillStyle = base; cx.fillRect(0,0,w,h);
    var ph = h/(planks||1);
    for(var p=0;p<(planks||1);p++){
      var y0 = p*ph, tone = (r()-0.5)*26;
      cx.fillStyle = 'rgba('+(tone>0?255:0)+','+(tone>0?235:0)+','+(tone>0?200:0)+','+Math.abs(tone)/255+')'; cx.fillRect(0,y0,w,ph);
      for(var i=0;i<80;i++){ var yy = y0 + r()*ph; cx.strokeStyle = dark; cx.globalAlpha = 0.05 + r()*0.10; cx.lineWidth = 1 + r()*2.5;
        cx.beginPath(); cx.moveTo(0,yy); for(var x=0;x<=w;x+=w/8) cx.lineTo(x, yy + Math.sin(x*0.01 + i)*3*r()); cx.stroke(); }
      cx.globalAlpha = 0.5; cx.fillStyle = dark; cx.fillRect(0, y0, w, 2);
      var off = r()*w; cx.fillRect(off, y0, 2, ph);
      cx.globalAlpha = 1;
    }
  }, null, false);
}
function noiseTex(seed, base, speck, w, h, n, a){
  return canvasTex(w, h, function(cx){ var r = HFA.mulberry32(seed); cx.fillStyle = base; cx.fillRect(0,0,w,h);
    for(var i=0;i<n;i++){ cx.fillStyle = speck; cx.globalAlpha = r()*a; var s = 1 + r()*3; cx.fillRect(r()*w, r()*h, s, s); } cx.globalAlpha = 1; });
}

/* =========================================================================
 * CAFE (x = 0) — quán cà phê trước ga, 10h sáng, bàn đôi cạnh cửa sổ
 * ========================================================================= */
var CX = 0;
var cafe = reg('cafe', new THREE.Group()); cafe.position.x = CX;
(function(){
  var fl = new THREE.Mesh(new THREE.PlaneGeometry(9, 9), new THREE.MeshStandardMaterial({ map:woodTex(11,'#6b4b33','#2a1a10',1024,1024,8), roughness:0.55 }));
  fl.material.map.wrapS = fl.material.map.wrapT = THREE.RepeatWrapping; fl.material.map.repeat.set(2,2);
  fl.rotation.x = -Math.PI/2; fl.position.set(0.8, 0, 0); fl.receiveShadow = true; cafe.add(fl);
  var plaster = new THREE.MeshStandardMaterial({ map:noiseTex(12,'#d8ccb6','#8a7c66',512,512,5000,0.18), roughness:0.92 });
  var wains = new THREE.MeshStandardMaterial({ map:woodTex(13,'#5a3d28','#20140c',512,512,1), roughness:0.6 });
  /* tường cửa sổ x = -1.15: khung + kính, mở ra phố */
  var WX = -1.15;
  var lowW = box(0.12, 0.8, 5.0, wains); lowW.position.set(WX, 0.4, 0); cafe.add(lowW);
  var upW = box(0.12, 0.5, 5.0, plaster); upW.position.set(WX, 2.6, 0); cafe.add(upW);
  var frameMat = std(0x2b2724, 0.5, 0.3);
  [-2.5,-1.25,0.0,1.25,2.5].forEach(function(z){ var m = box(0.08, 1.55, 0.07, frameMat); m.position.set(WX, 1.575, z); cafe.add(m); });
  var tr = box(0.08, 0.06, 5.0, frameMat); tr.position.set(WX, 2.05, 0); cafe.add(tr);
  var sill = box(0.3, 0.04, 5.0, wains); sill.position.set(WX+0.1, 0.82, 0); cafe.add(sill);
  var glass = new THREE.Mesh(new THREE.PlaneGeometry(5.0, 1.55), new THREE.MeshStandardMaterial({color:0xffffff, roughness:0.04, metalness:0.0, transparent:true, opacity:0.07, depthWrite:false}));
  glass.rotation.y = Math.PI/2; glass.position.set(WX, 1.575, 0); cafe.add(glass);
  /* phố ngoài cửa sổ: tranh mờ (độ sâu trường ảnh), tự phát sáng như ban ngày */
  /* vẽ ở 512×256 rồi để lọc tuyến tính phóng lên = mờ tự nhiên (KHÔNG dùng ctx.filter blur:
   * trên canvas phần mềm mỗi lệnh vẽ bị blur riêng → nạp trang >10s) */
  var street = canvasTex(512, 256, function(cx, w, h){ cx.save(); cx.scale(0.25, 0.25); w = 2048; h = 1024;
    var r = HFA.mulberry32(21);
    var sk = cx.createLinearGradient(0,0,0,h*0.55); sk.addColorStop(0,'#a9c3d8'); sk.addColorStop(1,'#e9ecea');
    cx.fillStyle = sk; cx.fillRect(0,0,w,h);
    var cols = ['#c9bda6','#b8b3aa','#d8d0c0','#a79d8c','#cfc6b4','#8d8a84'];
    for(var i=0;i<14;i++){ var bx = i*w/13 - 40 + r()*30, bw = w/13 + 20, bh = h*(0.28 + r()*0.3);
      cx.fillStyle = cols[i%cols.length]; cx.fillRect(bx, h*0.62-bh, bw, bh);
      for(var yy=h*0.62-bh+20; yy<h*0.58; yy+=46){ for(var xx=bx+14; xx<bx+bw-24; xx+=38){ cx.fillStyle = r()<0.5 ? '#6f7880' : '#8a949a'; cx.fillRect(xx, yy, 22, 26); } }
      if(r()<0.6){ cx.fillStyle = ['#8a3a2e','#2f5d6f','#6d6a3a'][i%3]; cx.fillRect(bx+10, h*0.62-70, bw-20, 26); } }
    for(var j=0;j<9;j++){ cx.fillStyle = r()<0.5 ? '#6f8a52' : '#58703f'; cx.beginPath(); cx.arc(r()*w, h*0.5 + r()*40, 50 + r()*50, 0, 7); cx.fill(); }
    cx.fillStyle = '#9d9a94'; cx.fillRect(0, h*0.62, w, h*0.08);
    cx.fillStyle = '#6d6c6a'; cx.fillRect(0, h*0.70, w, h*0.30);
    cx.fillStyle = '#e9e6de'; for(var k=0;k<12;k++) cx.fillRect(k*w/12 + 40, h*0.82, 90, 10);
    cx.restore();
  });
  var ext = new THREE.Mesh(new THREE.PlaneGeometry(16, 8), new THREE.MeshBasicMaterial({map:street, fog:false}));
  ext.material.color.setScalar(0.95); ext.rotation.y = Math.PI/2; ext.position.set(-6.5, 2.2, 0); cafe.add(ext);
  G.cafeExt = ext;
  /* tường sau lưng bạn (z = -2.5) + ốp gỗ + tranh treo + đèn tường */
  var bw1 = box(4.5, 2.8, 0.1, plaster); bw1.position.set(1.05, 1.4, -2.5); cafe.add(bw1);
  var bw1w = box(4.5, 0.9, 0.04, wains); bw1w.position.set(1.05, 0.45, -2.43); cafe.add(bw1w);
  var pic = box(0.7, 0.5, 0.03, std(0x2a2420,0.5)); pic.position.set(0.9, 1.7, -2.43); cafe.add(pic);
  var picIn = new THREE.Mesh(new THREE.PlaneGeometry(0.6,0.4), new THREE.MeshStandardMaterial({ map:canvasTex(256,170,function(cx,w,h){
    var g = cx.createLinearGradient(0,0,0,h); g.addColorStop(0,'#c9d6dc'); g.addColorStop(0.6,'#e8e0cc'); g.addColorStop(1,'#8a9a6a'); cx.fillStyle = g; cx.fillRect(0,0,w,h);
    cx.fillStyle = '#5b6b4a'; cx.beginPath(); cx.moveTo(0,h*0.7); cx.quadraticCurveTo(w*0.4,h*0.45,w,h*0.68); cx.lineTo(w,h); cx.lineTo(0,h); cx.fill(); }), roughness:0.7 }));
  picIn.position.set(0.9, 1.7, -2.41); cafe.add(picIn);
  /* tường sau lưng 私 (z = +2.5) */
  var bw2 = box(4.5, 2.8, 0.1, plaster); bw2.position.set(1.05, 1.4, 2.5); cafe.add(bw2);
  var bw2w = box(4.5, 0.9, 0.04, wains); bw2w.position.set(1.05, 0.45, 2.43); cafe.add(bw2w);
  /* quầy bên phải (x = 2.9) + máy pha + kệ tách */
  var counter = box(0.7, 1.0, 3.2, wains); counter.position.set(2.9, 0.5, -0.4); cafe.add(counter);
  var ctop = box(0.8, 0.05, 3.3, std(0x3a2a1e,0.35)); ctop.position.set(2.88, 1.02, -0.4); cafe.add(ctop);
  var mach = box(0.45, 0.42, 0.55, std(0xb9bcbf,0.25,0.9)); mach.position.set(3.0, 1.26, -1.1); cafe.add(mach);
  var backW = box(0.1, 2.8, 5.0, plaster); backW.position.set(3.35, 1.4, 0); cafe.add(backW);
  for(var s=0;s<2;s++){ var sh = box(0.26, 0.03, 2.2, wains); sh.position.set(3.2, 1.55 + s*0.4, -0.3); cafe.add(sh);
    for(var c=0;c<8;c++){ var cp = cyl(0.04, 0.035, 0.08, std(0xf1eee8,0.3)); cp.position.set(3.2, 1.61 + s*0.4, -1.2 + c*0.26); cafe.add(cp); } }
  var ceil = new THREE.Mesh(new THREE.PlaneGeometry(9,9), std(0xe6dfd2,0.95)); ceil.rotation.x = Math.PI/2; ceil.position.set(0.8, 2.85, 0); cafe.add(ceil);
  /* đèn thả trên bàn */
  var cord = cyl(0.004,0.004,0.95, std(0x111111,0.5)); cord.position.set(-0.55, 2.38, 0); cafe.add(cord);
  var shadeG = new THREE.LatheGeometry([[0.02,0.0],[0.05,-0.02],[0.13,-0.14],[0.16,-0.2]].map(function(p){ return new THREE.Vector2(p[0],p[1]); }), 32);
  var shade = new THREE.Mesh(shadeG, new THREE.MeshStandardMaterial({color:0x2c3a33, roughness:0.45, metalness:0.2, side:THREE.DoubleSide})); shade.position.set(-0.55, 1.92, 0); cafe.add(shade);
  var bulb = new THREE.Mesh(new THREE.SphereGeometry(0.04, 16, 12), new THREE.MeshBasicMaterial({color:new THREE.Color(4.0,2.8,1.6)})); bulb.position.set(-0.55, 1.76, 0); cafe.add(bulb);
  /* bàn tròn gỗ óc chó + chân trụ */
  var walnut = new THREE.MeshStandardMaterial({ map:woodTex(14,'#4a2f1e','#1a0e08',512,512,1), roughness:0.42 });
  var top = cyl(0.37, 0.37, 0.035, walnut, 48); top.position.set(-0.55, 0.72, 0); cafe.add(top);
  var ped = cyl(0.04, 0.05, 0.7, std(0x1d1b1a,0.4,0.6)); ped.position.set(-0.55, 0.36, 0); cafe.add(ped);
  var foot = cyl(0.22, 0.24, 0.03, std(0x1d1b1a,0.4,0.6), 32); foot.position.set(-0.55, 0.015, 0); cafe.add(foot);
  /* ghế gỗ */
  function chair(z, flip){
    var g = new THREE.Group(); var wd = std(0x5e3f28, 0.6);
    var seat = box(0.42, 0.04, 0.42, wd); seat.position.y = 0.45; g.add(seat);
    [[-0.18,-0.18],[0.18,-0.18],[-0.18,0.18],[0.18,0.18]].forEach(function(q){ var l = cyl(0.018,0.016,0.45,wd); l.position.set(q[0],0.225,q[1]); g.add(l); });
    var back = box(0.42, 0.34, 0.03, wd); back.position.set(0, 0.8, -0.2); g.add(back);
    [[-0.19],[0.19]].forEach(function(q){ var p = cyl(0.016,0.016,0.4,wd); p.position.set(q[0],0.66,-0.2); g.add(p); });
    g.position.set(-0.55, 0, z); g.rotation.y = flip ? Math.PI : 0; cafe.add(g);
  }
  chair(-0.72, false); chair(0.72, true);
  /* lọ hoa nhỏ bên cửa sổ */
  var vase = cyl(0.03, 0.025, 0.12, new THREE.MeshStandardMaterial({color:0x9fb8c2, roughness:0.1, transparent:true, opacity:0.55})); vase.position.set(-0.82, 0.8, 0.05); cafe.add(vase);
  var stem = cyl(0.003,0.003,0.2, std(0x4a6a32,0.7)); stem.position.set(-0.82, 0.93, 0.05); cafe.add(stem);
  var bloomF = ball(0.025,1,0.8,1, std(0xe8d27a,0.6)); bloomF.position.set(-0.82, 1.04, 0.05); cafe.add(bloomF);
})();
/* tách + đĩa (Lathe — liền khối, không ghép cầu) */
var CUP_PROF = [[0.0,0.004],[0.028,0.004],[0.032,0.008],[0.036,0.03],[0.041,0.07],[0.043,0.082],[0.039,0.082],[0.036,0.07],[0.031,0.03],[0.026,0.012],[0.0,0.012]];
var SAUCER_PROF = [[0.0,0.0],[0.05,0.0],[0.066,0.004],[0.075,0.012],[0.078,0.016],[0.074,0.016],[0.064,0.009],[0.0,0.007]];
var porcelain = new THREE.MeshStandardMaterial({color:0xf3f0ea, roughness:0.18, metalness:0.0});
function makeCup(){
  var g = new THREE.Group();
  var cup = new THREE.Mesh(new THREE.LatheGeometry(CUP_PROF.map(function(p){ return new THREE.Vector2(p[0],p[1]); }), 40), porcelain);
  cup.material.side = THREE.DoubleSide; cup.castShadow = true; cup.receiveShadow = true; cup.position.y = 0.008; g.add(cup);
  var handle = new THREE.Mesh(new THREE.TorusGeometry(0.018, 0.0045, 10, 20, Math.PI*1.2), porcelain); handle.rotation.z = -Math.PI*0.6; handle.position.set(0.045, 0.052, 0); handle.castShadow = true; g.add(handle);
  var coffee = new THREE.Mesh(new THREE.CircleGeometry(0.038, 32), new THREE.MeshStandardMaterial({color:0x1f110a, roughness:0.08, metalness:0.0}));
  coffee.rotation.x = -Math.PI/2; coffee.position.y = 0.074; g.add(coffee);
  var saucer = new THREE.Mesh(new THREE.LatheGeometry(SAUCER_PROF.map(function(p){ return new THREE.Vector2(p[0],p[1]); }), 40), porcelain);
  saucer.castShadow = true; saucer.receiveShadow = true;
  var S = new THREE.Group(); S.add(saucer); S.add(g); g.userData.saucer = S;
  var spoon = box(0.004, 0.002, 0.07, std(0xcfd2d4,0.2,1)); spoon.position.set(0.05, 0.012, 0.02); spoon.rotation.y = 0.3; S.add(spoon);
  return {saucer:S, cup:g};
}
var cupF = makeCup(); cupF.saucer.position.set(-0.55, 0.74, -0.2); cafe.add(cupF.saucer);
var cupM = makeCup(); cupM.saucer.position.set(-0.50, 0.74, 0.21); cupM.saucer.rotation.y = Math.PI; cafe.add(cupM.saucer);
/* hơi nước bốc từ tách của bạn — nguội dần qua C02–C04 */
var steam = makePoints(90, {size:0.012, maxPx:22, near:0.25, gain:1});
var STEAM_R = (function(){ var r = HFA.mulberry32(31), a = []; for(var i=0;i<90;i++) a.push([r(), r(), r()]); return a; })();
function setSteam(t, amt, baseX, baseY, baseZ){
  for(var i=0;i<90;i++){ var q = STEAM_R[i]; var ph = (t*0.16 + q[0]) % 1;
    var y = baseY + ph*0.22, sw = 0.012*Math.sin(t*0.9 + q[1]*6.28 + ph*5.0) + (q[2]-0.5)*0.02*ph*3;
    ptsSet(steam, i, baseX + sw, y, baseZ + 0.01*Math.cos(t*0.7+q[2]*6.28), 0.9, 0.88, 0.85, amt*0.10*Math.sin(ph*Math.PI)*(1-ph*0.5), 0.012 + ph*0.03); }
  ptsDone(steam);
}
/* người trong quán */
var friendC = buildHuman({top:0x6a735e, bot:0x3b3a3f, hair:0x8e8983, skin:0xc9a488});
var meC = buildHuman({top:0x2f3b4e, bot:0x3a3632, hair:0x9d9b97, skin:0xbd977b});
/* đèn quán — giàn chung: sunL + hemiL + ptA (đèn thả) + ptB (bù) */
var sunC = sunL, hemiC = hemiL, lampC = ptA, fillC = ptB;
function cafeLights(k, warm){
  k *= 0.62;
  sunSet(0xfff0da, CX-7, 4.2, 1.6, CX-0.4, 0.7, 0, 3.2, 20); hemiSet(0xe9eef2, 0x6a5a48);
  ptSet(ptA, 0xffc27a, CX-0.55, 1.72, 0, 4.0, 1.6); ptSet(ptB, 0xf3ede4, CX+1.8, 2.0, 0.6, 7, 1.5);
  sunC.intensity = 2.2*k; hemiC.intensity = 0.55*k; lampC.intensity = (0.9 + 0.8*(warm||0))*k; fillC.intensity = 0.55*k;
  scene.environment = envDay;
}

/* =========================================================================
 * BUS (x = 100) — xe buýt tuyến buổi sáng
 * ========================================================================= */
var BX = 100;
var bus = reg('bus', new THREE.Group()); bus.position.x = BX;
var busIn = new THREE.Group(); bus.add(busIn);
var BUS_WZ = -1.25;   /* mặt kính cửa sổ bên 私 */
(function(){
  var rubber = new THREE.MeshStandardMaterial({ map:canvasTex(256,256,function(cx,w,h){ cx.fillStyle = '#4a4e55'; cx.fillRect(0,0,w,h);
    cx.fillStyle = '#3b3e44'; for(var y=8;y<h;y+=16) for(var x=8;x<w;x+=16){ cx.beginPath(); cx.arc(x + ((y/16)%2)*8, y, 3.5, 0, 7); cx.fill(); } }, [16,4]), roughness:0.8 });
  var floor = box(10.5, 0.05, 2.6, rubber); floor.position.set(0, -0.025, 0); busIn.add(floor);
  var panel = std(0xd8d6d0, 0.55), dark = std(0x2b2d31, 0.5, 0.2);
  [BUS_WZ, -BUS_WZ].forEach(function(z, side){
    var lw = box(10.5, 0.95, 0.06, panel); lw.position.set(0, 0.475, z + (side ? 0.03 : -0.03)); busIn.add(lw);
    var uw = box(10.5, 0.42, 0.06, panel); uw.position.set(0, 2.06, z + (side ? 0.03 : -0.03)); busIn.add(uw);
    for(var x=-5.2; x<=5.3; x+=1.3){ var p = box(0.1, 0.92, 0.07, dark); p.position.set(x, 1.4, z); busIn.add(p); }
    var bar = box(10.5, 0.04, 0.05, dark); bar.position.set(0, 1.62, z); busIn.add(bar);
    var gl = new THREE.Mesh(new THREE.PlaneGeometry(10.5, 0.9), new THREE.MeshStandardMaterial({color:0xdfe9ea, roughness:0.03, metalness:0.0, transparent:true, opacity:0.06, depthWrite:false}));
    gl.position.set(0, 1.4, z); gl.rotation.y = side ? Math.PI : 0; busIn.add(gl);
  });
  var ceil = box(10.5, 0.05, 2.6, std(0xecebe6, 0.8)); ceil.position.set(0, 2.28, 0); busIn.add(ceil);
  [-0.6, 0.6].forEach(function(z){ var s = new THREE.Mesh(new THREE.BoxGeometry(9.5, 0.03, 0.12), new THREE.MeshBasicMaterial({color:new THREE.Color(1.3,1.3,1.25)})); s.position.set(0, 2.245, z); busIn.add(s); });
  /* ghế đơn bọc nỉ xanh, quay về phía trước (+x) */
  var moq = new THREE.MeshStandardMaterial({ map:canvasTex(256,256,function(cx,w,h){ var r = HFA.mulberry32(41); cx.fillStyle = '#2d4f86'; cx.fillRect(0,0,w,h);
    for(var i=0;i<3000;i++){ cx.fillStyle = r()<0.5 ? 'rgba(20,35,70,0.5)' : 'rgba(90,120,170,0.35)'; cx.fillRect(r()*w, r()*h, 2, 2); }
    cx.strokeStyle = 'rgba(200,170,90,0.35)'; cx.lineWidth = 3; for(var y=20;y<h;y+=40){ cx.beginPath(); cx.moveTo(0,y); for(var x=0;x<=w;x+=16) cx.lineTo(x, y + ((x/16)%2 ? 6 : -6)); cx.stroke(); } }, [2,2]), roughness:0.92 });
  var pole = std(0xe0a526, 0.4, 0.3), chrome = std(0xc9ccd0, 0.25, 0.9);
  function seat(x, z){
    var g = new THREE.Group();
    var cu = box(0.46, 0.12, 0.46, moq); cu.position.set(0, 0.44, 0); g.add(cu);
    var bk = box(0.08, 0.58, 0.46, moq); bk.position.set(-0.24, 0.76, 0); bk.rotation.z = 0.12; g.add(bk);
    var gh = new THREE.Mesh(new THREE.TorusGeometry(0.1, 0.012, 8, 20, Math.PI), chrome); gh.position.set(-0.28, 1.06, 0); gh.rotation.x = Math.PI/2; gh.rotation.z = Math.PI/2; g.add(gh);
    var leg = cyl(0.02, 0.02, 0.38, chrome); leg.position.set(0, 0.19, 0); g.add(leg);
    g.position.set(x, 0, z); busIn.add(g);
  }
  for(var i=-4;i<=4;i++) seat(i*1.0, -0.82);
  for(var j=-4;j<=0;j++) seat(j*1.0, 0.82);
