/* trang bài báo: canvas A4, chữ thật của trích dẫn + các dòng thân bài */
function paperSheet(spec){
  var tx = canvasTex(1024, 1448, function(cx, w, h){
    var r = HFA.mulberry32(spec.seed);
    cx.fillStyle = '#f2ede2'; cx.fillRect(0,0,w,h);
    for(var i=0;i<4000;i++){ cx.fillStyle = 'rgba(120,100,70,'+(r()*0.05)+')'; cx.fillRect(r()*w, r()*h, 2, 2); }
    cx.fillStyle = '#3a3a3a'; cx.font = 'italic 30px Georgia, "Times New Roman", serif'; cx.textAlign = 'left'; cx.textBaseline = 'alphabetic';
    cx.fillText(spec.journal, 80, 100); cx.textAlign = 'right'; cx.fillText(spec.vol, w-80, 100);
    cx.fillStyle = '#555'; cx.fillRect(80, 118, w-160, 2);
    cx.textAlign = 'left'; cx.fillStyle = '#141414'; cx.font = '700 50px Georgia, "Times New Roman", serif';
    var words = spec.title.split(' '), line = '', y = 210;
    for(var k=0;k<words.length;k++){ var test = line + words[k] + ' '; if(cx.measureText(test).width > w-160 && line){ cx.fillText(line, 80, y); line = words[k]+' '; y += 64; } else line = test; }
    cx.fillText(line, 80, y); y += 70;
    cx.font = '32px Georgia, "Times New Roman", serif'; cx.fillStyle = '#2a2a2a'; cx.fillText(spec.authors, 80, y); y += 44;
    cx.font = 'italic 26px Georgia, "Times New Roman", serif'; cx.fillStyle = '#555'; cx.fillText(spec.aff, 80, y); y += 70;
    cx.fillStyle = '#222'; cx.font = '700 28px Georgia, serif'; cx.fillText('Abstract', 80, y); y += 30;
    for(var ln=0; ln<30; ln++){ var col = ln < 9 ? 0 : (ln % 2); var cxX = ln < 9 ? 80 : (col ? w/2 + 20 : 80); var cw = ln < 9 ? w-160 : w/2 - 100;
      var yy = ln < 9 ? y + ln*30 : y + 9*30 + 30 + Math.floor((ln-9)/2)*30;
      for(var q=0;q<cw;){ var ww = 20 + r()*70; if(q+ww > cw) ww = cw-q; cx.fillStyle = 'rgba(40,40,40,'+(0.45+r()*0.2)+')'; cx.fillRect(cxX+q, yy, ww, 11); q += ww + 9; } }
    cx.fillStyle = '#777'; cx.font = '22px Georgia, serif'; cx.textAlign = 'center'; cx.fillText(spec.foot, w/2, h-60);
  });
  var geo = new THREE.PlaneGeometry(0.21, 0.297, 24, 24);
  var P = geo.attributes.position; for(var i=0;i<P.count;i++){ var x = P.getX(i), y = P.getY(i); P.setZ(i, 0.004*Math.sin((x/0.21+0.5)*Math.PI) + 0.006*Math.pow((y/0.297+0.5),3)); }
  geo.computeVertexNormals();
  var m = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({map:tx, roughness:0.85, side:THREE.DoubleSide}));
  m.rotation.x = -Math.PI/2; m.receiveShadow = true; m.castShadow = true; m.visible = false; paperSet.add(m);
  return m;
}
