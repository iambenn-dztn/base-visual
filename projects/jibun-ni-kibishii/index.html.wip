/* =========================================================================
 * HEAD (x = 500) — mạng điểm sáng trong đầu (ẩn dụ; không vẽ giải phẫu chi tiết)
 * ========================================================================= */
var HX = 500;
var SHELL_VS = 'varying vec3 vN; varying vec3 vV; void main(){ vec4 w=modelMatrix*vec4(position,1.0);'+
  ' vN=normalize(mat3(modelMatrix)*normal); vV=normalize(cameraPosition-w.xyz); gl_Position=projectionMatrix*viewMatrix*w; }';
var SHELL_FS = 'uniform vec3 uCol; uniform float uOp; varying vec3 vN; varying vec3 vV;'+
  ' void main(){ float f=pow(1.0-abs(dot(normalize(vN),normalize(vV))),2.4); gl_FragColor=vec4(uCol*f*uOp,1.0); }';
function shellMat(col){ return new THREE.ShaderMaterial({ uniforms:{uCol:{value:new THREE.Color(col)}, uOp:{value:1}}, vertexShader:SHELL_VS, fragmentShader:SHELL_FS,
  transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, fog:false }); }
var NODE_N = 460;
function buildBrainHead(seed){
  var g = new THREE.Group();
  var sm = shellMat(0x8fa6c8);
  var sk = new THREE.Mesh(HEAD_GEO, sm); sk.position.y = 0.115; g.add(sk);
  var prof = [[0.0,-0.10],[0.13,-0.10],[0.165,-0.05],[0.172,0.05],[0.162,0.17],[0.158,0.27],[0.176,0.37],[0.192,0.43],[0.186,0.475],[0.15,0.51],[0.085,0.532],[0.052,0.54],[0.0,0.545]];
  var tor = new THREE.Mesh(new THREE.LatheGeometry(prof.map(function(p){ return new THREE.Vector2(p[0],p[1]); }), 48), sm);
  tor.scale.set(1.12, 1, 0.66); tor.position.y = -0.60 + 0.0; g.add(tor);
  var nk = new THREE.Mesh(new THREE.CylinderGeometry(0.048, 0.052, 0.12, 24, 1, true), sm); nk.position.y = -0.025; g.add(nk);
  /* nút: rải trong khối não (ellipsoid), tất định */
  var r = HFA.mulberry32(seed), pos = [];
  while(pos.length < NODE_N){ var x = (r()*2-1), y = (r()*2-1), z = (r()*2-1); if(x*x+y*y+z*z > 1) continue;
    pos.push(new THREE.Vector3(x*0.072, 0.142 + y*0.058, 0.004 + z*0.084)); }
  var pts = makePoints(NODE_N, {size:0.0038, maxPx:12, near:0.05, order:27}); scene.remove(pts); g.add(pts);
  /* dây nối: mỗi nút → 2 nút gần nhất */
  var segs = [];
  for(var i=0;i<NODE_N;i++){ var best = [1e9,1e9], bi = [-1,-1];
    for(var j=0;j<NODE_N;j++){ if(j===i) continue; var d = pos[i].distanceToSquared(pos[j]); if(d < best[0]){ best[1]=best[0]; bi[1]=bi[0]; best[0]=d; bi[0]=j; } else if(d < best[1]){ best[1]=d; bi[1]=j; } }
    for(var q=0;q<2;q++) if(bi[q] > i) segs.push(i, bi[q]); }
  var lp = new Float32Array(segs.length*3), lc = new Float32Array(segs.length*3);
  for(var s=0;s<segs.length;s++){ var v = pos[segs[s]]; lp[s*3]=v.x; lp[s*3+1]=v.y; lp[s*3+2]=v.z; }
  var lg = new THREE.BufferGeometry(); lg.setAttribute('position', new THREE.BufferAttribute(lp,3)); lg.setAttribute('color', new THREE.BufferAttribute(lc,3));
  var lines = new THREE.LineSegments(lg, new THREE.LineBasicMaterial({vertexColors:true, transparent:true, blending:THREE.AdditiveBlending, depthWrite:false, fog:false}));
  lines.renderOrder = 26; g.add(lines);
  g.userData = {shell:sm, pts:pts, pos:pos, lines:lines, segs:segs};
  g.scale.setScalar(9); g.visible = false; scene.add(g);
  return g;
}
var brainA = buildBrainHead(111), brainB = buildBrainHead(112);
/* vùng (toạ độ đầu, mặt hướng +z): tự phê bình → trán bên + đai trước lưng (lạnh);
   tự trấn an → cực thái dương + thuỳ đảo (ấm). Theo mô tả của Longe 2010. */
var REG_CRIT = [[0.045,0.170,0.055],[-0.045,0.170,0.055],[0.0,0.165,0.035]];
var REG_REAS = [[0.060,0.100,0.045],[-0.060,0.100,0.045],[0.045,0.125,0.005],[-0.045,0.125,0.005]];
function regionW(v, R, s){ var w = 0; for(var i=0;i<R.length;i++){ var dx=v.x-R[i][0], dy=v.y-R[i][1], dz=v.z-R[i][2]; w = Math.max(w, Math.exp(-(dx*dx+dy*dy+dz*dz)/(s*s))); } return w; }
[brainA, brainB].forEach(function(b){ var o = {crit:[], reas:[]}; for(var i=0;i<NODE_N;i++){ o.crit.push(regionW(b.userData.pos[i], REG_CRIT, 0.026)); o.reas.push(regionW(b.userData.pos[i], REG_REAS, 0.022)); } b.userData.W = o; });
/** crit/reas: mức kích hoạt; blur: tan rã (C40); t: nhịp thở nhẹ */
function setBrain(b, t, crit, reas, blur, shellOp){
  b.visible = true;
  var ud = b.userData, pts = ud.pts, P = ud.pos, rnd = R26, BW = ud.W;
  b.userData.shell.uniforms.uOp.value = shellOp;
  for(var i=0;i<NODE_N;i++){
    var wc = BW.crit[i]*crit, wr = BW.reas[i]*reas;
    var pulse = 0.85 + 0.15*Math.sin(t*2.2 + rnd[i][0]*20);
    var base = 0.10;
    var rC = 0.55*base + 0.75*wc + 1.9*wr, gC = 0.62*base + 0.95*wc + 1.15*wr, bC = 0.85*base + 1.9*wc + 0.45*wr;
    var jx = (rnd[i][1]-0.5)*0.03*blur, jy = (rnd[i][2]-0.5)*0.03*blur, jz = (rnd[i][3]-0.5)*0.03*blur;
    var grey = blur*0.6; var l = (rC+gC+bC)/3; rC = lerp(rC, l, grey); gC = lerp(gC, l, grey); bC = lerp(bC, l, grey);
    ptsSet(pts, i, P[i].x + jx, P[i].y + jy, P[i].z + jz, rC*pulse, gC*pulse, bC*pulse, 1, 0.028 + 0.03*(wc+wr));
  }
  ptsDone(pts);
  var lc = ud.lines.geometry.attributes.color.array, sg = ud.segs;
  for(var s=0;s<sg.length;s++){ var k = sg[s]; var wc2 = BW.crit[k]*crit, wr2 = BW.reas[k]*reas;
    var f = (0.10 + 0.5*wc2 + 0.5*wr2)*(1 - 0.6*blur);
    lc[s*3] = f*(0.5 + 1.2*wr2); lc[s*3+1] = f*(0.6 + 0.6*wr2 + 0.4*wc2); lc[s*3+2] = f*(0.9 + 1.0*wc2); }
  ud.lines.geometry.attributes.color.needsUpdate = true;
}

