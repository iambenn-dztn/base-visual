};
SH.C28 = function(u, t){   /* thở ra một chút — 私 trong ánh ấm dịu */
  voidBase(1, 0.8);
  spot(warmSpot, 0.8, 6.0, 2.4, 0, 0, 0, 26, 0.42, 0.9);
  spotBeam(beamWarm, warmSpot, 0.06);
  figV(figS, 0, 0, 0.15, {hp:lerp(0.20, 0.02, ramp(t, 331.5, 335.0)), lean:lerp(0.08, 0, ramp(t, 331.5, 335.0))});
  var p = u/dur('C28');
