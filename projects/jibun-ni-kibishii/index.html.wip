var SX = 400;
var scanSet = reg('scan', new THREE.Group()); scanSet.position.x = SX;
(function(){
  var vinyl = new THREE.Mesh(new THREE.PlaneGeometry(14, 14), new THREE.MeshStandardMaterial({ map:noiseTex(101,'#b7bcbf','#8a9094',512,512,6000,0.25), roughness:0.5 }));
  vinyl.rotation.x = -Math.PI/2; vinyl.receiveShadow = true; scanSet.add(vinyl);
  var wall = box(14, 4, 0.1, std(0xdfe3e4, 0.9)); wall.position.set(0, 2, -3.2); scanSet.add(wall);
  var sh = new THREE.Shape(); var R = 1.05, rr = 0.25;
  sh.moveTo(-R+rr, -R); sh.lineTo(R-rr, -R); sh.quadraticCurveTo(R, -R, R, -R+rr); sh.lineTo(R, R-rr); sh.quadraticCurveTo(R, R, R-rr, R);
  sh.lineTo(-R+rr, R); sh.quadraticCurveTo(-R, R, -R, R-rr); sh.lineTo(-R, -R+rr); sh.quadraticCurveTo(-R, -R, -R+rr, -R);
  var hole = new THREE.Path(); hole.absarc(0, 0.12, 0.34, 0, Math.PI*2, true); sh.holes.push(hole);
  var geo = new THREE.ExtrudeGeometry(sh, {depth:1.6, bevelEnabled:true, bevelThickness:0.06, bevelSize:0.05, bevelSegments:4, curveSegments:48});
  var housing = new THREE.Mesh(geo, new THREE.MeshStandardMaterial({color:0xf1f2f0, roughness:0.32, metalness:0.0}));
  housing.castShadow = true; housing.receiveShadow = true; housing.position.set(0, 1.05, -1.9); scanSet.add(housing);
  var bez = new THREE.Mesh(new THREE.TorusGeometry(0.36, 0.035, 16, 64), std(0xc9ccd0, 0.35)); bez.position.set(0, 1.17, -0.24); scanSet.add(bez);
  var boreLight = new THREE.Mesh(new THREE.CylinderGeometry(0.335, 0.335, 1.5, 48, 1, true), new THREE.MeshBasicMaterial({color:new THREE.Color(1.1,1.2,1.3), side:THREE.BackSide}));
  boreLight.rotation.x = Math.PI/2; boreLight.position.set(0, 1.17, -1.05); scanSet.add(boreLight);
  var stripe = new THREE.Mesh(new THREE.TorusGeometry(0.72, 0.012, 8, 64, Math.PI), new THREE.MeshBasicMaterial({color:new THREE.Color(0.6,1.4,2.2)})); stripe.position.set(0, 1.17, -0.27); scanSet.add(stripe);
  var ped = box(0.5, 0.62, 1.6, std(0xe3e5e4, 0.5)); ped.position.set(0, 0.31, 0.75); scanSet.add(ped);
  var tbl = box(0.55, 0.08, 2.3, std(0xf4f4f2, 0.45)); tbl.position.set(0, 0.86, 0.15); scanSet.add(tbl);
  var cush = box(0.48, 0.05, 2.1, std(0x3f5f8a, 0.85)); cush.position.set(0, 0.925, 0.15); scanSet.add(cush);
})();
