/* =========================================================================
 * MỖI FRAME: tắt hết rồi shot bật cái nó cần
 * ========================================================================= */
var ALL_FIGS = [friendC, meC, meB, paxB, meR, friR, figS, figJ, figF, figX, patient];
var ALL_PTS = [steam, dots26, crowd, others, haze, ringP, pathP, threadP, burstP, lineP];
var ALL_BEAMS = [beamCold, beamWarm, beamTop, beamOut, beamGrey];
var ALL_LIGHTS = [sunL, rimL, hemiL, ambL, spotA, spotB, spotC, ptA, ptB, ptC];
function resetFrame(){
  var k;
  for(k in G){ if(G[k] && G[k].isObject3D && G[k].parent === scene) G[k].visible = false; }
  for(var i=0;i<ALL_FIGS.length;i++) ALL_FIGS[i].root.visible = false;
  for(i=0;i<ALL_PTS.length;i++) ALL_PTS[i].visible = false;
  for(i=0;i<ALL_BEAMS.length;i++) ALL_BEAMS[i].visible = false;
  for(i=0;i<ALL_LIGHTS.length;i++) ALL_LIGHTS[i].intensity = 0;
  for(i=0;i<PILLARS.length;i++){ PILLARS[i].visible = false; PILLARS[i].scale.setScalar(1); }
  for(i=0;i<orbs.length;i++) orbs[i].visible = false;
  for(k in PAPERS) PAPERS[k].visible = false;
  for(i=0;i<CARD_N;i++){ cardsA[i].visible = false; cardsB[i].visible = false; }
  brainA.visible = false; brainB.visible = false;
  hideLabels();
  FX.sat = 1; FX.mul = [1,1,1]; FX.flash = 0; FX.dip = 1;
  bloomPass.strength = 0.55;
  bgMat.uniforms.uTop.value.setRGB(0,0,0); bgMat.uniforms.uBot.value.setRGB(0,0,0);
  scene.fog.near = 900; scene.fog.far = 1400; scene.fog.color.setRGB(0,0,0);
  scene.environment = envDark;
  camera.fov = 40;
}
function camV(x,y,z,lx,ly,lz,fov){ setCam(VX+x,y,z,VX+lx,ly,lz,fov); }
function camC(x,y,z,lx,ly,lz,fov){ setCam(CX+x,y,z,CX+lx,ly,lz,fov); }
function camB(x,y,z,lx,ly,lz,fov){ setCam(BX+x,y,z,BX+lx,ly,lz,fov); }
function camP(x,y,z,lx,ly,lz,fov){ setCam(PX+x,y,z,PX+lx,ly,lz,fov); }
function camL(a, b, p){ return [lerp(a[0],b[0],p), lerp(a[1],b[1],p), lerp(a[2],b[2],p)]; }
function fig(f, x, z, heading, p, op){ figShow(f, op==null?1:op); place(f, x, z, heading); pose(f, p||{}); }
function figV(f, x, z, heading, p, op){ fig(f, VX+x, z, heading, p, op); }
function lblV(l, x, y, z, op){ showLabel(l, VX+x, y, z, op); }

/* ---- nền + đèn chung của VOID ---- */
function voidBase(k, warmth){
  on('void'); voidLights();
  scene.environment = envDark;
  var w = warmth||0;
  bgMat.uniforms.uTop.value.setRGB(lerp(0.010,0.016,w), lerp(0.012,0.012,w), lerp(0.018,0.010,w));
  bgMat.uniforms.uBot.value.setRGB(0.004, 0.004, 0.005);
  scene.fog.color.setRGB(0.006, 0.006, 0.008); scene.fog.near = 9; scene.fog.far = 34;
  ambV.intensity = 0.45*k; rimV.intensity = 0.55*k;
  rimV.color.setRGB(lerp(0.62,0.95,w), lerp(0.70,0.75,w), lerp(0.85,0.6,w));
}
function cafeBase(k, warm){
  on('cafe'); cafeLights(k, warm);
  bgMat.uniforms.uTop.value.setRGB(0.6,0.62,0.64); bgMat.uniforms.uBot.value.setRGB(0.3,0.28,0.25);
}
function busBase(t, k){
  on('bus'); busLights(k, t); setTown(t);
  bgMat.uniforms.uTop.value.setRGB(0.55,0.70,0.90); bgMat.uniforms.uBot.value.setRGB(0.85,0.87,0.86);
  scene.fog.color.setRGB(0.80,0.84,0.88); scene.fog.near = 30; scene.fog.far = 140;
  /* dây treo lắc theo gia tốc (hàm của t) */
  var sw = 0.05*Math.sin(t*1.1) + 0.03*Math.sin(t*2.3 + 1.0);
  for(var i=0;i<G.straps.length;i++) G.straps[i].rotation.x = sw*(0.8 + 0.2*Math.sin(i*1.7)) * busSpeedK(t);
}
/* tư thế người trên xe */
function meBusPose(t, extra){
  var p = {sit:1, lean:0.04, hy:0.72, hp:0.06, aLx:-0.42, eL:-0.95, aRx:-0.42, eR:-0.95, aLz:-0.05, aRz:0.05};
  p.hr = 0.012*Math.sin(t*1.3); if(extra) for(var k in extra) p[k] = extra[k];
  return p;
}
function busPeople(t, meP){
  fig(meB, BX+0.02, -0.82, Math.PI/2, meP);
  fig(paxB, BX-3.0, 0.82, Math.PI/2, {sit:1, lean:0.12, hp:0.38, aLx:-0.5, eL:-1.1, aRx:-0.5, eR:-1.1, aLz:-0.1, aRz:0.1});
}
function reflect(meOp, friOp, meP, friP){
  if(meOp > 0.003){ humanOpacity(meR, meOp); place(meR, 0.02, -0.82, Math.PI/2); pose(meR, meP); }
  if(friOp > 0.003){ humanOpacity(friR, friOp); place(friR, 1.02, -0.82, Math.PI/2); pose(friR, friP); }
}

/* ---- tư thế người trong quán ---- */
var FR_REST = {sit:1, lean:0.20, hp:0.34, hy:-0.05, aLx:-0.52, eL:-1.12, aRx:-0.52, eR:-1.12, aLz:-0.26, aRz:0.26};
var FR_UP   = {sit:1, lean:0.10, hp:0.04, hy:0.0, aLx:-0.50, eL:-1.10, aRx:-0.50, eR:-1.10, aLz:-0.24, aRz:0.24};
var FR_HOLD = {sit:1, lean:0.10, hp:0.04, hy:0.0, aLx:-0.50, eL:-1.10, aRx:-0.95, eR:-1.55, aLz:-0.24, aRz:0.12};
var ME_REST = {sit:1, lean:0.10, hp:0.06, aLx:-0.55, eL:-1.10, aRx:-0.55, eR:-1.10, aLz:-0.22, aRz:0.22};
var _hv = new THREE.Vector3();
function cafePeople(t, frP, meP, lift){
  fig(friendC, CX-0.55, -0.66, 0, frP);
  fig(meC, CX-0.55, 0.66, Math.PI, meP);
  /* tách của bạn: nằm yên trên đĩa, hoặc theo tay phải khi nhấc (C04) */
  var S = cupF.saucer, cp = cupF.cup;
  cp.position.set(0,0,0); cp.rotation.set(0,0,0);
  if(lift > 0){
    friendC.root.updateMatrixWorld(true);
    friendC.handR.getWorldPosition(_hv);
    S.updateMatrixWorld(true);
    var local = S.worldToLocal(_hv.clone());
    cp.position.set(lerp(0, local.x + 0.03, lift), lerp(0, local.y - 0.055, lift), lerp(0, local.z, lift));
    cp.rotation.y = -1.2*lift;
  }
  setSteam(t, lift > 0 ? 0 : clamp(1 - (t - 8.0)/28.0, 0.15, 1), CX-0.55, 0.83, -0.2);
}

/* ---- hạt 26 câu hỏi / 3 cụm ---- */
/* thứ tự mục: 5 tử tế (ấm) + 5 phán xét (lạnh) · 4+4 · 4+4 (đúng cấu trúc SCS 26 mục) */
var ITEM_GROUP = [], ITEM_POS = [];
(function(){ var sz = [[5,5],[4,4],[4,4]], idx = 0;
  for(var g=0; g<3; g++) for(var s=0; s<2; s++) for(var n=0; n<sz[g][s]; n++){ ITEM_GROUP.push([g, s, n, sz[g][s]]); idx++; } })();
function set26(t, arcAmt, clusterAmt, floorAmt, appearT0, appearT1, pillarX){
  for(var i=0;i<26;i++){
    var ig = ITEM_GROUP[i], g = ig[0], warm = ig[1] === 0;
    var ord = (i*7) % 26;   /* thứ tự hiện rải đều trên cung */
    var a0 = appearT0 + (appearT1 - appearT0)*ord/25;
    var vis = clamp((t - a0)/0.4, 0, 1);
    var ang = -1.25 + 2.5*ord/25;
    var ax = Math.sin(ang)*2.6, ay = 1.55 + 0.9*Math.cos(ang*1.2), az = 0.8 - Math.cos(ang)*0.4;
    var ca = (ig[2] + (warm ? 0 : ig[3]))/(ig[3]*2) * 6.283;
    var cx = pillarX[g] + Math.cos(ca)*0.35, cy = 1.3 + Math.sin(ca)*0.35, cz = -1.0;
    var fx = pillarX[g] + Math.cos(ca)*0.38, fy = 0.05, fz = -1.0 + Math.sin(ca)*0.38;
    var x = lerp(ax, cx, clusterAmt), y = lerp(ay, cy, clusterAmt), z = lerp(az, cz, clusterAmt);
    x = lerp(x, fx, floorAmt); y = lerp(y, fy, floorAmt); z = lerp(z, fz, floorAmt);
    var col = warm ? [2.2, 1.45, 0.75] : [0.9, 1.3, 2.3];
    var neu = 1 - clamp(clusterAmt*1.5, 0, 1);
    ptsSet(dots26, i, VX + x, y + 0.03*Math.sin(t*1.3 + i), z, lerp(col[0],1.6,neu*0.6), lerp(col[1],1.55,neu*0.6), lerp(col[2],1.5,neu*0.6), vis*(1 - floorAmt*0.6), 0.09);
  }
  ptsDone(dots26);
}
var PIL_X = [-2.6, 0, 2.6];
/** đặt trụ i ở toạ độ world tuỳ ý với tỉ lệ sc */
function setPillarW(i, wx, wy, wz, sc, rise, I, base){
  var p = PILLARS[i];
  if(rise <= 0.002 && (base||0) <= 0.002){ p.visible = false; return; }
  p.visible = true; p.position.set(wx, wy, wz); p.scale.setScalar(sc);
  p.userData.mat.uniforms.uRise.value = rise; p.userData.mat.uniforms.uI.value = I;
  p.userData.ring.material.opacity = Math.max(base||0, rise > 0 ? 0.8*I : 0);
  p.userData.disc.material.opacity = 0.35*I*Math.min(1, rise*3);
}

/* ---- đám đông 956 người (Neff & Pommier 2013) ---- */
var GRP = [[0,384,-4.6],[384,400,0],[784,172,4.6]];
function crowdSet(t, scatter, groupAmt, dimStudents){
  for(var g=0; g<3; g++){ var s = GRP[g][0], n = GRP[g][1], gx = GRP[g][2], R = 0.09*Math.sqrt(n);
    for(var j=0;j<n;j++){ var i = s + j, q = R26[i];
      var a = j*2.39996, rr = R*Math.sqrt((j+0.5)/n);
      var tx = gx + Math.cos(a)*rr, tz = Math.sin(a)*rr;
      var sx = (q[0]*2-1)*8, sz = (q[1]*2-1)*5;
      var x = lerp(sx, tx, groupAmt), z = lerp(sz, tz, groupAmt);
      var ap = clamp((t - (CS.C24 + 7.8) - q[2]*1.2)/0.5, 0, 1)*scatter;
      var br = 0.8 + 0.2*Math.sin(t*1.6 + q[3]*30);
      var dim = (g === 0 ? dimStudents : 0);
      ptsSet(crowd, i, VX + x, 0.06, z, 1.5*br*(1-dim*0.3), 1.35*br, 1.15*br*(1+dim*0.2), ap, 0.05);
    } }
  ptsDone(crowd);
}
function orbPair(g, t, sep, op, wob){
  var gx = GRP[g][2];
  var w = wob || 0;
  var ax = gx - sep/2 + w*0.35*Math.sin(t*0.61 + g), ay = 2.0 + w*0.3*Math.sin(t*0.83 + 1.3);
  var bx = gx + sep/2 + w*0.4*Math.sin(t*0.47 + 2.1), by = 2.0 + w*0.25*Math.sin(t*1.07 + 0.2);
  showSprite(orbs[g*2], VX + ax, ay, 0, op, 0.75);
  showSprite(orbs[g*2+1], VX + bx, by, 0, op, 0.75);
  return [ax, ay, bx, by];
}
function threadSet(slot, a, amt, t){
  for(var i=0;i<100;i++){ var u = i/99, id = slot*100 + i;
    var x = lerp(a[0], a[2], u), y = lerp(a[1], a[3], u) - 0.12*Math.sin(u*Math.PI);
    var flow = 0.6 + 0.4*Math.sin(u*20 - t*3);
    ptsSet(threadP, id, VX + x, y, 0, 2.0*flow, 1.6*flow, 1.0*flow, amt*(u < amt*1.02 ? 1 : 0), 0.035); }
}

/* ---- sương cảm xúc quanh 私 (chánh niệm ↔ nhập làm một) ---- */
function hazeSet(t, cx, cz, gap, amt, cold){
  for(var i=0;i<900;i++){ var q = R26[i%1000];
    var h = 0.1 + q[0]*1.65, ang = q[1]*6.283 + t*0.08*(q[2]-0.5);
    var rBody = 0.20 + 0.06*Math.sin(h*2.0) + (h > 1.45 ? -0.08 : 0);
    var rr = rBody + gap + 0.10*q[3];
    var x = cx + Math.cos(ang)*rr*1.1, z = cz + Math.sin(ang)*rr*0.75, y = h + 0.05*Math.sin(t*0.7 + q[3]*9);
    var c = cold ? [0.55, 0.75, 1.3] : [1.1, 0.95, 0.85];
    ptsSet(haze, i, VX + x, y, z, c[0], c[1], c[2], amt*(0.35 + 0.35*q[2]), 0.045);
  }
  ptsDone(haze);
}
/* ---- ánh sáng của "những người khác" (trụ 2 / 自分をあわれむ) ---- */
function othersSet(t, amt, nearK, avoidX, avoidZ, avoidR){
  for(var i=0;i<140;i++){ var q = R26[i+300];
    var ang = q[0]*6.283, rr = lerp(9 + q[1]*6, 3.2 + q[1]*2.5, nearK);
    var x = Math.cos(ang)*rr, z = Math.sin(ang)*rr*0.8 - 1.5, y = 0.6 + q[2]*1.4;
    var dx = x - (avoidX||0), dz = z - (avoidZ||0), d = Math.sqrt(dx*dx + dz*dz);
    var av = avoidR ? smooth((d - avoidR)/2.0) : 1;
    var tw = 0.75 + 0.25*Math.sin(t*1.1 + q[3]*20);
    ptsSet(others, i, VX + x, y, z, 1.6*tw, 1.35*tw, 1.05*tw, amt*av*(0.5 + 0.5*q[3]), 0.12);
  }
  ptsDone(others);
}

/* ============================================================================
 * 62 SHOT
 * ========================================================================== */
var SH = {};

/* ---------------- CHƯƠNG 1 — quán cà phê ---------------- */
SH.C01 = function(u, t){   /* toàn cảnh quán, nắng xiên qua cửa sổ */
  cafeBase(1, 0);
  cafePeople(t, FR_REST, ME_REST, 0);
  var p = u/dur('C01');
  camC(lerp(1.95, 1.55, p), lerp(1.50, 1.42, p), lerp(1.85, 1.55, p), -0.62, 0.95, -0.15, 40);
};
SH.C02 = function(u, t){   /* qua vai 私: bạn cúi, tay ôm tách chưa uống */
  cafeBase(1, 0);
  cafePeople(t, FR_REST, ME_REST, 0);
  var p = u/dur('C02');
  camC(-0.34, 1.30, lerp(1.32, 1.14, p), -0.60, 1.00, -0.55, 32);
};
SH.C03 = function(u, t){   /* hai người nhìn nghiêng: 私 trả lời ngay */
  cafeBase(1, 0.2);
  var talk = win(t, 23.8, 28.9, 0.5);
  var me = mixPose(ME_REST, {lean:0.16, hp:0.02 + 0.04*Math.sin(t*5.0)*talk}, talk);
  cafePeople(t, FR_REST, me, 0);
  var p = u/dur('C03');
  camC(lerp(1.75, 1.60, p), 1.22, lerp(0.08, 0.0, p), -0.55, 1.02, 0.0, 36);
};
SH.C04 = function(u, t){   /* bạn cười, nhấc tách lên */
  cafeBase(1, 0.4 + 0.3*ramp(t, 35.2, 37.5));
  var up = ramp(t, 35.23, 36.6);
  var fr = mixPose(FR_REST, FR_UP, up);
  var lift = ramp(t, 36.9, 38.9);
  fr.aRx = lerp(fr.aRx, -0.95, lift); fr.eR = lerp(fr.eR, -1.55, lift); fr.aRz = lerp(fr.aRz, 0.12, lift);
  cafePeople(t, fr, ME_REST, clamp((t - 36.9)/0.35, 0, 1));
  var p = u/dur('C04');
  camC(lerp(0.55, 0.45, p), 1.18, lerp(0.62, 0.52, p), -0.62, 0.92, -0.42, 32);
};
SH.C05 = function(u, t){   /* nhìn vào từ ngoài cửa sổ — một buổi sáng bình thường */
  cafeBase(1, 0.6);
  cafePeople(t, mixPose(FR_HOLD, {hp:0.10}, 0.5), mixPose(ME_REST, {lean:0.06, hp:0.0}, 0.5), 1);
  var p = u/dur('C05');
  camC(-2.9, 1.42, lerp(1.05, 0.45, p), -0.45, 1.05, lerp(0.05, -0.08, p), 34);
};

/* ---------------- xe buýt ---------------- */
SH.C06 = function(u, t){   /* xe buýt, 私 bên cửa sổ, phố trôi */
  busBase(t, 1);
  var turn = ramp(t, 54.4, 57.0);
  busPeople(t, meBusPose(t, {hp:lerp(0.06, 0.16, turn)}));
  var p = u/dur('C06');
  camB(lerp(-4.4, -3.2, p), 1.56, lerp(0.40, 0.25, p), 0.6, 1.12, -0.75, 44);
};
SH.C07 = function(u, t){   /* cận kính: ảnh phản chiếu, lời tự trách */
  busBase(t, 0.55);
  FX.sat = 0.72; FX.mul = [0.90, 0.97, 1.10];
  /* bóng cầu vượt: phố ngoài tối lại (sương gần) → ảnh phản chiếu trên kính hiện rõ */
  scene.fog.color.setRGB(0.10, 0.11, 0.12); scene.fog.near = 2.5; scene.fog.far = 16;
  bgMat.uniforms.uTop.value.setRGB(0.10,0.11,0.12); bgMat.uniforms.uBot.value.setRGB(0.08,0.08,0.09);
  var meP = meBusPose(t, {hp:0.20, hy:0.78});
  busPeople(t, meP);
  reflect(0.34, 0, meP, null);
  var p = u/dur('C07');
  camB(lerp(-0.70, -0.60, p), 1.46, lerp(-0.10, -0.18, p), 0.05, 1.32, -1.55, 32);
};
SH.C08 = function(u, t){   /* nghiêng mặt 私 — câu hỏi "vì sao" */
  busBase(t, 0.85);
  FX.sat = 0.9;
  busPeople(t, meBusPose(t, {hp:lerp(0.14, 0.04, ramp(t, 90.2, 93.5)), hy:0.32}));
  var p = u/dur('C08');
  camB(lerp(0.95, 0.85, p), 1.36, lerp(-1.10, -1.05, p), 0.02, 1.30, -0.80, lerp(36, 31, p));
};
SH.C09 = function(u, t){   /* rời xe → không gian một cái bóng */
  if(t < 100.3){
    busBase(t, 1);
    busPeople(t, meBusPose(t, {hy:0.80, hp:0.05}));
    var p = (t - CS.C09)/(100.3 - CS.C09);
    camB(lerp(0.9, 0.55, p), 1.36, lerp(-0.30, -0.45, p), -0.2, 1.35, -1.25, lerp(30, 26, p));
    FX.flash = 0.75*smooth((t - 98.6)/1.7);
  } else {
    voidBase(1, 0.2);
    spot(topSpot, 0, 6.5, 0.6, 0, 0, 0, 22, 0.36, 0.55);
    spotBeam(beamTop, topSpot, 0.10);
    figV(figS, 0, 0, 0, {hp:0.04});
    var p2 = (t - 100.3)/(SC.C09[1] - 100.3);
    camV(0, 1.55, lerp(7.0, 6.2, p2), 0, 1.15, 0, 36);
    FX.flash = 0.75*(1 - smooth((t - 100.3)/0.9));
  }
};

/* ---------------- CHƯƠNG 2 ---------------- */
SH.C10 = function(u, t){   /* Kristin Neff — bàn đọc */
  on('paper'); paperLights(1);
  showPaper('neff03', 0.03, 0.02, -0.08);
  var p = u/dur('C10');
  camP(lerp(0.30, 0.22, p), lerp(1.18, 1.10, p), lerp(0.56, 0.48, p), 0.0, 0.76, 0.0, 34);
  var op = win(t, 108.9, SC.C10[1] + 1, 0.7);
  /* nhãn tên — nửa phải khung, xa góc trên-trái (nhãn chương) */
  showLabel(L.neffName, PX + 0.0, 0.76, -0.45, op);
  showLabel(L.neffSub, PX + 0.0, 0.76, -0.33, op*0.95);
};
/* hai cái bóng: bạn (trái) và 私 (phải) */
function twoShadows(t, frWarm, selfCold, selfBow, frHead){
  voidBase(1, 0.3);
  figV(figF, -1.7, 0, 0.55, {hp:lerp(0.42, 0.06, frHead), lean:lerp(0.20, 0.04, frHead)});
  figV(figS, 1.7, 0, -0.55 - 0.2*selfCold, {hp:lerp(0.03, 0.46, selfBow), lean:lerp(0.0, 0.22, selfBow), aLz:lerp(0.07, 0.03, selfBow), aRz:lerp(-0.07, -0.03, selfBow)});
  spot(topSpot, 0, 7, 1.2, 0, 0, 0, 5.5, 0.6, 0.8);
  spot(warmSpot, -1.2, 5.2, 1.4, -1.7, 0, 0, 30*frWarm, 0.36, 0.85);
  spot(coldSpot, 2.3, 5.6, 0.2, 1.7, 0, 0, 55*selfCold, 0.26, 0.10);
  spotBeam(beamWarm, warmSpot, 0.10*frWarm);
  spotBeam(beamCold, coldSpot, 0.13*selfCold);
}
SH.C11 = function(u, t){   /* câu "私は本当にだめだ" của người bạn */
  twoShadows(t, 0.08, 0, 0, 0);
  var p = u/dur('C11');
  camV(0, 1.7, lerp(8.0, 7.4, p), 0, 1.35, 0, 38);
  lblV(L.sentence, -1.2, 2.75, 0, win(t, 121.9, SC.C11[1] + 2, 0.5));
};
SH.C12 = function(u, t){   /* với bạn: đáp lại dịu dàng — tia ấm đi ra ngoài */
  var k = ramp(t, 131.7, 134.0);
  twoShadows(t, 0.1 + 0.9*k, 0, 0, ramp(t, 135.3, 139.0));
  setBeam(beamOut, VX + 1.62, 1.38, 0.05, VX - 1.55, 1.3, 0.0, 0.34, 0.16*k, 0xffc27e);
  var p = u/dur('C12');
  camV(lerp(-0.4, -0.8, p), 1.6, lerp(6.8, 6.2, p), -0.6, 1.3, 0, 38);
  lblV(L.sentence, -1.2, 2.75, 0, 1 - smooth((t - 139.8)/1.0));
};
SH.C13 = function(u, t){   /* cùng câu ấy, nói với chính mình — đèn lạnh, cúi đầu */
  var fOut = 1 - ramp(t, 141.0, 142.5);
  var cold = ramp(t, 146.9, 147.6);
  var bow = ramp(t, 151.9, 154.0)*0.9 + ramp(t, 147.0, 150.0)*0.1;
  twoShadows(t, 0.8*fOut, cold, bow, 1);
  figShow(figF, fOut);
  var p = u/dur('C13');
  camV(lerp(0.6, 1.3, p), 1.6, lerp(6.6, 5.2, p), lerp(0.4, 1.5, p), 1.3, 0, 36);
  var mv = ramp(t, 143.05, 145.0);
  lblV(L.sentence, lerp(-1.2, 1.7, mv), 2.75, 0, win(t, CS.C13, 151.5, 0.5));
};
SH.C14 = function(u, t){   /* cùng một câu — hai câu trả lời ngược nhau */
  twoShadows(t, 1, 1, 1, 1);
  setBeam(beamOut, VX + 1.62, 1.38, 0.05, VX - 1.55, 1.3, 0.0, 0.34, 0.10, 0xffc27e);
  var p = u/dur('C14');
  camV(0, 1.9, lerp(7.2, 8.0, p), 0, 1.4, 0, 40);
  lblV(L.sentence, 0, 3.05, 0, win(t, CS.C14 + 0.3, SC.C14[1] + 2, 0.6));
};
SH.C15 = function(u, t){   /* bài báo Neff 2003 */
  on('paper'); paperLights(1);
  showPaper('neff03', 0.03, 0.02, 0.06);
  var p = u/dur('C15');
  var a = -0.4 + 0.5*p;
  camP(0.03 + Math.sin(a)*0.46, lerp(0.98, 0.94, p), 0.02 + Math.cos(a)*0.46, 0.02, 0.75, -0.02, 30);
  showLabel(L.src03, PX + 0.03, 0.905, 0.02, win(t, 162.8, SC.C15[1] + 1, 0.6));
};
function pillarStage(t, k){
  voidBase(k, 0.5);
  spot(topSpot, 0, 7.5, 3.0, 0, 0, 0.6, 7.5, 0.55, 0.8);
  figV(figS, 0, 1.5, 0, {hp:0.06});
}
SH.C16 = function(u, t){   /* 26 câu hỏi hiện ra thành một cung quanh 私 */
  pillarStage(t, 1);
  set26(t, 1, 0, 0, 174.3, 185.2, PIL_X);
  var p = u/dur('C16');
  camV(0, 1.9, lerp(8.2, 7.4, p), 0, 1.6, 0.5, 40);
  lblV(L.q26, 0, 3.35, 0.5, win(t, 174.3, 180.5, 0.5));
};
SH.C17 = function(u, t){   /* 26 → ba cụm (5+5 · 4+4 · 4+4) → hạ xuống thành chân trụ */
  pillarStage(t, 1);
  var cl = ramp(t, 188.0, 190.4), fl = ramp(t, 190.9, 192.8);
  set26(t, 1, cl, fl, 0, 0.01, PIL_X);
  for(var i=0;i<3;i++) setPillarW(i, VX + PIL_X[i], 0, -1.0, 1, 0, 0, 0.5*fl);
  var p = u/dur('C17');
  camV(0, 2.0, lerp(7.6, 8.0, p), 0, 1.5, -0.2, 40);
};
function pillars3(t, r1, r2, r3, I){
  var R = [r1, r2, r3];
  for(var i=0;i<3;i++) setPillarW(i, VX + PIL_X[i], 0, -1.0, 1, R[i], I*(0.4 + 0.6*R[i]), 0.5);
  pillarLight.position.set(VX, 2.2, 0.4); pillarLight.intensity = 3.0*(r1 + r2 + r3);
}
SH.C18 = function(u, t){   /* trụ 1: tử tế với mình ↔ tự phán xét */
  pillarStage(t, 1);
  set26(t, 1, 1, 1, 0, 0.01, PIL_X);
  pillars3(t, ramp(t, 193.4, 195.6), 0, 0, 1);
  var hit = bump(t, 202.6, 205.4);
  spot(coldSpot, 0.6, 5.5, 2.4, 0, 0, 1.5, 45*hit, 0.24, 0.1);
  spotBeam(beamCold, coldSpot, 0.12*hit);
  var p = u/dur('C18');
  camV(lerp(-0.6, -1.4, p), 1.9, lerp(7.2, 6.4, p), -1.6, 1.8, -0.4, 40);
  lblV(L.p1, PIL_X[0] - 1.5, 3.0, -1.0, win(t, 193.6, SC.C18[1] + 1, 0.5));
  lblV(L.p1x, PIL_X[0] - 1.5, 2.35, -1.0, win(t, 196.5, SC.C18[1] + 1, 0.5));
};
SH.C19 = function(u, t){   /* trụ 2: nỗi khổ ai cũng có ↔ cô lập */
  pillarStage(t, 1);
  set26(t, 1, 1, 1, 0, 0.01, PIL_X);
  pillars3(t, 1, ramp(t, 207.5, 209.6), 0, 1);
  var iso = ramp(t, 213.2, 216.5);
  othersSet(t, ramp(t, 208.7, 210.5), lerp(0.55, 0.25, iso), 0, 1.5, 7.5*iso);
  var p = u/dur('C19');
  camV(0, lerp(2.4, 3.6, p), lerp(8.6, 11.0, p), 0, 1.4, -0.4, 40);
  lblV(L.p2, PIL_X[1] - 2.2, 3.6, -1.0, win(t, 207.8, SC.C19[1] + 1, 0.5));
  lblV(L.p2x, 2.4, 3.0, -1.0, win(t, 213.2, SC.C19[1] + 1, 0.5));
};
SH.C20 = function(u, t){   /* trụ 3: chánh niệm — cảm xúc ở gần, không nuốt mình */
  pillarStage(t, 1);
  set26(t, 1, 1, 1, 0, 0.01, PIL_X);
  pillars3(t, 1, 1, ramp(t, 221.0, 223.2), 1);
  var hz = ramp(t, 225.2, 227.3);
  hazeSet(t, 0, 1.5, lerp(0.15, 0.55, ramp(t, 230.3, 232.2)), hz, false);
  var p = u/dur('C20');
  camV(lerp(1.9, 1.3, p), 1.7, lerp(6.4, 5.4, p), 0.6, 1.4, 0.4, 38);
  lblV(L.p3, PIL_X[2] + 1.5, 3.2, -1.0, win(t, 221.2, SC.C20[1] + 1, 0.5));
};
SH.C21 = function(u, t){   /* ↔ nhập làm một: "thất bại" → "tôi là thất bại" */
  pillarStage(t, 0.8);
  pillars3(t, 0.6, 0.6, 0.6, 0.6);
  var cl = ramp(t, 233.8, 236.0);
  hazeSet(t, 0, 1.5, lerp(0.55, 0.04, cl), 1, cl > 0.5);
  figV(figS, 0, 1.5, 0, {hp:lerp(0.06, 0.36, ramp(t, 238.8, 241.5)), lean:lerp(0, 0.12, ramp(t, 238.8, 241.5))});
  var p = u/dur('C21');
  camV(lerp(0.9, 0.5, p), 1.75, lerp(5.2, 4.4, p), 0, 1.45, 1.5, 36);
  lblV(L.p3x, 1.25, 2.95, 1.0, win(t, 233.9, 237.0, 0.5));
  lblV(L.fail1, 0, 2.55, 1.5, win(t, 237.3, 238.9, 0.35));
  lblV(L.fail2, 0, 2.55, 1.5, win(t, 238.9, SC.C21[1] + 1, 0.35));
};
SH.C22 = function(u, t){   /* quay lại bàn cà phê: lời đã nói ứng với trụ nào */
  cafeBase(1, 0.5);
  cafePeople(t, mixPose(FR_HOLD, {hp:0.12}, 0.6), ME_REST, 1);
  var sc = 0.085, base = [[-0.72, 0.0],[-0.55, 0.0],[-0.38, 0.0]];
  var r2 = ramp(t, 251.8, 253.2), r1 = ramp(t, 255.7, 257.0), r3 = ramp(t, 259.0, 260.3);
  var R = [r1, r2, r3];
  for(var i=0;i<3;i++) setPillarW(i, CX + base[i][0], 0.745, base[i][1] + 0.02, sc, R[i], 0.55 + 0.45*R[i], 0.6*ramp(t, 249.0, 250.5));
  var p = u/dur('C22');
  camC(lerp(0.75, 0.62, p), lerp(1.75, 1.68, p), lerp(0.10, -0.02, p), -0.58, 0.78, 0.0, 40);
  showLabel(L.n1, CX - 0.72, 1.16, 0.02, 0.9*r1);
  showLabel(L.n2, CX - 0.55, 1.16, 0.02, 0.9*r2);
  showLabel(L.n3, CX - 0.38, 1.16, 0.02, 0.9*r3);
};
SH.C23 = function(u, t){   /* ba trụ đứng giữa mình và bạn — phía chính mình không trụ nào */
  voidBase(1, 0.5);
  figV(figF, -3.4, 0, 0.9, {hp:0.08});
  figV(figS, 0, 0, -Math.PI/2 + 0.15, {hp:0.04});
  figV(figX, 3.4, 0, -0.9, {hp:0.44, lean:0.2});
  for(var i=0;i<3;i++) setPillarW(i, VX - 1.7, 0, -0.9 + i*0.9, 0.72, 1, 0.85, 0.5);
  pillarLight.position.set(VX - 1.7, 2.0, 0.5); pillarLight.intensity = 5;
  spot(topSpot, 0, 7, 2, 0, 0, 0, 6, 0.7, 0.8);
  spot(coldSpot, 3.8, 5.5, 0.6, 3.4, 0, 0, 30, 0.24, 0.1);
  var empty = ramp(t, 272.4, 274.0);
  var ringX = [1.7, 1.7, 1.7], ringZ = [-0.9, 0, 0.9];
  /* ba vòng đáy trống bên phía chính mình — dùng lại hạt ringP */
  for(var j=0;j<3;j++) for(var q=0;q<100;q++){ var a = q/100*6.283; ptsSet(ringP, j*100 + q, VX + ringX[j] + Math.cos(a)*0.28, 0.03, ringZ[j] + Math.sin(a)*0.28, 0.6, 0.75, 1.1, 0.5*empty, 0.04); }
  for(var e=300;e<320;e++) ptsSet(ringP, e, 0,0,0, 0,0,0, 0, 0.01);
  ptsDone(ringP);
  var p = u/dur('C23');
  camV(0, lerp(2.4, 2.7, p), lerp(8.8, 9.6, p), 0, 1.2, 0, 42);
};
SH.C24 = function(u, t){   /* Neff & Pommier 2013 → 956 người, ba nhóm */
  if(t < 285.6){
    on('paper'); paperLights(1);
    showPaper('neff13', 0.02, 0.03, -0.1);
    var p = (t - CS.C24)/(285.6 - CS.C24);
    camP(lerp(-0.25, -0.12, p), lerp(1.05, 0.98, p), lerp(0.42, 0.40, p), 0.03, 0.75, 0.0, 32);
    showLabel(L.src13, PX + 0.03, 0.93, 0.02, win(t, 278.8, 286.5, 0.5));
    FX.dip = smooth((285.6 - t)/0.3);
  } else {
    voidBase(1, 0.4);
    spot(topSpot, 0, 12, 4, 0, 0, 0, 4, 0.75, 0.9);
    crowdSet(t, 1, ramp(t, 287.4, 289.6), 0);
    var p2 = (t - 285.6)/(SC.C24[1] - 285.6);
    camV(0, lerp(9.5, 8.6, p2), lerp(10.5, 9.8, p2), 0, 0, 0, 40);
    FX.dip = smooth((t - 285.6)/0.3);
  }
};
SH.C25 = function(u, t){   /* nhãn nhóm + hai quả cầu: tử tế với mình / thương người */
  voidBase(1, 0.4);
  spot(topSpot, 0, 12, 4, 0, 0, 0, 4, 0.75, 0.9);
  crowdSet(t, 1, 1, 0);
  var o = ramp(t, 296.0, 297.6);
  for(var g=0; g<3; g++) orbPair(g, t, 1.1, o, 0);
  var p = u/dur('C25');
