  lblV(L.oOther, 0.9, 1.15, 0, win(t, 298.0, 303.0, 0.4));
};
SH.C26 = function(u, t){   /* sinh viên: không nối · người lớn & thiền: có sợi nối */
  voidBase(1, 0.4);
  spot(topSpot, 0, 12, 4, 0, 0, 0, 4, 0.75, 0.9);
  crowdSet(t, 1, 1, win(t, 303.6, 311.8, 0.8));
  var pa = orbPair(0, t, 1.1, 1, 0), pb = orbPair(1, t, 1.1, 1, 0), pc = orbPair(2, t, 1.1, 1, 0);
  threadSet(0, pb, ramp(t, 312.3, 313.8), t);
  threadSet(1, pc, ramp(t, 313.0, 314.99), t);
  for(var i=200;i<300;i++) ptsSet(threadP, i, 0,0,0, 0,0,0, 0, 0.01);
  ptsDone(threadP);
  var p = u/dur('C26');
  camV(lerp(-2.2, 1.2, p), 3.6, lerp(9.0, 8.6, p), lerp(-2.4, 1.8, p), 1.2, 0, 40);
  lblV(L.gStu, -4.6, 3.35, 0, 0.85);
  lblV(L.gAdu, 0, 3.35, 0, 0.85);
  lblV(L.gMed, 4.6, 3.35, 0, 0.85);
};
SH.C27 = function(u, t){   /* hai sức mạnh khác nhau — không tự động đi cùng nhau */
  voidBase(1, 0.4);
  spot(topSpot, 0, 12, 4, 0, 0, 0, 3.5, 0.75, 0.9);
  crowdSet(t, 1, 1, 0.3);
  var sep = lerp(1.1, 2.0, ramp(t, 317.0, 320.0));
  orbPair(0, t, sep, 1, 1);
  var p = u/dur('C27');
