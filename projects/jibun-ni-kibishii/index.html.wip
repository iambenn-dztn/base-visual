  lblV(L.gStu, -4.6, 3.35, 0, win(t, 290.9, SC.C25[1] + 1, 0.4));
  lblV(L.gAdu, 0, 3.35, 0, win(t, 291.8, SC.C25[1] + 1, 0.4));
  lblV(L.gMed, 4.6, 3.35, 0, win(t, 293.7, SC.C25[1] + 1, 0.4));
