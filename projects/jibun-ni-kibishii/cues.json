{
  "total": 818.7,
  "count": 308,
  "cues": [
    {
      "t": 0,
      "s": "朝の十時ごろでした。"
    },
    {
      "t": 2.09,
      "s": "駅前の小さな喫茶店で、"
    },
    {
      "t": 4.39,
      "s": "古い友人と向かい合って座っていました。"
    },
    {
      "t": 8.37,
      "s": "友人はコーヒーに手をつけないまま、"
    },
    {
      "t": 11.87,
      "s": "ある失敗の話をしていました。もう何日も、"
    },
    {
      "t": 15.98,
      "s": "そのことばかり考えてしまう、"
    },
    {
      "t": 18.86,
      "s": "と言うんです。"
    },
    {
      "t": 20.3,
      "s": "私は、ほとんど考えずに答えていました。"
    },
    {
      "t": 23.97,
      "s": "「誰にでもあることだよ。"
    },
    {
      "t": 26.29,
      "s": "あなたが悪いわけじゃない」。"
    },
    {
      "t": 28.98,
      "s": "言葉を探す必要は、ありませんでした。"
    },
    {
      "t": 32.29,
      "s": "口から、そのまま出てきたんです。"
    },
    {
      "t": 35.23,
      "s": "友人は少し笑って、"
    },
    {
      "t": 36.88,
      "s": "やっとカップを持ち上げました。"
    },
    {
      "t": 39.64,
      "s": "友人の失敗を、"
    },
    {
      "t": 40.94,
      "s": "私は少しも重いとは思いませんでした。"
    },
    {
      "t": 44.28,
      "s": "誰だって、そういう日はあります。"
    },
    {
      "t": 47.25,
      "s": "本気で、そう思っていたんです。"
    },
    {
      "t": 50.04,
      "s": "帰りのバスで、窓の外を見ていたときです。"
    },
    {
      "t": 54.36,
      "s": "ふと、何年も前のことを思い出しました。"
    },
    {
      "t": 58.47,
      "s": "私も、あれとよく似た失敗をしていたんです。"
    },
    {
      "t": 63.01,
      "s": "そして、そのことで、"
    },
    {
      "t": 65.17,
      "s": "今もときどき自分を責めています。"
    },
    {
      "t": 68.63,
      "s": "あのとき自分に向けた言葉は、"
    },
    {
      "t": 71.25,
      "s": "よく覚えています。"
    },
    {
      "t": 72.94,
      "s": "「どうしてあんなことをしたんだ。"
    },
    {
      "t": 75.94,
      "s": "しっかりしろ」。"
    },
    {
      "t": 78.92,
      "s": "誰にでもあることだよ。この一言を、"
    },
    {
      "t": 81.98,
      "s": "私は自分には、"
    },
    {
      "t": 83.24,
      "s": "一度も言ったことがありませんでした。"
    },
    {
      "t": 86.48,
      "s": "友達にはすぐ言えるのに、自分には言えない。"
    },
    {
      "t": 90.25,
      "s": "バスに揺られながら、"
    },
    {
      "t": 92.05,
      "s": "なぜなんだろう、"
    },
    {
      "t": 93.49,
      "s": "と考えはじめました。"
    },
    {
      "t": 95.29,
      "s": "実は、"
    },
    {
      "t": 95.94,
      "s": "このずれを正面から調べた研究者がいます。"
    },
    {
      "t": 100.31,
      "s": "そして答えは、性格の話ではありませんでした。"
    },
    {
      "t": 105.1,
      "s": "今日は、その話をします。"
    },
    {
      "t": 107.72,
      "s": "テキサス大学に、"
    },
    {
      "t": 109.22,
      "s": "クリスティン・ネフという心理学者がいます。"
    },
    {
      "t": 113.17,
      "s": "この人が、"
    },
    {
      "t": 114.11,
      "s": "一つの問いかけを紹介しているんです。"
    },
    {
      "t": 117.49,
      "s": "大事な友達が、あなたにこう言ったとします。"
    },
    {
      "t": 121.9,
      "s": "「私は本当にだめだ。"
    },
    {
      "t": 123.99,
      "s": "どうしてあんなことをしたんだろう」。"
    },
    {
      "t": 127.77,
      "s": "あなたは、何と答えますか。"
    },
    {
      "t": 130.5,
      "s": "多くの人は、"
    },
    {
      "t": 131.75,
      "s": "すぐにやさしい言葉を返すはずです。"
    },
    {
      "t": 135.28,
      "s": "そんなことないよ。"
    },
    {
      "t": 137.16,
      "s": "誰にでもある。"
    },
    {
      "t": 138.61,
      "s": "まずはゆっくり休んで。"
    },
    {
      "t": 140.9,
      "s": "では、同じ一文を、"
    },
    {
      "t": 143.05,
      "s": "自分が自分に言ったときはどうか。"
    },
    {
      "t": 146.88,
      "s": "多くの人は、そのまま受け取ってしまいます。"
    },
    {
      "t": 151.89,
      "s": "そうだ、私はだめなんだ、と。"
    },
    {
      "t": 155.23,
      "s": "同じ一文なのに、"
    },
    {
      "t": 156.96,
      "s": "相手が変わるだけで、"
    },
    {
      "t": 159.12,
      "s": "返事がまるで逆になるんです。"
    },
    {
      "t": 162.14,
      "s": "ネフさんは二千三年に、"
    },
    {
      "t": 164.19,
      "s": "自分へのやさしさを測る物差しを作りました。"
    },
    {
      "t": 168.1,
      "s": "セルフ・コンパッション尺度という、"
    },
    {
      "t": 171.27,
      "s": "質問に答えていく形のものです。"
    },
    {
      "t": 174.07,
      "s": "質問は二十六あります。"
    },
    {
      "t": 176.44,
      "s": "つらいとき、自分に思いやりを向けているか。"
    },
    {
      "t": 180.98,
      "s": "失敗したとき、自分だけがだめだと感じるか。"
    },
    {
      "t": 185.51,
      "s": "そういう問いです。"
    },
    {
      "t": 187.46,
      "s": "この物差しは、"
    },
    {
      "t": 188.74,
      "s": "自分へのやさしさを、"
    },
    {
      "t": 190.56,
      "s": "三つの柱に分けて考えています。"
    },
    {
      "t": 193.29,
      "s": "一つ目は、自分へのやさしさ。"
    },
    {
      "t": 196.45,
      "s": "その反対側にあるのが、自分を裁く心です。"
    },
    {
      "t": 200.96,
      "s": "失敗した自分を、"
    },
    {
      "t": 202.76,
      "s": "厳しい言葉で叩くかどうか、"
    },
    {
      "t": 205.7,
      "s": "ということです。"
    },
    {
      "t": 207.49,
      "s": "二つ目は、"
    },
    {
      "t": 208.67,
      "s": "つらさは誰にでもある、"
    },
    {
      "t": 211.26,
      "s": "という感覚です。"
    },
    {
      "t": 213.15,
      "s": "反対側は、孤立。"
    },
    {
      "t": 215.04,
      "s": "こんな目にあうのは自分だけだ、"
    },
    {
      "t": 218.57,
      "s": "と感じることですね。"
    },
    {
      "t": 220.94,
      "s": "三つ目は、マインドフルネスと呼ばれています。"
    },
    {
      "t": 225.21,
      "s": "少し難しい言葉ですが、"
    },
    {
      "t": 227.34,
      "s": "つらい気持ちを打ち消しもせず、"
    },
    {
      "t": 230.26,
      "s": "飲みこまれもしない、"
    },
    {
      "t": 232.2,
      "s": "ということです。"
    },
    {
      "t": 233.75,
      "s": "その反対側が、気持ちとの一体化です。"
    },
    {
      "t": 237.23,
      "s": "「失敗した」が、"
    },
    {
      "t": 238.78,
      "s": "いつのまにか「私は失敗そのものだ」に"
    },
    {
      "t": 242.26,
      "s": "すり替わってしまう状態なんです。"
    },
    {
      "t": 245.36,
      "s": "あの喫茶店で私が友人に言ったことを、"
    },
    {
      "t": 249.08,
      "s": "私なりに並べ直してみます。"
    },
    {
      "t": 251.77,
      "s": "「誰にでもある」は、二つ目の柱でした。"
    },
    {
      "t": 255.69,
      "s": "「あなたが悪いわけじゃない」は、"
    },
    {
      "t": 259,
      "s": "一つ目と三つ目です。失敗と、"
    },
    {
      "t": 261.89,
      "s": "その人そのものを、"
    },
    {
      "t": 263.75,
      "s": "分けて見ていたわけです。"
    },
    {
      "t": 266.23,
      "s": "つまり私は、三つの柱を、"
    },
    {
      "t": 268.47,
      "s": "友人に向かってはちゃんと使えていたんです。"
    },
    {
      "t": 272.4,
      "s": "自分に向かってだけ、"
    },
    {
      "t": 274.27,
      "s": "一本も立っていませんでした。"
    },
    {
      "t": 278.05,
      "s": "もう一つ、気になる研究があります。"
    },
    {
      "t": 281.29,
      "s": "ネフさんとポミエさんが"
    },
    {
      "t": 283.38,
      "s": "二千十三年に出したもので、"
    },
    {
      "t": 285.85,
      "s": "九百人あまりを、"
    },
    {
      "t": 287.37,
      "s": "三つのグループに分けて調べています。"
    },
    {
      "t": 290.8,
      "s": "大学生と、"
    },
    {
      "t": 291.77,
      "s": "地域で暮らす大人と、"
    },
    {
      "t": 293.7,
      "s": "瞑想を続けている人たち。"
    },
    {
      "t": 296.02,
      "s": "自分へのやさしさと、"
    },
    {
      "t": 297.95,
      "s": "人への思いやりが、"
    },
    {
      "t": 299.69,
      "s": "どれくらい結びついているかを見たんです。"
    },
    {
      "t": 303.55,
      "s": "大学生では、"
    },
    {
      "t": 304.64,
      "s": "人への思いやりと、"
    },
    {
      "t": 306.27,
      "s": "自分へのやさしさのあいだに、"
    },
    {
      "t": 308.82,
      "s": "はっきりしたつながりが出ませんでした。"
    },
    {
      "t": 312.27,
      "s": "大人と、"
    },
    {
      "t": 312.99,
      "s": "瞑想をする人たちでは、"
    },
    {
      "t": 314.99,
      "s": "つながりが見えました。"
    },
    {
      "t": 316.99,
      "s": "人にやさしくできることと、"
    },
    {
      "t": 319.48,
      "s": "自分にやさしくできることは、"
    },
    {
      "t": 322.16,
      "s": "同じ一つの力ではない。少なくとも、"
    },
    {
      "t": 325.41,
      "s": "自動でついてくるものではない、"
    },
    {
      "t": 328.28,
      "s": "ということなんです。"
    },
    {
      "t": 330.19,
      "s": "正直に言うと、"
    },
    {
      "t": 331.56,
      "s": "これを読んで少しほっとしました。"
    },
    {
      "t": 334.7,
      "s": "人にだけやさしい自分が、"
    },
    {
      "t": 337.05,
      "s": "特別にゆがんでいるわけではなかったんです。"
    },
    {
      "t": 341.16,
      "s": "では、"
    },
    {
      "t": 341.82,
      "s": "なぜ自分にだけ、"
    },
    {
      "t": 343.58,
      "s": "厳しい声が出てくるのか。"
    },
    {
      "t": 346.23,
      "s": "ここからが、いちばん深いところです。"
    },
    {
      "t": 350.2,
      "s": "ネフさんは、こう説明しています。"
    },
    {
      "t": 353.72,
      "s": "人は危ないと感じると、戦うか、逃げるか、"
    },
    {
      "t": 358.13,
      "s": "固まるか。"
    },
    {
      "t": 359.23,
      "s": "体が、身を守る構えに入ります。"
    },
    {
      "t": 362.54,
      "s": "友達が失敗したとき、"
    },
    {
      "t": 364.61,
      "s": "私たち自身は脅かされていません。"
    },
    {
      "t": 367.92,
      "s": "だから、構えに入らずにすみます。"
    },
    {
      "t": 371.23,
      "s": "そのかわりに、別の仕組みが動くんです。"
    },
    {
      "t": 375.16,
      "s": "弱っている仲間を気づかって、"
    },
    {
      "t": 378.03,
      "s": "そばに寄りそう仕組みです。"
    },
    {
      "t": 380.7,
      "s": "家族や仲間が互いを守るために育ってきたもの、"
    },
    {
      "t": 385.21,
      "s": "とネフさんは言います。"
    },
    {
      "t": 387.46,
      "s": "ところが、"
    },
    {
      "t": 388.6,
      "s": "失敗したのが自分だと、"
    },
    {
      "t": 391.1,
      "s": "話が変わります。"
    },
    {
      "t": 392.92,
      "s": "脅かされているのは、自分そのものです。"
    },
    {
      "t": 397.25,
      "s": "体は、身を守る構えのほうに入ります。"
    },
    {
      "t": 401.35,
      "s": "そして、その構えが、"
    },
    {
      "t": 403.48,
      "s": "外ではなく内側に向かうんです。"
    },
    {
      "t": 406.68,
      "s": "自分を叩いて、"
    },
    {
      "t": 408.17,
      "s": "しゃんとさせて、"
    },
    {
      "t": 409.88,
      "s": "二度と間違えないようにしようとする。"
    },
    {
      "t": 413.73,
      "s": "つまり、"
    },
    {
      "t": 414.42,
      "s": "あの厳しい声は、"
    },
    {
      "t": 415.79,
      "s": "意地悪で出ているのではありません。"
    },
    {
      "t": 418.71,
      "s": "なんというか、見張りのようなものなんです。"
    },
    {
      "t": 422.32,
      "s": "もう危ない目にあわないように、身構えている。"
    },
    {
      "t": 427.26,
      "s": "この違いを、"
    },
    {
      "t": 428.35,
      "s": "脳の中で見ようとした研究があります。"
    },
    {
      "t": 431.61,
      "s": "二千十年に、"
    },
    {
      "t": 432.7,
      "s": "イギリスのチームが『ニューロイメージ』と"
    },
    {
      "t": 436.33,
      "s": "いう専門誌に出したものです。"
    },
    {
      "t": 438.87,
      "s": "参加者は装置の中で、失敗の場面を読みます。"
    },
    {
      "t": 442.87,
      "s": "そして、"
    },
    {
      "t": 443.63,
      "s": "自分を責めるつもりで考えたり、"
    },
    {
      "t": 446.48,
      "s": "励ますつもりで考えたりします。"
    },
    {
      "t": 449.34,
      "s": "自分を責めているとき、"
    },
    {
      "t": 451.22,
      "s": "よく動いていたのは、"
    },
    {
      "t": 452.93,
      "s": "間違いを見つけて処理したり、"
    },
    {
      "t": 455.32,
      "s": "行動にブレーキをかけたりする働きと、"
    },
    {
      "t": 458.39,
      "s": "結びつけられてきた場所でした。"
    },
    {
      "t": 460.95,
      "s": "自分を励ましているときは、"
    },
    {
      "t": 463.28,
      "s": "別の場所が動いていました。"
    },
    {
      "t": 465.62,
      "s": "研究チームは、"
    },
    {
      "t": 466.87,
      "s": "人に思いやりや共感を向けるときと、"
    },
    {
      "t": 469.93,
      "s": "よく似た場所だと述べています。"
    },
    {
      "t": 472.62,
      "s": "正直なところ、"
    },
    {
      "t": 474.04,
      "s": "私にとっては、"
    },
    {
      "t": 475.45,
      "s": "ここがいちばん大きな発見でした。"
    },
    {
      "t": 478.69,
      "s": "自分を励ますとき、脳は、"
    },
    {
      "t": 481.12,
      "s": "人を思いやるときの道具を使っているらしい、"
    },
    {
      "t": 485.38,
      "s": "ということなんです。"
    },
    {
      "t": 487.4,
      "s": "ただ、"
    },
    {
      "t": 487.96,
      "s": "脳の場所の話は、"
    },
    {
      "t": 489.46,
      "s": "少し割り引いて聞いておきたいと思っています。"
    },
    {
      "t": 493.57,
      "s": "ある場所が動いたことと、"
    },
    {
      "t": 495.81,
      "s": "心の中で起きていることを、"
    },
    {
      "t": 498.24,
      "s": "そのまま同じにはできませんから。"
    },
    {
      "t": 501.23,
      "s": "それでも、"
    },
    {
      "t": 502.38,
      "s": "ネフさんの説明と、この研究は、"
    },
    {
      "t": 505.84,
      "s": "同じ方向を指しています。"
    },
    {
      "t": 508.61,
      "s": "やさしくする力は、もうあるんです。"
    },
    {
      "t": 512.52,
      "s": "ただ、外にしか向いていない。"
    },
    {
      "t": 517.24,
      "s": "では、"
    },
    {
      "t": 517.86,
      "s": "その向きを自分に変えることに、"
    },
    {
      "t": 520.98,
      "s": "なぜこんなに抵抗があるのか。"
    },
    {
      "t": 523.89,
      "s": "心のどこかで、こう思っているからです。"
    },
    {
      "t": 527.85,
      "s": "自分に甘くしたら、だめになる。"
    },
    {
      "t": 530.97,
      "s": "厳しくしていないと、怠けて、"
    },
    {
      "t": 533.88,
      "s": "同じ失敗をくり返す。"
    },
    {
      "t": 535.96,
      "s": "実は私も、ずっとそう思ってきました。"
    },
    {
      "t": 539.69,
      "s": "この思いこみを、"
    },
    {
      "t": 541.12,
      "s": "実験で確かめた人たちがいます。"
    },
    {
      "t": 543.81,
      "s": "カリフォルニア大学バークレー校の、"
    },
    {
      "t": 546.85,
      "s": "ブレインズさんとチェンさんです。"
    },
    {
      "t": 549.71,
      "s": "二千十二年の報告です。"
    },
    {
      "t": 551.68,
      "s": "参加者は、まず難しい単語のテストを受けます。"
    },
    {
      "t": 556.12,
      "s": "ほとんどの人が、うまくできません。"
    },
    {
      "t": 559.56,
      "s": "わざと、そう作ってあるんです。"
    },
    {
      "t": 562.59,
      "s": "そのあと、"
    },
    {
      "t": 563.55,
      "s": "ある人たちにだけ、"
    },
    {
      "t": 565.28,
