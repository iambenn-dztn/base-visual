  setCar(T, carD(810.71) + dd, 0, {hallZ:-60 + dd, moving:0, father:false, walker:[wx, wz, 0.76, u*5.4]});
  camLerp([0.06,1.25,0.98, -1.9,1.0,-2.6, 52], [0.06,1.25,1.0, -2.2,1.0,-2.8, 50], u/11.2);
}, 0, 0);

/* =========================================================================
 * VÒNG LẶP CHÍNH — renderAtTime(t) TẤT ĐỊNH THUẦN
 * ========================================================================= */
function resetVisibility(){
  for(var k in G) G[k].visible = false;
  resetPlates();
  RIB_LIFE.visible = false; RIB_DIR.visible = false;
  RIB_LIFE.material.uniforms.uI.value = 1;
  for(var f=0; f<FUT.length; f++) FUT[f].visible = false;
}
function sceneIndex(t){
  for(var i=0;i<SC.length;i++){ if(t >= SC[i].a && t < SC[i].b) return i; }
  return t < SC[0].a ? 0 : SC.length-1;
}
function renderAtTime(t){
  /* LEADTAIL:APPLIED — dịch timeline sang phải 2s cho intro lặng.
     Cảnh vẫn dùng mốc gốc của timing.json; chỉ tới muộn hơn 2s. */
  var _tReal = t;                    /* thời gian THẬT của video, cho phụ đề */
  t = Math.max(0, t - 2);   /* thời gian CẢNH, đã trừ intro */

  t = clamp(t, 0, SCENE_END);
  resetVisibility();
  var i = sceneIndex(t), s = SC[i];
  var u = t - s.a, dur = s.b - s.a;
  s.fn(u, t, dur);
  if(G.plates.visible || _plateN > 0){ G.plates.visible = true; sortPlates(); }
  VOID_DUST.material.uniforms.uT.value = t;
  /* chuyển cảnh: nhúng tối ngắn ở biên (fi/fo = 0 → cắt thẳng) */
  var f = 1;
  if(s.fi > 0) f = Math.min(f, smooth(u / s.fi));
  if(s.fo > 0) f = Math.min(f, smooth((s.b - t) / s.fo));
  stage.lens.uniforms.uFade.value = f * HFA.globalFade(t, SCENE_END, 1.2, 2.5);
  stage.lens.uniforms.uT.value = t;
  kFlush();
  HFA.applySubtitle(subEl, CUES, _tReal);
  /* LEADTAIL:APPLIED — màn hình đen 5s cuối: nhạc chạy tiếp, hình tắt dần. */
  (function(){
    var ob = document.getElementById('outro-black');
    if(!ob) return;
    var f = (_tReal - 834) / 1.2;         /* 1.2s chuyển sang đen */
    ob.style.opacity = String(Math.max(0, Math.min(1, f)));
  })();
  HFA.applyChapter(chapEl, CHAPTERS, _tReal, 5.5);
  composer.render();
}


/* =========================================================================
 * PHỤ ĐỀ — sinh bởi: node scripts/gen-captions.mjs --project projects/monogatari
 * (≤22 ký tự toàn角/dòng, tự nhận tiếng Nhật). ĐỪNG sửa tay.
 * ========================================================================= */
const CUES=[
 {t:2.00,s:"木曜日の朝でした。"},
 {t:4.03,s:"私は車を運転していて、"},
 {t:6.52,s:"助手席には父が座っていました。"},
 {t:9.91,s:"毎週この時間に、"},
 {t:11.64,s:"父を隣町の囲碁の会へ送っていくんです。"},
 {t:15.76,s:"片道、二十分ほどの道です。"},
 {t:18.56,s:"田んぼの横の道に出たとき、"},
 {t:21.02,s:"父が窓の外を見ながら、"},
 {t:23.11,s:"ぽつりと言いました。"},
 {t:25.01,s:"あの台風の晩はな。"},
 {t:28.32,s:"ああ、あの話だ、と私は思いました。"},
 {t:31.64,s:"子どものころから、"},
 {t:33.41,s:"もう何十回と聞いてきた話なんです。"},
 {t:36.73,s:"父が小学生のころ、"},
 {t:38.50,s:"家は田んぼの端にありました。"},
 {t:41.27,s:"大きな台風が来て、夜じゅう、"},
 {t:44.03,s:"風が家を揺らしたそうです。"},
 {t:46.59,s:"居間のガラス窓が、"},
 {t:48.36,s:"今にも外れそうに鳴っていた。"},
 {t:51.11,s:"それを誰かが一晩中、"},
 {t:53.08,s:"両手で押さえていたんです。"},
 {t:55.63,s:"押さえていたのは、祖父でした。"},
 {t:58.72,s:"私が聞いてきた話では、いつもそうでした。"},
 {t:62.84,s:"ところが、この朝の父は、こう言ったんです。"},
 {t:66.19,s:"おふくろがな、朝まで押さえてたんだ。"},
 {t:71.01,s:"祖母だ、と言いました。それに、"},
 {t:73.72,s:"前はろうそくの明かりだったのが、"},
 {t:76.60,s:"この朝は懐中電灯になっていました。"},
 {t:79.67,s:"前はじいちゃんだったよね。"},
 {t:82.16,s:"そう言いかけて、私は口を閉じました。"},
 {t:85.61,s:"どちらが本当なのか。"},
 {t:87.81,s:"父の記憶が、どこか弱ってきているのか。"},
 {t:92.00,s:"そんな考えが、一瞬よぎりました。"},
 {t:95.53,s:"でも、"},
 {t:96.02,s:"それよりも気になったことがあったんです。"},
 {t:99.25,s:"同じ人が、同じ話をしている。それなのに、"},
 {t:103.81,s:"なぜ細かいところだけが、"},
 {t:106.54,s:"話すたびに変わるのか。"},
 {t:110.53,s:"その夜、私は調べてみることにしました。実は、"},
 {t:115.49,s:"この問いには、"},
 {t:117.06,s:"九十年以上前から答えを探して"},
 {t:120.22,s:"きた人たちがいたんです。"},
 {t:122.92,s:"まず、一つ想像してみてください。記憶が、"},
 {t:127.13,s:"一本の録音テープのようなものだったとしたら。"},
 {t:131.78,s:"そうであれば、"},
 {t:133.23,s:"何度再生しても、"},
 {t:134.89,s:"同じ音が出てくるはずです。"},
 {t:137.59,s:"父の台風の話も、毎回同じになります。"},
 {t:141.32,s:"でも、実際はそうなりません。"},
 {t:144.14,s:"そこに早くから目をつけたのが、"},
 {t:147.16,s:"イギリスの心理学者、"},
 {t:149.17,s:"バートレットでした。"},
 {t:151.18,s:"一九三二年、"},
 {t:152.54,s:"バートレットは、"},
 {t:154.34,s:"リメンバリングという本を出しました。"},
 {t:158.41,s:"思い出すこと、という意味です。"},
 {t:161.81,s:"その中の実験は、とても素朴なものでした。"},
 {t:165.81,s:"イギリスの学生たちに、"},
 {t:168.02,s:"ある短い物語を読んでもらうんです。"},
 {t:171.41,s:"北アメリカの先住民に伝わる昔話で、題を、"},
 {t:176.18,s:"幽霊たちの戦い、といいます。"},
 {t:179.51,s:"学生たちには、なじみのない話でした。"},
 {t:183.81,s:"読んだあと、"},
 {t:185.18,s:"学生はその話を思い出して書きます。"},
 {t:189.05,s:"何日かたって、また書く。"},
 {t:191.79,s:"何か月もたって、また書く。"},
 {t:194.75,s:"同じ人が、同じ話を、何度も書き直すわけです。"},
 {t:199.49,s:"すると、どうなったか。"},
 {t:202.02,s:"話の骨組みは、わりあい残りました。"},
 {t:205.94,s:"何が起きて、どう終わったか。"},
 {t:209.17,s:"そこは大きく崩れないんです。"},
 {t:212.39,s:"変わっていったのは、細かいところでした。"},
 {t:215.77,s:"話は回を追うごとに短くなり、"},
 {t:218.14,s:"なじみのない部分が、"},
 {t:219.84,s:"なじみのあるものに置き換わっていきました。"},
 {t:223.39,s:"たとえば、"},
 {t:224.27,s:"原文ではカヌーだった舟が、"},
 {t:226.54,s:"いつの間にか、"},
 {t:227.77,s:"ただのボートになっている。"},
 {t:230.04,s:"学生たちが知っている舟に、"},
 {t:232.32,s:"変わっていたんです。"},
 {t:234.07,s:"バートレットは、"},
 {t:235.57,s:"この結果から、"},
 {t:236.88,s:"記憶についてこう書いています。"},
 {t:239.69,s:"思い出すというのは、"},
 {t:241.59,s:"固定された跡を、"},
 {t:243.10,s:"もう一度呼び起こすことではない。"},
 {t:246.14,s:"想像による、組み立て直しなのだ、と。"},
 {t:249.55,s:"つまり、こういうことなんです。記憶は、"},
 {t:252.91,s:"しまってあるものを"},
 {t:254.50,s:"そのまま取り出すのではありません。"},
 {t:257.51,s:"思い出すたびに、"},
 {t:258.92,s:"手元の材料で組み立て直している。"},
 {t:261.76,s:"材料は、"},
 {t:262.58,s:"昔の出来事のかけらと、"},
 {t:264.83,s:"今の自分が知っていることです。"},
 {t:267.91,s:"だから細部は、"},
 {t:269.34,s:"今の自分の方へ寄っていくわけです。"},
 {t:272.83,s:"ここで、私はもう一つ知りたくなりました。"},
 {t:277.53,s:"これは、実験室の中だけの話なのだろうか、と。"},
 {t:282.69,s:"ふだんの思い出話ではどうなのか。"},
 {t:286.01,s:"それを調べたのが、"},
 {t:287.88,s:"アメリカの心理学者、"},
 {t:289.95,s:"マーシュとトヴェルスキーの、"},
 {t:292.86,s:"二〇〇四年の研究です。"},
 {t:295.14,s:"参加した学生たちは、"},
 {t:296.82,s:"自分の出来事を人に話すたびに、"},
 {t:299.35,s:"それを書きとめていきました。"},
 {t:301.71,s:"そして、"},
 {t:302.55,s:"話した本人が、"},
 {t:304.01,s:"自分で振り返って印をつけるんです。"},
 {t:307.57,s:"大げさにしたか。省いたか。"},
 {t:310.29,s:"付け足したか。"},
 {t:311.76,s:"結果は、こうでした。"},
 {t:313.98,s:"話した本人が、"},
 {t:315.54,s:"内容を変えたと認めた語りは、"},
 {t:318.64,s:"全体の六十一パーセント。"},
 {t:321.31,s:"一方で、"},
 {t:322.09,s:"不正確だったと本人が思った語りは、"},
 {t:325.39,s:"四十二パーセントにとどまりました。"},
 {t:328.70,s:"正直に言うと、"},
 {t:330.12,s:"私はこの二つの数字の差に、"},
 {t:332.75,s:"いちばん驚きました。"},
 {t:334.78,s:"変えたと自覚していても、"},
 {t:337.21,s:"嘘をついたとは思っていないんです。"},
 {t:340.65,s:"そして話は、"},
 {t:341.86,s:"聞き手によっても変わっていました。"},
 {t:345.28,s:"楽しませたいときは大きくし、"},
 {t:348.11,s:"用件を伝えたいときは簡単にする。"},
 {t:351.33,s:"ただ、参加者は大学生です。"},
 {t:354.06,s:"年を重ねた人の昔話を、"},
 {t:356.36,s:"そのまま測ったものではありません。"},
 {t:359.93,s:"それでも、"},
 {t:360.93,s:"話すたびに細部が変わるのは、"},
 {t:363.73,s:"年をとった人に限ったことではない。"},
 {t:367.12,s:"人が話をするときの、ふつうの姿なんです。"},
 {t:372.59,s:"ここまでで、"},
 {t:373.77,s:"細部が変わる仕組みはわかりました。ですが、"},
 {t:377.88,s:"私にはまだ一つ、"},
 {t:379.45,s:"腑に落ちないことがあったんです。"},
 {t:382.58,s:"父の話は、"},
 {t:383.56,s:"でたらめに変わったのではありませんでした。"},
 {t:387.68,s:"窓を押さえていた人が、祖父から祖母へ。"},
 {t:391.40,s:"変わる向きが、あったんです。"},
 {t:394.15,s:"その向きを考える手がかりが、"},
 {t:396.64,s:"アメリカのノースウェスタン大学の心理学者、"},
 {t:400.38,s:"ダン・マクアダムスの研究にありました。"},
 {t:403.76,s:"マクアダムスは、"},
 {t:405.31,s:"人は自分の人生を、"},
 {t:407.05,s:"一つの物語として心の中に持っている、"},
 {t:410.53,s:"と考えました。これを、"},
 {t:412.66,s:"ナラティブ・アイデンティティと呼びます。"},
 {t:416.53,s:"二〇一三年、"},
 {t:417.58,s:"マクリーンとの共著の論文では、"},
 {t:420.20,s:"それをこう説明しています。"},
 {t:422.47,s:"心の中にしまわれ、"},
 {t:424.42,s:"少しずつ変わり続ける人生の物語。"},
 {t:427.89,s:"組み立て直された過去と、"},
 {t:430.49,s:"思い描いた未来をつなぎ合わせて、"},
 {t:433.96,s:"人生にまとまりと目的を与えるもの。"},
 {t:437.65,s:"実は、"},
 {t:438.30,s:"この定義の中に、"},
 {t:440.02,s:"父の話を考える鍵が入っていたんです。"},
 {t:443.90,s:"組み立て直された過去、とあります。"},
 {t:447.18,s:"この理論では、"},
 {t:448.53,s:"人生の物語の中の過去は、"},
 {t:450.85,s:"はじめから組み立て直されたものなんです。"},
 {t:454.71,s:"そして、変わり続ける、とあります。"},
 {t:457.83,s:"物語は、棚にしまわれた本ではありません。"},
 {t:461.49,s:"語る人と一緒に、"},
 {t:462.96,s:"書き足されていくものなんです。"},
 {t:465.71,s:"なぜ書き足すのか。"},
 {t:467.57,s:"人生の物語は、"},
 {t:469.01,s:"自分とは何者か、"},
 {t:470.66,s:"という問いへの答えだからです。"},
 {t:473.76,s:"語る人が変わっていけば、"},
 {t:476.24,s:"答えも少しずつ変わります。"},
 {t:478.92,s:"さて、ここで、"},
 {t:480.25,s:"もう一人の人に登場してもらいます。"},
 {t:483.47,s:"アメリカの精神科医、ロバート・バトラーです。"},
 {t:487.65,s:"一九六三年、バトラーは、"},
 {t:490.20,s:"サイカイアトリーという精神医学の学術誌に、"},
 {t:494.66,s:"一本の論文を出しました。"},
 {t:497.21,s:"題は、ライフレビュー。"},
 {t:499.55,s:"人生の振り返り、という意味です。"},
 {t:502.95,s:"当時、"},
 {t:503.54,s:"お年寄りが昔の話ばかりするのは、"},
 {t:506.68,s:"衰えのしるしだと見られていました。"},
 {t:510.02,s:"意味のないことだと、扱われていたんです。"},
 {t:513.95,s:"バトラーは、そこに異を唱えました。"},
 {t:517.71,s:"年を重ねると、人は自然に、"},
 {t:520.59,s:"自分の人生全体を振り返るようになる。"},
 {t:524.57,s:"それは誰にでも起きることだ、と。"},
 {t:528.11,s:"きっかけは、"},
 {t:529.28,s:"残された時間に限りがある、"},
 {t:531.81,s:"と感じることだと、"},
 {t:533.56,s:"バトラーは書いています。"},
 {t:535.89,s:"振り返りは、ただ懐かしむことではありません。"},
 {t:540.32,s:"昔の出来事を取り出して、見直し、"},
 {t:543.54,s:"並べ直す働きなんです。"},
 {t:545.75,s:"バトラーは、"},
 {t:546.85,s:"いいことばかりだとも言っていません。"},
 {t:550.16,s:"振り返りが、"},
 {t:551.26,s:"人によっては気持ちの落ち込みに"},
 {t:554.01,s:"つながることもある、"},
 {t:555.85,s:"と書いています。"},
 {t:557.32,s:"その一方で、"},
 {t:558.49,s:"年を重ねた人の率直さや穏やかさ、"},
 {t:561.62,s:"知恵といったものも、"},
 {t:563.57,s:"この振り返りの中から育つのだ、"},
 {t:566.50,s:"と書いているんです。"},
 {t:568.45,s:"バトラーはのちに、"},
 {t:570.21,s:"アメリカ国立老化研究所の初代所長を"},
 {t:573.52,s:"務めた人です。"},
 {t:574.89,s:"日本の介護の現場で、"},
 {t:576.81,s:"回想法と呼ばれているものがあります。"},
 {t:580.26,s:"その源流をたどると、"},
 {t:582.18,s:"この一九六三年の論文に行き着くんです。"},
 {t:586.99,s:"ここで、父の話に戻してみます。"},
 {t:590.90,s:"八十を過ぎた父が、台風の晩をまた語る。"},
 {t:594.84,s:"そのたびに、話は組み立て直されています。"},
 {t:598.98,s:"バートレットが見た仕組みです。"},
 {t:602.09,s:"そして組み立て直すとき、"},
 {t:604.38,s:"今の父が大事だと思うものが、"},
 {t:607.05,s:"少しずつ前に出てくる。"},
 {t:609.15,s:"マクアダムスの言う、変わり続ける物語です。"},
 {t:613.16,s:"あの晩、"},
 {t:613.95,s:"窓を押さえていたのは、"},
 {t:616.12,s:"本当は誰だったのか。"},
 {t:618.10,s:"正直なところ、それは私にはもうわかりません。"},
 {t:622.44,s:"父にも、わからないのかもしれません。"},
 {t:625.99,s:"ここからは、私なりの推測です。父はもう、"},
 {t:629.99,s:"あの晩の祖父母より、"},
 {t:631.99,s:"ずっと年上になっています。"},
 {t:634.59,s:"自分も親として、"},
 {t:636.11,s:"子どもを守る側に何十年も"},
 {t:638.38,s:"立ってきた人なんです。"},
 {t:640.47,s:"そういう人が振り返れば、"},
 {t:642.75,s:"あの晩の見え方が変わっても、"},
 {t:645.40,s:"不思議ではありません。"},
 {t:647.49,s:"マクアダムスの考え方に沿えば、"},
 {t:650.61,s:"細部が変わるのは、"},
 {t:652.48,s:"その話が今も、"},
 {t:653.94,s:"父の人生の物語として"},
 {t:656.02,s:"使われているしるしなんです。"},
 {t:658.93,s:"ここで、"},
 {t:659.57,s:"言っておかなければならないことがあります。"},
 {t:662.92,s:"マクアダムスの理論も、"},
 {t:664.94,s:"バトラーのライフレビューも、"},
 {t:667.51,s:"長く広く使われてきた考え方です。ですが、"},
 {t:671.18,s:"一つの実験で数字が出た、"},
 {t:673.38,s:"という種類のものではありません。"},
 {t:676.32,s:"ですから、科学が証明した、とは申しません。"},
 {t:680.53,s:"心理学者たちがこの現象をこう説明している。"},
 {t:684.74,s:"そういうことなんです。"},
 {t:686.94,s:"それから、もう一つ。"},
 {t:689.11,s:"同じ日のうちに何度も同じことを尋ねる、"},
 {t:693.23,s:"といった変化は、"},
 {t:694.96,s:"また別の話です。"},
 {t:696.70,s:"気になるときは、"},
 {t:698.43,s:"お医者さんに相談することなんです。"},
 {t:703.59,s:"次の木曜日の朝も、"},
 {t:705.59,s:"私は父を乗せて、"},
 {t:707.37,s:"同じ道を走っていました。"},
 {t:710.03,s:"田んぼの横に出たところで、"},
 {t:712.70,s:"父がまた言いました。"},
 {t:714.75,s:"あの台風の晩はな。"},
 {t:716.61,s:"窓を押さえていたのは、この日も祖母でした。"},
 {t:720.22,s:"私は、何も直しませんでした。"},
 {t:722.61,s:"代わりに、一つだけ聞いてみたんです。"},
 {t:726.33,s:"そのとき、お父さんはどこにいたの、と。"},
 {t:730.26,s:"父は少し黙ってから、言いました。"},
 {t:733.38,s:"ちゃぶ台の下で、妹を抱えてたんだ。"},
 {t:738.18,s:"何十回も聞いてきた話に、"},
 {t:740.75,s:"はじめて聞く一行が加わりました。"},
 {t:744.17,s:"なんというか、"},
 {t:745.66,s:"話は崩れたのではありませんでした。"},
 {t:749.30,s:"一枚、重なったんです。"},
 {t:751.65,s:"マーシュとトヴェルスキーが見たとおり、"},
 {t:755.42,s:"話は聞き手によって形を変えます。"},
 {t:758.60,s:"この朝の聞き手は、私でした。"},
 {t:761.38,s:"父の中で何が起きているのか、"},
 {t:764.16,s:"すべてはわかりません。"},
 {t:766.34,s:"ですが、一つ確かなことがあります。"},
 {t:769.72,s:"父は、あの晩を、"},
 {t:771.48,s:"今の自分の言葉で組み立て直していました。"},
 {t:775.87,s:"助手席で、私に向かって。"},
 {t:778.51,s:"今日お話ししたことで、"},
 {t:780.36,s:"覚えて帰っていただきたいのは、"},
 {t:782.89,s:"一つだけです。"},
 {t:784.07,s:"記憶は、録音ではありません。"},
 {t:786.91,s:"思い出すたびに組み立て直されるものです。"},
 {t:790.97,s:"それは、"},
 {t:791.79,s:"九十年あまり前の実験から、"},
 {t:794.42,s:"確かめられてきたことなんです。"},
 {t:797.47,s:"ですから、"},
 {t:798.43,s:"昔話の細部が変わるとき、"},
 {t:800.74,s:"そこで起きているのは、"},
 {t:802.86,s:"壊れていく記憶ではありません。"},
 {t:805.75,s:"一つの人生を、"},
 {t:807.09,s:"今もまとめ直している心の働きなんです。"},
 {t:812.71,s:"車は、囲碁の会の前に着きました。"},
 {t:815.91,s:"父はドアを開けながら、来週はな、"},
 {t:819.10,s:"あの川の話をしてやる、"},
 {t:821.30,s:"と言いました。"},
 {t:822.70,s:"私は、うん、と答えました。"},
 {t:825.63,s:"その話もきっと、"},
 {t:827.43,s:"前とは少し違うのだろうと思いながら。"}
];

/* ---- font Nhật: chỉ vẽ texture có chữ SAU KHI font nạp xong ---- */
if(document.fonts && document.fonts.load){
  Promise.all([
    document.fonts.load('700 96px "BIZ UDPGothic"'),
    document.fonts.load('400 96px "BIZ UDPGothic"')
  ]).then(function(){
    FONT_READY = true;
    drawTextTextures();
    var tl = window.__timelines && window.__timelines["monogatari"];
    renderAtTime(tl ? tl.time() : 0);
  });
}

/* ⚠ Dòng đăng ký phải nằm NGUYÊN DẠNG trong file này — StaticGuard quét VĂN BẢN.
 * Khoá trùng ĐÚNG data-composition-id của div gốc. */
window.__timelines = window.__timelines || {};
window.__timelines["monogatari"] = HFA.makeTimeline("monogatari", TOTAL, renderAtTime);

</script>
</body>
</html>

