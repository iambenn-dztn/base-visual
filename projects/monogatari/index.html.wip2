/* =========================================================================
 * NGƯỜI — chỉ dáng/lưng/tay, KHÔNG dựng mặt. Khớp nối phủ bằng cầu để không lộ
 * đường cắt (ràng buộc B). Đứng quay lưng về camera, hai tay ấn lên kính.
 * ========================================================================= */
function buildAdult(o){
  var g = new THREE.Group();
  var cloth = stdMat(o.cloth, 0.92, 0), skin = stdMat(o.skin, 0.7, 0), hair = stdMat(o.hair, 0.85, 0), pants = stdMat(o.pants, 0.92, 0);
  var h = o.h, hip = 0.52*h, sh = 0.835*h, sw = o.sw;
  var lean = -0.05;
  /* chân: quần (ông) / もんぺ ống rộng bó cổ chân (bà) */
  var lr = o.female ? 0.095 : 0.075, lr2 = o.female ? 0.07 : 0.056;
  g.add(limb([-0.09,hip,0],[-0.10,0.08,0.02], lr,lr2, pants));
  g.add(limb([ 0.09,hip,0],[ 0.10,0.08,0.02], lr,lr2, pants));
  g.add(sph(lr2, pants, -0.10,0.08,0.02)); g.add(sph(lr2, pants, 0.10,0.08,0.02));
  g.add(sph(0.16, pants, 0,hip,0, 1,0.55,0.75));
  g.add(box(0.09,0.05,0.22, stdMat(0x191512,0.8), -0.10,0.025,-0.02));
  g.add(box(0.09,0.05,0.22, stdMat(0x191512,0.8),  0.10,0.025,-0.02));
  /* áo khoác (半纏): phủ từ dưới hông tới vai, rộng ở vạt */
  var tor = limb([0,hip-0.14,0.01],[0,sh,lean], 0.20, sw*0.42, cloth, 24); tor.scale.set(1,1,0.66); g.add(tor);
  g.add(sph(0.20, cloth, 0,hip-0.14,0.01, 1,0.18,0.66));
  var sL = [-sw*0.46, sh-0.02, lean], sR = [sw*0.46, sh-0.02, lean];
  g.add(sph(0.068, cloth, sL[0],sL[1],sL[2]));
  g.add(sph(0.068, cloth, sR[0],sR[1],sR[2]));
  g.add(sph(sw*0.36, cloth, 0,sh-0.03,lean, 1.25,0.42,0.62));        /* vai liền khối */
  g.add(limb([0,sh,lean],[0,sh+0.08,lean-0.01], 0.045,0.042, skin));
  var hc = [0, sh+0.08+0.095*o.hs, lean-0.02];
  g.add(sph(0.095*o.hs, skin, hc[0],hc[1],hc[2], 0.9,1.08,1.0));
  /* tóc phủ đỉnh + gáy (nhìn từ sau không thấy mặt) */
  var hm = new THREE.Mesh(new THREE.SphereGeometry(0.1*o.hs, 28, 20, 0, Math.PI*2, 0, Math.PI*0.62), hair);
  hm.position.set(hc[0],hc[1]+0.004,hc[2]+0.006); hm.scale.set(0.93,1.08,1.03); hm.rotation.x = 0.35; g.add(hm);
  if(o.bun) g.add(sph(0.05, hair, hc[0], hc[1]+0.06, hc[2]+0.075));
  /* tay: vai → khuỷu → bàn tay ấn trên kính */
  var hands = o.hands;
  for(var s=0;s<2;s++){
    var S = s===0 ? sL : sR, Hd = hands[s];
    var E = [(S[0]+Hd[0])/2 + (s===0?-0.045:0.045), (S[1]+Hd[1])/2 - 0.08, (S[2]+Hd[2])/2];
    g.add(limb(S, E, 0.066, 0.06, cloth));
    g.add(sph(0.06, cloth, E[0],E[1],E[2]));
    g.add(limb(E, [Hd[0],Hd[1]-0.02,Hd[2]+0.05], 0.058, 0.05, cloth));
    g.add(sph(0.05, cloth, Hd[0],Hd[1]-0.02,Hd[2]+0.05, 1,1,0.35));
    g.add(limb([Hd[0],Hd[1]-0.02,Hd[2]+0.05],[Hd[0],Hd[1]-0.03,Hd[2]+0.02], 0.03,0.028, skin));
    var hand = sph(0.05, skin, Hd[0],Hd[1],Hd[2], 0.95,1.35,0.42);
    g.add(hand);
  }
  g.position.set(o.pos[0],0,o.pos[2]);
  return g;
}
/* ông: 1m65, vai rộng, tóc ngắn sẫm | bà: 1m50, búi tóc, kimono */
var FIG_GF = buildAdult({h:1.66, sw:0.44, hs:1.0, cloth:0x1a2029, pants:0x16181c, skin:0x6e4e3e, hair:0x1e1c1a,
  pos:[0,0,-1.52], hands:[[-0.31,1.47,-0.63],[0.33,1.44,-0.69]]});
var FIG_GM = buildAdult({h:1.50, sw:0.37, hs:0.96, female:true, bun:true, cloth:0x2c201d, pants:0x2a2226, skin:0x6e503f, hair:0x131110,
  pos:[0.06,0,-1.64], hands:[[-0.27,1.34,-0.51],[0.29,1.30,-0.57]]});
R.g.add(FIG_GM); R.g.add(FIG_GF);

/* hai đứa trẻ dưới chabudai: cha (≈8 tuổi) ôm em gái — nằm co, không mặt */
var KIDS = new THREE.Group();
(function(){
  /* cha lúc nhỏ: nằm nghiêng dưới bàn, lưng về camera (+z), đầu bên trái, co gối ôm em */
  var shirt = stdMat(0x505a6a, 0.9), shorts = stdMat(0x23262e, 0.9), skin = stdMat(0x8a6450, 0.7), hair = stdMat(0x0f0e0d, 0.8);
  var dress = stdMat(0x7e2f2a, 0.9);
  /* lưng + vai (nhìn từ sau) */
  var tor = limb([-0.20,0.105,0.02],[0.08,0.10,0.03], 0.085, 0.075, shirt, 20); tor.scale.set(1,1,0.85); KIDS.add(tor);
  KIDS.add(sph(0.088, shirt, -0.20,0.105,0.02, 0.8,1,0.9));
  KIDS.add(sph(0.08, shorts, 0.10,0.095,0.03, 1.0,0.95,1.0));
  /* đùi co lên phía trước (−z), cẳng chân gập lại */
  KIDS.add(limb([0.10,0.09,0.0],[0.15,0.08,-0.20], 0.055,0.048, shorts));
  KIDS.add(sph(0.046, skin, 0.15,0.08,-0.20));
  KIDS.add(limb([0.15,0.08,-0.20],[0.30,0.06,-0.13], 0.042,0.034, skin));
  KIDS.add(box(0.05,0.035,0.075, stdMat(0x5a534a,0.9), 0.315,0.05,-0.125));
  /* đầu: tóc đen phủ gáy (quay lưng), tai */
  KIDS.add(limb([-0.28,0.12,0.015],[-0.33,0.13,0.01], 0.035,0.035, skin));
  KIDS.add(sph(0.078, hair, -0.40,0.145,0.0, 1.0,0.95,1.0));
  KIDS.add(sph(0.016, skin, -0.40,0.215,0.005, 1,0.6,0.8));
  /* tay trên vòng qua em: vai → khuỷu → bàn tay đặt lên lưng em */
  KIDS.add(limb([-0.20,0.18,0.0],[-0.12,0.21,-0.12], 0.036,0.033, shirt));
  KIDS.add(sph(0.034, shirt, -0.12,0.21,-0.12));
  KIDS.add(limb([-0.12,0.21,-0.12],[-0.22,0.19,-0.22], 0.03,0.026, skin));
  KIDS.add(sph(0.03, skin, -0.23,0.19,-0.225, 1.0,0.75,1.2));
  /* em gái: nằm trong vòng tay, phía xa camera — thấy đỉnh đầu + vai + gấu váy */
  KIDS.add(sph(0.075, dress, -0.16,0.11,-0.19, 1.3,0.9,0.9));
  KIDS.add(sph(0.062, hair, -0.31,0.14,-0.19));
  KIDS.add(sph(0.018, stdMat(0xc8403a,0.6), -0.30,0.20,-0.17));   /* kẹp tóc đỏ */
  KIDS.add(limb([-0.06,0.07,-0.20],[0.04,0.05,-0.24], 0.03,0.025, skin));
})();
R.g.add(KIDS);

/* =========================================================================
 * NGÔI NHÀ BÊN RUỘNG (nhìn từ ngoài, S04) — đặt ở x=+60
 * ========================================================================= */
var HOUSE_WIN_MAT = new THREE.MeshBasicMaterial({color:new THREE.Color(1.6,0.95,0.45)});
(function buildHouse(){
  var g = R.ext, cx0 = 60;
  var ground = new THREE.Mesh(new THREE.PlaneGeometry(220,160), stdMat(0xffffff,0.9,0,{map:canvasTex(512,512,function(cx,w,h){
    var r = HFA.mulberry32(51); cx.fillStyle = '#1d2216'; cx.fillRect(0,0,w,h);
    for(var y=0;y<h;y+=4){ cx.fillStyle = 'rgba(60,70,40,' + (0.2+r()*0.25).toFixed(2) + ')'; cx.fillRect(0,y,w,1.5); }
    for(var i=0;i<40;i++){ cx.fillStyle = 'rgba(90,100,120,0.12)'; cx.fillRect(r()*w, r()*h, 20+r()*60, 3+r()*6); }
  },{repeat:[10,8]})}));
  ground.rotation.x = -Math.PI/2; ground.position.set(cx0,0,-10); g.add(ground);
  /* 畦 (bờ ruộng) */
  for(var k=0;k<6;k++){ g.add(box(60,0.18,0.5, stdMat(0x2a2a1c,0.9), cx0, 0.09, 12 - k*9)); }
  var wallM = stdMat(0x6d6352, 0.92), roofM = stdMat(0x2b303a, 0.5, 0.25), woodM = stdMat(0x2e2219, 0.8);
  g.add(box(10,2.9,6.5, wallM, cx0,1.45,-3.5));
  g.add(box(10.4,0.35,6.9, woodM, cx0,0.18,-3.5));     /* 基礎 */
  /* mái đầu hồi hai mảng */
  var rl = box(11.4,0.16,4.4, roofM, cx0,3.72,-1.55); rl.rotation.x = -0.52; g.add(rl);
  var rr = box(11.4,0.16,4.4, roofM, cx0,3.72,-5.45); rr.rotation.x = 0.52; g.add(rr);
  g.add(box(11.5,0.22,0.3, roofM, cx0,4.72,-3.5));
  var shp = new THREE.Shape(); shp.moveTo(-3.3,0); shp.lineTo(3.3,0); shp.lineTo(0,1.85); shp.lineTo(-3.3,0);
  var gab = new THREE.Mesh(new THREE.ShapeGeometry(shp), wallM); gab.position.set(cx0+5.0,2.9,-3.5); gab.rotation.y = Math.PI/2; g.add(gab);
  var gab2 = gab.clone(); gab2.position.x = cx0-5.0; gab2.rotation.y = -Math.PI/2; g.add(gab2);
  /* 縁側 + cửa kính sáng đèn */
  g.add(box(9.6,0.1,1.1, woodM, cx0,0.55,0.05));
  var wins = [[-2.6,1.55,2.6,1.6],[1.6,1.55,1.3,1.0],[3.6,1.55,1.3,1.0]];
  for(var i=0;i<wins.length;i++){
    var w = wins[i];
    var pane = new THREE.Mesh(new THREE.PlaneGeometry(w[2],w[3]), HOUSE_WIN_MAT);
    pane.position.set(cx0+w[0], w[1], -0.24); g.add(pane);
    g.add(box(w[2]+0.12,0.08,0.1, woodM, cx0+w[0], w[1]+w[3]/2, -0.22));
    g.add(box(w[2]+0.12,0.08,0.1, woodM, cx0+w[0], w[1]-w[3]/2, -0.22));
    for(var m=0;m<=4;m++){ g.add(box(0.05,w[3],0.08, woodM, cx0+w[0]-w[2]/2+m*w[2]/4, w[1], -0.22)); }
  }
  var HOUSE_GLOW = new THREE.PointLight(0xffa050, 1.2, 8, 1.5); HOUSE_GLOW.position.set(cx0-2.2,1.5,1.2); g.add(HOUSE_GLOW);
  R.houseGlow = HOUSE_GLOW;
  var EXT_AMB = new THREE.HemisphereLight(0x4a5a78, 0x151812, 0.55); g.add(EXT_AMB);
  tree(g, cx0-8, -7, 7.5, 61); tree(g, cx0+7.5, -9, 8.5, 62); tree(g, cx0+11, -2, 6.0, 63); tree(g, cx0-12.5, -3, 6.8, 64); tree(g, cx0+2, -13, 9.5, 65);
})();

/* =========================================================================
 * renderRoom(rt, cfg) — vẽ một "lần kể" vào render-target.
 *   who: 'gf' | 'gm' | null · light: 'candle' | 'flash' · kids: bool
 *   table: [x,z] · cam: [px,py,pz,lx,ly,lz,fov] · storm: hệ số gió/mưa
 *   simple: bỏ mưa/cây/bàn (lần kể "cho gọn") · focus: đèn ấm đẩy vào người giữ cửa
 *   ext: nhìn ngôi nhà từ ngoài
 * ========================================================================= */
var RC_MAIN  = [1.05,1.20,1.30, -0.12,1.12,-2.1, 48];
function renderRoom(rt, cfg, t){
  var storm = cfg.storm == null ? 1 : cfg.storm;
  var ext = !!cfg.ext;
  R.g.visible = !ext; R.ext.visible = ext;
  FIG_GF.visible = cfg.who === 'gf';
  FIG_GM.visible = cfg.who === 'gm';
  KIDS.visible = !!cfg.kids;
  var tb = cfg.table || [0.30,-0.40];
  CHABU.position.set(tb[0],0,tb[1]);
  CHABU.visible = !cfg.simple;
  KIDS.position.set(tb[0]+0.02,0,tb[1]+0.03);
  /* nến */
  var fl = 1 + 0.07*Math.sin(t*13.1) + 0.05*Math.sin(t*29.7+1.3) + 0.03*Math.sin(t*47.3+0.4);
  CANDLE.visible = cfg.light === 'candle' && !cfg.simple;
  CANDLE.position.set(tb[0]-0.12, 0.333, tb[1]+0.05);
  CANDLE_L.intensity = 1.7*fl;
  CANDLE.userData.flame.scale.set(1, 2.6*(0.94+0.06*fl), 1);
  CANDLE.userData.flame.rotation.z = 0.06*Math.sin(t*3.1);
  /* đèn pin nằm trên bàn, rọi vào cửa */
  var useFlash = cfg.light === 'flash';
  FLASH.visible = useFlash && !cfg.simple;
  FLASH.position.set(tb[0]+0.08, 0.333, tb[1]-0.02);
  FLASH.rotation.set(0.0, 0.67, 0);
  FLASH_TGT.position.set(-1.0,1.35,-2.2);
  FLASH_L.intensity = useFlash ? (cfg.simple ? 0 : 2.6) : 0;
  BEAM.visible = useFlash && !cfg.simple;
  if(BEAM.visible){
    FLASH.updateMatrixWorld(true);
    var a = FLASH.localToWorld(new THREE.Vector3(0,0.03,-0.12));
    var b = new THREE.Vector3(-1.0,1.35,-2.17);
    var d = b.clone().sub(a); var L = d.length();
    BEAM.position.copy(a).add(b).multiplyScalar(0.5);
    BEAM.quaternion.setFromUnitVectors(new THREE.Vector3(0,-1,0), d.clone().normalize());
    BEAM.scale.set(1, L, 1);
  }
  /* cửa rung theo gió — hàm thuần của t */
  var gust = 0.55 + 0.45*Math.sin(t*0.37) * Math.sin(t*0.11+1.0);
  for(var i=0;i<PANES.length;i++){
    var p = PANES[i], bs = p.userData.base;
    var jx = storm*0.0045*gust*(Math.sin(t*23.0+i*1.7) + 0.6*Math.sin(t*37.0+i));
    p.position.set(bs[0]+jx, bs[1], bs[2] + storm*0.002*gust*Math.sin(t*17.0+i*2.3));
    p.rotation.z = storm*0.0022*gust*Math.sin(t*19.0+i*0.9);
  }
  for(var k=0;k<TREES.length;k++){
    var tr = TREES[k], ph = tr.userData.ph;
    tr.userData.sway.rotation.z = storm*(0.10 + 0.08*gust)*Math.sin(t*1.3+ph) + storm*0.05*Math.sin(t*3.7+ph*2.0);
    tr.userData.sway.rotation.x = storm*0.04*Math.sin(t*1.1+ph*1.3);
    tr.visible = !cfg.simple || ext;
  }
  RAIN_WIN.visible = !cfg.simple; RAIN_WIN.material.uniforms.uT.value = t; RAIN_WIN.material.uniforms.uI.value = 0.9*storm; RAIN_WIN.material.uniforms.uWind.value = storm;
  RAIN_EXT.material.uniforms.uT.value = t; RAIN_EXT.material.uniforms.uI.value = 0.8*storm; RAIN_EXT.material.uniforms.uWind.value = storm;
  GLASSRAIN.visible = !cfg.simple; GLASSRAIN.material.uniforms.uT.value = t; GLASSRAIN.material.uniforms.uI.value = 0.9*Math.min(1.6,storm);
  GLASSRAIN.material.uniforms.uCol.value.setRGB(useFlash?0.16:0.13, useFlash?0.17:0.11, useFlash?0.20:0.09);
  SKYSTORM.material.uniforms.uT.value = t*storm;
  HOUSE_WIN_MAT.color.setRGB(1.6*fl, 0.95*fl, 0.45*fl);
  R_FOCUS.intensity = (cfg.focus||0)*2.2;
  R_FOCUS_T.position.set(0,1.2,-1.7);
  R_KIDFILL.intensity = cfg.kids ? 0.45 : 0;
  R_KIDFILL.position.set(tb[0]-0.1,0.22,tb[1]+0.45);
  R_AMB.intensity = cfg.simple ? 0.55 : 0.30;
  var c = cfg.cam || RC_MAIN;
  roomCam.position.set(c[0],c[1],c[2]); roomCam.lookAt(c[3],c[4],c[5]);
  if(roomCam.fov !== (c[6]||48)){ roomCam.fov = c[6]||48; roomCam.updateProjectionMatrix(); }
  renderer.setRenderTarget(rt);
  renderer.setClearColor(0x020304,1);
  renderer.clear(true,true,true);
  renderer.render(roomScene, roomCam);
  renderer.setRenderTarget(null);
  renderer.setClearColor(0x000000,1);
}
/* ba "lần kể" chuẩn */
var V0 = {who:'gf', light:'candle', table:[0.22,-0.42]};                 /* bản quen: ông + nến */
var V1 = {who:'gm', light:'flash',  table:[0.42,-0.30]};                 /* sáng nay: bà + đèn pin */
var VX = {who:'gm', light:'candle', table:[0.32,-0.36]};                 /* một lần kể lai khác */
var V2 = {who:'gm', light:'flash',  table:[0.42,-0.30], kids:true};      /* lớp mới: dưới chabudai */
function withCfg(base, extra){ var o = {}, k; for(k in base) o[k] = base[k]; for(k in extra) o[k] = extra[k]; return o; }


/* =========================================================================
 * NHÓM CẢNH TRONG SCENE CHÍNH — mỗi nhóm TỰ MANG ĐÈN của nó (lỗi 4: thiếu đèn).
 * Nhóm ẩn thì đèn trong nhóm cũng tắt theo.
 * ========================================================================= */
var G = {};
['car','voidbg','plates','desk','cass','water','tok','hg','chair','care','shelf','shards'].forEach(function(k){
  G[k] = new THREE.Group(); G[k].visible = false; scene.add(G[k]);
});

/* =========================================================================
 * XE BUỔI SÁNG — nội thất nhìn từ ghế lái (góc nhìn của 私), ruộng lúa trôi qua.
 * Tay lái bên phải (xe Nhật), cha ngồi ghế phụ bên trái. Chỉ thấy gáy/vai cha.
 * Xe đứng yên ở gốc toạ độ; THẾ GIỚI trôi về +z theo quãng đường d(t).
 * ========================================================================= */
var CAR = { world:new THREE.Group(), cabin:new THREE.Group() };
G.car.add(CAR.world); G.car.add(CAR.cabin);
(function carLights(){
  var sun = new THREE.DirectionalLight(0xfff0da, 1.55); sun.position.set(-40,45,-55); G.car.add(sun);
  var hemi = new THREE.HemisphereLight(0xc4d8f4, 0x6e6444, 0.62); G.car.add(hemi);
  var amb = new THREE.AmbientLight(0xfff2e0, 0.10); G.car.add(amb);
  CAR.sun = sun;
})();
/* bầu trời sáng: xanh nhạt, mây mỏng tĩnh */
var CAR_SKY = new THREE.Mesh(new THREE.SphereGeometry(1500, 40, 24), new THREE.ShaderMaterial({
  uniforms:{uT:{value:0}},
  vertexShader:'varying vec3 vP;void main(){vP=normalize(position);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}',
  fragmentShader:[
    'varying vec3 vP;uniform float uT;',
    'float hh(vec2 p){return fract(sin(dot(p,vec2(12.9898,78.233)))*43758.5453);}',
    'float vn(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);return mix(mix(hh(i),hh(i+vec2(1,0)),f.x),mix(hh(i+vec2(0,1)),hh(i+vec2(1,1)),f.x),f.y);}',
    'float fbm(vec2 p){float a=0.5,s=0.0;for(int i=0;i<5;i++){s+=a*vn(p);p*=2.02;a*=0.5;}return s;}',
    'void main(){ vec3 d=normalize(vP); float y=max(d.y,0.0);',
    ' vec3 zen=vec3(0.16,0.30,0.58), hor=vec3(0.66,0.74,0.82);',
    ' vec3 c=mix(hor,zen,pow(y,0.55));',
    ' vec2 q=d.xz/(d.y+0.12)*1.6+vec2(uT*0.004,0.0);',
    ' float cl=smoothstep(0.52,0.85,fbm(q*1.3))*smoothstep(0.02,0.25,d.y);',
    ' c=mix(c,vec3(0.95,0.95,0.93),cl*0.75);',
    ' c=mix(c,vec3(0.72,0.75,0.74),smoothstep(0.03,-0.02,d.y));',
    ' gl_FragColor=vec4(c*1.25,1.0); }'
  ].join('\n'),
  side:THREE.BackSide, depthWrite:false
}));
CAR_SKY.renderOrder = -10; CAR.world.add(CAR_SKY);

/* đường nhựa: texture trượt theo quãng đường (offset là hàm của t) */
var ROAD_TEX = canvasTex(256,1024,function(cx,w,h){
  var r = HFA.mulberry32(71);
  cx.fillStyle = '#4a4a48'; cx.fillRect(0,0,w,h);
  for(var i=0;i<14000;i++){ var v = 50 + r()*60; cx.fillStyle = 'rgba(' + v + ',' + v + ',' + (v-2) + ',0.5)'; cx.fillRect(r()*w, r()*h, 1+r()*2, 1+r()*2); }
  /* vạch mép trái (liền), tim đường (đứt) */
  cx.fillStyle = '#d9d6cc'; cx.fillRect(10,0,7,h);
  cx.fillStyle = '#d9d6cc'; cx.fillRect(w/2-4,0,8,h*0.5);
  cx.fillStyle = 'rgba(30,30,30,0.25)'; cx.fillRect(w*0.2,0,w*0.1,h); cx.fillRect(w*0.7,0,w*0.1,h);
},{repeat:[1,60]});
ROAD_TEX.wrapS = THREE.ClampToEdgeWrapping;
var ROAD = new THREE.Mesh(new THREE.PlaneGeometry(6.0, 600), stdMat(0xffffff, 0.92, 0, {map:ROAD_TEX}));
ROAD.rotation.x = -Math.PI/2; ROAD.position.set(1.5, 0.0, -270); CAR.world.add(ROAD);
/* ruộng lúa chín hai bên (vàng lục) — texture trượt cùng tốc độ */
var PADDY_TEX = canvasTex(512,512,function(cx,w,h){
  var r = HFA.mulberry32(72);
  cx.fillStyle = '#958a40'; cx.fillRect(0,0,w,h);
  for(var b=0;b<14;b++){ cx.fillStyle = 'rgba(' + (r()<0.5 ? '110,120,52' : '170,140,62') + ',0.18)'; cx.fillRect(r()*w, r()*h, 60+r()*200, 30+r()*120); }
  for(var i=0;i<26000;i++){ var g = r(); cx.fillStyle = g<0.5 ? 'rgba(120,112,50,0.35)' : (g<0.8 ? 'rgba(176,150,70,0.35)' : 'rgba(90,96,48,0.35)'); cx.fillRect(r()*w, r()*h, 1+r()*2, 3+r()*6); }
  for(var y=0;y<h;y+=8){ cx.fillStyle = 'rgba(70,64,30,0.12)'; cx.fillRect(0,y,w,2); }
  cx.fillStyle = '#5e6a3a'; cx.fillRect(0,h-10,w,10);     /* 畦 */
},{repeat:[5,27]});
var PADDY_L = new THREE.Mesh(new THREE.PlaneGeometry(90, 600), stdMat(0xffffff, 0.95, 0, {map:PADDY_TEX}));
PADDY_L.rotation.x = -Math.PI/2; PADDY_L.position.set(-46.2, -0.25, -270); CAR.world.add(PADDY_L);
var PADDY_R = new THREE.Mesh(new THREE.PlaneGeometry(90, 600), stdMat(0xffffff, 0.95, 0, {map:PADDY_TEX}));
PADDY_R.rotation.x = -Math.PI/2; PADDY_R.position.set(49.2, -0.25, -270); CAR.world.add(PADDY_R);
/* lề cỏ hai bên đường */
var VERGE_M = stdMat(0x5f6b3a, 0.95);
var VL = new THREE.Mesh(new THREE.PlaneGeometry(1.4,600), VERGE_M); VL.rotation.x = -Math.PI/2; VL.position.set(-2.2,-0.12,-270); CAR.world.add(VL);
var VR = new THREE.Mesh(new THREE.PlaneGeometry(1.4,600), VERGE_M); VR.rotation.x = -Math.PI/2; VR.position.set(5.2,-0.12,-270); CAR.world.add(VR);
/* nền xa + núi tầng tầng (mờ theo khí quyển) */
var FARLAND = new THREE.Mesh(new THREE.PlaneGeometry(3000,2000), stdMat(0x7d7a45,0.95));
FARLAND.rotation.x = -Math.PI/2; FARLAND.position.set(0,-0.4,-1300); CAR.world.add(FARLAND);
(function mountains(){
  var cols = [0x8497a8, 0x9aabb9, 0xadbcc7];
  for(var L=0;L<3;L++){
    var r = HFA.mulberry32(80+L);
    var shp = new THREE.Shape(); var x0 = -1600, x1 = 1600; shp.moveTo(x0,-20);
    for(var x=x0;x<=x1;x+=40){
      var y = 60 + 70*Math.sin(x*0.004+L*1.7) + 45*Math.sin(x*0.011+L) + 25*r() + L*30;
      shp.lineTo(x, y);
    }
    shp.lineTo(x1,-20); shp.lineTo(x0,-20);
    var m = new THREE.Mesh(new THREE.ShapeGeometry(shp), new THREE.MeshBasicMaterial({color:cols[L], fog:false}));
    m.position.set(0,0,-700 - L*180); CAR.world.add(m);
  }
})();
/* cột điện + dây: vị trí z = hàm tuần hoàn của quãng đường */
var POLES = [], POLE_N = 10, POLE_SP = 45, POLE_LEN = POLE_N*POLE_SP;
var M_POLE = stdMat(0x8c8a84, 0.85);
for(var ip=0; ip<POLE_N; ip++){
  var pg = new THREE.Group();
  pg.add(limb([0,0,0],[0,10.5,0], 0.16, 0.12, M_POLE, 12));
  pg.add(box(1.6,0.1,0.1, stdMat(0x5b5a55,0.8), 0,9.8,0));
  pg.add(box(0.9,0.08,0.08, stdMat(0x5b5a55,0.8), 0,8.9,0));
  CAR.world.add(pg); POLES.push(pg);
}
var WIRE_SEG = 10;
var WIRE_POS = new Float32Array(POLE_N*3*WIRE_SEG*2*3);
var WIRE_G = new THREE.BufferGeometry(); WIRE_G.setAttribute('position', new THREE.BufferAttribute(WIRE_POS,3));
var WIRES = new THREE.LineSegments(WIRE_G, new THREE.LineBasicMaterial({color:0x2a2a2a}));
WIRES.frustumCulled = false; CAR.world.add(WIRES);
/* nhà nông + lùm cây xa, trôi chậm (tuần hoàn dài) */
var FARMS = [];
(function(){
  var r = HFA.mulberry32(90);
  for(var i=0;i<9;i++){
    var g = new THREE.Group();
    var side = (i%2===0) ? -1 : 1;
    var x = side*(38 + r()*90);
    var wallC = [0xd8d0c0,0xc9bea8,0xb9ad96][i%3];
    g.add(box(10,4,7, stdMat(wallC,0.9), 0,2,0));
    var rf = box(11,0.3,4.2, stdMat(0x3e4450,0.6,0.2), 0,4.6,-1.7); rf.rotation.x = -0.5; g.add(rf);
    var rf2 = box(11,0.3,4.2, stdMat(0x3e4450,0.6,0.2), 0,4.6,1.7); rf2.rotation.x = 0.5; g.add(rf2);
    for(var k=0;k<3;k++){ g.add(sph(3+r()*2, stdMat(0x3d5230,0.95), (r()-0.5)*16, 3+r()*2, -6-r()*6, 1.2,0.9,1)); }
    g.rotation.y = r()*0.6-0.3;
    g.userData = {x:x, z0:i*110 + r()*40};
    CAR.world.add(g); FARMS.push(g);
  }
})();
