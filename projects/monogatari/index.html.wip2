  g.add(box(0.05,0.86,0.05, fm, -1.27,1.45,-1.03)); g.add(box(0.05,0.86,0.05, fm, -0.13,1.45,-1.03)); g.add(box(0.03,0.8,0.04, fm, -0.7,1.45,-1.03));
  /* đèn bàn */
  var metal = stdMat(0x2c2c2e,0.35,0.7);
  var base = new THREE.Mesh(new THREE.CylinderGeometry(0.09,0.1,0.025,32), metal); base.position.set(0.62,0.757,-0.72); g.add(base);
  g.add(limb([0.62,0.76,-0.72],[0.55,1.12,-0.78], 0.012,0.012, metal));
  g.add(sph(0.018, metal, 0.55,1.12,-0.78));
  g.add(limb([0.55,1.12,-0.78],[0.36,1.20,-0.55], 0.011,0.011, metal));
  var shade = new THREE.Mesh(new THREE.ConeGeometry(0.11,0.15,32,1,true), stdMat(0x3a4a3c,0.5,0.4,{side:THREE.DoubleSide}));
  shade.position.set(0.33,1.17,-0.52); shade.rotation.set(0.45,0,0.3); g.add(shade);
  D.bulbMat = new THREE.MeshBasicMaterial({color:new THREE.Color(4.0,3.0,1.8)});
  var bulb = sph(0.03, D.bulbMat, 0.325,1.13,-0.505); g.add(bulb);
  D.lamp = new THREE.SpotLight(0xffc98f, 1.3, 4.0, 0.85, 0.85, 1.2);
  D.lamp.position.set(0.32,1.12,-0.50); g.add(D.lamp);
  D.lampT = new THREE.Object3D(); D.lampT.position.set(0.0,0.74,-0.35); g.add(D.lampT); D.lamp.target = D.lampT;
  D.amb = new THREE.AmbientLight(0x5a6478, 0.16); g.add(D.amb);
  D.morning = new THREE.DirectionalLight(0xfff0d8, 0.0); D.morning.position.set(-2.2,3.0,-3.0); g.add(D.morning);
  D.fill = new THREE.PointLight(0xffd6a8, 0.25, 3.0, 1.5); D.fill.position.set(-0.3,1.3,0.6); g.add(D.fill);
})();

