  deskObjects({sheets:sheetPose(T), mug:[0.62,-0.12], lamp:1, lampT:[0,-0.40],
    skel: 0.8*ramp(T,200.1,202.0) - 0.35*ramp(T,210.4,212.0)});
  var pan = ramp(T, 213.8, 220.5);
  camLerp([0.0,1.52,0.02, 0.0,0.745,-0.40, 40], [0.22,1.30,-0.06, 0.14,0.745,-0.40, 38], pan);
}, 0.3, 0.45);
