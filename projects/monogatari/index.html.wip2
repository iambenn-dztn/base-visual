});
S('S18', 232.07, 247.55, function(u,T){
  useVoid(0.6, 0.9);
  G.shards.visible = true;
  renderRoom(rtA, V0, T);
  setShards(T, 0.0, rtA, rtA, 0, 3.0, 0.03, -4.0, 0.30, TINT_OLD, TINT_NEW);
  cam(0,0,1.5, 0,0,-4, 42);
  kOn('kQsrc', win(T, 232.4, 247.3, 0.8));
