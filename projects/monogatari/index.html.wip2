function chairScene(T, warm, ring, ringY, coolBack){
  G.chair.visible = true; useVoid(0.5, 0.8);
  CH.winMat.color.setRGB(lerp(0.42,0.72,warm), lerp(0.47,0.60,warm), lerp(0.55,0.44,warm));
  CH.key.color.setRGB(lerp(0.75,1.0,warm), lerp(0.80,0.88,warm), lerp(0.88,0.7,warm));
  CH.key.intensity = lerp(0.7, 1.0, warm);
  CH.warm.intensity = 1.4*warm;
  if(ring > 0){
    for(var i=0;i<8;i++){
      var a = Math.PI*0.42 + i/7*Math.PI*1.16 + 0.05*Math.sin(T*0.1);
      var x = Math.sin(a)*2.5, z = Math.cos(a)*2.5 - 0.3;
      var tint = tintMix([0.7,0.8,1.0],[1.1,0.97,0.85], 1-coolBack);
      plate(LIFE[i], x, ringY + 0.12*Math.sin(i*1.7), z, 1.25, {srgb:true, tint:tint, sat:lerp(0.35,0.9,1-coolBack), op:ring*0.9, bright:lerp(0.5,1.0,1-coolBack), ry:a + Math.PI});
    }
  }
}
