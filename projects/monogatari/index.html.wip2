  rs.lineTo(-sw2+rr,sh2); rs.quadraticCurveTo(-sw2,sh2,-sw2,sh2-rr); rs.lineTo(-sw2,-sh2+rr); rs.quadraticCurveTo(-sw2,-sh2,-sw2+rr,-sh2);
  var sb = new THREE.Mesh(new THREE.ExtrudeGeometry(rs,{depth:0.09, bevelEnabled:true, bevelThickness:0.025, bevelSize:0.025, bevelSegments:4, curveSegments:10}), M_SEAT);
  sb.position.set(-0.37,0.78,0.30); sb.rotation.x = 0.12; c.add(sb);
