  deskObjects({book:[0.02,-0.36,0.35], stack:[-0.42,-0.55], mug:[0.46,-0.18], lamp:ramp(T,108.9,110.2)});
  var p = ramp(T, 114.8, 120.5);
  camLerp([0.05,1.30,0.85, 0,0.80,-0.5, 42], [0.12,1.08,0.30, 0.02,0.76,-0.36, 40], p*0.8 + u/12.4*0.2);
}, 0.8, 0.45);
