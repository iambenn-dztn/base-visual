  alb.add(box(0.62,0.02,0.36, stdMat(0x3a2418,0.8), 0,0,0));
  alb.add(box(0.29,0.006,0.33, stdMat(0x1c1c1c,0.9), -0.15,0.013,0)); alb.add(box(0.29,0.006,0.33, stdMat(0x1c1c1c,0.9), 0.15,0.013,0));
  var ph = [[-0.2,-0.07,1],[-0.1,0.08,4],[0.1,-0.07,6],[0.2,0.08,3]];
  for(var p=0;p<ph.length;p++){ var pm = new THREE.Mesh(new THREE.PlaneGeometry(0.12,0.0675), stdMat(0xffffff,0.6,0,{map:LIFE[ph[p][2]]})); pm.rotation.x = -Math.PI/2; pm.position.set(ph[p][0],0.0175,ph[p][1]); alb.add(pm); }
  /* hai chén trà */
