  fragmentShader:'varying vec2 vUv;varying vec3 vN;varying vec3 vV;uniform float uI;void main(){ float f=abs(dot(normalize(vN),normalize(vV))); float a=pow(f,2.0)*pow(vUv.y,1.6)*uI*0.10; gl_FragColor=vec4(vec3(0.85,0.9,1.0)*a,a);}',
