var _pv = new THREE.Vector3();
function project(x,y,z){
  _pv.set(x,y,z).project(camera);
  return [ clamp((_pv.x*0.5+0.5)*W, 120, W-120), clamp((-_pv.y*0.5+0.5)*H, 90, 700) ];
}

/* =========================================================================
 * HÀM CẢNH — u: giây trong cảnh, T: giây tuyệt đối (timing.json), dur: độ dài cảnh
 * ========================================================================= */
function useVoid(warm, bright){
  G.voidbg.visible = true; G.plates.visible = true;
  VOID_BG.material.uniforms.uWarm.value = warm == null ? 0.5 : warm;
  VOID_BG.material.uniforms.uB.value = bright == null ? 1 : bright;
}
/** lớp ảnh phủ kín khung (cảnh "bên trong" ký ức) */
function fullPlate(tex, tint, sat, op, bright){
  cam(0,0,0, 0,0,-1, 40);
  var w = 2*2.0*Math.tan(20*Math.PI/180)*16/9*1.02;
  plate(tex, 0,0,-2.0, w, {tint:tint, sat:sat, op:op==null?1:op, bright:bright==null?1:bright, feather:0.012, edge:0});
}
function carD(T){ return 12*T; }
function tintMix(a,b,p){ return [lerp(a[0],b[0],p), lerp(a[1],b[1],p), lerp(a[2],b[2],p)]; }
function camArr(A,B,p){ var o = []; for(var i=0;i<7;i++) o.push(lerp(A[i],B[i],clamp(p,0,1))); return o; }

var RC_WIN      = [1.40,1.30,-0.50, 1.15,1.18,-2.2, 44];
var RC_CHILDEYE = [0.30,0.24,0.40, 0.0,1.30,-2.0, 58];
var RC_ADULT    = [0.78,1.62,-0.50, 0.0,1.28,-2.2, 46];
var RC_KID      = [1.30,0.36,1.05, 0.15,0.30,-0.85, 48];
var RC_DRAMA    = [0.70,0.50,0.35, -0.05,1.35,-2.1, 56];

var SC = [];
function S(k,a,b,fn,fi,fo){ SC.push({k:k,a:a,b:b,fn:fn,fi:fi==null?0.45:fi,fo:fo==null?0.45:fo}); }

/* ---------------- 第1章 — 入口 ---------------- */
S('S01', 0, 23.01, function(u,T){
  G.car.visible = true;
  var yaw = lerpE(0.18, 0.95, ramp(T,18.6,20.6));
  setCar(T, carD(T), yaw, {});
  camLerp([0.06,1.25,1.08, -1.02,1.02,-3.0, 50], [0.06,1.25,0.97, -1.0,1.02,-3.0, 50], u/23);
}, 0, 0);
S('S02', 23.01, 26.32, function(u,T){
  G.car.visible = true;
  setCar(T, carD(T), 0.98, {});
  camLerp(CC_SIDE, [0.22,1.28,0.72, -1.8,1.15,-0.35, 42], u/3.3);
}, 0, 0.35);
S('S03', 26.32, 34.73, function(u,T){
  useVoid(0.35);
  renderRoom(rtA, V0, T);
  var n = Math.min(26, 1 + Math.floor(u*4.2));
  for(var i=0;i<n;i++){
    var appear = clamp((u*4.2 - i)/1.2, 0, 1);
    /* hàng lớp lùi chéo sang phải: mỗi lần kể lệch hẳn khỏi lần trước, không che nhau (lỗi 3) */
    plate(rtA, -1.4 + i*0.95, 0.05*Math.sin(i*0.9), -3.0 - i*1.15, 2.2,
      {tint:TINT_OLD, sat:0.6, op:appear*0.95*Math.exp(-i*0.07), bright:1.3, ry:-0.45});
  }
  camLerp([-1.3,0.35,1.4, 1.1,0,-8, 44], [-1.1,0.3,0.9, 1.4,0,-8.5, 44], u/8.4);
}, 0.35, 0.45);
S('S04', 34.73, 44.59, function(u,T){
  useVoid(0.3);
  var cp = camArr([47.5,1.6,17.0, 60,2.2,-3, 44], [51.5,1.55,12.8, 60,2.0,-3, 44], u/9.9);
  renderRoom(rtA, {ext:true, storm:1.0, cam:cp}, T);
  fullPlate(rtA, TINT_OLD, 0.7, 1, 1.55);
});
S('S05', 44.59, 60.84, function(u,T){
  useVoid(0.3);
  var p = ramp(T, 49.3, 53.8);
  var c = camArr(RC_WIN, RC_MAIN, p);
  if(T > 53.8){ var q = (T-53.8)/7.0; c = camArr(RC_MAIN, [0.85,1.22,0.9, -0.1,1.15,-2.1, 46], q); }
  renderRoom(rtA, withCfg(V0, {cam:c}), T);
  fullPlate(rtA, TINT_OLD, 0.7, 1, 1.45);
});
S('S06', 60.84, 69.01, function(u,T){
  G.car.visible = true;
  var yaw = lerpE(0.95, 0.55, ramp(T,63.6,65.2));
  setCar(T, carD(T), yaw, {});
  camLerp(CC_CLOSE, [0.18,1.30,0.80, -0.37,1.26,0.10, 32], u/8.2);
}, 0.35, 0.35);
S('S07', 69.01, 77.67, function(u,T){
  useVoid(0.45);
  renderRoom(rtA, V0, T); renderRoom(rtB, V1, T);
  var p = ramp(T, 69.6, 74.9);
  plate(rtA, lerp(0,-0.40,p), lerp(0,-0.06,p), lerp(-3.2,-4.6,p), 2.6, {tint:TINT_OLD, sat:0.65, op:lerp(1,0.42,p), bright:1.35});
  plate(rtB, 0.22, 0.10, -3.0, 2.6, {tint:TINT_NEW, sat:0.95, op:0.92*p, bright:1.35});
  cam(0.05,0,0.9, 0,0,-4, 42);
});
S('S08', 77.67, 93.53, function(u,T){
  useVoid(0.45);
  renderRoom(rtA, V0, T); renderRoom(rtB, V1, T);
  var s = ramp(T, 82.6, 85.4);            /* tách sang hai bên: "どちらが本当なのか" */
  var worry = win(T, 86.0, 90.6, 1.6);    /* "記憶が弱ってきているのか" */
  var back = ramp(T, 77.7, 80.2);
  plate(rtA, lerp(-0.40,-1.42,s), lerp(-0.06,0,s), lerp(-4.6,-3.7,Math.max(s,back*0.5)), 2.5,
    {tint:TINT_OLD, sat:0.65-0.35*worry, op:lerp(0.42,0.95,Math.max(back*0.7,s)), bright:1.35-0.55*worry, ry:0.18*s});
  plate(rtB, lerp(0.22,1.42,s), lerp(0.10,0,s), lerp(-3.0,-3.7,s), 2.5,
    {tint:TINT_NEW, sat:0.95-0.55*worry, op:0.92, bright:1.35-0.55*worry, ry:-0.18*s});
  cam(0.25*Math.sin(u*0.12), 0.05, lerp(0.9,1.3,s), 0,0,-3.7, 42);
});
S('S09', 93.53, 108.53, function(u,T){
  useVoid(0.4);
  renderRoom(rtA, V0, T); renderRoom(rtB, V1, T); renderRoom(rtC, VX, T);
  var texs = [rtA, rtC, rtB, rtA, rtC, rtB];
  var tints = [TINT_OLD, tintMix(TINT_OLD,TINT_NEW,0.3), tintMix(TINT_OLD,TINT_NEW,0.6), TINT_OLD, tintMix(TINT_OLD,TINT_NEW,0.8), TINT_NEW];
  var spread = ramp(T, 101.6, 106.0);
  var n = Math.min(6, 1 + Math.floor(u*1.1));
  for(var i=0;i<n;i++){
    var z = -7.2 + i*0.9, dist = 0.5 - z;
    var ap = clamp((u*1.1 - i)/1.0, 0, 1);
    plate(texs[i], (i-2.5)*0.05*(1+spread*6), 0.0, z, 3.4*dist/5.2, {tint:tints[i], sat:0.8, op:ap*(0.30 + 0.07*i), bright:1.4, ry:spread*0.12*(i-2.5)/2.5});
  }
  cam(lerp(0,1.1,spread), lerp(0,0.15,spread), 0.5, lerp(0,0.2,spread),0,-5, 42);
}, 0.45, 0.8);

/* ---------------- 第2章 — 録音ではない ---------------- */
function deskObjects(o){
  D.book.visible = !!o.book; if(o.book) { D.book.position.set(o.book[0], 0.763 + (o.book[3]||0), o.book[1]); D.book.rotation.set(0, o.book[2]||0, 0); }
  D.stack.visible = !!o.stack; if(o.stack) D.stack.position.set(o.stack[0], 0.745, o.stack[1]);
  D.journal.visible = !!o.journal; if(o.journal){ D.journal.position.set(o.journal[0], 0.750, o.journal[1]); D.journal.rotation.set(0, o.journal[2]||0, 0); }
  D.paperMT.visible = !!o.mt; if(o.mt){ D.paperMT.position.set(o.mt[0], 0.7465, o.mt[1]); D.paperMT.rotation.set(-Math.PI/2, 0, o.mt[2]||0); }
  D.paperNI.visible = !!o.ni; if(o.ni){ D.paperNI.position.set(o.ni[0], 0.7468, o.ni[1]); D.paperNI.rotation.set(-Math.PI/2, 0, o.ni[2]||0); }
  D.mug.visible = !!o.mug; if(o.mug) D.mug.position.set(o.mug[0], 0.745, o.mug[1]);
  D.nb.visible = !!o.nb; if(o.nb){ D.nb.position.set(o.nb[0], 0.748, o.nb[1]); D.nb.rotation.set(0, o.nb[2]||0, 0); }
  placeSheets(o.sheets || [null,null,null,null]);
  var lamp = o.lamp == null ? 1 : o.lamp;
  D.lamp.intensity = 2.3*lamp; D.bulbMat.color.setRGB(4.0*lamp+0.05, 3.0*lamp+0.05, 1.8*lamp+0.05);
  var mo = o.morning || 0;
  D.morning.intensity = 1.6*mo; D.amb.intensity = 0.16 + 0.35*mo;
  D.winMat.color.setRGB(lerp(0.02,1.4,mo), lerp(0.03,1.15,mo), lerp(0.05,0.85,mo));
  D.lampT.position.set(o.lampT ? o.lampT[0] : 0, 0.745, o.lampT ? o.lampT[1] : -0.35);
  M_SKEL.opacity = o.skel || 0;
  for(var i=0;i<TICKS.length;i++){ var tk = TICKS[i]; tk.material.opacity = o.ticks ? o.ticks[tk.userData.col] : 0; }
}
S('S10', 108.53, 120.92, function(u,T){
