    var cp = []; for(var i2=0;i2<=10;i2++){ var q2 = i2/10; cp.push(new THREE.Vector2(0.03+0.012*q2, q2*0.075)); } cp.push(new THREE.Vector2(0.038,0.075)); cp.push(new THREE.Vector2(0.036,0.008));
    var cup = new THREE.Mesh(new THREE.LatheGeometry(cp,36), stdMat(c?0x5a6a5a:0x7a5a48,0.3,0.0,{side:THREE.DoubleSide}));
    cup.position.set(-0.15 + c*0.62, 0.74, 0.25 - c*0.05); g.add(cup);
  }
  var sun = new THREE.DirectionalLight(0xffe2b8, 1.3); sun.position.set(-3,3,2); g.add(sun);
