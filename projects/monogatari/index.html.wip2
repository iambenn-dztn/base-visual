/* ---- hai bài báo in ---- */
function paperTex(seed, head, title, authors){
  return textCanvasTex(600,850,function(cx,w,h){
    var r = HFA.mulberry32(seed);
    cx.fillStyle = '#f3f0e8'; cx.fillRect(0,0,w,h);
    cx.fillStyle = '#555'; cx.font = '400 17px ' + JP_FONT; cx.textAlign = 'left'; cx.fillText(head, 44, 54);
    cx.fillRect(44,66,w-88,1.5);
    cx.fillStyle = '#161616'; cx.font = '700 36px ' + JP_FONT; cx.textAlign = 'center';
    for(var i=0;i<title.length;i++) cx.fillText(title[i], w/2, 140 + i*46);
    cx.font = '400 22px ' + JP_FONT; cx.fillStyle = '#333'; cx.fillText(authors, w/2, 150 + title.length*46);
    var y = 230 + title.length*46;
    for(var col=0; col<2; col++){
      var yy = y;
      for(var l=0; l<26; l++){ cx.fillStyle = 'rgba(40,40,40,0.55)'; var lw = (col? 236:236) - (l%7===6 ? 90*r() : r()*14); cx.fillRect(44 + col*272, yy, lw, 6); yy += 17; }
    }
  });
}
var TX_MT = paperTex(512, 'Applied Cognitive Psychology 18: 491–503 (2004)', ['Spinning the Stories', 'of Our Lives'], 'Elizabeth J. Marsh · Barbara Tversky');
var TX_NI = paperTex(513, 'Current Directions in Psychological Science 22(3): 233–238 (2013)', ['Narrative Identity'], 'Dan P. McAdams · Kate C. McLean');
D.paperMT = new THREE.Mesh(new THREE.PlaneGeometry(0.21,0.2975), M_PAPER(TX_MT)); D.paperMT.rotation.x = -Math.PI/2; G.desk.add(D.paperMT);
D.paperNI = new THREE.Mesh(new THREE.PlaneGeometry(0.21,0.2975), M_PAPER(TX_NI)); D.paperNI.rotation.x = -Math.PI/2; G.desk.add(D.paperNI);

/* ---- cốc trà ---- */
D.mug = new THREE.Group();
(function(){
  var pts = []; for(var i=0;i<=12;i++){ var y = i/12*0.085; pts.push(new THREE.Vector2(0.034 + 0.006*Math.sin(i/12*Math.PI*0.8), y)); }
  pts.push(new THREE.Vector2(0.031,0.085)); pts.push(new THREE.Vector2(0.031,0.008));
  var cup = new THREE.Mesh(new THREE.LatheGeometry(pts,40), stdMat(0x8a7a66,0.35,0.0,{side:THREE.DoubleSide}));
  D.mug.add(cup);
  var tea = new THREE.Mesh(new THREE.CircleGeometry(0.031,32), stdMat(0x5a4a1e,0.1)); tea.rotation.x = -Math.PI/2; tea.position.y = 0.07; D.mug.add(tea);
})();
G.desk.add(D.mug);

/* ---- sổ ghi (Marsh & Tversky: tự đánh dấu mỗi lần kể) ---- */
var NB_ROWS = 7;
var NB_BOX = [];   /* toạ độ uv tâm các ô (tính sẵn, không phụ thuộc font) */
(function(){ for(var r=0;r<NB_ROWS;r++) for(var c=0;c<3;c++) NB_BOX.push([0.28 + c*0.25, 0.26 + r*0.095]); })();
var TX_NB_L = textCanvasTex(560,800,function(cx,w,h){
  var r = HFA.mulberry32(520);
  cx.fillStyle = '#f1ecdf'; cx.fillRect(0,0,w,h);
  for(var y=120;y<h;y+=38){ cx.fillStyle = 'rgba(90,120,160,0.35)'; cx.fillRect(30,y,w-60,1.5); }
  cx.fillStyle = '#2a2a3a'; cx.font = '700 40px ' + JP_FONT; cx.textAlign = 'left'; cx.fillText('話したこと', 40, 80);
  cx.strokeStyle = 'rgba(40,40,70,0.75)'; cx.lineWidth = 2.2;
  for(var row=0; row<NB_ROWS; row++){
    var yy = h*(0.26 + row*0.095);
    cx.font = '400 24px ' + JP_FONT; cx.fillStyle = '#34344a'; cx.fillText((row+1) + '.', 40, yy+8);
    cx.beginPath(); var x = 90; cx.moveTo(x, yy);
    for(var k=0;k<40;k++){ x += 9 + r()*3; cx.lineTo(x, yy + Math.sin(k*1.7 + row)*5 + (r()-0.5)*4); }
    cx.stroke();
  }
});
var TX_NB_R = textCanvasTex(560,800,function(cx,w,h){
  cx.fillStyle = '#f1ecdf'; cx.fillRect(0,0,w,h);
  for(var y=120;y<h;y+=38){ cx.fillStyle = 'rgba(90,120,160,0.35)'; cx.fillRect(30,y,w-60,1.5); }
  cx.fillStyle = '#2a2a3a'; cx.font = '700 30px ' + JP_FONT; cx.textAlign = 'center';
  var heads = ['大げさ','省いた','付け足した'];
  for(var c=0;c<3;c++) cx.fillText(heads[c], w*(0.28 + c*0.25), h*0.17);
  cx.strokeStyle = '#3a3a4e'; cx.lineWidth = 3;
  for(var i=0;i<NB_BOX.length;i++){ var b = NB_BOX[i]; cx.strokeRect(w*b[0]-18, h*b[1]-18, 36, 36); }
});
D.nb = new THREE.Group();
(function(){
  var L = new THREE.Mesh(new THREE.PlaneGeometry(0.2,0.2857), M_PAPER(TX_NB_L)); L.rotation.x = -Math.PI/2; L.position.set(-0.101,0.004,0); L.rotation.y = 0.0; D.nb.add(L);
  var Rr = new THREE.Mesh(new THREE.PlaneGeometry(0.2,0.2857), M_PAPER(TX_NB_R)); Rr.rotation.x = -Math.PI/2; Rr.position.set(0.101,0.004,0); D.nb.add(Rr);
  D.nb.add(box(0.41,0.006,0.295, stdMat(0x3a2a22,0.8), 0,0.0,0));
})();
/* dấu tick: chỉ là nét vẽ, không chữ → dựng ngay */
var TX_TICK = canvasTex(128,128,function(cx,w,h){
  cx.clearRect(0,0,w,h); cx.strokeStyle = '#b02a22'; cx.lineWidth = 13; cx.lineCap = 'round'; cx.lineJoin = 'round';
  cx.beginPath(); cx.moveTo(22,70); cx.lineTo(52,100); cx.lineTo(108,24); cx.stroke();
});
var TICKS = [];
/* mẫu đánh dấu tất định: hàng r, cột c */
var TICK_PAT = [[0,0],[0,2],[1,1],[2,0],[2,1],[3,2],[4,0],[5,1],[5,2],[6,0]];
for(var it=0; it<TICK_PAT.length; it++){
  var tm = new THREE.Mesh(new THREE.PlaneGeometry(0.03,0.03), new THREE.MeshBasicMaterial({map:TX_TICK, transparent:true, depthWrite:false, opacity:0}));
  tm.rotation.x = -Math.PI/2;
  var bx = NB_BOX[TICK_PAT[it][0]*3 + TICK_PAT[it][1]];
  tm.position.set(0.101 + (bx[0]-0.5)*0.2, 0.008, (bx[1]-0.5)*0.2857);
  tm.userData.col = TICK_PAT[it][1];
  D.nb.add(tm); TICKS.push(tm);
}
G.desk.add(D.nb);

/* ---- bốn tờ giấy thí nghiệm Bartlett: bản gốc → lần nhớ lại ngắn dần ---- */
var SHEET_INFO = [
  {head:'幽霊たちの戦い', sub:'北アメリカの昔話（原文）', n:20},
  {head:'読んだ直後', sub:'思い出して書く', n:15},
  {head:'数日後', sub:'また書く', n:11},
  {head:'数か月後', sub:'また書く', n:7}
];
/* "khung xương" (骨組み) ở cùng vị trí tương đối mọi tờ: mở đầu / sự việc / kết thúc */
function sheetLineY(k, n){ return 0.30 + k*0.032; }
function skelIdx(n){ return [0, Math.floor(n*0.5), n-1]; }
function sheetTex(i){
  var info = SHEET_INFO[i];
  return textCanvasTex(600,850,function(cx,w,h){
    var r = HFA.mulberry32(530+i);
    cx.fillStyle = '#efe9da'; cx.fillRect(0,0,w,h);
    for(var q=0;q<3000;q++){ cx.fillStyle = 'rgba(120,100,70,' + (r()*0.06).toFixed(3) + ')'; cx.fillRect(r()*w, r()*h, 1, 1); }
    cx.fillStyle = '#26221e'; cx.textAlign = 'left';
    cx.font = '700 52px ' + JP_FONT; cx.fillText(info.head, 48, 108);
    cx.font = '400 26px ' + JP_FONT; cx.fillStyle = '#5a5248'; cx.fillText(info.sub, 50, 158);
    cx.fillRect(48,182,w-96,2);
    var sk = skelIdx(info.n);
    for(var k=0;k<info.n;k++){
      var y = h*sheetLineY(k, info.n);
      var isSk = sk.indexOf(k) >= 0;
      cx.strokeStyle = isSk ? 'rgba(25,25,35,0.95)' : 'rgba(60,60,80,0.62)';
      cx.lineWidth = isSk ? 3.4 : 2.2;
      cx.beginPath(); var x = 52; cx.moveTo(x, y);
      var len = (k === info.n-1) ? 260 + r()*120 : 470 + r()*30;
      while(x < 52 + len){ x += 7 + r()*4; cx.lineTo(x, y + Math.sin(x*0.21 + k)*4 + (r()-0.5)*3); }
      cx.stroke();
    }
  });
}
D.sheets = [];
for(var is=0; is<4; is++){
  var sm = new THREE.Mesh(new THREE.PlaneGeometry(0.21,0.2975), M_PAPER(sheetTex(is)));
  sm.rotation.x = -Math.PI/2; G.desk.add(sm); D.sheets.push(sm);
}
/* dải sáng ấm đè lên dòng "khung xương" của mỗi tờ */
D.skel = [];
var M_SKEL = new THREE.MeshBasicMaterial({color:new THREE.Color(1.5,0.95,0.45), transparent:true, opacity:0, depthWrite:false, blending:THREE.AdditiveBlending});
for(var is2=0; is2<4; is2++){
  var n = SHEET_INFO[is2].n, sk = skelIdx(n);
  for(var q2=0;q2<3;q2++){
    var strip = new THREE.Mesh(new THREE.PlaneGeometry(0.17,0.006), M_SKEL);
    strip.rotation.x = -Math.PI/2; strip.userData = {sheet:is2, v:sheetLineY(sk[q2], n)};
    G.desk.add(strip); D.skel.push(strip);
  }
}
function placeSheets(poses){
  for(var i=0;i<4;i++){
    var s = D.sheets[i], p = poses[i];
    s.visible = !!p;
    if(!p) continue;
    s.position.set(p[0], 0.747 + i*0.0006, p[1]); s.rotation.set(-Math.PI/2, 0, p[2]||0);
    var sc = p[3]==null?1:p[3]; s.scale.set(sc,sc,1);
  }
  for(var k=0;k<D.skel.length;k++){
    var st = D.skel[k], sh = D.sheets[st.userData.sheet];
    st.visible = sh.visible;
    if(!st.visible) continue;
    var sc2 = sh.scale.x, rz = sh.rotation.z;
    var lx = -0.105*sc2 + 0.02*sc2 + 0.085*sc2, lz = (st.userData.v - 0.5)*0.2975*sc2;
    st.position.set(sh.position.x + Math.cos(rz)*lx + Math.sin(rz)*lz, 0.7495, sh.position.z - Math.sin(rz)*lx + Math.cos(rz)*lz);
    st.rotation.set(-Math.PI/2, 0, rz); st.scale.set(sc2, sc2, 1);
  }
}

/* =========================================================================
 * BĂNG CASSETTE — "nếu ký ức là một cuộn băng ghi âm"
 * ========================================================================= */
var CS = {};
(function(){
  var g = G.cass;
  var tbl = new THREE.Mesh(new THREE.PlaneGeometry(8,6), stdMat(0xffffff,0.6,0,{map:woodTex('#3a2a1e','20,12,6',1024,512,540,120)}));
  tbl.rotation.x = -Math.PI/2; g.add(tbl);
  var key = new THREE.SpotLight(0xffd2a0, 1.5, 8, 0.6, 0.7, 1.2); key.position.set(-1.2,2.4,1.2); g.add(key);
  var kt = new THREE.Object3D(); kt.position.set(0,0,0); g.add(kt); key.target = kt;
  var rim = new THREE.DirectionalLight(0x8fb0ff, 0.5); rim.position.set(2,1.5,-3); g.add(rim);
  g.add(new THREE.AmbientLight(0x404858, 0.25));
  var body = new THREE.Group(); body.position.set(0,0.07,0); body.rotation.x = -Math.PI/2; g.add(body); CS.body = body;
  /* vỏ: lưng đục + mặt khói trong suốt */
  body.add(box(1.0,0.64,0.05, stdMat(0x1b1b1f,0.5,0.1), 0,0,-0.035));
  var shell = new THREE.Mesh(new THREE.BoxGeometry(1.0,0.64,0.07), new THREE.MeshStandardMaterial({color:0x3a3a44, transparent:true, opacity:0.45, roughness:0.15, metalness:0.1, depthWrite:false}));
  shell.renderOrder = 5; body.add(shell);
  /* nhãn giấy */
  var lab = textCanvasTex(900,300,function(cx,w,h){
    cx.fillStyle = '#efe6cf'; cx.fillRect(0,0,w,h);
    cx.fillStyle = '#b8472e'; cx.fillRect(0,0,w,34); cx.fillRect(0,h-26,w,26);
    for(var y=86;y<h-30;y+=46){ cx.fillStyle = 'rgba(80,110,150,0.35)'; cx.fillRect(40,y,w-80,2); }
    cx.fillStyle = '#1f2a44'; cx.font = '700 84px ' + JP_FONT; cx.textAlign = 'left'; cx.textBaseline = 'alphabetic';
    cx.fillText('台風の晩', 60, 170);
    cx.font = '700 40px ' + JP_FONT; cx.fillStyle = '#6a2a20'; cx.textAlign = 'right'; cx.fillText('A', w-50, 90);
    cx.font = '400 30px ' + JP_FONT; cx.fillStyle = '#3a3a3a'; cx.fillText('C-60', w-50, 240);
  });
  var lm = new THREE.Mesh(new THREE.PlaneGeometry(0.86,0.24), stdMat(0xbcb5a6,0.85,0,{map:lab}));
  lm.position.set(0,0.17,0.037); lm.renderOrder = 6; body.add(lm);
  var lab2 = new THREE.Mesh(new THREE.PlaneGeometry(0.86,0.1), stdMat(0xa8a090,0.85)); lab2.position.set(0,-0.23,0.037); lab2.renderOrder = 6; body.add(lab2);
  /* hai cuộn băng + trục */
  CS.reels = []; CS.packs = [];
  for(var s=0;s<2;s++){
    var x = s===0 ? -0.21 : 0.21;
    var pack = new THREE.Mesh(new THREE.CylinderGeometry(1,1,0.03,48), stdMat(0x3a2418,0.35,0.2));
    pack.rotation.x = Math.PI/2; pack.position.set(x,-0.03,0.0); body.add(pack); CS.packs.push(pack);
    var hub = new THREE.Group(); hub.position.set(x,-0.03,0.01); body.add(hub);
    hub.add((function(){ var m = new THREE.Mesh(new THREE.CylinderGeometry(0.075,0.075,0.035,32), stdMat(0xe9e6df,0.4)); m.rotation.x = Math.PI/2; return m; })());
    for(var k=0;k<6;k++){ var a = k*Math.PI/3; var tth = box(0.018,0.03,0.04, stdMat(0xe9e6df,0.4), Math.cos(a)*0.04, Math.sin(a)*0.04, 0.0); tth.rotation.z = a; hub.add(tth); }
    hub.add((function(){ var m = new THREE.Mesh(new THREE.CylinderGeometry(0.028,0.028,0.04,24), stdMat(0x111111,0.6)); m.rotation.x = Math.PI/2; return m; })());
    CS.reels.push(hub);
  }
  body.add(box(0.6,0.012,0.028, stdMat(0x3a2418,0.4,0.2), 0,-0.29,0.0));
  for(var sc=0;sc<5;sc++){ var sx = [-0.45,0.45,-0.45,0.45,0][sc], sy = [0.27,0.27,-0.27,-0.27,-0.27][sc];
    var scr = new THREE.Mesh(new THREE.CylinderGeometry(0.018,0.018,0.01,16), stdMat(0x9a9a9a,0.3,0.9)); scr.rotation.x = Math.PI/2; scr.position.set(sx,sy,0.038); body.add(scr); }
})();
function setCassette(t){
  var c = 0.05, k = 0.0105, r0 = 0.19, rmin = 0.09;
  var s = c*t, rL = Math.sqrt(Math.max(rmin*rmin, r0*r0 - k*s)), rR = Math.sqrt(rmin*rmin + k*s);
  CS.packs[0].scale.set(rL,1,rL); CS.packs[1].scale.set(rR,1,rR);
  CS.reels[0].rotation.z = 2154*(r0 - rL);
  CS.reels[1].rotation.z = 2154*(rR - rmin)*(rmin/0.19)*2.1;
}

/* =========================================================================
 * MẶT NƯỚC LÚC CHẠNG VẠNG + THUYỀN: カヌー → ボート (morph hình học thật)
 * ========================================================================= */
var WT = {};
(function(){
  var g = G.water;
  var sky = new THREE.Mesh(new THREE.SphereGeometry(400,32,20), new THREE.ShaderMaterial({
    vertexShader:'varying vec3 vP;void main(){vP=normalize(position);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}',
    fragmentShader:'varying vec3 vP;void main(){ vec3 d=normalize(vP); float y=max(d.y,0.0); vec3 c=mix(vec3(0.55,0.42,0.38),vec3(0.05,0.08,0.16),pow(y,0.5)); c+=vec3(0.35,0.18,0.08)*pow(max(dot(d,normalize(vec3(0.5,0.05,-1.0))),0.0),24.0); gl_FragColor=vec4(c,1.0);}',
    side:THREE.BackSide, depthWrite:false
  }));
  sky.renderOrder = -10; g.add(sky);
  WT.water = new THREE.Mesh(new THREE.PlaneGeometry(400,400,1,1), new THREE.ShaderMaterial({
    uniforms:{uT:{value:0}, uCam:{value:new THREE.Vector3()}},
    vertexShader:'varying vec3 vW;void main(){vec4 w=modelMatrix*vec4(position,1.0);vW=w.xyz;gl_Position=projectionMatrix*viewMatrix*w;}',
    fragmentShader:[
      'varying vec3 vW;uniform float uT;uniform vec3 uCam;',
      'vec2 wav(vec2 p,vec2 d,float f,float s){float ph=dot(p,d)*f+uT*s;return d*cos(ph)*f;}',
      'void main(){ vec2 p=vW.xz; vec2 g=vec2(0.0);',
      ' g+=wav(p,normalize(vec2(1.0,0.3)),0.9,0.8)*0.012; g+=wav(p,normalize(vec2(-0.4,1.0)),2.1,1.3)*0.007;',
      ' g+=wav(p,normalize(vec2(0.8,-0.6)),5.3,2.3)*0.004; g+=wav(p,normalize(vec2(-0.9,-0.2)),9.7,3.1)*0.0025;',
      ' g+=wav(p,normalize(vec2(0.3,0.95)),17.0,4.6)*0.0015; g+=wav(p,normalize(vec2(-0.7,0.7)),23.0,5.3)*0.001;',
      ' vec3 n=normalize(vec3(-g.x,1.0,-g.y)); vec3 v=normalize(uCam-vW); vec3 r=reflect(-v,n);',
      ' float y=max(r.y,0.0); vec3 sky=mix(vec3(0.55,0.42,0.38),vec3(0.05,0.08,0.16),pow(y,0.5));',
      ' sky+=vec3(1.2,0.6,0.25)*pow(max(dot(r,normalize(vec3(0.5,0.05,-1.0))),0.0),60.0);',
      ' float fr=0.03+0.97*pow(1.0-max(dot(n,v),0.0),5.0);',
      ' vec3 deep=vec3(0.010,0.018,0.026);',
      ' vec3 c=mix(deep,sky,fr);',
      ' float dist=length(vW.xz-uCam.xz); c=mix(c,vec3(0.30,0.24,0.24),smoothstep(40.0,160.0,dist)*0.6);',
      ' gl_FragColor=vec4(c,1.0); }'
    ].join('\n')
  }));
  WT.water.rotation.x = -Math.PI/2; g.add(WT.water);
  /* bờ xa: rừng tối */
  var shp = new THREE.Shape(); shp.moveTo(-300,-2); var r = HFA.mulberry32(560);
  for(var x=-300;x<=300;x+=6){ shp.lineTo(x, 4 + 3*Math.sin(x*0.05) + 2.5*r() + 2*Math.sin(x*0.013)); }
  shp.lineTo(300,-2); shp.lineTo(-300,-2);
  var shore = new THREE.Mesh(new THREE.ShapeGeometry(shp), new THREE.MeshBasicMaterial({color:new THREE.Color(0.035,0.035,0.045)}));
  shore.position.set(0,0,-90); g.add(shore);
  var dl = new THREE.DirectionalLight(0xffc49a, 1.6); dl.position.set(20,6,-40); g.add(dl);
  g.add(new THREE.HemisphereLight(0x6a7aa0, 0x1a1a22, 0.55));
  var fl = new THREE.DirectionalLight(0x9ab0d8, 0.35); fl.position.set(-6,5,8); g.add(fl);
  /* thân thuyền: lưới tham số, cập nhật mỗi frame bằng hàm của hệ số morph */
  WT.NS = 56; WT.NT = 18;
  var geo = new THREE.BufferGeometry();
  var pos = new Float32Array(WT.NS*WT.NT*3), idx = [];
  for(var i=0;i<WT.NS-1;i++) for(var j=0;j<WT.NT-1;j++){
    var a = i*WT.NT+j, b = (i+1)*WT.NT+j, c2 = (i+1)*WT.NT+j+1, d2 = i*WT.NT+j+1;
    idx.push(a,b,d2, b,c2,d2);
  }
  geo.setAttribute('position', new THREE.BufferAttribute(pos,3)); geo.setIndex(idx);
  WT.hullMat = stdMat(0x9a7c56, 0.7, 0.0, {side:THREE.DoubleSide});
  WT.hull = new THREE.Mesh(geo, WT.hullMat); WT.hull.frustumCulled = false;
  WT.boat = new THREE.Group(); WT.boat.add(WT.hull); g.add(WT.boat);
  /* tấm đuôi (transom) — chỉ có diện tích khi đã thành ボート */
  var tg = new THREE.BufferGeometry(); var tp = new Float32Array((WT.NT+1)*3); var ti = [];
  for(var j2=0;j2<WT.NT-1;j2++) ti.push(WT.NT, j2, j2+1);
  tg.setAttribute('position', new THREE.BufferAttribute(tp,3)); tg.setIndex(ti);
  WT.transom = new THREE.Mesh(tg, WT.hullMat); WT.transom.frustumCulled = false; WT.boat.add(WT.transom);
  /* hai thanh ngồi (thwart) của ボート */
  WT.thw = [box(1,0.04,0.2, stdMat(0x6a4c30,0.7), 0,0,0), box(1,0.04,0.2, stdMat(0x6a4c30,0.7), 0,0,0)];
  WT.boat.add(WT.thw[0]); WT.boat.add(WT.thw[1]);
  /* viền mạn (gunwale) */
  WT.gun = new THREE.Line(new THREE.BufferGeometry(), new THREE.LineBasicMaterial({color:0x2a1c12}));
  WT.gun.geometry.setAttribute('position', new THREE.BufferAttribute(new Float32Array(WT.NS*2*3),3)); WT.gun.frustumCulled = false;
  WT.boat.add(WT.gun);
})();
function hullParams(m){
  return { L:lerp(4.6,3.5,m), W:lerp(0.74,1.34,m), D:lerp(0.34,0.48,m) };
}
function setBoat(m){
  var P = hullParams(m), NS = WT.NS, NT = WT.NT;
  var pos = WT.hull.geometry.attributes.position.array;
  function prof(s){
    var wc = Math.pow(Math.max(0,1 - s*s), 0.72);
    var wb = s < 0 ? Math.pow(Math.max(0,1 - s*s), 0.55) : (1 - 0.42*s*s);
    var dc = Math.pow(Math.max(0,1 - Math.pow(s,4)), 0.5);
    var db = s < 0 ? Math.pow(Math.max(0,1 - Math.pow(s,4)), 0.5) : (1 - 0.3*s*s);
    var shc = 0.05 + 0.30*Math.pow(Math.abs(s),6);
    var shb = 0.06 + 0.05*s*s + (s<0 ? 0.12*Math.pow(-s,4) : 0);
    return { w: lerp(wc,wb,m), d: lerp(dc,db,m), sh: lerp(shc,shb,m) };
  }
  var gunArr = WT.gun.geometry.attributes.position.array, gk = 0;
  for(var i=0;i<NS;i++){
    var s = -1 + 2*i/(NS-1), pr = prof(s);
    for(var j=0;j<NT;j++){
      var th = Math.PI*j/(NT-1);
      var sn = Math.sin(th);
      var fullness = lerp(1.0, 0.55, m);
      var k = (i*NT+j)*3;
      pos[k]   = s*P.L/2;
      pos[k+1] = pr.sh - P.D*pr.d*Math.pow(sn, fullness);
      pos[k+2] = (P.W/2)*pr.w*Math.cos(th);
    }
    gunArr[gk++] = s*P.L/2; gunArr[gk++] = pr.sh; gunArr[gk++] = (P.W/2)*pr.w;
  }
  for(var i2=NS-1;i2>=0;i2--){ var s2 = -1 + 2*i2/(NS-1), p2 = prof(s2); gunArr[gk++] = s2*P.L/2; gunArr[gk++] = p2.sh; gunArr[gk++] = -(P.W/2)*p2.w; }
  WT.gun.geometry.setDrawRange(0, NS*2);
  WT.gun.geometry.attributes.position.needsUpdate = true;
  WT.hull.geometry.attributes.position.needsUpdate = true;
  WT.hull.geometry.computeVertexNormals();
  var tp = WT.transom.geometry.attributes.position.array, last = (NS-1)*NT*3;
  for(var j2=0;j2<NT;j2++){ tp[j2*3] = pos[last+j2*3]; tp[j2*3+1] = pos[last+j2*3+1]; tp[j2*3+2] = pos[last+j2*3+2]; }
  var pe = prof(1);
  tp[NT*3] = P.L/2; tp[NT*3+1] = pe.sh; tp[NT*3+2] = 0;
  WT.transom.geometry.attributes.position.needsUpdate = true; WT.transom.geometry.computeVertexNormals();
  WT.hullMat.color.setRGB(lerp(0.60,0.42,m), lerp(0.48,0.31,m), lerp(0.34,0.21,m));
  for(var q=0;q<2;q++){
    var xs = q===0 ? -0.35 : 0.55, pr2 = prof(xs/(P.L/2));
    var th2 = WT.thw[q]; th2.visible = m > 0.55;
    th2.position.set(xs, pr2.sh - 0.1, 0);
    th2.scale.set(0.22, 1, (P.W*pr2.w*0.95)/0.2);
    th2.material.opacity = 1;
  }
}

/* =========================================================================
 * 100 + 100 LẦN KỂ — Marsh & Tversky 2004: 61% "đã thay đổi", 42% "không chính xác"
 * ========================================================================= */
var TK = {};
(function(){
  var g = G.tok;
  var surf = new THREE.Mesh(new THREE.PlaneGeometry(40,40), stdMat(0x17171a,0.55,0.2)); surf.rotation.x = -Math.PI/2; g.add(surf);
  g.add(new THREE.HemisphereLight(0x8090b0, 0x101010, 0.55));
  var k = new THREE.DirectionalLight(0xfff0e0, 0.9); k.position.set(-2,4,3); g.add(k);
  var geo = new THREE.CylinderGeometry(0.036,0.036,0.012,28);
  var capGeo = new THREE.CylinderGeometry(0.034,0.034,0.004,28);
  TK.base = []; TK.cap = [];
  for(var s=0;s<2;s++){
    var base = new THREE.InstancedMesh(geo, stdMat(0x2c2c30,0.4,0.6), 100);
    var cap = new THREE.InstancedMesh(capGeo, new THREE.MeshBasicMaterial({color:0xffffff}), 100);
    cap.instanceColor = new THREE.InstancedBufferAttribute(new Float32Array(300), 3);
    g.add(base); g.add(cap); TK.base.push(base); TK.cap.push(cap);
    var mm = new THREE.Matrix4();
    for(var i=0;i<100;i++){
      mm.makeTranslation((s===0?-0.72:0.72) + ((i%10)-4.5)*0.1, 0.006, (Math.floor(i/10)-4.5)*0.1);
      base.setMatrixAt(i, mm);
    }
    base.instanceMatrix.needsUpdate = true;
  }
})();
var _tkM = new THREE.Matrix4(), _tkS = new THREE.Vector3(), _tkQ = new THREE.Quaternion(), _tkP = new THREE.Vector3();
/** nL, nR: số ô đã sáng · pulse: nhịp sáng cho phần chênh 19 ô (43..61) */
function setTokens(t, nL, nR, pulse){
  for(var s=0;s<2;s++){
    var cap = TK.cap[s], n = s===0 ? nL : nR;
    var col = s===0 ? [1.9,1.05,0.38] : [0.85,1.15,1.9];
    for(var i=0;i<100;i++){
      var on = clamp(n - i, 0, 1);
      var x = (s===0?-0.72:0.72) + ((i%10)-4.5)*0.1, z = (Math.floor(i/10)-4.5)*0.1;
      _tkP.set(x, 0.013 + 0.004*on, z); _tkS.set(on>0?1:0.0001, 1, on>0?1:0.0001);
      _tkM.compose(_tkP, _tkQ, _tkS); cap.setMatrixAt(i, _tkM);
      var b = on;
      if(s===0 && pulse > 0 && i >= 42 && i < 61) b *= 1 + 0.9*pulse*(0.6 + 0.4*Math.sin(t*3.0));
      cap.instanceColor.setXYZ(i, col[0]*b, col[1]*b, col[2]*b);
    }
    cap.instanceMatrix.needsUpdate = true; cap.instanceColor.needsUpdate = true;
  }
}

/* =========================================================================
 * ĐỒNG HỒ CÁT — "thời gian còn lại có hạn" (Butler)
 * ========================================================================= */
var HG = {};
function glassR(y){ var a = clamp(Math.abs(y)/0.5,0,1); return 0.016 + 0.225*Math.pow(Math.sin(a*Math.PI*0.64),1.15); }
(function(){
  var g = G.hg;
  var pts = []; for(var i=0;i<=60;i++){ var y = -0.48 + i/60*0.96; pts.push(new THREE.Vector2(glassR(y), y)); }
  var glass = new THREE.Mesh(new THREE.LatheGeometry(pts,64), new THREE.MeshStandardMaterial({color:0xcfe0ee, transparent:true, opacity:0.14, roughness:0.04, metalness:0.0, side:THREE.DoubleSide, depthWrite:false, envMapIntensity:2.0}));
  glass.renderOrder = 40; g.add(glass);
  var rim = new THREE.Mesh(new THREE.LatheGeometry(pts,64), new THREE.ShaderMaterial({
    vertexShader:'varying vec3 vN;varying vec3 vV;void main(){vN=normalize(normalMatrix*normal);vec4 mv=modelViewMatrix*vec4(position,1.0);vV=normalize(-mv.xyz);gl_Position=projectionMatrix*mv;}',
    fragmentShader:'varying vec3 vN;varying vec3 vV;void main(){float f=1.0-abs(dot(normalize(vN),normalize(vV)));float a=pow(f,3.0)*0.55;gl_FragColor=vec4(vec3(1.0,0.92,0.8)*a,a);}',
    transparent:true, depthWrite:false, blending:THREE.AdditiveBlending, side:THREE.DoubleSide
  }));
  rim.renderOrder = 41; g.add(rim);
  var wood = stdMat(0xffffff,0.55,0,{map:woodTex('#5a3a22','30,16,8',256,256,570,40)});
  var t1 = new THREE.Mesh(new THREE.CylinderGeometry(0.29,0.29,0.045,48), wood); t1.position.y = 0.505; g.add(t1);
  var t2 = new THREE.Mesh(new THREE.CylinderGeometry(0.29,0.29,0.045,48), wood); t2.position.y = -0.505; g.add(t2);
  for(var k=0;k<3;k++){ var a = k*Math.PI*2/3 + 0.5; g.add(limb([Math.cos(a)*0.25,-0.49,Math.sin(a)*0.25],[Math.cos(a)*0.25,0.49,Math.sin(a)*0.25],0.018,0.018,wood,12)); }
  HG.sandMat = stdMat(0xcaa56e, 0.95, 0, {side:THREE.DoubleSide});
  HG.top = new THREE.Mesh(new THREE.BufferGeometry(), HG.sandMat); g.add(HG.top);
  HG.bot = new THREE.Mesh(new THREE.BufferGeometry(), HG.sandMat); g.add(HG.bot);
  HG.stream = new THREE.Mesh(new THREE.CylinderGeometry(0.0035,0.0035,1,8), HG.sandMat); g.add(HG.stream);
  var tbl = new THREE.Mesh(new THREE.PlaneGeometry(10,10), stdMat(0xffffff,0.6,0,{map:woodTex('#2e2118','16,8,4',1024,512,571,100)})); tbl.rotation.x = -Math.PI/2; tbl.position.y = -0.528; g.add(tbl);
  var key = new THREE.SpotLight(0xffd6a6, 3.4, 8, 0.5, 0.8, 1.1); key.position.set(-1.4,1.6,1.6); g.add(key);
  var kt = new THREE.Object3D(); g.add(kt); key.target = kt;
  var rimL = new THREE.DirectionalLight(0x9fb8e8, 0.7); rimL.position.set(1.5,1.0,-2.5); g.add(rimL);
  g.add(new THREE.AmbientLight(0x3a4050, 0.25));
  g.position.set(0,0.53,0);
})();
function setHourglass(f){
  /* f = phần cát đã rơi (0..1). Mức cát trên giảm, đống cát dưới cao dần */
  var topLevel = lerp(0.36, 0.05, f);
  var tp = [new THREE.Vector2(0.0001, 0.03 + Math.max(0,topLevel-0.05)*0.35)];
  var nS = 10;
  for(var i=1;i<=nS;i++){ var q = i/nS; var y = topLevel - 0.035*(1-q)*(1-q); tp.push(new THREE.Vector2(glassR(topLevel)*0.965*q, y)); }
  for(var k=10;k>=0;k--){ var y2 = 0.02 + (topLevel-0.02)*k/10; tp.push(new THREE.Vector2(glassR(y2)*0.965, y2)); }
  tp.push(new THREE.Vector2(0.0001, 0.02));
  if(HG.top.geometry) HG.top.geometry.dispose();
  HG.top.geometry = new THREE.LatheGeometry(tp.reverse(), 48);
  var hB = lerp(0.02, 0.24, Math.sqrt(f));
  var bp = [new THREE.Vector2(0.0001, -0.475 + hB)];
  for(var j=1;j<=12;j++){ var q2 = j/12; var y3 = -0.475 + hB*(1 - Math.pow(q2,1.35)); bp.push(new THREE.Vector2(glassR(y3)*0.96*q2 + 0.0001, y3)); }
  bp.push(new THREE.Vector2(0.0001,-0.475));
  if(HG.bot.geometry) HG.bot.geometry.dispose();
  HG.bot.geometry = new THREE.LatheGeometry(bp, 48);
  var yTop = 0.02, yBot = -0.475 + hB;
  HG.stream.visible = f < 0.995;
  HG.stream.position.set(0,(yTop+yBot)/2,0); HG.stream.scale.set(1, Math.max(0.001,yTop-yBot), 1);
}

