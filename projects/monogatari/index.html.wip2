  var pp = camera.localToWorld(new THREE.Vector3(0.88, 0.10, -2.3));
  var pl = plate(rtB, pp.x, pp.y, pp.z, 1.2, {tint:TINT_NEW, sat:0.9, op:0.5*win(T,715.0,720.4,1.2), bright:1.5, noDepth:true});
  if(pl) pl.lookAt(camera.position);
}, 0, 0);
