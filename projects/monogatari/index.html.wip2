  useVoid(0.75);
  renderRoom(rtA, V0, T); renderRoom(rtB, V1, T); renderRoom(rtC, withCfg(V2,{cam:RC_KID}), T);
  var merge = ramp(T, 795.5, 806.0);
  var warm = ramp(T, 795.5, 804.0);
  plate(rtA, lerp(-0.30,0,merge), lerp(-0.08,0,merge), -5.4, 3.0, {tint:tintMix(TINT_OLD,[1.05,0.98,0.92],warm), sat:0.7, op:lerp(0.55,0.45,merge), bright:1.3});
  plate(rtB, lerp(0.10,0,merge), lerp(0.06,0,merge), -4.3, 2.6, {tint:TINT_NEW, sat:0.95, op:lerp(0.7,0.6,merge), bright:1.3});
  plate(rtC, lerp(0.34,0,merge), lerp(0.12,0,merge), -3.3, 2.2, {tint:TINT_KID, sat:0.95, op:0.8, bright:1.4 + 0.2*warm});
  cam(lerp(0.9,0.0,ramp(T,776.6,790)), lerp(0.2,0.0,ramp(T,776.6,790)) + 0.32, lerp(2.3,1.9,merge), 0,0.46,-4.3, 42);
  kOn('kTake1', win(T, 782.1, 795.2, 0.7));
  kOn('kTake2', win(T, 784.9, 795.2, 0.7));
}, 0.45, 0.45);
function arrD(u){ /* chạy 12 m/s rồi phanh êm trong 6 s: quãng đường là hàm đóng của u */
  if(u < 1) return 12*u;
  var tau = Math.min(u-1, 6); return 12 + 12*(tau - tau*tau/12);
}
S('S55', 810.71, 820.70, function(u,T){
  G.car.visible = true;
  var dd = arrD(u);
  setCar(T, carD(810.71) + dd, lerpE(0.95, 1.25, ramp(T,813.6,814.8)), {hallZ:-60 + dd, moving:1 - ramp(u,1,7), door:1.05*ramp(T,814.2,816.8)});
  camLerp([0.06,1.25,1.0, -1.3,1.02,-3.0, 52], [0.06,1.25,0.98, -1.9,1.0,-2.6, 52], ramp(u, 3, 9));
}, 0.45, 0);
