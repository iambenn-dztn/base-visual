});
S('S12', 129.78, 139.32, function(u,T){
  useVoid(0.4);
  renderRoom(rtA, V0, T);
  var pulse = 1.25 + 0.12*Math.sin(T*2.2);
  var ts = [131.0, 132.5, 134.0];
  for(var i=0;i<3;i++) plate(rtA, (i-1)*2.05, 0, -4.2, 1.9, {tint:[0.9,0.95,1.05], sat:0.75, op:ramp(T,ts[i],ts[i]+0.8), bright:pulse});
  cam(0,0.1,1.2, 0,0,-4.2, 42);
});
S('S13', 139.32, 149.18, function(u,T){
  useVoid(0.45);
  renderRoom(rtA, V0, T); renderRoom(rtB, V1, T); renderRoom(rtC, VX, T);
  var p = ramp(T, 139.7, 142.2), back = ramp(T, 142.4, 148.5);
  var z = lerp(-4.2, -5.6, back), op = lerp(1, 0.55, back);
  plate(rtA, -2.05, 0, z, 1.9, {tint:[0.9,0.95,1.05], sat:0.75, op:op, bright:1.25});
  plate(rtA, 0, 0, z, 1.9, {tint:[0.9,0.95,1.05], sat:0.75, op:op*(1-p), bright:1.25});
  plate(rtB, 0.06*p, 0.05*p, z+0.01, 1.9, {tint:TINT_NEW, sat:0.9, op:op*p, bright:1.25, rz:0.03*p});
  plate(rtA, 2.05, 0, z, 1.9, {tint:[0.9,0.95,1.05], sat:0.75, op:op*(1-p), bright:1.25});
  plate(rtC, 2.05-0.07*p, -0.04*p, z+0.01, 1.9, {tint:tintMix(TINT_OLD,TINT_NEW,0.5), sat:0.85, op:op*p, bright:1.25, rz:-0.03*p});
  cam(0,0.1,1.2, 0,0,-4.2, 42);
  kOn('kBartName', win(T, 145.2, 149.0, 0.6));
});
S('S14', 149.18, 159.81, function(u,T){
  G.desk.visible = true;
  var sweep = lerp(-0.25, 0.1, ramp(T,149.5,156.0));
  deskObjects({book:[0.0,-0.36,0.28], stack:[-0.45,-0.60], mug:[0.40,-0.12], lamp:1, lampT:[sweep,-0.36]});
  camLerp([0.22,1.02,-0.02, 0.0,0.76,-0.37, 38], [0.14,0.96,-0.08, 0.0,0.76,-0.37, 36], u/10.6);
  kOn('kSrcRem', win(T, 150.4, 159.6, 0.7));
  kOn('kSrcRem2', win(T, 156.4, 159.6, 0.6));
});
function sheetPose(T){
  var at = [160.4, 183.3, 187.15, 189.9];
  var poses = [];
  for(var i=0;i<4;i++){
    var q = ramp(T, at[i], at[i]+0.9);
    if(q <= 0){ poses.push(null); continue; }
    var tx = -0.36 + i*0.24, tz = -0.40;
    if(i===0){ var m = ramp(T, 181.9, 183.2); tx = lerp(0.0, -0.36, m); }
    poses.push([tx + (1-q)*0.10, tz + (1-q)*0.22, (i%2?0.03:-0.025)*(1-0.5*q)]);
  }
  return poses;
}
S('S15', 159.81, 197.49, function(u,T){
  G.desk.visible = true;
  deskObjects({sheets:sheetPose(T), mug:[0.62,-0.12], lamp:1, lampT:[0,-0.40]});
  var wide = ramp(T, 181.9, 184.2), wide2 = ramp(T, 192.8, 196.5);
  var A = [0.02,1.10,-0.08, 0.0,0.745,-0.47, 38], B = [0.0,1.30,0.18, 0.0,0.745,-0.42, 42], Cc = [0.0,1.42,0.30, 0.0,0.745,-0.42, 42];
  var E = camArr(A, [0.0,1.06,-0.12, 0.0,0.745,-0.47, 36], (181.9-159.81)/22);  /* nối liền, không giật ở 181.9 */
  if(T < 181.9) camLerp(A, [0.0,1.06,-0.12, 0.0,0.745,-0.47, 36], u/22);
  else if(T < 192.8) camLerp(E, B, wide);
  else camLerp(B, Cc, wide2);
  kOn('kGhostSub', win(T, 169.6, 181.6, 0.7));
  kOn('kGhost', win(T, 174.3, 181.6, 0.7));
});
S('S16', 197.49, 221.39, function(u,T){
