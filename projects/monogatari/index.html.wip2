  for(var row=0;row<3;row++){ var x = -1.12; while(x < 1.1){ var bw = 0.03+r()*0.04, bh = 0.34+r()*0.18; shelfG.add(box(bw,bh,0.24, stdMat(cols[Math.floor(r()*cols.length)],0.85), x+bw/2, 0.32+row*0.6+bh/2, 0.02)); x += bw+0.004; if(r()<0.06) x += 0.08; } }
  var tbl = new THREE.Mesh(new THREE.BoxGeometry(1.6,0.04,0.9), stdMat(0xffffff,0.55,0,{map:woodTex('#6e4b2e','40,24,12',1024,512,602,140)})); tbl.position.set(0,0.72,0); g.add(tbl);
  var pageTex = canvasTex(256,360,function(cx,w,h){ cx.fillStyle = '#f0e9d8'; cx.fillRect(0,0,w,h); var rr = HFA.mulberry32(603); for(var y=30;y<h-20;y+=14){ cx.fillStyle='rgba(50,45,40,0.5)'; cx.fillRect(22,y,w-44-(rr()<0.15?rr()*80:0),4); } });
  SB.book = new THREE.Group(); SB.book.position.set(0,0.742,0.05); g.add(SB.book);
  SB.cover = box(0.52,0.012,0.34, stdMat(0x5a2a22,0.8), 0,0,0); SB.book.add(SB.cover);
  SB.left = box(0.24,1,0.32, stdMat(0xb8b0a0,0.9), -0.125,0,0); SB.book.add(SB.left);
  SB.right = box(0.24,1,0.32, stdMat(0xb8b0a0,0.9), 0.125,0,0); SB.book.add(SB.right);
  SB.pl = new THREE.Mesh(new THREE.PlaneGeometry(0.235,0.315), stdMat(0xbdb7aa,0.9,0,{map:pageTex})); SB.pl.rotation.x = -Math.PI/2; SB.book.add(SB.pl);
  SB.pr = new THREE.Mesh(new THREE.PlaneGeometry(0.235,0.315), stdMat(0xbdb7aa,0.9,0,{map:pageTex})); SB.pr.rotation.x = -Math.PI/2; SB.book.add(SB.pr);
  SB.turn = new THREE.Group(); SB.book.add(SB.turn);
  var tp = new THREE.Mesh(new THREE.PlaneGeometry(0.235,0.315), stdMat(0xbdb7aa,0.9,0,{map:pageTex, side:THREE.DoubleSide})); tp.rotation.x = -Math.PI/2; tp.position.x = 0.1175; SB.turn.add(tp);
  var lamp = new THREE.SpotLight(0xffc98f, 1.3, 5, 0.7, 0.8, 1.1); lamp.position.set(0.6,1.6,0.6); g.add(lamp);
  var lt = new THREE.Object3D(); lt.position.set(0,0.74,0.05); g.add(lt); lamp.target = lt;
  g.add(new THREE.AmbientLight(0x4a5060, 0.22));
  var shelfL = new THREE.DirectionalLight(0xa0b4d0, 0.35); shelfL.position.set(-2,3,2); g.add(shelfL);
})();
function setBook(u, grow){
  var thL = lerp(0.012, 0.03, grow), thR = lerp(0.006, 0.022, grow);
  SB.left.scale.y = thL; SB.left.position.y = 0.006 + thL/2;
  SB.right.scale.y = thR; SB.right.position.y = 0.006 + thR/2;
  SB.pl.position.set(-0.125, 0.0065 + thL, 0); SB.pr.position.set(0.125, 0.0065 + thR, 0);
  var cyc = (u % 2.6)/2.6, a = ease(clamp((cyc-0.1)/0.75,0,1));
  SB.turn.position.set(0, 0.008 + Math.max(thL,thR), 0);
  SB.turn.rotation.z = a*Math.PI;
  SB.turn.visible = cyc > 0.08 && cyc < 0.92;
}


/* =========================================================================
 * CHỮ ĐỘNG (kinetic type) — lớp DOM, font BIZ UDPGothic. Chỉ đặt ở 2/3 trên khung,
 * cách mép ≥ 80px, không chồng #sub (đáy) hay #chap (trái dưới) — ràng buộc A, C.
 * ========================================================================= */
var KT = {}, KT_IDS = [];
var C_WARM = '#F3CB91', C_COOL = '#AFCBEE', C_TXT = '#F6F1E7';
function K(id, text, css){
  var d = document.createElement('div'); d.className = 'kt'; d.id = id; d.textContent = text;
  d.style.cssText = css; kinEl.appendChild(d);
  KT[id] = {el:d, op:-1, want:0, x:null, y:null, wx:null, wy:null}; KT_IDS.push(id);
}
function kOn(id, op, x, y){ var k = KT[id]; if(op > k.want) k.want = op; if(x != null){ k.wx = x; k.wy = y; } }
function kFlush(){
  for(var i=0;i<KT_IDS.length;i++){
    var k = KT[KT_IDS[i]];
    var o = Math.round(k.want*1000)/1000;
    if(o !== k.op){ k.el.style.opacity = String(o); k.op = o; }
    if(k.wx != null && (k.wx !== k.x || k.wy !== k.y)){ k.el.style.left = k.wx.toFixed(1) + 'px'; k.el.style.top = k.wy.toFixed(1) + 'px'; k.x = k.wx; k.y = k.wy; }
    k.want = 0; k.wx = null; k.wy = null;
  }
}
var CEN = 'transform:translate(-50%,-50%);';
K('kBartName', 'バートレット（イギリスの心理学者）', 'left:960px;top:150px;font-size:46px;' + CEN);
K('kSrcRem',  'バートレット『リメンバリング』（1932年）', 'left:960px;top:130px;font-size:46px;' + CEN);
K('kSrcRem2', 'Remembering ＝ 思い出すこと', 'left:960px;top:205px;font-size:38px;color:' + C_WARM + ';' + CEN);
K('kGhostSub','北アメリカ先住民の昔話', 'left:960px;top:118px;font-size:36px;color:' + C_COOL + ';' + CEN);
