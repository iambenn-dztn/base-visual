/* camera trong xe — tư thế chuẩn */
var CC_WIDE  = [0.06,1.25,1.02, -1.02,1.02,-3.0, 50];
var CC_SIDE  = [0.25,1.28,0.78, -1.8,1.15,-0.3, 44];
var CC_CLOSE = [0.20,1.30,0.86, -0.37,1.26,0.10, 34];

/** cập nhật thế giới trôi qua: d = quãng đường (m), yaw đầu cha (rad) */
function setCar(t, d, headYaw, opts){
  opts = opts || {};
  CAR_SKY.material.uniforms.uT.value = t;
  ROAD_TEX.offset.y = (d/10) % 1;
  PADDY_TEX.offset.y = (d/15) % 1;
  for(var i=0;i<POLE_N;i++){
    var z = -420 + ((i*POLE_SP + d) % POLE_LEN);
    POLES[i].position.set(5.9, -0.1, z);
  }
  /* dây điện võng giữa các cột liền kề (bỏ đoạn nối qua điểm quấn vòng) */
  var k = 0;
  for(var i2=0;i2<POLE_N;i2++){
    var a = POLES[i2].position, b = POLES[(i2+1)%POLE_N].position;
    var ok = Math.abs(b.z - a.z - POLE_SP) < 1.0;
    for(var wv=0; wv<3; wv++){
      var xo = [-0.7,0.0,0.7][wv], yo = 9.85 + (wv===1?0.05:0);
      for(var s=0;s<WIRE_SEG;s++){
        var f0 = s/WIRE_SEG, f1 = (s+1)/WIRE_SEG;
        var sag0 = 4*f0*(1-f0)*0.9, sag1 = 4*f1*(1-f1)*0.9;
        if(!ok){ f0 = f1 = 0; sag0 = sag1 = 0; }
        WIRE_POS[k++] = a.x+xo; WIRE_POS[k++] = a.y+yo - sag0; WIRE_POS[k++] = a.z + (b.z-a.z)*f0*(ok?1:0);
        WIRE_POS[k++] = a.x+xo; WIRE_POS[k++] = a.y+yo - sag1; WIRE_POS[k++] = a.z + (b.z-a.z)*f1*(ok?1:0);
      }
    }
  }
  WIRE_G.attributes.position.needsUpdate = true;
  for(var j=0;j<FARMS.length;j++){
    var fu = FARMS[j].userData;
    FARMS[j].position.set(fu.x, 0, -900 + ((fu.z0 + d) % 1000));
  }
  HALL.visible = opts.hallZ != null;
  if(HALL.visible) HALL.position.set(-13.5, -0.05, opts.hallZ);
  WALKER.visible = !!opts.walker;
  if(opts.walker){
    var wk = opts.walker;
    WALKER.position.set(wk[0], 0, wk[1]); WALKER.rotation.y = wk[2];
    var ph = wk[3];
    WLEGS[0].rotation.x = 0.38*Math.sin(ph); WLEGS[1].rotation.x = -0.38*Math.sin(ph);
    WARMS[0].rotation.x = -0.28*Math.sin(ph); WARMS[1].rotation.x = 0.28*Math.sin(ph);
  }
  FATHER.visible = opts.father !== false;
  FHEAD.rotation.set(-0.05, headYaw, 0.0);
  CAR_DOOR.rotation.y = -(opts.door || 0);
  /* rung nhẹ của xe đang chạy (hàm thuần của t) */
  var moving = opts.moving == null ? 1 : opts.moving;
  CAR.cabin.position.y = moving*(0.0025*Math.sin(t*9.3) + 0.0015*Math.sin(t*15.7+1.1));
  CAR.cabin.rotation.z = moving*0.0015*Math.sin(t*4.1);
}


/* =========================================================================
 * KHÔNG GIAN LỚP ẢNH (void) — nền tối ấm, bụi mềm; nơi các lớp ký ức treo.
 * ========================================================================= */
var VOID_BG = new THREE.Mesh(new THREE.SphereGeometry(120, 32, 20), new THREE.ShaderMaterial({
  uniforms:{uWarm:{value:0.5}, uB:{value:1}},
  vertexShader:'varying vec3 vP;void main(){vP=normalize(position);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}',
  fragmentShader:[
    'varying vec3 vP;uniform float uWarm,uB;',
    'void main(){ vec3 d=normalize(vP);',
    ' vec3 cool=vec3(0.010,0.014,0.022), warm=vec3(0.024,0.016,0.011);',
    ' vec3 c=mix(cool,warm,uWarm);',
    ' float glow=pow(max(dot(d,normalize(vec3(0.0,0.1,-1.0))),0.0),6.0);',
    ' c+=mix(vec3(0.020,0.026,0.040),vec3(0.045,0.030,0.018),uWarm)*glow;',
    ' c*=0.8+0.2*smoothstep(-0.6,0.4,d.y);',
    ' gl_FragColor=vec4(c*uB,1.0); }'
  ].join('\n'),
  side:THREE.BackSide, depthWrite:false
}));
VOID_BG.renderOrder = -10; G.voidbg.add(VOID_BG);
var VOID_DUST = dustPoints(1400, [30,14,40], [0,0,-8], 101, [0.9,0.78,0.6], 5, 0.018);
G.voidbg.add(VOID_DUST);

/* ---- bể lớp ảnh (plate pool) ---- */
var PLATES = [];
for(var ipl=0; ipl<34; ipl++){
  var pm = new THREE.Mesh(new THREE.PlaneGeometry(1.6,0.9), plateMat());
  pm.visible = false; G.plates.add(pm); PLATES.push(pm);
}
var _plateN = 0;
/** đặt một lớp ảnh. w = bề rộng (m). o: {op,tint,sat,bright,feather,edge,srgb,grid,ry,rx,blank} */
function plate(tex, x,y,z, w, o){
  if(_plateN >= PLATES.length) return null;
  var p = PLATES[_plateN++]; o = o || {};
  var u = p.material.uniforms;
  p.visible = true;
  p.position.set(x,y,z);
  p.rotation.set(o.rx||0, o.ry||0, o.rz||0);
  var asp = o.aspect || 16/9;
  p.scale.set(w/1.6, (w/asp)/0.9, 1);
  u.map.value = tex; u.uOp.value = o.op==null?1:o.op;
  var tn = o.tint || TINT_N; u.uTint.value.setRGB(tn[0],tn[1],tn[2]);
  u.uSat.value = o.sat==null?1:o.sat; u.uBright.value = o.bright==null?1:o.bright;
  u.uFeather.value = o.feather==null?0.05:o.feather; u.uEdge.value = o.edge==null?0.55:o.edge;
  u.uSRGB.value = o.srgb?1:0; u.uGrid.value = o.grid||0; u.uBlank.value = o.blank||0;
  u.uAspect.value = asp;
  p.material.depthTest = !o.noDepth;   /* noDepth: lớp phủ cố ý nổi trên vật đặc (S48) */
  p.userData.order = o.order;
  return p;
}
function resetPlates(){ for(var i=0;i<PLATES.length;i++) PLATES[i].visible = false; _plateN = 0; }
/** vẽ lớp xa trước (trong suốt chồng đúng thứ tự) */
function sortPlates(){
  var v = [];
  for(var i=0;i<_plateN;i++) v.push(PLATES[i]);
  var cp = camera.position;
  v.sort(function(a,b){
    var da = a.userData.order != null ? a.userData.order : -a.position.distanceTo(cp);
    var db = b.userData.order != null ? b.userData.order : -b.position.distanceTo(cp);
    return da - db;
  });
  for(var j=0;j<v.length;j++) v[j].renderOrder = 10 + j;
}

/* ---- "ảnh ký ức" của những đời người khác: tranh canvas mờ nét, tất định ---- */
function memoryPhoto(kind, seed){
  return canvasTex(640,360,function(cx,w,h){
    var r = HFA.mulberry32(seed);
    function grad(stops){ var g = cx.createLinearGradient(0,0,0,h); for(var i=0;i<stops.length;i++) g.addColorStop(stops[i][0], stops[i][1]); cx.fillStyle = g; cx.fillRect(0,0,w,h); }
    function blob(x,y,rad,col){ var g = cx.createRadialGradient(x,y,0,x,y,rad); g.addColorStop(0,col); g.addColorStop(1,'rgba(0,0,0,0)'); cx.fillStyle = g; cx.fillRect(x-rad,y-rad,rad*2,rad*2); }
    cx.filter = 'blur(5px)';
    if(kind===0){ grad([[0,'#f2a65e'],[0.45,'#e57e4d'],[0.55,'#6b5a78'],[1,'#27304a']]); blob(w*0.62,h*0.47,60,'rgba(255,230,170,0.95)'); cx.fillStyle='rgba(20,24,40,0.8)'; cx.fillRect(0,h*0.56,w,h); for(var i=0;i<30;i++){ cx.fillStyle='rgba(255,200,140,0.35)'; cx.fillRect(w*0.5+r()*w*0.25,h*0.58+r()*h*0.3,20+r()*40,2); } }
    else if(kind===1){ grad([[0,'#b9c6d6'],[0.6,'#e3e8ee'],[1,'#f4f5f7']]); for(var i2=0;i2<6;i2++){ var x=r()*w, y=h*0.45+r()*h*0.1; cx.fillStyle='rgba(40,40,48,0.85)'; cx.beginPath(); cx.moveTo(x-50,y); cx.lineTo(x,y-40); cx.lineTo(x+50,y); cx.fill(); cx.fillStyle='rgba(90,80,70,0.8)'; cx.fillRect(x-40,y,80,40); } }
    else if(kind===2){ grad([[0,'#0d0c16'],[1,'#1c1420']]); for(var i3=0;i3<26;i3++){ blob(r()*w, h*0.2+r()*h*0.5, 14+r()*26, 'rgba(255,' + (140+Math.floor(r()*80)) + ',60,0.9)'); } }
    else if(kind===3){ grad([[0,'#7fb0e0'],[0.55,'#cfe2f1'],[0.56,'#b9a58a'],[1,'#a08c6c']]); for(var i4=0;i4<12;i4++){ blob(r()*w, h*0.25+r()*h*0.3, 40+r()*40, 'rgba(250,200,215,0.85)'); } cx.fillStyle='rgba(240,238,230,0.9)'; cx.fillRect(w*0.1,h*0.35,w*0.3,h*0.22); }
    else if(kind===4){ grad([[0,'#9cc4e6'],[0.42,'#dbe8ee'],[0.44,'#6f8a55'],[1,'#4f6a36']]); cx.fillStyle='rgba(90,110,140,0.7)'; cx.beginPath(); cx.moveTo(0,h*0.44); for(var x4=0;x4<=w;x4+=20) cx.lineTo(x4,h*0.44-30-25*Math.sin(x4*0.012)); cx.lineTo(w,h*0.44); cx.fill(); }
    else if(kind===5){ grad([[0,'#262a3e'],[0.6,'#58506a'],[1,'#20202a']]); for(var i5=0;i5<40;i5++){ var yy=h*0.3+r()*h*0.4; cx.fillStyle='rgba(255,210,150,0.5)'; cx.fillRect(r()*w,yy,40+r()*120,3); } cx.fillStyle='rgba(10,10,14,0.9)'; cx.fillRect(0,0,w*0.06,h); cx.fillRect(w*0.94,0,w*0.06,h); }
    else if(kind===6){ grad([[0,'#6c5a48'],[1,'#3a2e26']]); cx.fillStyle='rgba(255,236,200,0.85)'; cx.fillRect(w*0.55,h*0.12,w*0.28,h*0.45); blob(w*0.69,h*0.36,160,'rgba(255,220,170,0.35)'); cx.fillStyle='rgba(120,86,60,0.95)'; cx.fillRect(w*0.1,h*0.66,w*0.8,h*0.08); }
    else { grad([[0,'#d88a4a'],[0.5,'#b4602e'],[1,'#4a2c1a']]); for(var i7=0;i7<40;i7++){ blob(r()*w, r()*h*0.7, 16+r()*30, 'rgba(' + (200+Math.floor(r()*55)) + ',' + (60+Math.floor(r()*90)) + ',30,0.8)'); } }
    cx.filter = 'none';
    /* hạt phim + góc tối nhẹ */
    for(var n=0;n<5000;n++){ var v=Math.floor(r()*255); cx.fillStyle='rgba(' + v + ',' + v + ',' + v + ',0.05)'; cx.fillRect(r()*w,r()*h,1,1); }
    var vg = cx.createRadialGradient(w/2,h/2,h*0.3,w/2,h/2,w*0.62); vg.addColorStop(0,'rgba(0,0,0,0)'); vg.addColorStop(1,'rgba(0,0,0,0.45)'); cx.fillStyle = vg; cx.fillRect(0,0,w,h);
  });
}
var LIFE = [];
for(var il=0; il<8; il++) LIFE.push(memoryPhoto(il, 300+il));

/* ---- dải sáng "câu chuyện đời" (ribbon) — ống phát sáng theo đường cong ---- */
function ribbonMesh(points, radius, seg){
  var curve = new THREE.CatmullRomCurve3(points.map(function(p){ return new THREE.Vector3(p[0],p[1],p[2]); }));
  var geo = new THREE.TubeGeometry(curve, seg||160, radius, 10, false);
  var mat = new THREE.ShaderMaterial({
    uniforms:{uP:{value:1}, uI:{value:1}, uCol:{value:new THREE.Color(1.6,1.05,0.55)}, uT:{value:0}},
    vertexShader:'varying vec2 vUv;varying vec3 vN;varying vec3 vV;void main(){vUv=uv;vN=normalize(normalMatrix*normal);vec4 mv=modelViewMatrix*vec4(position,1.0);vV=normalize(-mv.xyz);gl_Position=projectionMatrix*mv;}',
    fragmentShader:[
      'varying vec2 vUv;varying vec3 vN;varying vec3 vV;uniform float uP,uI,uT;uniform vec3 uCol;',
      'void main(){ float f=abs(dot(normalize(vN),normalize(vV)));',
      ' float core=pow(f,1.5);',
      ' float head=smoothstep(uP,uP-0.04,vUv.x);',
      ' float pulse=0.8+0.2*sin(vUv.x*40.0-uT*1.2);',
      ' float a=core*head*uI*pulse;',
      ' gl_FragColor=vec4(uCol*a, a); }'
    ].join('\n'),
    transparent:true, depthWrite:false, blending:THREE.AdditiveBlending
  });
  var m = new THREE.Mesh(geo, mat); m.renderOrder = 60; return m;
}
/* dải cho S27/S29/S44: đi qua các lớp đời người, tới khung tương lai trống */
var RIB_LIFE = ribbonMesh([[-7.5,-0.6,-3],[-5,0.3,-4.5],[-2.5,-0.4,-5.5],[0,0.35,-6],[2.5,-0.3,-6.5],[5,0.4,-7.5],[7.5,0.0,-9],[10,0.3,-10.5]], 0.022, 240);
G.plates.add(RIB_LIFE);
/* dải cho S26: từ lớp cũ (sau) tới lớp mới (trước) */
var RIB_DIR = ribbonMesh([[0,0,-7.5],[0.5,0.25,-6.2],[-0.2,-0.1,-4.8],[0.3,0.2,-3.6],[0,0,-2.5]], 0.018, 120);
G.plates.add(RIB_DIR);
/* khung tương lai: viền sáng, bên trong trống */
function frameMesh(){
  var g = new THREE.Group();
  var m = new THREE.MeshBasicMaterial({color:new THREE.Color(1.3,1.0,0.7), transparent:true, opacity:0.8, depthWrite:false, blending:THREE.AdditiveBlending});
  var t = 0.012;
  g.add(box(1.6,t,t,m,0,0.45,0)); g.add(box(1.6,t,t,m,0,-0.45,0)); g.add(box(t,0.9,t,m,-0.8,0,0)); g.add(box(t,0.9,t,m,0.8,0,0));
  g.userData.mat = m; g.renderOrder = 55; return g;
}
var FUT = [frameMesh(), frameMesh(), frameMesh()];
FUT.forEach(function(f){ G.plates.add(f); });

/* =========================================================================
 * MẢNH GHÉP (reconstruction) — 8×5 mảnh cắt từ hai lần kể, tự ghép lại, có khe hở
 * ========================================================================= */
var SH_NX = 8, SH_NY = 5, SHARDS = [];
(function(){
  var r = HFA.mulberry32(401);
  for(var j=0;j<SH_NY;j++) for(var i=0;i<SH_NX;i++){
    var m = new THREE.Mesh(new THREE.PlaneGeometry(1,1), plateMat());
    var u = m.material.uniforms;
    u.uUv.value.set(i/SH_NX, j/SH_NY, 1/SH_NX, 1/SH_NY);
    u.uFeather.value = 0.015; u.uEdge.value = 0.0; u.uAspect.value = 1.0;
    m.userData = { i:i, j:j,
      sx:(r()-0.5)*9, sy:(r()-0.5)*5, sz:-2 - r()*7, rx:(r()-0.5)*2.4, ry:(r()-0.5)*2.4, rz:(r()-0.5)*1.6,
      delay:r(), newer: r() < 0.34 };
    G.shards.add(m); SHARDS.push(m);
  }
})();
/**
 * p: tiến độ ghép 0→1 · texOld/texNew: hai lần kể · warmMix: phần "hiện tại" chiếm chỗ
 * W: bề rộng ảnh khi ghép xong · gap: khe hở (0..1) · cz: độ sâu ảnh ghép
 */
function setShards(t, p, texOld, texNew, warmMix, Wd, gap, cz, op, tintOld, tintNew){
  var Hd = Wd*9/16, cw = Wd/SH_NX, ch = Hd/SH_NY;
  for(var k=0;k<SHARDS.length;k++){
    var m = SHARDS[k], d = m.userData, u = m.material.uniforms;
    var q = ease(clamp((p - d.delay*0.45)/0.55, 0, 1));
    var tx = -Wd/2 + cw*(d.i+0.5), ty = -Hd/2 + ch*(d.j+0.5);
    var drift = (1-q);
    m.position.set(lerp(d.sx, tx, q) + drift*0.15*Math.sin(t*0.3+k), lerp(d.sy, ty, q) + drift*0.12*Math.cos(t*0.27+k*1.3), lerp(d.sz, cz, q));
    m.rotation.set(d.rx*drift, d.ry*drift, d.rz*drift);
    var s = 1 - gap;
    m.scale.set(cw*s, ch*s, 1);
    var isNew = d.newer && warmMix > 0.5;
    u.map.value = isNew ? texNew : texOld;
    var tn = isNew ? tintNew : tintOld;
    u.uTint.value.setRGB(tn[0],tn[1],tn[2]);
    u.uOp.value = op * (0.35 + 0.65*q) * (d.newer ? Math.abs(warmMix*2-1) : 1);
    u.uBright.value = 1.0; u.uSat.value = isNew ? 0.95 : 0.7;
    m.renderOrder = 20 + k;
  }
}


/* =========================================================================
 * BÀN LÀM VIỆC BAN ĐÊM — nơi 私 tra cứu: sách Bartlett, tạp chí Psychiatry,
 * bài báo Marsh & Tversky / McAdams & McLean, sổ ghi, các tờ giấy thí nghiệm.
