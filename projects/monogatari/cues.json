{
  "total": 831.94,
  "count": 308,
  "cues": [
    {
      "t": 0,
      "s": "木曜日の朝でした。"
    },
    {
      "t": 2.03,
      "s": "私は車を運転していて、"
    },
    {
      "t": 4.52,
      "s": "助手席には父が座っていました。"
    },
    {
      "t": 7.91,
      "s": "毎週この時間に、"
    },
    {
      "t": 9.64,
      "s": "父を隣町の囲碁の会へ送っていくんです。"
    },
    {
      "t": 13.76,
      "s": "片道、二十分ほどの道です。"
    },
    {
      "t": 16.56,
      "s": "田んぼの横の道に出たとき、"
    },
    {
      "t": 19.02,
      "s": "父が窓の外を見ながら、"
    },
    {
      "t": 21.11,
      "s": "ぽつりと言いました。"
    },
    {
      "t": 23.01,
      "s": "あの台風の晩はな。"
    },
    {
      "t": 26.32,
      "s": "ああ、あの話だ、と私は思いました。"
    },
    {
      "t": 29.64,
      "s": "子どものころから、"
    },
    {
      "t": 31.41,
      "s": "もう何十回と聞いてきた話なんです。"
    },
    {
      "t": 34.73,
      "s": "父が小学生のころ、"
    },
    {
      "t": 36.5,
      "s": "家は田んぼの端にありました。"
    },
    {
      "t": 39.27,
      "s": "大きな台風が来て、夜じゅう、"
    },
    {
      "t": 42.03,
      "s": "風が家を揺らしたそうです。"
    },
    {
      "t": 44.59,
      "s": "居間のガラス窓が、"
    },
    {
      "t": 46.36,
      "s": "今にも外れそうに鳴っていた。"
    },
    {
      "t": 49.11,
      "s": "それを誰かが一晩中、"
    },
    {
      "t": 51.08,
      "s": "両手で押さえていたんです。"
    },
    {
      "t": 53.63,
      "s": "押さえていたのは、祖父でした。"
    },
    {
      "t": 56.72,
      "s": "私が聞いてきた話では、いつもそうでした。"
    },
    {
      "t": 60.84,
      "s": "ところが、この朝の父は、こう言ったんです。"
    },
    {
      "t": 64.19,
      "s": "おふくろがな、朝まで押さえてたんだ。"
    },
    {
      "t": 69.01,
      "s": "祖母だ、と言いました。それに、"
    },
    {
      "t": 71.72,
      "s": "前はろうそくの明かりだったのが、"
    },
    {
      "t": 74.6,
      "s": "この朝は懐中電灯になっていました。"
    },
    {
      "t": 77.67,
      "s": "前はじいちゃんだったよね。"
    },
    {
      "t": 80.16,
      "s": "そう言いかけて、私は口を閉じました。"
    },
    {
      "t": 83.61,
      "s": "どちらが本当なのか。"
    },
    {
      "t": 85.81,
      "s": "父の記憶が、どこか弱ってきているのか。"
    },
    {
      "t": 90,
      "s": "そんな考えが、一瞬よぎりました。"
    },
    {
      "t": 93.53,
      "s": "でも、"
    },
    {
      "t": 94.02,
      "s": "それよりも気になったことがあったんです。"
    },
    {
      "t": 97.25,
      "s": "同じ人が、同じ話をしている。それなのに、"
    },
    {
      "t": 101.81,
      "s": "なぜ細かいところだけが、"
    },
    {
      "t": 104.54,
      "s": "話すたびに変わるのか。"
    },
    {
      "t": 108.53,
      "s": "その夜、私は調べてみることにしました。実は、"
    },
    {
      "t": 113.49,
      "s": "この問いには、"
    },
    {
      "t": 115.06,
      "s": "九十年以上前から答えを探して"
    },
    {
      "t": 118.22,
      "s": "きた人たちがいたんです。"
    },
    {
      "t": 120.92,
      "s": "まず、一つ想像してみてください。記憶が、"
    },
    {
      "t": 125.13,
      "s": "一本の録音テープのようなものだったとしたら。"
    },
    {
      "t": 129.78,
      "s": "そうであれば、"
    },
    {
      "t": 131.23,
      "s": "何度再生しても、"
    },
    {
      "t": 132.89,
      "s": "同じ音が出てくるはずです。"
    },
    {
      "t": 135.59,
      "s": "父の台風の話も、毎回同じになります。"
    },
    {
      "t": 139.32,
      "s": "でも、実際はそうなりません。"
    },
    {
      "t": 142.14,
      "s": "そこに早くから目をつけたのが、"
    },
    {
      "t": 145.16,
      "s": "イギリスの心理学者、"
    },
    {
      "t": 147.17,
      "s": "バートレットでした。"
    },
    {
      "t": 149.18,
      "s": "一九三二年、"
    },
    {
      "t": 150.54,
      "s": "バートレットは、"
    },
    {
      "t": 152.34,
      "s": "リメンバリングという本を出しました。"
    },
    {
      "t": 156.41,
      "s": "思い出すこと、という意味です。"
    },
    {
      "t": 159.81,
      "s": "その中の実験は、とても素朴なものでした。"
    },
    {
      "t": 163.81,
      "s": "イギリスの学生たちに、"
    },
    {
      "t": 166.02,
      "s": "ある短い物語を読んでもらうんです。"
    },
    {
      "t": 169.41,
      "s": "北アメリカの先住民に伝わる昔話で、題を、"
    },
    {
      "t": 174.18,
      "s": "幽霊たちの戦い、といいます。"
    },
    {
      "t": 177.51,
      "s": "学生たちには、なじみのない話でした。"
    },
    {
      "t": 181.81,
      "s": "読んだあと、"
    },
    {
      "t": 183.18,
      "s": "学生はその話を思い出して書きます。"
    },
    {
      "t": 187.05,
      "s": "何日かたって、また書く。"
    },
    {
      "t": 189.79,
      "s": "何か月もたって、また書く。"
    },
    {
      "t": 192.75,
      "s": "同じ人が、同じ話を、何度も書き直すわけです。"
    },
    {
      "t": 197.49,
      "s": "すると、どうなったか。"
    },
    {
      "t": 200.02,
      "s": "話の骨組みは、わりあい残りました。"
    },
    {
      "t": 203.94,
      "s": "何が起きて、どう終わったか。"
    },
    {
      "t": 207.17,
      "s": "そこは大きく崩れないんです。"
    },
    {
      "t": 210.39,
      "s": "変わっていったのは、細かいところでした。"
    },
    {
      "t": 213.77,
      "s": "話は回を追うごとに短くなり、"
    },
    {
      "t": 216.14,
      "s": "なじみのない部分が、"
    },
    {
      "t": 217.84,
      "s": "なじみのあるものに置き換わっていきました。"
    },
    {
      "t": 221.39,
      "s": "たとえば、"
    },
    {
      "t": 222.27,
      "s": "原文ではカヌーだった舟が、"
    },
    {
      "t": 224.54,
      "s": "いつの間にか、"
    },
    {
      "t": 225.77,
      "s": "ただのボートになっている。"
    },
    {
      "t": 228.04,
      "s": "学生たちが知っている舟に、"
    },
    {
      "t": 230.32,
      "s": "変わっていたんです。"
    },
    {
      "t": 232.07,
      "s": "バートレットは、"
    },
    {
      "t": 233.57,
      "s": "この結果から、"
    },
    {
      "t": 234.88,
      "s": "記憶についてこう書いています。"
    },
    {
      "t": 237.69,
      "s": "思い出すというのは、"
    },
    {
      "t": 239.59,
      "s": "固定された跡を、"
    },
    {
      "t": 241.1,
      "s": "もう一度呼び起こすことではない。"
    },
    {
      "t": 244.14,
      "s": "想像による、組み立て直しなのだ、と。"
    },
    {
      "t": 247.55,
      "s": "つまり、こういうことなんです。記憶は、"
    },
    {
      "t": 250.91,
      "s": "しまってあるものを"
    },
    {
      "t": 252.5,
      "s": "そのまま取り出すのではありません。"
    },
    {
      "t": 255.51,
      "s": "思い出すたびに、"
    },
    {
      "t": 256.92,
      "s": "手元の材料で組み立て直している。"
    },
    {
      "t": 259.76,
      "s": "材料は、"
    },
    {
      "t": 260.58,
      "s": "昔の出来事のかけらと、"
    },
    {
      "t": 262.83,
      "s": "今の自分が知っていることです。"
    },
    {
      "t": 265.91,
      "s": "だから細部は、"
    },
    {
      "t": 267.34,
      "s": "今の自分の方へ寄っていくわけです。"
    },
    {
      "t": 270.83,
      "s": "ここで、私はもう一つ知りたくなりました。"
    },
    {
      "t": 275.53,
      "s": "これは、実験室の中だけの話なのだろうか、と。"
    },
    {
      "t": 280.69,
      "s": "ふだんの思い出話ではどうなのか。"
    },
    {
      "t": 284.01,
      "s": "それを調べたのが、"
    },
    {
      "t": 285.88,
      "s": "アメリカの心理学者、"
    },
    {
      "t": 287.95,
      "s": "マーシュとトヴェルスキーの、"
    },
    {
      "t": 290.86,
      "s": "二〇〇四年の研究です。"
    },
    {
      "t": 293.14,
      "s": "参加した学生たちは、"
    },
    {
      "t": 294.82,
      "s": "自分の出来事を人に話すたびに、"
    },
    {
      "t": 297.35,
      "s": "それを書きとめていきました。"
    },
    {
      "t": 299.71,
      "s": "そして、"
    },
    {
      "t": 300.55,
      "s": "話した本人が、"
    },
    {
      "t": 302.01,
      "s": "自分で振り返って印をつけるんです。"
    },
    {
      "t": 305.57,
      "s": "大げさにしたか。省いたか。"
    },
    {
      "t": 308.29,
      "s": "付け足したか。"
    },
    {
      "t": 309.76,
      "s": "結果は、こうでした。"
    },
    {
      "t": 311.98,
      "s": "話した本人が、"
    },
    {
      "t": 313.54,
      "s": "内容を変えたと認めた語りは、"
    },
    {
      "t": 316.64,
      "s": "全体の六十一パーセント。"
    },
    {
      "t": 319.31,
      "s": "一方で、"
    },
    {
      "t": 320.09,
      "s": "不正確だったと本人が思った語りは、"
    },
    {
      "t": 323.39,
      "s": "四十二パーセントにとどまりました。"
    },
    {
      "t": 326.7,
      "s": "正直に言うと、"
    },
    {
      "t": 328.12,
      "s": "私はこの二つの数字の差に、"
    },
    {
      "t": 330.75,
      "s": "いちばん驚きました。"
    },
    {
      "t": 332.78,
      "s": "変えたと自覚していても、"
    },
    {
      "t": 335.21,
      "s": "嘘をついたとは思っていないんです。"
    },
    {
      "t": 338.65,
      "s": "そして話は、"
    },
    {
      "t": 339.86,
      "s": "聞き手によっても変わっていました。"
    },
    {
      "t": 343.28,
      "s": "楽しませたいときは大きくし、"
    },
    {
      "t": 346.11,
      "s": "用件を伝えたいときは簡単にする。"
    },
    {
      "t": 349.33,
      "s": "ただ、参加者は大学生です。"
    },
    {
      "t": 352.06,
      "s": "年を重ねた人の昔話を、"
    },
    {
      "t": 354.36,
      "s": "そのまま測ったものではありません。"
    },
    {
      "t": 357.93,
      "s": "それでも、"
    },
    {
      "t": 358.93,
      "s": "話すたびに細部が変わるのは、"
    },
    {
      "t": 361.73,
      "s": "年をとった人に限ったことではない。"
    },
    {
      "t": 365.12,
      "s": "人が話をするときの、ふつうの姿なんです。"
    },
    {
      "t": 370.59,
      "s": "ここまでで、"
    },
    {
      "t": 371.77,
      "s": "細部が変わる仕組みはわかりました。ですが、"
    },
    {
      "t": 375.88,
      "s": "私にはまだ一つ、"
    },
    {
      "t": 377.45,
      "s": "腑に落ちないことがあったんです。"
    },
    {
      "t": 380.58,
      "s": "父の話は、"
    },
    {
      "t": 381.56,
      "s": "でたらめに変わったのではありませんでした。"
    },
    {
      "t": 385.68,
      "s": "窓を押さえていた人が、祖父から祖母へ。"
    },
    {
      "t": 389.4,
      "s": "変わる向きが、あったんです。"
    },
    {
      "t": 392.15,
      "s": "その向きを考える手がかりが、"
    },
    {
      "t": 394.64,
      "s": "アメリカのノースウェスタン大学の心理学者、"
    },
    {
      "t": 398.38,
      "s": "ダン・マクアダムスの研究にありました。"
    },
    {
      "t": 401.76,
      "s": "マクアダムスは、"
    },
    {
      "t": 403.31,
      "s": "人は自分の人生を、"
    },
    {
      "t": 405.05,
      "s": "一つの物語として心の中に持っている、"
    },
    {
      "t": 408.53,
      "s": "と考えました。これを、"
    },
    {
      "t": 410.66,
      "s": "ナラティブ・アイデンティティと呼びます。"
    },
    {
      "t": 414.53,
      "s": "二〇一三年、"
    },
    {
      "t": 415.58,
      "s": "マクリーンとの共著の論文では、"
    },
    {
      "t": 418.2,
      "s": "それをこう説明しています。"
    },
    {
      "t": 420.47,
      "s": "心の中にしまわれ、"
    },
    {
      "t": 422.42,
      "s": "少しずつ変わり続ける人生の物語。"
    },
    {
      "t": 425.89,
      "s": "組み立て直された過去と、"
    },
    {
      "t": 428.49,
      "s": "思い描いた未来をつなぎ合わせて、"
    },
    {
      "t": 431.96,
      "s": "人生にまとまりと目的を与えるもの。"
    },
    {
      "t": 435.65,
      "s": "実は、"
    },
    {
      "t": 436.3,
      "s": "この定義の中に、"
    },
    {
      "t": 438.02,
      "s": "父の話を考える鍵が入っていたんです。"
    },
    {
      "t": 441.9,
      "s": "組み立て直された過去、とあります。"
    },
    {
      "t": 445.18,
      "s": "この理論では、"
    },
    {
      "t": 446.53,
      "s": "人生の物語の中の過去は、"
    },
    {
      "t": 448.85,
      "s": "はじめから組み立て直されたものなんです。"
    },
    {
      "t": 452.71,
      "s": "そして、変わり続ける、とあります。"
    },
    {
      "t": 455.83,
      "s": "物語は、棚にしまわれた本ではありません。"
    },
    {
      "t": 459.49,
      "s": "語る人と一緒に、"
    },
    {
      "t": 460.96,
      "s": "書き足されていくものなんです。"
    },
    {
      "t": 463.71,
      "s": "なぜ書き足すのか。"
    },
    {
      "t": 465.57,
      "s": "人生の物語は、"
    },
    {
      "t": 467.01,
      "s": "自分とは何者か、"
    },
    {
      "t": 468.66,
      "s": "という問いへの答えだからです。"
    },
    {
      "t": 471.76,
      "s": "語る人が変わっていけば、"
    },
    {
      "t": 474.24,
      "s": "答えも少しずつ変わります。"
    },
    {
      "t": 476.92,
      "s": "さて、ここで、"
    },
    {
      "t": 478.25,
      "s": "もう一人の人に登場してもらいます。"
    },
    {
      "t": 481.47,
      "s": "アメリカの精神科医、ロバート・バトラーです。"
    },
    {
      "t": 485.65,
      "s": "一九六三年、バトラーは、"
    },
    {
      "t": 488.2,
      "s": "サイカイアトリーという精神医学の学術誌に、"
    },
    {
      "t": 492.66,
      "s": "一本の論文を出しました。"
    },
    {
      "t": 495.21,
      "s": "題は、ライフレビュー。"
    },
    {
      "t": 497.55,
      "s": "人生の振り返り、という意味です。"
    },
    {
      "t": 500.95,
      "s": "当時、"
    },
    {
      "t": 501.54,
      "s": "お年寄りが昔の話ばかりするのは、"
    },
    {
      "t": 504.68,
      "s": "衰えのしるしだと見られていました。"
    },
    {
      "t": 508.02,
      "s": "意味のないことだと、扱われていたんです。"
    },
    {
      "t": 511.95,
      "s": "バトラーは、そこに異を唱えました。"
    },
    {
      "t": 515.71,
      "s": "年を重ねると、人は自然に、"
    },
    {
      "t": 518.59,
      "s": "自分の人生全体を振り返るようになる。"
    },
    {
      "t": 522.57,
      "s": "それは誰にでも起きることだ、と。"
    },
    {
      "t": 526.11,
      "s": "きっかけは、"
    },
    {
      "t": 527.28,
      "s": "残された時間に限りがある、"
    },
    {
      "t": 529.81,
      "s": "と感じることだと、"
    },
    {
      "t": 531.56,
      "s": "バトラーは書いています。"
    },
    {
      "t": 533.89,
      "s": "振り返りは、ただ懐かしむことではありません。"
    },
    {
      "t": 538.32,
      "s": "昔の出来事を取り出して、見直し、"
    },
    {
      "t": 541.54,
      "s": "並べ直す働きなんです。"
    },
    {
      "t": 543.75,
      "s": "バトラーは、"
    },
    {
      "t": 544.85,
      "s": "いいことばかりだとも言っていません。"
    },
    {
      "t": 548.16,
      "s": "振り返りが、"
    },
    {
      "t": 549.26,
      "s": "人によっては気持ちの落ち込みに"
    },
    {
      "t": 552.01,
      "s": "つながることもある、"
    },
    {
      "t": 553.85,
      "s": "と書いています。"
    },
    {
      "t": 555.32,
      "s": "その一方で、"
    },
    {
      "t": 556.49,
      "s": "年を重ねた人の率直さや穏やかさ、"
    },
    {
      "t": 559.62,
      "s": "知恵といったものも、"
    },
    {
      "t": 561.57,
      "s": "この振り返りの中から育つのだ、"
    },
    {
      "t": 564.5,
      "s": "と書いているんです。"
    },
    {
      "t": 566.45,
      "s": "バトラーはのちに、"
    },
    {
      "t": 568.21,
      "s": "アメリカ国立老化研究所の初代所長を"
    },
    {
      "t": 571.52,
      "s": "務めた人です。"
    },
    {
      "t": 572.89,
      "s": "日本の介護の現場で、"
    },
    {
      "t": 574.81,
      "s": "回想法と呼ばれているものがあります。"
    },
    {
      "t": 578.26,
      "s": "その源流をたどると、"
    },
    {
      "t": 580.18,
      "s": "この一九六三年の論文に行き着くんです。"
    },
    {
      "t": 584.99,
      "s": "ここで、父の話に戻してみます。"
    },
    {
      "t": 588.9,
      "s": "八十を過ぎた父が、台風の晩をまた語る。"
    },
    {
      "t": 592.84,
      "s": "そのたびに、話は組み立て直されています。"
    },
    {
      "t": 596.98,
      "s": "バートレットが見た仕組みです。"
    },
    {
      "t": 600.09,
      "s": "そして組み立て直すとき、"
    },
    {
      "t": 602.38,
      "s": "今の父が大事だと思うものが、"
    },
    {
      "t": 605.05,
      "s": "少しずつ前に出てくる。"
    },
    {
      "t": 607.15,
      "s": "マクアダムスの言う、変わり続ける物語です。"
    },
    {
      "t": 611.16,
      "s": "あの晩、"
    },
    {
      "t": 611.95,
      "s": "窓を押さえていたのは、"
    },
    {
      "t": 614.12,
      "s": "本当は誰だったのか。"
    },
    {
      "t": 616.1,
      "s": "正直なところ、それは私にはもうわかりません。"
    },
    {
      "t": 620.44,
      "s": "父にも、わからないのかもしれません。"
    },
    {
      "t": 623.99,
      "s": "ここからは、私なりの推測です。父はもう、"
    },
    {
      "t": 627.99,
      "s": "あの晩の祖父母より、"
    },
    {
      "t": 629.99,
      "s": "ずっと年上になっています。"
    },
    {
      "t": 632.59,
      "s": "自分も親として、"
    },
    {
      "t": 634.11,
      "s": "子どもを守る側に何十年も"
    },
    {
      "t": 636.38,
      "s": "立ってきた人なんです。"
    },
    {
      "t": 638.47,
      "s": "そういう人が振り返れば、"
    },
    {
      "t": 640.75,
      "s": "あの晩の見え方が変わっても、"
    },
    {
      "t": 643.4,
      "s": "不思議ではありません。"
    },
    {
      "t": 645.49,
      "s": "マクアダムスの考え方に沿えば、"
    },
    {
      "t": 648.61,
      "s": "細部が変わるのは、"
    },
    {
      "t": 650.48,
      "s": "その話が今も、"
    },
    {
      "t": 651.94,
      "s": "父の人生の物語として"
    },
    {
      "t": 654.02,
      "s": "使われているしるしなんです。"
    },
    {
      "t": 656.93,
      "s": "ここで、"
    },
    {
      "t": 657.57,
      "s": "言っておかなければならないことがあります。"
    },
    {
      "t": 660.92,
      "s": "マクアダムスの理論も、"
    },
    {
      "t": 662.94,
      "s": "バトラーのライフレビューも、"
    },
    {
      "t": 665.51,
      "s": "長く広く使われてきた考え方です。ですが、"
    },
    {
      "t": 669.18,
      "s": "一つの実験で数字が出た、"
    },
    {
      "t": 671.38,
      "s": "という種類のものではありません。"
    },
    {
      "t": 674.32,
      "s": "ですから、科学が証明した、とは申しません。"
    },
    {
      "t": 678.53,
      "s": "心理学者たちがこの現象をこう説明している。"
    },
    {
      "t": 682.74,
      "s": "そういうことなんです。"
    },
    {
      "t": 684.94,
      "s": "それから、もう一つ。"
    },
    {
      "t": 687.11,
      "s": "同じ日のうちに何度も同じことを尋ねる、"
    },
    {
      "t": 691.23,
      "s": "といった変化は、"
    },
    {
      "t": 692.96,
      "s": "また別の話です。"
    },
    {
      "t": 694.7,
      "s": "気になるときは、"
    },
    {
      "t": 696.43,
      "s": "お医者さんに相談することなんです。"
    },
    {
      "t": 701.59,
      "s": "次の木曜日の朝も、"
    },
    {
      "t": 703.59,
      "s": "私は父を乗せて、"
    },
    {
      "t": 705.37,
      "s": "同じ道を走っていました。"
    },
    {
      "t": 708.03,
      "s": "田んぼの横に出たところで、"
    },
    {
      "t": 710.7,
      "s": "父がまた言いました。"
    },
    {
      "t": 712.75,
      "s": "あの台風の晩はな。"
    },
    {
      "t": 714.61,
      "s": "窓を押さえていたのは、この日も祖母でした。"
    },
    {
      "t": 718.22,
      "s": "私は、何も直しませんでした。"
    },
    {
      "t": 720.61,
      "s": "代わりに、一つだけ聞いてみたんです。"
    },
    {
      "t": 724.33,
      "s": "そのとき、お父さんはどこにいたの、と。"
    },
    {
      "t": 728.26,
      "s": "父は少し黙ってから、言いました。"
    },
    {
      "t": 731.38,
      "s": "ちゃぶ台の下で、妹を抱えてたんだ。"
    },
    {
      "t": 736.18,
      "s": "何十回も聞いてきた話に、"
    },
    {
      "t": 738.75,
      "s": "はじめて聞く一行が加わりました。"
    },
    {
      "t": 742.17,
      "s": "なんというか、"
    },
    {
      "t": 743.66,
      "s": "話は崩れたのではありませんでした。"
    },
    {
      "t": 747.3,
      "s": "一枚、重なったんです。"
    },
    {
      "t": 749.65,
      "s": "マーシュとトヴェルスキーが見たとおり、"
    },
    {
      "t": 753.42,
      "s": "話は聞き手によって形を変えます。"
    },
    {
      "t": 756.6,
      "s": "この朝の聞き手は、私でした。"
    },
    {
      "t": 759.38,
      "s": "父の中で何が起きているのか、"
    },
    {
      "t": 762.16,
      "s": "すべてはわかりません。"
    },
    {
      "t": 764.34,
      "s": "ですが、一つ確かなことがあります。"
    },
    {
      "t": 767.72,
      "s": "父は、あの晩を、"
    },
    {
      "t": 769.48,
      "s": "今の自分の言葉で組み立て直していました。"
    },
    {
      "t": 773.87,
      "s": "助手席で、私に向かって。"
    },
    {
      "t": 776.51,
      "s": "今日お話ししたことで、"
    },
    {
      "t": 778.36,
      "s": "覚えて帰っていただきたいのは、"
    },
    {
      "t": 780.89,
      "s": "一つだけです。"
    },
    {
      "t": 782.07,
      "s": "記憶は、録音ではありません。"
    },
    {
      "t": 784.91,
      "s": "思い出すたびに組み立て直されるものです。"
    },
    {
      "t": 788.97,
      "s": "それは、"
    },
    {
      "t": 789.79,
      "s": "九十年あまり前の実験から、"
    },
    {
      "t": 792.42,
      "s": "確かめられてきたことなんです。"
    },
    {
      "t": 795.47,
      "s": "ですから、"
    },
    {
      "t": 796.43,
      "s": "昔話の細部が変わるとき、"
    },
    {
      "t": 798.74,
      "s": "そこで起きているのは、"
    },
    {
      "t": 800.86,
      "s": "壊れていく記憶ではありません。"
    },
    {
      "t": 803.75,
      "s": "一つの人生を、"
    },
    {
      "t": 805.09,
      "s": "今もまとめ直している心の働きなんです。"
    },
    {
      "t": 810.71,
      "s": "車は、囲碁の会の前に着きました。"
    },
    {
      "t": 813.91,
      "s": "父はドアを開けながら、来週はな、"
    },
    {
      "t": 817.1,
      "s": "あの川の話をしてやる、"
    },
    {
      "t": 819.3,
      "s": "と言いました。"
    },
    {
      "t": 820.7,
      "s": "私は、うん、と答えました。"
    },
    {
      "t": 823.63,
      "s": "その話もきっと、"
    },
    {
      "t": 825.43,
      "s": "前とは少し違うのだろうと思いながら。"
    }
  ]
}