<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1920, height=1080">
<title>Tập 4 — Rơi Vào Hố Đen — HyperFrames</title>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{width:1920px;height:1080px;overflow:hidden;background:#010207;font-family:"Segoe UI",-apple-system,Roboto,sans-serif;}
  #root{position:relative;width:1920px;height:1080px;}
  #c{position:absolute;inset:0;display:block;z-index:0;}
  #fx{position:absolute;inset:0;display:block;z-index:4;}
  #vig{position:absolute;inset:0;pointer-events:none;z-index:6;background:radial-gradient(ellipse at center,rgba(0,0,0,0) 52%,rgba(1,1,6,.62) 100%);}
  #chap{position:absolute;left:50%;top:6.2%;transform:translateX(-50%);z-index:18;color:#ffd7a8;font-size:26px;font-weight:600;letter-spacing:5px;text-transform:uppercase;opacity:0;text-shadow:0 2px 16px rgba(0,0,0,.95);white-space:nowrap;}
  #sub{position:absolute;left:50%;bottom:8.5%;transform:translateX(-50%);z-index:20;width:min(1400px,86%);text-align:center;color:#f4f1ff;font-size:40px;font-weight:600;line-height:1.4;text-shadow:0 2px 18px rgba(0,0,0,.95),0 0 3px rgba(0,0,0,.95);}
  #err{position:absolute;left:12px;top:12px;z-index:99;color:#ff9090;background:rgba(0,0,0,.8);padding:8px 10px;font:12px/1.5 monospace;max-width:90%;white-space:pre-wrap;border-radius:8px;display:none;}
</style>
</head>
<body>
<div data-hf-id="hf-root" id="root" data-composition-id="tap-04-roi-vao-ho-den" data-start="0" data-duration="1295.93" data-width="1920" data-height="1080">
  <canvas data-hf-id="hf-c" id="c" class="clip" data-start="0" data-duration="1295.93" data-track-index="0"></canvas>
  <canvas data-hf-id="hf-fx" id="fx" class="clip" data-start="0" data-duration="1295.93" data-track-index="1"></canvas>
  <div data-hf-id="hf-vig" id="vig"></div>
  <div data-hf-id="hf-chap" id="chap" data-layout-allow-occlusion></div>
  <div data-hf-id="hf-sub" id="sub" data-layout-allow-occlusion></div>
  <div data-hf-id="hf-err" id="err"></div>
</div>

<script>
window.addEventListener('error',function(e){var d=document.getElementById('err');if(!d)return;d.style.display='block';
  d.textContent='LỖI: '+(e.message||e.type)+(e.filename?('\n@ '+e.filename.split('/').pop()+':'+e.lineno):'');});

/* ============================================================
   "RƠI VÀO HỐ ĐEN" — Tập 4
   Composition TẤT ĐỊNH theo t. 9 chương = 9 CẢNH khác biệt,
   cắt dứt khoát, hình bám sát lời thoại. Dựng thẳng trên
   timeline 0..1295.93 (KHÔNG remap, KHÔNG audio).
   Hố đen = billboard shader (đĩa bồi tụ + chân trời đen tuyệt đối
   + vòng photon + lensing), starfield bị bẻ cong (screen lensing).
   ============================================================ */
const TOTAL=1295.93, W=1920, H=1080;
/* mốc CẮT CẢNH = start của các cue có chapter (timing.json) + TOTAL cuối */
const SB=[0, 81.26, 248.14, 347.41, 553.33, 700.59, 829.92, 1006.05, 1171.84, 1295.93];
const CHAP=["","ĐIỂM KHÔNG THỂ QUAY ĐẦU","HỐ ĐEN LÀ GÌ","VƯỢT QUA CHÂN TRỜI",
  "THỜI GIAN VỠ VỤN","MÌ HÓA","ĐIỂM KỲ DỊ","HỐ ĐEN BỐC HƠI",
  "NHỮNG GÃ KHỔNG LỒ","CÁNH CỬA GIỚI HẠN HIỂU BIẾT"];

function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return ((t^t>>>14)>>>0)/4294967296;};}
const rnd=mulberry32(20260706), rndc=mulberry32(4177), L=mulberry32(909);

function clamp(x,a,b){return Math.max(a,Math.min(b,x));}
function lerp(a,b,x){return a+(b-a)*x;}
function smooth(a){a=clamp(a,0,1);return a*a*a*(a*(a*6-15)+10);}
function ss(e0,e1,x){let t=clamp((x-e0)/((e1-e0)||1e-6),0,1);return t*t*(3-2*t);}
function win(t,a,b,fi,fo){return Math.max(0,Math.min(ss(a,a+fi,t),1-ss(b-fo,b,t)));}

/* ---------------- Three.js: renderer / scene ---------------- */
const renderer=new THREE.WebGLRenderer({canvas:document.getElementById('c'),antialias:true});
renderer.setPixelRatio(1); renderer.setSize(W,H);
renderer.outputEncoding=THREE.sRGBEncoding; renderer.toneMapping=THREE.ACESFilmicToneMapping; renderer.toneMappingExposure=1.0;
renderer.setClearColor(0x010207,1);
const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(50,W/H,0.1,60000);

/* ---------------- textures canvas (không phụ thuộc mạng) ---------------- */
function softDot(size,r,g,b){const cv=document.createElement('canvas');cv.width=cv.height=size;const x=cv.getContext('2d');const c=size/2;
  const gr=x.createRadialGradient(c,c,0,c,c,c);gr.addColorStop(0,'rgba('+r+','+g+','+b+',1)');gr.addColorStop(.28,'rgba('+r+','+g+','+b+',.45)');gr.addColorStop(.6,'rgba('+r+','+g+','+b+',.09)');gr.addColorStop(1,'rgba('+r+','+g+','+b+',0)');
  x.fillStyle=gr;x.fillRect(0,0,size,size);const t=new THREE.Texture(cv);t.needsUpdate=true;return t;}
const BLUEGLOW=softDot(128,190,220,255);

/* ---------------- starfield THẬT (r=30000 > khoảng cách camera xa nhất ~1400) ----------------
   màu theo nhiệt độ sao (lam→trắng→vàng→cam→đỏ) */
function starColor(rng){const u=rng();
  if(u<0.06)      return [0.62,0.74,1.00];
  else if(u<0.20) return [0.80,0.87,1.00];
  else if(u<0.46) return [1.00,0.98,0.94];
  else if(u<0.72) return [1.00,0.93,0.72];
  else if(u<0.90) return [1.00,0.78,0.50];
  else            return [1.00,0.60,0.42];}
const SR=30000;
const starVS=`attribute float aS;varying vec3 vC;void main(){vC=color;vec4 mv=modelViewMatrix*vec4(position,1.0);gl_PointSize=aS*(30000.0/-mv.z);gl_Position=projectionMatrix*mv;}`;
const starFS=`varying vec3 vC;void main(){vec2 c=gl_PointCoord-0.5;float d=length(c);float a=smoothstep(0.5,0.0,d);float core=smoothstep(0.16,0.0,d);gl_FragColor=vec4(vC*(a+core*0.8),a);}`;
const stars=(function(){const N=4600,P=new Float32Array(N*3),S=new Float32Array(N),C=new Float32Array(N*3);
  for(let i=0;i<N;i++){const u=rnd(),v=rnd(),th=2*Math.PI*u,ph=Math.acos(2*v-1),sp=Math.sin(ph),r=SR;
    P[i*3]=sp*Math.cos(th)*r;P[i*3+1]=Math.cos(ph)*r;P[i*3+2]=sp*Math.sin(th)*r;
    const bright=rnd()<0.04?(18+rnd()*18):(Math.pow(rnd(),2.8)*11+2.2);
    S[i]=bright; const col=starColor(rnd),lum=0.6+0.4*Math.min(1,bright/14);
    C[i*3]=col[0]*lum;C[i*3+1]=col[1]*lum;C[i*3+2]=col[2]*lum;}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(P,3));g.setAttribute('aS',new THREE.BufferAttribute(S,1));g.setAttribute('color',new THREE.BufferAttribute(C,3));
  const pts=new THREE.Points(g,new THREE.ShaderMaterial({vertexColors:true,vertexShader:starVS,fragmentShader:starFS,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false}));
  scene.add(pts);return pts;})();
/* dải Ngân Hà mờ vắt ngang nền */
const milkyBand=(function(){const N=3800,P=new Float32Array(N*3),S=new Float32Array(N),C=new Float32Array(N*3);
  const tilt=0.55,ct=Math.cos(tilt),stt=Math.sin(tilt);
  for(let i=0;i<N;i++){const th=rnd()*Math.PI*2;const lat=(rnd()-0.5)*(rnd()-0.5)*1.7;const cl=Math.cos(lat),sl=Math.sin(lat),r=28000;
    let x=cl*Math.cos(th)*r, y=sl*r, z=cl*Math.sin(th)*r;const y2=y*ct-z*stt, z2=y*stt+z*ct;
    P[i*3]=x;P[i*3+1]=y2;P[i*3+2]=z2;S[i]=Math.pow(rnd(),3.0)*5.0+1.2;
    const w=(0.5+rnd()*0.4)*(0.5+0.5*Math.exp(-Math.abs(lat)*3.0));
    C[i*3]=w*0.84;C[i*3+1]=w*0.88;C[i*3+2]=w;}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(P,3));g.setAttribute('aS',new THREE.BufferAttribute(S,1));g.setAttribute('color',new THREE.BufferAttribute(C,3));
  const pts=new THREE.Points(g,new THREE.ShaderMaterial({vertexColors:true,vertexShader:starVS,fragmentShader:starFS,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false,opacity:0.5}));
  scene.add(pts);return pts;})();

/* ---------------- noise GLSL ---------------- */
const SN=`
vec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}
vec4 mod289(vec4 x){return x-floor(x*(1.0/289.0))*289.0;}
vec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}
vec4 taylorInvSqrt(vec4 r){return 1.79284291400159-0.85373472095314*r;}
float snoise(vec3 v){const vec2 C=vec2(1.0/6.0,1.0/3.0);const vec4 D=vec4(0.0,0.5,1.0,2.0);
 vec3 i=floor(v+dot(v,C.yyy));vec3 x0=v-i+dot(i,C.xxx);
 vec3 g=step(x0.yzx,x0.xyz);vec3 l=1.0-g;vec3 i1=min(g.xyz,l.zxy);vec3 i2=max(g.xyz,l.zxy);
 vec3 x1=x0-i1+C.xxx;vec3 x2=x0-i2+C.yyy;vec3 x3=x0-D.yyy;i=mod289(i);
 vec4 p=permute(permute(permute(i.z+vec4(0.0,i1.z,i2.z,1.0))+i.y+vec4(0.0,i1.y,i2.y,1.0))+i.x+vec4(0.0,i1.x,i2.x,1.0));
 float n_=0.142857142857;vec3 ns=n_*D.wyz-D.xzx;vec4 j=p-49.0*floor(p*ns.z*ns.z);
 vec4 x_=floor(j*ns.z);vec4 y_=floor(j-7.0*x_);vec4 x=x_*ns.x+ns.yyyy;vec4 y=y_*ns.x+ns.yyyy;vec4 h=1.0-abs(x)-abs(y);
 vec4 b0=vec4(x.xy,y.xy);vec4 b1=vec4(x.zw,y.zw);vec4 s0=floor(b0)*2.0+1.0;vec4 s1=floor(b1)*2.0+1.0;vec4 sh=-step(h,vec4(0.0));
 vec4 a0=b0.xzyw+s0.xzyw*sh.xxyy;vec4 a1=b1.xzyw+s1.xzyw*sh.zzww;
 vec3 p0=vec3(a0.xy,h.x);vec3 p1=vec3(a0.zw,h.y);vec3 p2=vec3(a1.xy,h.z);vec3 p3=vec3(a1.zw,h.w);
 vec4 norm=taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));p0*=norm.x;p1*=norm.y;p2*=norm.z;p3*=norm.w;
 vec4 m=max(0.6-vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)),0.0);m=m*m;
 return 42.0*dot(m*m,vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));}
float fbm(vec3 p){float f=0.0,a=0.5;for(int i=0;i<5;i++){f+=a*snoise(p);p=p*2.05+3.3;a*=0.5;}return f;}
`;

/* ============================================================
   HỐ ĐEN — SHADER LENSING THẬT (ray-march trắc địa Schwarzschild)
   Quad TOÀN KHUNG: mỗi pixel dựng 1 tia từ camera (uCamPos + cơ
   sở uCamRight/Up/Fwd) rồi RAY-MARCH photon quanh hố đen ở gốc.
   Đơn vị trong shader = bán kính Schwarzschild Rs (=1). Chân trời
   r<1 → đen; bóng (shadow) tự nổi ~2.6Rs do lensing; vòng photon
   = tia sượt r≈1.5 rồi thoát; đĩa bồi tụ = annulus phẳng y=0
   (trong→ngoài: gradient nhiệt + Doppler beaming tương đối + dịch
   đỏ hấp dẫn), bị bẻ vòng lên/xuống bóng đen (đa lần cắt đĩa);
   nền sao procedural lấy theo HƯỚNG TIA ĐÃ BẺ CONG (sao bẻ quanh rìa).
   Tất định: hàm thuần của uniforms, động qua uT; nhiễu = noise GLSL.
   ============================================================ */
const bhMat=new THREE.ShaderMaterial({transparent:true,depthWrite:false,depthTest:false,
  uniforms:{uT:{value:0},uOp:{value:1},uRs:{value:20},uBright:{value:1},uAsym:{value:0.9},
    uRing:{value:1},uEHT:{value:0},uDiskIn:{value:2.6},uDiskOut:{value:10.0},
    uAspect:{value:W/H},uTanHalf:{value:Math.tan(25*Math.PI/180)},
    uCamPos:{value:new THREE.Vector3(0,0,600)},uCamRight:{value:new THREE.Vector3(1,0,0)},
    uCamUp:{value:new THREE.Vector3(0,1,0)},uCamFwd:{value:new THREE.Vector3(0,0,-1)}},
  vertexShader:`varying vec2 vUv;void main(){vUv=uv;gl_Position=vec4(position.xy,0.0,1.0);}`,
  fragmentShader:`precision highp float;varying vec2 vUv;
   uniform float uT,uOp,uRs,uBright,uAsym,uRing,uEHT,uDiskIn,uDiskOut,uAspect,uTanHalf;
   uniform vec3 uCamPos,uCamRight,uCamUp,uCamFwd;`+SN+`
   float h21(vec2 p){p=fract(p*vec2(123.34,345.45));p+=dot(p,p+34.345);return fract(p.x*p.y);}
   /* nền sao procedural theo hướng tia (đã bẻ cong) + dải Ngân Hà */
   vec3 starField(vec3 dir){
    vec3 col=vec3(0.0);
    float lon=atan(dir.z,dir.x), lat=asin(clamp(dir.y,-1.0,1.0));
    vec2 uv=vec2(lon,lat);
    for(int k=0;k<3;k++){
      float sc=90.0+float(k)*95.0;
      vec2 g=uv*sc; vec2 id=floor(g); vec2 f=fract(g)-0.5;
      float hh=h21(id+float(k)*57.3);
      float star=step(0.985-float(k)*0.003,hh);
      float d=length(f); float pt=star*smoothstep(0.11,0.0,d);
      float ch=h21(id+7.1); vec3 sc2=mix(vec3(0.66,0.78,1.0),vec3(1.0,0.86,0.6),ch);
      sc2=mix(sc2,vec3(1.0),0.28);
      col+=pt*sc2*(0.55+0.9*h21(id+3.3));
    }
    float band=exp(-pow(dir.y*2.3,2.0));
    float bn=fbm(dir*3.0+2.0);
    col+=band*(0.028+0.05*max(0.0,bn))*vec3(0.55,0.62,0.86);
    col+=vec3(0.006,0.008,0.017);
    return col;
   }
   /* mẫu đĩa bồi tụ tại điểm cắt mặt phẳng (blackbody + Doppler + redshift) */
   vec4 diskSample(vec3 hit, vec3 rd){
    float rho=length(hit.xz);
    float tt=clamp((rho-uDiskIn)/(uDiskOut-uDiskIn),0.0,1.0);
    vec3 col=mix(vec3(0.75,0.86,1.0),vec3(1.0,0.98,0.92),smoothstep(0.0,0.12,tt));
    col=mix(col,vec3(1.0,0.55,0.16),smoothstep(0.10,0.5,tt));
    col=mix(col,vec3(0.72,0.16,0.05),smoothstep(0.55,1.0,tt));
    float bright=mix(2.0,0.10,pow(tt,0.65));
    float ang=atan(hit.z,hit.x);
    float spin=uT*(0.35+1.1/rho);
    float n=fbm(vec3(cos(ang-spin)*rho*1.15, hit.y*0.5, sin(ang-spin)*rho*1.15));
    float turb=0.5+0.75*smoothstep(-0.55,0.85,n);
    float dens=clamp(turb*mix(1.0,0.2,tt),0.0,1.0);
    bright*=turb;
    /* Doppler beaming tương đối: vận tốc quỹ đạo tiếp tuyến (prograde) */
    vec3 vdir=normalize(cross(vec3(0.0,1.0,0.0),hit));
    float beta=clamp(0.62*sqrt(uDiskIn/max(rho,uDiskIn)),0.0,0.72)*clamp(uAsym,0.0,1.0);
    float vlos=dot(vdir,rd);
    float dopp=1.0/(1.0-beta*vlos);
    bright*=pow(dopp,3.2);
    col=mix(col,col*vec3(0.72,0.86,1.35),clamp((dopp-1.0)*0.9,0.0,1.0));
    col=mix(col,col*vec3(1.35,0.72,0.42),clamp((1.0-dopp)*0.9,0.0,1.0));
    /* dịch đỏ hấp dẫn gần chân trời */
    float gg=sqrt(clamp(1.0-1.0/rho,0.02,1.0));
    bright*=mix(0.42,1.0,gg);
    col=mix(col*vec3(1.25,0.68,0.38),col,gg);
    if(uEHT>0.5){col=mix(col,vec3(1.0,0.6,0.22),0.55);bright*=0.85;}
    return vec4(col*bright,dens);
   }
   void main(){
    vec2 ndc=vUv*2.0-1.0; ndc.x*=uAspect;
    vec3 rd=normalize(uCamFwd + ndc.x*uTanHalf*uCamRight + ndc.y*uTanHalf*uCamUp);
    vec3 ro=uCamPos/uRs;
    vec3 pos=ro, vel=rd;
    vec3 cc=cross(pos,vel); float h2=dot(cc,cc);
    float ESC=length(ro)+8.0;
    vec3 accum=vec3(0.0); float transp=1.0; float minP=1e9;
    bool captured=false;
    for(int i=0;i<200;i++){
      float r=length(pos);
      if(r<1.0){captured=true;break;}
      if(r>ESC && dot(pos,vel)>0.0)break;
      minP=min(minP,abs(r-1.5));
      float dt=clamp((r-1.0)*0.16+0.02,0.02,0.5);
      vec3 acc=-1.5*h2*pos/pow(dot(pos,pos),2.5);
      vel+=acc*dt;
      vec3 npos=pos+vel*dt;
      if(pos.y*npos.y<0.0){
        float f=pos.y/(pos.y-npos.y);
        vec3 hit=mix(pos,npos,f);
        float rho=length(hit.xz);
        if(rho>uDiskIn && rho<uDiskOut){
          vec4 ds=diskSample(hit,normalize(vel));
          accum+=ds.rgb*ds.a*transp;
          transp*=(1.0-ds.a*0.9);
        }
      }
      pos=npos;
      if(transp<0.02)break;
    }
    vec3 bg=captured?vec3(0.0):starField(normalize(vel));
    vec3 col=accum+bg*transp;
    /* vòng photon: tia sượt r≈1.5 rồi thoát → vành sáng MẢNH ngay rìa bóng */
    if(!captured){
      float pr=exp(-minP*minP*(uEHT>0.5?14.0:42.0));
      col+=vec3(1.0,0.98,1.06)*pr*uRing*(uEHT>0.5?0.9:1.35);
    }
    col*=uBright;
    col=min(col,vec3(60.0));
    gl_FragColor=vec4(max(col,vec3(0.0))*uOp,1.0);
   }`});
const BHSHADOWR=52.0;
const bh=new THREE.Mesh(new THREE.PlaneGeometry(2,2),bhMat);
bh.renderOrder=-10; scene.add(bh);

/* ---------------- bức xạ Hawking (hạt lấp lánh rỉ ra ở rìa) — cảnh 7 ---------------- */
const hawkMat=new THREE.ShaderMaterial({transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,
  uniforms:{uT:{value:0},uOp:{value:1},uR0:{value:BHSHADOWR*1.05},uRange:{value:70},uSpeed:{value:0.05}},
  vertexShader:`attribute float aSeed;uniform float uT,uR0,uRange,uSpeed;varying float vA;varying float vS;
   void main(){float ph=fract(aSeed*7.13+uT*uSpeed);vec3 dir=normalize(position);float rad=uR0+ph*uRange;
    vec3 pos=dir*rad;vS=aSeed;vA=ph*(1.0-ph)*4.0;
    vec4 mv=modelViewMatrix*vec4(pos,1.0);
    gl_PointSize=(1.8+3.2*fract(aSeed*91.0))*(300.0/-mv.z)*(0.5+0.5*sin(uT*6.0+aSeed*30.0));
    gl_Position=projectionMatrix*mv;}`,
  fragmentShader:`varying float vA;varying float vS;uniform float uOp;
   void main(){vec2 c=gl_PointCoord-0.5;float a=smoothstep(0.5,0.0,length(c));
    vec3 col=mix(vec3(0.7,0.85,1.0),vec3(1.0,0.95,0.8),fract(vS*17.0));
    gl_FragColor=vec4(col*a*vA,a*vA)*uOp;}`});
const hawkPts=(function(){const N=680,P=new Float32Array(N*3),Sd=new Float32Array(N);
  for(let i=0;i<N;i++){const u=rnd(),v=rnd(),th=2*Math.PI*u,ph=Math.acos(2*v-1),sp=Math.sin(ph);
    P[i*3]=sp*Math.cos(th);P[i*3+1]=Math.cos(ph);P[i*3+2]=sp*Math.sin(th);Sd[i]=rnd();}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(P,3));g.setAttribute('aSeed',new THREE.BufferAttribute(Sd,1));
  const pts=new THREE.Points(g,hawkMat);pts.renderOrder=4;scene.add(pts);pts.visible=false;return pts;})();

/* ---------------- LƯỚI KHÔNG-THỜI GIAN (giếng vô tận) — cảnh 6 ---------------- */
const GN=48, GS=1700;
const gridBase=[];
const gridGeo=new THREE.BufferGeometry();
(function(){const verts=[];
  for(let i=0;i<=GN;i++)for(let j=0;j<=GN;j++){const x=(i/GN-0.5)*GS,z=(j/GN-0.5)*GS;gridBase.push([x,z]);}
  const idxLine=(i,j)=>i*(GN+1)+j;
  for(let i=0;i<=GN;i++)for(let j=0;j<=GN;j++){
    if(i<GN){verts.push(idxLine(i,j),idxLine(i+1,j));}
    if(j<GN){verts.push(idxLine(i,j),idxLine(i,j+1));}}
  const pos=new Float32Array(gridBase.length*3);
  for(let k=0;k<gridBase.length;k++){pos[k*3]=gridBase[k][0];pos[k*3+1]=0;pos[k*3+2]=gridBase[k][1];}
  gridGeo.setAttribute('position',new THREE.BufferAttribute(pos,3));
  gridGeo.setIndex(verts);})();
const gridMesh=new THREE.LineSegments(gridGeo,new THREE.LineBasicMaterial({color:0x4a70c8,transparent:true,opacity:0.42,blending:THREE.AdditiveBlending,depthWrite:false}));
gridMesh.renderOrder=2; scene.add(gridMesh);
function updateGrid(t,depth,well){const pos=gridGeo.attributes.position.array;
  for(let k=0;k<gridBase.length;k++){const x=gridBase[k][0],z=gridBase[k][1];const r=Math.sqrt(x*x+z*z);
    let y=-depth/(1+(r/(140*well))*(r/(140*well)));
    pos[k*3+1]=y;}
  gridGeo.attributes.position.needsUpdate=true;}

/* ---------------- hậu kỳ: bloom + lens (+ screen lensing) ---------------- */
const composer=new THREE.EffectComposer(renderer);composer.addPass(new THREE.RenderPass(scene,camera));
const bloom=new THREE.UnrealBloomPass(new THREE.Vector2(W,H),0.72,0.55,0.72);composer.addPass(bloom);
const lensPass=new THREE.ShaderPass({uniforms:{tDiffuse:{value:null},uRes:{value:new THREE.Vector2(W,H)},uT:{value:0},uBH:{value:new THREE.Vector2(0.5,0.5)},uBHr:{value:0.1},uLens:{value:0}},
  vertexShader:`varying vec2 vUv;void main(){vUv=uv;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}`,
  fragmentShader:`uniform sampler2D tDiffuse;uniform vec2 uRes;uniform float uT;uniform vec2 uBH;uniform float uBHr;uniform float uLens;varying vec2 vUv;
    float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
    void main(){vec2 uv=vUv;vec2 asp=vec2(uRes.x/uRes.y,1.0);
      if(uLens>0.001){vec2 d=(uv-uBH)*asp;float rr=length(d);
        if(rr>1e-4){float defl=uLens*uBHr*uBHr/(rr*rr+0.0004);defl=min(defl,rr*0.96);
          uv=uv-normalize(d)*defl/asp;}}
      vec2 c=uv-0.5;float r2=dot(c,c);float ca=0.0006+r2*0.0022;vec3 col;
      col.r=texture2D(tDiffuse,uv+c*ca).r;col.g=texture2D(tDiffuse,uv).g;col.b=texture2D(tDiffuse,uv-c*ca).b;
      float vig=1.0-smoothstep(0.32,0.98,r2*1.85);col*=mix(0.6,1.0,vig);
      col+=(h(uv*uRes+floor(uT*30.0))-0.5)*0.022;gl_FragColor=vec4(col,1.0);}`});
lensPass.renderToScreen=true;composer.addPass(lensPass);

/* screen-space vị trí + bán kính hố đen (origin) để bẻ cong sao nền */
const _v0=new THREE.Vector3(), _vr=new THREE.Vector3(), _right=new THREE.Vector3();
function updateBHscreen(){
  _v0.set(0,0,0).project(camera);
  const ux=_v0.x*0.5+0.5, uy=_v0.y*0.5+0.5;
  _right.setFromMatrixColumn(camera.matrixWorld,0);
  _vr.copy(_right).multiplyScalar(BHSHADOWR).project(camera);
  const ex=_vr.x*0.5+0.5, ey=_vr.y*0.5+0.5;
  const rr=Math.hypot((ex-ux)*(W/H),(ey-uy));
  lensPass.uniforms.uBH.value.set(ux,uy);
  lensPass.uniforms.uBHr.value=Math.max(0.01,rr);
}

/* ============================================================
   #fx — canvas 2D overlay (kinetic type / sơ đồ / ẩn dụ)
   ============================================================ */
const fx=document.getElementById('fx'); fx.width=W; fx.height=H; const X=fx.getContext('2d');
function clearFx(){X.setTransform(1,0,0,1,0,0);X.clearRect(0,0,W,H);X.textAlign='center';X.textBaseline='middle';X.globalAlpha=1;X.shadowBlur=0;}
function backdrop(a){if(a<=0)return;X.fillStyle="rgba(1,1,6,"+Math.min(1,a)+")";X.fillRect(0,0,W,H);}
function F(w,s){return w+' '+s+'px "Segoe UI",Roboto,Arial,sans-serif';}
function txt(s,x,y,size,weight,col,a,glow,align){if(a<=0.004)return;X.save();X.globalAlpha=Math.min(1,a);X.font=F(weight,size);X.fillStyle=col;X.textAlign=align||'center';X.textBaseline='middle';if(glow){X.shadowColor=glow;X.shadowBlur=size*0.45;}X.fillText(s,x,y);X.restore();}
function glow2d(x,y,r,cr,cg,cb,a){if(a<=0.004||r<=0)return;X.save();X.globalAlpha=Math.min(1,a);const g=X.createRadialGradient(x,y,0,x,y,r);g.addColorStop(0,`rgba(${cr},${cg},${cb},1)`);g.addColorStop(.35,`rgba(${cr},${cg},${cb},.5)`);g.addColorStop(1,`rgba(${cr},${cg},${cb},0)`);X.fillStyle=g;X.beginPath();X.arc(x,y,r,0,7);X.fill();X.restore();}
function dot2d(x,y,r,col,a){if(a<=0.004)return;X.save();X.globalAlpha=Math.min(1,a);X.fillStyle=col;X.beginPath();X.arc(x,y,r,0,7);X.fill();X.restore();}
function ring2d(x,y,r,col,lw,a){if(a<=0.004||r<=0)return;X.save();X.globalAlpha=Math.min(1,a);X.strokeStyle=col;X.lineWidth=lw;X.beginPath();X.arc(x,y,r,0,7);X.stroke();X.restore();}
function line2d(x0,y0,x1,y1,col,lw,a){if(a<=0.004)return;X.save();X.globalAlpha=Math.min(1,a);X.strokeStyle=col;X.lineWidth=lw;X.beginPath();X.moveTo(x0,y0);X.lineTo(x1,y1);X.stroke();X.restore();}
function arc2d(x,y,r,a0,a1,col,lw,a){if(a<=0.004||r<=0)return;X.save();X.globalAlpha=Math.min(1,a);X.strokeStyle=col;X.lineWidth=lw;X.beginPath();X.arc(x,y,r,a0,a1);X.stroke();X.restore();}
function holeDisc(x,y,r,ringCol,a){if(a<=0.004)return;X.save();X.globalAlpha=Math.min(1,a);X.fillStyle="rgba(2,2,8,1)";X.beginPath();X.arc(x,y,r,0,7);X.fill();X.strokeStyle=ringCol;X.lineWidth=Math.max(2,r*0.14);X.shadowColor=ringCol;X.shadowBlur=r*0.6;X.beginPath();X.arc(x,y,r*1.06,0,7);X.stroke();X.restore();}
function sceneOp(i,t){return win(t,SB[i-1],SB[i],0.5,0.5);}
const CY='rgba(150,216,255,1)', WH='rgba(238,241,255,1)', AM='rgba(255,182,96,1)', RD='rgba(255,120,96,1)', DIM='rgba(168,186,220,1)', VI='rgba(200,182,255,1)';

/* precompute tất định (seed L) */
const PARTS=[];for(let i=0;i<90;i++)PARTS.push({a:L()*6.28,r:L(),s:L(),k:L()});
const CONV=[];for(let i=0;i<64;i++)CONV.push({a:(i/64)*6.28+ (L()-0.5)*0.2});
const QFOAM=[];for(let i=0;i<70;i++)QFOAM.push({x:L(),y:L(),ph:L()*6.28,s:L()});

/* ============================================================
   CẢNH 1 — ĐIỂM KHÔNG THỂ QUAY ĐẦU (tiến về hố đen, sao bị bẻ cong)
   ============================================================ */
function fxScene1(t,op){
  /* C01 0-12.4 bạn đang rơi */
  const a1=win(t,1.4,12.4,2.2,1.6)*op;
  if(a1>0.01){txt("BẠN ĐANG RƠI",W/2,H*0.4,78,"800",WH,a1,"rgba(120,150,230,0.4)");
    txt("về phía một nơi mà không gì có thể quay lại",W/2,H*0.52,34,"400",DIM,win(t,4,12.4,1.6,1.6)*op);
    txt("— kể cả ánh sáng · kể cả thời gian —",W/2,H*0.72,30,"500",CY,win(t,8,12.4,1.4,1.6)*op);}
  /* C02 12.4-32.33 vùng tối tuyệt đối, sao bị kéo giãn */
  const a2=win(t,13.4,32.33,1.6,1.6)*op;
  if(a2>0.01){txt("MỘT VÙNG TỐI TUYỆT ĐỐI",W/2,H*0.16,50,"700",WH,a2,"rgba(120,150,230,0.4)");
    txt("quanh rìa: những ngôi sao bị KÉO GIÃN · UỐN CONG",W/2,H*0.86,32,"500",AM,win(t,22,32.33,1.6,1.6)*op);}
  /* C03 32.33-46.46 câu hỏi */
  const a3=win(t,33.3,46.46,1.6,1.6)*op;
  if(a3>0.01){txt("CHUYỆN GÌ XẢY RA",W/2,H*0.34,58,"800",WH,a3,"rgba(120,150,230,0.4)");
    txt("nếu bạn rơi vào một HỐ ĐEN?",W/2,H*0.46,44,"700",AM,a3,"rgba(255,150,80,0.4)");
    txt("Bạn sẽ thấy gì? Cảm thấy gì? Và ở tận cùng — có gì chờ bạn?",W/2,H*0.72,30,"400",DIM,win(t,39,46.46,1.4,1.6)*op);}
  /* C04 46.46-64.53 vật lý dự đoán */
  const a4=win(t,47.5,64.53,1.6,1.6)*op;
  if(a4>0.01){txt("ĐÂY LÀ ĐIỀU VẬT LÝ THỰC SỰ DỰ ĐOÁN",W/2,H*0.2,42,"700",WH,a4,"rgba(120,150,230,0.35)");
    const items=["đẹp đến kinh ngạc","khủng khiếp","và có phần — chính ta cũng chưa biết"];
    const cols=[CY,RD,VI];
    for(let k=0;k<3;k++)txt(items[k],W/2,H*0.42+k*74,40,"600",cols[k],win(t,50+k*4,64.53,1.2,1.6)*op,"rgba(0,0,0,0.5)");}
  /* C05 64.53-81.26 không phải cái hố */
  const a5=win(t,65.5,81.26,1.6,1.5)*op;
  if(a5>0.01){txt("HỐ ĐEN KHÔNG PHẢI MỘT CÁI HỐ",W/2,H*0.34,50,"700",WH,a5,"rgba(120,150,230,0.4)");
    txt("không phải một cái phễu hút — mà kỳ lạ hơn thế rất nhiều",W/2,H*0.68,32,"500",DIM,win(t,71,81.26,1.4,1.5)*op);}
}

/* ============================================================
   CẢNH 2 — HỐ ĐEN LÀ GÌ (đĩa bồi tụ iconic + kinetic)
   ============================================================ */
function fxScene2(t,op){
  /* C06 81.26 trọng lực */
  const a6=win(t,82.2,93.93,1.4,1.2)*op;
