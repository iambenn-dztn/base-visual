    txt("càng MẠNH khi vật càng NẶNG — và khi bạn càng ở GẦN",W/2,H*0.86,32,"500",DIM,win(t,86,93.93,1.4,1.2)*op);}
  /* C07 93.93 vận tốc thoát */
  const a7=win(t,94.9,111.4,1.2,1.2)*op;
  if(a7>0.01){const v=Math.round(lerp(0,40000,ss(96,105,t))/100)*100;
    txt("VẬN TỐC THOÁT",W/2,H*0.18,42,"700",CY,a7,"rgba(90,160,230,0.4)");
    txt(v.toLocaleString('vi-VN')+" km/h",W/2,H*0.36,84,"800",WH,a7,"rgba(120,180,255,0.5)");
    txt("để rời khỏi Trái Đất — hành tinh nhỏ hơn cần ít hơn, sao khổng lồ cần nhiều hơn",W/2,H*0.85,30,"500",DIM,win(t,104,111.4,1.2,1.2)*op);}
  /* C08 111.4 nén → tốc độ ánh sáng */
  const a8=win(t,112.4,129.73,1.2,1.2)*op;
  if(a8>0.01){txt("NÉN KHỐI LƯỢNG VÀO KHÔNG GIAN NHỎ DẦN",W/2,H*0.2,40,"700",WH,a8,"rgba(120,170,255,0.4)");
    txt("→ vận tốc thoát tăng mãi, tới một ngưỡng điên rồ:",W/2,H*0.72,32,"500",DIM,win(t,118,129.73,1.2,1.2)*op);
    txt("= TỐC ĐỘ ÁNH SÁNG",W/2,H*0.82,48,"800",AM,win(t,122,129.73,1.2,1.2)*op,"rgba(255,150,80,0.4)");}
  /* C09 129.73 không gì thoát */
  const a9=win(t,130.7,150.6,1.2,1.4)*op;
  if(a9>0.01){txt("KHÔNG GÌ CÓ THỂ THOÁT RA",W/2,H*0.34,54,"800",WH,a9,"rgba(120,170,255,0.45)");
    txt("kể cả chính ÁNH SÁNG",W/2,H*0.46,40,"700",CY,win(t,136,150.6,1.2,1.4)*op);
    txt("ĐÓ CHÍNH LÀ MỘT HỐ ĐEN",W/2,H*0.72,44,"800",AM,win(t,143,150.6,1.2,1.4)*op,"rgba(255,150,80,0.45)");}
  /* C10 150.6 đen vì ánh sáng biến mất */
  const a10=win(t,151.6,165.6,1.3,1.2)*op;
  if(a10>0.01){txt("nó KHÔNG đen theo kiểu sơn màu đen",W/2,H*0.2,38,"600",DIM,a10);
    txt("nó đen vì là nơi ÁNH SÁNG ĐI VÀO VÀ BIẾN MẤT",W/2,H*0.85,36,"700",WH,win(t,156,165.6,1.3,1.2)*op,"rgba(120,170,255,0.4)");}
  /* C11 165.6 chân trời sự kiện */
  const a11=win(t,166.6,179.87,1.2,1.2)*op;
  if(a11>0.01){txt("CHÂN TRỜI SỰ KIỆN",W/2,H*0.42,64,"800",AM,a11,"rgba(255,160,80,0.5)");
    txt("khái niệm quan trọng nhất của cả hành trình này",W/2,H*0.56,32,"500",WH,win(t,172,179.87,1.2,1.2)*op);}
  /* C12 179.87 ranh giới */
  const a12=win(t,180.9,200.74,1.2,1.2)*op;
  if(a12>0.01){txt("không chỉ là ranh giới của cái TA THẤY",W/2,H*0.2,38,"600",WH,a12,"rgba(120,170,255,0.35)");
    txt("mà là ranh giới của cái CÓ THỂ XẢY RA và được biết tới",W/2,H*0.85,34,"600",CY,win(t,190,200.74,1.2,1.2)*op);}
  /* C13 200.74 cánh cửa một chiều */
  const a13=win(t,201.7,222.87,1.2,1.2)*op;
  if(a13>0.01){txt("MỘT CÁNH CỬA CHỈ MỞ MỘT CHIỀU",W/2,H*0.2,46,"800",WH,a13,"rgba(120,170,255,0.4)");
    txt("VÀO được  →  không một tín hiệu, không một tiếng kêu cứu ĐI RA",W/2,H*0.85,32,"600",RD,win(t,209,222.87,1.2,1.2)*op);}
  /* C14 222.87 ranh giới vô hình */
  const a14=win(t,223.9,248.14,1.2,1.4)*op;
  if(a14>0.01){txt("KHÔNG TƯỜNG · KHÔNG BỀ MẶT · KHÔNG MÀNG",W/2,H*0.2,40,"700",WH,a14,"rgba(120,170,255,0.4)");
    txt("chỉ là một đường ranh giới VÔ HÌNH — ngoài: còn quay đầu · trong: đã quá muộn, mãi mãi",W/2,H*0.85,30,"500",DIM,win(t,232,248.14,1.2,1.4)*op);}
}

