    txt("đã ở TRONG — mọi con đường dẫn sâu hơn",W*0.72,H*0.55,26,"500",DIM,win(t,292,305.34,1.2,1.2)*op);
    txt("→",W/2,H*0.44,60,"300",WH,win(t,290,305.34,1.2,1.2)*op*0.7);}
