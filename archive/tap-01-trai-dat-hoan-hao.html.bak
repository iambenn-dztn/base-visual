<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1920, height=1080">
<title>Tập 1 — Trái Đất Hoàn Hảo — HyperFrames</title>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
<script src="https://unpkg.com/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{width:1920px;height:1080px;overflow:hidden;background:#03040a;font-family:-apple-system,Segoe UI,Roboto,sans-serif;}
  #root{position:relative;width:1920px;height:1080px;}
  #c{position:absolute;inset:0;display:block;}
  #vig{position:absolute;inset:0;pointer-events:none;z-index:5;background:radial-gradient(ellipse at center,rgba(0,0,0,0) 58%,rgba(2,2,8,.42) 100%);}
  #sub{position:absolute;left:50%;bottom:9%;transform:translateX(-50%);z-index:20;width:min(1400px,86%);text-align:center;color:#f4f1ff;font-size:40px;font-weight:600;line-height:1.4;text-shadow:0 2px 18px rgba(0,0,0,.95),0 0 3px rgba(0,0,0,.95);}
  #err{position:absolute;left:12px;top:12px;z-index:99;color:#ff9090;background:rgba(0,0,0,.8);padding:8px 10px;font:12px/1.5 monospace;max-width:90%;white-space:pre-wrap;border-radius:8px;display:none;}
</style>
</head>
<body>
<div data-hf-id="hf-m1d3" id="root" data-composition-id="tap-01-trai-dat" data-start="0" data-duration="808.74" data-width="1920" data-height="1080">
  <canvas data-hf-id="hf-pspp" id="c" class="clip" data-start="0" data-duration="808.74" data-track-index="0"></canvas>
  <div data-hf-id="hf-xl8p" id="vig"></div>
  <div data-hf-id="hf-2tmp" id="sub"></div>
  <div data-hf-id="hf-mp26" id="err"></div>
  <audio data-hf-id="hf-yy5y" id="narr" class="clip" data-start="0" data-duration="808.74" data-track-index="1" src="../projects/hoan-hao-trai-dat/voice/narration_mixed.mp3"></audio>
</div>

<script>
window.addEventListener('error',function(e){var d=document.getElementById('err');if(!d)return;d.style.display='block';
  d.textContent='LỖI: '+(e.message||e.type)+(e.filename?('\n@ '+e.filename.split('/').pop()+':'+e.lineno):'');});
// ===================== composition TẤT ĐỊNH theo t =====================
const TOTAL=808.74, W=1920, H=1080, R=10, EO=180, VN_ROT=2.40;
function mulberry32(a){return function(){a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return ((t^t>>>14)>>>0)/4294967296;};}
const rnd=mulberry32(20260704);
const renderer=new THREE.WebGLRenderer({canvas:document.getElementById('c'),antialias:true});
renderer.setPixelRatio(1); renderer.setSize(W,H);
renderer.outputEncoding=THREE.sRGBEncoding; renderer.toneMapping=THREE.ACESFilmicToneMapping; renderer.toneMappingExposure=1.15;
const scene=new THREE.Scene();
const camera=new THREE.PerspectiveCamera(50,W/H,0.1,16000);
const SUNPOS=new THREE.Vector3(-EO,0,0), SUN=SUNPOS.clone().normalize();
const maxAniso=renderer.capabilities.getMaxAnisotropy();
const TB='https://cdn.jsdelivr.net/gh/turban/webgl-earth@master/images/';
const PX='https://cdn.jsdelivr.net/gh/jeromeetienne/threex.planets@master/images/';
const loader=new THREE.TextureLoader(); loader.setCrossOrigin('anonymous');
function tex(u,s){const t=loader.load(u);if(s)t.encoding=THREE.sRGBEncoding;t.anisotropy=maxAniso;return t;}
const earthDay=tex(TB+'2_no_clouds_4k.jpg',true),earthWater=tex(TB+'water_4k.png',false),earthBump=tex(TB+'elev_bump_4k.jpg',false),earthCloud=tex(PX+'earthcloudmap.jpg',false),
  moonTex=tex(PX+'moonmap1k.jpg',true),mercTex=tex(PX+'mercurymap.jpg',true),venusTex=tex(PX+'venusmap.jpg',true),marsTex=tex(PX+'marsmap1k.jpg',true),
  jupTex=tex(PX+'jupitermap.jpg',true),satTex=tex(PX+'saturnmap.jpg',true),satRingTex=tex(PX+'saturnringcolor.jpg',true),
  uranTex=tex(PX+'uranusmap.jpg',true),nepTex=tex(PX+'neptunemap.jpg',true),plutoTex=tex(PX+'plutomap1k.jpg',true),galaxyTex=tex(PX+'galaxy_starfield.png',true);
galaxyTex.mapping=THREE.EquirectangularReflectionMapping; scene.background=galaxyTex;
const sunLight=new THREE.DirectionalLight(0xfff3e0,1.7); sunLight.position.copy(SUNPOS); scene.add(sunLight);
scene.add(new THREE.AmbientLight(0x2a3a52,0.30));
const DOT=(function(){const s=64,cv=document.createElement('canvas');cv.width=cv.height=s;const g=cv.getContext('2d');
  const gr=g.createRadialGradient(s/2,s/2,0,s/2,s/2,s/2);gr.addColorStop(0,'#fff');gr.addColorStop(.3,'rgba(255,255,255,.4)');gr.addColorStop(.6,'rgba(255,255,255,.08)');gr.addColorStop(1,'rgba(255,255,255,0)');
  g.fillStyle=gr;g.fillRect(0,0,s,s);const t=new THREE.Texture(cv);t.needsUpdate=true;return t;})();
(function(){const N=2200,P=new Float32Array(N*3),S=new Float32Array(N);
  for(let i=0;i<N;i++){const u=rnd(),v=rnd(),th=2*Math.PI*u,ph=Math.acos(2*v-1),sp=Math.sin(ph),r=11000;
    P[i*3]=sp*Math.cos(th)*r;P[i*3+1]=Math.cos(ph)*r;P[i*3+2]=sp*Math.sin(th)*r;S[i]=Math.pow(rnd(),2.5)*24+3;}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(P,3));g.setAttribute('aS',new THREE.BufferAttribute(S,1));
  scene.add(new THREE.Points(g,new THREE.ShaderMaterial({vertexShader:`attribute float aS;void main(){vec4 mv=modelViewMatrix*vec4(position,1.0);gl_PointSize=aS*(11000.0/-mv.z);gl_Position=projectionMatrix*mv;}`,
    fragmentShader:`void main(){vec2 c=gl_PointCoord-0.5;float a=smoothstep(0.5,0.0,length(c));gl_FragColor=vec4(vec3(0.95,0.96,1.0)*a,a);}`,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false})));})();
const earthTilt=new THREE.Group(); earthTilt.rotation.z=0.409; scene.add(earthTilt);
const earthMesh=new THREE.Mesh(new THREE.SphereGeometry(R,96,96),new THREE.MeshPhongMaterial({map:earthDay,specularMap:earthWater,bumpMap:earthBump,bumpScale:0.3,specular:new THREE.Color(0x2a4d68),shininess:18}));
earthTilt.add(earthMesh);
const cloudMesh=new THREE.Mesh(new THREE.SphereGeometry(R*1.015,64,64),new THREE.MeshPhongMaterial({map:earthCloud,alphaMap:earthCloud,color:0xffffff,transparent:true,opacity:0.9,depthWrite:false})); earthTilt.add(cloudMesh);
const atmMat=new THREE.ShaderMaterial({uniforms:{uSun:{value:SUN}},transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,
  vertexShader:`varying vec3 vVN;varying vec3 vNW;void main(){vVN=normalize(normalMatrix*normal);vNW=normalize(mat3(modelMatrix)*normal);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}`,
  fragmentShader:`precision highp float;varying vec3 vVN;varying vec3 vNW;uniform vec3 uSun;void main(){float rim=pow(clamp(1.0-vVN.z,0.0,1.0),3.0);float day=smoothstep(-0.25,0.55,dot(normalize(vNW),normalize(uSun)));gl_FragColor=vec4(vec3(0.32,0.56,1.0)*rim*(0.25+0.85*day),1.0);}`});
scene.add(new THREE.Mesh(new THREE.SphereGeometry(R*1.06,48,48),atmMat));
function latLon(lat,lon,r){const phi=(90-lat)*Math.PI/180,th=(lon+180)*Math.PI/180;return new THREE.Vector3(-r*Math.sin(phi)*Math.cos(th),r*Math.cos(phi),r*Math.sin(phi)*Math.sin(th));}
function mkLabel(txt,col,px){const cv=document.createElement('canvas');let g=cv.getContext('2d');const f='600 '+(px||26)+'px Segoe UI, Arial';
  g.font=f;const w=Math.ceil(g.measureText(txt).width)+18;cv.width=w;cv.height=(px||26)+14;g=cv.getContext('2d');g.font=f;g.textAlign='center';g.textBaseline='middle';g.fillStyle=col;g.fillText(txt,w/2,cv.height/2);
  const t=new THREE.Texture(cv);t.needsUpdate=true;const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:t,transparent:true,opacity:0,depthWrite:false,depthTest:false}));sp.userData.w=w;sp.userData.h=cv.height;return sp;}
function place(lat,lon,txt,dc,tc,ly){const p=latLon(lat,lon,R*1.02);
  const d=new THREE.Sprite(new THREE.SpriteMaterial({map:DOT,color:dc,transparent:true,depthTest:true,depthWrite:false,blending:THREE.AdditiveBlending}));d.position.copy(p);d.scale.set(0.55,0.55,1);earthMesh.add(d);
  const l=mkLabel(txt,tc,26);l.material.opacity=1;l.material.depthTest=true;l.scale.set(l.userData.w*0.013,l.userData.h*0.013,1);l.position.copy(p.clone().multiplyScalar(1.03));l.position.y+=(ly||0);earthMesh.add(l);}
place(16.2,108,'Việt Nam',0xffffff,'rgba(255,255,255,0.96)',-0.4);
place(16.5,112,'Hoàng Sa',0xffd23f,'rgba(255,226,120,0.98)',0.8);
place(9.5,114,'Trường Sa',0xffd23f,'rgba(255,226,120,0.98)',-0.3);
function archipelago(clat,clon,dlat,dlon,n){const P=new Float32Array(n*3);
  for(let i=0;i<n;i++){const p=latLon(clat+(rnd()-0.5)*dlat,clon+(rnd()-0.5)*dlon,R*1.006);P[i*3]=p.x;P[i*3+1]=p.y;P[i*3+2]=p.z;}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(P,3));
  earthMesh.add(new THREE.Points(g,new THREE.PointsMaterial({map:DOT,color:0xfff0cb,size:0.24,sizeAttenuation:true,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending})));}
archipelago(16.5,112,1.6,2.4,26); archipelago(9.5,114,5.6,5.6,50);
const moon=new THREE.Mesh(new THREE.SphereGeometry(R*0.27,48,48),new THREE.MeshPhongMaterial({map:moonTex,shininess:3})); scene.add(moon);
const solar=new THREE.Group(); solar.position.copy(SUNPOS); scene.add(solar);
// ===== MẶT TRỜI CHÂN THỰC: quang cầu (granulation+limb darkening+vết đen) + sắc cầu + nhật hoa =====
const SUN_NOISE=`
vec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}
vec4 mod289(vec4 x){return x-floor(x*(1.0/289.0))*289.0;}
vec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}
vec4 taylorInvSqrt(vec4 r){return 1.79284291400159-0.85373472095314*r;}
float snoise(vec3 v){const vec2 C=vec2(1.0/6.0,1.0/3.0);const vec4 D=vec4(0.0,0.5,1.0,2.0);
 vec3 i=floor(v+dot(v,C.yyy));vec3 x0=v-i+dot(i,C.xxx);
 vec3 g=step(x0.yzx,x0.xyz);vec3 l=1.0-g;vec3 i1=min(g.xyz,l.zxy);vec3 i2=max(g.xyz,l.zxy);
 vec3 x1=x0-i1+C.xxx;vec3 x2=x0-i2+C.yyy;vec3 x3=x0-D.yyy;i=mod289(i);
 vec4 p=permute(permute(permute(i.z+vec4(0.0,i1.z,i2.z,1.0))+i.y+vec4(0.0,i1.y,i2.y,1.0))+i.x+vec4(0.0,i1.x,i2.x,1.0));
 float n_=0.142857142857;vec3 ns=n_*D.wyz-D.xzx;vec4 j=p-49.0*floor(p*ns.z*ns.z);
 vec4 x_=floor(j*ns.z);vec4 y_=floor(j-7.0*x_);vec4 x=x_*ns.x+ns.yyyy;vec4 y=y_*ns.x+ns.yyyy;vec4 h=1.0-abs(x)-abs(y);
 vec4 b0=vec4(x.xy,y.xy);vec4 b1=vec4(x.zw,y.zw);vec4 s0=floor(b0)*2.0+1.0;vec4 s1=floor(b1)*2.0+1.0;vec4 sh=-step(h,vec4(0.0));
 vec4 a0=b0.xzyw+s0.xzyw*sh.xxyy;vec4 a1=b1.xzyw+s1.xzyw*sh.zzww;
 vec3 p0=vec3(a0.xy,h.x);vec3 p1=vec3(a0.zw,h.y);vec3 p2=vec3(a1.xy,h.z);vec3 p3=vec3(a1.zw,h.w);
 vec4 norm=taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));p0*=norm.x;p1*=norm.y;p2*=norm.z;p3*=norm.w;
 vec4 m=max(0.6-vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)),0.0);m=m*m;
 return 42.0*dot(m*m,vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));}
float fbm(vec3 p){float f=0.0,a=0.5;for(int i=0;i<5;i++){f+=a*snoise(p);p=p*2.03+7.1;a*=0.5;}return f;}
`;
const sunMat=new THREE.ShaderMaterial({uniforms:{uT:{value:0}},
  vertexShader:`varying vec3 vDir;varying vec3 vN;varying vec3 vV;void main(){vDir=normalize(position);vN=normalize(normalMatrix*normal);vec4 mv=modelViewMatrix*vec4(position,1.0);vV=-mv.xyz;gl_Position=projectionMatrix*mv;}`,
  fragmentShader:`precision highp float;varying vec3 vDir;varying vec3 vN;varying vec3 vV;uniform float uT;`+SUN_NOISE+`
   void main(){vec3 d=normalize(vDir);
    vec3 q=d*7.0+vec3(uT*0.02,uT*0.015,-uT*0.02);
    float gran=fbm(q);float fine=fbm(d*22.0+uT*0.05);
    float cells=gran*0.72+fine*0.28;float bri=smoothstep(-0.5,0.7,cells);
    float sp=fbm(d*1.7+3.3);float spot=smoothstep(0.56,0.76,sp);
    vec3 cDark=vec3(0.72,0.20,0.02),cMid=vec3(1.0,0.60,0.16),cHot=vec3(1.0,0.93,0.72);
    vec3 col=mix(cDark,cMid,smoothstep(0.15,0.6,bri));
    col=mix(col,cHot,smoothstep(0.62,1.0,bri));
    col=mix(col,vec3(0.26,0.07,0.02),spot*0.92);
    float mu=clamp(dot(normalize(vN),normalize(vV)),0.0,1.0);
    col*=(0.30+0.70*pow(mu,0.6));
    col+=cHot*pow(1.0-mu,3.0)*bri*0.35;
    col*=1.4;
    gl_FragColor=vec4(col,1.0);}`});
const sunMesh=new THREE.Mesh(new THREE.SphereGeometry(74,96,96),sunMat); solar.add(sunMesh);
const chromoMat=new THREE.ShaderMaterial({transparent:true,blending:THREE.AdditiveBlending,depthWrite:false,side:THREE.FrontSide,
  vertexShader:`varying vec3 vN;varying vec3 vV;void main(){vN=normalize(normalMatrix*normal);vec4 mv=modelViewMatrix*vec4(position,1.0);vV=-mv.xyz;gl_Position=projectionMatrix*mv;}`,
  fragmentShader:`precision highp float;varying vec3 vN;varying vec3 vV;void main(){float f=pow(1.0-max(dot(normalize(vN),normalize(vV)),0.0),3.2);gl_FragColor=vec4(vec3(1.0,0.42,0.16)*f*1.7,1.0);}`});
solar.add(new THREE.Mesh(new THREE.SphereGeometry(74*1.028,64,64),chromoMat));
// nhật hoa: texture mềm + tia mờ (PRNG riêng để không xê dịch layout vành đai)
const rndc=mulberry32(99);
function coronaTex(size,rays){const cv=document.createElement('canvas');cv.width=cv.height=size;const g=cv.getContext('2d');const c=size/2;
  const gr=g.createRadialGradient(c,c,0,c,c,c);gr.addColorStop(0,'rgba(255,246,222,1)');gr.addColorStop(.06,'rgba(255,238,190,.96)');gr.addColorStop(.16,'rgba(255,206,120,.55)');gr.addColorStop(.34,'rgba(255,150,60,.17)');gr.addColorStop(.66,'rgba(255,120,40,.05)');gr.addColorStop(1,'rgba(0,0,0,0)');
  g.fillStyle=gr;g.fillRect(0,0,size,size);g.globalCompositeOperation='lighter';
  for(let i=0;i<rays;i++){const a=rndc()*Math.PI*2,len=c*(0.45+rndc()*0.5),wid=(1.5+rndc()*3.0)*(size/256);
    g.save();g.translate(c,c);g.rotate(a);const rg=g.createLinearGradient(0,0,len,0);rg.addColorStop(0,'rgba(255,220,150,0.18)');rg.addColorStop(1,'rgba(255,180,90,0)');
    g.fillStyle=rg;g.beginPath();g.moveTo(0,-wid);g.lineTo(len,0);g.lineTo(0,wid);g.closePath();g.fill();g.restore();}
  const t=new THREE.Texture(cv);t.needsUpdate=true;return t;}
const SUNTEX=coronaTex(512,44);
const solarGlow=new THREE.Sprite(new THREE.SpriteMaterial({map:SUNTEX,blending:THREE.AdditiveBlending,depthWrite:false,transparent:true,opacity:0.95})); solar.add(solarGlow);
const coronaFar=new THREE.Sprite(new THREE.SpriteMaterial({map:coronaTex(512,30),blending:THREE.AdditiveBlending,depthWrite:false,transparent:true,opacity:0.5})); solar.add(coronaFar);
const orbitMats=[], labelSprites=[], planets=[];
function orbitRing(r){const pts=[];for(let i=0;i<=160;i++){const a=i/160*Math.PI*2;pts.push(new THREE.Vector3(Math.cos(a)*r,0,Math.sin(a)*r));}
  const g=new THREE.BufferGeometry().setFromPoints(pts);const m=new THREE.LineBasicMaterial({color:0x6f86b0,transparent:true,opacity:0,depthWrite:false});orbitMats.push(m);return new THREE.LineLoop(g,m);}
function addPlanet(tx,orbit,size,a0,spd,tilt,spin,name){solar.add(orbitRing(orbit));
  const m=new THREE.Mesh(new THREE.SphereGeometry(size,40,40),new THREE.MeshPhongMaterial({map:tx,shininess:4}));if(tilt)m.rotation.z=tilt;solar.add(m);
  const lab=mkLabel(name,'rgba(205,228,255,0.95)',30);lab.scale.set(lab.userData.w*0.06,lab.userData.h*0.06,1);labelSprites.push(lab);solar.add(lab);
  const p={mesh:m,orbit:orbit,a0:a0,spd:spd,size:size,lab:lab,spin:spin||1};planets.push(p);return p;}
// bán kính hành tinh theo TỈ LỆ THẬT so với Trái Đất (R=10): kích cỡ tương đối giữa các hành tinh luôn đúng ở mọi góc nhìn
addPlanet(mercTex,100,3.83,0.5,0.12,0,1,'Sao Thủy');      // 0.383 R⊕
addPlanet(venusTex,140,9.50,2.1,0.09,0.05,-1,'Sao Kim');  // 0.950 R⊕ (tự quay ngược)
addPlanet(marsTex,250,5.32,5.2,0.06,0.44,1,'Sao Hỏa');    // 0.532 R⊕
solar.add(orbitRing(EO));
const earthLab=mkLabel('Trái Đất','rgba(205,228,255,0.95)',30);earthLab.scale.set(earthLab.userData.w*0.06,earthLab.userData.h*0.06,1);earthLab.position.set(EO,16,0);labelSprites.push(earthLab);solar.add(earthLab);
const jup=addPlanet(jupTex,560,109.7,1.2,0.03,0.05,1,'Sao Mộc');   // 10.97 R⊕
const sat=addPlanet(satTex,880,91.4,4.4,0.022,0.47,1,'Sao Thổ');   // 9.14 R⊕
addPlanet(uranTex,1180,39.8,2.0,0.015,1.71,-1,'Sao Thiên Vương');  // 3.98 R⊕ (nghiêng 98°)
addPlanet(nepTex,1450,38.6,0.7,0.011,0.49,1,'Sao Hải Vương');      // 3.86 R⊕
addPlanet(moonTex,320,0.74,1.0,0.05,0.05,1,'Ceres');              // 0.074 R⊕
addPlanet(plutoTex,1600,1.86,2.0,0.009,0.008,1,'Sao Diêm Vương');  // 0.186 R⊕
addPlanet(moonTex,1690,1.83,4.0,0.007,0.007,1,'Eris');            // 0.183 R⊕
const ringGeo=new THREE.RingGeometry(105,210,120,1);
(function(){const pos=ringGeo.attributes.position,uv=ringGeo.attributes.uv,v=new THREE.Vector3();for(let i=0;i<pos.count;i++){v.fromBufferAttribute(pos,i);const d=v.length();uv.setXY(i,(d-105)/105,0.5);}})();
const satRing=new THREE.Mesh(ringGeo,new THREE.MeshBasicMaterial({map:satRingTex,alphaMap:satRingTex,transparent:true,opacity:0.9,side:THREE.DoubleSide,depthWrite:false}));satRing.rotation.x=Math.PI/2.4;sat.mesh.add(satRing);
const hzMat=new THREE.MeshBasicMaterial({color:0x58d090,transparent:true,opacity:0,side:THREE.DoubleSide,blending:THREE.AdditiveBlending,depthWrite:false});
const hz=new THREE.Mesh(new THREE.RingGeometry(EO-22,EO+25,120),hzMat);hz.rotation.x=Math.PI/2;solar.add(hz);
const beltMats=[];
function beltLayer(grp,N,rmin,rmax,yj,size,col,op){const P=new Float32Array(N*3);
  for(let i=0;i<N;i++){const a=rnd()*Math.PI*2,r=rmin+rnd()*(rmax-rmin),y=(rnd()-0.5)*yj;P[i*3]=Math.cos(a)*r;P[i*3+1]=y;P[i*3+2]=Math.sin(a)*r;}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(P,3));
  const m=new THREE.PointsMaterial({color:col,size:size*1.7,map:DOT,sizeAttenuation:true,transparent:true,opacity:op,depthWrite:false,blending:THREE.AdditiveBlending});beltMats.push({m:m,base:op});grp.add(new THREE.Points(g,m));}
const belt=new THREE.Group();beltLayer(belt,3200,290,360,9,1.5,0x9a8f7a,0.8);beltLayer(belt,340,292,358,9,4.0,0xb9ad94,0.95);solar.add(belt);
const kb=new THREE.Group();beltLayer(kb,3000,1540,1770,30,1.4,0x8aa0b8,0.55);beltLayer(kb,300,1540,1770,30,3.6,0xaebfce,0.7);solar.add(kb);
const composer=new THREE.EffectComposer(renderer);composer.addPass(new THREE.RenderPass(scene,camera));
const bloom=new THREE.UnrealBloomPass(new THREE.Vector2(W,H),0.45,0.6,0.55);composer.addPass(bloom);
const lensPass=new THREE.ShaderPass({uniforms:{tDiffuse:{value:null},uRes:{value:new THREE.Vector2(W,H)},uT:{value:0}},
  vertexShader:`varying vec2 vUv;void main(){vUv=uv;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}`,
  fragmentShader:`uniform sampler2D tDiffuse;uniform vec2 uRes;uniform float uT;varying vec2 vUv;
    float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
    void main(){vec2 uv=vUv,c=uv-0.5;float r2=dot(c,c),ca=0.0006+r2*0.0022;vec3 col;
      col.r=texture2D(tDiffuse,uv+c*ca).r;col.g=texture2D(tDiffuse,uv).g;col.b=texture2D(tDiffuse,uv-c*ca).b;
      float vig=1.0-smoothstep(0.34,0.95,r2*1.8);col*=mix(0.6,1.0,vig);col+=(h(uv*uRes+floor(uT*30.0))-0.5)*0.03;gl_FragColor=vec4(col,1.0);}`});
lensPass.renderToScreen=true;composer.addPass(lensPass);
function smooth(a){return a*a*a*(a*(a*6-15)+10);}
function track(t,k){if(t<=k[0].t)return k[0].v;if(t>=k[k.length-1].t)return k[k.length-1].v;
  for(let i=0;i<k.length-1;i++){if(t>=k[i].t&&t<=k[i+1].t){const a=smooth((t-k[i].t)/(k[i+1].t-k[i].t)),v0=k[i].v,v1=k[i+1].v;
    if(Array.isArray(v0))return v0.map((x,j)=>x+(v1[j]-x)*a);return v0+(v1-v0)*a;}}return k[k.length-1].v;}
// ===== camera choreography — 18 nhịp theo 16 chương (TOTAL 967.83s) =====
const camPos=[
 {t:0,v:[-70,55,760]},{t:15,v:[-40,28,300]},{t:30,v:[-16,7,34]},{t:58,v:[-16,7,34]},
