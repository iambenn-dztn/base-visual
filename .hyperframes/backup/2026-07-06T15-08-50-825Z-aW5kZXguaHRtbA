/* ---------------- starfield THẬT (r=30000 > khoảng cách camera xa nhất) ----------------
   màu theo nhiệt độ sao (lam→trắng→vàng→cam→đỏ) */
function starColor(u){
  if(u<0.06)      return [0.62,0.74,1.00];
  else if(u<0.20) return [0.80,0.87,1.00];
  else if(u<0.46) return [1.00,0.98,0.94];
  else if(u<0.72) return [1.00,0.93,0.72];
  else if(u<0.90) return [1.00,0.78,0.50];
  else            return [1.00,0.60,0.42];}
const SR=30000;
const starVS=`attribute float aS;varying vec3 vC;void main(){vC=color;vec4 mv=modelViewMatrix*vec4(position,1.0);gl_PointSize=aS*(30000.0/-mv.z);gl_Position=projectionMatrix*mv;}`;
const starFS=`varying vec3 vC;uniform float uOp;void main(){vec2 c=gl_PointCoord-0.5;float d=length(c);float a=smoothstep(0.5,0.0,d);float core=smoothstep(0.16,0.0,d);gl_FragColor=vec4(vC*(a+core*0.8),a)*uOp;}`;
const starOp={value:1};
const stars=(function(){const N=4400,P=new Float32Array(N*3),S=new Float32Array(N),C=new Float32Array(N*3);
  for(let i=0;i<N;i++){const u=rnd(),v=rnd(),th=2*Math.PI*u,ph=Math.acos(2*v-1),sp=Math.sin(ph),r=SR;
    P[i*3]=sp*Math.cos(th)*r;P[i*3+1]=Math.cos(ph)*r;P[i*3+2]=sp*Math.sin(th)*r;
    const bright=rnd()<0.04?(18+rnd()*18):(Math.pow(rnd(),2.8)*11+2.2);
    S[i]=bright; const col=starColor(rnd()),lum=0.6+0.4*Math.min(1,bright/14);
    C[i*3]=col[0]*lum;C[i*3+1]=col[1]*lum;C[i*3+2]=col[2]*lum;}
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(P,3));g.setAttribute('aS',new THREE.BufferAttribute(S,1));g.setAttribute('color',new THREE.BufferAttribute(C,3));
  const pts=new THREE.Points(g,new THREE.ShaderMaterial({vertexColors:true,uniforms:{uOp:starOp},vertexShader:starVS,fragmentShader:starFS,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false}));
  scene.add(pts);return pts;})();

/* ---------------- noise GLSL ---------------- */
const SN=`
vec3 mod289(vec3 x){return x-floor(x*(1.0/289.0))*289.0;}
vec4 mod289(vec4 x){return x-floor(x*(1.0/289.0))*289.0;}
vec4 permute(vec4 x){return mod289(((x*34.0)+1.0)*x);}
vec4 taylorInvSqrt(vec4 r){return 1.79284291400159-0.85373472095314*r;}
float snoise(vec3 v){const vec2 C=vec2(1.0/6.0,1.0/3.0);const vec4 D=vec4(0.0,0.5,1.0,2.0);
 vec3 i=floor(v+dot(v,C.yyy));vec3 x0=v-i+dot(i,C.xxx);
 vec3 g=step(x0.yzx,x0.xyz);vec3 l=1.0-g;vec3 i1=min(g.xyz,l.zxy);vec3 i2=max(g.xyz,l.zxy);
 vec3 x1=x0-i1+C.xxx;vec3 x2=x0-i2+C.yyy;vec3 x3=x0-D.yyy;i=mod289(i);
 vec4 p=permute(permute(permute(i.z+vec4(0.0,i1.z,i2.z,1.0))+i.y+vec4(0.0,i1.y,i2.y,1.0))+i.x+vec4(0.0,i1.x,i2.x,1.0));
 float n_=0.142857142857;vec3 ns=n_*D.wyz-D.xzx;vec4 j=p-49.0*floor(p*ns.z*ns.z);
 vec4 x_=floor(j*ns.z);vec4 y_=floor(j-7.0*x_);vec4 x=x_*ns.x+ns.yyyy;vec4 y=y_*ns.x+ns.yyyy;vec4 h=1.0-abs(x)-abs(y);
 vec4 b0=vec4(x.xy,y.xy);vec4 b1=vec4(x.zw,y.zw);vec4 s0=floor(b0)*2.0+1.0;vec4 s1=floor(b1)*2.0+1.0;vec4 sh=-step(h,vec4(0.0));
 vec4 a0=b0.xzyw+s0.xzyw*sh.xxyy;vec4 a1=b1.xzyw+s1.xzyw*sh.zzww;
 vec3 p0=vec3(a0.xy,h.x);vec3 p1=vec3(a0.zw,h.y);vec3 p2=vec3(a1.xy,h.z);vec3 p3=vec3(a1.zw,h.w);
 vec4 norm=taylorInvSqrt(vec4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));p0*=norm.x;p1*=norm.y;p2*=norm.z;p3*=norm.w;
 vec4 m=max(0.6-vec4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)),0.0);m=m*m;
 return 42.0*dot(m*m,vec4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));}
float fbm(vec3 p){float f=0.0,a=0.5;for(int i=0;i<5;i++){f+=a*snoise(p);p=p*2.05+3.3;a*=0.5;}return f;}
`;
const HS=`float hs(float n){return fract(sin(n)*43758.5453);}`;
const BEADVS=`attribute float aS;varying vec3 vC;void main(){vC=color;vec4 mv=modelViewMatrix*vec4(position,1.0);gl_PointSize=aS*(220.0/-mv.z);gl_Position=projectionMatrix*mv;}`;
const BEADFS=`varying vec3 vC;uniform float uOp;void main(){vec2 c=gl_PointCoord-0.5;float d=length(c);float a=smoothstep(0.5,0.0,d);gl_FragColor=vec4(vC*(a+smoothstep(0.22,0.0,d)*0.9),a)*uOp;}`;

/* ---------------- phân tử (nguyên tử + liên kết) ---------------- */
const atomGeo=new THREE.SphereGeometry(1,18,14);
const bondGeo=new THREE.CylinderGeometry(0.26,0.26,1,8);
const ATOMC={C:0x6b7686,O:0xff5a48,N:0x5a86ff,H:0xeef3ff,S:0xffd24a};
function atomMesh(col,r){const m=new THREE.Mesh(atomGeo,new THREE.MeshStandardMaterial({color:col,emissive:col,emissiveIntensity:0.32,roughness:0.32,metalness:0.0}));m.scale.setScalar(r);return m;}
const _u=new THREE.Vector3(0,1,0);
function bondMesh(a,b){const dir=new THREE.Vector3().subVectors(b,a);const len=dir.length();const mm=new THREE.Mesh(bondGeo,new THREE.MeshStandardMaterial({color:0x9aa6ba,emissive:0x2c3444,emissiveIntensity:0.5,roughness:0.5}));mm.position.copy(a).add(b).multiplyScalar(0.5);mm.scale.set(1,len,1);mm.quaternion.setFromUnitVectors(_u,dir.clone().normalize());return mm;}
function buildMolecule(seed){const g=new THREE.Group();const rng=mulberry32(seed);
  const types=['C','O','N','C','H','C','O','N','S'];const n=4+Math.floor(rng()*4);const pts=[];
  for(let i=0;i<n;i++){const p=new THREE.Vector3((rng()-0.5)*3.4,(rng()-0.5)*3.4,(rng()-0.5)*3.4);pts.push(p);
    const tp=types[i%types.length];const r=tp==='H'?0.5:(tp==='C'?0.92:0.8);const a=atomMesh(ATOMC[tp],r);a.position.copy(p);g.add(a);}
  for(let i=1;i<n;i++)g.add(bondMesh(pts[i-1],pts[i]));
  return g;
}

/* ---------------- chuỗi xoắn ARN phát sáng ---------------- */
function buildHelix(N,radius,pitch,scale){
  const g=new THREE.Group();
  const bp=[],bc=[],bs=[],bl=[],blc=[];
  const cols=[[0.35,1.0,0.72],[0.55,0.82,1.0],[1.0,0.86,0.42],[1.0,0.5,0.62]];
  let pAx=null,pAy=null,pAz=null,pBx=null,pBy=null,pBz=null;
  for(let i=0;i<N;i++){const ang=i*0.52;const y=(i-(N-1)/2)*pitch;
    const ax=Math.cos(ang)*radius,az=Math.sin(ang)*radius;
    const bx=Math.cos(ang+Math.PI)*radius,bz=Math.sin(ang+Math.PI)*radius;
    const cA=cols[i%4],cB=cols[(i+2)%4];
    bp.push(ax,y,az);bc.push(cA[0],cA[1],cA[2]);bs.push(26);
    bp.push(bx,y,bz);bc.push(cB[0],cB[1],cB[2]);bs.push(26);
    if(pAx!==null){bl.push(pAx,pAy,pAz,ax,y,az);blc.push(0.35,0.9,0.72,0.35,0.9,0.72);
      bl.push(pBx,pBy,pBz,bx,y,bz);blc.push(0.4,0.7,0.95,0.4,0.7,0.95);}
    /* rung (bậc thang) mỗi 2 */
    if(i%2===0){bl.push(ax,y,az,bx,y,bz);blc.push(0.7,0.85,0.7,0.55,0.7,0.9);}
    pAx=ax;pAy=y;pAz=az;pBx=bx;pBy=y;pBz=bz;
  }
  const pg=new THREE.BufferGeometry();pg.setAttribute('position',new THREE.BufferAttribute(new Float32Array(bp),3));
  pg.setAttribute('color',new THREE.BufferAttribute(new Float32Array(bc),3));pg.setAttribute('aS',new THREE.BufferAttribute(new Float32Array(bs),1));
  const pts=new THREE.Points(pg,new THREE.ShaderMaterial({vertexColors:true,uniforms:{uOp:{value:1}},vertexShader:BEADVS,fragmentShader:BEADFS,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false}));
  g.add(pts);
  const lg=new THREE.BufferGeometry();lg.setAttribute('position',new THREE.BufferAttribute(new Float32Array(bl),3));lg.setAttribute('color',new THREE.BufferAttribute(new Float32Array(blc),3));
  const lines=new THREE.LineSegments(lg,new THREE.LineBasicMaterial({vertexColors:true,transparent:true,opacity:0.75,blending:THREE.AdditiveBlending,depthWrite:false}));
  g.add(lines);
  g.scale.setScalar(scale||1);
  g.userData={pts:pts,lines:lines};
  return g;
}

/* ============================================================
   GROUP 1 — RANH GIỚI SỐNG/CHẾT (bụi vô tri ↔ đốm sống)
