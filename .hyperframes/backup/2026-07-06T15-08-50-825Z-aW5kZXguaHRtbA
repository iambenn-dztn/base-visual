function subAt(t){let idx=0;for(let i=0;i<CUES.length;i++){if(CUES[i].t<=t+1e-6)idx=i;else break;}return CUES[idx]?CUES[idx].s:"";}

/* ---------------- camera helper ---------------- */
function cam(px,py,pz,lx,ly,lz){camera.position.set(px,py,pz);camera.lookAt(lx||0,ly||0,lz||0);}
function orbit(d,elev,speed,t,lookY){const a=t*speed;camera.position.set(Math.sin(a)*d,elev,Math.cos(a)*d);camera.lookAt(0,lookY||0,0);}

/* ============================================================
   renderAtTime(t) — hàm thuần, mọi chuyển động là hàm của t
   (KHÔNG remap: hình dựng thẳng trên timeline giọng)
   ============================================================ */
function renderAtTime(tReal){
  const t=clamp(tReal,0,TOTAL);
  /* scene index */
  let A=1;for(let i=1;i<=8;i++){if(t>=SB[i-1])A=i;}
  /* shared uniforms */
  stars.rotation.y=t*0.0006;
  planetMat.uniforms.uT.value=t; smokeMat.uniforms.uT.value=t; meteorMat.uniforms.uT.value=t;
  cellMat.uniforms.uT.value=t; cell2.material.uniforms.uT.value=t; tailMat.uniforms.uT.value=t;
  lensPass.uniforms.uT.value=t;
  /* reset visibility */
  grpBoundary.visible=false;grpEarth.visible=false;grpSoup.visible=false;grpVent.visible=false;
  grpRNA.visible=false;grpCell.visible=false;grpComet.visible=false;
  stars.visible=true;starOp.value=1;camera.fov=50;camera.up.set(0,1,0);
  renderer.setClearColor(0x02040a,1);

  if(A===1){
    renderer.setClearColor(0x03040c,1);starOp.value=0.55;
    grpBoundary.visible=true;
    const br=0.85+0.35*Math.sin(t*1.6);lifeCore.material.opacity=br;lifeCore.scale.setScalar(110+18*Math.sin(t*1.6));
    lifeOrbit.rotation.y=t*0.5;lifeOrbit.rotation.x=t*0.3;
    dustClump.rotation.y=t*0.05;
    const dr=lerp(430,360,ss(0,121.93,t));
    cam(Math.sin(t*0.03)*40,24,dr,0,0,0);
  }else if(A===2){
    renderer.setClearColor(0x0a0304,1);starOp.value=0.4;
    grpEarth.visible=true;
    const cool=ss(196,265,t);/* nguội & tạo đại dương từ ~C11 */
    planetMat.uniforms.uCool.value=cool;atmoMat.uniforms.uCool.value=cool;
    planet.rotation.y=t*0.06;
    meteorMat.uniforms.uOp.value=1-ss(196,232,t)*0.92;/* dội bom thưa dần khi nguội */
    orbit(360,lerp(38,60,ss(121.93,265,t)),0.02,t,0);
  }else if(A===3){
    renderer.setClearColor(0x0a0603,1);starOp.value=0;
    grpSoup.visible=true;
    for(let i=0;i<soupMols.length;i++){const s=soupMols[i];const appear=ss(266+i*4,290+i*4,t);
      s.mesh.visible=appear>0.02;s.mesh.scale.setScalar((4.2)*(0.4+0.6*appear));
      s.mesh.position.set(s.base.x+Math.sin(t*s.ap+s.ph)*16,s.base.y+Math.cos(t*s.ap*0.8+s.ph)*12,s.base.z+Math.sin(t*s.ap*0.6)*14);
      s.mesh.rotation.y=t*s.sp;s.mesh.rotation.x=t*s.sp*0.6;}
    orbit(300,20,0.012,t,0);
  }else if(A===4){
    renderer.setClearColor(0x01060a,1);starOp.value=0;
    grpVent.visible=true;
    smokeMat.uniforms.uOp.value=win(t,449.48,648.68,3,4)*1.35;
    mineralGlow.material.uniforms.uOp.value=0.95+0.25*Math.sin(t*2);
    const a=(t-449.48)*0.02;
    camera.position.set(Math.sin(a)*220,52+34*Math.sin((t-449.48)*0.03),Math.cos(a)*220);
    camera.lookAt(0,78,0);
  }else if(A===5){
    renderer.setClearColor(0x03050e,1);starOp.value=0;
    grpRNA.visible=true;
    rnaDust.rotation.y=t*0.02;
    const rep=ss(770,830,t);/* tự sao chép: tách đôi */
    rnaA.rotation.y=t*0.28;rnaB.rotation.y=t*0.28;
    rnaA.position.x=-lerp(0,42,rep);rnaB.position.x=lerp(0,42,rep);
    rnaB.visible=rep>0.02;rnaB.userData.pts.material.uniforms.uOp.value=rep;rnaB.userData.lines.material.opacity=0.75*rep;
    orbit(150,10,0.05,t,0);
  }else if(A===6){
    renderer.setClearColor(0x03060c,1);starOp.value=0;
    grpCell.visible=true;
    const asm=ss(869,905,t);lipidMat.uniforms.uA.value=asm;lipidMat.uniforms.uOp.value=win(t,869,1044,3,3)*(1-ss(940,975,t)*0.6);
    cellMat.uniforms.uOp.value=ss(895,925,t);
    innerRNA.rotation.y=t*0.4;cellMols.rotation.y=-t*0.2;
    cell1.rotation.y=t*0.15;
    const div=ss(945,975,t);/* phân đôi */
    cell1.position.x=-lerp(0,40,div);cell2.position.x=lerp(0,40,div);
    cell2.material.uniforms.uOp.value=div*ss(895,925,t);cell2.rotation.y=-t*0.15;
    orbit(lerp(210,265,div),30,0.025,t,0);
  }else if(A===7){
    renderer.setClearColor(0x02030c,1);starOp.value=1;
    grpComet.visible=true;
    /* sao chổi bay từ phải-trên xuống trái-dưới, gieo xuống Trái Đất nhỏ */
    const jr=ss(1044.28,1210,t);
    cometNode.position.set(lerp(230,-200,jr),lerp(170,-110,jr),lerp(20,-30,jr));
    cometNode.rotation.z=0.3;cometNode.rotation.y=t*0.2;nucleus.rotation.y=t*0.5;nucleus.rotation.x=t*0.3;
    coma.material.opacity=0.85;cometMols.rotation.y=t*0.4;
    const seed=ss(1195,1214,t);seedEarth.scale.setScalar(1+seed*0.15);
    seedAtmo.material.uniforms.uCool.value=1;
    seedEarth.rotation.y=t*0.1;
    cam(0,10,470,0,0,0);
  }else if(A===8){
    renderer.setClearColor(0x03040c,1);starOp.value=0.5;
    /* 3D chỉ là sao nền + đốm gốc; cây vẽ ở 2D */
    grpBoundary.visible=true;dustClump.visible=false;
    lifeCore.material.opacity=0.0;lifeOrbit.material.uniforms.uOp.value=0;
    cam(0,0,600,0,0,0);
  }

  camera.updateProjectionMatrix();camera.updateMatrixWorld();
  composer.render();

  /* ---- 2D overlay ---- */
  clearFx();
  for(let i=1;i<=8;i++){const o=sceneOp(i,t);if(o>0.004)FX[i](t,o);}
  const fb=(t<1.4?(1-t/1.4):0)+(t>TOTAL-3?clamp((t-(TOTAL-3))/2.8,0,1):0);
  if(fb>0){X.fillStyle="rgba(1,2,8,"+clamp(fb,0,1)+")";X.fillRect(0,0,W,H);}

  /* ---- tiêu đề chương + phụ đề ---- */
  const chapO=win(t,SB[A-1],SB[A-1]+6.5,0.8,1.5);
  chapEl.textContent=CHAP[A-1];chapEl.style.opacity=(chapO*clamp(1-fb,0,1)).toFixed(3);
  subEl.textContent=subAt(t);subEl.style.opacity=clamp(1-fb,0,1).toFixed(3);

  /* reset các thứ đã tắt tạm cho scene 8 */
  if(A!==8){dustClump.visible=true;lifeOrbit.material.uniforms.uOp.value=1;}
}

/* ---------------- timeline TẤT ĐỊNH ---------------- */
window.__timelines=window.__timelines||{};
const tl=gsap.timeline({paused:true});
const clk={t:0};
tl.to(clk,{t:TOTAL,duration:TOTAL,ease:"none",onUpdate:()=>renderAtTime(clk.t)},0);
window.__timelines["tap-05-su-song"]=tl;
renderAtTime(0);
</script>
