const grpBoundary=new THREE.Group();scene.add(grpBoundary);
const dustClump=(function(){const N=900,P=new Float32Array(N*3),S=new Float32Array(N),C=new Float32Array(N*3);
  for(let i=0;i<N;i++){const rr=Math.pow(rnd(),0.6)*70;const u=rnd(),v=rnd(),th=2*Math.PI*u,ph=Math.acos(2*v-1),sp=Math.sin(ph);
    P[i*3]=-140+sp*Math.cos(th)*rr;P[i*3+1]=sp*Math.sin(th)*rr*0.8;P[i*3+2]=Math.cos(ph)*rr;
    S[i]=6+rnd()*7;const g=0.28+rnd()*0.22;C[i*3]=g*1.05;C[i*3+1]=g;C[i*3+2]=g*0.92;}
  const gg=new THREE.BufferGeometry();gg.setAttribute('position',new THREE.BufferAttribute(P,3));gg.setAttribute('aS',new THREE.BufferAttribute(S,1));gg.setAttribute('color',new THREE.BufferAttribute(C,3));
  const pts=new THREE.Points(gg,new THREE.ShaderMaterial({vertexColors:true,uniforms:{uOp:{value:1}},vertexShader:BEADVS,fragmentShader:BEADFS,transparent:true,blending:THREE.NormalBlending,depthWrite:false}));
  grpBoundary.add(pts);return pts;})();
const lifeCore=glowSprite(DOT_WARM,120,1);lifeCore.position.set(150,0,0);grpBoundary.add(lifeCore);
const lifeOrbit=(function(){const N=140,P=new Float32Array(N*3),S=new Float32Array(N),C=new Float32Array(N*3);
  for(let i=0;i<N;i++){const rr=18+rnd()*40;const u=rnd(),v=rnd(),th=2*Math.PI*u,ph=Math.acos(2*v-1),sp=Math.sin(ph);
    P[i*3]=sp*Math.cos(th)*rr;P[i*3+1]=sp*Math.sin(th)*rr;P[i*3+2]=Math.cos(ph)*rr;
    S[i]=8+rnd()*10;C[i*3]=1.0;C[i*3+1]=0.82+rnd()*0.15;C[i*3+2]=0.5+rnd()*0.2;}
  const gg=new THREE.BufferGeometry();gg.setAttribute('position',new THREE.BufferAttribute(P,3));gg.setAttribute('aS',new THREE.BufferAttribute(S,1));gg.setAttribute('color',new THREE.BufferAttribute(C,3));
  const pts=new THREE.Points(gg,new THREE.ShaderMaterial({vertexColors:true,uniforms:{uOp:{value:1}},vertexShader:BEADVS,fragmentShader:BEADFS,transparent:true,blending:THREE.AdditiveBlending,depthWrite:false}));
  pts.position.set(150,0,0);grpBoundary.add(pts);return pts;})();

/* ============================================================
   GROUP 2 — TRÁI ĐẤT SƠ KHAI (magma → đại dương) + dội bom
   ============================================================ */
const grpEarth=new THREE.Group();scene.add(grpEarth);
const PLR=120;
const planetMat=new THREE.ShaderMaterial({uniforms:{uT:{value:0},uCool:{value:0}},
  vertexShader:`varying vec3 vDir;varying vec3 vN;varying vec3 vV;
   void main(){vDir=normalize(position);vN=normalize(mat3(modelMatrix)*normal);vec4 wp=modelMatrix*vec4(position,1.0);vV=normalize(cameraPosition-wp.xyz);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0);}`,
  fragmentShader:`precision highp float;varying vec3 vDir;varying vec3 vN;varying vec3 vV;uniform float uT,uCool;`+SN+`
   void main(){vec3 d=vDir;
    float plates=fbm(d*2.1);
    float detail=fbm(d*6.5+uT*0.02);
    float flow=fbm(d*3.6-uT*0.05+detail*0.5);
    float lava=smoothstep(0.18,-0.30,plates+flow*0.4);
    vec3 rock=mix(vec3(0.10,0.045,0.03),vec3(0.22,0.10,0.07),detail*0.5+0.5);
    vec3 hot=mix(vec3(0.75,0.12,0.01),vec3(1.0,0.55,0.12),smoothstep(0.2,0.85,lava));
    hot=mix(hot,vec3(1.0,0.95,0.72),smoothstep(0.78,1.0,lava));
    vec3 col=mix(rock,hot,smoothstep(0.22,0.55,lava));
    float emis=0.5+lava*1.9;
    vec3 coolRock=mix(vec3(0.045,0.04,0.05),vec3(0.16,0.13,0.11),detail*0.5+0.5);
    float low=smoothstep(0.35,0.02,plates);
    vec3 ocean=mix(vec3(0.01,0.05,0.11),vec3(0.03,0.13,0.22),flow*0.5+0.5);
    vec3 cooled=mix(coolRock,ocean,low);
    col=mix(col,cooled,uCool);
    float e=mix(emis,0.10,uCool)*(0.35+0.65*lava);
    float lam=clamp(dot(vN,normalize(vec3(0.6,0.5,0.55))),0.0,1.0);
